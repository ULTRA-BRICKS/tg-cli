  // parsing so it works in a bare environment (e.g. from the installer).
  // Exact-match only, so `tg "install-skill"` still sends that as a message.
  if (rawArgs.length === 1 && rawArgs[0] === "install-skill") {
    process.exit(installSkill())
  }
  const home = process.env.HOME ?? "~"
  // The config dir the credential/env lookups below read from — honors
  // TG_CTL_CONFIG_DIR (same override tg-ctl's own daemon and the `replies`
  // subcommand already respect) so a non-default dir (e.g. two bots on one
  // machine, or tg-ctl's usage-schedule launchd job, which pins exactly this
  // var into its plist) doesn't silently fall back to ~/.config/tg-cli and
  // either fail to find credentials or send with the WRONG bot's (review
  // finding — this send path used to hardcode the default dir, unlike `replies`).
  const configDir = process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli")

  // `tg hooks ...` — list / trust / untrust for pre-send-photo hooks. Hooks are
  // trust-by-default (they run with no trust step), so `trust` is a no-op unless
  // AGENTS_HOOKS_TRUST=1 re-engages the TOFU pin. Exact-match leading token, so
  // `tg "hooks ..."` as a plain message still sends. Returns null when argv is
  // not a hooks subcommand. Pass the SAME merged config+process env the later
  // gate uses (config `.env` → process.env precedence) so AGENTS_HOOKS_TRUST set
  // in the resolved config dir's .env governs `hooks list/trust` exactly as it
  // governs a real send — otherwise `trust` would no-op while sends still quarantine.
  if (rawArgs[0] === "hooks") {
    const hooksEnv = {
      ...loadEnv(join(configDir, ".env")),
      ...process.env,
    }
    const code = runHooksCli(rawArgs, home, hooksEnv)
    if (code !== null) process.exit(code)
  }

  // `tg voice setup` — (re)configure inbound voice transcription (STT). Probes
  // the host for an existing local Whisper (~/xp first), persists the discovered
  // runner/model/language into config.yaml, and prints the guidance. Delegated
  // to `tg-ctl voice-setup` so the probe + persist logic lives in ONE place.
  // EXACT match only: bare `tg voice` (1 token) or `tg voice setup` (2 tokens).
  // A longer first arg like `tg voice setup is done` is an ordinary message and
  // must still send — hence the length guard, not just `rawArgs[1] === "setup"`.
  if (
    rawArgs[0] === "voice" &&
    (rawArgs.length === 1 || (rawArgs.length === 2 && rawArgs[1] === "setup"))
  ) {
    const result = Bun.spawnSync([join(import.meta.dir, "tg-ctl"), "voice-setup"], {
      stdout: "inherit",
      stderr: "inherit",
      timeout: 60_000,
    })
    process.exit(result.exitCode ?? 1)
  }

  // `tg help [<topic>]` — standard topic-help (the ecosystem convention; NOT a
  // bespoke `--format-help` flag). `tg help format` prints the message-formatting
  // reference; `tg help` (no/unknown topic) prints the main help, which lists the
  // available topics. Exact leading-token match only, so `tg "help me"` (a longer
  // first token followed by prose) still sends as an ordinary message. The
  // `--format-help` flag is kept as a back-compat alias (handled via parseArgs).
  if (
    rawArgs[0] === "help" &&
    (rawArgs.length === 1 || (rawArgs.length === 2 && !rawArgs[1].startsWith("-")))
  ) {
    const topic = rawArgs[1]
    if (topic === "format") {
      console.log(colorizeHelp(formatHelp(), shouldColorize()))
      process.exit(0)
    }
    if (topic === "report") {
      console.log(colorizeHelp(REPORT_USAGE, shouldColorize()))
      process.exit(0)
    }
    if (topic === undefined) {
      console.log(colorizeHelp(USAGE, shouldColorize()))
      process.exit(0)
    }
    // A `tg help <unknown>` names a topic that does not exist — say so (3-part:
    // WHAT/WHY/HOW) on stderr and exit non-zero, rather than silently sending it.
    console.error(`Error: unknown help topic '${topic}'. Available topics: format, report. See \`tg help\`.`)
    process.exit(1)
  }

  // `tg user [list | find <query>] [flags]` — shorthand for `tg replies user`.
  // Exact-match leading token only, so `tg "user ..."` as a plain message sends.
  if (rawArgs[0] === "user") {
    process.argv.splice(2, 1, "replies", "user")
    rawArgs.splice(0, 1, "replies", "user")
  }

  // `tg replies ...` — recall what was sent over Telegram (the CTO's "вспомнить
  // что писал пользователь"). Reads the daemon's append-only history.jsonl,
  // defaults to THIS tmux pane's session + inbound (user) messages. Exact-match
  // leading token only, so `tg "replies ..."` as a plain message still sends.
  // Returns null when argv is not a replies subcommand → fall through to send.
  if (rawArgs[0] === "replies") {
    // Resolve the bot id from the SAME config dir whose history we read (now the
    // one shared `configDir` above), so an alternate TG_CTL_CONFIG_DIR can't mix
    // a different dir's token with a different dir's history file. process.env
    // still wins over the dir's `.env`.
    const repliesEnv = {
      ...loadEnv(join(configDir, ".env")),
      ...process.env,
    }
    const botToken = repliesEnv.TG_BOT_TOKEN ?? ""
    const repliesPaths = ctlPaths(configDir, botIdFromToken(botToken))
    const historyPath = repliesPaths.history
    const detectRepliesPane = (): string | null => {
      const pane = process.env.TMUX_PANE
      return pane && pane.length > 0 ? pane : null
    }
    // The real `tmux list-panes` spawn for `--session <windowName>` resolution
    // lives HERE (the entrypoint owns I/O); features/replies/window.ts stays pure
    // and just parses this output. pane_id FIRST + TAB so space-containing window
    // names survive the split.
    const runTmuxListPanes = (): { exitCode: number; stdout: string } | null => {
      try {
        const res = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{window_name}"], {
          stdout: "pipe",
          stderr: "pipe",
        })
        return { exitCode: res.exitCode, stdout: new TextDecoder().decode(res.stdout) }
      } catch {
        return null // tmux binary not on PATH
      }
    }
    const code = runReplies(rawArgs, {
      readHistory: () => {
        try {
          return readFileSync(historyPath, "utf8")
        } catch {
          return null
        }
      },
      detectPane: detectRepliesPane,
      // The reader's OWN agent name (this pane's window/project) — the default
      // `current` scope filters history to it. SAME derivation the daemon stamps
      // as targetAgent, so the default view actually matches the tagged rows.
      currentAgent: currentPaneAgentName,
      // The registry view + this session's key: the default scope is the SESSION,
      // so a rename never splits its history (spec §3.3, tg-cli#460).
      sessions: () => {
        const reg = readSessionRegistry(repliesPaths.sessions)
        if (reg.sessions.length === 0) return null
        return {
          sessions: reg.sessions.map((e) => ({ key: e.key, name: e.name.primary, aliases: e.aliases })),
          current: ownSessionKey(reg, detectAncestorAgent()),
        }
      },
      // `--session ext` → the pane ids of every tmux window named exactly "ext".
      resolveWindow: (name: string) => resolveWindowPanes(name, runTmuxListPanes),
      // Local time (Europe/Belgrade for the CTO) — matches the daemon's wrap.
      fmtTime: (unixSec: number) => {
        const d = new Date(unixSec * 1000)
        const p = (n: number): string => String(n).padStart(2, "0")
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
      },
      log: (m) => console.log(m),
      errlog: (m) => console.error(m),
    })
    if (code !== null) process.exit(code)
  }

  // `tg report --title … (--ticket … | --pr …) --impact … --verify-cmd … --verify-result …`
  // — formats a structured result report and re-enters the normal send pipeline
  // with --tag report --format html (features/cli/report.ts owns the pure
  // parsing/formatting; this block owns I/O + argv splicing, same shape as the
  // `user`/`replies` subcommands above). Exact leading-token match; second token
  // must be "-h" or a real "--flag" (or absent) — so `tg report failure` as
  // prose still sends, and so does prose starting with a single dash like
  // `tg report -50% latency regression` (buildReportSend itself only ever
  // accepts "-h"/"--help" or a "--"-prefixed flag, so the guard mirrors that
  // exactly instead of engaging on any leading "-").
  if (
    rawArgs[0] === "report" &&
    (rawArgs.length === 1 || rawArgs[1] === "-h" || rawArgs[1].startsWith("--"))
  ) {
    const result = buildReportSend(rawArgs.slice(1))
    if (isReportHelp(result)) {
      console.log(colorizeHelp(result.help, shouldColorize()))
      process.exit(0)
    }
    if (isReportError(result)) {
      console.error(result.error)
      process.exit(1)
    }
    process.argv.splice(2, process.argv.length - 2, ...result.argv)
    rawArgs.splice(0, rawArgs.length, ...result.argv)
  }

  // Resolve feature flags FIRST: pull --feature/--no-feature out of argv, load
  // ~/.config/tg-cli/config.yaml, and merge (default → config → CLI). The
  // result gates auto-attach. The transmitter safety nets (caption overflow +
  // 4096 split) are NOT a feature and always run.
  const flagResult = applyFeatureFlags(rawArgs)
  if (flagResult.error) {
    console.error(`Error: ${flagResult.error}`)
    console.error(colorizeHelp(USAGE, shouldColorize({ isTTY: Boolean(process.stderr.isTTY) })))
    process.exit(1)
  }
  // config.yaml is read ONCE; the raw text feeds both the features: block
  // parser here and the control: block parser for tg-ctl auto-start below.
  const configYamlRaw = (() => {
    try {
      return readFileSync(join(home, ".config", "tg-cli", "config.yaml"), "utf8")
    } catch {
      return ""
    }
  })()
  const featureConfig = parseFeatureConfig(configYamlRaw)
  const features = resolveFeatures(featureConfig, {
    enable: flagResult.enable,
    disable: flagResult.disable,
  })
  const autoAttachOn = features["auto-attach"] !== false
  const attachDenylistOn = features["attach-denylist"] !== false
  const floodCapOn = features["flood-cap"] !== false

  const args = flagResult.rest
  // Memoize the worktree-root enumeration: git is spawned at most once per
  // process, and only when a path-like token actually misses plain resolution
  // (parseArgs calls this thunk lazily inside the auto-attach scan).
  let worktreeRootsCache: string[] | null = null
  const getWorktreeRoots = (): string[] => {
    if (worktreeRootsCache === null) {
      worktreeRootsCache = enumerateWorktreeRoots(process.cwd(), runGitReal)
    }
    return worktreeRootsCache
  }
  const recursiveAttachOn = features["recursive-attach"] !== false
  // Same flag the body-detection call below gates on (`features["autolink-msgrefs"] !== false`)
  // — threaded into parseArgs so the --title guard honours a disabled feature identically
  // (tg-cli#138 review finding on PR #139: --title must not ban a literal the body allows).
  const msgrefAutolinkOn = features["autolink-msgrefs"] !== false
  // Stray-CJK guard (feature `cjk-guard`, ON by default): checked below on the
  // final decoded caption/title, right before send.
  const cjkGuardOn = features["cjk-guard"] !== false
  const screenshotGuardOn = features["screenshot-guard"] !== false
  // Same flag the body-detection `detectTicketCodesExpanded` call below gates on — threaded so
  // the --title HYP-<id> guard honours a disabled feature identically to the body.
  const ticketAutolinkOn = features["autolink-tasks"] !== false
  const parsed = parseArgs(
    args,
    process.cwd(),
    home,
    autoAttachOn,
    getWorktreeRoots,
    attachDenylistOn,
    recursiveAttachOn,
    undefined,
    msgrefAutolinkOn,
    ticketAutolinkOn,
  )

  // No-send actions resolve BEFORE the credential gate so help/version/info
  // flags work without Telegram credentials configured.
  if (parsed.action === "help") {
    console.log(colorizeHelp(USAGE, shouldColorize()))
    process.exit(0)
  }
  if (parsed.action === "version") {
    console.log(versionOutput(import.meta.dir))
    process.exit(0)
  }
  if (parsed.action === "formatHelp") {
    console.log(colorizeHelp(formatHelp(), shouldColorize()))
    process.exit(0)
  }
  if (parsed.action === "error") {
    console.error(`Error: ${parsed.message}`)
    // Errors go to stderr; colorize only when stderr is the terminal.
    console.error(colorizeHelp(USAGE, shouldColorize({ isTTY: Boolean(process.stderr.isTTY) })))
    process.exit(1)
  }

  const configEnv = loadEnv(join(configDir, ".env"))
  const env = { ...configEnv, ...process.env }

  // Override embeddable emoji IDs with env vars if provided. Runs before any
  // info-flag handler so --ls-emoji-helpers reflects overrides + emits warnings.
  if (env.TG_EMOJI_IDS) {
    try {
      const parsedIds = JSON.parse(env.TG_EMOJI_IDS)
      if (parsedIds !== null && typeof parsedIds === "object" && !Array.isArray(parsedIds)) {
        for (const [model, id] of Object.entries(parsedIds)) {
          if (["__proto__", "constructor", "tostring", "valueof"].includes(model.toLowerCase())) {
            console.error(`Warning: Rejecting reserved key in TG_EMOJI_IDS: ${model}`)
            continue
          }
          if (typeof id === "string" && /^\d{19}$/.test(id)) {
            EMBEDDABLE_EMOJI_MAP[model] = id
          } else if (typeof id === "string") {
            console.error(`Warning: Ignoring invalid emoji ID in TG_EMOJI_IDS for ${model}: ${id} (expected 19 digits)`)
          } else {
            console.error(`Warning: Ignoring non-string emoji ID in TG_EMOJI_IDS for ${model}: ${id} (expected string)`)
          }
        }
      } else {
        console.error("Warning: TG_EMOJI_IDS must be a JSON object, not an array or primitive")
      }
    } catch {
      console.error("Warning: TG_EMOJI_IDS contains invalid JSON, using default emoji IDs")
    }
  }
  for (const [key, val] of Object.entries(env)) {
    if (key.startsWith("TG_EMOJI_ID_")) {
      const model = key.slice("TG_EMOJI_ID_".length).toLowerCase()
      if (model && !["__proto__", "constructor", "tostring", "valueof"].includes(model)) {
        if (val && /^\d{19}$/.test(val)) {
          EMBEDDABLE_EMOJI_MAP[model] = val
        } else {
          console.error(`Warning: Ignoring invalid emoji ID for ${model}: ${val} (expected 19 digits)`)
        }
      } else if (model && ["__proto__", "constructor", "tostring", "valueof"].includes(model)) {
        console.error(`Warning: Rejecting reserved key in TG_EMOJI_ID_${model}: ${val}`)
      }
    }
  }

  // --- AI model detection ---

  // The opencode session's actual model name, read from `opencode debug
  // config` (single provider model wins; a '*router*' id preferred over an
  // arbitrary first). null when unreadable — the caller decides the fallback.
  const opencodeModelFromConfig = (): string | null => {
    try {
      const result = Bun.spawnSync(["opencode", "debug", "config"], {
        stdout: "pipe",
        stderr: "pipe",
        // Branding-only read: a wedged opencode binary must never block a
        // send — on timeout the kill makes exitCode non-zero → null below.
        timeout: 2000,
        killSignal: "SIGKILL",
      })
      if (result.exitCode !== 0) return null
      const cfg = JSON.parse(new TextDecoder().decode(result.stdout))
      const providers = cfg.provider || {}
      for (const [_name, p] of Object.entries(providers)) {
        const prov = p as { models?: Record<string, unknown> }
        if (!prov.models) continue
        const ids = Object.keys(prov.models)
        const short = (fullId: string) => (fullId.includes('/') ? (fullId.split('/').pop() || fullId) : fullId)
        if (ids.length === 1) return short(ids[0])
        const router = ids.find((id) => id.includes("router"))
        if (router) return short(router)
        return short(ids[0])
      }
    } catch {
      // ignore — unreadable config
    }
    return null
  }

  // Precedence: explicit env override → process LINEAGE (the agent that
  // actually launched this tg) → env-marker fallbacks (CLAUDECODE → OPENCODE
  // → CODEX) → pgrep fallbacks. Lineage leads because env vars are
  // INHERITABLE: an agent spawned inside another agent's pane carries the
  // outer agent's markers (omp exports CLAUDECODE=1 via its pi heritage —
  // #246; a claude session inside an opencode pane inherits OPENCODE). The
  // nearest recognizable ancestor is the truth in those topologies. The env
  // markers remain the fallback for detached spawns whose launcher is not in
  // the process tree. Runs once per process (MODEL below), so the ps walk is
  // paid once per send, not per message part.
  const detectAiModel = (): string => {
    // 1. Explicit env var wins
    if (env.TG_AI_MODEL) return env.TG_AI_MODEL

    // 2. Walk the ancestor process tree. An agent that launched `tg` as a
    // subprocess (codex, aider, pi, opencode, omp, claude) is the real sender
    // even when it exports no env marker — codex notably sets neither CODEX
    // nor CODEX_HOME for the shell commands it runs. An opencode ancestor is
    // refined to the session's actual model name (config read), falling back
    // to the generic kind when unreadable.
    const ancestorAgent = detectAgentViaAncestry()
    if (ancestorAgent === "opencode") return opencodeModelFromConfig() ?? "opencode"
    if (ancestorAgent) return ancestorAgent

    // 3. Env-marker fallbacks (no recognizable ancestor — detached spawn, or
    // the launcher is not a known agent). The chain keeps the PRE-EXISTING
    // relative order (CLAUDECODE → OPENCODE → CODEX) — the smallest possible
    // behavior delta. The hop argument behind it covers the OBSERVED nesting
    // (claude inner): CLAUDECODE is self-published by the inner agent (one
    // hop), OPENCODE/CODEX are inherited from an outer pane (two hops). The
    // reverse nesting in a DETACHED spawn (opencode inner, claude outer) is
    // mislabeled by this order — accepted, lineage-first already covers the
    // attached case. OPENCODE still refines to the config model name; an
    // unreadable config falls through to CODEX (never to the pgrep block,
    // where a background `ollama` daemon would otherwise win) and finally to
    // the generic kind. CLAUDECODE ahead of pgrep covers the original ollama
    // hazard for claude sessions. KNOWN LIMITATION (#246): a DETACHED spawn
    // from an omp session lands here with only CLAUDECODE=1 (omp sets no
    // marker of its own — verified live: no OMP_* in the process env) and
    // brands claude; only attached spawns brand omp.
    if (env.CLAUDECODE || env.CLAUDE_CODE_ENTRYPOINT) return "claude"
    if (env.OPENCODE) {
      const model = opencodeModelFromConfig()
      if (model) return model
      if (env.CODEX) return "codex"
      return "opencode"
    }
    if (env.CODEX) return "codex"

    // 4. Detect other known CLI tools
    if (isProcessRunning("aider")) return "aider"
    if (isProcessRunning("cursor")) return "cursor"
    if (isProcessRunning("windsurf")) return "windsurf"
    if (isProcessRunning("llama")) return "llama"
    if (isProcessRunning("ollama")) return "ollama"
    if (isProcessRunning("opencode") || isProcessRunning("opencode.exe")) return "opencode"

    return ""
  }

  const MODEL = detectAiModel()

  const detectAiEmoji = (): string => {
    // 1. Explicit env var wins
    if (env.TG_AI_EMOJI) return env.TG_AI_EMOJI

    // 2. Derive from detected model name
    if (MODEL) {
      const base = extractBaseModel(MODEL)
      // typeof guard, not truthiness: prototype keys ('constructor', …) are
      // truthy non-strings on a plain object map and must fall through.
      const exact = MODEL_EMOJI_MAP[base]
      if (typeof exact === 'string') return exact
      // Fallback to substring matching for partial matches — minus the
      // SUBSTRING_FALLBACK_EXCLUDED_KEYS (short substrings like 'omp' would
      // misbrand unrelated names such as 'computer-use-preview').
      for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
        if (SUBSTRING_FALLBACK_EXCLUDED_KEYS.has(key)) continue
        if (base.includes(key)) return emoji
      }
    }

    // Unknown / undeterminable model (e.g. an opencode session whose inner model
    // couldn't be read) — a neutral folder icon rather than misbranding.
    return "📁"
  }

  const AI_EMOJI = detectAiEmoji()

  // --- Session name → the `[window]` header bracket + the auto `--title` badge ---
  // ONE resolver (resolveSessionName, tg-cli#455) names the session everywhere —
  // this header, the /agent picker, `tg-ctl status`, history. In tmux the PRIMARY
  // name is the tmux window name (a bare auto-rename default falls back to the cwd
  // project → `rig-cli`, not `2.1.207`) and the harness's own session title is the
  // SECONDARY name, rendered as the auto `--title` badge — never a substitute for
  // the window (Alex escalation point 5: "[Fix Missing Provisioned Skills in Rig]"
  // with no tmux window shown). Outside tmux the harness title IS the primary name.
  // `null` = not in tmux, or tmux could not resolve this pane (tg-cli#448: that
  // edge used to print a false literal "no tmux" from inside a real pane). tmux 3.5a
  // answers `display-message -t <gone pane>` with exit 0 and EMPTY fields, and a live
  // pane always has a pane_current_path — so an empty answer is "unresolved" too.
  const getTmuxPane = (): { windowName: string; panePath: string } | null => {
    const pane = process.env.TMUX_PANE
    if (!process.env.TMUX || !pane) return null
    try {
      const result = Bun.spawnSync(
        ["tmux", "display-message", "-p", "-t", pane, "#{window_name}\t#{pane_current_path}"], {
        stdout: "pipe",
        stderr: "pipe",
      })
      if (result.exitCode === 0) {
        const raw = new TextDecoder().decode(result.stdout).replace(/\r?\n$/, "")
        const tab = raw.indexOf("\t")
        const windowName = tab >= 0 ? raw.slice(0, tab) : raw
        const panePath = tab >= 0 ? raw.slice(tab + 1) : ""
        if (windowName || panePath) return { windowName, panePath }
      }
    } catch {
      // ignore — tmux not available or not in a pane
    }
    return null
  }

  // The harness title a non-omp agent (Claude Code: `✳ <title>`) paints into its tmux
  // pane title; '' when the pane title carries no harness mark (e.g. the host name).
  const getPaneTitle = (): string => {
    const pane = process.env.TMUX_PANE
    if (!process.env.TMUX || !pane) return ""
    try {
      const result = Bun.spawnSync(["tmux", "display-message", "-p", "-t", pane, "#{pane_title}"], {
        stdout: "pipe",
        stderr: "pipe",
      })
      return result.exitCode === 0 ? titleFromPaneTitle(new TextDecoder().decode(result.stdout)) : ""
    } catch {
      return ""
    }
  }

  // The omp session's own title + cwd, from its primary session jsonl (`type:title` /
  // `session.title`, `session.cwd`) found via lsof on the omp pid.
  const getOmpSession = (ompPid: number | null): { title: string; cwd: string } => {
    if (ompPid === null) return { title: "", cwd: "" }
    try {
      const lsof = Bun.spawnSync(["lsof", "-a", "-p", String(ompPid), "-Fn", "-n", "-P"], {
        stdout: "pipe",
        stderr: "pipe",
      })
      if (lsof.exitCode !== 0) return { title: "", cwd: "" }
      const paths = parseLsofJsonlPaths(new TextDecoder().decode(lsof.stdout))
      const sessionFile = pickPrimaryOmpSessionFile(paths)
      if (!sessionFile) return { title: "", cwd: "" }
      const meta = parseOmpSessionMeta(readFileSync(sessionFile, "utf8"))
      return { title: meta.title ?? "", cwd: meta.cwd ?? "" }
    } catch {
      return { title: "", cwd: "" }
    }
  }

  // --- Emoji helpers listing ---
  const listEmojiHelpers = (): string => {
    const lines = [
      "Available emoji helpers:",
      "",
    ]
    for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
      const id = EMBEDDABLE_EMOJI_MAP[key]
      if (id) {
        lines.push(`  :${key}: → ${emoji} <tg-emoji emoji-id="${id}">`)
      } else {
        lines.push(`  :${key}: → ${emoji} (no emoji-id set — add TG_EMOJI_ID_${key})`)
      }
    }
    lines.push("")
    lines.push("Set emoji IDs via env vars:")
    lines.push("  TG_EMOJI_ID_claude=5274170649227600531")
    lines.push("  TG_EMOJI_IDS='{\"claude\":\"5274170649227600531\",\"codex\":\"5273797309195393626\"}'")
    return lines.join("\n")
  }

  // Info-only flags inspect local state and send nothing, so they must work
  // without Telegram credentials configured. Resolve them before the gate.
  if (parsed.action === "lsEmojiHelpers") {
    console.log(listEmojiHelpers())
    process.exit(0)
  }
  if (parsed.action === "detectModel") {
    console.log(`${MODEL || "(none)"}\t${AI_EMOJI || "(none)"}`)
    process.exit(0)
  }
  // Resolve the window label only from here on: the `--detect-agent` info action
  // and the real send need it, but the emoji/model info flags above must NOT
  // pay for ps/lsof/tmux subprocesses they never read.
  const ancestor = detectAncestorAgent()
  const ompAncestorPid = ancestor?.agent === "omp" ? ancestor.pid : null
  const tmuxPane = getTmuxPane()
  const ompSession = getOmpSession(ompAncestorPid)
  // omp's adapter title wins; any other agent's title comes from its pane title.
  const harnessTitle = ompSession.title || (ancestor && ancestor.agent !== "omp" ? getPaneTitle() : "")
  // A session identity exists inside tmux or under an agent ancestor. A bare,
  // non-agent invocation outside tmux (a cron job, a plain script) gets NO bracket.
  const hasSessionIdentity = tmuxPane !== null || Boolean(process.env.TMUX) || ancestor !== null
  const sessionNameFor = (title: string) =>
    hasSessionIdentity
      ? resolveSessionName({
          tmuxWindow: tmuxPane?.windowName ?? null,
          cwd: tmuxPane?.panePath || ompSession.cwd || process.cwd(),
          harnessTitle: title,
        })
      : { primary: "", secondary: null }
  if (parsed.action === "detectAgent") {
    // The auto `[window]` label this session's messages get with no flag (the
    // resolver's primary name, or "(none)"), and the harness title on a second line
    // when it is shown as the secondary name. There is NO env-based subagent
    // auto-detection; a subagent self-labels with `--subagent`.
    const name = sessionNameFor(harnessTitle)
    console.log(name.primary || "(none)")
    if (name.secondary) console.log(`title: ${name.secondary}`)
    process.exit(0)
  }

  // --- Escalation-format gate (DENY-BY-DEFAULT) --------------------------
  // parseArgs attaches `escalationWarning` when a --tag decision send
  // does not follow the decision-request format. By DEFAULT this is a hard stop
  // (exit 1): the escalation format is REQUIRED. ESCALATION_GATE_ENFORCE=0 is the
  // one documented escape — it downgrades to advisory (warn + proceed). Placed
  // BEFORE the credential gate so a block reports the format problem first (and
  // so the block path is observable in a no-creds subprocess test). The --table
  // path bypasses THIS parse-time gate (stdin unseen) and is validated on the
  // final rendered body further below. See args.ts for the validator wiring.
  // `escalationWarning` is only ever attached by the escalation-format gate,
  // which TAG_GATES registers for ESCALATION_TAGS entries alone — so `tag` is
  // always set here; the narrowing guard keeps that explicit rather than
  // fabricating a tag word for the Blocked line.
  if (parsed.action === "send" && parsed.escalationWarning && parsed.tag !== undefined) {
    enforceEscalationGate(parsed.escalationWarning, parsed.tag, env)
  }

  const BOT_TOKEN = env.TG_BOT_TOKEN
  const CHAT_ID = env.TG_CHAT_ID
  const CHAT_ID_NUMBER = Number(CHAT_ID)
  const currentChatId = Number.isFinite(CHAT_ID_NUMBER) ? CHAT_ID_NUMBER : undefined

  // --dry-run needs no credentials at all: it never reaches the network, so an
  // agent can iterate against the escalation-format gate (or any other guard
  // below) without TG_BOT_TOKEN/TG_CHAT_ID configured.
  if (!parsed.dryRun && (!BOT_TOKEN || !CHAT_ID)) {
    console.error("Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ~/.config/tg-cli/.env")
    process.exit(1)
  }

  // Honor TG_API_BASE (default api.telegram.org) — same as the tg-ctl daemon — so a test
  // harness can point the OUTBOUND sender at a mock Bot-API server (review qa bot harness).
  const API = `${process.env.TG_API_BASE || "https://api.telegram.org"}/bot${BOT_TOKEN}`

  const { items, caption: rawCaption, format, title: explicitTitle, tag, subagent, withOriginal, noPdf, pdfDevice, replyTo, topic, table, dryRun } = parsed
  // The harness session title (secondary name in tmux, primary outside it) is
  // auto content — but the content guards below (CJK/mixed-script,
  // screenshot-mention, dictionary) must enforce ONLY on text the AGENT actually
  // typed, matching their documented scope. `safeHarnessTitle` starts as the
  // candidate and each guard DROPS it (never hard-fails) on a hit — the user did
  // not author the session's own auto-generated title and cannot fix it, so it
  // must never be able to block an otherwise-clean outgoing message (review
  // finding). The session name is resolved from it after every guard below.
  let safeHarnessTitle = harnessTitle

  // The optional SECOND `[name]` bracket is a SUBAGENT self-label — explicit
  // only. `--subagent <name>` (parsed to `subagent`) wins; the `TG_AGENT` env is
  // the same-precedence fallback for a subagent that sets it once in its shell.
  // The MAIN/orchestrator agent passes neither and gets NO second bracket — its
  // identity is the `[window]` label (the session's primary name) above. There is deliberately NO
  // env-based auto-detection: `CLAUDE_CODE_CHILD_SESSION` is not a reliable
  // main-vs-subagent signal, so a guessed `[subagent]` bracket is never emitted.
  const AGENT_LABEL = subagent || env.TG_AGENT?.trim() || undefined

  // Forum-topic thread id (docs/specs/tg-forum-topics.md §8): the explicit
  // `--topic <id>` flag wins; otherwise fall back to the TG_TOPIC env (merged
  // config `.env` → process.env, same precedence as the credentials). A
  // malformed TG_TOPIC is IGNORED (logged) rather than fatal — the env is an
  // ambient default an agent's shell may inherit stale, and a daily-critical
  // send must never die because of it; the message simply goes to General. An
  // explicit `--topic` was already validated to a positive int at parse time.
  let messageThreadId: number | undefined = topic
  // An EXPLICIT --topic is strict (a thread error surfaces). A topic taken from
  // the TG_TOPIC env is ADVISORY: an agent's shell may have inherited a stale /
  // closed / foreign id, so a thread rejection must fall back to General rather
  // than kill the send (handled in the transport via threadIdAdvisory).
  let threadIdAdvisory = false
  if (messageThreadId === undefined && env.TG_TOPIC) {
    // A launcher/daemon that writes TG_TOPIC via a file or with a trailing
    // newline would otherwise fail the regex and silently degrade to General;
    // trim first (the --topic flag arrives as its own argv token, no trim needed).
    const rawTopic = env.TG_TOPIC.trim()
    if (/^[1-9][0-9]*$/.test(rawTopic)) {
      messageThreadId = Number(rawTopic)
      threadIdAdvisory = true
    } else {
      // Strip control chars before logging an env value (avoid log-injection via
      // a crafted TG_TOPIC); the message is for the local terminal only.
      const safe = rawTopic.replace(/[^\x20-\x7e]/g, "?").slice(0, 64)
      console.error(`tg: ignoring invalid TG_TOPIC '${safe}' (expected a positive topic id) — posting to General`)
    }
  }

  // `tg --table`: read delimited rows from stdin, render an aligned <pre>
  // monospace table (Telegram has no native HTML tables), and use it as the
  // message body. Any argv text becomes a heading ABOVE the table; the table
  // forces HTML format so the <pre> renders. Double-width glyphs (emoji/CJK) in
  // a cell can push columns out of alignment — warn but still send.
  let caption: string
  let effectiveFormat: Format = format
  // The agent-AUTHORED text for the dictionary gate below, each piece tagged
  // with how Telegram will render it (the gate matches what the reader SEES).
  // For a --table send that is the heading (in the caller's format) plus the
  // raw stdin rows as PLAIN text (they are rendered escaped inside <pre>), NOT
  // the rendered block — the gate exempts <pre>/<code> contents in HTML, and
  // the table wrapper must not turn every cell into a quote. For a text send
  // it is the caption in the caller's format; a pipe-table auto-conversion
  // escapes the caller's plain text, so it stays plain here.
  let dictFields: DictionaryField[]
  if (table) {
    const stdinRaw = await Bun.stdin.text()
    if (stdinRaw.trim() === "") {
      console.error(
        "Error: --table reads rows from stdin but got none. " +
          "Pipe TSV or `a | b` lines, e.g.  printf 'task\\tstatus\\nship\\tdone' | tg --table",
      )
      process.exit(1)
    }
    const rendered = toTablePre(stdinRaw)
    if (rendered.hasWide) {
      console.error(
        "tg: --table: a cell contains a double-width glyph (emoji/CJK) — columns may not align " +
          "in the monospace block. Keep cells ASCII/Cyrillic for clean alignment.",
      )
    }
    // The table is HTML (a <pre> block), so the whole message goes out as HTML.
    // The argv heading is plain user text — escape it UNLESS the user explicitly
    // asked for --format html (then they own their own markup). Without this a
    // heading like "size < 10" would break HTML parsing once the <pre> forces
    // HTML mode on the combined caption.
    const rawHeading = decodeTextEscapes(rawCaption)
    const heading = format === "html" ? rawHeading : escapeHtml(rawHeading)
    caption = heading ? `${heading}\n${rendered.html}` : rendered.html
    effectiveFormat = "html"
    dictFields = [
      { label: "table heading", text: rawHeading, format },
      { label: "table rows", text: stdinRaw, format: "plain" },
    ]
  } else {
    caption = decodeTextEscapes(rawCaption)
    // Same implicit-HTML upgrade renderText uses later: a body that contains a
    // Telegram-supported tag is sent as HTML even without --format html, so the
    // dictionary must match what the reader SEES (tags stripped / <code> exempt).
    // A non-tag like <скамейка> stays plain — detectHtmlTags ignores unknown tags.
    const dictFormat = format === "html" || detectHtmlTags(caption) ? "html" : "plain"
    dictFields = [{ label: items.length > 0 ? "caption" : "body", text: caption, format: dictFormat }]
    // Auto-convert a markdown pipe table typed directly in the body to a real
    // Telegram <table> (Telegram renders NO markdown tables — a `| a | b |` grid
    // arrives as plain text). Escalation messages, and the escalation gate's own
    // suggested example, use markdown pipes, so without this they arrive broken
    // ("таблица сломана"). Non-table lines are HTML-escaped for a plain-text send
    // (the resulting <table> forces HTML mode); left untouched when the caller
    // already asked for --format html and owns their markup.
    if (detectTableKind(caption) === "pipe") {
      const escaper = format === "html" ? (s: string): string => s : escapeHtml
      const conv = pipeTableToHtml(caption, escaper)
      if (conv.converted) {
        caption = conv.html
        effectiveFormat = "html"
      }
    }
  }

  if (shouldWarnLongUnstructuredPlainMessage({ text: caption, format, table, items })) {
    console.error(LONG_UNSTRUCTURED_MESSAGE_WARNING)
  }

  // Stray-CJK guard (feature `cjk-guard`, ON by default): hard-block a send that
  // carries a LONE CJK/ideographic codepoint stuck mid-word into otherwise
  // Latin/Cyrillic text (the "hieroglyph in a normal word" bug). Runs HERE — on
  // the caption (escapes resolved, --table body assembled) and the --title (as-
  // is: buildPrefix renders it verbatim), i.e. the text the AGENT AUTHORED.
  //
  // SCOPE (deliberate, not an oversight): the bug originates in the agent's own
  // typed message, so the guard checks exactly that. It intentionally runs
  // BEFORE the autolink/line-spec pass appends externally-sourced excerpts
  // (Linear/GitHub titles, tg# message quotes, file-sourced line-spec snippets);
  // CJK in that external content is legitimate and must NOT be blocked. It also
  // scans raw markup for a `--format html` message rather than the rendered
  // visible text — an LLM garble is a raw codepoint in prose, which this covers;
  // an HTML entity / tag-split hieroglyph is out of scope. Quoted/code content is
  // NOT exempted (the guard can't tell a quoted garble from a real one) — use
  // `--no-feature cjk-guard` for the rare legitimately-CJK message. See
  // features/cli/cjk-guard.ts.
  if (cjkGuardOn) {
    for (const text of [caption, explicitTitle ?? ""]) {
      if (!text) continue
      const stray = findStrayCjk(text)
      if (stray) {
        console.error(`Error: ${formatStrayCjkError(stray)}`)
        process.exit(1)
      }
      // Same feature, same gate: a homoglyph/mojibake "garbage word" that mixes
      // Cyrillic with a foreign alphabet in ONE token (e.g. "почčesна") is the
      // same "garbled token slipped in" class. See features/cli/mixed-script-guard.ts.
      const mixed = findMixedScriptTokens(text)
      if (mixed) {
        console.error(`Error: ${formatMixedScriptError(mixed)}`)
        process.exit(1)
      }
    }
    // The harness-title candidate gets the SAME checks, but a hit silently
    // drops it (see the comment on `safeHarnessTitle` above) instead of
    // exiting.
    if (safeHarnessTitle && (findStrayCjk(safeHarnessTitle) || findMixedScriptTokens(safeHarnessTitle))) {
      safeHarnessTitle = ""
    }
  }

  // Screenshot-attach gate (feature `screenshot-guard`, ON by default): a
  // caption/--title that mentions screenshot/скриншот with no photo attached
  // is a hard error before dry-run/transmit (tg-cli#337). Runs HERE so
  // --dry-run also catches it. A --photo (or auto-attached image) in `items`
  // skips the gate — that path already has a file. Documents do not count.
  // A photo item whose path is missing/empty is later skipped by
  // checkAttachmentFile and the caption still goes out as text — that is
  // NOT an attached image (review finding on tg-cli#337). Only a real
  // on-disk non-empty photo file counts.
  const hasAttachedPhoto = items.some((it) => {
    if (it.type !== "photo") return false
    try {
      const st = statSync(it.path)
      return st.isFile() && st.size > 0
    } catch {
      return false
    }
  })
  if (screenshotGuardOn && !hasAttachedPhoto) {
    for (const text of [caption, explicitTitle ?? ""]) {
      if (!text) continue
      if (mentionsScreenshot(text)) {
        console.error(`Error: ${formatScreenshotAttachError()}`)
        process.exit(1)
      }
    }
    if (safeHarnessTitle && mentionsScreenshot(safeHarnessTitle)) safeHarnessTitle = ""
  }

  // Dictionary gate (tg-cli#302, ALWAYS on, no bypass flag): refuse to send a
  // message carrying a banned word from the shared dictionary
  // (~/.claude/DICT.json, override: $TG_DICT_PATH), printing every hit with the
  // rule id, the matched text in context and the replacement. Runs on the SAME
  // agent-authored text as the guards above (the --title and the caption / the
  // raw --table rows) and BEFORE the dry-run short-circuit, so --dry-run runs
  // the identical check and a refusal never touches the network. A MISSING file
  // disables the gate silently; a malformed / unreadable one refuses every send
  // until fixed (fail closed — a silently dead gate is how the words leak). One
  // readFileSync, ENOENT → absent: not existsSync-then-read (TOCTOU). Only
  // ENOENT at the DEFAULT path means "absent": an EXPLICIT TG_DICT_PATH that
  // does not exist, or ENOTDIR (a path component is a file), is a
  // misconfiguration — and would otherwise be the agent's own off-switch — so
  // it refuses. Reads the MERGED config env (`~/.config/tg-cli/.env` under the
  // real environment), like every other TG_* setting.
  // See features/cli/dict-gate.ts.
  const dictLocation = resolveDictionaryPath(env)
  if (dictLocation !== null) {
    const dictPath = dictLocation.path
    let dictRaw: string | null = null
    try {
      dictRaw = readFileSync(dictPath, "utf8")
    } catch (e) {
      const code = (e as NodeJS.ErrnoException).code
      if (code === "ENOENT" && dictLocation.explicit) {
        console.error(`Error: dictionary ${dictPath} (TG_DICT_PATH) does not exist. ${FAIL_CLOSED_NOTE}`)
        process.exit(1)
      }
      if (code !== "ENOENT") {
        console.error(`Error: dictionary ${dictPath} cannot be read (${code ?? String(e)}). ${FAIL_CLOSED_NOTE}`)
        process.exit(1)
      }
    }
    const dict = loadDictionary(dictRaw, dictPath)
    if (dict.kind === "error") {
      console.error(`Error: ${dict.message}`)
      process.exit(1)
    }
    if (dict.kind === "ok") {
      // The --title and the --subagent label are header text the agent
      // authors; both are always plain (the header renderer escapes them).
      const hits = checkDictionary(dict.rules, [
        { label: "--title", text: explicitTitle ?? "", format: "plain" },
        { label: "--subagent", text: subagent ?? "", format: "plain" },
        ...dictFields,
      ])
      if (hits.length > 0) {
        console.error(formatDictionaryHits(hits, dictPath))
        process.exit(1)
      }
      // The harness-title candidate gets the SAME dictionary check, but a hit
      // silently drops it (see the `safeHarnessTitle` comment above) instead
      // of refusing the send.
      if (safeHarnessTitle && checkDictionary(dict.rules, [{ label: "harness-title", text: safeHarnessTitle, format: "plain" }]).length > 0) {
        safeHarnessTitle = ""
      }
    }
  }
  // Every content guard above has now either passed the harness-title candidate
  // or dropped it — resolve the session name from what survived (a dropped title
  // never leaks into the `[window]` bracket either; the cwd project stands in).
  // The primary name is the `[window]` bracket; the secondary name (the title,
  // in tmux) is the default header title. Decision (tg-cli#448): no `--no-title`
  // opt-out — the CTO asked to see the harness session name (2026-09-29) and the
  // content guards already drop an unfit title; an explicit `--title` replaces it.
  const sessionName = sessionNameFor(safeHarnessTitle)
  const title = explicitTitle ?? (sessionName.secondary || undefined)

  // Close the --table bypass: the parse-time gate (features/cli/args.ts) skips a
  // --table send because the rows arrive on stdin, which parseArgs never sees.
  // So for an ESCALATION sent via --table, validate the FINAL rendered body here
  // (a boxed table alone is not a decision-request: it still lacks a
  // recommendation, context, a file ref, and the section structure).
  if (tag !== undefined && isEscalationTag(tag) && table) {
    const fin = validateEscalationFormat(caption)
    if (fin.missing.length > 0) enforceEscalationGate(escalationFormatMessage(tag, fin.missing), tag, env)
  }

  // --- dry-run short-circuit --------------------------------------------
  // Everything above this point is LOCAL validation/rendering: the escalation-
  // format gate (parse-time + the --table final check just above), the
  // cjk/mixed-script guard, the screenshot-attach gate, the dictionary gate (on
  // the agent-authored caption text / table rows / header labels), and the
  // pipe-table→<table> conversion have all already run against the FINAL assembled
  // `caption`. A failing gate above
  // already exits(1) without ever reaching here or touching the network — the
  // gap this flag closes is the PASSING case: a structurally-compliant message
  // (right tags/table/pros-cons/file-ref) used to fall straight through to the
  // real send below, which is exactly how scaffold/placeholder drafts (an
  // agent testing whether its markup satisfies the strict gate) reached the
  // live chat — 6 real messages in one incident, one of them still carrying
  // the literal "foo bar baz test" / "Option A" / "ok"/"bad" placeholder text
  // from escalationFormatMessage's own example. --dry-run stops here: no
  // credential check, no autolink/network lookups below, no transport, no
  // send.
  //
  // Attachments (photo/file/PDF) are explicitly OUT OF SCOPE — the plan that
  // builds/converts them lives further below and is not exercised here. A
  // silent "OK" that only validated the text half of a photo+caption send
  // would be a false positive (review finding), so --dry-run with an
  // attachment is a hard error naming exactly what's unsupported, rather than
  // a partial, misleadingly-labeled pass.
  if (dryRun && items.length > 0) {
    console.error(
      `Error: --dry-run does not support attachments (${items.length} item(s): ` +
        `${items.map((it) => it.type).join(', ')}) — it only validates the TEXT body. ` +
        "Drop --photo/--file (or the auto-attached path in the text) to dry-run just the caption.",
    )
    process.exit(1)
  }
  if (dryRun) {
    console.log(
      `tg --dry-run: OK — message is well-formed (tag=${tag ?? "(none)"}, format=${effectiveFormat}). ` +
        "No network call was made and nothing was sent.",
    )
    // NOTE: this is the body as assembled so far (post table/pipe-table
    // conversion, pre-autolink) — autolink-tasks/autolink-msgrefs run AFTER
    // this point and can still rewrite it before a real send. It is the exact
    // text every guard above just validated, but it is not a byte-exact
    // preview of the final wire body.
    console.log("--- rendered body (pre-autolink) ---")
    console.log(caption)
    process.exit(0)
  }

  // `--tag` is validated at parse time (features/cli/args.ts → validateTag):
  // only the lowercase-english words (answer/decision/problem/report) reach
  // here, so there is no unknown-tag soft-render path to warn about — an invalid
  // tag already failed with a 3-part error and a non-zero exit.

  // --- autolink-tasks: detect ticket codes, verify them via the linear CLI ---
  // (docs/specs/autolink-tasks.md). One `linear api` spawn per send, and only
  // when the text actually contains ticket-like codes. Codes Linear doesn't
  // know simply don't come back and stay plain text. Every failure mode keeps
  // the send going unchanged: missing CLI / missing auth produce a ONE-TIME
  // stderr hint (state in ~/.config/tg-cli/autolink-tasks.json), anything else
  // a one-line warning.
  const AUTOLINK_STATE_PATH = join(home, ".config", "tg-cli", "autolink-tasks.json")
  const hintOnce = (kind: HintKind, message: string): void => {
    let raw: string | null = null
    try {
      raw = readFileSync(AUTOLINK_STATE_PATH, "utf8")
    } catch {
      raw = null
    }
    const state = parseHintState(raw)
    if (state[kind]) return
    console.error(message)
    try {
      mkdirSync(join(home, ".config", "tg-cli"), { recursive: true })
      writeFileSync(AUTOLINK_STATE_PATH, serializeHintState(markHint(state, kind)))
    } catch {
      // best-effort: a hint shown twice beats a send blocked by bookkeeping
    }
  }
  const runLinearReal: Runner = (cliArgs) => {
    try {
      const proc = Bun.spawnSync(["linear", ...cliArgs], {
        stdout: "pipe",
        stderr: "pipe",
        timeout: 10_000,
      })
      return {
        exitCode: proc.exitCode ?? 1,
        stdout: proc.stdout.toString(),
        stderr: proc.stderr.toString(),
      }
    } catch {
      // spawn itself failed → the linear binary is not installed
      return null
    }
  }
  let autolinkTickets: TicketInfo[] = []
  if (features["autolink-tasks"] !== false && caption) {
    const codes = detectTicketCodesExpanded(caption)
    if (codes.length > 0) {
      // 1h response cache (positive AND negative verdicts) so repeated reports
      // mentioning the same tickets don't re-spawn the linear CLI every send.
      // Cache failures degrade to a plain probe; probe failures degrade to
      // cached hits only — the send itself is never blocked.
      const CACHE_PATH = join(home, ".cache", "tg-cli", "linear-cache.json")
      const cacheRaw = ((): string | null => {
        try {
          return readFileSync(CACHE_PATH, "utf8")
        } catch {
          return null
        }
      })()
      const now = Date.now()
      const { hits, missing } = splitByCache(codes, cacheRaw, now)
      let probed: Map<string, TicketInfo> | null = null
      if (missing.length > 0) {
        const probe = probeTickets(missing, runLinearReal)
        if (probe.status === "ok") {
          probed = probe.tickets
          try {
            mkdirSync(join(home, ".cache", "tg-cli"), { recursive: true })
            writeFileSync(CACHE_PATH, mergeIntoCache(cacheRaw, missing, probed, now))
          } catch {
            // best-effort cache; never block a send over bookkeeping
          }
        } else if (probe.status === "no-cli") {
          hintOnce(
            "install",
            `autolink-tasks: ticket-like codes found (${codes.join(", ")}) but the linear CLI is not installed. ` +
              "Install: brew install schpet/tap/linear — or disable with --no-feature autolink-tasks. (shown once)",
          )
        } else if (probe.status === "no-auth") {
          hintOnce(
            "login",
            "autolink-tasks: the linear CLI is not authenticated. Run: linear auth login (shown once)",
          )
        } else {
          console.error(`Warning: autolink-tasks: ${probe.message} — sending without links`)
        }
      }
      // Cached hits + live results, in first-appearance order. A null hit is a
      // cached verified-absent verdict; a failed probe leaves its codes plain.
      autolinkTickets = codes
        .map((c) => (hits.has(c) ? hits.get(c) : (probed?.get(c) ?? null)))
        .filter((t): t is TicketInfo => t != null)
    }
  }
  const hasTickets = autolinkTickets.length > 0

  // --- autolink-prs: detect #N refs, resolve them via the gh CLI ---
  // (docs/specs/autolink-prs.md). Sibling of autolink-tasks: detect → cache
  // split → probe → merge. Two gh spawns when refs are found — repo identity
  // (`gh repo view`) then one batched `gh api graphql`. Issues merge into the
  // tickets reference block; PRs get their own block (handled in render below).
  // Every failure mode keeps the send going as plain text. The once-only hints
  // reuse the autolink-tasks state file (AUTOLINK_STATE_PATH) with gh-* kinds.
  const runGhReal: Runner = (cliArgs) => {
    try {
      const proc = Bun.spawnSync(["gh", ...cliArgs], {
        stdout: "pipe",
        stderr: "pipe",
        timeout: 10_000,
      })
      return {
        exitCode: proc.exitCode ?? 1,
        stdout: proc.stdout.toString(),
        stderr: proc.stderr.toString(),
      }
    } catch {
      // spawn itself failed → the gh binary is not installed
      return null
    }
  }
  const autolinkRefs = new Map<number, GhRef>()
  let autolinkRefOrder: number[] = []
  const ghInstallHint = (refs: number[]): void =>
    hintOnce(
      "gh-install",
      `autolink-prs: GitHub refs found (${refs.map((n) => `#${n}`).join(", ")}) but the gh CLI is not installed. ` +
        "Install: brew install gh — or disable with --no-feature autolink-prs. (shown once)",
    )
  const ghLoginHint = (): void =>
    hintOnce("gh-login", "autolink-prs: the gh CLI is not authenticated. Run: gh auth login (shown once)")
  if (features["autolink-prs"] !== false && caption) {
    const refs = detectRefsExpanded(caption)
    if (refs.length > 0) {
      autolinkRefOrder = refs
      // Resolve repo identity first — the cache is keyed by repo (#260 means
      // different things in different repos), so we cannot cache-split before we
      // know the repo. `gh repo view` is cheap; the batched graphql is the spawn
      // we want to skip when every ref is already cached.
      const repoProbe = probeRepo(runGhReal)
      if (repoProbe.status === "ok") {
        const repo = repoProbe.repo
        const GH_CACHE_PATH = join(home, ".cache", "tg-cli", "gh-cache.json")
        const ghCacheRaw = ((): string | null => {
          try {
            return readFileSync(GH_CACHE_PATH, "utf8")
          } catch {
            return null
          }
        })()
        const now = Date.now()
        const { hits, missing } = splitGhCache(repo, refs, ghCacheRaw, now)
        let probed: Map<number, GhRef> | null = null
        if (missing.length > 0) {
          const probe = probeRefsInRepo(repo, missing, runGhReal)
          if (probe.status === "ok") {
            probed = probe.refs
            try {
              mkdirSync(join(home, ".cache", "tg-cli"), { recursive: true })
              writeFileSync(GH_CACHE_PATH, mergeGhCache(ghCacheRaw, repo, missing, probed, now))
            } catch {
              // best-effort cache; never block a send over bookkeeping
            }
          } else if (probe.status === "no-cli") {
            ghInstallHint(refs)
          } else if (probe.status === "no-auth") {
            ghLoginHint()
          } else {
            console.error(`Warning: autolink-prs: ${probe.message} — sending without links`)
          }
        }
        // Cached hits + live results, in first-appearance order. A null hit is a
        // cached verified-absent verdict; a failed probe leaves its refs plain.
        for (const num of refs) {
          const ref = hits.has(num) ? hits.get(num) : (probed?.get(num) ?? null)
          if (ref) autolinkRefs.set(num, ref)
        }
      } else if (repoProbe.status === "no-cli") {
        ghInstallHint(refs)
      } else if (repoProbe.status === "no-auth") {
        ghLoginHint()
      } else {
        // no-repo: not a GitHub repo / no remote — normal for many cwds. Silent.
      }
    }
  }
  const hasRefs = autolinkRefs.size > 0

  // --- autolink-msgrefs: detect `tg#<id>` inbound-message references (tg#28).
  // These are the convention the inbound inject wrap renders, distinct from a
  // GitHub `#<id>`. PURE text detection — no CLI spawn — and the linkify runs
  // FIRST in the transform below (before the #N PR pass), so a `tg#3715` is
  // recognized as a message ref and never mis-resolved as issue/PR #3715. The
  // deep link only materializes for a supergroup chat; in a private DM the ref
  // is marked but unlinked (no public per-message URL exists there).
  const rawMsgRefIds =
    features["autolink-msgrefs"] !== false && caption ? detectMsgRefs(caption) : []
  const buildMsgRefEntriesFor = (ids: number[]) => {
    if (ids.length === 0) return []
    const historyPath = ctlPaths(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"), botIdFromToken(BOT_TOKEN)).history
    let historyRaw: string
    try {
      historyRaw = readFileSync(historyPath, "utf8")
    } catch {
      return []
    }
    return buildMsgRefEntries(
      parseHistory(historyRaw),
      ids,
      (id) => msgRefUrl(currentChatId, id),
      currentChatId,
    )
  }
  const hasMsgRefs = rawMsgRefIds.length > 0
  const hasAutolink = hasTickets || hasRefs || hasMsgRefs

  // Record an outbound message_id → this origin so the daemon can route a REPLY
  // to the agent that produced it, and order the unrecognized-reply picker by
  // LRU/MRU (docs/specs/reply-quotes.md). Tmux pane if present; otherwise the
  // omp ancestor pid as omp:<pid> so an out-of-tmux omp is still recognizable
  // (tg-cli#339). A corrupt or unwritable file just degrades to the picker.
  const TMUX_PANE = process.env.TMUX_PANE
  const originPaneId = outboundOriginPaneId({
    tmuxPane: TMUX_PANE,
    ompAncestorPid,
  })
  const ROUTES_PATH = originPaneId
    ? ctlPaths(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"), botIdFromToken(BOT_TOKEN)).routes
    : null
  // The origin pane's tmux pane_current_path — the SAME quantity the daemon
  // reads (pane.panePath) when validating a reply. Recording this instead of
  // process.cwd() is the routing fix: agents run `tg` from /tmp, so process.cwd()
  // never matched the pane's project dir and every reply hit the picker. Returns
  // null when not in tmux / the query fails, so resolveRouteCwd degrades to cwd.
  const queryPanePath = (): string | null => {
    if (!TMUX_PANE && ompAncestorPid) {
      try {
        const result = Bun.spawnSync(
          ["lsof", "-a", "-p", String(ompAncestorPid), "-d", "cwd", "-Fn"],
          { stdout: "pipe", stderr: "pipe" },
        )
        if (result.exitCode === 0) {
          const cwd = parseLsofCwd(new TextDecoder().decode(result.stdout))
          if (cwd) return cwd
        }
      } catch {
        // lsof missing — fall back to process.cwd() in resolveRouteCwd
      }
      return null
    }
    if (!TMUX_PANE) return null
    return readOriginPane().path
  }
  // ONE tmux read of the origin pane: its path (the route cwd, above) and its
  // exact locator — server pid + pane pid — that names the pane across tmux
  // restarts (spec §2.6). Cached: every chunk of one send shares it.
  let originPane: { path: string | null; serverPid?: number; panePid?: number } | undefined
  const readOriginPane = (): { path: string | null; serverPid?: number; panePid?: number } => {
    if (originPane) return originPane
    originPane = { path: null }
    if (!TMUX_PANE) return originPane
    try {
      const result = Bun.spawnSync(
        ["tmux", "display-message", "-p", "-t", TMUX_PANE, "#{pane_current_path}\t#{pid}\t#{pane_pid}"],
        { stdout: "pipe", stderr: "pipe" },
      )
      if (result.exitCode === 0) {
        // The pids are the LAST two fields: a pane path may itself contain a tab.
        const fields = new TextDecoder().decode(result.stdout).replace(/\r?\n$/, "").split("\t")
        const panePid = fields.pop()
        const serverPid = fields.pop()
        const path = fields.join("\t")
        originPane = {
          path: path || null,
          ...(Number(serverPid) > 0 ? { serverPid: Number(serverPid) } : {}),
          ...(Number(panePid) > 0 ? { panePid: Number(panePid) } : {}),
        }
      }
    } catch {
      // tmux missing / pane gone — fall back to process.cwd() in resolveRouteCwd
    }
    return originPane
  }
  // The session this send came from (session registry key, spec §2.4), resolved
  // once per send from the daemon's sessions.json (read-only here) and the exact
  // origin locators. A reply then follows the SESSION, so it still lands after an
  // omp restart/resume changed the pid (tg-cli#459). Unresolved (the daemon has
  // not scanned this session yet) → the route keeps its locators and the
  // daemon's next scan stamps the key.
  let originSession: { locators: RouteOrigin; sessionKey: string | null } | undefined
  const resolveOriginSession = (): { locators: RouteOrigin; sessionKey: string | null } => {
    if (originSession) return originSession
    const pane = readOriginPane()
    const locators: RouteOrigin = {
      paneId: originPaneId!,
      ...(ancestor ? { agentPid: ancestor.pid } : {}),
      ...(pane.serverPid && pane.panePid ? { serverPid: pane.serverPid, panePid: pane.panePid } : {}),
    }
    let sessionKey: string | null = null
    try {
      const sessionsPath = ctlPaths(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"), botIdFromToken(BOT_TOKEN)).sessions
      sessionKey = resolveRouteSession(parseRegistry(readFileSync(sessionsPath, "utf8")), locators)
    } catch {
      // no registry yet — the daemon's next scan stamps the route
    }
    originSession = { locators, sessionKey }
    return originSession
  }
  // EVERY outbound message id of THIS send (a multi-chunk >4096 split or a
  // media-group send emits several Telegram message_ids for one logical
  // agent message — see recordOutboundHistory below, which now logs a
  // recall-able history record for each one, not just the first).
  const outboundIds: number[] = []
  const recordRoute = (messageId: number): void => {
    outboundIds.push(messageId)
    if (!ROUTES_PATH || !originPaneId) return
    try {
      // Resolve the route cwd (a tmux display-message lookup) BEFORE taking the
      // lock — it's the slow part, and keeping it out of the critical section
      // shrinks the lock hold to a fast read-append-write so contention timeouts
      // are essentially impossible (the codex #55 scenario was a writer blocked on
      // exactly this lookup WHILE holding the lock). Snapshot ts here too so the
      // locked body is pure file I/O.
      const origin = resolveOriginSession()
      const newRoute = {
        id: messageId,
        cwd: resolveRouteCwd({ queryPanePath, fallbackCwd: process.cwd() }),
        ts: Math.floor(Date.now() / 1000),
        ...origin.locators,
        ...(origin.sessionKey ? { sessionKey: origin.sessionKey } : {}),
      }
      // Serialize the read-modify-write across concurrent agents: two `tg` sends
      // racing this RMW would last-writer-wins-clobber each other's route entries,
      // dropping the very origin→message_id mapping the daemon needs to recognize a
      // reply. The O_EXCL lockfile (fsRoutesLockIo) is the cross-process mutex; a
      // dead-owner lock is broken by PID-liveness, so a live writer is never
      // clobbered. onContended:'skip' — if we can't get the lock within the budget,
      // we SKIP rather than write unlocked (an unlocked write could clobber the
      // concurrent holder's entry; skipping drops only THIS send's bookkeeping).
      withRoutesLock(
        fsRoutesLockIo(`${ROUTES_PATH}.lock`),
        () => {
          // Read race-free under the lock: one readFileSync, ENOENT (first ever
          // write) → empty. NOT existsSync-then-read (a TOCTOU check-then-use).
          let raw: string | null
          try {
            raw = readFileSync(ROUTES_PATH, "utf8")
          } catch {
            raw = null
          }
          writeFileSync(ROUTES_PATH, serializeRoutes(appendRoute(parseRoutes(raw), newRoute)))
        },
        { onContended: "skip" },
      )
    } catch {
      // best-effort: never let route bookkeeping break a send
    }
  }

  // Append `agent` history record(s) for this send so `tg replies` can recall
  // what the agent sent (mirror of the daemon's inbound writer). Best-effort:
  // swallow-all — history bookkeeping must never break a send. Gated on
  // originPaneId (not TMUX_PANE) the SAME way ROUTES_PATH is above: a tmux
  // pane if present, else the omp:<pid> synthetic origin, so an omp session
  // with no tmux pane also gets a real outbound record — tg-cli#363's daemon
  // nudge needs this as its last-tg-sent signal for exactly the headless
  // population it targets, and before this fix that population wrote NOTHING
  // here (the nudge would have had zero signal for its main target). The
  // text is the message body (or a [photo]/[document] placeholder for a
  // media-only send). One record is written per outbound message_id — see
  // `buildOutboundHistoryRecords` (features/replies/outbound.ts) for why.
  // Called AFTER transmit so the ids are known.
  const CTL_PATHS = originPaneId ? ctlPaths(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"), botIdFromToken(BOT_TOKEN)) : null
  const recordOutboundHistory = (body: string): void => {
    if (!CTL_PATHS || !originPaneId) return
    const text = outboundHistoryText(body, { photos: plan.photos.length, documents: plan.documents.length })
    if (text === null) return
    try {
      // The registry session this send comes from (spec §3.3, tg-cli#460): the
      // identity `tg replies` scopes on, so a later rename never splits it. It
      // also names an out-of-tmux omp, which has no pane to derive a name from.
      const registry = readSessionRegistry(CTL_PATHS.sessions)
      const sessionKey = ownSessionKey(registry, ancestor)
      const entry = registry.sessions.find((e) => e.key === sessionKey)
      // randomUUID() only actually lands in a record when the send is truly
      // multi-part (buildOutboundHistoryRecords ignores it otherwise) — a
      // random token, not the group's first id, so it can't collide across
      // two different chats sharing this bot's history file (tg-cli#131 f/u).
      const recs = buildOutboundHistoryRecords(
        outboundIds,
        text,
        Math.floor(Date.now() / 1000),
        originPaneId,
        randomUUID(),
        currentChatId,
        // This session's own agent name (resolveSessionName().primary over its pane) — the
        // SAME label the daemon stamps on inbound, so `tg replies` groups a
        // session's outbound and its inbound under one current-agent scope.
        // Out of tmux it is the registry entry's name; undefined → untagged.
        currentPaneAgentName() ?? entry?.name.primary ?? undefined,
        sessionKey ?? undefined,
      )
      // Under the history lock shared with the daemon's inbound writer (tg-cli#136).
      appendHistoryFile(CTL_PATHS.history, recs)
    } catch {
      // best-effort: never let history bookkeeping break a send
    }
  }

  // --- renderText hook: prefix + emoji → inline <tg-emoji> HTML ---
  // Pipeline order (forced, see normalize.ts): decode → extract(R2/R4) → THIS
  // hook on the surviving prose → assemble. Rendering AFTER extraction keeps
  // emoji-entity offsets valid (a strip would otherwise shift them) and avoids
  // substituting :helper: markers inside text we're about to remove.
  // --- Line-spec quotes + marker-injected copies (in-memory) ---
  // For each text-readable item that carried a trailing line-spec, build:
  //   - a TG quote of the referenced range ±2 (AST-aware) to insert directly
  //     below the path mention in the caption, and
  //   - an in-memory copy of the whole file with marker comments around the
  //     range, which REPLACES the disk source (never touches the original).
  // Images with a line-spec are attached as-is (no snippet/markers).
  //
  // The line-spec snippet/marker work lives in the pure `planLineSpecs`
  // (features/auto-attach/line-spec.ts), tested in isolation with an in-memory
  // reader. Here we inject a real disk reader that converts a throwing read into
  // null. The planner's own TEXT_EXTS gate decides ext
  // eligibility, so this reader only ever runs on a text-ext path; a null result
  // (missing/unreadable) makes the planner fall through to attach-as-is and
  // never silently drop a file.
  const readText = (p: string): string | null => {
    try {
      return readFileSync(p, "utf8")
    } catch {
      return null
    }
  }
  const lsPlan = planLineSpecs(items, readText)
  const lineSpecRenders = lsPlan.quotes
  const hasQuotes = lineSpecRenders.length > 0

  // --- renderText hook: prefix + emoji → inline <tg-emoji> HTML ---
  // Pipeline order (forced, see normalize.ts): decode → extract(R2/R4) → THIS
  // hook on the surviving prose → assemble. Rendering AFTER extraction keeps
  // emoji-entity offsets valid (a strip would otherwise shift them) and avoids
  // substituting :helper: markers inside text we're about to remove. Line-spec
  // quotes are inserted AFTER this hook (anchored on the token) so the injected
  // <pre> can't flip the userHtml/escape decision below.
  const prefix = buildPrefix({ aiEmoji: AI_EMOJI, model: MODEL, tmuxWindow: sessionName.primary, agentLabel: AGENT_LABEL, tag, title })
  const renderText = (stripped: string, fmt: Format): { text: string; format: Format } => {
    const parsedCaption = parseEmojiHelpers(stripped)
    // buildPrefix already rendered the prefix to finished html/plain (its emoji
    // tag and styled [window] are OURS, not user-authored HTML), so userHtml is
    // decided by the CAPTION alone. The caption's own custom-emoji entities are
    // rendered to inline <tg-emoji> here (offset-based, they would be
    // invalidated by the >4096 splitter); the trusted prefix is then prepended.
    //   "User HTML"  = caption asked for --format html or wrote real tags.
    //   "Forced HTML" = a custom emoji / <b> window fallback, line-spec quotes,
    //     or autolink — escape the caption's plain text so literals can't break
    //     parsing.
    // Auto-detect Telegram HTML tags in the body: if the text contains known
    // Telegram markup (<b>, <i>, <code>, <pre>, <a>, etc.) treat it as HTML even
    // without an explicit --format html. This lets agents write HTML-formatted
    // reports naturally without the flag, while comparison operators like `2 < 3`
    // or unknown tags like `<foo>` are never mis-treated (detectHtmlTags only
    // matches the Telegram-supported tag set).
    const userHtml = fmt === "html" || detectHtmlTags(parsedCaption.text)
    const renderToHtml =
      userHtml || prefix.forceHtml || parsedCaption.entities.length > 0 || hasQuotes || hasAutolink
    if (!renderToHtml) return { text: prefix.plain + parsedCaption.text, format: "plain" }
    const captionHtml = convertEntitiesToHtml(parsedCaption.text, parsedCaption.entities, !userHtml)
    return { text: prefix.html + captionHtml, format: "html" }
  }

  // --- File contents for R2 (duplicated-paste detection) ---
  // Only DOCUMENT items, read from disk, size-capped — string-matching a binary
  // photo against pasted text is pointless and potentially huge. Every mentioned
  // doc is attached (decision C), so all of them participate in R2: if a doc's
  // full content was also pasted verbatim, R2 strips the paste and the file
  // rides as the attachment — no size exception.
  const R2_MAX_BYTES = 256 * 1024
  const fileContents = items
    .filter((it) => it.type === "document")
    .map((it) => {
      try {
        if (statSync(it.path).size > R2_MAX_BYTES) return null
        return { path: it.path, content: readFileSync(it.path, "utf8") }
      } catch {
        return null
      }
    })
    .filter((f): f is { path: string; content: string } => f !== null)

  // --- Build the SendPlan (normalization layer: R2/R3/R4 + render) ---
  const plan = buildSendPlan(items, caption, effectiveFormat, { fileContents, renderText })

  // --- pre-send-photo hooks (agents-hooks/v1). NON-BREAKING SEAM. ---
  // Guarded by ONE `stat ~/.agents/hooks/tg/` (hooksActive). With no descriptors
  // dir the whole block is skipped and the send path is byte-for-byte today's
  // behaviour. Hooks fire ONLY here (the photo subcommand) — plain `tg "msg"`
  // never reaches this. A `block` (a hook exits 10, e.g. review visual judging
  // the screenshot unstyled/broken) HOLDS the send. Everything else (hook error,
  // timeout) fails open per the runner policy.
  // SECURITY: descriptors are trust-by-default — a drop-in names an executable
  // that runs on EVERY photo send, with no trust step. Only the user / their
  // own tools should ever write to ~/.agents/hooks/tg/. AGENTS_HOOKS_TRUST=1
  // re-engages the TOFU quarantine for the rare untrusted-input case.
  if (
    features["hooks"] !== false &&
    plan.photos.length > 0 &&
    hooksActive(env)
  ) {
    const diskPhotoPaths = plan.photos
      .filter((p) => p.source.kind === "disk")
      .map((p) => (p.source as { kind: "disk"; path: string }).path)
    if (diskPhotoPaths.length > 0) {
      // `env` is the merged config+process env (the `{ ...configEnv,
      // ...process.env }` built in main()), so AGENTS_HOOKS=0 /
      // AGENTS_HOOKS_TRUST=auto / API keys set in ~/.config/tg-cli/.env are
      // honored and forwarded to the hook subprocess.
      // NOTE on `caption`: this is the RAW parsed caption, BEFORE the autolink /
      // line-spec transforms below mutate plan.textMessages[0]. The gate sits
      // here (not after those mutations) to keep the non-breaking seam in one
      // clean place and gate on the IMAGE — the shipped `review visual` hook
      // judges the screenshot and ignores caption. A future hook that needs the
      // FINAL rendered caption should read the image, not args.caption (which is
      // best-effort pre-transform text).
      const gate = gatePhotos(diskPhotoPaths, { caption, chatId: CHAT_ID }, env)
      if (gate.blocked) {
        console.error(
          `Blocked: pre-send-photo hook rejected ${gate.blockedPath}` +
            (gate.message ? `\n  ${gate.message}` : ""),
        )
        process.exit(10)
      }
    }
  }


  // --- autolink transform (tasks + prs): linkify verified Linear codes and
  // GitHub #N refs, then append reference blocks. Single ticket → title on the
  // first line; several tickets / any GitHub issue → a collapsed block (tickets
  // then issues); PRs → their own collapsed block after that. Runs BEFORE
  // line-spec quote insertion so injected <pre> bodies are never linkified.
  // plan.textMessages[0] also covers the media-caption ride — the transmitter
  // promotes that same message to a caption. hasAutolink forced HTML in
  // renderText, so the body is already escaped/rendered HTML here.
  if (hasAutolink && plan.textMessages.length > 0) {
    const { issues, prs } = buildEntries(autolinkRefs, autolinkRefOrder)
    // tg#28: linkify `tg#<id>` message refs FIRST so the resulting <a>/styled
    // span is what the ticket/#N passes then walk over (they skip inside <a>),
    // and a `tg#3715` is never even offered to the PR resolver. Deep link only
    // when the chat is a supergroup; otherwise the ref is marked but unlinked.
    let body = plan.textMessages[0].text
    const linkableMsgRefIds = hasMsgRefs ? detectLinkableMsgRefs(body) : []
    const msgRefEntries = buildMsgRefEntriesFor(linkableMsgRefIds)
    if (hasMsgRefs) body = linkifyMsgRefs(body, (id) => msgRefUrl(currentChatId, id))
    plan.textMessages[0] = {
      text: applyAutolink(body, autolinkTickets, prefix.present, {
        linkifyTickets: hasTickets
          ? (html: string): string =>
              linkifyTicketsCompound(html, new Map(autolinkTickets.map((t) => [t.code, t])))
          : undefined,
        linkify: hasRefs ? (html: string): string => linkifyRefsCompound(html, autolinkRefs) : undefined,
        issues: [...msgRefEntries, ...issues],
        prs,
        styleTitle: styleTaskTitle,
      }),
      format: "html",
    }
  }

  // --- Insert line-spec quotes (post-render) + swap in marker-injected copies.
  if (hasQuotes) {
    // Anchor each quote on the line that contains its (kept) path token, then
    // splice the quote in on the line directly below. Token-anchored, so it is
    // robust to length changes from emoji/HTML rendering above.
    if (plan.textMessages.length > 0) {
      let body = plan.textMessages[0].text
      for (const r of lineSpecRenders) {
        const lines = body.split("\n")
        // The render may have HTML-escaped the prose (forced HTML for the
        // quote), which also escapes &<> inside the token — so match both the
        // raw token and its escaped form.
        const escapedToken = escapeHtml(r.token)
        const idx = lines.findIndex((l) => l.includes(r.token) || l.includes(escapedToken))
        if (idx === -1) {
          // Token not found in the rendered text (shouldn't happen) → append.
          lines.push(r.quote)
        } else {
          lines.splice(idx + 1, 0, r.quote)
        }
        body = lines.join("\n")
      }
      // A quote is HTML, so the message must be sent as HTML.
      plan.textMessages[0] = { text: body, format: "html" }
    } else {
      // No prose survived but quotes exist → send the quotes as the message.
      plan.textMessages.push({
        text: lineSpecRenders.map((r) => r.quote).join("\n"),
        format: "html",
      })
    }
    // Replace each line-spec document's disk source with the in-memory
    // marker-injected copy (never modifies the original file on disk). Every
    // readable line-spec text file is attached (decision C) and has an entry in
    // `lsPlan.marked`; a binary/unreadable one has none, so `.find` returns
    // undefined and the swap no-ops, leaving it attached as-is.
    for (const m of lsPlan.marked) {
      const doc = plan.documents.find(
        (d) => d.source.kind === "disk" && d.source.path === m.path,
      )
      if (doc) doc.source = { kind: "memory", filename: m.filename, content: m.content }
    }
  }

  // Real fs wiring for the pure checkAttachmentFile (tg-cli#207) — the
  // entrypoint owns I/O, the feature module stays disk-free/testable. Defined
  // here (BEFORE code-as-pdf/md-as-pdf) so a document that is already
  // missing/empty/unreadable is dropped before conversion ever runs on it —
  // otherwise a bad ORIGINAL source could be silently replaced by a generated
  // PDF that passes validation on its own, never revalidating what the user
  // actually pointed at. Reused unchanged at the transmit() call below.
  const fileCheckDeps: FileCheckDeps = {
    stat: (p) => statSync(p),
    canRead: (p) => {
      try {
        accessSync(p, fsConstants.R_OK)
        return true
      } catch {
        return false
      }
    },
  }
  plan.documents = plan.documents.filter((d) => {
    if (d.source.kind !== "disk") return true
    const result = checkAttachmentFile(d.source.path, fileCheckDeps)
    if (result === "ok") return true
    const reason = result === "missing" ? "file not found" : result === "empty" ? "file is empty" : "file is unreadable"
    console.error(`tg: skipping attachment ${d.source.path}: ${reason}`)
    return false
  })

  // Shared deps for both PDF passes (code-as-pdf + md-as-pdf). Pure I/O thunks;
  // the feature modules stay pure and testable.
  const pdfTempDirs: string[] = [] // dirs to rm after transmit (both PDF passes)
  const pdfDeps: ConvertDeps = {
    run: (cmd, timeoutMs) => {
      try {
        const proc = Bun.spawnSync(cmd, { stdout: "pipe", stderr: "pipe", timeout: timeoutMs })
        return { exitCode: proc.exitCode ?? 1, stderr: proc.stderr.toString() }
      } catch {
        return null
      }
    },
    makeTempDir: () => mkdtempSync(join(tmpdir(), "tg-pdf-")),
    writeFile: (p, c) => writeFileSync(p, c),
    readFile: (p) => readFileSync(p, "utf8"),
    fileExists: (p) => existsSync(p),
    fileSize: (p) => {
      try {
        return statSync(p).size
      } catch {
        return -1
      }
    },
    whichCmd: (name) => Bun.which(name),
    env,
  }

  // --- code-as-pdf: render disk-sourced code/config docs to a mobile PDF ---
  // (features/code-pdf/convert.ts). Telegram iOS previews raw .ts/.json/.yaml…
  // uselessly; a wrapped, syntax-highlighted, phone-sized PDF is the readable
  // artifact. BY DEFAULT only the PDF is sent — the original is dropped (the CTO
  // rule "по умолчанию оригинал не шли"). `--with-original` keeps the raw file
  // too; `--no-pdf` (or --no-feature code-as-pdf) skips the render and attaches
  // the original (today's behavior). Runs BEFORE md-as-pdf and AFTER the marker
  // swap, mirroring it. Markdown stays on the md-pdf path (detectCodeLang→null).
  if (features["code-as-pdf"] !== false && !noPdf) {
    const device = resolveDevice(pdfDevice, env)
    if (device.unknown) {
      const where = device.source === "env" ? "TG_PDF_DEVICE" : "--pdf-device"
      console.error(
        `tg: unknown ${where} '${device.requested}' — using ${device.name}. ` +
          "Known: iphone15pro, iphone15promax, iphonese, a4.",
      )
    }
    const result = applyCodePdfToPlan(
      plan.documents,
      { convert: (codePath) => convertCodeToPdf(codePath, pdfDeps, device.preset) },
      { withOriginal: withOriginal === true },
    )
    plan.documents = result.documents
    pdfTempDirs.push(...result.tmpDirs) // removed after transmit
    // Failed renders leave no artifact on the wire — drop their temp dirs NOW
    // (otherwise a box with Chrome but no pandoc leaks /tmp on every send).
    for (const dir of result.failedTmpDirs) {
      try {
        rmSync(dir, { recursive: true, force: true })
      } catch {
        // best-effort cleanup
      }
    }
    for (const f of result.failures) {
      console.error(`Warning: code-as-pdf: ${f.path}: ${f.error} — attaching the original file`)
    }
  }

  // --- md-as-pdf: convert disk-sourced markdown documents to PDF ---
  // (features/md-pdf/convert.ts). Runs AFTER the marker swap above, so a
  // line-spec'd .md (now a memory marker copy) is intentionally left as
  // markdown — its marker comments would be invisible in a PDF. Conversion
  // failure attaches the original .md unchanged (BOM'd below for the preview).
  if (features["md-as-pdf"] !== false) {
    for (const doc of plan.documents) {
      if (!isConvertibleMd(doc) || doc.source.kind !== "disk") continue
      const { pdfPath, error, tmpDir } = convertMdToPdf(doc.source.path, pdfDeps)
      if (pdfPath) {
        doc.source = { kind: "disk", path: pdfPath }
        if (tmpDir) pdfTempDirs.push(tmpDir) // removed after transmit
      } else {
        console.error(`Warning: md-as-pdf: ${doc.source.path}: ${error} — attaching the original .md`)
        if (tmpDir) rmSync(tmpDir, { recursive: true, force: true })
      }
    }
  }

  if (
    plan.photos.length === 0 &&
    plan.documents.length === 0 &&
    plan.textMessages.length === 0
  ) {
    console.error("Error: no message text provided")
    process.exit(1)
  }

  // --- pre-send-text hooks (agents-hooks/v1). NON-BREAKING SEAM. ---
  // The `pre-send-text` sibling of the pre-send-photo gate above: same
  // `hooksActive` guard (no descriptors dir → byte-for-byte today's
  // behaviour), same trust-by-default / fail-open policy. Fires for EVERY
  // text message in the plan (plain `tg "msg"` included, not just photo
  // captions), on the FINAL assembled body — after render/autolink/line-spec
  // quotes, right before the transmitter splits/sends it, so a hook sees
  // exactly what the recipient will read. Every entry is gated (review
  // finding: gating only textMessages[0] silently skipped/un-audited any
  // later text message the plan carries), mirroring gatePhotos looping over
  // every disk photo. A `block` (a hook exits 10) HOLDS the send.
  if (features["hooks"] !== false && hooksActive(env)) {
    for (const tm of plan.textMessages) {
      const gate = gateText(tm.text, { tag, chatId: CHAT_ID }, env)
      if (gate.blocked) {
        console.error(`Blocked: pre-send-text hook rejected the message` + (gate.message ? `\n  ${gate.message}` : ""))
        process.exit(10)
      }
    }
  }

  // Build the bot-bound transport (api + chat + the route recorder + an
  // optional --reply-to anchor), then hand it to the transmitter, which applies
  // caption-overflow + the >4096 split + the photos→text→documents ordering on
  // top of the four send primitives. replyTo threads the first outbound message
  // under the referenced inbound Telegram message_id (Feature: threaded replies).
  const transport = createTelegramTransport({
    api: API,
    chatId: CHAT_ID,
    recordRoute,
    replyToMessageId: replyTo,
    messageThreadId,
    threadIdAdvisory,
  })
  // fileCheckDeps: defined earlier (before code-as-pdf/md-as-pdf), reused here
  // unchanged so the pre- and post-conversion checks agree on what "ok" means.
  await transmit(plan, transport, {
    checkFile: (path) => checkAttachmentFile(path, fileCheckDeps),
    allowFlood: !floodCapOn,
  })

  // Reaction lifecycle (tg-cli#114): an `--tag answer --reply-to <id>` send means
  // message <id> is now ANSWERED — flip its reaction to the done mark (👌, the
  // allowed proxy for ✅). Best-effort: the answer already sent, so a reaction
  // failure must never fail the command (mirrors the daemon's fail-open receipt).
  const doneReaction = doneReactionForSend({ tag, replyToMessageId: replyTo })
  if (doneReaction) {
    try {
      await fetch(`${API}/setMessageReaction`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          chat_id: CHAT_ID,
          message_id: doneReaction.messageId,
          reaction: [{ type: "emoji", emoji: doneReaction.emoji }],
        }),
        signal: AbortSignal.timeout(10_000),
      })
    } catch {
      // best-effort — a failed done-mark never fails an already-sent answer
    }
  }

  // Outbound history for `tg replies` recall — one `agent` record per
  // outbound message_id (now known; see buildOutboundHistoryRecords). The
  // body is the raw user-typed message (caption), so recall shows what the
  // agent meant to say, not the branded envelope. Best-effort; never blocks
  // the (already-sent) send.
  recordOutboundHistory(caption)

  // Generated code→pdf / md→pdf artifacts are uploaded by now — drop their temp
  // dirs so repeated reports don't pile up in the OS tmp (codex review finding).
  for (const dir of pdfTempDirs) {
    try {
      rmSync(dir, { recursive: true, force: true })
    } catch {
      // best-effort cleanup
    }
  }

  // --- tg-ctl lazy auto-start (control spec §7): fires only AFTER a fully
  // successful send, only inside tmux with a DETECTED AI AGENT (MODEL — the
  // same in-session detection that brands the message) AND control.enabled.
  // Fire-and-forget: the daemon's flock makes repeated starts a no-op, and
  // NOTHING in this block may ever break a send — hence the swallow-all catch.
  try {
    const ctlCfg = resolveControlConfig(parseControlConfig(configYamlRaw))
    if (MODEL && shouldAutoStart(process.env, ctlCfg)) {
      Bun.spawn(
        [
          join(import.meta.dir, "tg-ctl"),
          "start",
          "--pane",
          process.env.TMUX_PANE ?? "",
          "--cwd",
          process.cwd(),
        ],
        { detached: true, stdio: ["ignore", "ignore", "ignore"] },
      ).unref()
    }
  } catch {
    // best-effort — auto-start failures are invisible by design
  }

  // Reaching here means every send actually went through (checkResponse exits
  // the process on any API failure).
  console.log(formatSendOk(outboundIds))
}
