#!/usr/bin/env bun
// `tg` — the outbound one-shot sender. This file is only the entrypoint: it re-exports the
// symbols other code imports (`VERSION`, `USAGE`) and, when executed directly, hands its own
// directory to the outbound pipeline in features/cli/outbound-runtime/ (tg-cli#817: the runtime
// used to be one 2400-line block here). Stage order and contracts: outbound-runtime/run.ts.
import { runOutbound } from "./features/cli/outbound-runtime/run"

// Re-export VERSION from its module so `import { VERSION } from "../tg"` keeps
// working (tests/ergonomics.test.ts) after the version helpers moved to
// features/cli/version.ts.
export { VERSION } from "./features/cli/version"

// `import { USAGE } from "../tg"` is part of the entrypoint's surface; the text lives with the runtime.
export { USAGE } from "./features/cli/outbound-runtime/usage"

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  await runOutbound(import.meta.dir)
}
