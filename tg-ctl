    inboxSyncing = true
    try {
      do {
        inboxDirty = false
        await syncInboxOnce()
      } while (inboxDirty)
    } catch (err) {
      log(`inbox sync failed: ${err}`)
    } finally {
      inboxSyncing = false
    }
