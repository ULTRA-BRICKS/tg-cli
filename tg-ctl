#!/usr/bin/env bun
// tg-ctl — inbound control daemon for tg-cli
// (spec: docs/specs/2026-06-10-tg-ctl-control-design.md, v1 scope §16).
//
// All decision logic lives in features/tg-ctl/* as pure modules; the effectful
// wiring lives in features/tg-ctl/daemon-runtime/* (fetch, spawns, file I/O,
// signals, the bun:ffi flock). This file is only the executable entry point: it
// registers its own path for the modules that re-execute it, re-exports the
// helpers the tests import, and dispatches the CLI when run directly.
//
// Launcher/daemon split (spec §6, review blocker F1, both halves verified on
// Bun 1.4.0): `start` NEVER takes the lock (a launcher-held flock dies with the
// launcher, opening a two-daemon window) and NEVER pipes stdio (a piped child
// makes every agent `tg` call hang for the daemon's lifetime). The daemon
// (`run`) takes the flock as its FIRST action and exits 0 when another
// instance still owns the bot after a short grace (a probe may hold it for an instant).

import { runCli } from "./features/tg-ctl/daemon-runtime/cli-main"
import { registerRootScript } from "./features/tg-ctl/daemon-runtime/root-script"

export { decideQueuedPermissionReconnect, normalizeButtonRequest, type QueuedPermissionReconnectOutcome } from "./features/tg-ctl/daemon-runtime/button-requests"
export { NO_AGENT_REPLY, USAGE } from "./features/tg-ctl/daemon-runtime/constants"
export { formatCandidates, loadEnv, parseStartFlags, readOffset, type StartFlags } from "./features/tg-ctl/daemon-runtime/ctx-io"

registerRootScript(import.meta.path)

// CLI entrypoint (only runs when executed directly, not when imported)
if (import.meta.main) {
  await runCli()
}
