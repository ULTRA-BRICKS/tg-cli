  const noticeStaleQueuedDecisions = (now: number): boolean => {
    let changed = false
    for (const entry of abandonedButtons.values()) {
      const qd = entry.queuedDecision
      if (!qd || qd.notifiedAt !== undefined || now - qd.at <= QUEUED_DECISION_NOTICE_MS) continue
