const CLAUDE_HARNESS_HOOK_CMD = "tg-ctl harness-event"
const CLAUDE_STATUSLINE_TELEMETRY_CMD = "tg-ctl harness-event --agent claude"
const CODEX_USAGE_HOOK_CMD = "tg-ctl codex-usage-hook"
const CODEX_TRANSCRIPT_TAIL_BYTES = 500_000

// Spec §5.2 no-agent guard: harness-neutral, one line. Never claims "Claude Code"
// for whatever was addressed (tg#17036: it was sent for an omp that WAS in tmux).
export const NO_AGENT_REPLY =
  "No live agent found → not delivered. Start Claude Code / Codex in a tmux window or under the rig wrapper (`rig harness run <harness> --name <label>`); omp is reachable in or outside tmux."

// --- Pure helpers (exported for tests) ---

// Same .env shape `tg` reads (KEY=VALUE lines, # comments). Reimplemented
// locally on purpose: importing from ./tg would drag the entire sender module
// graph into the daemon for a 15-line parser.
export function loadEnv(filePath: string): Record<string, string> {
  const env: Record<string, string> = {}
  try {
    const lines = readFileSync(filePath, "utf8").split("\n")
    for (const line of lines) {
      const trimmed = line.trim()
      if (!trimmed || trimmed.startsWith("#")) continue
      const eq = trimmed.indexOf("=")
      if (eq === -1) continue
      const key = trimmed.slice(0, eq).trim()
      const value = trimmed.slice(eq + 1).trim()
      if (key) env[key] = value
    }
  } catch {
    // file doesn't exist — skip
  }
  return env
}

export interface StartFlags {
  paneId?: string
  cwd?: string
  session?: string
}

// `tg` passes `--pane ''` when TMUX_PANE is unset — empty values are skipped,
// not stored, so the registration never carries hollow fields.
export function parseStartFlags(args: string[]): StartFlags {
  const out: StartFlags = {}
  for (let i = 0; i < args.length; i++) {
    const value = args[i + 1]
    if (!value) continue
    if (args[i] === "--pane") {
      out.paneId = value
      i++
    } else if (args[i] === "--cwd") {
      out.cwd = value
      i++
    } else if (args[i] === "--session") {
      out.session = value
      i++
    }
  }
  return out
}

// Offset file content → next getUpdates offset. Malformed/absent → 0
// (Telegram treats 0 as "no confirmed updates yet").
export function readOffset(content: string | null): number {
  if (content === null) return 0
  const trimmed = content.trim()
  return /^\d+$/.test(trimmed) ? Number(trimmed) : 0
}

// One line per candidate so the ambiguity reply names realistic choices.
export function formatCandidates(candidates: TargetPane[]): string {
  return candidates
    .map((c) => {
      // Lead with the user-set window name — the label the CTO recognizes
      // (tg-cli#75) — but ONLY when it's a real name, not a bare default
      // (a number / shell command / version string). Applying the picker's
      // isBareWindowName keeps this diagnostic line in sync with the buttons.
      const win = isBareWindowName(c.pane.windowName) ? "" : `${c.pane.windowName} `
      return `${win}${c.pane.sessionName}:${c.pane.windowIndex} ${c.pane.paneId} (${c.agent}, ${c.pane.panePath})`
    })
    .join("\n")
}

// --- Effectful plumbing (only ever invoked from the import.meta.main block) ---

interface Ctx {
  configDir: string
  paths: CtlPaths
  cfg: ControlConfig
  voice: VoiceConfig
  token: string
  chatId: number
  apiBase: string
  botId: string
  home: string
  cwd: string
}

function log(msg: string): void {
  console.error(`[${new Date().toISOString()}] ${msg}`)
}

function readFileOrNull(path: string): string | null {
  try {
    return readFileSync(path, "utf8")
  } catch {
    return null
  }
}

function readFileTailOrNull(path: string, maxBytes: number): string | null {
  let fd: number | null = null
  try {
    const stat = statSync(path)
    if (!stat.isFile()) return null
    const size = stat.size
    const length = Math.min(Math.max(0, maxBytes), size)
    const offset = Math.max(0, size - length)
    const buf = Buffer.allocUnsafe(length)
    fd = openSync(path, "r")
    let bytesRead = 0
    while (bytesRead < length) {
      const chunkBytes = readSync(fd, buf, bytesRead, length - bytesRead, offset + bytesRead)
      if (chunkBytes <= 0) break
      bytesRead += chunkBytes
    }
    return buf.subarray(0, bytesRead).toString("utf8")
  } catch {
    return null
  } finally {
    if (fd !== null) {
      try {
        closeSync(fd)
      } catch {
        // ignore close failure on best-effort hook telemetry
      }
    }
  }
}

function readJsonObjectOrNull(path: string): Record<string, unknown> | null {
  const raw = readFileOrNull(path)
  if (!raw) return null
  try {
    const parsed = JSON.parse(raw)
    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? (parsed as Record<string, unknown>) : null
  } catch {
    return null
  }
}

function hasClaudeStatusLineCommand(settings: Record<string, unknown>): boolean {
  const statusLine = settings.statusLine
  if (!statusLine || typeof statusLine !== "object" || Array.isArray(statusLine)) return false
  const command = (statusLine as Record<string, unknown>).command
  return typeof command === "string" && command.trim().length > 0
}

// Crash-safe write: stage into a sibling temp file then rename(2) over the target.
// rename is atomic on the same filesystem, so a reader (or a daemon that died
// mid-write) sees either the old file or the new one whole — never a torn JSON the
// next startup would fail to parse. Used for the durable question state, which is
// rewritten on every mutation of a hot path.
function atomicWrite(path: string, content: string): void {
  const tmp = `${path}.tmp`
  writeFileSync(tmp, content, { mode: 0o600 })
  renameSync(tmp, path)
}

// Append history records to the JSONL log, trimmed to the bound, under the
// history lock it shares with `tg`'s outbound writer (tg-cli#136). BEST-EFFORT:
// the recall log is purely informational (like routes), so a read/write error
// must never break the inbound inject path.
function appendHistory(path: string, records: HistoryRecord[]): void {
  try {
    if (!appendHistoryFile(path, records)) log(`history: lock contended, ${records.length} inbound row(s) not recorded`)
  } catch {
    // best-effort: never let history bookkeeping break an inject
  }
}

function fileMtimeMs(path: string): number | null {
  try {
    return statSync(path).mtimeMs
  } catch {
    return null
  }
}

// Alive unless kill(2) answers ESRCH. EPERM means the pid exists but this process may not signal it
// (another uid, a Landlock signal domain) — reading that as dead made `status` call a running daemon
// a stale pidfile (#748). An error with no `syscall` was thrown before kill(2) ran (a pid outside
// pid_t): no process has that pid.
function kill0(pid: number): boolean {
  try {
    process.kill(pid, 0)
    return true
  } catch (err) {
    return err instanceof Error && "syscall" in err && err.syscall === "kill" && "code" in err && err.code !== "ESRCH"
  }
}

function api(ctx: Ctx): string {
  return `${ctx.apiBase}/bot${ctx.token}`
}

// Daemon-side Bot API call. Never throws and never exits — a failed notice
// must not take the poll loop down with it.
async function botPost(ctx: Ctx, method: string, body: unknown): Promise<Record<string, unknown> | null> {
  const result = await botPostResult(ctx, method, body)
  // Preserve the legacy wrapper contract: transport-level HTTP errors return null,
  // but Telegram's historical HTTP-200 {ok:false} envelopes remain visible to callers.
  if (!result.ok && typeof result.status === "number") return null
  return result.json ?? null
}

type BotPostResult =
  | { ok: true; json: Record<string, unknown> }
  | { ok: false; status?: number; description: string; json?: Record<string, unknown> }

function telegramErrorDescription(text: string): { description: string; json?: Record<string, unknown> } {
  try {
    const parsed = JSON.parse(text) as unknown
    if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
      const json = parsed as Record<string, unknown>
      if (typeof json.description === "string") return { description: json.description, json }
      return { description: JSON.stringify(json).slice(0, 200), json }
    }
  } catch {
    // Fall through to the raw body; non-JSON upstream failures are still useful diagnostics.
  }
  return { description: text.slice(0, 200) }
}

// Telegram's success answer to an edit, standing in for a "message is not modified" refusal.
const EDIT_UNCHANGED: Record<string, unknown> = { ok: true, result: true }

// The one path every daemon Bot API call takes, so an edit that changed nothing
// (isEditNotModified, tg-cli#728) is success here for every edit call site: no failure line,
// and the caller sees ok. `timeoutMs`: a diagnostic read (status' getMe) passes a short one, so
// a stalled API cannot hold the reply for the full send timeout.
async function botPostResult(ctx: Ctx, method: string, body: unknown, timeoutMs = 15_000): Promise<BotPostResult> {
  try {
    const resp = await fetch(`${api(ctx)}/${method}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(timeoutMs),
    })
    if (!resp.ok) {
      const text = await resp.text()
      const error = telegramErrorDescription(text)
      if (isEditNotModified(method, error.description)) return { ok: true, json: EDIT_UNCHANGED }
      log(`${method} failed: ${resp.status} ${text.slice(0, 200)}`)
      return { ok: false, status: resp.status, ...error }
    }
    const json = (await resp.json()) as Record<string, unknown>
    if (!json || typeof json !== "object") return { ok: false, description: "non-object JSON response" }
    if (json.ok === false) {
      const description =
        typeof json.description === "string" ? json.description : JSON.stringify(json).slice(0, 200)
      if (isEditNotModified(method, description)) return { ok: true, json: EDIT_UNCHANGED }
      return { ok: false, description, json }
    }
    return { ok: true, json }
  } catch (err) {
    log(`${method} failed: ${err}`)
    return { ok: false, description: String(err) }
  }
}

// The 📥 Inbox topic (tg-cli#705) carries ONLY question-card copies, which the daemon's inbox
// sync posts straight through botPostResult. Every other daemon send — notices, replies, /status,
// pickers, session posts — that would land there goes to General instead. Set by the daemon
// whenever its Inbox state changes; null outside a daemon or before the topic exists.
let inboxThreadId: number | null = null
function outsideInbox<T extends { message_thread_id?: unknown }>(extra: T): T {
  if (inboxThreadId === null || extra.message_thread_id !== inboxThreadId) return extra
  log(`inbox guard: a non-card send aimed at the Inbox topic ${inboxThreadId} goes to General`)
  const rest = { ...extra }
  delete rest.message_thread_id
  return rest
}

async function sendMessage(ctx: Ctx, text: string, extra: Record<string, unknown> = {}): Promise<number | null> {
  const json = await botPost(ctx, "sendMessage", { chat_id: ctx.chatId, text, ...outsideInbox(extra) })
  const result = json?.result
  if (!result || typeof result !== "object") return null
  const messageId = (result as { message_id?: unknown }).message_id
  return typeof messageId === "number" ? messageId : null
}

// tg-cli#710: replay the sends `tg` queued while Telegram kept failing (outbox.ts), each
// marked as delayed, with the route + history rows `tg` would have written. Kicked on
// startup and after every successful getUpdates; single-flight and never awaited, so a
// backlog never holds up inbound handling. A transient failure ends the pass and pauses
// the next one (Telegram's retry_after on a 429, else OUTBOX_RETRY_PAUSE_MS), so a busy
// chat's getUpdates batches don't each re-read the backlog and fire a doomed request.
const OUTBOX_RETRY_PAUSE_MS = 5_000
let outboxFlushing = false
let outboxFlushNotBefore = 0
function kickOutboxFlush(ctx: Ctx): void {
  if (outboxFlushing || Date.now() < outboxFlushNotBefore) return
  outboxFlushing = true
  flushOutbox(ctx.paths.outbox, {
    post: (method, init) =>
      fetch(`${api(ctx)}/${method}`, {
        ...init,
        signal: AbortSignal.timeout(init.body instanceof FormData ? DEFAULT_SEND_RETRY.uploadAttemptTimeoutMs : DEFAULT_SEND_RETRY.attemptTimeoutMs),
      }),
    now: Date.now,
    log,
    recordRoutes: (routes) => {
      const done = withRoutesLock(
        fsRoutesLockIo(`${ctx.paths.routes}.lock`),
        () => {
          writeFileSync(ctx.paths.routes, serializeRoutes(routes.reduce(appendRoute, parseRoutes(readFileOrNull(ctx.paths.routes)))))
          return true
        },
        { onContended: "skip" },
      )
      if (!done) log(`outbox: routes lock contended, ${routes.length} route(s) not recorded`)
    },
    appendHistory: (records) => appendHistory(ctx.paths.history, records),
  })
    .then((res) => {
      if (res.stopped) outboxFlushNotBefore = Date.now() + (res.retryAfterMs ?? OUTBOX_RETRY_PAUSE_MS)
    })
    .catch((err) => log(`outbox: flush error: ${err}`))
    .finally(() => {
      outboxFlushing = false
    })
}

// Shared by every initial-post call site so the parse_mode/reply_markup shape can't drift
// between them — a divergent copy is exactly how a hatch card's parse_mode threading silently
// stops matching between flows.
// `sessionKey`: the card's registry session, when the payload is threaded into its topic — the
// send then gets the §4.5 thread-not-found fallback to General.
async function sendButtonCard(ctx: Ctx, payload: ButtonMessagePayload, sessionKey: SessionKey | null = null): Promise<number | null> {
  const extra: Record<string, unknown> = { reply_markup: payload.reply_markup }
  if (payload.parse_mode) extra.parse_mode = payload.parse_mode
  if (payload.message_thread_id !== undefined && sessionKey !== null) {
    return sendToSessionTopic(ctx, sessionKey, payload.message_thread_id, payload.text, extra)
  }
  return sendMessage(ctx, payload.text, extra)
}

async function answerCallbackQuery(ctx: Ctx, callbackQueryId: string, text: string): Promise<void> {
  // A text-reply-synthesized decision (see the 'answer-question' construction in
  // features/tg-ctl/updates.ts) carries an empty callbackQueryId sentinel: there is no real
  // Telegram callback query to acknowledge, so this is a correct no-op on a SUCCESS path — the
  // card's own editMessageText already gives the human visible feedback. It is NOT correct on a
  // pure-toast failure branch (expired / already-answered / mismatched) that posts no edit —
  // those call sites MUST use answerCallbackQueryOrNotify below instead, or the sentinel would
  // silently swallow the only feedback the human would otherwise get (review finding).
  if (!callbackQueryId) return
  await botPost(ctx, "answerCallbackQuery", { callback_query_id: callbackQueryId, text })
}

// For a failure branch that reports its outcome ONLY via the toast (no accompanying card edit):
// a real button tap's `action.callbackQueryId` is always real, so `answerCallbackQuery` reaches
// the human either way. A text-reply-synthesized decision (empty-sentinel `action`, see
// features/tg-ctl/updates.ts) has no callback query to toast — without this, the human's "yes"
// would silently do nothing with zero feedback (review finding: a same-batch race where a button
// tap resolves the card a moment before a text reply to it lands would otherwise vanish
// unexplained). Falls back to a plain chat reply carrying the identical text. Success branches
// that follow up with an editMessageText keep using plain `answerCallbackQuery` — the card edit
// is already sufficient feedback there and a second message would be redundant noise.
async function answerCallbackQueryOrNotify(
  ctx: Ctx,
  action: Extract<Action, { kind: "answer-question" }>,
  text: string,
): Promise<void> {
  if (!action.callbackQueryId) {
    await sendMessage(ctx, text, typeof action.threadId === "number" ? { message_thread_id: action.threadId } : {})
    return
  }
  await answerCallbackQuery(ctx, action.callbackQueryId, text)
}

// NOTE: Telegram's editMessageText REPLACES the whole inline keyboard — omitting
// reply_markup detaches it. Pass the markup whenever the edited card must stay
// tappable (e.g. restoring a re-attached question card to its live prompt).
async function editMessageText(
  ctx: Ctx,
  messageId: number,
  text: string,
  replyMarkup?: ButtonMessagePayload["reply_markup"],
  parseMode?: ButtonMessagePayload["parse_mode"],
): Promise<void> {
  const body: Record<string, unknown> = { chat_id: ctx.chatId, message_id: messageId, text }
  if (replyMarkup) body.reply_markup = replyMarkup
  if (parseMode) body.parse_mode = parseMode
  await botPost(ctx, "editMessageText", body)
}

// Remove the inline keyboard from a previously-sent message (forum-topics increment 4): after a
// topic binds we clear the now-stale model buttons so they can't be re-tapped. Omitting
// reply_markup detaches the keyboard. Best-effort — botPost swallows failures (a deleted prompt
// message, a transient API error), never throwing into the poll loop.
async function clearMessageKeyboard(ctx: Ctx, messageId: number): Promise<void> {
  await botPost(ctx, "editMessageReplyMarkup", { chat_id: ctx.chatId, message_id: messageId })
}

// Take a message the daemon posted out of the chat — an Inbox copy whose card closed, a reminder
// ping the removed #403 / #464 reminders left: delete it; when Telegram refuses the delete for
// good (too old for a bot delete, already gone, …) edit it to `placeholder` instead. True once
// Telegram gave its verdict: done, or refused for good — a message already gone counts as
// removed. False when a step failed for a reason that may pass (no answer, 429, 5xx): the caller
// keeps the message on disk and retries (tg-cli#722, #723). Never throws. `chatId` is the chat
// the message was POSTED in (tg-cli#518): after a TG_CHAT_ID change it is not ctx.chatId.
async function retireMessage(ctx: Ctx, chatId: number, messageId: number, placeholder: string): Promise<boolean> {
  const deleted = await botPostResult(ctx, "deleteMessage", { chat_id: chatId, message_id: messageId })
  if (deleted.ok) return true
  if (telegramFailureIsTransient(deleted)) return false
  const edited = await botPostResult(ctx, "editMessageText", { chat_id: chatId, message_id: messageId, text: placeholder })
  return !telegramFailureIsTransient(edited)
}

// Set a reaction on a message (tg-cli#114 lifecycle: 👀 working → 😴 stalled →
// 👌 done). Skips an emoji Telegram would reject (⏳/✅ are REACTION_INVALID) so
// we never waste a call on a guaranteed 400. Best-effort — botPost swallows
// failures; a receipt must never break the caller.
async function setMessageReaction(ctx: Ctx, messageId: number, emoji: string): Promise<void> {
  if (!isAllowedReaction(emoji)) {
    log(`setMessageReaction skipped: ${emoji} is not an allowed reaction`)
    return
  }
  await botPost(ctx, "setMessageReaction", {
    chat_id: ctx.chatId,
    message_id: messageId,
    reaction: [{ type: "emoji", emoji }],
  })
}

// Send a rich-HTML message (Bot API sendRichMessage, `rich_message.html`), the
// path /tasks uses for its table (#115). Normalizes + pre-flights the HTML with
// the same helpers `tg` uses, so an invalid table fails locally with a clear log
// instead of an opaque API 400. Returns the sent message id or null.
async function sendRich(
  ctx: Ctx,
  rawHtml: string,
  extra: { reply_markup?: TasksReplyMarkup; message_thread_id?: number; reply_parameters?: { message_id: number } } = {},
): Promise<number | null> {
  const html = normalizeRichHtml(rawHtml)
  const check = validateRichHtml(html)
  if (!check.ok) {
    log(`sendRich invalid html: ${check.error}`)
    return null
  }
  const json = await botPost(ctx, "sendRichMessage", { chat_id: ctx.chatId, rich_message: { html }, ...outsideInbox(extra) })
  const result = json?.result
  if (!result || typeof result !== "object") return null
  const messageId = (result as { message_id?: unknown }).message_id
  return typeof messageId === "number" ? messageId : null
}

// Publish the bot's own slash-commands to Telegram's "/" autocomplete + menu
// button (setMyCommands), so `/agent` and the rest are discoverable instead of
// blind-typed. Best-effort and idempotent: a network/API failure is logged and
// ignored — the daemon's job is routing, not the menu. The ENTIRE body is
// wrapped: botPost already swallows transport errors, but the whole publish path
// is belt-and-suspenders try/catch'd so no future regression on this side path
// can ever throw into runDaemon and abort startup. validateBotCommands guards
// the list against Telegram's constraints (the test suite enforces it too).
//
// Scope: the default (global) scope — the menu shows in every chat with the bot.
// tg-ctl is a single-user personal control bot (one TG_CHAT_ID), so global is the
// intended choice; a multi-tenant bot would scope per chat to avoid leaking the
// menu to other chats.
async function publishBotCommands(ctx: Ctx): Promise<void> {
  try {
    validateBotCommands()
    const json = await botPost(ctx, "setMyCommands", { commands: BOT_COMMANDS })
    if (json?.ok === true) log(`setMyCommands ok — published ${BOT_COMMANDS.length} commands`)
    else log("setMyCommands did not confirm ok — menu may be stale (continuing)")
  } catch (err) {
    // Unreachable on today's code (botPost is try/catch'd, validate only throws
    // on a bad list we control) — but startup must survive it regardless.
    log(`setMyCommands failed — menu not published (continuing): ${err}`)
  }
}

// Tab separator — pane_current_path may contain spaces (see discover.ts).
// #{window_name} is carried in the CORE snapshot (a fixed field BEFORE the greedy
// path) so the /agent picker can label by the user-set window name reliably
// (tg-cli#75 fix C); the previous separate window-name tmux call did NOT pass the
// UTF-8 locale env, so under launchd the tab-mangle blanked every name and the
// picker fell back to the cwd basename.
const PANE_FORMAT =
  "#{session_name}\t#{window_index}\t#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{window_name}\t#{@tg_spawn_token}\t#{pane_current_path}"

// Subprocess env with a GUARANTEED UTF-8 locale. THE root cause of the "Claude Code not in tmux"
// saga: under launchd the daemon inherits NO locale (LANG/LC_* unset), and tmux then classifies the
// TAB separator in PANE_FORMAT as non-printable and ESCAPES it to `_` in its `-F` output. Every line
// then collapses to a single field, parsePaneList drops it (<8 fields), snapshot() returns ZERO
// panes, and the daemon reports "not in tmux" for every message despite live agent panes. A UTF-8
// locale makes tmux emit real tabs. It MUST be passed explicitly on the spawn — Bun.spawnSync does
// NOT pick up a runtime `process.env` mutation — so this env is handed to every discovery subprocess.
// (#44/#46 retried a symptom; the output was non-empty but mis-separated, which is why a retry could
// never fix it.)
//
// Set LC_ALL UNCONDITIONALLY. LC_ALL is the top-priority locale var, so this overrides ANY inherited
// state — including the trap where LC_ALL=C coexists with LANG=*.UTF-8 (common in cron/CI profiles):
// a "does any var look UTF-8?" check would see LANG and wrongly leave the effective C locale in place.
// Discovery output is parsed as raw bytes, so the SPECIFIC UTF-8 locale is irrelevant — only that it
// IS UTF-8. Pick one guaranteed to exist on the platform: macOS ships en_US.UTF-8 but not C.UTF-8;
// minimal Linux images often ship C.UTF-8 but not en_US.UTF-8.
const SUBPROC_ENV: Record<string, string> = (() => {
  const env = { ...process.env } as Record<string, string>
  env.LC_ALL = process.platform === "darwin" ? "en_US.UTF-8" : "C.UTF-8"
  return env
})()

// tmux absent / no server / ps failure → empty snapshot, never a crash:
// discovery then degrades to the no-agent reply path.
function snapshot(): { panes: PaneInfo[]; procs: ProcInfo[] } {
  let procs: ProcInfo[] = []
  // Retry a transient empty/failed `tmux list-panes` before accepting "no panes". panesWithRetry is
  // a no-op on the happy path (breaks on the first non-empty read) and pure/unit-tested. The env is
  // forced UTF-8 (see SUBPROC_ENV) so tmux emits real tab separators.
  const panes = panesWithRetry(
    () => {
      try {
        const tmux = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", PANE_FORMAT], {
          stdout: "pipe",
          stderr: "pipe",
          env: SUBPROC_ENV,
        })
        return { exitCode: tmux.exitCode ?? 1, stdout: tmux.stdout.toString() }
      } catch {
        return null // tmux binary missing — retrying cannot help
      }
    },
    { sleep: (ms) => Bun.sleepSync(ms) },
  )
  // The ps query gets the SAME transient-empty resilience as tmux above: `ps -axo` returning an
  // empty list is impossible on a live system (system procs always exist), so an empty/failed read
  // is a launchd-runtime flake — and an empty procs list makes findAgentInPane match nothing, so
  // live agent panes report as "no agent" exactly like an empty tmux read (the gap the tmux-only
  // retry missed). Retry an exit-0-but-empty read; break on the first non-empty or a hard failure.
  for (let i = 0; i < 3; i++) {
    if (i > 0) Bun.sleepSync(120)
    try {
      const ps = Bun.spawnSync(["ps", "-axo", "pid=,ppid=,command="], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (ps.exitCode !== 0) break // ps failed hard — retrying unlikely to help
      procs = parseProcList(ps.stdout.toString())
      if (procs.length > 0) break
    } catch {
      break // ps missing — never on a supported platform
    }
  }
  return { panes, procs }
}

// Raw `#{pane_title}` per pane id — the harness title omp (`π > title`) and Claude Code
// (`✳ title`) paint into the terminal (secondary name, tg-cli#455). A separate query, not a
// PANE_FORMAT field: a title is free text and would break that parser's fixed layout. Only
// the naming surfaces read it; any failure degrades to "no titles", never to "no panes".
function readPaneTitles(): Map<string, string> {
  try {
    const tmux = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{pane_title}"], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
    })
    return tmux.exitCode === 0 ? parsePaneTitles(tmux.stdout.toString()) : new Map()
  } catch {
    return new Map()
  }
}

// Read the per-pane registration SET (tg-cli#67). Tolerates the legacy
// single-object file shape (a daemon upgraded in place keeps the live
// registration written by the previous version — see parseRegistrations).
// `livePaneIds` prunes entries whose pane is gone; pass null to skip pruning
// (no snapshot available, or a momentarily-empty/flaky one — pruning on empty
// would wipe every live session at once). Inside the daemon a keyed row then
// follows its session through the registry: to the pane it lives in now, or out
// of the set once it is gone, so a reused pane never inherits it (#354).
function readRegistrations(paths: CtlPaths, livePaneIds: Set<string> | null = null): Registration[] {
  let raw: string | null
  try {
    raw = readFileSync(paths.registration, "utf8")
  } catch {
    return []
  }
  return pruneRegistrations(resolveRegistrationsBySession(parseRegistrations(raw), currentSessionRegistry()), livePaneIds)
}

// Durably PRUNE dead-pane entries from the on-disk store (review finding): the
// daemon reads-and-prunes in memory every poll, but without writing the pruned
// set back, dead entries accumulate forever — and upsertRegistration's cap
// evicts by insertion order, so 100 piled-up dead entries would eventually evict
// a still-LIVE session and silently drop its questions (the exact failure this
// feature fights). So when discovery sees the store shrink under a TRUSTWORTHY
// live-pane set, persist the smaller set. Race-safe: re-read + re-prune INSIDE
// the registration lock, so a `tg start` that upserted between the poll read and
// here is not clobbered. Best-effort and off the hot path — never throws, and is
// skipped entirely on a flaky/empty snapshot (livePaneIds === null).
function pruneRegistrationsOnDisk(paths: CtlPaths, livePaneIds: Set<string> | null): void {
  if (livePaneIds === null) return
  try {
    withRoutesLock(
      fsRoutesLockIo(`${paths.registration}.lock`),
      () => {
        let raw: string | null
        try {
          raw = readFileSync(paths.registration, "utf8")
        } catch {
          return
        }
        const current = parseRegistrations(raw)
        const pruned = pruneRegistrations(current, livePaneIds)
        if (pruned.length !== current.length) {
          writeFileSync(paths.registration, serializeRegistrations(pruned))
        }
      },
      { onContended: "skip" }, // a live writer holds the lock — let it; we prune next poll
    )
  } catch {
    // best-effort prune — never break the poll loop
  }
}

// Fresh discovery on every call — the registration file may have been
// rewritten by a newer `tg`/`tg-ctl start` since the last poll.
// An explicit `tg-ctl start --session X` (stored in the registration) outranks
// config.yaml's control.session: it is the fresher, more specific intent, and
// the auto-start path never sets it (tg passes only --pane/--cwd).
// Rate-limit the no-agent diagnostic so the per-poll idle check can't spam the log.
let lastNoAgentLogMs = 0
function discoverTarget(ctx: Ctx): DiscoverResult {
  const { panes, procs } = snapshot()
  // Prune dead-pane entries against the live snapshot, but ONLY when the snapshot
  // actually has panes — an empty/flaky read must not wipe every registration
  // (panesWithRetry already retried the transient empty case).
  const livePaneIds = panes.length > 0 ? new Set(panes.map((p) => p.paneId)) : null
  const regs = readRegistrations(ctx.paths, livePaneIds)
  // Persist the prune so dead-pane entries can't accumulate to the cap and evict
  // a live session (review finding). Off the hot path, lock-guarded, no-op when
  // nothing was pruned or the snapshot is untrustworthy.
  pruneRegistrationsOnDisk(ctx.paths, livePaneIds)
  // An explicit `tg-ctl start --session X` (the fresher, more specific intent)
  // outranks config.yaml's control.session; the auto-start path never sets it.
  const sessionPin = regs.find((r) => r.sessionName)?.sessionName ?? ctx.cfg.session
  const result = pickTargetPaneFromSet(panes, procs, regs, sessionPin)
  // OBSERVABILITY: a "no-agent" result is what produces the misleading "Claude Code not in tmux"
  // reply. It has been an UNREPRODUCIBLE intermittent in the launchd runtime, so log the snapshot
  // shape on it — the next occurrence then shows the REAL cause (tmux-empty vs ps-empty vs
  // agent-match-fail vs a stale registration) instead of failing silently. Rate-limited to ≤1/10s.
  if (!result.ok && result.reason === "no-agent") {
    const now = Date.now()
    if (now - lastNoAgentLogMs > 10_000) {
      lastNoAgentLogMs = now
      const agentPanes = panes.filter((p) => findAgentInPane(p, procs)).length
      const regSummary = regs.length > 0 ? regs.map((r) => `${r.paneId ?? "?"}@${r.cwd ?? "?"}`).join(",") : "none"
      log(
        `no-agent reply: panes=${panes.length} procs=${procs.length} agent-panes=${agentPanes} ` +
          `regs=${regs.length} reg=${regSummary}`,
      )
    }
  }
  return result
}

// Git-state-check banner support (git-state.ts): a best-effort, timeout-guarded read of the
// destination pane's cwd, run right before a silent auto-bind delivery. A stuck `git` (lock
// contention, a huge repo, a hung network filesystem) must never block the daemon's single-
// threaded poll loop, so both spawns are killed after GIT_STATE_TIMEOUT_MS; ANY failure — not a
// git repo, the git binary missing, a timeout, a non-zero exit — degrades to null (no banner),
// the same "never breaks delivery" contract every other best-effort read in this file follows.
const GIT_STATE_TIMEOUT_MS = 2000
function gitStateForPath(cwd: string): PaneGitState | null {
  try {
    const branchProc = Bun.spawnSync(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"], {
      stdout: "pipe",
      stderr: "pipe",
      timeout: GIT_STATE_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (branchProc.exitCode !== 0) return null // not a git repo, or git errored — undeterminable
    const statusProc = Bun.spawnSync(["git", "-C", cwd, "status", "--porcelain"], {
      stdout: "pipe",
      stderr: "pipe",
      timeout: GIT_STATE_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (statusProc.exitCode !== 0) return null
    return buildPaneGitState(branchProc.stdout.toString(), statusProc.stdout.toString())
  } catch {
    return null // git binary missing — never break the poll loop
  }
}

// All tmux panes that host an agent, as /agent selection candidates (item 1).
// The window name comes from the CORE snapshot's #{window_name} field (tg-cli#75
// fix C) — NOT a separate tmux call: that call skipped the UTF-8 locale env, so
// under launchd the tab-mangle blanked every name and the picker fell back to the
// cwd basename ("hyperide · claude" instead of "ext · claude"). A pane with no
// usable name (empty / a bare default) is detected downstream (isBareWindowName)
// and the label leans on the cwd basename there; here we fall back to the session
// name only when the snapshot carried no window name at all.
function listAgentCandidates(): AgentCandidate[] {
  const { panes, procs } = snapshot()
  const out: AgentCandidate[] = []
  for (const pane of panes) {
    const found = findAgentInPane(pane, procs)
    if (!found) continue
    out.push({
      paneId: pane.paneId,
      sessionName: pane.sessionName,
      windowIndex: pane.windowIndex,
      windowName: pane.windowName || pane.sessionName,
      agent: found.agent,
      // cwd — the picker derives a distinct project-dir label from its basename
      // when window names collide or are bare defaults (the "4 · claude" ×3 bug).
      panePath: pane.panePath,
    })
  }
  // The harness title each agent pane shows — the picker's SECONDARY name, read only
  // for panes that host an agent (a pane whose omp exited keeps its stale title).
  const titles = out.length > 0 ? readPaneTitles() : new Map<string, string>()
  for (const c of out) c.paneTitle = titles.get(c.paneId) ?? null
  // A pane id is unique per tmux server; dedupe guards a merged/flaky snapshot.
  // Out-of-tmux omp join as paneId omp:<pid> so /agent can pick them; an omp shown
  // in a pane keeps that pane's row and adds its title (never renames the row).
  const merged = mergeLiveOmpCandidates(dedupeCandidates(out), listLiveOmpAgents())
  // A session a rig wrapper hosts in abduco outside tmux joins as `host:<name>`.
  merged.push(...ptyOnlyHosts(panes, procs).map(hostToCandidate))
  // An omp a rig wrapper hosts is already the `omp:<pid>` row above (that row is how it is reached);
  // it takes the wrapper's label and id so `/agent <label>` selects it like any other host.
  const ompHosts = listLiveHosts(procs).filter((h) => h.agent === "omp")
  for (const c of merged) {
    const host = c.paneId.startsWith("omp:") ? ompHosts.find((h) => `omp:${h.harnessPid}` === c.paneId) : undefined
    if (host) {
      c.windowName = hostDisplayName(host)
      c.aliases = [...(c.aliases ?? []), host.name]
    }
  }
  // Names a session had before a rename (registry aliases, spec §3.2), so
  // `/agent <oldname>` still reaches it.
  const registry = sessionRegistry
  if (registry) {
    for (const c of merged) {
      const key = resolveLocatorToSession(registry, c.paneId, undefined)
      const aliases = key ? registry.sessions.find((e) => e.key === key)?.aliases : undefined
      if (aliases && aliases.length > 0) c.formerNames = aliases
    }
  }
  return merged
}

// --- agents OUTSIDE tmux (tg-cli#306) ---
//
// A second, cheap ps read (`pid tty` only) is DISPLAY-ONLY for claude/codex/opencode
// (tg-cli#413 follow-up removed the gate there — see the "Past bug (tg-cli#413
// follow-up)" note above `findUnreachableAgents`); for pi/aider/omp/unknown (no
// per-shape headless detection) it is still load-bearing: `findUnreachableAgents`
// requires a real tty map entry for those kinds before listing one as unreachable.
// Their cwd comes from lsof (one call per such agent — a handful at most). A `ps`
// failure here degrades to an empty map, never a crash — that only suppresses
// pi/aider/omp/unknown (still tty-gated); claude/codex/opencode are listed either way.
function readPidTtyMap(): Map<number, string> {
  try {
    const ps = Bun.spawnSync(["ps", "-axo", "pid=,tty="], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    if (ps.exitCode !== 0) return new Map()
    return parsePidTtyList(ps.stdout.toString())
  } catch {
    return new Map()
  }
}

// #458: when the installed bridge last changed — the managed loader (same agent root
// ensureOmpLiveExtensionOnStartup installs into) and the files it names (the extension and
// runtime; the runtime imports only node builtins) — vs when each unbridged omp started:
// tells "resume once to load it" from a real bridge failure. No loader, a loader with no
// file URL, any missing file or a `ps` failure degrades to no verdict, never a crash.
function readBridgeCodeAge(home: string, pids: number[]): BridgeCodeAge | undefined {
  const loaderPath = join(home, ".omp", "agent", "extensions", "tg-omp-live.ts")
  const codeChangedAtMs = bridgeCodeChangedAtMs(loaderPath, readFileOrNull(loaderPath), fileMtimeMs)
  try {
    const ps = Bun.spawnSync(["ps", "-o", "pid=,etime=", "-p", pids.join(",")], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    return { codeChangedAtMs, startedAtMs: parsePidStartList(ps.stdout.toString(), Date.now()) }
  } catch {
    return undefined
  }
}

const LSOF_TIMEOUT_MS = 2000
let lsofMissingWarned = false
// The agent's cwd: `/proc/<pid>/cwd` where it exists (Linux — no external tool),
// else `lsof` (macOS ships it). On a Linux box with neither the cwd is unknown — said
// ONCE in the log, never silently — and the agent is still listed, by its --name or
// pid, just without a cwd-derived inbox key.
function cwdOfPid(pid: number): string | null {
  try {
    return readlinkSync(`/proc/${pid}/cwd`)
  } catch {
    // no procfs (macOS) or the process is gone — fall through to lsof
  }
  try {
    const lsof = Bun.spawnSync(["lsof", "-a", "-p", String(pid), "-d", "cwd", "-Fn", "-n"], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
      timeout: LSOF_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (lsof.exitCode !== 0) return null
    return parseLsofCwd(lsof.stdout.toString())
  } catch (err) {
    if (!lsofMissingWarned) {
      lsofMissingWarned = true
      log(`unreachable scan: cannot resolve the cwd of pid ${pid} — no /proc and lsof failed (${err}); install lsof for cwd-keyed inboxes`)
    }
    return null
  }
}

// Memoized for a short window: the scan is sync (ps + one lsof per agent, up to
// LSOF_TIMEOUT_MS each) and one inbound message can ask for it several times in a row
// (route attempt, then the no-agent reply); a poll tick asks once more. One scan per
// ~2s keeps the single-threaded poll loop responsive (review finding).
const UNREACHABLE_SCAN_TTL_MS = 2000
let unreachableCache: { at: number; agents: UnreachableAgent[] } | null = null
function listUnreachableAgents(): UnreachableAgent[] {
  const now = Date.now()
  if (unreachableCache && now - unreachableCache.at < UNREACHABLE_SCAN_TTL_MS) return unreachableCache.agents
  const ttyByPid = readPidTtyMap()
  const { panes, procs } = snapshot()
  const hosts = listLiveHosts(procs)
  const agents = findUnreachableAgents(panes, procs, ttyByPid)
    .filter((a) => a.agent !== "omp")
    // A harness a rig wrapper hosts in abduco is reachable through its PTY, not unreachable.
    .filter((a) => hostOfPid(a.pid, procs, hosts) === null)
    .map((a) => ({ ...a, cwd: cwdOfPid(a.pid) }))
  unreachableCache = { at: now, agents }
  return agents
}

// --- Sessions a rig wrapper hosts in abduco OUTSIDE tmux (docs/specs/2026-09-30-harness-agnostic-control.md) ---
//
// The wrapper writes <config>/hosts/<name>.json; tg-ctl only READS it, and a record counts only
// while the process table still shows its abduco server with exactly one harness below it
// (liveHosts) — a crashed or exited session drops out without anything having to delete its record.
// Delivery types the message into the session's PTY through abduco's client socket.
const hostIssuesLogged = new Set<string>()
function logHostIssueOnce(key: string, message: string): void {
  if (hostIssuesLogged.has(key)) return
  hostIssuesLogged.add(key)
  log(message)
}

function loadHostRecords(): HostRecord[] {
  const { records, rejected } = readHostRecords(hostsDir(resolveConfigDir(process.env.HOME ?? "~")), process.getuid?.() ?? -1)
  for (const r of rejected) logHostIssueOnce(`${r.file}:${r.reason}`, `host registry: ignoring ${r.file} — ${r.reason}`)
  return records
}

function isUnixSocket(path: string): boolean {
  try {
    return statSync(path).isSocket()
  } catch {
    return false
  }
}

// Every registered host the process table proves alive right now. `procs`: the discovery
// snapshot the caller already holds (this is called from inside hot paths, so it never scans).
function listLiveHosts(procs: ProcInfo[]): LiveHost[] {
  const { live, skipped } = liveHosts(loadHostRecords(), procs, isUnixSocket)
  for (const s of skipped) logHostIssueOnce(`${s.name}:${s.reason}`, `host registry: ${s.name} is not live — ${s.reason}`)
  return live
}

// The live hosts whose PTY is the ONLY view of the session: one a tmux pane shows (through an
// `abduco -a` client) or omp-live already lists is reached through that row, not a second one.
function ptyOnlyHosts(panes: PaneInfo[], procs: ProcInfo[]): LiveHost[] {
  const shown = new Set<number>(listLiveOmpAgents().map((a) => a.pid))
  for (const pane of panes) {
    const pid = findAgentInPane(pane, procs)?.pid
    if (pid !== undefined) shown.add(pid)
  }
  return hostsNotShownElsewhere(listLiveHosts(procs), shown)
}

// Types `text` into the PTY of the named host, after any earlier message for it has finished. The
// host is looked up in a FRESH process table only once its turn comes: during the wait it may
// have exited (the wrapper relaunching its harness leaves a live abduco server with nothing
// under it). `expectPid`: the harness must still be this exact process. No ledger here: the
// caller owns the claim.
function typeIntoHost(name: string, text: string, logNote: string, expectPid?: number): Promise<SinkResult> {
  return serializeTyping(`host:${name}`, async (): Promise<SinkResult> => {
    const host = listLiveHosts(snapshot().procs).find((h) => h.name === name && (expectPid === undefined || h.harnessPid === expectPid))
    if (!host) return { ok: false, error: `${name} is no longer running under the rig wrapper — message not delivered` }
    log(`host-pty: ${logNote} → ${host.name} (${host.agent} pid ${host.harnessPid}, cwd ${host.cwd ?? "?"})`)
    return typeIntoHostNow(host, text)
  })
}

// Two messages for one typing target (a host's PTY, a tmux pane) are typed one after the other:
// interleaved, one's text would ride the other's Enter, and a pane's submit-check would read a
// box holding both. `key`: `host:<name>` or `pane:<paneId>`.
const typingTail = new Map<string, Promise<unknown>>()
function serializeTyping<T>(key: string, run: () => Promise<T>): Promise<T> {
  const result = (typingTail.get(key) ?? Promise.resolve()).then(run, run)
  const tail = result.catch(() => undefined)
  typingTail.set(key, tail)
  void tail.then(() => {
    if (typingTail.get(key) === tail) typingTail.delete(key)
  })
  return result
}

async function typeIntoHostNow(host: LiveHost, text: string): Promise<SinkResult> {
  const res = await injectIntoAbducoSession({ connect: connectAbducoSocket, sleep: (ms) => Bun.sleep(ms) }, host.socket, text)
  if (res.ok) return { ok: true }
  const who = hostDisplayName(host)
  log(`host-pty: ${host.name} failed${res.uncertain ? " after the text was partly written" : ""}: ${res.error}`)
  return {
    ok: false,
    uncertain: res.uncertain,
    error: res.uncertain
      ? `${who}: ${res.error}. The message may already be in its prompt — check before resending; it was not sent again.`
      : `${who}: ${res.error} — message not delivered.`,
  }
}

// Types an inbound Telegram message into a wrapper-hosted session's PTY at most once
// (tg-cli#299). The host is re-verified against a fresh process table INSIDE the claim, right
// before typing: it may have exited, or been replaced, between picking the target and typing — and a replay
// of an already delivered message must be suppressed without touching the session at all.
function deliverToHost(name: string, text: string, messageId: number | string | null | undefined): Promise<SinkResult> {
  return deliverInboundOnce(typeof messageId === "number" ? messageId : null, hostOriginId(name), () => typeIntoHost(name, text, `tg#${messageId ?? "-"}`))
}

// The one entry for a delivery addressed by route-origin / picker id: null when `paneId` is not a
// `host:<name>` address (the caller continues with its tmux/omp handling), else the exactly-once
// delivery into that host's PTY.
function deliverHostPane(paneId: string, text: string, messageId: number | string | null | undefined): Promise<SinkResult> | null {
  const name = hostNameFromOriginId(paneId)
  return name === null ? null : deliverToHost(name, text, messageId)
}

// `lsof -Fn` n-paths for a pid — used to find omp's primary session jsonl.
function jsonlPathsOfPid(pid: number): string[] {
  try {
    const lsof = Bun.spawnSync(["lsof", "-a", "-p", String(pid), "-Fn", "-n"], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
      timeout: LSOF_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (lsof.exitCode !== 0) return []
    return parseLsofJsonlPaths(lsof.stdout.toString())
  } catch {
    return []
  }
}

// omp's own per-terminal record of the session it is running (tg-cli#487): the
// fallback for an omp holding no session jsonl open at all.
function ompBreadcrumbSessionFile(agent: LiveOmpAgent, cwd: string | null): string | null {
  const id = ompTerminalId(agent)
  if (!id) return null
  const home = process.env.HOME
  const agentDir = process.env.PI_CODING_AGENT_DIR?.trim() || (home ? join(home, ".omp", "agent") : null)
  if (!agentDir) return null
  try {
    const file = ompSessionFileFromBreadcrumb(readFileSync(join(agentDir, "terminal-sessions", id), "utf8"), cwd)
    return file && existsSync(file) ? file : null
  } catch {
    return null
  }
}

// `panes`/`procs`: the discovery snapshot the agents were derived from, kept so the
// session-registry scan reuses it instead of paying for its own ps/lsof pass.
// `serverPid`: the tmux server of exactly that pane list, read on both sides of it
// only while a registry scan is wanted (undefined = not read for this snapshot).
let liveOmpCache: { at: number; agents: LiveOmpAgent[]; panes: PaneInfo[]; procs: ProcInfo[]; serverPid: number | null | undefined } | null = null
function listLiveOmpAgents(): LiveOmpAgent[] {
  const now = Date.now()
  if (liveOmpCache && now - liveOmpCache.at < UNREACHABLE_SCAN_TTL_MS) return liveOmpCache.agents
  const ttyByPid = readPidTtyMap()
  const wantServerPid = sessionScanWanted()
  const serverPidBefore = wantServerPid ? readTmuxServerPid() : null
  const { panes, procs } = snapshot()
  const serverPid = wantServerPid ? serverPidAcross(serverPidBefore, readTmuxServerPid()) : undefined
  const agents = findLiveOmpAgents(panes, procs, ttyByPid).map((a) => {
    const host = originalHosts.find(h => h.pid === a.pid)
    if (host) return { ...a, ...host }
    const cwd = cwdOfPid(a.pid)
    // A subagent-derived main file is only a name; like the breadcrumb, trust it only if it exists.
    const openFile = pickPrimaryOmpSessionFile(jsonlPathsOfPid(a.pid))
    const sessionFile = (openFile && existsSync(openFile) ? openFile : null) ?? ompBreadcrumbSessionFile(a, cwd)
    let meta = null
    if (sessionFile) {
      try {
        meta = parseOmpSessionMeta(readFileSync(sessionFile, "utf8"))
      } catch {
        meta = null
      }
    }
    return withOmpSession(a, { cwd, sessionFile, meta })
  })
  for (const host of originalHosts) {
    if (!agents.some(a => a.pid === host.pid) && procs.some(p => p.pid === host.pid)) {
      agents.push({ ...host, paneId: null, tty: null })
    }
  }
  liveOmpCache = { at: now, agents, panes, procs, serverPid }
  return agents
}

// The original interactive OMP owns the endpoint. ACP session/load is NOT attach.
let originalHosts: OriginalOmpEndpoint[] = []
let originalProbe: Promise<void> | null = null
let originalProbeAt = 0
async function refreshOriginalHosts(): Promise<void> {
  if (originalProbe) return originalProbe
  if (Date.now() - originalProbeAt < 2000) return
  originalProbe = (async () => {
    try { originalHosts = await listLiveEndpoints(defaultRegistryRoot()) }
    catch { originalHosts = [] }
    originalProbeAt = Date.now()
    liveOmpCache = null
  })().finally(() => { originalProbe = null })
  return originalProbe
}
// --- Inbound delivery ledger (tg-cli#299, features/tg-ctl/delivery-ledger.ts) ---
// Opened by runDaemon; null in every other process (ask, status, …), which never
// delivers an inbound message, so every gate below passes straight through there.
// Keyed by the daemon's one chat (TG_CHAT_ID): every route and reply goes to it.
let deliveryLedger: { path: string; chat: number; state: LedgerState } | null = null

function openDeliveryLedger(path: string, chat: number): LedgerState {
  const events = parseLedger(readFileOrNull(path))
  const kept = compactLedger(events)
  if (kept) {
    try {
      atomicWrite(path, serializeLedgerEvents(kept))
    } catch (err) {
      log(`delivery ledger compaction failed: ${err instanceof Error ? err.message : String(err)}`)
    }
  }
  const state = applyLedgerEvents(emptyLedgerState(), kept ?? events)
  deliveryLedger = { path, chat, state }
  return state
}

// tg auth's `/start <nonce>` claim (docs/specs/tg-auth.md §4): persist the chat into the .env and
// report it to the waiting `tg auth` through the pending file. Returns whether the chat was
// saved; the caller switches to it (switchChat) only from the NEXT batch, so the batch that
// carried the tap is routed and ledgered against the one chat it was received for. A failed
// .env write is reported as `failed` and changes nothing.
function claimAuthBinding(ctx: Ctx, claim: { chat: AuthChat; pending: PendingAuth }): boolean {
  const envPath = join(ctx.configDir, ".env")
  try {
    atomicWrite(envPath, mergeEnvContent(readFileOrNull(envPath), { TG_CHAT_ID: String(claim.chat.id) }))
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err)
    log(`tg auth: cannot save chat ${claim.chat.id} to ${envPath}: ${message}`)
    try {
      atomicWrite(ctx.paths.authPending, serializePending(markAuthFailed(claim.pending, message)))
    } catch (reportErr) {
      log(`tg auth: cannot report the failure: ${reportErr instanceof Error ? reportErr.message : String(reportErr)}`)
    }
    return false
  }
  try {
    atomicWrite(ctx.paths.authPending, serializePending(markAuthBound(claim.pending, claim.chat, Date.now())))
  } catch (err) {
    log(`tg auth: chat saved, but cannot report it to tg auth: ${err instanceof Error ? err.message : String(err)}`)
  }
  log(`tg auth: bound chat ${claim.chat.id}${claim.chat.id === ctx.chatId ? " (unchanged)" : ` (was ${ctx.chatId})`}`)
  return true
}

// The daemon keeps running on a chat `tg auth` just bound — no restart (tg-cli#561).
function switchChat(ctx: Ctx, chatId: number): void {
  if (chatId === ctx.chatId) return
  log(`now serving chat ${chatId} (was ${ctx.chatId})`)
  ctx.chatId = chatId
  if (deliveryLedger) deliveryLedger.chat = chatId
}

// Folds `events` into the live state, then appends and fsyncs them: a claim must be
// on disk before the text leaves the daemon, or a kill right after the send would
// forget the send happened. Returns whether the events reached the disk.
function recordDelivery(events: LedgerEvent[]): boolean {
  const ledger = deliveryLedger
  if (!ledger || events.length === 0) return true
  applyLedgerEvents(ledger.state, events)
  try {
    const fd = openSync(ledger.path, "a", 0o600)
    try {
      const buf = Buffer.from(serializeLedgerEvents(events))
      for (let off = 0; off < buf.length; ) off += writeSync(fd, buf, off)
      fsyncSync(fd)
    } finally {
      closeSync(fd)
    }
    return true
  } catch (err) {
    // The in-memory state still blocks a second send in this run; only a restart
    // could repeat a message whose record never reached the disk.
    log(`delivery ledger append failed: ${err instanceof Error ? err.message : String(err)}`)
    return false
  }
}

function recordHeld(messageId: number | null, target: string, hold: LedgerHold): void {
  if (messageId === null || !deliveryLedger) return
  recordDelivery([{ ts: Date.now(), event: "queued", chat: deliveryLedger.chat, msg: messageId, target, hold }])
}

// A held message the daemon gave up on outside any sink (an expired picker or topic
// hold, a picker lost by a restart) — the CTO is told separately.
function recordFailed(messageId: number, target: string, error: string): void {
  if (!deliveryLedger) return
  recordDelivery([{ ts: Date.now(), event: "failed", chat: deliveryLedger.chat, msg: messageId, target, error }])
}

// THE gate every sink puts in front of an inbound Telegram message (the omp-live
// bridge, tmux send-keys, the Stop-hook inbox): a message already delivered, or in
// flight, is not sent again — it reports success, since it did arrive. Otherwise a
// durable claim, the send, then its outcome; a claim that cannot reach the disk sends
// nothing (a restart could not know it went out) and fails the delivery instead.
// `messageId` null: not an inbound message (a key press, a synthetic notice) — sent as is.
async function deliverInboundOnce<R extends SinkResult>(
  messageId: number | null | undefined,
  target: string,
  send: () => Promise<R>,
): Promise<R | { ok: true } | { ok: false; error: string }> {
  const ledger = deliveryLedger
  if (!ledger || messageId === null || messageId === undefined) return send()
  const base = { chat: ledger.chat, msg: messageId, target }
  const decision = decideDelivery(ledger.state.messages.get(ledgerKey(ledger.chat, messageId)))
  if (decision.kind === "suppress") {
    log(`delivery: tg#${messageId} → ${target} suppressed — already ${decision.prior.state} to ${decision.prior.target}`)
    recordDelivery([{ ts: Date.now(), event: "duplicate", ...base, prior: decision.prior.state }])
    return { ok: true }
  }
  if (!recordDelivery([{ ts: Date.now(), event: "claimed", ...base }])) {
    const error = "the delivery ledger could not be written, so it was not sent"
    recordDelivery([{ ts: Date.now(), event: "failed", ...base, error }])
    return { ok: false, error }
  }
  let res: R
  try {
    res = await send()
  } catch (err) {
    recordDelivery([{ ts: Date.now(), event: "failed", ...base, error: err instanceof Error ? err.message : String(err) }])
    throw err
  }
  recordDelivery([sinkOutcomeEvent(Date.now(), base, res)])
  return res
}

// `paneId`: the tmux pane this exact OMP runs in, when known. An OMP with NO
// endpoint there is still the original process — typing into its own TUI is its
// normal input path, not a second history writer and not a spawn (#458).
// A numeric `messageId` is an inbound Telegram message: sent at most once (tg-cli#299).
async function deliverOriginalOmp(target: OriginalOmpTarget, text: string, messageId?: number | string, paneId?: string | null): Promise<SinkResult> {
  if (typeof messageId !== "number") return sendOriginalOmp(target, text, messageId, paneId)
  return deliverInboundOnce(messageId, paneId ?? `omp:${target.pid ?? "?"}`, () => sendOriginalOmp(target, text, messageId, paneId))
}

async function sendOriginalOmp(target: OriginalOmpTarget, text: string, messageId?: number | string, paneId?: string | null): Promise<SinkResult> {
  let code: string
  try {
    await refreshOriginalHosts()
    const host = selectOriginalEndpoint(target, originalHosts)
    const receipt = await sendLiveMessage({ root: defaultRegistryRoot(), pid: host.pid,
      instanceId: host.instanceId, sessionId: host.sessionId, requestId: originalRequestId(text, messageId), text })
    log(`omp-live: accepted pid=${receipt.pid} instance=${receipt.instanceId} session=${receipt.sessionId} request=${receipt.requestId}`)
    return { ok: true }
  } catch (err) {
    code = err instanceof Error && /^[a-z_]+$/.test(err.message) ? err.message : 'delivery_failed'
  }
  // Only a proven-absent endpoint may fall back: any other code means the endpoint
  // exists (or may have accepted the text), and typing it again would duplicate it.
  // The fallback is the terminal that hosts this exact process — its tmux pane, else the
  // abduco session the rig wrapper runs it in: its own TUI either way, no second writer.
  if (code === 'endpoint_unavailable' && target.pid !== undefined) {
    if (paneId && !paneId.startsWith("omp:")) {
      const res = await typeIntoOwnOmpPane(paneId, target.pid, text)
      if (res) return res
    }
    const hosted = await typeIntoHostOfOmp(target.pid, text)
    if (hosted) return hosted
  }
  log(`omp-live: rejected reason=${code} (no replacement process started)`)
  // A timed-out or dropped connection already handed the text to a live, busy host.
  if (code === 'endpoint_timeout' || code === 'endpoint_connection_lost') {
    return { ok: false, error: `Original OMP bridge: ${code}. The original OMP is busy; the text may still arrive when it frees up — check before resending. No second agent was started.` }
  }
  return { ok: false, error: `Original OMP bridge: ${code}. Run tg-ctl omp-live install. Save/stop the original before resuming it once to load the bridge; never start a second copy. No second agent was started.` }
}
// null = the pane no longer hosts exactly this OMP pid; the caller fails closed.
async function typeIntoOwnOmpPane(paneId: string, pid: number, text: string): Promise<SinkResult | null> {
  const { panes, procs } = snapshot()
  const pane = panes.find((p) => p.paneId === paneId)
  const hosted = pane ? findAgentInPane(pane, procs) : null
  if (hosted?.agent !== "omp" || hosted.pid !== pid) return null
  log(`omp-live: no endpoint for pid=${pid} — tmux send-keys into its own pane ${paneId} (original process, no spawn)`)
  return executeInjectSteps(buildTextInjectPlan(paneId, text))
}
// null = no live rig-wrapper host runs exactly this omp pid; the caller fails closed.
async function typeIntoHostOfOmp(pid: number, text: string): Promise<SinkResult | null> {
  const { procs } = snapshot()
  const host = hostOfPid(pid, procs, listLiveHosts(procs))
  if (!host || host.agent !== "omp" || host.harnessPid !== pid) return null
  log(`omp-live: no endpoint for pid=${pid} — abduco PTY of ${host.name} (original process, no spawn)`)
  return typeIntoHost(host.name, text, `omp pid ${pid}`, pid)
}

// --- Session registry (docs/specs/session-registry-and-topics.md §2, tg-cli#487) ---
// The daemon is the ONLY writer of sessions.json. Off the poll hot path: at most
// once per SESSION_SCAN_INTERVAL_MS (sooner when a hook sighting needs binding),
// deferred to run while the long-poll is in flight, one scan at a time. A scan
// reuses the tick's cached discovery (listLiveOmpAgents' snapshot + omp list) —
// no ps/lsof of its own — turns it into LiveSessions, reconciles them into the
// registry, runs any not-yet-done one-shot store migration, and persists only
// when the serialized registry changed. Delivery paths read it through
// currentSessionRegistry / refreshSessionRegistry (session-target.ts); a failure
// here is logged and never breaks the poll loop.
const SESSION_SCAN_INTERVAL_MS = 30_000
let sessionRegistry: Registry | null = null
let sessionRegistryWritten: string | null = null
let sessionScanAt = 0
// True once this daemon reconciled a scan of its own. Before that the registry
// is the persisted file, which may predate a tmux restart during downtime.
let sessionRegistryScanned = false
let sessionScanDue = true
let sessionScanInFlight = false
// Set by the daemon's first kick: CLI one-shots that list omp never scan, so they
// never pay for the server-pid reads.
let sessionScanEnabled = false
// The daemon's ctx, set by its first kick: the delivery-time readers below are
// module-level (executeInjectSteps, readRegistrations) and CLI one-shots have none.
let sessionScanCtx: Ctx | null = null
// Bumped by every scan that ran; a queued tick scan whose discovery is older
// than a forced delivery-time scan is skipped instead of undoing it.
let sessionScanGen = 0
let sessionScanForced = false
let sessionRefreshAt = 0
const SESSION_REFRESH_MIN_MS = 2_000
// cc/codex `session_id`s seen on the hook socket, by pane. The pid is bound at
// the next scan (bindHookSessions), so a later process in the same pane never
// inherits the id.
let pendingHookSessions: PendingHookSighting[] = []
let hookSessions: HookSessionSighting[] = []
const MAX_PENDING_HOOK_SESSIONS = 64
// Names seen but not yet stable for RENAME_DEBOUNCE_MS (spec §3.2); in memory only.
let pendingRenames: PendingRenames = new Map()

// A pending rename wants the scan that can commit it as soon as its debounce ends,
// not a full SESSION_SCAN_INTERVAL_MS later.
function renameCommitDue(now: number): boolean {
  for (const p of pendingRenames.values()) if (now - p.since >= RENAME_DEBOUNCE_MS) return true
  return false
}

function sessionScanWanted(): boolean {
  if (sessionScanForced) return true
  if (!sessionScanEnabled || sessionScanInFlight) return false
  const now = Date.now()
  return sessionScanDue || now - sessionScanAt >= SESSION_SCAN_INTERVAL_MS || renameCommitDue(now)
}

// The registry as last scanned (or as persisted, before the first scan of this
// daemon). Null outside the daemon.
function currentSessionRegistry(): Registry | null {
  if (sessionRegistry || !sessionScanCtx) return sessionRegistry
  sessionRegistry = parseRegistry(readFileOrNull(sessionScanCtx.paths.sessions))
  return sessionRegistry
}

// A fresh scan right before a delivery that depends on WHO a pane or pid hosts
// now (spec §2.5 re-adoption after a resume, §2.6 pane-reuse guard): a fresh
// ps/lsof/tmux discovery, reconciled synchronously. Rate-limited so a burst of
// deliveries (a deferred flush) shares one scan; `force` skips the limit.
function refreshSessionRegistry(force = false): Registry | null {
  const ctx = sessionScanCtx
  if (!ctx || (!force && Date.now() - sessionRefreshAt < SESSION_REFRESH_MIN_MS)) return currentSessionRegistry()
  sessionRefreshAt = Date.now()
  liveOmpCache = null
  sessionScanForced = true
  try {
    listLiveOmpAgents()
  } finally {
    sessionScanForced = false
  }
  const discovery = liveOmpCache
  if (discovery && discovery.serverPid !== undefined) {
    sessionScanGen++
    scanSessionRegistry(ctx, { ...discovery, serverPid: discovery.serverPid })
  }
  return currentSessionRegistry()
}

function recordHookSession(req: ButtonRequest): void {
  const sighting = hookSightingOf(req)
  if (!sighting) return
  pendingHookSessions.push(sighting)
  if (pendingHookSessions.length > MAX_PENDING_HOOK_SESSIONS) pendingHookSessions.shift()
  sessionScanDue = true // bind it while the asking process is still alive
}

// tmux `#{pid}` of the server `list-panes` read — part of every pane locator, so a
// server restart that reuses `%N` ids never looks like the same pane (§2.6).
function readTmuxServerPid(): number | null {
  try {
    const tmux = Bun.spawnSync(["tmux", "display-message", "-p", "#{pid}"], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    const pid = Number(tmux.stdout.toString().trim())
    return tmux.exitCode === 0 && Number.isInteger(pid) && pid > 0 ? pid : null
  } catch {
    return null
  }
}

function sessionStoreIo(paths: CtlPaths): MigrationIo {
  const pathOf = (store: MigrationStore): string =>
    store === "routes" ? paths.routes : store === "registration" ? paths.registration : store === "lastUserTarget" ? paths.lastUserTarget : paths.topics
  return {
    read: (store) => readFileOrNull(pathOf(store)),
    write: (store, content) => {
      if (content !== null) return atomicWrite(pathOf(store), content)
      try {
        unlinkSync(pathOf(store))
      } catch {
        // already absent
      }
    },
    locked: (store, body) =>
      withRoutesLock(fsRoutesLockIo(`${pathOf(store)}.lock`), () => {
        body()
        return true
      }, { onContended: "skip" }) === true,
  }
}

function describeRegistryEvent(ev: RegistryEvent): string {
  switch (ev.kind) {
    case "promoted":
      return `promoted ${ev.from} → ${ev.to}`
    case "paneReused":
      return `paneReused ${ev.paneId} ${ev.from} → ${ev.to}`
    case "readopted":
      return `readopted ${ev.key} thread=${ev.threadId ?? "-"}`
    case "renamed":
      return `renamed ${ev.key} ${JSON.stringify(ev.from.primary)} → ${JSON.stringify(ev.to.primary)}${ev.to.secondary ? ` (${JSON.stringify(ev.to.secondary)})` : ""}`
    default:
      return `${ev.kind} ${ev.key}`
  }
}

// Called once per poll tick, right after the tick refreshed listLiveOmpAgents.
// Never awaits: the scan is queued behind the getUpdates request it precedes. A
// snapshot taken while no scan was wanted carries no server pid; the next
// discovery refresh (UNREACHABLE_SCAN_TTL_MS) reads one.
function kickSessionRegistryScan(ctx: Ctx): void {
  sessionScanEnabled = true
  sessionScanCtx = ctx
  if (!sessionScanWanted()) return
  const discovery = liveOmpCache
  if (!discovery || discovery.serverPid === undefined) return
  const { serverPid } = discovery
  sessionScanInFlight = true
  sessionScanDue = false
  sessionScanAt = Date.now()
  const gen = ++sessionScanGen
  setTimeout(() => {
    try {
      if (gen === sessionScanGen) scanSessionRegistry(ctx, { ...discovery, serverPid })
    } finally {
      sessionScanInFlight = false
    }
  }, 0)
}

function scanSessionRegistry(ctx: Ctx, discovery: NonNullable<typeof liveOmpCache> & { serverPid: number | null }): void {
  const now = Date.now()
  try {
    const prev = sessionRegistry ?? parseRegistry(readFileOrNull(ctx.paths.sessions))
    sessionRegistry = prev
    const { panes, procs, agents, serverPid } = discovery
    if (!scanIsTrustworthy(prev, { panes, procs, serverPid })) return
    hookSessions = bindHookSessions(hookSessions, pendingHookSessions, panes, procs)
    pendingHookSessions = []
    const scan = listLiveSessions({ panes, procs, serverPid, paneTitles: readPaneTitles(), omp: agents, hookSessions })
    const { next, events, pending } = reconcile(prev, scan, now, pendingRenames)
    pendingRenames = pending
    const io = sessionStoreIo(ctx.paths)
    for (const ev of events) {
      log(`session-registry: ${describeRegistryEvent(ev)}`)
      if (ev.kind === "promoted") for (const line of rekeyStores(io, ev.from, ev.to)) log(`session-registry: ${line}`)
    }
    sessionRegistry = next
    sessionRegistryScanned = true
    // The one-shot migration drops rows whose pane is dead, so an empty pane list
    // from a live server (the launchd flake) waits for a later scan — it would read
    // every registered pane as dead. With no server at all pane liveness is
    // unknown: the migration runs and drops nothing for a dead pane.
    const livePaneIds = migrationLivePanes({ panes, serverPid })
    if (livePaneIds !== "wait") {
      const migration = runMigration(next, io, { now, livePaneIds })
      for (const line of migration.log) log(`session-registry: ${line}`)
      sessionRegistry = migration.registry
    }
    persistSessionRegistry(ctx)
    followSessionTopics(ctx, prev, events)
  } catch (err) {
    log(`session-registry: scan failed: ${err instanceof Error ? err.message : String(err)}`)
  }
}

function persistSessionRegistry(ctx: Ctx): void {
  if (!sessionRegistry) return
  const serialized = serializeRegistry(sessionRegistry)
  if (serialized === sessionRegistryWritten) return
  atomicWrite(ctx.paths.sessions, serialized)
  sessionRegistryWritten = serialized
}

function currentRegistry(ctx: Ctx): Registry {
  sessionRegistry ??= parseRegistry(readFileOrNull(ctx.paths.sessions))
  return sessionRegistry
}

// --- One forum topic per session (docs/specs/session-registry-and-topics.md §4.2–§4.5, tg-cli#467) ---
// The daemon is the ONLY caller of createForumTopic. A session's topic is created lazily on its
// first outbound — a `tg` send (the hook-socket `resolve-session` ask) or a question/permission
// card — so idle sessions open no topics. It is stored as the registry entry's `threadId` and
// mirrored into topics.json as a bound binding, which is what the inbound triage (§4.4) routes
// by. A resumed or restarted session keeps its topic and says "reattached" there.
// How long an outbound waits for its topic before posting to General (the create goes on, and
// the next outbound uses the topic): `tg` gives the lookup 2 s in all.
const TOPIC_WAIT_MS = 1200
// Fresh private-chat topics reject bot writes for a moment (telegram-bot-api #905): retry once.
const TOPIC_THREAD_RETRY_MS = 1000
// A bot without topic capability (or a failing createForumTopic) is re-asked at most this often.
const TOPIC_CAPABILITY_TTL_MS = 10 * 60_000
// Per entry, when its topic was last recreated after a deletion (§4.2's 24 h cap). Held in
// memory: a daemon restart forgets it, which at worst allows one extra recreate (tg-cli#498).
const topicRecreatedAt = new Map<SessionKey, number>()
let topicCapability: { at: number; ok: boolean } | null = null
let topicEnsurer: ((key: SessionKey) => Promise<number | null>) | null = null

function liveEntry(ctx: Ctx, key: string): SessionEntry | null {
  return currentRegistry(ctx).sessions.find((e) => e.key === key && e.state === "live") ?? null
}

// Replace one entry's topic fields and persist (the daemon is sessions.json's only writer).
function patchSessionEntry(ctx: Ctx, key: SessionKey, patch: Partial<Pick<SessionEntry, "threadId" | "topicMisses">>): SessionEntry | null {
  const reg = currentRegistry(ctx)
  const prev = reg.sessions.find((e) => e.key === key)
  if (!prev) return null
  // A topic that is replaced or dropped takes its pending retitle with it.
  if (patch.threadId !== undefined && prev.threadId !== null && prev.threadId !== patch.threadId) topicRenamer?.forget(prev.threadId)
  const next = { ...prev, ...patch }
  sessionRegistry = { ...reg, sessions: reg.sessions.map((e) => (e === prev ? next : e)) }
  try {
    persistSessionRegistry(ctx)
  } catch (err) {
    log(`session topics: registry write failed: ${err}`)
  }
  return next
}

// Mirror an entry's topic into topics.json as a bound binding on its current pane locator, so
// the inbound triage delivers the topic's messages to it. No write when already so bound.
function bindTopicToEntry(ctx: Ctx, threadId: number, entry: SessionEntry): void {
  const locator = paneLocatorOf(entry)
  if (!locator) return
  const topics = parseTopics(readFileOrNull(ctx.paths.topics))
  const existing = findTopic(topics, threadId)
  if (existing?.status === "bound" && existing.paneId === locator && existing.path === entry.cwd) return
  const ts = Math.floor(Date.now() / 1000)
  const binding = existing
    ? { ...markBound(existing, locator, ts), path: entry.cwd }
    : attachTopic(threadId, { paneId: locator, name: topicTitleFor(entry), path: entry.cwd, harness: HARNESS_AGENT[entry.harness] }, ts)
  writeSessionTopics(ctx, appendTopic(topics, binding))
}

function writeSessionTopics(ctx: Ctx, topics: TopicBinding[]): void {
  try {
    atomicWrite(ctx.paths.topics, serializeTopics(topics))
  } catch (err) {
    log(`session topics: topics.json write failed: ${err}`)
  }
}

// Private-chat topics need the bot's threaded mode (getMe.has_topics_enabled); a supergroup
// forum is not gated by it. Cached for TOPIC_CAPABILITY_TTL_MS either way.
async function topicsCapable(ctx: Ctx): Promise<boolean> {
  if (ctx.chatId < 0) return true
  if (topicCapability && Date.now() - topicCapability.at < TOPIC_CAPABILITY_TTL_MS) return topicCapability.ok
  const result = (await botPost(ctx, "getMe", {}))?.result
  const ok = !(result && typeof result === "object" && "has_topics_enabled" in result && result.has_topics_enabled === false)
  topicCapability = { at: Date.now(), ok }
  if (!ok) log("session topics: getMe.has_topics_enabled=false — sessions stay in General")
  return ok
}

async function createSessionTopic(ctx: Ctx, key: SessionKey): Promise<number | null> {
  const entry = liveEntry(ctx, key)
  if (!entry) return null
  // A topic already bound to this session's pane (the attach picker, a flat /new spawn, a
  // binding from before the registry) is adopted, never duplicated. Its cwd must match: a pane
  // id is reused freely.
  const locator = paneLocatorOf(entry)
  const own = locator ? topicForPane(parseTopics(readFileOrNull(ctx.paths.topics)), locator) : null
  if (own && (own.path === undefined || own.path === entry.cwd)) {
    patchSessionEntry(ctx, key, { threadId: own.threadId })
    log(`session topics: ${key} adopted topic ${own.threadId}`)
    return own.threadId
  }
  if (!(await topicsCapable(ctx))) return null
  const resp = await botPostResult(ctx, "createForumTopic", { chat_id: ctx.chatId, name: topicTitleFor(entry) })
  const result = resp.ok ? resp.json.result : undefined
  const threadId = result && typeof result === "object" && "message_thread_id" in result ? result.message_thread_id : undefined
  if (typeof threadId !== "number") {
    log(`session topics: createForumTopic for ${key} failed: ${resp.ok ? "no message_thread_id" : resp.description}`)
    // Only a capability answer (not a forum / topics off / no rights) holds every session in
    // General for the TTL; a transient failure (429, 5xx, network) retries on the next outbound.
    if (!resp.ok && (isThreadRejection(resp.description) || /not enough rights/i.test(resp.description))) {
      topicCapability = { at: Date.now(), ok: false }
    }
    return null
  }
  // Logged BEFORE the write: a crash in between leaves one orphan topic, findable here (§4.2).
  log(`topic created ${threadId} for ${key}`)
  const bound = patchSessionEntry(ctx, key, { threadId, topicMisses: null })
  if (bound) bindTopicToEntry(ctx, threadId, bound)
  return threadId
}

// The session's topic, created on first use; null when topics are off or unavailable, or when
// the create takes longer than TOPIC_WAIT_MS (the caller then posts to General).
function sessionTopic(ctx: Ctx, key: SessionKey): Promise<number | null> {
  if (!ctx.cfg.topics && !ctx.cfg.privateTopics) return Promise.resolve(null)
  topicEnsurer ??= createTopicEnsurer({
    threadIdOf: (k) => currentRegistry(ctx).sessions.find((e) => e.key === k)?.threadId ?? null,
    create: (k) => createSessionTopic(ctx, k),
  })
  // The 📥 Inbox topic is never a session's topic (tg-cli#705): not for a card, not for a `tg`
  // send, not for `tg --session-topic`.
  return Promise.race([topicEnsurer(key), Bun.sleep(TOPIC_WAIT_MS).then(() => null)]).then((t) => (t === inboxThreadId ? null : t))
}

// A threaded send fell back to General (§4.5): count the miss, recreate the topic once it is
// proven gone, and tell the human why the session posts in General (once per miss run).
async function noteSessionTopicMiss(ctx: Ctx, key: SessionKey, threadId: number, description: string): Promise<void> {
  const entry = liveEntry(ctx, key)
  if (!entry || entry.threadId !== threadId) return
  const now = Date.now()
  const { misses, recreate } = noteTopicMiss(entry.topicMisses, now, {
    deleted: isTopicDeletedError(description),
    lastRecreatedAt: topicRecreatedAt.get(key) ?? null,
  })
  const name = entry.name.primary || entry.key
  if (recreate) {
    topicRecreatedAt.set(key, now)
    patchSessionEntry(ctx, key, { threadId: null, topicMisses: null })
    writeSessionTopics(ctx, parseTopics(readFileOrNull(ctx.paths.topics)).filter((t) => t.threadId !== threadId))
    log(`session topics: topic ${threadId} of ${key} is gone (${description}) — recreating on the next outbound`)
    await sendMessage(ctx, `⚠️ [${name}] its topic is gone — posted here; a new topic opens with its next message`)
    return
  }
  patchSessionEntry(ctx, key, { topicMisses: misses })
  log(`session topics: topic ${threadId} of ${key} rejected a send (${description}) — miss ${misses?.count ?? 0}, posted to General`)
  if (misses?.count === 1) await sendMessage(ctx, `⚠️ [${name}] its topic is not accepting messages (${description}) — posting here in General for now`)
}

function clearSessionTopicMisses(ctx: Ctx, key: SessionKey): void {
  if (liveEntry(ctx, key)?.topicMisses) patchSessionEntry(ctx, key, { topicMisses: null })
}

// Post into a session's topic with the private-topic fallback (§4.5): a thread rejection is
// retried once after 1 s; a second one posts to General (after the notice) and counts a miss.
// A threaded success clears the miss counter. Any other failure returns null, like sendMessage.
// The CLI side of the same fallback is `send()` in features/transport/telegram.ts
// (`threadRetryDelayMs`); a change to what counts as a rejection belongs in both.
async function sendToSessionTopic(ctx: Ctx, key: SessionKey, threadId: number, text: string, extra: Record<string, unknown> = {}): Promise<number | null> {
  if (threadId === inboxThreadId) return sendMessage(ctx, text, extra) // never into the 📥 Inbox (tg-cli#705)
  const body = { chat_id: ctx.chatId, text, ...extra, message_thread_id: threadId }
  let resp = await botPostResult(ctx, "sendMessage", body)
  if (!resp.ok && isThreadRejection(resp.description) && !isTopicDeletedError(resp.description)) {
    await Bun.sleep(TOPIC_THREAD_RETRY_MS)
    resp = await botPostResult(ctx, "sendMessage", body)
  }
  if (resp.ok) {
    clearSessionTopicMisses(ctx, key)
    const result = resp.json.result
    const messageId = result && typeof result === "object" && "message_id" in result ? result.message_id : undefined
    return typeof messageId === "number" ? messageId : null
  }
  if (!isThreadRejection(resp.description) && !isTopicDeletedError(resp.description)) return null
  await noteSessionTopicMiss(ctx, key, threadId, resp.description)
  return sendMessage(ctx, text, extra)
}

// hook-socket `resolve-session` (§4.3): which live session is this `tg` in, and its topic.
async function handleResolveSession(ctx: Ctx, socket: Socket, q: SessionLookup): Promise<void> {
  let entry = findSessionForLookup(currentRegistry(ctx), q)
  // A session that started since the last scan: scan now, off the 30 s cadence.
  if (!entry) {
    const fresh = refreshSessionRegistry()
    entry = fresh ? findSessionForLookup(fresh, q) : null
  }
  const threadId = entry ? await sessionTopic(ctx, entry.key) : null
  const answer = entry ? { key: entry.key, name: entry.name.primary, threadId } : { key: null, name: null, threadId: null }
  socket.end(`${JSON.stringify(answer)}\n`)
}

// Scan follow-up: a session that moved or came back keeps its topic — the binding follows its
// new pane locator — and a new process of it (resume, restart) posts "reattached" there. A
// tmux move of the same process says nothing. A committed rename retitles the topic.
function followSessionTopics(ctx: Ctx, prev: Registry, events: RegistryEvent[]): void {
  if (!ctx.cfg.topics && !ctx.cfg.privateTopics) return
  // Forget the recreate cap of entries the registry has dropped.
  const sessions = currentRegistry(ctx).sessions
  for (const key of topicRecreatedAt.keys()) {
    if (!sessions.some((e) => e.key === key)) topicRecreatedAt.delete(key)
  }
  for (const ev of events) {
    if (ev.kind === "renamed") {
      retitleSessionTopic(ctx, ev)
      continue
    }
    if (ev.kind === "pruned") {
      const threadId = prev.sessions.find((e) => e.key === ev.key)?.threadId
      if (threadId != null) topicRenamer?.forget(threadId)
      continue
    }
    if (ev.kind !== "readopted" && ev.kind !== "relocated") continue
    const entry = liveEntry(ctx, ev.key)
    if (!entry || entry.threadId === null) continue
    const threadId = entry.threadId
    bindTopicToEntry(ctx, threadId, entry)
    const before = prev.sessions.find((e) => e.key === ev.key)
    if (ev.kind === "readopted" || before?.locators.pid !== entry.locators.pid) {
      log(`session topics: ${entry.key} reattached to topic ${threadId}`)
      void sendToSessionTopic(ctx, entry.key, threadId, `📂 ${entry.name.primary || entry.key} — reattached`)
    }
  }
}

// Rename → editForumTopic (spec §4.7, tg-cli#466): a committed `renamed` event (§3.2, stable for
// 20 s) retitles the session's topic `primary · secondary`, at most once a minute per topic with
// the latest name winning (topic-rename.ts). Nothing flows back: a topic renamed in Telegram —
// including the echo of this very edit — is only logged (§4.4 row 5), never applied to tmux or
// the registry, so there is no rename loop.
let topicRenamer: TopicRenamer | null = null
function retitleSessionTopic(ctx: Ctx, ev: Extract<RegistryEvent, { kind: "renamed" }>): void {
  const entry = currentRegistry(ctx).sessions.find((e) => e.key === ev.key)
  if (!entry || entry.threadId === null) return
  topicRenamer ??= createTopicRenamer({
    now: Date.now,
    schedule: (fn, ms) => {
      const timer = setTimeout(() => void fn(), ms)
      return () => clearTimeout(timer)
    },
    edit: (threadId, title) => editSessionTopic(ctx, threadId, title),
  })
  void topicRenamer.rename(entry.threadId, topicTitleFor(entry), topicTitleFor({ key: entry.key, name: ev.from }))
}

async function editSessionTopic(ctx: Ctx, threadId: number, title: string): Promise<boolean> {
  const resp = await botPostResult(ctx, "editForumTopic", { chat_id: ctx.chatId, message_thread_id: threadId, name: title })
  // TOPIC_NOT_MODIFIED: the topic already carries this title.
  if (!resp.ok && !/TOPIC_NOT_MODIFIED/.test(resp.description)) {
    log(`session topics: retitling topic ${threadId} failed: ${resp.description}`)
    return false
  }
  log(`session topics: topic ${threadId} retitled "${title}"`)
  return true
}

// One `  - …` line per omp, each naming the tmux pane it is shown in (window name +
// harness title, falling back to the pane title) — the same resolver name the picker
// and the outbound header use. One pane snapshot + one title read per listing.
function describeOmpLines(agents: LiveOmpAgent[]): string[] {
  const panes = snapshot().panes
  const titles = agents.some((a) => a.paneId) ? readPaneTitles() : new Map<string, string>()
  return agents.map((a) => {
    const pane = a.paneId ? panes.find((p) => p.paneId === a.paneId) : undefined
    return `  - ${describeLiveOmp(a, pane ? { ...pane, paneTitle: titles.get(pane.paneId) ?? null } : null)}`
  })
}

function noAgentReplyNow(): string {
  const live = listLiveOmpAgents()
  const unreachable = listUnreachableAgents()
  if (live.length > 0) {
    const lines = describeOmpLines(live)
    const ompBlock = `omp (original-process bridge, never session/load):\n${lines.join("\n")}`
    if (unreachable.length === 0) return ompBlock
    return `${ompBlock}\n${noAgentReplyText("", unreachable)}`
  }
  return noAgentReplyText(NO_AGENT_REPLY, unreachable)
}

// Entries in a key's pending.jsonl (0 when absent/unreadable).
function pendingInboxCount(ctx: Ctx, key: string): number {
  const raw = readFileOrNull(join(inboxDirFor(ctx.configDir, key), PENDING_FILE))
  return raw ? parseInboxLines(raw).entries.length : 0
}

// The inbox holds the user's private Telegram text: directories 0700, files 0600 —
// enforced on every write, including paths that already existed with looser modes
// (review finding: a 022 umask would otherwise leave them world-readable).
function tightenInboxModes(dir: string, file?: string): void {
  chmodSync(inboxRoot(dirname(dirname(dir))), INBOX_DIR_MODE)
  chmodSync(dir, INBOX_DIR_MODE)
  if (file && existsSync(file)) chmodSync(file, INBOX_FILE_MODE)
}

// Append ONE entry to an agent's pending inbox: mkdir -p + a single O_APPEND write of
// one complete line (never a torn record for the consuming Stop hook). Throws on IO
// failure. omp's grant-notice fallback is the only caller (tg-cli#456).
function queueToInbox(ctx: Ctx, key: string, entry: InboxEntry): void {
  const dir = inboxDirFor(ctx.configDir, key)
  mkdirSync(dir, { recursive: true, mode: INBOX_DIR_MODE })
  const pending = join(dir, PENDING_FILE)
  appendFileSync(pending, serializeInboxEntry(entry), { mode: INBOX_FILE_MODE })
  tightenInboxModes(dir, pending)
}

// Deliver an operation-bound grant notice to its exact origin. A recorded pane uses its
// original route; OMP uses a verified session-bound socket and, when that is unavailable,
// the durable scoped inbox its Stop bridge consumes at the next yield — never a cwd/name
// guess or a spawn. Claude Code / Codex without a pane get nothing: they are tmux-only
// (tg-cli#456), and their inbox delivered only at a turn end an idle or exited session
// never reaches — every message stranded there was such a notice. The card then names
// the token path.
async function routeGrantNotice(ctx: Ctx, req: ButtonRequest, text: string, deliveryId: string): Promise<boolean> {
  const ompOrigin = req.origin?.agent === "omp" || req.agent === "omp"
  if (req.paneId && !ompOrigin) {
    try {
      const res = await executeInjectSteps(buildTextInjectPlan(req.paneId, wrapInbound(ctx.cfg.injectWrap, "tg", text), { sessionKey: req.sessionKey }))
      // Typed but still in its input box (#463): name the pane and text in the chat.
      if (!res.ok && res.unsubmitted) await sendMessage(ctx, res.error)
      return res.ok
    } catch (err) {
      log(`grant-notice pane route failed pane=${req.paneId}: ${err instanceof Error ? err.message : String(err)}`)
      return false
    }
  }
  if (!ompOrigin) {
    log(`grant-notice: ${req.agent} origin has no tmux pane — nothing queued (Claude Code/Codex are tmux-only)`)
    return false
  }
  await refreshOriginalHosts()
  let target: OriginalOmpTarget | null = null
  if (req.origin?.sessionId) target = { cwd: req.cwd, sessionId: req.origin.sessionId }
  else if (req.paneId) {
    const live = liveOmpForPane(listLiveOmpAgents(), req.paneId)
    if (live) target = live
  }
  // No exact session/pane identity: retain in scoped inbox, never guess by cwd.
  if (target) {
    const res = await deliverOriginalOmp(target, text, deliveryId, req.paneId)
    if (res.ok) return true
    // Typed into its pane but still unsubmitted (#463): report it and do not queue
    // it again — the card reports the notice undelivered and names the token path.
    if (res.unsubmitted) {
      await sendMessage(ctx, res.error)
      return false
    }
    log(`grant-notice omp route failed (falling back to inbox) session=${target.sessionId ?? "-"}: ${res.error}`)
  }
  // The requester's own project inbox (grants.ts grantInboxKey): never a subagent-name
  // inbox another project escalating under the same name would share (tg-cli#433).
  const inboxKey = grantInboxKey(req)
  if (!inboxKey) {
    log(`grant-notice: omp origin has no cwd — no project inbox to queue to session=${req.origin?.sessionId ?? "-"}`)
    return false
  }
  try {
    queueToInbox(ctx, inboxKey, {
      id: null,
      ts: new Date().toISOString(),
      from: "tg",
      text,
      wrapped: text,
    })
    return true
  } catch (err) {
    log(`grant-notice inbox route failed key-cwd=${req.cwd ?? "-"}: ${err instanceof Error ? err.message : String(err)}`)
    return false
  }
}

function listInboxKeys(ctx: Ctx): string[] {
  try {
    return readdirSync(inboxRoot(ctx.configDir), { withFileTypes: true })
      .filter((d) => d.isDirectory())
      .map((d) => d.name)
      .sort()
  } catch {
    return []
  }
}

// Archive what the omp Stop bridge delivered. The hook publishes each consumption as ONE
// complete `delivered-<pid>-<ts>.jsonl` (temp + rename), so a file we see is whole and no
// in-flight hook write can be lost to our unlink: append it to acked.jsonl, unlink.
// Never throws into the poll loop.
function archiveDeliveredInboxes(ctx: Ctx): void {
  for (const key of listInboxKeys(ctx)) {
    const dir = inboxDirFor(ctx.configDir, key)
    try {
      for (const name of readdirSync(dir)) {
        if (!isDeliveredBatchFile(name)) continue
        const path = join(dir, name)
        const raw = readFileOrNull(path) ?? ""
        const parsed = parseInboxLines(raw)
        if (parsed.entries.length > 0 || parsed.malformed > 0) {
          log(`inbox ${key}: ${parsed.entries.length} delivered by the Stop hook (${parsed.malformed} malformed) — archived`)
        }
        if (raw) appendFileSync(join(dir, ACKED_FILE), raw.endsWith("\n") ? raw : `${raw}\n`, { mode: INBOX_FILE_MODE })
        unlinkSync(path)
      }
    } catch (err) {
      log(`inbox ${key}: delivered-batch sweep failed: ${err}`)
    }
  }
}

// `tg-ctl audit-delivery` (tg-cli#299): read-only report of inbound messages that never
// reached an agent, reached one twice, or never arrived (update-id gaps). See delivery-audit.ts.
function runAuditDelivery(ctx: Ctx, argv: string[]): number {
  const args = parseAuditArgs(argv)
  if (args.kind === "help") {
    console.log(AUDIT_USAGE)
    return 0
  }
  if (args.kind === "error") {
    console.error(`tg-ctl audit-delivery: ${args.message}\n${AUDIT_USAGE}`)
    return 2
  }
  const history = [ctx.paths.history, ...args.history].flatMap((p) => parseHistory(readFileOrNull(p)))
  const logs = [ctx.paths.log, join(ctx.configDir, "launchd.tg-ctl.err.log"), ...args.logs].map((p) => readFileOrNull(p) ?? "").join("\n")
  const roots = args.transcripts ?? [join(ctx.home, ".omp", "agent", "sessions"), join(ctx.home, ".claude", "projects"), join(ctx.home, ".codex", "sessions")]
  // Transcripts last written before the window cannot hold a delivery inside it. No inbound
  // history and no --since: no lower bound, every transcript is read.
  const oldest = args.since ?? history.reduce((min, r) => (r.direction === "user" ? Math.min(min, r.ts) : min), Infinity)
  const minMtimeMs = Number.isFinite(oldest) ? oldest * 1000 : 0
  const copies: InjectedCopy[] = []
  const walk = (dir: string): void => {
    let entries
    try {
      entries = readdirSync(dir, { withFileTypes: true })
    } catch {
      return
    }
    for (const e of entries) {
      const path = join(dir, e.name)
      if (e.isDirectory()) walk(path)
      else if (e.name.endsWith(".jsonl") && (fileMtimeMs(path) ?? -1) >= minMtimeMs) {
        const raw = readFileOrNull(path)
        if (raw) copies.push(...transcriptCopies(raw, path))
      }
    }
  }
  for (const root of roots) walk(root)
  const report = buildAuditReport({
    chatId: ctx.chatId,
    history,
    ledger: parseLedger(readFileOrNull(ctx.paths.deliveryLedger)),
    copies,
    logAttempts: logDeliveryIds(logs),
    sinceSec: args.since,
    untilSec: args.until,
  })
  process.stdout.write(args.json ? `${JSON.stringify(report, null, 2)}\n` : formatAuditReport(report))
  return 0
}

// Every archived stranded-*.jsonl, per inbox key (read-only).
function strandedInboxGroups(ctx: Ctx): StrandedGroup[] {
  const groups: StrandedGroup[] = []
  for (const key of listInboxKeys(ctx)) {
    const dir = inboxDirFor(ctx.configDir, key)
    let names: string[]
    try {
      names = readdirSync(dir).filter(isStrandedFile).sort()
    } catch (err) {
      log(`inbox ${key}: cannot list stranded files: ${err}`)
      continue
    }
    for (const name of names) {
      const { entries, malformed } = parseInboxLines(readFileOrNull(join(dir, name)) ?? "")
      groups.push({ key, file: `${key}/${name}`, entries, malformed })
    }
  }
  return groups
}

// One-time retirement of the cc/codex Stop-hook inbox (tg-cli#456). Until the marker
// says `complete`: claim every pending.jsonl (rename — the same atomic claim the Stop
// hook uses, so a racing hook either got it first or finds none), split it, archive what
// the retired channel stranded as stranded-<stamp>.jsonl and append omp's still-live
// grant notices back to pending.jsonl for the omp hook (an omp fallback queued by the
// previous daemon or during a failed-send retry is never swallowed). The stranded entries
// are listed ONCE to the CTO through the daemon's own reply path, then the marker is
// written (a kill between the send and the marker write lists them again at the next
// start: a duplicate, never a loss). A transient send failure (network, 429, 5xx) keeps
// the built report and the next poll retries ONLY the send: re-sweeping would churn
// omp's pending.jsonl and could archive (and report) an omp notice queued since — or one
// whose grant expired in between — as stranded. Telegram rejecting the report outright
// (4xx) is final: retrying would fail forever, so it is logged and the archive stands
// (`tg-ctl inbox` counts it). The sweep is synchronous, so no routeGrantNotice append
// interleaves.
let strandedReportDone = false
let strandedReportUnsent: StrandedSweep | null = null
async function reportStrandedInbox(ctx: Ctx): Promise<void> {
  if (strandedReportDone) return
  const marker = strandedReportMarker(ctx.configDir)
  const prior = parseStrandedMarker(readFileOrNull(marker))
  if (prior?.complete) {
    strandedReportDone = true
    return
  }
  if (strandedReportUnsent === null) strandedReportUnsent = sweepStrandedInbox(ctx, new Set(prior?.reported ?? []))
  const { text, count, complete, files } = strandedReportUnsent
  if (text !== null) {
    const sent = await botPostResult(ctx, "sendMessage", { chat_id: ctx.chatId, text })
    if (telegramFailureIsTransient(sent)) {
      log("inbox: the stranded-message report did not send — retrying the send next poll")
      return
    }
    if (!sent.ok) {
      log(`inbox: Telegram rejected the stranded-message report (${sent.status ?? "ok:false"} ${sent.description}) — not retrying; the archive keeps every message`)
    } else if (count > 0) {
      log(`inbox: ${count} stranded cc/codex message(s) reported once, archived as ${STRANDED_PREFIX}*.jsonl (tg-cli#456)`)
    }
  }
  strandedReportDone = true
  strandedReportUnsent = null
  // A key whose claim could not be archived keeps its claim-sweep-*.jsonl; an incomplete
  // marker makes the next daemon start sweep it again — so those messages are never
  // lost — and report only the archives this one did not already send.
  const reported = [...new Set([...(prior?.reported ?? []), ...files])]
  try {
    atomicWrite(marker, `${JSON.stringify({ reportedAt: new Date().toISOString(), messages: count, complete, reported })}\n`)
  } catch (err) {
    log(`inbox: could not write ${marker} (a restart would report the stranded messages again): ${err}`)
  }
  if (!complete) log("inbox: some pending.jsonl could not be archived — the next start retries the sweep")
}

// Claim, split and archive every pending.jsonl — and any claim-sweep-*.jsonl an earlier
// sweep left behind (crash or failed archive) — once; returns the report over every
// stranded-*.jsonl not in `reported` (this sweep's and any earlier daemon's unreported
// ones), the archives it lists, and whether every claim was archived.
type StrandedSweep = { text: string | null; count: number; complete: boolean; files: string[] }
function sweepStrandedInbox(ctx: Ctx, reported: ReadonlySet<string>): StrandedSweep {
  // An omp grant: its origin says omp, it routes to an omp session, or — an omp ask with
  // no origin block (routeGrantNotice also treats `agent: "omp"` as omp) — its grace
  // record's original request came from omp.
  const store = parseGrantStore(readFileOrNull(ctx.paths.grants), Date.now())
  const ompGraceRequests = new Set(store.grace.filter((r) => r.req.agent === "omp").map((r) => r.requestId))
  const liveOmpApprovals = new Map(
    store.grants
      .filter((g) => g.consumed_at === null && (g.origin?.agent === "omp" || g.route?.startsWith("acp:") || ompGraceRequests.has(g.request_id)))
      .map((g) => [g.approval_id, g.request_id] as const),
  )
  const stamp = new Date().toISOString().replace(/[:.]/g, "-")
  let complete = true
  for (const key of listInboxKeys(ctx)) {
    const dir = inboxDirFor(ctx.configDir, key)
    const pending = join(dir, PENDING_FILE)
    let claims: string[]
    try {
      claims = readdirSync(dir).filter(isSweepClaimFile).sort().map((n) => join(dir, n))
      if (existsSync(pending)) {
        const claim = join(dir, `${CLAIM_SWEEP_PREFIX}${process.pid}-${stamp}.jsonl`)
        try {
          renameSync(pending, claim)
          claims.push(claim)
        } catch (err) {
          // The omp Stop hook claimed it between the check and the rename: it consumes
          // that file itself, so nothing is left to archive — not a failed sweep.
          if (!(err instanceof Error && "code" in err && err.code === "ENOENT")) throw err
        }
      }
    } catch (err) {
      log(`inbox ${key}: could not claim the stranded pending.jsonl: ${err}`)
      complete = false
      continue
    }
    // Replaying a claim after a crash must not duplicate: its archive is named after the
    // claim and rewritten whole, and a kept omp line already back in pending.jsonl is skipped.
    for (const claim of claims) {
      try {
        const { keep, stranded } = splitStrandedLines(readFileSync(claim, "utf8"), liveOmpApprovals)
        const archive = join(dir, `${STRANDED_PREFIX}${basename(claim).slice(CLAIM_SWEEP_PREFIX.length)}`)
        if (stranded.length > 0) writeFileSync(archive, `${stranded.join("\n")}\n`, { mode: INBOX_FILE_MODE })
        const pendingLines = new Set((readFileOrNull(pending) ?? "").split("\n"))
        const fresh = keep.filter((l) => !pendingLines.has(l))
        if (fresh.length > 0) appendFileSync(pending, `${fresh.join("\n")}\n`, { mode: INBOX_FILE_MODE })
        unlinkSync(claim)
      } catch (err) {
        log(`inbox ${key}: could not archive ${claim} (left in place; the next start retries it): ${err}`)
        complete = false
      }
    }
  }
  const groups = strandedInboxGroups(ctx).filter((g) => !reported.has(g.file))
  return {
    text: strandedReportText(groups, inboxRoot(ctx.configDir)),
    count: groups.reduce((n, g) => n + g.entries.length, 0),
    complete,
    files: groups.map((g) => g.file),
  }
}

// `tg-ctl inbox` — what the Stop-hook inbox still holds: omp's grant-notice fallback
// (pending, delivered at that omp's next yield) and the archived cc/codex backlog.
// Read-only: Claude Code and Codex are tmux-only, nothing can be queued (tg-cli#456).
function runInboxCommand(ctx: Ctx, argv: string[]): number {
  if (argv.length > 0) {
    console.error("usage: tg-ctl inbox   (`inbox queue` is gone: Claude Code and Codex are tmux-only, tg-cli#456)")
    return 1
  }
  // Until the daemon's one-time sweep has run (first poll after the upgrade, or a daemon
  // that is down), pending.jsonl may still hold the retired cc/codex backlog.
  const swept = parseStrandedMarker(readFileOrNull(strandedReportMarker(ctx.configDir)))?.complete === true
  const what = swept ? "omp grant notice, delivered at that omp's next yield" : "not swept yet: the daemon reports any cc/codex backlog here when it next starts"
  const lines: string[] = []
  for (const key of listInboxKeys(ctx)) {
    const n = pendingInboxCount(ctx, key)
    if (n > 0) lines.push(`  - ${key}: ${n} pending (${what})`)
  }
  const archived = strandedInboxGroups(ctx).reduce((n, g) => n + g.entries.length, 0)
  if (archived > 0) lines.push(`  archived: ${archived} stranded cc/codex message(s) in ${inboxRoot(ctx.configDir)}/*/${STRANDED_PREFIX}*.jsonl`)
  console.log(lines.length > 0 ? lines.join("\n") : "inbox: nothing pending")
  return 0
}

// `tg-ctl alert …` (tg-cli#636): temporary alert subscriptions of live omp sessions and the
// alert ingestion used by rig sysmon and the omp-supervisor watcher. Bound state is resolved
// against the omp-live registry here — the extension publishes no events (see
// features/tg-ctl/alert-subscriptions.ts). One-shot: no daemon involved. Both state files
// are read-modify-written under their O_EXCL lockfile (the routes/history protocol): the
// two documented sources fire together on an overloaded machine.
interface AlertHost {
  ctx: Ctx
  now: number
  endpoints: OriginalOmpEndpoint[]
  registryError: string | null // the omp-live registry could not be read: no binding is trustworthy
}

async function runAlertCommand(ctx: Ctx, argv: string[]): Promise<number> {
  const command = parseAlertArgv(argv)
  if (command.cmd === "error") {
    console.error(`tg-ctl alert: ${command.error}`)
    return 1
  }
  const host: AlertHost = { ctx, now: Date.now(), endpoints: [], registryError: null }
  try {
    host.endpoints = await listLiveEndpoints(defaultRegistryRoot())
  } catch (err) {
    host.registryError = `omp-live registry unreadable: ${(err as { code?: string }).code ?? err}`
    console.error(`tg-ctl alert: ${host.registryError}`)
  }
  switch (command.cmd) {
    case "list":
      return runAlertList(host, command.json)
    case "subscribe":
      return runAlertSubscribe(host, command)
    case "unsubscribe":
      return runAlertUnsubscribe(host, command)
    case "send":
      return runAlertSend(host, command)
    case "handoff-request":
      return runAlertHandoffRequest(host, command)
    case "handoff":
      return runAlertHandoff(host, command)
    case "take":
      return runAlertTake(host, command)
    case "release":
      return runAlertRelease(host, command)
    case "holder":
      return runAlertHolder(host, command)
  }
}

// Run `body` over the subscription store under its lock and persist what it returns;
// a store nobody can lock within ~2 s is reported, never written unlocked.
function withAlertSubscriptions<T>(host: AlertHost, body: (store: AlertSubscriptionStore) => { store: AlertSubscriptionStore; result: T }): T | undefined {
  const path = host.ctx.paths.alertSubscriptions
  return withRoutesLock(fsRoutesLockIo(`${path}.lock`), () => {
    const out = body(parseAlertSubscriptions(readFileOrNull(path), host.now))
    atomicWrite(path, serializeAlertSubscriptions(out.store, host.now))
    return out.result
  }, { attempts: 200, onContended: "skip" })
}

function withAlertThrottle<T>(host: AlertHost, body: (store: AlertThrottleStore) => { store: AlertThrottleStore; result: T }): T | undefined {
  const path = host.ctx.paths.alertThrottle
  return withRoutesLock(fsRoutesLockIo(`${path}.lock`), () => {
    const out = body(parseAlertThrottle(readFileOrNull(path), host.now))
    atomicWrite(path, serializeAlertThrottle(out.store, host.now))
    return out.result
  }, { attempts: 200, onContended: "skip" })
}

const ALERT_LOCK_BUSY = "state file locked by another tg-ctl alert for over 2 s; nothing changed"

function runAlertList(host: AlertHost, json: boolean): number {
  const store = parseAlertSubscriptions(readFileOrNull(host.ctx.paths.alertSubscriptions), host.now)
  const bindings = resolveAlertBindings(store, host.endpoints, host.now)
  console.log(json ? JSON.stringify(bindings.map((b) => ({ ...b.subscription, state: b.state })), null, 1) : formatAlertList(bindings, host.now))
  return host.registryError && bindings.length > 0 ? 1 : 0
}

type AlertSessionTarget = { ok: true; sessionId: string; endpoint: OriginalOmpEndpoint | null } | { ok: false; error: string }

// The session a subscribe/unsubscribe names: --session, --pid (a LIVE omp), or the caller's
// own omp (the nearest live omp-live ancestor).
function resolveAlertSession(host: AlertHost, pid: number | null, sessionId: string | null): AlertSessionTarget {
  if (sessionId !== null) return { ok: true, sessionId, endpoint: host.endpoints.find((e) => e.sessionId === sessionId) ?? null }
  if (pid !== null) {
    const endpoint = host.endpoints.find((e) => e.pid === pid)
    return endpoint ? { ok: true, sessionId: endpoint.sessionId, endpoint } : { ok: false, error: `omp pid ${pid} has no live omp-live endpoint (tg-ctl omp-live status --json)` }
  }
  const endpoint = nearestLiveAncestor(ancestorPids(process.pid), host.endpoints)
  if (endpoint) return { ok: true, sessionId: endpoint.sessionId, endpoint }
  return { ok: false, error: "no live omp session among this process's ancestors (a tmux pane descends from the tmux server, not from omp): pass --pid <omp pid> or --session <omp session id>" }
}

function runAlertSubscribe(host: AlertHost, command: Extract<AlertCommand, { cmd: "subscribe" }>): Promise<number> | number {
  if (host.registryError) return 1
  if (command.exclusive && command.source !== null) return runAlertExclusiveSubscribe(host, command.source, command)
  const target = resolveAlertSession(host, command.pid, command.sessionId)
  if (!target.ok) {
    console.error(`tg-ctl alert: ${target.error}`)
    return 1
  }
  const subscription = withAlertSubscriptions(host, (store) => {
    const prior = store.subscriptions.find((s) => s.sessionId === target.sessionId)
    const next: AlertSubscription = {
      sessionId: target.sessionId,
      title: target.endpoint?.title ?? prior?.title ?? null,
      pid: target.endpoint?.pid ?? prior?.pid ?? null,
      cwd: target.endpoint?.cwd ?? prior?.cwd ?? null,
      sources: command.sources,
      createdAt: host.now,
      expiresAt: command.ttlMs === null ? null : host.now + command.ttlMs,
    }
    return { store: upsertAlertSubscription(store, next), result: next }
  })
  if (!subscription) {
    console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
    return 1
  }
  const state = target.endpoint ? "bound" : "suspended"
  const ttl = command.ttlMs === null ? "no expiry" : `ttl ${formatAge(command.ttlMs)}`
  console.log(`subscribed (${state}): ${subscription.title ?? "(untitled)"} · pid ${subscription.pid ?? "?"} · session ${target.sessionId} · sources: ${command.sources?.join(",") ?? "all"} · ${ttl}`)
  return 0
}

// --- exclusive holder (tg-cli#747): one session per source receives `send --to-holder` ---
// Every slot change happens under the subscription-store lock (two sessions claiming at
// once: exactly one wins); notes into sessions are delivered after the lock is released.

type HolderStep = { outcome: HolderOutcome; state: HolderState; prior: AlertHolder | null; denied?: { sessionId: string } | null }

// The caller of a holder command as a claimant: --session, --pid or the nearest live omp.
// `requireLive`: the acting session must have a live omp-live endpoint (claim, request, take).
function resolveAlertClaimant(host: AlertHost, pid: number | null, sessionId: string | null, requireLive = false): { ok: true; claimant: Claimant } | { ok: false; error: string } {
  const target = resolveAlertSession(host, pid, sessionId)
  if (!target.ok) return target
  const ep = target.endpoint
  if (requireLive && !ep) return { ok: false, error: `session ${target.sessionId} is not live (no omp-live endpoint)` }
  return { ok: true, claimant: { sessionId: target.sessionId, title: ep?.title ?? null, pid: ep?.pid ?? null, cwd: ep?.cwd ?? null } }
}

// Run one holder rule on the refreshed store under the lock; a refusal persists only the
// refresh. undefined = the lock stayed busy (reported here).
function holderStep(host: AlertHost, source: string, rule: (store: AlertSubscriptionStore) => HolderOutcome & { denied?: { sessionId: string } | null }): HolderStep | undefined {
  const step = withAlertSubscriptions<HolderStep>(host, (raw) => {
    const store = refreshHolder(raw, source, host.endpoints, host.now)
    const before = holderState(store, source, host.endpoints, host.now)
    const outcome = rule(store)
    return { store: outcome.ok ? outcome.store : store, result: { outcome, state: before.state, prior: before.holder, denied: outcome.denied } }
  })
  if (step === undefined) console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
  return step
}

// Deliver a note into a session when it has a live endpoint; a failure is reported, never fatal.
async function deliverHolderNote(host: AlertHost, source: string, sessionId: string, text: string): Promise<boolean> {
  const ep = host.endpoints.find((e) => e.sessionId === sessionId)
  if (!ep) return false
  // A resume between listing and sending (new pid, same session) re-resolves once.
  const failure = await deliverWithStaleRetry(
    ep,
    (e) => sendLiveMessage({ root: defaultRegistryRoot(), pid: e.pid, instanceId: e.instanceId, sessionId: e.sessionId, requestId: holderRequestId(source, sessionId, host.now, crypto.randomUUID()), text }),
    async () => (await listLiveEndpoints(defaultRegistryRoot())).find((e) => e.sessionId === sessionId) ?? null,
  )
  if (failure !== null) console.error(`tg-ctl alert: note to session ${sessionId} failed: ${failure}`)
  return failure === null
}

// A refused step: code 3 prints who holds the slot (stdout), code 1 the error (stderr).
function reportHolderRefusal(host: AlertHost, source: string, step: HolderStep): number {
  const { outcome } = step
  if (outcome.ok) return 0
  if (outcome.code === 1) console.error(`tg-ctl alert: ${outcome.error}`)
  else console.log(outcome.holder && step.state !== "vacant" ? `${holderRefusal(source, outcome.holder, step.state, host.now)}\n(${outcome.error})` : outcome.error)
  return outcome.code
}

const holderLine = (h: AlertHolder): string => `${h.title ?? "(untitled)"} · pid ${h.pid ?? "?"} · session ${h.sessionId}`
const holderTtl = (h: AlertHolder, now: number): string => (h.expiresAt === null ? "no expiry" : `expires in ${formatAge(h.expiresAt - now)}`)

function runAlertExclusiveSubscribe(host: AlertHost, source: string, command: Extract<AlertCommand, { cmd: "subscribe" }>): number {
  const caller = resolveAlertClaimant(host, command.pid, command.sessionId, true)
  if (!caller.ok) {
    console.error(`tg-ctl alert: ${caller.error}`)
    return 1
  }
  const step = holderStep(host, source, (store) => claimHolder(store, source, caller.claimant, host.endpoints, host.now, command.ttlMs))
  if (!step) return 1
  if (!step.outcome.ok) return reportHolderRefusal(host, source, step)
  console.log(`holder of ${source}: ${holderLine(step.outcome.holder)} · ${holderTtl(step.outcome.holder, host.now)}`)
  return 0
}

async function runAlertHandoffRequest(host: AlertHost, command: Extract<AlertCommand, { cmd: "handoff-request" }>): Promise<number> {
  if (host.registryError) return 1
  const caller = resolveAlertClaimant(host, command.pid, command.sessionId, true)
  if (!caller.ok) {
    console.error(`tg-ctl alert: ${caller.error}`)
    return 1
  }
  const step = holderStep(host, command.source, (store) => requestHandoff(store, command.source, caller.claimant, host.endpoints, host.now, command.reason))
  if (!step) return 1
  if (!step.outcome.ok) return reportHolderRefusal(host, command.source, step)
  const holder = step.outcome.holder
  const request = holder.request!
  const noted = await deliverHolderNote(host, command.source, holder.sessionId, handoffRequestNote(command.source, holder, request))
  if (!noted) {
    // The holder never saw it: withdraw it so it cannot ripen into a take.
    withAlertSubscriptions(host, (store) => ({ store: withdrawRequest(store, command.source, request.sessionId, request.at), result: null }))
    console.log(`FAILED request for ${command.source}: the note did not reach ${holderLine(holder)}; the request was withdrawn — retry later (a holder gone for 10 minutes frees the slot)`)
    return 5
  }
  console.log(`requested ${command.source} from ${holderLine(holder)}; the holder was notified; unanswered for 10 minutes, take it with: tg-ctl alert take --source ${command.source}`)
  return 0
}

async function runAlertHandoff(host: AlertHost, command: Extract<AlertCommand, { cmd: "handoff" }>): Promise<number> {
  if (host.registryError) return 1
  const caller = resolveAlertClaimant(host, command.pid, command.sessionId)
  if (!caller.ok) {
    console.error(`tg-ctl alert: ${caller.error}`)
    return 1
  }
  const { source } = command
  if (command.deny) {
    const step = holderStep(host, source, (store) => denyHandoff(store, source, caller.claimant.sessionId, host.endpoints, host.now))
    if (!step) return 1
    if (!step.outcome.ok) return reportHolderRefusal(host, source, step)
    const denied = step.denied!
    await deliverHolderNote(host, source, denied.sessionId, handoffDeniedNote(source, step.outcome.holder, command.reason))
    console.log(`denied the ${source} request of session ${denied.sessionId}`)
    return 0
  }
  const to = command.to!
  const ep = host.endpoints.find((e) => e.sessionId === to)
  const target: Claimant = { sessionId: to, title: ep?.title ?? null, pid: ep?.pid ?? null, cwd: ep?.cwd ?? null }
  const step = holderStep(host, source, (store) => grantHandoff(store, source, caller.claimant.sessionId, target, host.endpoints, host.now))
  if (!step) return 1
  if (!step.outcome.ok) return reportHolderRefusal(host, source, step)
  if (step.prior) await deliverHolderNote(host, source, to, handoffGrantedNote(source, step.prior))
  console.log(`handed ${source} to ${holderLine(step.outcome.holder)}`)
  return 0
}

async function runAlertTake(host: AlertHost, command: Extract<AlertCommand, { cmd: "take" }>): Promise<number> {
  if (host.registryError) return 1
  const caller = resolveAlertClaimant(host, command.pid, command.sessionId, true)
  if (!caller.ok) {
    console.error(`tg-ctl alert: ${caller.error}`)
    return 1
  }
  const step = holderStep(host, command.source, (store) => takeHolder(store, command.source, caller.claimant, host.endpoints, host.now, command.ttlMs))
  if (!step) return 1
  if (!step.outcome.ok) return reportHolderRefusal(host, command.source, step)
  const prior = step.prior
  if (prior && prior.sessionId !== caller.claimant.sessionId) await deliverHolderNote(host, command.source, prior.sessionId, holderTakenNote(command.source, step.outcome.holder))
  console.log(`holder of ${command.source}: ${holderLine(step.outcome.holder)} · ${holderTtl(step.outcome.holder, host.now)}`)
  return 0
}

function runAlertRelease(host: AlertHost, command: Extract<AlertCommand, { cmd: "release" }>): number {
  const caller = resolveAlertClaimant(host, command.pid, command.sessionId)
  if (!caller.ok) {
    console.error(`tg-ctl alert: ${caller.error}`)
    return 1
  }
  const step = holderStep(host, command.source, (store) => releaseHolder(store, command.source, caller.claimant.sessionId))
  if (!step) return 1
  if (!step.outcome.ok) return reportHolderRefusal(host, command.source, step)
  console.log(`released ${command.source}`)
  return 0
}

// The slot's state (refreshed under the lock, so a live holder's lastSeenLiveAt advances).
// Exit 3 when vacant; 1 when the registry is unreadable (no state is trustworthy).
function runAlertHolder(host: AlertHost, command: Extract<AlertCommand, { cmd: "holder" }>): number {
  const { source } = command
  const st = withAlertSubscriptions(host, (raw) => {
    const store = refreshHolder(raw, source, host.endpoints, host.now)
    return { store, result: holderState(store, source, host.endpoints, host.now) }
  })
  if (!st) {
    console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
    return 1
  }
  const holder = st.state === "vacant" ? null : st.holder
  if (command.json) {
    const h = holder && { sessionId: holder.sessionId, title: holder.title, pid: holder.pid, cwd: holder.cwd, since: holder.since, lastSeenLiveAt: holder.lastSeenLiveAt, failingSince: holder.failingSince, expiresAt: holder.expiresAt }
    console.log(JSON.stringify({ source, state: st.state, holder: h, request: holder?.request ?? null }, null, 1))
  } else if (!holder) {
    console.log(`${source}: vacant`)
  } else {
    const request = holder.request ? ` · request from ${holder.request.title ?? "(untitled)"} (session ${holder.request.sessionId}, ${formatAge(host.now - holder.request.at)} ago)` : ""
    console.log(`${source}: ${st.state} · ${holderLine(holder)} · since ${formatAge(host.now - holder.since)} · ${holderTtl(holder, host.now)}${request}`)
  }
  if (host.registryError) return 1
  return st.state === "vacant" ? 3 : 0
}

type AlertUnsubscribeOutcome = { removed: string } | { none: string } | { error: string }

function runAlertUnsubscribe(host: AlertHost, command: Extract<AlertCommand, { cmd: "unsubscribe" }>): number {
  const outcome = withAlertSubscriptions<AlertUnsubscribeOutcome | number>(host, (store) => {
    if (command.all) return { store: { ...store, subscriptions: [] }, result: store.subscriptions.length }
    // --pid names a LIVE omp first (a pid the OS reused belongs to that session now); only a
    // pid no live endpoint owns falls back to the recorded pid of a closed session.
    const target = resolveAlertSession(host, command.pid, command.sessionId)
    const byRecordedPid = !target.ok && command.pid !== null ? store.subscriptions.find((s) => s.pid === command.pid) : undefined
    const sessionId = target.ok ? target.sessionId : byRecordedPid?.sessionId
    if (sessionId === undefined) return { store, result: { error: target.ok ? "no session named" : target.error } }
    if (!store.subscriptions.some((s) => s.sessionId === sessionId)) return { store, result: { none: sessionId } }
    return { store: removeAlertSubscription(store, sessionId), result: { removed: sessionId } }
  })
  if (outcome === undefined) {
    console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
    return 1
  }
  if (typeof outcome === "number") {
    console.log(`unsubscribed ${outcome} session(s)`)
    return 0
  }
  if ("error" in outcome) {
    console.error(`tg-ctl alert: ${outcome.error}`)
    return 1
  }
  console.log("none" in outcome ? `no subscription for session ${outcome.none}` : `unsubscribed session ${outcome.removed}`)
  return 0
}

interface AlertDeliveryFailure {
  binding: AlertBinding
  reason: string
}

// Deliver the posted alert into every bound session among `targets`.
async function deliverAlertToSessions(host: AlertHost, message: AlertMessage, messageId: number, targets: readonly AlertBinding[]): Promise<{ delivered: AlertBinding[]; failed: AlertDeliveryFailure[] }> {
  const text = sessionAlertText(message, messageId)
  const delivered: AlertBinding[] = []
  const failed: AlertDeliveryFailure[] = []
  for (const b of targets) {
    if (!b.endpoint) continue
    try {
      await sendLiveMessage({ root: defaultRegistryRoot(), pid: b.endpoint.pid, instanceId: b.endpoint.instanceId, sessionId: b.endpoint.sessionId, requestId: alertRequestId(messageId, b.endpoint.sessionId), text })
      delivered.push(b)
    } catch (err) {
      failed.push({ binding: b, reason: String((err as { code?: string }).code ?? err) })
    }
  }
  for (const f of failed) console.error(`tg-ctl alert: session delivery failed — ${describeAlertBinding(f.binding)}: ${f.reason}`)
  return { delivered, failed }
}

function describeAlertBinding(b: AlertBinding): string {
  return `${b.subscription.title ?? "(untitled)"} (pid ${b.subscription.pid ?? "?"})`
}

async function runAlertSend(host: AlertHost, command: Extract<AlertCommand, { cmd: "send" }>): Promise<number> {
  if (command.toHolder) return runAlertSendToHolder(host, command)
  const { message, windowMs, force } = command
  const key = throttleKey(message.source, message.key, message.severity)
  const boundNow = (): AlertBinding[] => {
    const store = parseAlertSubscriptions(readFileOrNull(host.ctx.paths.alertSubscriptions), host.now)
    return resolveAlertBindings(store, host.endpoints, host.now, message.source).filter((b) => b.state === "bound")
  }

  // 1. Under the lock: the verdict, and a claim when this send is the one to post.
  const verdict = withAlertThrottle(host, (store) => {
    const v: ThrottleVerdict = force ? { kind: "send" } : throttleVerdict(store, key, host.now, windowMs)
    return { store: v.kind === "send" ? claimAlert(store, key, host.now) : store, result: v }
  })
  if (verdict === undefined) {
    console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
    return 1
  }
  if (verdict.kind === "in-flight") {
    console.log(`in flight: another tg-ctl alert is posting ${message.source}/${message.key}/${message.severity} (claimed ${formatAge(host.now - verdict.entry.at)} ago)`)
    return 0
  }
  if (verdict.kind === "throttled") {
    // Posted inside the window: no second post; the sessions it did not reach get it now.
    const messageId = verdict.entry.messageId!
    const pending = boundNow().filter((b) => verdict.entry.pending.includes(b.subscription.sessionId))
    const { delivered, failed } = await deliverAlertToSessions(host, message, messageId, pending)
    if (delivered.length > 0) withAlertThrottle(host, (store) => ({ store: markAlertDelivered(store, key, delivered.map((b) => b.subscription.sessionId)), result: null }))
    const extra = delivered.length > 0 ? `; delivered to ${delivered.length} pending session(s)` : ""
    console.log(`throttled tg#${messageId} (${message.source}/${message.key}/${message.severity} sent ${formatAge(host.now - verdict.entry.at)} ago, window ${formatAge(windowMs)}${extra})`)
    return failed.length > 0 ? 1 : 0
  }

  // 2. Post to Telegram (outside the lock; `tg` may take a while). `tg` has no `--`
  //    end-of-options, so a body starting with `-` would be read as an unknown flag;
  //    a leading space (trimmed by `tg`) keeps it text.
  const body = telegramAlertBody(message, boundNow())
  const tgArgv = [tgBinary(), "--format", "html", "--automated", "--tag", alertTag(message.severity), "--subagent", message.source, "--title", alertTitle(message), body.startsWith("-") ? ` ${body}` : body]
  const posted = await spawnGuarded(tgArgv, 60_000)
  const messageId = posted.exitCode === 0 ? parseTgSendOk(posted.stdout) : null
  if (messageId === null) {
    // The claim is released so the monitor's retry posts again.
    withAlertThrottle(host, (store) => ({ store: settleAlert(store, key, null, []), result: null }))
    const why = posted.exitCode === 0 ? "tg exited 0 but printed no `OK tg#<id>` line" : `tg exit ${posted.exitCode}`
    console.error(`tg-ctl alert: Telegram post failed (${why}): ${(posted.stderr || posted.stdout).trim().slice(-300) || "no output"}`)
    console.log("FAILED tg#? sessions=0")
    return 1
  }

  // 3. Deliver into the sessions bound NOW (a session resumed while `tg` ran has a new
  //    endpoint), then settle the claim with the ones not reached.
  try {
    host.endpoints = await listLiveEndpoints(defaultRegistryRoot())
  } catch {
    /* keep the snapshot: the registry was readable a moment ago */
  }
  const { delivered, failed } = await deliverAlertToSessions(host, message, messageId, boundNow())
  const settled = withAlertThrottle(host, (store) => ({ store: settleAlert(store, key, messageId, failed.map((f) => f.binding.subscription.sessionId)), result: true }))
  if (settled === undefined) console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY} (the claim expires by itself)`)
  const names = delivered.length ? ` (${delivered.map(describeAlertBinding).join("; ")})` : ""
  console.log(`OK tg#${messageId} sessions=${delivered.length}${names}${failed.length ? ` failed=${failed.length}` : ""}`)
  return failed.length > 0 || host.registryError !== null ? 1 : 0
}

// `send --to-holder` (tg-cli#747): deliver into the source's exclusive holder ONLY — never
// Telegram (no `tg` spawn), never the non-exclusive subscribers. The holder state is read
// (and a bound holder's liveness refreshed) BEFORE any throttle claim, so a vacant or
// suspended slot leaves no claim behind. A delivery then claims the holder's own throttle key
// (holderThrottleKey: a handoff starts the new holder's window afresh); a failed one releases
// its own claim so the monitor's retry delivers. Known limit: delivery
// runs outside the store lock, so a send that picked the holder just before a handoff may
// still reach the previous holder; the next send goes to the new one.
// Exit 0 ok/throttled, 1 error, 3 vacant, 5 suspended or failed.
async function runAlertSendToHolder(host: AlertHost, command: Extract<AlertCommand, { cmd: "send" }>): Promise<number> {
  const { message, windowMs, force } = command
  const { source } = message
  if (host.registryError) return 1
  const text = holderAlertText(message)
  if (Buffer.byteLength(text) > HOLDER_TEXT_MAX_BYTES) {
    console.error(`tg-ctl alert: the holder copy is ${Buffer.byteLength(text)} bytes; the omp-live limit is ${HOLDER_TEXT_MAX_BYTES} (shorten --text)`)
    return 1
  }
  const st = withAlertSubscriptions(host, (raw) => {
    const store = refreshHolder(raw, source, host.endpoints, host.now)
    return { store, result: holderState(store, source, host.endpoints, host.now) }
  })
  if (st === undefined) {
    console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
    return 1
  }
  if (st.state === "vacant" || !st.holder) {
    console.log(`VACANT ${source}`)
    return 3
  }
  const holder = st.holder
  if (st.state === "suspended" || !st.endpoint) {
    console.log(`SUSPENDED ${source} ${holder.sessionId}`)
    return 5
  }

  const key = holderThrottleKey(holder.sessionId, source, message.key, message.severity)
  const verdict = withAlertThrottle(host, (store) => {
    const v: ThrottleVerdict = force ? { kind: "send" } : throttleVerdict(store, key, host.now, windowMs)
    return { store: v.kind === "send" ? claimAlert(store, key, host.now) : store, result: v }
  })
  if (verdict === undefined) {
    console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY}`)
    return 1
  }
  const what = `${source}/${message.key}/${message.severity}`
  if (verdict.kind === "in-flight") {
    console.log(`in flight: another tg-ctl alert is delivering ${what} to the holder (claimed ${formatAge(host.now - verdict.entry.at)} ago)`)
    return 0
  }
  if (verdict.kind === "throttled") {
    console.log(`throttled holder (${what} delivered ${formatAge(host.now - verdict.entry.at)} ago, window ${formatAge(windowMs)})`)
    return 0
  }

  const failure = await deliverWithStaleRetry(
    st.endpoint,
    (ep) => sendLiveMessage({ root: defaultRegistryRoot(), pid: ep.pid, instanceId: ep.instanceId, sessionId: ep.sessionId, requestId: holderRequestId(source, ep.sessionId, host.now, crypto.randomUUID()), text }),
    async () => (await listLiveEndpoints(defaultRegistryRoot())).find((e) => e.sessionId === holder.sessionId) ?? null,
  )
  const now = Date.now()
  withAlertSubscriptions(host, (store) => ({ store: markHolderDelivery(store, source, holder.sessionId, holder.since, failure === null, now), result: null }))
  const settled = withAlertThrottle(host, (store) => ({ store: failure === null ? settleHolderAlert(store, key, host.now) : releaseHolderClaim(store, key, host.now), result: true }))
  if (settled === undefined) console.error(`tg-ctl alert: ${ALERT_LOCK_BUSY} (the claim expires by itself)`)
  if (failure !== null) {
    console.log(`FAILED holder ${holder.sessionId}: ${failure}`)
    return 5
  }
  console.log(`OK holder ${holder.sessionId} pid ${st.endpoint.pid}`)
  return 0
}

// The `tg` sender next to this tg-ctl (the same checkout — a worktree's alert posts with its
// own code), else the one on PATH.
function tgBinary(): string {
  const sibling = join(dirname(realpathSync(import.meta.path)), "tg")
  return existsSync(sibling) ? sibling : "tg"
}

// This process's ancestors, nearest first, from one `ps` snapshot — cut at an omp
// worker broker, whose parent omp does not own the jobs it hosts (tg-cli#709).
function ancestorPids(pid: number): number[] {
  try {
    const ps = Bun.spawnSync(["ps", "-axo", "pid=,ppid=,command="], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    return ancestorPidChain(parseProcList(ps.stdout.toString()), pid)
  } catch {
    return []
  }
}

// A failed plan; `sessionMismatch`: the §2.6 guard refused (the pane hosts a
// different session now) and `error` is the named reply for the CTO;
// `unsubmitted`: the text WAS typed but is still in the input box (#463) — never
// re-type it, report it.
type InjectFailure = { ok: false; error: string; sessionMismatch?: true; unsubmitted?: true }

// The registry as it describes pane `paneId` NOW (re-scanned first). A scan
// shared with an earlier delivery of the same burst is trusted only while the
// pane still holds the agent process that scan recorded; otherwise it rescans,
// so a pane that changed hands inside the rate-limit window is still caught.
function registryForPane(paneId: string, observed?: { panes: PaneInfo[]; procs: ProcInfo[] }): Registry | null {
  const shared = Date.now() - sessionRefreshAt < SESSION_REFRESH_MIN_MS
  const reg = refreshSessionRegistry()
  if (!reg || !shared) return reg
  const { panes, procs } = observed ?? snapshot()
  const pane = panes.find((p) => p.paneId === paneId)
  const agentPid = pane ? findAgentInPane(pane, procs)?.pid : undefined
  return registryCurrentForPane(reg, paneId, pane?.panePid, agentPid) ? reg : (refreshSessionRegistry(true) ?? reg)
}

// The §2.6 guard's named refusal when pane `paneId` no longer hosts session
// `sessionKey` (registryForPane), else null. Unkeyed targets (an untracked
// harness, a pre-registry row) and a daemon without a registry pass.
function paneSessionRefusal(sessionKey: string | undefined, paneId: string, observed?: { panes: PaneInfo[]; procs: ProcInfo[] }): string | null {
  if (sessionKey === undefined) return null
  const reg = registryForPane(paneId, observed)
  if (!reg) return null
  const check = checkPaneSession(reg, sessionKey, paneId)
  if (check.ok) return null
  log(`pane-guard: refused ${paneId} for ${sessionKey} (now ${check.hostName ?? "no agent"})`)
  return paneRefusalText(check, paneId)
}

// The agent process a verify-pane found in the pane (findAgentInPane).
type HostedAgent = { agent: AgentKind; pid?: number }

// The verify-pane step, shared by both executors. It re-runs discovery on a
// CURRENT snapshot — the agent may have exited between picking the target and
// typing into it, and injecting into a bare shell would EXECUTE the text (spec
// §5.2). With a session key it also requires the pane to still host THAT
// session (spec §2.6, #354/#100): a tmux server restart or a respawned pane
// reuses `%N`, and a cwd match is never enough.
function verifyPaneStep(step: Extract<InjectStep, { kind: "verify-pane" }>): InjectFailure | { ok: true; hosted: HostedAgent } {
  const { panes, procs } = snapshot()
  const pane = panes.find((p) => p.paneId === step.paneId)
  const hosted = pane ? findAgentInPane(pane, procs) : null
  if (!hosted) {
    return { ok: false, error: `pane ${step.paneId} no longer hosts an agent — message not injected` }
  }
  const refusal = paneSessionRefusal(step.sessionKey, step.paneId, { panes, procs })
  return refusal === null ? { ok: true, hosted } : { ok: false, error: refusal, sessionMismatch: true }
}

// Does pane `paneId` still run the very agent process the text was typed into? A pane
// can change hands during the settle wait (the agent exits, tmux reuses `%N`).
function paneStillHosts(paneId: string, hosted: HostedAgent): boolean {
  const { panes, procs } = snapshot()
  const pane = panes.find((p) => p.paneId === paneId)
  const now = pane ? findAgentInPane(pane, procs) : null
  return now !== null && now.agent === hosted.agent && now.pid === hosted.pid
}

// The submit-check step (tg-cli#463), shared by both executors: `hosted` is what the
// plan's verify-pane found. Ends the plan as delivered (the text left the input box,
// or the box cannot be read, or the pane no longer runs that agent) or unsubmitted
// (still typed after the retry Enter); "retry-enter" runs the retry Enter that follows.
// The pane is re-checked before its box is read and again before the retry Enter:
// another agent's box says nothing about this text, and an Enter there would submit
// whatever that agent holds.
function submitCheckStep(step: Extract<InjectStep, { kind: "submit-check" }>, hosted: HostedAgent | null): { ok: true } | InjectFailure | "retry-enter" {
  const agent = hosted?.agent ?? "unknown agent"
  const handedOver = (): { ok: true } => {
    log(`submit-check: pane ${step.paneId} no longer runs the ${agent} (pid ${hosted?.pid ?? "?"}) the message was typed into — submission not verified, no retry Enter`)
    return { ok: true }
  }
  if (hosted !== null && !paneStillHosts(step.paneId, hosted)) return handedOver()
  const screen = hosted === null ? null : capturePane(step.paneId)
  const typed = hosted === null || screen === null ? null : messageStillTyped(hosted.agent, screen, step.text)
  if (hosted === null || typed === null) {
    log(`submit-check: pane ${step.paneId} (${agent}) — input box not readable, submission not verified`)
    return { ok: true }
  }
  if (!typed) return { ok: true }
  if (!step.final) {
    if (!paneStillHosts(step.paneId, hosted)) return handedOver()
    log(`submit-check: pane ${step.paneId} (${agent}) still shows the message after Enter — retrying Enter once`)
    return "retry-enter"
  }
  log(`submit-check: pane ${step.paneId} (${agent}) still shows the message after the retry Enter — reporting it unsubmitted`)
  return { ok: false, unsubmitted: true, error: unsubmittedNotice(step.paneId, hosted.agent, step.text) }
}

// Execute an InjectStep plan (verify-pane: verifyPaneStep; submit-check: submitCheckStep). A plan
// owns its pane's input until it ends: a second message typed meanwhile would join the first in
// the box and the retry Enter would send both as one. EVERY plan on a pane takes the turn — a
// digit or key plan (a late button tap) types into the same pane as a text plan mid-check.
function executeInjectSteps(steps: InjectStep[]): Promise<{ ok: true } | InjectFailure> {
  const key = paneTypingKey(steps)
  return key ? serializeTyping(key, () => runInjectStepsLocked(steps)) : runInjectSteps(steps)
}

// The in-process turn above cannot see the detached `auto-continue-once` process, which types into
// the same panes: a pane's typing turn is also a lock file in the config dir (a dead owner's lock
// is broken). A lock that stays held past the budget is typed through — a stuck owner must not
// swallow the message.
const PANE_LOCK_ATTEMPTS = 400
const PANE_LOCK_DELAY_MS = 50
function paneLockIo(paneId: string): RoutesLockIo {
  const dir = join(resolveConfigDir(process.env.HOME ?? "~"), "pane-locks")
  mkdirSync(dir, { recursive: true })
  return fsRoutesLockIo(join(dir, `${paneId.replace(/[^A-Za-z0-9]/g, "_")}.lock`))
}

async function runInjectStepsLocked(steps: InjectStep[]): Promise<{ ok: true } | InjectFailure> {
  const paneId = (steps.find((step) => step.kind === "verify-pane") as Extract<InjectStep, { kind: "verify-pane" }>).paneId
  const io = paneLockIo(paneId)
  let held = false
  for (let i = 0; i < PANE_LOCK_ATTEMPTS && !held; i++) {
    held = io.acquire()
    if (held) break
    if (io.ownerDead() === true) io.breakIfDead()
    else await Bun.sleep(PANE_LOCK_DELAY_MS)
  }
  if (!held) log(`pane ${paneId} typing lock still held after ${PANE_LOCK_ATTEMPTS * PANE_LOCK_DELAY_MS}ms — typing through`)
  try {
    return await runInjectSteps(steps)
  } finally {
    if (held) io.release()
  }
}

// tg-cli#309: the verify-permission-menu step found a different menu (or none) where
// the plan's target was — the digit is never sent.
const PERMISSION_MENU_CHANGED: InjectFailure = {
  ok: false,
  error: "permission menu changed before the digit was sent — nothing typed",
}

async function runInjectSteps(steps: InjectStep[]): Promise<{ ok: true } | InjectFailure> {
  let hosted: HostedAgent | null = null
  for (const step of steps) {
    if (step.kind === "verify-pane") {
      const verified = verifyPaneStep(step)
      if (!verified.ok) return verified
      hosted = verified.hosted
    } else if (step.kind === "verify-permission-menu") {
      if (!permissionMenuUnchanged(capturePane(step.paneId), step.target)) return PERMISSION_MENU_CHANGED
    } else if (step.kind === "submit-check") {
      const checked = submitCheckStep(step, hosted)
      if (checked !== "retry-enter") return checked
    } else if (step.kind === "tmux") {
      const proc = Bun.spawnSync(step.argv, {
        stdin: step.stdin !== undefined ? new TextEncoder().encode(step.stdin) : undefined,
        stdout: "ignore",
        stderr: "pipe",
      })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `${step.argv.join(" ")} failed: ${proc.stderr.toString().trim()}` }
      }
    } else {
      await Bun.sleep(step.ms)
    }
  }
  return { ok: true }
}

// Types an inbound Telegram message (`messageId`) into a tmux pane at most once (tg-cli#299).
function injectInbound(messageId: number | null, paneId: string, steps: InjectStep[]): Promise<{ ok: true } | InjectFailure> {
  return deliverInboundOnce(messageId, paneId, () => executeInjectSteps(steps))
}

function executeInjectStepsSync(steps: InjectStep[]): { ok: true } | InjectFailure {
  const paneId = steps.find((step) => step.kind === "verify-pane")?.paneId
  if (paneId === undefined) return runInjectStepsSync(steps)
  return withRoutesLock(paneLockIo(paneId), () => runInjectStepsSync(steps), { attempts: PANE_LOCK_ATTEMPTS, delayMs: PANE_LOCK_DELAY_MS })!
}

function runInjectStepsSync(steps: InjectStep[]): { ok: true } | InjectFailure {
  let hosted: HostedAgent | null = null
  for (const step of steps) {
    if (step.kind === "verify-pane") {
      const verified = verifyPaneStep(step)
      if (!verified.ok) return verified
      hosted = verified.hosted
    } else if (step.kind === "verify-permission-menu") {
      if (!permissionMenuUnchanged(capturePane(step.paneId), step.target)) return PERMISSION_MENU_CHANGED
    } else if (step.kind === "submit-check") {
      const checked = submitCheckStep(step, hosted)
      if (checked !== "retry-enter") return checked
    } else if (step.kind === "tmux") {
      const proc = Bun.spawnSync(step.argv, {
        stdin: step.stdin !== undefined ? new TextEncoder().encode(step.stdin) : undefined,
        stdout: "ignore",
        stderr: "pipe",
      })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `${step.argv.join(" ")} failed: ${proc.stderr.toString().trim()}` }
      }
    } else {
      Bun.sleepSync(step.ms)
    }
  }
  return { ok: true }
}

// Capture a pane's current visible text (`tmux capture-pane -pJ`), used to
// re-check whether a Claude Code numbered permission menu is STILL showing
// before late-delivering a decision into it (see the permission branch of
// lateDeliverAbandonedQuestion). `-J` joins tmux's internal line-wrap breaks
// back into logical lines — without it, a long command that hard-wraps
// mid-token gets a newline (→ a space, after permission-menu.ts's whitespace
// normalization) inserted INSIDE the token, which can turn a real identity
// match into a false negative for exactly the long commands most likely to
// hit the 120s hook budget in the first place (review finding). Never
// throws: a dead pane / missing tmux yields null, same fail-soft posture as
// the rest of this file's tmux calls.
function capturePane(paneId: string): string | null {
  try {
    const proc = Bun.spawnSync(["tmux", "capture-pane", "-p", "-J", "-t", paneId], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
    })
    if (proc.exitCode !== 0) return null
    return proc.stdout.toString()
  } catch {
    return null
  }
}

// --- voice transcription (inbound STT) ---

// Configured AND the on-disk artefacts still exist. The config gate
// (isVoiceConfigured) is cheap; this adds the filesystem check the step function
// can't do (it is pure). A deleted model/binary falls back to onboarding instead
// of downloading the note and failing deep inside the runner.
function voiceReady(ctx: Ctx): boolean {
  return isVoiceConfigured(ctx.voice) && voiceArtifactsPresent(ctx.voice, existsSync, managedModelDir(ctx.home))
}

// The CT2 dir `tg voice setup` downloads into — it must also hold its tokenizer.
function managedModelDir(home: string): string {
  return managedVoicePaths(voiceInstallRoot(home)).fasterWhisperModelDir
}

// Spawn a binary ASYNCHRONOUSLY (Bun.spawn, not spawnSync) with a timeout +
// pipes, NEVER throwing. Async is the key: ffmpeg/whisper can take many seconds,
// and spawnSync would BLOCK the daemon's single event loop — freezing the
// Telegram poll loop AND the Unix hook server (q→buttons) until the child exits.
// `await proc.exited` yields the loop so hooks and other control messages keep
// flowing during a long transcription. The timeout kills the child (and so the
// awaited promise resolves) instead of wedging. A missing executable makes
// Bun.spawn throw ENOENT, which — uncaught — would bubble to the poll loop AFTER
// the offset was persisted and silently lose the note; caught here → exit 127.
async function spawnGuarded(
  argv: string[],
  timeoutMs: number,
  opts: { cwd?: string } = {},
): Promise<{ exitCode: number; stdout: string; stderr: string }> {
  let child: ReturnType<typeof Bun.spawn> | undefined
  try {
    child = Bun.spawn(argv, { stdin: "ignore", stdout: "pipe", stderr: "pipe", ...(opts.cwd ? { cwd: opts.cwd } : {}) })
    const proc = child
    let timedOut = false
    const timer = setTimeout(() => {
      timedOut = true
      proc.kill("SIGKILL")
    }, timeoutMs)
    try {
      const [stdout, stderr] = await Promise.all([
        new Response(proc.stdout).text(),
        new Response(proc.stderr).text(),
      ])
      await proc.exited
      if (timedOut) return { exitCode: 124, stdout, stderr: `${stderr}\ntimed out after ${timeoutMs}ms` }
      return { exitCode: proc.exitCode ?? 1, stdout, stderr }
    } finally {
      clearTimeout(timer)
    }
  } catch (err) {
    return { exitCode: 127, stdout: "", stderr: `spawn ${argv[0]} failed: ${err}` }
  }
}

// Spawn ffmpeg (OGG→WAV 16k mono) then the configured Whisper, returning the
// cleaned transcript or null on failure. Both spawns are ASYNC (event loop stays
// free for hooks/poll during a long transcription), timeout-guarded so a stuck
// binary can't wedge the loop, and exception-guarded so a MISSING binary returns
// null (not an uncaught throw). The WAV is written next to the OGG.
async function runTranscription(ctx: Ctx, oggPath: string): Promise<string | null> {
  const wavPath = oggPath.replace(/\.[^.]+$/, "") + ".wav"
  const ff = await spawnGuarded(buildFfmpegArgv(oggPath, wavPath), 60_000)
  if (ff.exitCode !== 0 || !existsSync(wavPath)) {
    log(`ffmpeg failed: ${ff.stderr.trim()}`)
    return null
  }

  const argv =
    ctx.voice.runner === "whisper.cpp"
      ? buildWhisperCppArgv(ctx.voice, wavPath, physicalCores())
      : buildFasterWhisperArgv(ctx.voice.binPath, fasterWhisperScriptPath(ctx), ctx.voice, wavPath)

  const proc = await spawnGuarded(argv, 300_000)
  try {
    unlinkSync(wavPath)
  } catch {
    // best-effort cleanup
  }
  if (proc.exitCode !== 0) {
    log(`whisper failed (${ctx.voice.runner}): ${proc.stderr.trim()}`)
    return null
  }
  return cleanTranscript(proc.stdout)
}

function formatVoiceConfirmation(text: string): string {
  const prefix = "🎤 Расшифровка: "
  const suffix = "\n… (здесь укорочено; полный текст не обрезается перед маршрутизацией)"
  const maxTelegramText = 4096
  const full = `${prefix}${text}`
  if (full.length <= maxTelegramText) return full

  const maxTextLength = Math.max(0, maxTelegramText - prefix.length - suffix.length)
  const kept: string[] = []
  let keptLength = 0
  for (const char of text) {
    if (keptLength + char.length > maxTextLength) break
    kept.push(char)
    keptLength += char.length
  }
  const out = `${prefix}${kept.join("")}${suffix}`
  if (out.length <= maxTelegramText) return out
  return `${prefix}${suffix}`.slice(0, maxTelegramText)
}

// The faster-whisper runner script: the configured project's own transcriber
// when it ships one (my_faster_whisper.py / transcribe.py), else a generated
// fallback written into the config dir. `main.py` is intentionally NOT trusted
// as a transcriber — uv-init projects ship a "Hello world" main.py that would
// silently produce no text. Resolved at transcription time (not stored) so a
// moved project is tolerated. The fallback is (re)written whenever it differs
// from the built-in copy, so an upgrade reaches hosts that already have one.
function fasterWhisperScriptPath(ctx: Ctx): string {
  // binPath is <project>/.venv/bin/python → project root is three dirs up.
  const projectRoot = resolve(ctx.voice.binPath, "..", "..", "..")
  for (const name of ["my_faster_whisper.py", "transcribe.py"]) {
    const candidate = join(projectRoot, name)
    if (existsSync(candidate)) return candidate
  }
  // No project transcriber → the self-contained built-in one.
  const fallback = join(ctx.configDir, "tg-faster-whisper.py")
  if (readFileOrNull(fallback) !== FASTER_WHISPER_FALLBACK_SCRIPT) {
    try {
      mkdirSync(ctx.configDir, { recursive: true })
      writeFileSync(fallback, FASTER_WHISPER_FALLBACK_SCRIPT)
    } catch (err) {
      log(`faster-whisper fallback script write failed: ${err}`)
    }
  }
  return fallback
}

// Persist the resolved voice config into <configDir>/config.yaml, replacing any
// existing `voice:` block (or appending one). No secrets here — only
// binary/model paths + language. The config dir is created first (a fresh
// machine running `tg voice setup` before anything else has no ~/.config/tg-cli
// yet). Returns whether the write landed so the caller can avoid claiming
// "configured" on a swallowed ENOENT.
function persistVoiceConfigToDir(configDir: string, cfg: VoiceConfig): boolean {
  try {
    mkdirSync(configDir, { recursive: true })
    const path = join(configDir, "config.yaml")
    const existing = readFileOrNull(path) ?? ""
    writeFileSync(path, upsertVoiceBlock(existing, cfg))
    return true
  } catch (err) {
    log(`voice config persist failed: ${err}`)
    return false
  }
}

// `tg-ctl voice-setup` (invoked by `tg voice setup`): probe the host, decide,
// install when nothing usable is there, persist when ready, and print the human
// guidance to stdout so the CLI relays it. Never sends to Telegram — this is the
// interactive local path. Takes only what it needs (no bot token / chatId — the
// gate is bypassed for this command). A configured runner whose files are still
// on disk is kept (decideOnboarding). The install plan is prebuilt only
// (Homebrew bottles, PyPI wheels, model downloads); each step runs with the
// terminal attached so download progress shows, and the host is re-probed after
// it, so "configured" is only claimed for an install that is really usable.
// `dryRun` prints the plan / the voice block it would write and changes nothing.
// Returns true on success (config written, or guidance shown for a not-ready
// host), false when an install step fails or a ready install could not be
// persisted — the caller exits non-zero so scripts/agents don't mistake it for
// a successful setup.
function runVoiceSetup(args: { configDir: string; home: string; current: VoiceConfig; dryRun: boolean }): boolean {
  const color = shouldColorize()
  const current = {
    cfg: args.current,
    present: voiceArtifactsPresent(args.current, existsSync, managedModelDir(args.home)),
  }
  let verdict = decideOnboarding(probeWhisper(args.home), args.current.language, current)
  if (verdict.kind === "install") {
    console.log(colorizeVoiceStatus(onboardingMessage(verdict), color))
    if (args.dryRun) {
      console.log("--dry-run: nothing installed, config.yaml unchanged.")
      return true
    }
    for (const step of verdict.steps) {
      console.log(`\n→ ${step.label}: ${formatCommand(step.argv)}`)
      let outcome: string | null
      try {
        // Each step is bounded on its own: `tg-ctl voice-setup` may be run directly,
        // without the `tg` wrapper's overall cap. The network tools time out stalls
        // themselves (curl --speed-time, uv/HF read timeouts); this catches the rest.
        const r = Bun.spawnSync(step.argv, {
          stdin: "inherit",
          stdout: "inherit",
          stderr: "inherit",
          timeout: 30 * 60_000,
        })
        outcome = r.exitedDueToTimeout ? "timed out after 30 min" : r.exitCode === 0 ? null : `exit ${r.exitCode ?? 1}`
      } catch (err) {
        console.error(String(err))
        outcome = "exit 127"
      }
      if (outcome !== null) {
        console.error(`✗ ${step.label} failed (${outcome}). Fix the cause above and re-run \`tg voice setup\`.`)
        return false
      }
    }
    verdict = decideOnboarding(probeWhisper(args.home), args.current.language, current)
    if (verdict.kind !== "ready") {
      console.error(`The install finished but no usable Whisper was found:\n${onboardingMessage(verdict)}`)
      return false
    }
  }
  if (verdict.kind === "ready") {
    const path = join(args.configDir, "config.yaml")
    if (args.dryRun) {
      console.log(`--dry-run: ${path} unchanged; tg voice setup would write:\n${renderVoiceConfigBlock(verdict.cfg)}`)
      return true
    }
    if (!persistVoiceConfigToDir(args.configDir, verdict.cfg)) {
      console.error(
        `Found a local Whisper (${verdict.cfg.runner}, ${verdict.cfg.modelPath}) but could not write ` +
          `${path}. Fix the permissions and re-run \`tg voice setup\`.`,
      )
      return false
    }
  }
  // This is the CLI path (`tg voice setup`): colorize the ✓/○ status glyph for a
  // terminal (green=configured, yellow=pending), and never when piped/NO_COLOR.
  // The DAEMON path (an unconfigured voice note) sends onboardingMessage to
  // Telegram uncolored — it builds the message directly and never calls this.
  console.log(colorizeVoiceStatus(onboardingMessage(verdict), color))
  return true
}

// Shared by `tg-ctl status` (CLI) and the /status command (TG reply). Works
// with no daemon running — everything is read from files + live discovery.
function findShadowingClaudeStatusLine(home: string, cwd: string, command: string): string | null {
  const userSettingsPath = resolve(home, ".claude", "settings.json")
  let dir = resolve(cwd)
  while (true) {
    for (const name of ["settings.local.json", "settings.json"]) {
      const candidate = resolve(dir, ".claude", name)
      if (candidate === userSettingsPath) continue
      const settings = readJsonObjectOrNull(candidate)
      if (!settings || !hasClaudeStatusLineCommand(settings)) continue
      return claudeStatusLineTelemetryInstalled(settings, command) ? null : candidate
    }
    const parent = dirname(dir)
    if (parent === dir) return null
    dir = parent
  }
}

function newestRegisteredCwd(regs: Registration[]): string | null {
  let best: Registration | null = null
  for (const reg of regs) {
    if (!reg.cwd) continue
    if (!best || (reg.registeredAt ?? 0) > (best.registeredAt ?? 0)) best = reg
  }
  return best?.cwd ?? null
}

function registeredCwdForPane(regs: Registration[], pane: Pick<PaneInfo, "paneId" | "sessionName">): string | null {
  const exact = regs.find((reg) => reg.cwd && reg.paneId && reg.paneId === pane.paneId)
  if (exact?.cwd) return exact.cwd
  const sessionMatches = regs.filter((reg) => reg.cwd && !reg.paneId && reg.sessionName && reg.sessionName === pane.sessionName)
  return sessionMatches.length === 1 ? sessionMatches[0].cwd! : null
}

function singleRegisteredCwd(regs: Registration[]): string | null {
  const unique = [...new Set(regs.map((reg) => reg.cwd).filter((cwd): cwd is string => Boolean(cwd)))]
  return unique.length === 1 ? unique[0] : null
}

// The bot's topic settings from getMe (docs/specs/session-registry-and-topics.md §4.6, tg-cli#736),
// or null when topics are off. With allows_users_to_create_topics, Telegram opens a new topic for
// every message sent from its "New Chat" entry (an implicit topic, §4.4 row 4) — the usual cause
// behind "a new topic appeared and my message went to a picker". Null synchronously, not a
// promise of null: with topics off, /status takes no extra await and keeps its place among the
// replies of the same batch.
function topicSettingsLine(ctx: Ctx): Promise<string> | null {
  if (!ctx.cfg.topics && !ctx.cfg.privateTopics) return null
  return botPostResult(ctx, "getMe", {}, 3_000).then((me) => {
    if (!me.ok) return `topics: getMe unavailable (${me.description})`
    const result = me.json.result
    const settings = new Map<string, unknown>(result && typeof result === "object" ? Object.entries(result) : [])
    const userTopics = settings.get("allows_users_to_create_topics")
    const line =
      `topics: has_topics_enabled=${String(settings.get("has_topics_enabled") ?? "unknown")}, ` +
      `allows_users_to_create_topics=${String(userTopics ?? "unknown")}`
    return userTopics === true
      ? `${line} — ⚠ every message sent from Telegram's "New Chat" opens a new topic and waits behind the session picker; @BotFather can stop users creating topics`
      : line
  })
}

// `topicSettings`: the resolved topicSettingsLine, awaited by the async caller.
function composeStatus(ctx: Ctx, statusCwd: string | null, topicSettings: string | null): string {
  const env = autostartEnv(ctx)
  const runState = probeDaemonRunState(ctx, false)
  const lines: string[] = [daemonStatusLine(runState, ctx.botId)]
  // Merged ≠ deployed until the resident process restarts (tg-cli#279): name the commit it loaded.
  if (runState.kind === "running") {
    const freshness = assessRunningCode(ctx, runState.pid)
    lines.push(codeFreshnessLine(freshness) + (shouldRestartForFreshness(freshness) ? " — run `tg-ctl restart`" : ""))
  }
  if (topicSettings) lines.push(topicSettings)

  // Show every LIVE registered session (the per-pane set), not just one — a
  // multi-session operator must SEE that all their panes are registered to
  // forward. Prune against the live snapshot so closed panes don't show as ghosts
  // (review finding); a flaky/empty snapshot skips pruning (shows all, fail-safe).
  const statusPanes = snapshot().panes
  const statusLive = statusPanes.length > 0 ? new Set(statusPanes.map((p) => p.paneId)) : null
  const regs = readRegistrations(ctx.paths, statusLive)
  if (regs.length === 0) {
    lines.push("registrations: none")
  } else {
    lines.push(`registrations: ${regs.length}`)
    for (const reg of regs) {
      lines.push(
        `  - pane ${reg.paneId ?? "?"}, cwd ${reg.cwd ?? "?"}` +
          (reg.sessionName ? `, session ${reg.sessionName}` : ""),
      )
    }
  }
  const found = discoverTarget(ctx)
  const statusScopeCwd = statusCwd ?? (found.ok ? found.target.pane.panePath : newestRegisteredCwd(regs) ?? ctx.cwd)
  lines.push(
    found.ok
      ? `target: ${found.target.agent} in ${found.target.pane.sessionName}:${found.target.pane.windowIndex} ` +
          `${found.target.pane.paneId}` +
          (found.target.agentPid !== undefined ? ` (pid ${found.target.agentPid})` : "")
      : found.reason === "ambiguous"
        ? `target: ambiguous —\n${formatCandidates(found.candidates)}`
        : "target: no agent pane found",
  )
  // Sessions a rig wrapper hosts in abduco outside tmux: reachable through their PTY.
  const statusSnapshot = snapshot()
  const hosted = ptyOnlyHosts(statusSnapshot.panes, statusSnapshot.procs)
  if (hosted.length > 0) {
    lines.push(`hosted (abduco, outside tmux): ${hosted.length}`)
    for (const h of hosted) lines.push(`  - ${describeHost(h)}`)
  }
  // Agents outside tmux AND outside the rig wrapper (tg-cli#306) — listed, not omitted, with the
  // reason and how to restart them so Telegram can reach them; the silent-invisibility this
  // replaces was the incident.
  const unreachable = listUnreachableAgents()
  if (unreachable.length > 0) {
    lines.push(`unreachable (outside tmux and the rig wrapper): ${unreachable.length}`)
    for (const a of unreachable) lines.push(`  - ${describeUnreachable(a)}`)
    lines.push(`  ${UNREACHABLE_HINT}`)
  }
  const liveOmp = listLiveOmpAgents()
  if (liveOmp.length > 0) {
    lines.push(`omp (original-process): ${liveOmp.length}`)
    lines.push(...describeOmpLines(liveOmp))
    lines.push(...describeUnbridgedOmp(liveOmp, (pids) => readBridgeCodeAge(ctx.home, pids)))
  }
  const offsetMtime = fileMtimeMs(ctx.paths.offset)
  lines.push(
    offsetMtime === null
      ? "offset: none"
      : `offset: ${readOffset(readFileOrNull(ctx.paths.offset))} ` +
          `(file age ${Math.round((Date.now() - offsetMtime) / 1000)}s)`,
  )
  // Guide the user when q→buttons isn't wired (the hook is what forwards an
  // agent's question to Telegram — without it the feature is silently dead).
  const hooksRaw = readFileOrNull(join(ctx.home, ".claude", "settings.json"))
  let questionHooksOk = false
  let harnessHooksOk = false
  let statusLineTelemetryOk = false
  let codexUsageTelemetryOk = false
  let shadowingStatusLine: string | null = null
  if (hooksRaw) {
    try {
      const hooksSettings = JSON.parse(hooksRaw)
      questionHooksOk = claudeHooksInstalled(hooksSettings, CLAUDE_QUESTION_HOOK_CMD)
      harnessHooksOk = harnessHooksInstalled(hooksSettings, CLAUDE_HARNESS_HOOK_CMD)
      statusLineTelemetryOk = claudeStatusLineTelemetryInstalled(hooksSettings, CLAUDE_STATUSLINE_TELEMETRY_CMD)
      if (statusLineTelemetryOk) {
        shadowingStatusLine = findShadowingClaudeStatusLine(ctx.home, statusScopeCwd, CLAUDE_STATUSLINE_TELEMETRY_CMD)
      }
    } catch {}
  }
  const codexHooksRaw = readFileOrNull(join(codexConfigDir(ctx.home), "hooks.json"))
  if (codexHooksRaw) {
    try {
      const codexHooksSettings = JSON.parse(codexHooksRaw)
      codexUsageTelemetryOk = codexUsageHookInstalled(codexHooksSettings, CODEX_USAGE_HOOK_CMD)
    } catch {}
  }
  lines.push(
    questionHooksOk
      ? "q→buttons hooks: installed (Claude Code)"
      : "q→buttons hooks: NOT installed — run `tg-ctl install-hooks`",
  )
  lines.push(
    harnessHooksOk
      ? "limit/error hooks: installed (Claude Code StopFailure)"
      : "limit/error hooks: NOT installed — run `tg-ctl install-hooks`",
  )
  lines.push(
    shadowingStatusLine
      ? `usage telemetry: shadowed by ${shadowingStatusLine} — run \`tg-ctl install-hooks\` from that scope or remove the override`
      : statusLineTelemetryOk
        ? "usage telemetry: installed (Claude Code statusLine)"
        : "usage telemetry: NOT installed — run `tg-ctl install-hooks`",
  )
  lines.push(
    codexUsageTelemetryOk
      ? "Codex usage telemetry: installed (Stop hook transcript collector)"
      : "Codex usage telemetry: NOT installed — run `tg-ctl install-hooks`, then trust it via Codex `/hooks`",
  )
  // Autostart (the shared service-management lifecycle): an installed unit means the daemon
  // comes back at login. Mirrors the q→buttons line — installed reports the kind/label, absent
  // gets a hint. On the no-op fallback (no launchd/systemd) there's no unit to find.
  //
  // Two mechanisms can autostart the daemon: tg-ctl's OWN `enable` unit (the file existence check),
  // OR an EXTERNAL launchd job that supervises this tg-ctl binary, wired outside tg-ctl (e.g. rig's
  // `ai.hyperide.tg-ctl` LaunchAgent). We check the own unit first (it carries the precise kind/label
  // and is cheap), then probe launchd for an external supervisor before declaring "NOT enabled" —
  // otherwise status lies while launchd keeps the daemon alive across reboots (tg-cli#88).
  const kind = autostartKind(env)
  lines.push(composeAutostartLine(env, kind))
  return lines.join("\n")
}

// The three Claude Code hook commands the daemon owns, as one unit. Shared by
// `install-hooks` and the startup self-heal so both target the identical wiring.
const CLAUDE_HOOK_COMMANDS = {
  question: CLAUDE_QUESTION_HOOK_CMD,
  harness: CLAUDE_HARNESS_HOOK_CMD,
  statusLine: CLAUDE_STATUSLINE_TELEMETRY_CMD,
}

// The resolved tg-cli config dir. SINGLE source of truth so the sentinel that
// `install-hooks` writes and the one the daemon self-heal reads resolve identically
// under the same environment (a `TG_CTL_CONFIG_DIR` set in only one of the two
// process contexts would still send them to different dirs — that is a launch-env
// mismatch, not a code divergence). Absolute so `enable` can pin it into the
// launchd/systemd unit.
function resolveConfigDir(home: string): string {
  return resolve(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"))
}

// Opt-in sentinel: `install-hooks` writes this so the daemon self-heal knows the
// user has ADOPTED the Claude hooks and it may restore them if a rewrite drops
// them. Its absence means "never opted in" → the daemon never first-time-installs
// hooks or rewrites a statusLine behind the user's back.
function claudeHooksSentinelPath(configDir: string): string {
  return join(configDir, "claude-hooks-installed")
}

// Startup self-heal: re-merge the Claude Code hooks into ~/.claude/settings.json
// when a rewrite dropped any of them — but ONLY for a user who previously ran
// `install-hooks` (the opt-in sentinel). The merge is purely ADDITIVE (reconcile
// appends missing hook groups and WRAPS any existing statusLine so the user's own
// display output is preserved) and CONVERGES after one write. Idempotent (writes
// only on an actual change) and fully best-effort — every failure is swallowed
// with a log line so the daemon always proceeds to its poll loop. Heals only the
// user-scope file; a shadowing project-scoped statusLine is left to the explicit
// `install-hooks`. The backup uses a self-heal-specific suffix + atomicWrite so an
// unattended heal can never clobber the manual `install-hooks` `.bak` nor truncate
// settings.json into garbage that would wedge the next start.
function ensureClaudeHooksOnStartup(ctx: Ctx): void {
  try {
    const claudeDir = join(ctx.home, ".claude")
    const paths = {
      settingsPath: join(claudeDir, "settings.json"),
      settingsDir: claudeDir,
      sentinelPath: claudeHooksSentinelPath(ctx.configDir),
    }
    const fs = {
      exists: existsSync,
      read: readFileOrNull,
      backup: (p: string, content: string) => {
        try {
          writeFileSync(p, content)
        } catch {}
      },
      writeAtomic: writeSettingsPreservingLink,
      ensureDir: (dir: string) => mkdirSync(dir, { recursive: true }),
      markOptedIn: (p: string) => writeFileSync(p, `${new Date().toISOString()}\n`),
    }
    const res = runClaudeHookSelfHeal(fs, paths, CLAUDE_HOOK_COMMANDS)
    if (res.outcome === "healed") {
      log("ensureClaudeHooksOnStartup: re-merged dropped Claude Code hooks into settings.json")
    }
    if (res.outcome === "migrated") {
      log("ensureClaudeHooksOnStartup: pre-sentinel hook install detected; wrote the opt-in sentinel (#211)")
    }
  } catch (err) {
    log(`ensureClaudeHooksOnStartup failed: ${err}`)
  }
}

// #458: every NEW interactive omp must load the original-process bridge without a
// manual step. Only where omp is actually used (its agent dir exists); the installer
// is idempotent and refuses user-owned or differently-managed loaders. Best-effort.
async function ensureOmpLiveExtensionOnStartup(ctx: Ctx): Promise<void> {
  const agentRoot = join(ctx.home, ".omp", "agent")
  if (!existsSync(agentRoot)) return
  try {
    const res = await installOmpLiveExtension(agentRoot)
    if (res.changed) log(`omp-live: installed the original-process extension at ${res.path} (new omp sessions load it)`)
  } catch (err) {
    log(`omp-live: extension not installed: ${err instanceof Error ? err.message : String(err)}`)
  }
}

// Direct fallback writer: merges the Codex Stop usage-telemetry hook straight into
// ~/.codex/hooks.json (backing the file up first). Used when rig is absent, and as the
// telemetry-preservation safety net when rig is present but hasn't provisioned the hook itself
// yet — see installCodexUsageTelemetry below.
function installCodexUsageTelemetryDirect(codexHooksPath: string, codexRaw: string | null, codexExisting: Record<string, unknown>): void {
  const codexUsage = withCodexUsageHook(codexExisting, CODEX_USAGE_HOOK_CMD)
  if (codexUsage.changed) {
    if (codexRaw) {
      try {
        writeFileSync(`${codexHooksPath}.bak`, codexRaw)
      } catch {}
    }
    mkdirSync(dirname(codexHooksPath), { recursive: true })
    writeFileSync(codexHooksPath, `${JSON.stringify(codexUsage.settings, null, 2)}\n`)
    console.log(`tg-ctl: installed Codex Stop usage telemetry collector → ${codexHooksPath}` + (codexRaw ? ` (backup: ${codexHooksPath}.bak)` : ""))
  } else {
    console.log("tg-ctl: Codex Stop usage telemetry collector already installed — nothing to do.")
  }
}

// Rig-aware Codex hook provisioning (tg#8672). When rig is present it owns the codex hook
// bridge (writes ~/.codex/config.toml), so writing tg-ctl's own hook straight into
// ~/.codex/hooks.json makes codex warn about loading hooks from both files. Delegate to
// `rig apply` first; rig does NOT yet fold the usage-telemetry Stop hook into its bridge, so we
// always re-check afterwards and only skip the direct hooks.json write when the hook is actually
// found installed — telemetry must never be silently lost while rig catches up (see
// features/tg-ctl/rig-delegate.ts for the detection/delegation mechanics and the full caveat).
// Returns the exit code the caller should propagate: 0 on success (rig owns it, or telemetry
// written directly), or rig's non-zero exit when a PRESENT rig FAILS (never swallowed into a
// fallback — the shared contract is that fallback is for ABSENT rig only).
function installCodexUsageTelemetry(codexHooksPath: string, codexRaw: string | null, codexExisting: Record<string, unknown>): number {
  const rig = detectRig(process.env)
  if (!rig.present) {
    // rig absent (or its shared helper not installed) — the direct write is the fallback.
    installCodexUsageTelemetryDirect(codexHooksPath, codexRaw, codexExisting)
    return 0
  }
  // Scope the reconcile to `--only harness` — the codex hook bridge is provisioned under the
  // harness layer, so a bare `rig apply` (which would reconcile skills/CI/GitHub/tmux/… too) is
  // both too broad and surprising for an `install-hooks` command.
  const delegated = runRigDelegate(["apply", "--only", "harness"], process.env, process.cwd())
  if (!delegated.ran) {
    // rig binary present but the shared helper couldn't run (e.g. agent-tools not fully
    // deployed) — the delegation never happened, so honor the request via the direct write.
    console.log(`tg-ctl: rig detected (${rig.rigPath}) but the delegation helper could not run — writing the telemetry hook directly.`)
    installCodexUsageTelemetryDirect(codexHooksPath, codexRaw, codexExisting)
    return 0
  }
  if (delegated.exitCode === NO_RIG_EXIT) {
    // The shared helper reports rig ABSENT via its sentinel (agent-tools#282: 97, moved off 3 so
    // it can't be confused with rig's own EXIT_DRIFT=3). detectRig said present, but rig went
    // away between detect and delegate (uninstalled mid-flight) — this is the "rig absent" case,
    // NOT a rig failure, so honor the request with the direct write. Branch on the sentinel
    // EXACTLY: a real rig failure (1/2/3/…) must fall through to the propagate path below.
    // Checked BEFORE the "delegated … (exit N)" log so the absent path never claims provisioning
    // happened.
    console.log(`tg-ctl: rig reported absent (sentinel ${NO_RIG_EXIT}) at delegation time — writing the telemetry hook directly.`)
    installCodexUsageTelemetryDirect(codexHooksPath, codexRaw, codexExisting)
    return 0
  }
  console.log(`tg-ctl: rig detected (${rig.rigPath}) — delegated codex hook provisioning via \`rig apply --only harness\` (exit ${delegated.exitCode})`)
  if (delegated.exitCode !== 0) {
    // A PRESENT rig that FAILS is a real failure — surface it, do NOT fall back to a direct
    // write (that would recreate the dual-source we set out to remove). Propagate the exit code.
    if (delegated.stderr.trim()) {
      console.error(`tg-ctl: rig apply failed: ${delegated.stderr.trim().split("\n").slice(0, 3).join(" | ")}`)
    }
    console.error("tg-ctl: rig apply failed — not writing codex hooks directly. Fix rig and re-run `tg-ctl install-hooks`.")
    return delegated.exitCode ?? 1
  }
  // rig succeeded. Check the AUTHORITATIVE artifact rig actually writes (~/.codex/config.toml),
  // re-read from disk — NOT the pre-delegation snapshot — to see whether rig now provisions the
  // usage-telemetry Stop hook itself.
  const codexConfigToml = readFileOrNull(join(dirname(codexHooksPath), "config.toml"))
  if (codexConfigToml && codexConfigToml.includes(CODEX_USAGE_HOOK_CMD)) {
    console.log("tg-ctl: rig now provisions the codex usage-telemetry Stop hook (~/.codex/config.toml) — skipping the direct hooks.json write.")
    return 0
  }
  // rig does not fold in the telemetry hook yet — write it directly so telemetry is not lost.
  // Re-read hooks.json FRESH (rig apply may have touched ~/.codex) rather than reusing the stale
  // pre-delegation snapshot.
  const freshRaw = readFileOrNull(codexHooksPath)
  let freshExisting: Record<string, unknown> = {}
  if (freshRaw) {
    try {
      const parsed = JSON.parse(freshRaw)
      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) freshExisting = parsed as Record<string, unknown>
    } catch {
      console.error(`tg-ctl: ${codexHooksPath} is not valid JSON after rig apply — fix or move it aside, then re-run`)
      return 1
    }
  }
  console.log(
    "tg-ctl: rig does not yet provision the codex usage-telemetry Stop hook — writing it directly so telemetry is not lost " +
      "(may coexist with rig's ~/.codex/config.toml bridge until rig folds this hook in; tg#8672).",
  )
  installCodexUsageTelemetryDirect(codexHooksPath, freshRaw, freshExisting)
  return 0
}

// Idempotently install the q→buttons agent-question hooks into Claude Code's
// user settings (backing the file up first), then print guidance for the other
// harnesses. Pure JSON merge lives in features/tg-ctl/hook-install.ts.
function installHooks(home: string): number {
  const settingsPath = join(home, ".claude", "settings.json")
  const raw = readFileOrNull(settingsPath)
  let existing: Record<string, unknown> = {}
  if (raw) {
    let parsed: unknown
    try {
      parsed = JSON.parse(raw)
    } catch {
      console.error(`tg-ctl: ${settingsPath} is not valid JSON — fix or move it aside, then re-run`)
      process.exit(1)
    }
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
      console.error(`tg-ctl: ${settingsPath} is not a JSON object — fix or move it aside, then re-run`)
      process.exit(1)
    }
    existing = parsed as Record<string, unknown>
  }
  const codexHooksPath = join(codexConfigDir(home), "hooks.json")
  const codexRaw = readFileOrNull(codexHooksPath)
  let codexExisting: Record<string, unknown> = {}
  if (codexRaw) {
    let parsed: unknown
    try {
      parsed = JSON.parse(codexRaw)
    } catch {
      console.error(`tg-ctl: ${codexHooksPath} is not valid JSON — fix or move it aside, then re-run`)
      process.exit(1)
    }
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
      console.error(`tg-ctl: ${codexHooksPath} is not a JSON object — fix or move it aside, then re-run`)
      process.exit(1)
    }
    codexExisting = parsed as Record<string, unknown>
  }
  // Provision all three Claude channels in ONE pass (q→buttons, StopFailure
  // notifications, and proactive statusLine usage telemetry) — the same shared
  // engine the daemon startup self-heal uses, so both stay in lockstep.
  const { settings, changed } = reconcileClaudeHooks(existing, CLAUDE_HOOK_COMMANDS)
  if (changed) {
    if (raw) {
      try {
        writeFileSync(`${settingsPath}.bak`, raw)
      } catch {}
    }
    mkdirSync(join(home, ".claude"), { recursive: true })
    writeFileSync(settingsPath, `${JSON.stringify(settings, null, 2)}\n`)
    console.log(`tg-ctl: installed Claude Code q→buttons + StopFailure + statusLine usage telemetry → ${settingsPath}` + (raw ? ` (backup: ${settingsPath}.bak)` : ""))
  }
  let shadowChanged = false
  const shadowingStatusLine = findShadowingClaudeStatusLine(home, process.cwd(), CLAUDE_STATUSLINE_TELEMETRY_CMD)
  if (shadowingStatusLine) {
    const shadowRaw = readFileOrNull(shadowingStatusLine)
    const shadowSettings = readJsonObjectOrNull(shadowingStatusLine)
    if (shadowRaw && shadowSettings) {
      const shadowTelemetry = withClaudeStatusLineTelemetry(shadowSettings, CLAUDE_STATUSLINE_TELEMETRY_CMD)
      if (shadowTelemetry.changed) {
        try {
          writeFileSync(`${shadowingStatusLine}.bak`, shadowRaw)
        } catch {}
        mkdirSync(dirname(shadowingStatusLine), { recursive: true })
        writeFileSync(shadowingStatusLine, `${JSON.stringify(shadowTelemetry.settings, null, 2)}\n`)
        console.log(`tg-ctl: installed Claude statusLine usage telemetry → ${shadowingStatusLine} (backup: ${shadowingStatusLine}.bak)`)
        shadowChanged = true
      }
    }
  }
  if (!changed && !shadowChanged) {
    console.log("tg-ctl: Claude Code q→buttons + StopFailure + statusLine usage telemetry already installed — nothing to do.")
  }
  const codexExit = installCodexUsageTelemetry(codexHooksPath, codexRaw, codexExisting)
  console.log("")
  console.log("Codex: trust the `tg-ctl codex-usage-hook` Stop hook via /hooks so quota telemetry can flow; add a PermissionRequest hook running `tg-ctl ask --agent codex` if you also want q→buttons.")
  console.log("opencode: native — the bot subscribes to question/permission SSE events; no hook file needed.")
  console.log("Restart any running agent session so it loads the new hooks.")
  // Record opt-in so the daemon may RESTORE these hooks if a later settings.json
  // rewrite drops them (ensureClaudeHooksOnStartup). Best-effort — never fail the
  // install over the sentinel.
  try {
    const configDir = resolveConfigDir(home)
    mkdirSync(configDir, { recursive: true })
    writeFileSync(claudeHooksSentinelPath(configDir), `${new Date().toISOString()}\n`)
    console.log(
      `The daemon will restore these hooks if a settings.json rewrite drops them. ` +
        `To stop that, delete ${claudeHooksSentinelPath(configDir)}.`,
    )
  } catch {}
  return codexExit
}

// --- start: registration snapshot + detached daemon spawn, then exit ---

function startLauncher(ctx: Ctx, flags: StartFlags): void {
  recordStartRegistration(ctx, flags)

  // No lock, no pipes (see header). The daemon flocks first and exits 0 if
  // another instance holds the bot, so double-starts are a cheap no-op.
  const logFd = openSync(ctx.paths.log, "a")
  const runBin = resolveDeployedBin(ctx.home)
  const runCwd = dirname(runBin)
  // Pin cwd + PWD to the deployed bin dir so a caller's worktree can be removed
  // after `start` without leaving the long-lived daemon on a deleted cwd.
  const proc = Bun.spawn([process.execPath, runBin, "run"], {
    detached: true,
    stdio: ["ignore", logFd, logFd],
    cwd: runCwd,
    env: { ...process.env, PWD: runCwd, TG_CTL_CONFIG_DIR: ctx.configDir },
  })
  proc.unref()
  closeSync(logFd) // the child holds its own dup
  console.log(`tg-ctl: daemon launch requested (bot ${ctx.botId}) — log: ${ctx.paths.log}`)
  // Hint at autostart unless it's already installed, so a one-shot `start` doesn't silently die
  // at the next reboot (the shared service-management contract: start HINTS at enable). Skipped
  // on the no-op fallback OS, where there's nothing to enable.
  const env = autostartEnv(ctx)
  if (autostartKind(env) !== "none" && !autostartUnitInstalled(env)) {
    console.log("tg-ctl: not set to start at login — run `tg-ctl enable` to survive reboots.")
  }
}

function recordStartRegistration(ctx: Ctx, flags: StartFlags): void {
  mkdirSync(ctx.configDir, { recursive: true })
  // UPSERT this session's entry into the per-pane registration SET (tg-cli#67),
  // keyed by paneId — instead of OVERWRITING one global slot. A `tg` send from
  // any OTHER live session no longer clobbers this session's registration, so
  // every concurrently-registered session's questions keep forwarding. Written
  // synchronously EVEN IF the daemon already runs — a fresh `tg` call re-targets
  // a long-lived daemon at the current pane (its own entry only).
  const reg: Registration = { registeredAt: Math.floor(Date.now() / 1000) }
  if (flags.paneId) reg.paneId = flags.paneId
  if (flags.cwd) reg.cwd = flags.cwd
  if (flags.session) reg.sessionName = flags.session
  // Serialize the read-modify-write across concurrent `tg start`s (two sessions
  // racing the upsert would last-writer-wins-clobber each other's entry — the
  // very lost-update the routes lock was built for). Same O_EXCL lockfile +
  // PID-liveness break; onContended:'skip' loses only THIS start's bookkeeping,
  // never another session's entry. Best-effort: a write failure must never block
  // the daemon launch below, so the whole RMW is swallowed.
  try {
    withRoutesLock(
      fsRoutesLockIo(`${ctx.paths.registration}.lock`),
      () => {
        let raw: string | null
        try {
          raw = readFileSync(ctx.paths.registration, "utf8")
        } catch {
          raw = null
        }
        writeFileSync(
          ctx.paths.registration,
          serializeRegistrations(upsertRegistration(parseRegistrations(raw), reg)),
        )
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
  } catch {
    // best-effort registration bookkeeping — never block the daemon launch
  }
}

// --- stop / restart / status ---

// Locate the daemon through the pidfile → flock holder → launchd chain `status` reports
// (tg-cli#316). `authoritativeLock`: stop/restart always ask the flock — its holder IS the daemon
// (spec §6), so a vanished pidfile can't make them no-op against a live daemon, and a live pidfile
// pid that does not hold the flock (a reused pid) is never signalled (tg-cli#438): with no lock
// holder and no launchd job, a pidfile pid that does not hold the flock is a stale pidfile. `status`
// probes the flock only when the pidfile pid is dead, keeping its cheap path.
function probeDaemonRunState(ctx: Ctx, authoritativeLock: boolean): DaemonRunState {
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const pidAlive = pid !== null && kill0(pid)
  const lockPid = authoritativeLock || !pidAlive ? lockHolderPid(ctx.paths.lock) : null
  const hintPid = lockPid ?? (pidAlive ? pid : null)
  const launchd = detectLaunchdDaemon(autostartEnv(ctx), hintPid)
  const reusedPid = authoritativeLock && pid !== null && pidAlive && lockPid === null && !launchd && !daemonLockHeldBy(ctx.paths.lock, pid)
  return daemonRunState(pid, pidAlive && !reusedPid, launchd, lockPid)
}

// How long `restart` waits for a successor (a launchd relaunch or the detached spawn) to take the
// flock and write its pidfile.
const SUCCESSOR_WAIT_MS = 15_000

// Re-run `probe` every 100ms until it yields a value or `ms` elapses (then null). Sync on purpose:
// the lifecycle subcommands are one-shot CLI calls with nothing else to run meanwhile.
function pollSync<T>(probe: () => T | null, ms: number): T | null {
  for (let waited = 0; ; waited += 100) {
    const value = probe()
    if (value !== null || waited >= ms) return value
    Bun.sleepSync(100)
  }
}

type StopOutcome =
  | { kind: "not-running" }
  | { kind: "stopped"; pid: number; launchdLabel?: string }
  | { kind: "still-alive"; pid: number }

// SIGTERM the located daemon and wait out its drain. "still-alive" means the process outlived the
// ceiling (or could not be signalled): it is NOT stopped, and `restart` must not launch over it.
// `state` is the caller's probe when it already has one (`restart --if-stale`), so one invocation
// acts on one view of the daemon instead of re-probing between the decision and the signal.
function stopDaemon(ctx: Ctx, state: DaemonRunState = probeDaemonRunState(ctx, true)): StopOutcome {
  if (state.kind === "not-running") {
    console.log("tg-ctl: not running")
    return { kind: "not-running" }
  }
  if (state.kind === "stale-pidfile") {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
    console.log(`tg-ctl: not running (cleaned stale pidfile, pid ${state.pid})`)
    return { kind: "not-running" }
  }
  const pid = state.pid
  try {
    process.kill(pid, "SIGTERM")
  } catch (err) {
    // ESRCH: it exited between the probe and the signal — that IS stopped. Anything else (EPERM:
    // another user's process) leaves it running.
    if (!(err instanceof Error && "code" in err && err.code === "ESRCH")) {
      console.error(`tg-ctl: SIGTERM failed for pid ${pid}: ${err}`)
      return { kind: "still-alive", pid }
    }
  }
  // Poll until the pid is gone, NOT a flat sleep: returning while the old daemon still owns the
  // flock would make `restart`'s successor no-op-exit on it and, once the old one drains, leave
  // NOTHING running (review: restart can leave no daemon). Ceiling: the cooperative drain may hold
  // the flock for GRACEFUL_SHUTDOWN_MS while it finishes the in-flight batch, plus a margin.
  const waitMs = GRACEFUL_SHUTDOWN_MS + 2000
  if (pollSync(() => (kill0(pid) ? null : pid), waitMs) === null) {
    console.error(`tg-ctl: pid ${pid} is still alive ${waitMs / 1000}s after SIGTERM — NOT stopped (\`kill -9 ${pid}\` if it is wedged)`)
    return { kind: "still-alive", pid }
  }
  // The daemon's cleanExit removes its own pidfile; this covers one that died without cleaning up.
  // Ownership-guarded: a launchd KeepAlive relaunch may already have written the successor's pid.
  try {
    if (ownsPidFile(readFileOrNull(ctx.paths.pid), pid)) unlinkSync(ctx.paths.pid)
  } catch {}
  console.log(`tg-ctl: stopped (pid ${pid})`)
  return { kind: "stopped", pid, launchdLabel: state.owner === "launchd" ? state.label : undefined }
}

// `tg-ctl restart [--if-stale]`: a graceful, VERIFIED reload. Exit 0 only when the old process is
// confirmed dead AND a successor holds the flock (its pidfile names a new live pid) — never
// "restarted" over a still-running old daemon or over nothing (tg-cli#438). A launchd-owned daemon
// comes back under launchd (`launchctl kickstart`; a no-op when a KeepAlive job already relaunched
// it), never as a detached stray fighting launchd for the flock. `--if-stale` is the deploy path
// (tg-cli#279): act only when a daemon runs whose loaded code is not proven current.
function restartDaemon(ctx: Ctx, flags: StartFlags, ifStale: boolean): number {
  let running: DaemonRunState | undefined
  if (ifStale) {
    running = probeDaemonRunState(ctx, true)
    if (running.kind !== "running") {
      console.log("tg-ctl: not running — nothing to restart")
      return 0
    }
    const freshness = assessRunningCode(ctx, running.pid)
    if (!shouldRestartForFreshness(freshness)) {
      console.log(`tg-ctl: ${codeFreshnessLine(freshness)} — no restart needed`)
      return 0
    }
    console.log(`tg-ctl: ${codeFreshnessLine(freshness)} — restarting`)
  }
  const stopped = stopDaemon(ctx, running)
  if (stopped.kind === "still-alive") {
    console.error(`tg-ctl: restart aborted — pid ${stopped.pid} is still running; did NOT start a replacement.`)
    return 1
  }
  const oldPid = stopped.kind === "stopped" ? stopped.pid : null
  const launchdLabel = stopped.kind === "stopped" ? stopped.launchdLabel : undefined
  if (launchdLabel) {
    recordStartRegistration(ctx, flags)
    if (!runAutostartCommand({ argv: ["launchctl", "kickstart", `${launchdDomain()}/${launchdLabel}`], describe: `kickstart of launchd job ${launchdLabel}` })) {
      return 1
    }
  } else {
    startLauncher(ctx, flags)
  }
  // The daemon writes its pidfile only after taking the flock; still requiring the pidfile pid to
  // hold the flock rejects a detached successor that died right after writing it — our own
  // unreaped child keeps answering kill(0) as a zombie, but the kernel has already released its
  // lock — and a stale pidfile naming some other live pid.
  const successor = pollSync(() => {
    const pid = readPidFile(readFileOrNull(ctx.paths.pid))
    return pid !== null && pid !== oldPid && kill0(pid) && daemonLockHeldBy(ctx.paths.lock, pid) ? pid : null
  }, SUCCESSOR_WAIT_MS)
  if (successor === null) {
    const where = launchdLabel ? `launchd job ${launchdLabel}` : `the daemon log ${ctx.paths.log}`
    console.error(`tg-ctl: restart FAILED — no new daemon took the lock within ${SUCCESSOR_WAIT_MS / 1000}s; check ${where}.`)
    return 1
  }
  console.log(oldPid === null ? `tg-ctl: started (pid ${successor})` : `tg-ctl: restarted (pid ${oldPid} → ${successor})`)
  return 0
}

// Run `git -C dir …`; trimmed stdout, or null when git fails / is missing.
function gitOutput(dir: string, args: string[]): string | null {
  try {
    const r = Bun.spawnSync(["git", "-C", dir, ...args], { stdout: "pipe", stderr: "ignore" })
    return r.exitCode === 0 ? r.stdout.toString().trim() : null
  } catch {
    return null
  }
}

// Record which commit this daemon process loaded (tg-cli#279) so `status` and `restart --if-stale`
// can compare it with the checkout's HEAD. Best-effort: outside a git checkout nothing is recorded
// and the code identity reads as unknown.
function recordRunInfo(ctx: Ctx): void {
  try {
    const codeDir = dirname(realpathSync(import.meta.path))
    const commit = gitOutput(codeDir, ["rev-parse", "HEAD"])
    if (commit) atomicWrite(ctx.paths.runInfo, serializeRunInfo({ pid: process.pid, commit, codeDir, startedAt: Date.now() }))
  } catch {}
}

// Is the running daemon executing the code its checkout holds now? (tg-cli#279)
function assessRunningCode(ctx: Ctx, daemonPid: number): CodeFreshness {
  const info = parseRunInfo(readFileOrNull(ctx.paths.runInfo))
  if (info === null || info.pid !== daemonPid) return assessCodeFreshness(info, daemonPid, null, null)
  const head = gitOutput(info.codeDir, ["rev-parse", "HEAD"])
  let changed: string[] | null = []
  if (head !== null && head !== info.commit) {
    const out = gitOutput(info.codeDir, ["diff", "--name-only", info.commit, head])
    changed = out === null ? null : out.split("\n").filter(Boolean)
  }
  return assessCodeFreshness(info, daemonPid, head, changed)
}

// --- enable / disable: OS autostart self-registration (the agenttools_service contract) ---

// Exit code for an autostart enable/disable that failed to install/remove the OS unit (the OS
// control command returned nonzero, or the unit file could not be written/removed). Mirrors the
// agenttools_service contract's exit-code 4 for "autostart enable/disable failed", so a script
// can branch on "the service is up but autostart is NOT live".
const EXIT_AUTOSTART_FAILED = 4

// Resolve the path the autostart unit should launch. launchd/systemd run the agent with a
// minimal PATH, so argv MUST be absolute. The deployed binary is the ~/.files/bin/tg-ctl symlink
// on PATH; fall back to this script's own path when it isn't installed (e.g. a worktree run) so
// `enable` from a dev checkout still launches the right file.
function resolveDeployedBin(home: string): string {
  const deployed = join(home, ".files", "bin", "tg-ctl")
  return existsSync(deployed) ? deployed : import.meta.path
}

// True when `systemctl --user` is usable on this Linux host. Cheap probe, never throws. macOS
// never calls this (autostartKind short-circuits to launchd before hasSystemd is read).
function hasUserSystemd(): boolean {
  try {
    const r = Bun.spawnSync(["systemctl", "--user", "--version"], { stdout: "ignore", stderr: "ignore" })
    return r.exitCode === 0
  } catch {
    return false
  }
}

function autostartEnv(ctx: Ctx): AutostartEnv {
  return {
    platform: process.platform,
    home: ctx.home,
    binPath: resolveDeployedBin(ctx.home),
    bunPath: process.execPath,
    logPath: ctx.paths.log,
    // The resolved config dir, so a non-default `TG_CTL_CONFIG_DIR=/x tg-ctl enable` pins it into
    // the unit (the OS launches the daemon with a minimal env that wouldn't carry it otherwise).
    configDir: ctx.configDir,
    xdgConfigHome: process.env.XDG_CONFIG_HOME ?? "",
    hasSystemd: process.platform === "linux" ? hasUserSystemd() : false,
  }
}

// The OS unit label/name for an enable-path message. Narrows the type to the kinds that HAVE a unit
// (the "none" fallback installs none) so a fallback can't be mislabeled, and delegates the actual
// mapping to autostartKindLabel — single source of truth shared with the status line, so the two
// can't drift.
function autostartUnitLabel(kind: "launchd" | "systemd"): string {
  return autostartKindLabel(kind)
}

// Is the launchd/systemd unit file already on disk for tg-ctl? Cheap existence check (no plist/
// unit body rendered); on the no-op fallback (no unit file) this returns false.
function autostartUnitInstalled(env: AutostartEnv): boolean {
  const path = autostartUnitPath(env)
  return path !== undefined && existsSync(path)
}

// The impure launchd probe behind detectExternalLaunchdSupervisor, factored out so the detection
// flow can be unit-tested with a fake probe (no real launchctl). `listLabels` runs `launchctl list`;
// `printDump(label)` runs `launchctl print <domain>/<label>`. Each returns undefined on failure so
// the caller skips that job instead of crashing.
interface LaunchctlProbe {
  listLabels(): string[] | undefined
  listJobs(): Array<{ pid: number | null; label: string }> | undefined
  printDump(label: string): string | undefined
}

// A LaunchAgent lives in the per-user `gui/<uid>` domain; under root (uid 0) daemons live in
// `system` instead (`gui/0/<label>` just errors), so pick the domain by uid.
function launchdDomain(): string {
  const uid = process.getuid?.() ?? 0
  return uid === 0 ? "system" : `gui/${uid}`
}

// The real probe: `launchctl list` for labels, `launchctl print <domain>/<label>` per label.
function realLaunchctlProbe(): LaunchctlProbe {
  const domain = launchdDomain()
  const listStdout = (): string | undefined => {
    const r = Bun.spawnSync(["launchctl", "list"], { stdout: "pipe", stderr: "ignore" })
    if (r.exitCode !== 0 || !r.stdout) return undefined
    return new TextDecoder().decode(r.stdout)
  }
  return {
    listLabels() {
      const stdout = listStdout()
      return stdout === undefined ? undefined : parseLaunchctlListLabels(stdout)
    },
    listJobs() {
      const stdout = listStdout()
      return stdout === undefined ? undefined : parseLaunchctlListJobs(stdout)
    },
    printDump(label) {
      const r = Bun.spawnSync(["launchctl", "print", `${domain}/${label}`], { stdout: "pipe", stderr: "ignore" })
      if (r.exitCode !== 0 || !r.stdout) return undefined
      return new TextDecoder().decode(r.stdout)
    },
  }
}


// Probe launchd (macOS only) for an EXTERNAL job that supervises this tg-ctl binary — autostart wired
// outside `tg-ctl enable` (e.g. rig's `ai.hyperide.tg-ctl` LaunchAgent). Returns the supervising
// label, or undefined when none / not macOS / launchctl unavailable. Used by `status` to stop lying
// "NOT enabled" while launchd keeps the daemon alive across reboots (tg-cli#88). Read-only.
//
// Builds a ProbedLaunchdJob per loaded label (its argv + whether it's persistent per the `properties`
// line) from the probe, then hands selection to the PURE selectExternalLaunchdSupervisor (which
// excludes tg-ctl's OWN label, requires the `run` subcommand against THIS binary, and rejects a
// loaded-but-temporary job). `probe` is injectable for tests; defaults to the real launchctl probe.
// Fully wrapped so a launchctl hiccup, a non-macOS host, or a missing binary never crashes `status`.
function detectExternalLaunchdSupervisor(env: AutostartEnv, probe: LaunchctlProbe = realLaunchctlProbe()): string | undefined {
  if (env.platform !== "darwin") return undefined
  if (!env.binPath) return undefined
  try {
    const labels = probe.listLabels()
    if (!labels) return undefined
    const jobs: ProbedLaunchdJob[] = []
    for (const label of labels) {
      if (label === LAUNCHD_LABEL) continue
      const dump = probe.printDump(label)
      if (dump === undefined) continue
      jobs.push({ label, argv: parseLaunchctlPrintArgv(dump), persistent: launchdJobIsPersistent(dump) })
    }
    return selectExternalLaunchdSupervisor(jobs, env.binPath)
  } catch {
    return undefined
  }
}

// Probe launchd for the job that is running THIS bot's daemon right now (tg-cli#316). Unlike
// detectExternalLaunchdSupervisor this includes tg-ctl's own unit, requires a live pid, and matches
// the job's config dir so a test HOME is not reported as ours. Read-only.
//
// Launchd is a LABEL on an already-proven per-bot process (`hintPid` from the pidfile or flock
// holder). It must not invent "running" for a different bot token that shares the config dir
// (review finding). No hint → no launchd claim.
function detectLaunchdDaemon(
  env: AutostartEnv,
  hintPid: number | null,
  probe: LaunchctlProbe = realLaunchctlProbe(),
): { label: string; pid: number } | undefined {
  if (env.platform !== "darwin") return undefined
  if (!env.binPath) return undefined
  if (hintPid === null) return undefined
  try {
    const listed = probe.listJobs()
    if (!listed) return undefined
    const labels = listed.filter((j) => j.pid === hintPid).map((j) => j.label)
    if (labels.length === 0) return undefined
    const jobs: ProbedLaunchdJob[] = []
    for (const label of labels) {
      const dump = probe.printDump(label)
      if (dump === undefined) continue
      jobs.push({
        label,
        argv: parseLaunchctlPrintArgv(dump),
        persistent: launchdJobIsPersistent(dump),
        pid: parseLaunchctlPrintPid(dump),
        configDir: launchdJobConfigDir(parseLaunchctlPrintEnvironment(dump)),
      })
    }
    return selectLaunchdDaemonJob(jobs, env.binPath, env.configDir, defaultConfigDir(env.home))
  } catch {
    return undefined
  }
}


// Pid holding THIS config dir's flock, if any. The flock is the real singleton (spec §6); when
// the pidfile and even the unix socket are gone, the lock holder is still the live daemon.
// Linux reads the kernel's lock table (procFlockHolders); elsewhere lsof -t names a process with
// the file open. Do NOT skip process.pid: Telegram `/status` runs composeStatus inside the daemon,
// so the holder IS us — that is the pid to report (review finding).
function lockHolderPid(lockPath: string): number | null {
  const holders = procFlockHolders(lockPath) ?? lsofOpeners(lockPath)
  return holders?.[0] ?? null
}

// Live pids with THIS lock file open per `lsof -t` — exit 1 with no output means nobody has it
// open. null when lsof cannot answer (missing, or any other failure).
function lsofOpeners(lockPath: string): number[] | null {
  try {
    const r = Bun.spawnSync(["lsof", "-t", lockPath], { stdout: "pipe", stderr: "ignore" })
    const out = r.stdout ? new TextDecoder().decode(r.stdout).trim() : ""
    if (r.exitCode !== 0 && !(r.exitCode === 1 && out === "")) return null
    return out
      .split(/\s+/)
      .map(Number)
      .filter((pid) => pid > 0 && kill0(pid))
  } catch {
    return null
  }
}

// Live pids holding a flock on THIS config dir's lock file, read WITHOUT taking it (tg-cli#490):
// /proc/locks names each flock's pid and inode, and a candidate counts only when one of its open
// fds IS the lock file (same dev + ino through /proc/<pid>/fd), which rules out an inode-number
// twin on another filesystem. A candidate that vanished meanwhile (ENOENT) holds nothing. No lock
// file means no holder. null = no confident answer, callers fall back: not Linux, /proc unreadable,
// or a holder this reader cannot inspect — another user's process (EACCES) or one the kernel
// cannot name here (pid 0) — never reported as "free".
function procFlockHolders(lockPath: string): number[] | null {
  if (process.platform !== "linux") return null
  const isENOENT = (err: unknown) => err instanceof Error && "code" in err && err.code === "ENOENT"
  let lock: BigIntStats
  try {
    lock = statSync(lockPath, { bigint: true })
  } catch (err) {
    return isENOENT(err) ? [] : null
  }
  let table: string
  try {
    table = readFileSync("/proc/locks", "utf8")
  } catch {
    return null
  }
  const holders: number[] = []
  for (const pid of flockPidsForInode(table, lock.ino.toString())) {
    if (pid === 0) return null
    let fds: string[]
    try {
      fds = readdirSync(`/proc/${pid}/fd`)
    } catch (err) {
      if (isENOENT(err)) continue
      return null
    }
    for (const fd of fds) {
      let open: BigIntStats
      try {
        open = statSync(`/proc/${pid}/fd/${fd}`, { bigint: true })
      } catch (err) {
        if (isENOENT(err)) continue
        return null
      }
      if (open.ino === lock.ino && open.dev === lock.dev) {
        holders.push(pid)
        break
      }
    }
  }
  return holders
}

// Does `pid` hold THIS config dir's flock? On Linux a read of the kernel's lock table that never
// contends with a starting daemon. Elsewhere (macOS has no /proc/locks) `pid` must have the file
// open (lsof), and then the only exact "is it held" test is daemonLockFree — taking the lock for an
// instant; runDaemon's DAEMON_LOCK_GRACE_MS keeps that instant from costing a starting daemon its
// run. Without lsof this degrades to "held by anyone".
function daemonLockHeldBy(lockPath: string, pid: number): boolean {
  const holders = procFlockHolders(lockPath)
  if (holders !== null) return holders.includes(pid)
  const openers = lsofOpeners(lockPath)
  if (openers !== null && !openers.includes(pid)) return false
  return !daemonLockFree(lockPath)
}

// flock(2) through bun:ffi — neither Bun nor Node expose it and macOS has no flock(1). The
// library is opened on first use, so CLI subcommands that never touch the lock never dlopen it.
const LOCK_EX_NB = 6 // LOCK_EX (2) | LOCK_NB (4)
const LOCK_UN = 8
let flockSymbol: ((fd: number, op: number) => number) | undefined
function flock(fd: number, op: number): number {
  if (!flockSymbol) {
    const lib = process.platform === "darwin" ? "libSystem.B.dylib" : "libc.so.6"
    flockSymbol = dlopen(lib, { flock: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 } }).symbols.flock
  }
  return flockSymbol(fd, op)
}

// Is THIS config dir's flock free — provably no daemon holds it? Without a kernel lock table
// (daemonLockHeldBy's fallback) taking it for an instant is the only exact test: lsof lists any
// process with the file open, and an exited-but-unreaped child keeps answering kill(0) while the
// kernel has already dropped its lock. A daemon starting in that instant finds the lock taken and
// retries through DAEMON_LOCK_GRACE_MS (tg-cli#490). Read-only open: never creates or truncates the
// lock file; no file means no daemon ever took it. Any other failure (EACCES, fd exhaustion, flock
// unavailable via FFI) is NOT proof of "free" — it answers false, so callers fall back to trusting
// the live pid. TG_CTL_LOCK_PROBE_TEST_HOLD_MS (tests only) stretches the instant so that race is
// reproducible.
function daemonLockFree(lockPath: string): boolean {
  let fd: number
  try {
    fd = openSync(lockPath, "r")
  } catch (err) {
    return err instanceof Error && "code" in err && err.code === "ENOENT"
  }
  try {
    if (flock(fd, LOCK_EX_NB) !== 0) return false
    const holdMs = Number(process.env.TG_CTL_LOCK_PROBE_TEST_HOLD_MS)
    if (holdMs > 0) Bun.sleepSync(holdMs)
    flock(fd, LOCK_UN)
    return true
  } catch {
    return false
  } finally {
    closeSync(fd)
  }
}


// The `autostart:` status line. Gathers the impure facts — own-unit file existence and (only when
// that's absent, to skip the launchctl probe otherwise) the external-launchd-supervisor probe — then
// hands them to the PURE autostartStatusLine for precedence + formatting (own-unit before external).
// Keeps composeStatus slim and isolates the one impure probe behind status logic.
function composeAutostartLine(env: AutostartEnv, kind: AutostartKind): string {
  const ownInstalled = kind !== "none" && autostartUnitInstalled(env)
  // Only probe launchd when the own unit is absent — autostartStatusLine prefers the own unit, so the
  // probe would be wasted work otherwise. The probe itself no-ops off launchd / on non-macOS.
  const external = !ownInstalled && kind === "launchd" ? detectExternalLaunchdSupervisor(env) : undefined
  return autostartStatusLine(kind, ownInstalled, external)
}

// Run one plan command. Returns true on success. An `optional` command that fails is treated as
// success (e.g. `launchctl unload` when nothing was loaded yet). stderr is surfaced on a hard
// failure so the user sees the launchctl/systemctl error.
function runAutostartCommand(cmd: AutostartCommand): boolean {
  try {
    const r = Bun.spawnSync(cmd.argv, { stdout: "ignore", stderr: "pipe" })
    if (r.exitCode === 0) return true
    if (cmd.optional) return true
    const stderr = r.stderr ? new TextDecoder().decode(r.stderr).trim() : ""
    console.error(`tg-ctl: ${cmd.describe} failed (${cmd.argv.join(" ")}): exit ${r.exitCode}${stderr ? ` — ${stderr}` : ""}`)
    return false
  } catch (err) {
    if (cmd.optional) return true
    console.error(`tg-ctl: ${cmd.describe} failed to spawn (${cmd.argv.join(" ")}): ${err}`)
    return false
  }
}

// `tg-ctl enable [--dry-run]` — install OS autostart AND start now. Mirrors the lib's
// ServiceManager.enable single-owner contract:
//   - launchd/systemd OWN the process (RunAtLoad / enable --now), so we stop any background
//     (pidfile) instance first to avoid two daemons fighting over the bot, then install the unit;
//     the activating command's exit code decides whether autostart is actually live.
//   - if the OS control command FAILS (sandbox / missing binary), OR there's no supported OS
//     autostart at all (the 'none' fallback), we fall back to a plain background `start` so the
//     service is still up now, and report that it will NOT survive reboot (enabled=false).
// Idempotent: re-running re-writes the same unit and reloads it. `--dry-run` prints the plan
// (unit path + launchctl/systemctl commands) and touches nothing — the e2e test uses it so it
// never loads a real LaunchAgent. Returns the process exit code.
function enableAutostart(ctx: Ctx, dryRun: boolean): number {
  const env = autostartEnv(ctx)
  const plan = buildEnablePlan(env)
  if (dryRun) {
    console.log(`tg-ctl: [dry-run] autostart kind: ${plan.kind}` + (plan.kind !== "none" ? `, ${autostartUnitLabel(plan.kind)}` : ""))
    if (plan.kind === "none") {
      console.log("tg-ctl: [dry-run] no supported OS autostart — would `tg-ctl start` now (no reboot survival)")
    }
    if (plan.file) console.log(`tg-ctl: [dry-run] would write ${plan.file.path}`)
    for (const cmd of plan.commands) console.log(`tg-ctl: [dry-run] would run: ${cmd.argv.join(" ")}`)
    return 0
  }

  // No supported OS autostart: just background-start now (the lib's NoopAutostartBackend path).
  if (plan.kind === "none") {
    startLauncher(ctx, {})
    console.error("tg-ctl: autostart is not supported on this OS — started now, but it will NOT survive reboot.")
    return 0
  }

  // The OS is about to launch its own copy. Stop any background (pidfile) instance first so we
  // don't end up with two processes on the same bot — the no-double-start invariant.
  if (stopDaemon(ctx).kind === "still-alive") {
    console.error("tg-ctl: enable aborted — the running daemon did not stop; autostart NOT installed over it.")
    return EXIT_AUTOSTART_FAILED
  }

  if (plan.file) {
    try {
      mkdirSync(dirname(plan.file.path), { recursive: true })
      writeFileSync(plan.file.path, plan.file.content, { mode: plan.file.mode })
    } catch (err) {
      console.error(`tg-ctl: writing ${plan.file.path} failed: ${err}`)
      return EXIT_AUTOSTART_FAILED
    }
  }
  // Run all commands; the LAST one is the activating one (`launchctl load` / `enable --now`)
  // whose success means autostart is live (mirrors the lib gating `enabled` on its exit code).
  let activated = true
  for (const cmd of plan.commands) {
    if (!runAutostartCommand(cmd)) activated = false
  }
  if (!activated) {
    // The unit file is on disk but the OS control command failed — autostart is NOT live. Fall
    // back to a background start so the service is at least up now, and report enabled=false.
    console.error(`tg-ctl: ${plan.kind} autostart command failed — falling back to a one-shot start (will NOT survive reboot).`)
    startLauncher(ctx, {})
    return EXIT_AUTOSTART_FAILED
  }
  // Past the kind === "none" early return, a launchd/systemd plan ALWAYS carries a file; narrow
  // explicitly so the success message doesn't lean on a non-null assertion.
  const where = plan.file ? ` at ${plan.file.path}` : ""
  console.log(
    `tg-ctl: autostart enabled — ${plan.kind} (${autostartUnitLabel(plan.kind)})${where}. ` +
      "The daemon starts at login and is running now.",
  )
  return 0
}

// `tg-ctl disable` — remove OS autostart AND stop the running daemon. Mirrors the lib's
// ServiceManager.disable: run the deactivating command (unload / disable --now) and only remove
// the unit file if it succeeded — a still-loaded unit's file is left in place rather than
// orphaning the live OS process. Then stop any background instance too. Idempotent: a missing
// unit is a no-op, not an error. Returns the process exit code (4 if the OS deactivate failed).
function disableAutostart(ctx: Ctx): number {
  const env = autostartEnv(ctx)
  const plan = buildDisablePlan(env)
  let removeFailed = false
  if (plan.filePath && existsSync(plan.filePath)) {
    // The first command is the deactivator (unload / disable --now); it gates file removal.
    const [deactivateCmd, ...postCmds] = plan.commands
    const ok = deactivateCmd ? runAutostartCommand(deactivateCmd) : true
    if (ok) {
      try {
        unlinkSync(plan.filePath)
      } catch (err) {
        console.error(`tg-ctl: removing ${plan.filePath} failed: ${err}`)
        removeFailed = true
      }
      for (const cmd of postCmds) runAutostartCommand(cmd)
    } else {
      // Deactivate failed — leave the file so `status` doesn't lie about the unit being gone.
      console.error(`tg-ctl: ${plan.kind} deactivate failed — leaving the unit file in place (the OS may still be running it).`)
      removeFailed = true
    }
  }
  // disable also stops the manager-spawned (background) instance. On launchd/systemd the unload/
  // disable above already stopped the OS-owned copy; this is the catch-all for a pidfile instance.
  const stopped = stopDaemon(ctx)
  if (stopped.kind === "still-alive") {
    console.error(`tg-ctl: disable incomplete — pid ${stopped.pid} is still running.`)
    return EXIT_AUTOSTART_FAILED
  }
  if (removeFailed) return EXIT_AUTOSTART_FAILED
  // On the 'none' fallback there was never an OS unit — say what actually happened (stopped the
  // background instance) rather than the misleading "autostart disabled (none)".
  console.log(
    plan.kind === "none"
      ? "tg-ctl: no OS autostart to remove — stopped the background instance."
      : `tg-ctl: autostart disabled (${plan.kind}).`,
  )
  return 0
}

// --- /spend scheduled push (end-of-week / end-of-month) ---

function usageScheduleWatermarkPath(ctx: Ctx): string {
  return ctlPaths(ctx.configDir, botIdFromToken(ctx.token) || "unknown").usageSchedule
}

function usageScheduleEnv(ctx: Ctx): UsageScheduleEnv {
  return {
    home: ctx.home,
    binPath: resolveDeployedBin(ctx.home),
    bunPath: process.execPath,
    logPath: ctx.paths.log,
    configDir: ctx.configDir,
    // Captured from the enabling shell — launchd's own PATH won't include wherever
    // `tg`/`rig` live (see usageScheduleUnitEnv's comment in usage-schedule.ts).
    pathEnv: process.env.PATH ?? '',
  }
}

// `tg-ctl usage-schedule enable [--dry-run]` — install the launchd job that fires
// `usage-schedule-check` daily at 23:50; `--dry-run` prints the plan and touches nothing
// (mirrors enableAutostart's own --dry-run contract). launchd (macOS) only — see
// usage-schedule.ts's SCOPE note.
// Seeded ONLY on a truly first enable (no watermark file yet) so the FIRST scheduled check
// never claims a period was "missed while the machine was asleep" — nothing was scheduled
// yet, so nothing could have been missed. `enable` is also a supported RE-run (retry a
// half-failed load, re-pin PATH after moving `tg`/`rig`) — an unconditional reseed there
// would silently overwrite a real pending/failed period with "already reported" and swallow
// it with neither a report nor a missed notice (review finding, converged on by two
// independent reviewers). An existing watermark — even an all-null one written by a prior
// enable — is therefore left untouched; only a genuinely absent file gets seeded.
function seedUsageScheduleWatermark(watermarkPath: string, now: Date): void {
  if (!shouldSeedUsageScheduleWatermark(readFileOrNull(watermarkPath))) return
  const seed = seedUsageScheduleWatermarkFor(now)
  try {
    atomicWrite(watermarkPath, `${JSON.stringify(seed)}\n`)
  } catch (err) {
    console.error(`tg-ctl: usage-schedule: seeding the watermark failed (a false "missed" notice may fire once): ${err}`)
  }
}

function enableUsageSchedule(ctx: Ctx, dryRun: boolean): number {
  if (process.platform !== "darwin") {
    console.error("tg-ctl: usage-schedule is only implemented for launchd (macOS) — not supported on this OS.")
    return EXIT_AUTOSTART_FAILED
  }
  const env = usageScheduleEnv(ctx)
  const plan = buildUsageScheduleEnablePlan(env)
  if (dryRun) {
    console.log(`tg-ctl: [dry-run] usage-schedule label: ${USAGE_SCHEDULE_LAUNCHD_LABEL}`)
    console.log(`tg-ctl: [dry-run] would write ${plan.file.path}`)
    for (const cmd of plan.commands) console.log(`tg-ctl: [dry-run] would run: ${cmd.argv.join(" ")}`)
    return 0
  }
  try {
    mkdirSync(dirname(plan.file.path), { recursive: true })
    writeFileSync(plan.file.path, plan.file.content, { mode: plan.file.mode })
  } catch (err) {
    console.error(`tg-ctl: writing ${plan.file.path} failed: ${err}`)
    return EXIT_AUTOSTART_FAILED
  }
  seedUsageScheduleWatermark(usageScheduleWatermarkPath(ctx), new Date())
  let activated = true
  for (const cmd of plan.commands) {
    if (!runAutostartCommand(cmd)) activated = false
  }
  if (!activated) {
    console.error("tg-ctl: usage-schedule launchctl command failed — the unit file is on disk but not loaded.")
    return EXIT_AUTOSTART_FAILED
  }
  console.log(`tg-ctl: usage-schedule enabled — ${USAGE_SCHEDULE_LAUNCHD_LABEL} at ${plan.file.path}. Checks daily at 23:50, sends one report per completed week and month (a day missed while asleep is reported as missed, not skipped).`)
  return 0
}

function disableUsageSchedule(ctx: Ctx): number {
  if (process.platform !== "darwin") {
    console.log("tg-ctl: usage-schedule was never installed on this OS — nothing to remove.")
    return 0
  }
  const plan = buildUsageScheduleDisablePlan(ctx.home)
  // The watermark is cleared on EVERY disable call that reaches this function — including
  // the "already gone" early-return paths below — not just the branch that actually
  // unloads/removes a plist. A re-disable after a partial failure, or a disable after the
  // plist was already removed by hand, is still an intentional "stop watching" the user
  // asked for; leaving the watermark behind in either case would make a LATER re-enable
  // (which only reseeds an ABSENT file, see shouldSeedUsageScheduleWatermark) see it as
  // present and skip reseeding, then fire a false "machine was asleep" notice for the whole
  // disabled window — the exact bug an earlier fix (review MEDIUM finding) closed for the
  // plist-present path but left open here (review HIGH finding: the early returns below
  // used to skip this cleanup entirely).
  const clearWatermark = () =>
    unlinkGuarded(usageScheduleWatermarkPath(ctx), "tg-ctl: usage-schedule: removing the watermark failed (harmless — a stale one only delays the next reseed)")
  if (!existsSync(plan.filePath)) {
    clearWatermark()
    console.log("tg-ctl: usage-schedule is not installed — nothing to remove.")
    return 0
  }
  const ok = runAutostartCommand(plan.commands[0])
  if (!ok) {
    console.error("tg-ctl: usage-schedule deactivate failed — leaving the unit file in place.")
    return EXIT_AUTOSTART_FAILED
  }
  try {
    unlinkSync(plan.filePath)
  } catch (err) {
    console.error(`tg-ctl: removing ${plan.filePath} failed: ${err}`)
    return EXIT_AUTOSTART_FAILED
  }
  clearWatermark()
  console.log("tg-ctl: usage-schedule disabled.")
  return 0
}

function writeUsageScheduleWatermark(path: string, watermark: UsageScheduleWatermark): void {
  atomicWrite(path, `${JSON.stringify(watermark)}\n`)
}

// Send one scheduled report through the `tg` CLI. The report body is plain text built
// from `rig usage --json` data (model names, the disclaimer) but `--format html` parses
// it as HTML — `rig usage` really does emit a "<synthetic>" model name, and Telegram
// rejects an unescaped stray "<" — so the body is escaped right here, at the HTML
// boundary (the interactive /spend reply goes out as plain text and must NOT be escaped).
// No splitting here: the `tg` CLI's own transmitter 4096-splits a non-rich HTML body
// (features/auto-attach/transmitter.ts), unlike the daemon's direct Bot API sends.
async function sendScheduledUsageReport(title: string, body: string): Promise<boolean> {
  const r = await spawnGuarded(["tg", "--format", "html", "--automated", "--tag", "report", "--title", title, escapeHtml(body)], 30_000)
  if (r.exitCode === 0) return true
  console.error(`tg-ctl: usage-schedule: sending "${title}" failed (exit ${r.exitCode}): ${r.stderr.trim() || "no error output"}`)
  return false
}

// What the scheduled check sends for one due period: the real report when the check runs
// ON the boundary day (`rig usage --period X` covers exactly the completing period), an
// explicit missed-report notice when it runs late (rig can only report the CURRENT
// period — see usage-schedule.ts's LIMIT note), or nothing (`null`, period stays due)
// when rig itself failed: an error blurb delivered "successfully" must never advance the
// watermark, or a transient rig failure on the boundary day consumes the period for good.
async function scheduledUsageBody(due: UsageScheduleDuePeriod): Promise<string | null> {
  if (!due.onTime) return missedUsageReportNotice(due)
  const report = await composeUsageReport(due.period)
  if (report.ok) return due.hasGap ? `${report.text}\n\n${usageScheduleGapNote(due.period)}` : report.text
  console.error(`tg-ctl: usage-schedule: "${due.title}" (period ${due.id}) not generated, left due for the next check: ${report.text}`)
  return null
}

// The job the installed launchd unit actually invokes once a day. A no-op unless a
// week/month report is DUE per the persisted watermark (usage-schedule.ts's
// usageSchedulePeriodsDue; both can be due the same day — both are handled). A period
// whose compose or send fails stays due, so the next daily check retries it instead of
// silently losing it. Dry-run (TG_USAGE_SCHEDULE_DRY_RUN=1 in the PROCESS env — not the
// merged .env, so a line left in the config file can't turn the schedule into a permanent
// no-op — or --dry-run) logs what WOULD be sent and never advances the watermark, so a
// manual smoke check neither pushes a message nor masks a pending real report.
async function runUsageScheduleCheck(now: Date, dryRun: boolean, watermarkPath: string): Promise<number> {
  const watermark = parseUsageScheduleWatermark(readFileOrNull(watermarkPath))
  const due = usageSchedulePeriodsDue(now, watermark)
  if (due.length === 0) return 0
  let next = watermark
  for (const item of due) {
    const body = await scheduledUsageBody(item)
    if (body === null) continue
    if (dryRun) {
      console.log(`tg-ctl: [dry-run] would send "${item.title}" (period ${item.id}${item.onTime ? "" : ", LATE"}): ${body.slice(0, 200)}${body.length > 200 ? "…" : ""}`)
      continue
    }
    if (!(await sendScheduledUsageReport(item.title, body))) continue
    next = item.period === "week" ? { ...next, lastWeekReported: item.id } : { ...next, lastMonthReported: item.id }
    // Persisted right after EACH successful send (not once after the whole loop) — a crash
    // between send and write would otherwise leave a delivered report looking "NOT
    // generated" to the next check (review LOW finding).
    try {
      writeUsageScheduleWatermark(watermarkPath, next)
    } catch (err) {
      console.error(`tg-ctl: usage-schedule: sent "${item.title}" but FAILED to persist the watermark — it may be reported as missed again tomorrow: ${err}`)
    }
  }
  return 0
}

// --- hook/client handoff over a local Unix socket ---

const MAX_HOOK_REQUEST_BYTES = 64 * 1024

// How long an UNSCOPED forwarded question (paneId undefined — the hook ran
// without TMUX_PANE) may stay open before it self-clears to "expired — answer in
// terminal". This bound exists ONLY for the unscoped case, because an unscoped
// question defers inbound for ALL panes (paneHasPendingQuestion's fail-closed
// `if (!pb.req.paneId) return true`); without the bound it would wedge every
// pane's routing forever. A SCOPED question gets NO timer and waits indefinitely
// for its Telegram answer or socket close — that is safe (the timer is armed only
// for the `!req.paneId` branch in handleHookSocketLine). Overridable via env only
// so the integration tests can exercise the expiry without a real 110s wait;
// production never sets it.
const UNSCOPED_ABANDON_MS = (() => {
  const raw = Number(process.env.TG_CTL_UNSCOPED_TIMEOUT_MS)
  // setTimeout clamps any delay > 2^31-1 ms to ~1ms in Node/Bun, which would
  // flip a huge "wait longer" override into "expire instantly" — the opposite of
  // intent. Clamp to TIMEOUT_MAX so an oversized value still means "a long wait".
  // A non-positive / non-numeric / absent value (incl. 0) falls back to the 110s
  // default — 0 is NOT "expire instantly" (the bound is a backstop, never zero).
  const TIMEOUT_MAX = 2_147_483_647
  return Number.isFinite(raw) && raw > 0 ? Math.min(raw, TIMEOUT_MAX) : 110_000
})()

interface PendingButton {
  req: ButtonRequest
  socket: Socket
  messageId: number | null
  // ms epoch when this entry was created (or revived). Persisted so the durable file
  // can be ordered by recency, and shown as the card's age in its 📥 Inbox copy.
  at: number
  // Only a SCOPED-less (unscoped) question arms an abandon timer; a scoped
  // question waits forever, so its timer is undefined. clearTimeout(undefined)
  // is a safe no-op, so every clearTimeout(entry.timer) call site is correct
  // whether or not the timer was armed.
  timer?: ReturnType<typeof setTimeout>
  finalText?: string
  finalReplyMarkup?: ButtonMessagePayload["reply_markup"]
}

// A SCOPED question whose hook socket has CLOSED — the agent's 120s hook budget
// elapsed (it fell back to the terminal AskUserQuestion prompt) OR the daemon
// restarted and restored it from disk. Its answer can STILL reach the pane it asked
// from, so we retain {paneId, options, card id} keyed by callbackRequestId. A LATER
// Telegram tap injects the chosen option into that pane (late-delivery), and a
// reconnecting hook with the SAME requestId re-attaches to this card instead of
// posting a duplicate (lossless restart). Unlike a PendingButton it holds NO live
// socket and — crucially — is NOT in `pendingButtons`, so it never defers the pane's
// inbound (the agent moved on / is blocked on its own reconnect).
interface AbandonedButton {
  req: ButtonRequest
  messageId: number | null
  at: number
  // A PERMISSION decision the user already tapped while the hook was disconnected
  // (queued because, unlike a question, a permission has no pane-text-injection
  // fallback — the hook needs a structured JSON reply, not terminal text). Never
  // silently dropped: this is delivered down the socket the instant a reconnecting
  // hook re-attaches to the same requestId AND its payload still matches
  // (permissionPayloadMatches — the RECONNECT re-attach branch in
  // handleHookSocketLine). PERSISTED: `persistQuestions` writes it and the restore
  // path re-reads it (see question-store.ts's RetainedQuestionRecord.queuedDecision),
  // and it is persisted IMMEDIATELY on tap (not only on the next unrelated
  // mutation) — a daemon crash between the tap and the reconnect must not lose the
  // human's decision while the card still claims it is "delivered automatically"
  // (PERM QUEUE RESTART proves this). The card stays visibly "queued" until actually
  // delivered so a re-tap (last tap wins) or a terminal answer both stay available.
  // `decision` is REQUIRED — see question-store.ts's matching RetainedQuestionRecord
  // field for why (review finding: the two types must agree).
  // `notifiedAt`: when the ONE-TIME "still waiting to reconnect" notice
  // (noticeStaleQueuedDecisions, QUEUED_DECISION_NOTICE_MS) fired for this queued
  // tap — undefined until it does. Persisted so a daemon restart doesn't re-fire
  // the notice for an entry that already got one (would read as spam / a false
  // "still no connection" repeat right after a bounce).
  queuedDecision?: { value: string; label: string; decision: PermissionDecision; at: number; notifiedAt?: number }
}

// Shared by permissionRequestIdForMessage's lookups (PendingButton, AbandonedButton
// and the grace store's GraceRecord have compatible {req, messageId} shapes) — a
// single copy of the "is this the one decidable permission card at this message_id"
// predicate instead of independently-written loops that could silently drift apart
// if the definition of "decidable" ever changes (review finding).
function findDecidablePermissionRequestId(
  entries: Iterable<[string, { req: ButtonRequest; messageId: number | null }]>,
  messageId: number,
): string | null {
  for (const [requestId, entry] of entries) {
    if (entry.messageId === messageId && entry.req.kind === "permission" && !entry.req.multiQuestion) return requestId
  }
  return null
}

// A question that has already been ANSWERED, kept briefly so a re-forward of the
// SAME requestId (a stable hash of session + question text) replays the stored
// answer instead of posting a fresh card. The in-flight dedup (`activeButtonKeys`)
// is released the instant a question is answered, so without this an
// AskUserQuestion that re-fires AFTER its answer would post a second, superseded
// card whose tap reads as "expired" (tg-cli#97). Keyed by `callbackRequestId`.
interface AnsweredButton {
  value: string
  label: string
  decision?: PermissionDecision
  at: number
  // How the answer reached the agent: `socket` (down the hook socket → a re-fire
  // REPLAYS it, #98) or `pane` (late-delivered by pane injection → a reconnecting
  // hook must NOT also replay it, or the agent gets it twice). Defaults to socket.
  delivery: "socket" | "pane"
}

// How long an answered request stays replayable. The re-fire that motivated this
// arrived ~37s after the answer; 5 min is a generous bound that still lets a
// genuinely NEW question reusing the same hash (the human re-asks much later) post
// a fresh card rather than silently replaying a stale answer. Overridable via env
// only so the integration tests can exercise the past-window expiry without a real
// 5-minute wait; production never sets it. Unlike UNSCOPED_ABANDON_MS this is only
// ever compared against (now - answeredAt), never used as a setTimeout delay, so no
// overflow clamp is needed. A non-positive / non-numeric / absent value falls back
// to the 5-minute default.
const ANSWERED_REPLAY_MS = (() => {
  const raw = Number(process.env.TG_CTL_ANSWERED_REPLAY_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 5 * 60_000
})()

// Drop answered entries past the replay window. Called whenever a NEW answer is
// recorded, so the cache stays bounded to ~the questions answered in the last
// window instead of growing for the daemon's whole lifetime (most requestIds are
// unique and never re-forwarded, so access-time pruning alone would leak).
function pruneAnsweredButtons(answered: Map<string, AnsweredButton>, now: number): void {
  for (const [key, entry] of answered) {
    if (now - entry.at > ANSWERED_REPLAY_MS) answered.delete(key)
  }
}

// Grant protocol v1.1 windows (tg-cli#398): how long an EXPIRED hatch ask stays
// addressable for a late Approve tap (grace), and how long a minted grant stays
// consumable (grant TTL). Both default 24h; env-overridable so integration
// tests can expire a grant/grace without a real 24h wait — production never
// sets them. These are security windows, not question retention: an open card
// stays open until a relevance signal closes it (tg-cli#705).
const GRACE_WINDOW_MS = (() => {
  const raw = Number(process.env.TG_CTL_GRACE_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 24 * 60 * 60_000
})()
const GRANT_TTL_MS = (() => {
  const raw = Number(process.env.TG_CTL_GRANT_TTL_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 24 * 60 * 60_000
})()
// How long a NON-critical ask can wait on its socket at most: its timeoutMs is clamped to
// ASK_TIMEOUT_MAX_MS, and the unscoped backstop retires it by then. A restored record still
// marked pending but older than this is a stale copy (a lost questions write after the
// card was answered), so its grace window is anchored no later than this past posting.
const ASK_LIVE_MAX_MS = Math.max(ASK_TIMEOUT_MAX_MS, UNSCOPED_ABANDON_MS)
// How long a decided card's record (grants.ts DecidedCard) is kept: past the latest grace
// window a stale questions-store copy of the card could still open — anchored at most
// ASK_LIVE_MAX_MS after posting, and the decision comes no earlier than the posting. A
// critical ask has no such bound (its restart anchor is the restart itself), so its record
// is kept while a copy of the card is on disk (null; grants.ts dropSettledDecided).
const DECIDED_RETAIN_MS = GRACE_WINDOW_MS + ASK_LIVE_MAX_MS
const decidedRetainMs = (req: ButtonRequest): number | null => (req.critical ? null : DECIDED_RETAIN_MS)

// PURE decision for what a hook reconnect should do about a retained entry's
// QUEUED permission decision — extracted from handleHookSocketLine so the
// branch is unit-testable with no daemon and no timing race. Order matters:
// one function, one return value, one caller switch. There is no expiry
// outcome (tg-cli#705): a queued decision stays deliverable until a relevance
// signal closes its card.
export type QueuedPermissionReconnectOutcome =
  | { kind: "no-queued-decision" }
  | { kind: "no-turn-proof" }
  | { kind: "turn-mismatch" }
  | { kind: "payload-mismatch" }
  | { kind: "deliver"; queuedDecision: NonNullable<AbandonedButton["queuedDecision"]> }
export function decideQueuedPermissionReconnect(
  retained: Pick<AbandonedButton, "req" | "queuedDecision">,
  req: ButtonRequest,
): QueuedPermissionReconnectOutcome {
  if (!retained.queuedDecision) return { kind: "no-queued-decision" }
  if (!queuedDecisionCanAutoDeliver(retained.req)) return { kind: "no-turn-proof" }
  if (retained.req.promptTurnId !== req.promptTurnId) return { kind: "turn-mismatch" }
  if (!permissionPayloadMatches(retained.req, req)) return { kind: "payload-mismatch" }
  return { kind: "deliver", queuedDecision: retained.queuedDecision }
}

// REMOVED (tg-cli#398, grant protocol v1.1): findQueuedHatchDecision and the
// handleHookSocketLine hatch short-circuit it fed. That mechanism authorized
// ANY later operation behind the same hookId — exactly the over-broad silent
// approval v1.1 forbids. A late Approve now mints a single-use,
// operation-bound grant (grants.ts) and a plain retry WITHOUT a grant simply
// posts a FRESH card (or consumes an outstanding grant via --verify-grant
// --pull, route-bound).

// How long a QUEUED permission decision can wait with no reconnect before the
// human gets a PROACTIVE "still waiting to reconnect" notice — a NOTICE
// threshold, not an expiry (Alex tg#9982: a queued tap must never be silently
// dropped/demoted on a timer). Past it the queue is NOT cleared and stays fully
// eligible for automatic delivery (decideQueuedPermissionReconnect).
//
// The identity check that makes delivery safe WITHIN that window lives
// upstream, in hook-normalize.ts's `invocationSeed`: requestId is now scoped to the prompt
// TURN (Claude Code's `prompt_id`, Codex's `turn_id`), not just the session, so
// a materially later, only-coincidentally-identical-looking request (the agent
// re-running the same command in a NEW turn) gets a fresh requestId and can
// never satisfy the reconnect branch's exact-requestId gate in the first
// place — permissionPayloadMatches (full toolInput/agent/pane/event/question
// equality) is defense-in-depth on top of that for the residual, much narrower
// risk of a lossy `summarizeInput` digest collision, not a time bound.
// Env-overridable for tests; production never sets it.
const QUEUED_DECISION_NOTICE_MS = (() => {
  const raw = Number(process.env.TG_CTL_QUEUED_DECISION_NOTICE_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 10 * 60_000
})()

// Exported for tests (same pattern as decideQueuedPermissionReconnect above):
// the AUTHORITATIVE socket/disk validator is the boundary the grant protocol's
// additive fields (tg-cli#398) must survive, so tests/ctl-grants.test.ts pins
// its tolerance contract directly instead of through a daemon round-trip.
export function normalizeButtonRequest(value: unknown): ButtonRequest | null {
  if (!value || typeof value !== "object") return null
  const rec = value as Record<string, unknown>
  const requestId = typeof rec.requestId === "string" && rec.requestId ? rec.requestId : null
  const agent = typeof rec.agent === "string" ? rec.agent : null
  const kind = rec.kind === "question" || rec.kind === "permission" ? rec.kind : null
  const question = typeof rec.question === "string" && rec.question ? rec.question : null
  if (!requestId || !agent || !kind || !question) return null
  const options = Array.isArray(rec.options)
    ? rec.options
        .filter((o): o is Record<string, unknown> => Boolean(o) && typeof o === "object")
        .map((o) => {
          const label = typeof o.label === "string" ? o.label : ""
          const description = typeof o.description === "string" ? o.description : undefined
          return label ? (description ? { label, description } : { label }) : null
        })
        .filter((o): o is { label: string; description?: string } => o !== null)
    : undefined

  // Custom allow/deny button wording (plan-approval → Proceed/Keep planning).
  // Both labels must be present + non-empty strings, else fall back to the
  // default Approve/Reject by leaving it undefined.
  const dl = rec.decisionLabels
  const decisionLabels =
    dl && typeof dl === "object" &&
    typeof (dl as Record<string, unknown>).allow === "string" && (dl as Record<string, unknown>).allow &&
    typeof (dl as Record<string, unknown>).deny === "string" && (dl as Record<string, unknown>).deny
      ? { allow: (dl as Record<string, string>).allow, deny: (dl as Record<string, string>).deny }
      : undefined
  // Which Claude hook event fired — decides the reply shape (PreToolUse →
  // permissionDecision; PermissionRequest → decision.behavior). Default
  // PermissionRequest preserves the pre-existing reply for older payloads.
  const permissionEvent = rec.permissionEvent === "PreToolUse" ? "PreToolUse" : undefined
  // The original tool_input MUST survive the socket boundary: a PreToolUse
  // ALLOW (ExitPlanMode Proceed, claude question) echoes it as `updatedInput`,
  // and the live hooks docs say "allow alone is not sufficient" for the
  // user-interactive tools — dropping it here silently downgraded the reply to
  // a bare allow (tg#5741 review finding).
  const toolInput =
    rec.toolInput && typeof rec.toolInput === "object" && !Array.isArray(rec.toolInput)
      ? (rec.toolInput as Record<string, unknown>)
      : undefined

  return {
    requestId,
    buttonId: typeof rec.buttonId === "string" ? rec.buttonId : undefined,
    paneId: typeof rec.paneId === "string" ? rec.paneId : undefined,
    cwd: typeof rec.cwd === "string" ? rec.cwd : undefined,
    sessionName: typeof rec.sessionName === "string" ? rec.sessionName : undefined,
    windowName: typeof rec.windowName === "string" ? rec.windowName : undefined,
    subagent: typeof rec.subagent === "string" ? rec.subagent : undefined,
    agent: agent as ButtonRequest["agent"],
    kind,
    question,
    title: typeof rec.title === "string" ? rec.title : undefined,
    options,
    decisionLabels,
    permissionEvent,
    toolInput,
    // Set-member marker: a multi-question sub-answer must never late-deliver
    // into the pane (all-or-nothing — see ButtonRequest.multiQuestion). Parsed
    // here so it survives BOTH the socket boundary and the disk restore.
    multiQuestion: rec.multiQuestion === true ? true : undefined,
    // The per-turn identity proof (see ButtonRequest.promptTurnId) MUST survive
    // BOTH the socket boundary and the disk restore — it's what the reconnect
    // branch requires before auto-delivering a queued permission decision
    // (handleHookSocketLine, tg-cli#182). Dropping
    // it here would silently
    // degrade every restored/reconnected request to the untrusted case.
    promptTurnId: typeof rec.promptTurnId === "string" ? rec.promptTurnId : undefined,
    // tg-cli#403 / agent-tools#754: MUST survive BOTH the socket boundary and
    // the disk restore — it's what gates askDaemon's Infinity deadline and
    // forwardAndPostQuestion's UNSCOPED_ABANDON_MS skip. This is the
    // SERVER-side (daemon socket) parse; the CLIENT-side counterpart lives in
    // hook-normalize.ts's normalizeHookPayload "already normalized" branch.
    critical: rec.critical === true ? true : undefined,
    // Grant protocol v1.1 additive fields (tg-cli#398) — the AUTHORITATIVE
    // socket/disk validator carries them tolerantly: unknown or malformed
    // subfields are dropped, never a rejection, so an old lib ↔ new daemon
    // (or vice versa) keep interoperating. `operation` is OPAQUE (the lib
    // computes the fingerprint; this daemon only compares it, grants.ts).
    hookId: typeof rec.hookId === "string" && rec.hookId ? rec.hookId : undefined,
    timeoutMs:
      typeof rec.timeoutMs === "number" && Number.isFinite(rec.timeoutMs) && rec.timeoutMs > 0 ? rec.timeoutMs : undefined,
    origin: readAskAdditiveOrigin(rec.origin),
    operation: readAskAdditiveOperation(rec.operation),
    sessionPin: typeof rec.sessionPin === "string" && rec.sessionPin ? rec.sessionPin.slice(0, 128) : undefined,
    // Daemon-stamped at arrival (handleHookSocketLine overwrites whatever a
    // client sent); read back here so it survives the disk restore.
    sessionKey: typeof rec.sessionKey === "string" && rec.sessionKey ? rec.sessionKey : undefined,
    asker: parseAskerIdentity(rec.asker),
  }
}

// Subfield-tolerant readers for the v1.1 additive fields (tg-cli#398) — same
// tolerance contract as hook-normalize.ts's readAskOrigin/readAskOperation,
// duplicated at the authoritative boundary on purpose: the daemon MUST NOT
// trust the client side's normalization for a socket/disk payload.
function readAskAdditiveOrigin(raw: unknown): ButtonRequest["origin"] {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return undefined
  const rec = raw as Record<string, unknown>
  const out: NonNullable<ButtonRequest["origin"]> = {}
  if (typeof rec.agent === "string" && rec.agent) out.agent = rec.agent
  if (typeof rec.sessionId === "string" && rec.sessionId) out.sessionId = rec.sessionId
  if (typeof rec.subagent === "string" && rec.subagent) out.subagent = rec.subagent
  return Object.keys(out).length ? out : undefined
}
function readAskAdditiveOperation(raw: unknown): ButtonRequest["operation"] {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return undefined
  const rec = raw as Record<string, unknown>
  const out: NonNullable<ButtonRequest["operation"]> = {}
  if (typeof rec.kind === "string" && rec.kind) out.kind = rec.kind
  if (typeof rec.fingerprint === "string" && rec.fingerprint) out.fingerprint = rec.fingerprint
  if (typeof rec.cwd === "string" && rec.cwd) out.cwd = rec.cwd
  if (typeof rec.repoRoot === "string" && rec.repoRoot) out.repoRoot = rec.repoRoot
  return Object.keys(out).length ? out : undefined
}

function canForwardButtonRequest(req: ButtonRequest): boolean {
  if (questionCapability(req.agent) !== "buttons") return false
  return !(req.agent === "codex" && req.kind !== "permission")
}

function hookMatchesRegistration(regs: Registration[], req: ButtonRequest): boolean {
  return registrationSetAllowsHook(regs, req, resolve)
}

// One-line, greppable descriptors for the ask-forward log. They identify which
// question arrived and which registration it was matched against, so a silent
// non-forward (the question stays in the harness) becomes a visible log line
// stating exactly why it was dropped — never a bare socket.end("null").
function describeAskRequest(req: ButtonRequest): string {
  return `agent=${req.agent} kind=${req.kind} req=${req.requestId} subagent=${req.subagent ?? "-"} window=${req.windowName ?? "-"} pane=${req.paneId ?? "-"} cwd=${req.cwd ?? "-"} session=${req.sessionName ?? "-"}`
}

// An interim STATUS line the daemon writes to the hook socket BEFORE its final reply
// (tg-cli#317). The final reply is unchanged (`null\n` or `<json>\n`), so a client that
// predates this still works; a client that reads status lines can tell a card that was
// POSTED and then expired from a request DROPPED at the door. Those two used to be one
// bare `null`, and the asking side reported a card the human could see in Telegram as
// "not-posted … daemon declined or unreachable" (messageId=14880, 2026-09-05).
type AskStatusLine =
  | { tgctl: "ask-status"; state: "posted"; messageId: number }
  | { tgctl: "ask-status"; state: "dropped"; reason: string }
  | { tgctl: "ask-status"; state: "expired"; messageId: number | null; ageMs: number }

function writeAskStatus(socket: Socket, status: AskStatusLine): void {
  if (socket.destroyed || socket.writableEnded) return
  socket.write(`${JSON.stringify(status)}\n`)
}

// Decline a forward: the reason travels down the socket as a status line, then the
// unchanged `null` reply. Every drop branch names its reason here AND in the daemon log.
function dropAsk(socket: Socket, reason: string): void {
  writeAskStatus(socket, { tgctl: "ask-status", state: "dropped", reason })
  socket.end("null\n")
}

function describeRegistration(regs: Registration[]): string {
  if (regs.length === 0) return "none"
  return regs
    .map((reg) => `pane=${reg.paneId ?? "-"} cwd=${reg.cwd ?? "-"} session=${reg.sessionName ?? "-"}`)
    .join(" | ")
}

function describeHookLine(line: string): string {
  const one = line.replace(/\s+/g, " ").trim()
  return one.length > 120 ? `${one.slice(0, 120)}…` : one
}

// The in-memory + durable state for forwarded questions, threaded through the hook
// socket handlers. Bundled into one struct so the handlers (and their helpers) take
// a single param instead of a long positional list, and so the durable `persist`
// callback travels with the maps it serializes.
interface QuestionRuntime {
  pending: Map<string, PendingButton>
  activeKeys: Set<string>
  // Socket-closed SCOPED questions retained for late-delivery + reconnect. NEVER in
  // `pending`, so an abandoned question never defers its pane's inbound.
  abandoned: Map<string, AbandonedButton>
  // Answered-request replay cache (tg-cli#97): a re-forward of an already-answered
  // requestId replays the stored answer down the socket and posts NO second card.
  answered: Map<string, AnsweredButton>
  // Persist the durable question state after any mutation (atomic write). A restored
  // daemon late-delivers a late tap and re-attaches a reconnecting hook.
  persist: () => void
  // Release a pane's deferred backlog when its question goes away without an inline
  // answer (timeout / socket close / send failure). Idle panes flush immediately;
  // panes with another live question keep their queue for that question's answer.
  onRelease: (paneId: string) => void
  // A scoped question's hook socket closed, so the harness may have fallen back to
  // the terminal prompt. The Telegram card remains answerable by reply-text, and
  // queued inbound is allowed to flush into the pane instead of requiring a resend.
  onTerminalFallback: (paneId: string) => void
  // Same, for an UNSCOPED question (no paneId): sweep every pane that still holds
  // a backlog. Must run AFTER the entry is deleted from `pending` so the per-pane
  // guard sees the real post-removal state.
  onUnscopedRelease: () => void
  // Grant protocol v1.1 (tg-cli#398): the daemon-owned grant + grace store
  // (in-memory mirror of the 0600 file at paths.grants; grants.ts). The daemon
  // is the ONLY authority — clients never touch this file.
  grants: GrantStoreData
  // Persist the grant store (atomic 0600 write). FAIL-CLOSED, unlike the
  // best-effort question persist: returns false on write failure, and every
  // grant mutation (mint/consume) MUST roll its in-memory change back and
  // deny/report rather than confirm a grant that a restart would replay or
  // lose.
  persistGrants: () => boolean
  // A hatch permission ask EXPIRED (retired from `pending`, both paths —
  // the unscoped backstop timer and the hook socket close): upsert its grace
  // record so a late tap within GRACE_WINDOW_MS stays addressable.
  onHatchExpired: (entry: PendingButton, pendingKey: string) => void
  // tg-cli#705: close an open card (pending or retained) on a relevance signal — a newer hatch
  // request, a decision on a sibling, an explicit withdraw. Ends a live asker's socket with a
  // `null` reply, edits the card to `status`, and the Inbox drops its copy. False when `key`
  // names no open card.
  closeCard: (key: string, status: string) => boolean
  // Every card not yet delivered, a retained one with a queued decision included — what a
  // newer hatch request or a sibling's decision closes.
  closableCards: () => OpenCard[]
  // tg-cli#717: post a card with no session topic INTO the 📥 Inbox (with a notification),
  // recorded as its own Inbox entry so no second copy is posted. null when topics are off or
  // the Inbox is unavailable — the caller then posts to General.
  postCardToInbox: (req: ButtonRequest, key: string) => Promise<{ messageId: number; threadId: number } | null>
}

// A genuinely dead card: an UNSCOPED question (no pane to late-deliver to) that
// timed out, or a send-failed forward. Its keyboard is cleared so it can't be tapped.
const EXPIRED_TERMINAL_TEXT = "expired — answer in terminal"
// abandonedPermissionText / abandonedMultiText (features/tg-ctl/questions.ts) cover
// a SCOPED permission or multi-question SET MEMBER whose hook socket closed (daemon
// restart mid-block, or the hook's 120s budget elapsed): the keyboard stays live so
// the user can tap once the agent reconnects, and the reconnect re-attach delivers
// the answer down the new socket. A multi-question set member additionally can't be
// late-delivered (the local dialog may be on a DIFFERENT question of the set — see
// ButtonRequest.multiQuestion), so its text points at the terminal instead. Both are
// built at the call site with the pane's resolved label (resolveSessionName primary) so
// the card identifies WHICH agent disconnected instead of a bare, unidentifiable
// message — and phrased as a transient reconnect, not agent death (tg-cli UX fix).

// Whether two permission ButtonRequests represent the SAME approved action —
// the guard a queued decision must pass before it is auto-delivered to a
// reconnecting hook (see handleHookSocketLine). Compares both the displayed
// question text AND the raw toolInput: the text alone is not enough, since
// toolInput can carry content (an edit's diff, a write's body, structured args)
// the question string never shows.
function permissionPayloadMatches(a: ButtonRequest, b: ButtonRequest): boolean {
  // `a` (the retained request) is always a permission — only a permission ever
  // carries a queuedDecision (see AbandonedButton.queuedDecision). `b` (the
  // reconnecting request) is NOT guaranteed to be one: `requestId` equality alone
  // (the caller's outer gate) doesn't prove kind/agent/pane/hook-event also match
  // — a reused or hash-colliding requestId across a DIFFERENT kind/agent/pane/event
  // must never have a permission decision auto-delivered onto it (review finding:
  // "not bound to request provenance"). `permissionEvent` matters too — the reply
  // SHAPE differs between PreToolUse and PermissionRequest.
  if (a.kind !== "permission" || b.kind !== "permission") return false
  if (a.agent !== b.agent) return false
  if (a.paneId !== b.paneId) return false
  if ((a.permissionEvent ?? "PermissionRequest") !== (b.permissionEvent ?? "PermissionRequest")) return false
  if (a.question !== b.question) return false
  // `promptTurnId` (review finding): the caller's outer `requestId` equality
  // isn't itself proof of invocation identity — requestId is a SHORT djb2 hash
  // (hook-normalize.ts), and the whole "a different invocation can't reach this
  // branch" argument for dropping the delivery timer rests on env.invocationNonce
  // being folded into that hash, not on the hash being collision-free. Comparing
  // the raw `promptTurnId` values here closes that gap directly instead of
  // trusting the hash alone. A genuine reconnect (the SAME process's own
  // reconnect-and-resend loop) resends the identical serialized request — same
  // nonce — so this never rejects a real reconnect.
  if (a.promptTurnId !== b.promptTurnId) return false
  return JSON.stringify(a.toolInput ?? null) === JSON.stringify(b.toolInput ?? null)
}

// A SCOPED question (with options) or a SCOPED permission can survive socket close:
// a question still injects into its pane (late-delivery); a permission re-attaches
// when the hook reconnects. Retain both when paneId is set. Returns true when
// retained (caller keeps the keyboard live); unscoped or option-less questions
// fall through to expiry.
function retainAbandonedQuestion(rt: QuestionRuntime, entry: PendingButton, pendingKey: string): boolean {
  const { req } = entry
  if (!req.paneId) {
    // A hatch/RIG_HATCH_REQUEST_* permission has no pane to inject into or
    // reconnect from (see parseHatchHookId's doc comment, questions.ts) — but
    // a human decision on it must still survive the socket closing, so a
    // LATER retry of the same hookId can consume it (handleHookSocketLine's
    // hatch short-circuit) instead of the tap being thrown away. Every other
    // unscoped kind (a plain question with no pane, or a multi-question set
    // member) has no consumer for a retained entry at all and stays
    // fall-through-to-expiry, unchanged.
    if (req.kind !== "permission" || !isHatchRequest(req)) return false
  } else if (req.kind === "question" && !req.options?.length) {
    return false
  }
  rt.abandoned.set(pendingKey, {
    req,
    messageId: entry.messageId,
    at: Date.now(),
  })
  return true
}

// A dead card (unscoped / no options) can never be late-delivered: clear its keyboard
// so it isn't tappable and mark it expired. messageId may still be null mid-send —
// stash the text so the post-send reconciliation applies it.
function expireDeadCard(ctx: Ctx, entry: PendingButton): void {
  if (entry.messageId !== null) {
    void clearMessageKeyboard(ctx, entry.messageId)
    void editMessageText(ctx, entry.messageId, EXPIRED_TERMINAL_TEXT)
  } else {
    entry.finalText = EXPIRED_TERMINAL_TEXT
  }
}

// Both retirement paths — the raw UNSCOPED_ABANDON_MS backstop timer (the
// requesting process is STILL CONNECTED, just past its abandon window — the
// DOMINANT production case for a hatch permission, since a hook process's own
// budget is ~120s, comfortably longer than the 110s default abandon window) and
// the hook socket's 'close' handler (the process already exited) — must retire
// a PendingButton through the SAME retain-or-expire decision. Before this was
// unified, the raw timer called expireDeadCard(ctx, entry) unconditionally, so
// for a still-connected hatch request it always won the race and destroyed the
// card before the socket ever closed and retention could run — silently
// re-breaking tg-cli#349 in the default scenario (review finding on #350,
// which had only fixed the already-exited/socket-close case).
function retireAbandonedEntry(ctx: Ctx, rt: QuestionRuntime, entry: PendingButton, pendingKey: string): void {
  // Grant protocol v1.1 (tg-cli#398): an expiring HATCH permission becomes
  // addressable for a late tap through its 24h grace record REGARDLESS of the
  // retained/expired decision below (a retained card can be closed by a relevance signal
  // — tg-cli#705 — and a daemon restart; grace still lets a late tap mint). Fail-soft with a loud
  // log: grace loss degrades the feature but never authorizes anything.
  if (entry.req.kind === "permission" && isHatchRequest(entry.req)) rt.onHatchExpired(entry, pendingKey)
  if (retainAbandonedQuestion(rt, entry, pendingKey)) {
    if (entry.req.kind === "question" && !entry.req.multiQuestion) {
      rt.onTerminalFallback(entry.req.paneId as string)
      const abandoned = buildPostTimeoutQuestionMessage(ctx.chatId, entry.req)
      if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, abandoned.text, abandoned.reply_markup)
      else {
        entry.finalText = abandoned.text
        entry.finalReplyMarkup = abandoned.reply_markup
      }
    } else {
      // A hatch entry's paneId is always undefined (see parseHatchHookId's
      // doc comment, questions.ts) — rt.onRelease expects a REAL paneId, so
      // calling it here for a hatch entry would release a pane that was
      // never deferred in the first place. onUnscopedRelease is the correct
      // release path for any paneless retained entry, hatch included.
      if (entry.req.paneId) rt.onRelease(entry.req.paneId)
      else rt.onUnscopedRelease()
      const label = resolveSessionName({ tmuxWindow: entry.req.windowName, cwd: entry.req.cwd }).primary
      const hookId = parseHatchHookId(entry.req.requestId)
      const abandonedText =
        entry.req.kind === "permission"
          ? hookId !== null
            ? hatchAbandonedPermissionText(entry.req, hookId)
            : abandonedPermissionText(entry.req, label)
          : abandonedMultiText(entry.req, label)
      // The keyboard MUST ride along explicitly (see editMessageText's own doc
      // comment: omitting reply_markup DETACHES the current keyboard, it is not
      // preserved) — otherwise this very edit removes the buttons the text just
      // invited a tap on, breaking the whole abandoned-tap/queue feature at the
      // moment it's needed (review finding). Mirrors the question branch above,
      // which already passes `abandoned.reply_markup` for the same reason.
      const abandonedMarkup = buildButtonMessage(ctx.chatId, entry.req).reply_markup
      if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, abandonedText, abandonedMarkup, hatchParseMode(entry.req))
      else {
        entry.finalText = abandonedText
        entry.finalReplyMarkup = abandonedMarkup
      }
    }
  } else {
    if (entry.req.paneId) rt.onRelease(entry.req.paneId)
    else rt.onUnscopedRelease()
    expireDeadCard(ctx, entry)
  }
}

// Arm the hook socket's 'close' handler for a freshly-forwarded or revived pending
// question. On close (the agent's hook process exits, or its 120s budget elapses)
// the entry leaves `pending` so it stops deferring the pane, then retireAbandonedEntry
// converges it through the same retain-or-expire decision the raw UNSCOPED_ABANDON_MS
// backstop timer uses. The pane's deferred backlog is released either way. Returns a
// getter the caller uses to avoid double-ending a socket it still owns.
function armPendingSocketClose(
  ctx: Ctx,
  rt: QuestionRuntime,
  entry: PendingButton,
  pendingKey: string,
): { closed: () => boolean } {
  let socketClosed = false
  entry.socket.on("close", () => {
    socketClosed = true
    if (rt.pending.get(pendingKey) !== entry) return
    clearTimeout(entry.timer)
    rt.pending.delete(pendingKey)
    rt.activeKeys.delete(pendingKey)
    retireAbandonedEntry(ctx, rt, entry, pendingKey)
    rt.persist()
  })
  return { closed: () => socketClosed }
}

// Each ask's `at`: strictly increasing, so two hatch asks in one millisecond still supersede in
// arrival order (tg-cli#723).
const askArrivedAt = arrivalClock()

// Fresh forward: register the pending entry, arm its socket-close handler, post the
// inline-keyboard card, and reconcile against a socket that closed mid-send. Split
// out of handleHookSocketLine so the dispatcher stays a readable parse→guard→route.
async function forwardAndPostQuestion(
  ctx: Ctx,
  rt: QuestionRuntime,
  req: ButtonRequest,
  socket: Socket,
  pendingKey: string,
): Promise<void> {
  rt.activeKeys.add(pendingKey)
  const entry: PendingButton = { req, socket, messageId: null, at: askArrivedAt() }
  // An UNSCOPED question defers EVERY pane (fail-closed), so it MUST self-clear on a
  // timer or it wedges all routing. A SCOPED question waits forever (no timer): only
  // its socket close releases it (see armPendingSocketClose).
  //
  // tg-cli#403: a CRITICAL unscoped (paneless — the headless hatch case) request
  // is the ONE exception: this timer is exactly what would otherwise force-close
  // its live socket after UNSCOPED_ABANDON_MS (110s default) with a bare "null"
  // reply, defeating "wait indefinitely" for the very use case critical mode
  // exists for (a headless RIG_HATCH_REQUEST_* ask). No timer is armed at all —
  // the entry stays in `pending`, live socket open, until either a real answer
  // arrives (the ordinary tap path, unaffected) or the socket itself closes
  // (the underlying process actually exits/gets killed — armPendingSocketClose's
  // 'close' handler still retires it exactly as for any other request).
  if (!req.paneId && req.critical !== true) {
    const abandonMs = clampRequestTimeoutMs(req.timeoutMs, UNSCOPED_ABANDON_MS)
    log(`unscoped-abandon-armed: req=${req.requestId} ms=${abandonMs}`)
    entry.timer = setTimeout(() => {
      if (rt.pending.get(pendingKey) !== entry) return
      rt.pending.delete(pendingKey)
      rt.activeKeys.delete(pendingKey)
      retireAbandonedEntry(ctx, rt, entry, pendingKey)
      rt.persist()
      writeAskStatus(socket, {
        tgctl: "ask-status", state: "expired", messageId: entry.messageId, ageMs: Date.now() - entry.at,
      })
      socket.end("null\n")
    // Contract §1 (tg-cli#398): a per-request timeoutMs (hatch asks carry
    // 600000) overrides the unscoped-abandon default, clamped to the 15-min
    // cap (clampRequestTimeoutMs). Absent → UNSCOPED_ABANDON_MS unchanged.
    }, abandonMs)
  }
  rt.pending.set(pendingKey, entry)
  const conn = armPendingSocketClose(ctx, rt, entry, pendingKey)

  // The card goes into the ASKING session's topic (spec §4.3, tg-cli#717), created on this first
  // card if need be, WITH a notification. The asking session is req.sessionKey (resolved on
  // arrival from the hook's session id, the asker's explicit session / pid chain / pane, §2.6),
  // else looked up by origin/pane. With topics on and no topic for it, the card itself goes to
  // the 📥 Inbox — never silently to General, never to another session's topic.
  const cardSessionNow = (): SessionEntry | null =>
    (req.sessionKey ? liveEntry(ctx, req.sessionKey) : null)
    ?? (req.asker ? findSessionForAsker(currentRegistry(ctx), req.asker) : null)
    ?? findSessionForCard(currentRegistry(ctx), { agent: req.agent, sessionId: req.origin?.sessionId, paneId: req.paneId, tmuxServerPid: req.asker?.tmuxServerPid })
  let cardSession = cardSessionNow()
  // A session that asked before the registry's next scan saw it (its first hook, a fresh
  // process): scan now rather than send its card to the Inbox.
  if (!cardSession && (ctx.cfg.topics || ctx.cfg.privateTopics)) {
    refreshSessionRegistry(true)
    cardSession = cardSessionNow()
  }
  const threadId = cardSession ? await sessionTopic(ctx, cardSession.key) : null
  const inboxCard = threadId === null ? await rt.postCardToInbox(req, pendingKey) : null
  const messageId = inboxCard?.messageId
    ?? (await sendButtonCard(ctx, buildButtonMessage(ctx.chatId, req, threadId), threadId !== null && cardSession ? cardSession.key : null))
  const cardThread = inboxCard ? `inbox:${inboxCard.threadId}` : threadId === null ? "general" : String(threadId)
  if (messageId === null) {
    // botPost already logged the low-level send failure; tie it to THIS abandoned
    // forward so the drop is greppable. No card posted → nothing to late-deliver.
    log(`ask-forward dropped: reason=send-failed ${describeAskRequest(req)}`)
    if (rt.pending.get(pendingKey) === entry) {
      rt.pending.delete(pendingKey)
      rt.activeKeys.delete(pendingKey)
      clearTimeout(entry.timer)
      if (entry.req.paneId) rt.onRelease(entry.req.paneId)
      else rt.onUnscopedRelease()
    } else {
      // The socket closed DURING the failed send, so the close handler already
      // removed the pending entry — and, for a scoped question, RETAINED an abandoned
      // entry with a null card id. But the card never posted, so drop that phantom:
      // left in place it would persist, survive a restart, and let a reconnect
      // re-attach to a card the human never saw (the agent blocked blind).
      const phantom = rt.abandoned.get(pendingKey)
      if (phantom && phantom.req.requestId === req.requestId && phantom.messageId === null) {
        rt.abandoned.delete(pendingKey)
      }
    }
    rt.persist()
    if (!conn.closed()) dropAsk(socket, "send-failed")
    return
  }
  log(`ask-forward posted: ${describeAskRequest(req)} messageId=${messageId} thread=${cardThread} session=${cardSession?.key ?? "-"}`)
  if (!conn.closed()) writeAskStatus(socket, { tgctl: "ask-status", state: "posted", messageId })
  entry.messageId = messageId
  // If the socket closed DURING the send, the close handler may have retained an
  // abandoned entry with a null card id — backfill it now so late-delivery can edit
  // the right message.
  const ab = rt.abandoned.get(pendingKey)
  if (ab && ab.req.requestId === req.requestId && ab.messageId === null) ab.messageId = messageId
  // Accepted bound: a SIGKILL in the sub-ms window between the card posting above and
  // this persist (the atomicWrite included) leaves a card in Telegram with no on-disk
  // record — a reconnect-resend after restart then finds no retained entry and posts a
  // SECOND card. Same nature as the sub-inject window in lateDeliverAbandonedQuestion;
  // full closure would need a write-ahead marker BEFORE the send, not worth it for a
  // sub-ms window on a crash-relaunch.
  rt.persist() // the card id is now known — persist so a restart can late-deliver/reattach
  // A newer hatch request for the same (hookId, cwd) makes every older open card for it
  // irrelevant (tg-cli#705): the retry is what the human should decide on. Done only once the
  // new card is live, so a failed post never leaves the hook with no card at all — and only for
  // cards that arrived before this one: an older request whose post was slower must not close
  // the newer card that beat it to Telegram. An older card still being posted is closed too
  // (tg-cli#723): its post applies the close text when it returns, so two racing posts leave
  // one open card, not two.
  const olderCards = [
    ...rt.closableCards(),
    ...[...rt.pending].filter(([, e]) => e.messageId === null).map(([key, e]) => ({ key, req: e.req, at: e.at })),
  ].filter((c) => c.at <= entry.at)
  for (const key of hatchSiblingsOf(olderCards, req, pendingKey)) rt.closeCard(key, CLOSE_STATUS.superseded)
  // The socket (or unscoped timer) closed DURING the send: the close handler set
  // finalText but, with messageId still null, couldn't touch the card. Apply it now —
  // and for a genuinely-dead card (EXPIRED_TERMINAL_TEXT) clear the keyboard too, so
  // the "dead card → not tappable" guarantee holds even on this race (a scoped
  // ABANDONED_TAP_TEXT card deliberately keeps its keyboard for late-delivery).
  if (rt.pending.get(pendingKey) !== entry || entry.finalText) {
    const finalText = entry.finalText ?? EXPIRED_TERMINAL_TEXT
    if (finalText === EXPIRED_TERMINAL_TEXT) void clearMessageKeyboard(ctx, messageId)
    void editMessageText(ctx, messageId, finalText, entry.finalReplyMarkup, finalText === EXPIRED_TERMINAL_TEXT ? undefined : hatchParseMode(entry.req))
  }
}

function startHookServer(ctx: Ctx, rt: QuestionRuntime): Server | null {
  try {
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    const server = createServer((socket) => {
      socket.setEncoding("utf8")
      let raw = ""
      socket.on("data", (chunk) => {
        raw += chunk
        const newline = raw.indexOf("\n")
        if (newline === -1) {
          // A hook request is a single small JSON line; anything bigger is a
          // misbehaving client trying to grow the buffer forever.
          if (raw.length > MAX_HOOK_REQUEST_BYTES) socket.destroy()
          return
        }
        const line = raw.slice(0, newline).trim()
        raw = raw.slice(newline + 1)
        void handleHookSocketLine(ctx, rt, socket, line)
      })
    })
    server.on("error", (err) => {
      log(`hook socket failed: ${err}`)
    })
    server.listen(ctx.paths.socket, () => {
      // Owner-only: the socket answers with approved hook JSON, so other local
      // users must not be able to connect (the guard trusts client-sent fields).
      try {
        chmodSync(ctx.paths.socket, 0o600)
      } catch {}
    })
    return server
  } catch (err) {
    log(`hook socket failed: ${err}`)
    return null
  }
}

// Close the cards a withdraw line names (tg-cli#705): one request by its requestId (or its
// callback key), or every hatch card of a hook id, optionally narrowed to one directory.
// Covers every card the daemon still holds — also a retained one whose tap is queued, which
// the Inbox does not list. Returns how many closed.
function withdrawCards(rt: QuestionRuntime, w: WithdrawRequest): number {
  const open: OpenCard[] = [...rt.pending, ...rt.abandoned].map(([key, e]) => ({ key, req: e.req, at: e.at }))
  const keys =
    w.kind === "request"
      ? open.filter((c) => c.req.requestId === w.requestId || c.key === w.requestId).map((c) => c.key)
      : hatchSiblingKeys(open, w.hookId, w.cwd ?? ANY_CWD, null)
  const status = CLOSE_STATUS.withdrawn(w.reason)
  return keys.filter((key) => rt.closeCard(key, status)).length
}

async function handleHookSocketLine(ctx: Ctx, rt: QuestionRuntime, socket: Socket, line: string): Promise<void> {
  // The verify-grant exchange (grant protocol v1.1, tg-cli#398) is NOT a
  // ButtonRequest — it is dispatched by its marker BEFORE normalization so an
  // old/normalized-looking payload can never be confused with a question
  // forward. Cross-repo compatibility: an OLD daemon (no marker handling)
  // receives this line, fails normalizeButtonRequest, and drops it as
  // "unparsable-payload" with a `null` reply — the new lib's client fails
  // CLOSED on that (deny), which is the correct self-healing behavior.
  let parsedLine: unknown
  try {
    parsedLine = JSON.parse(line)
  } catch {
    parsedLine = undefined
  }
  if (parsedLine && typeof parsedLine === "object" && (parsedLine as { tgctl?: unknown }).tgctl === "verify-grant") {
    await handleVerifyGrantRequest(ctx, rt, socket, parsedLine as Record<string, unknown>)
    return
  }
  // `tg`'s session-topic lines (spec §4.3/§4.5, tg-cli#467), also dispatched before
  // normalization. An old daemon drops them as unparsable with a `null` reply, which `tg`
  // reads as "no topic" and posts to General.
  const lookup = parseResolveSessionRequest(parsedLine)
  if (lookup) {
    await handleResolveSession(ctx, socket, lookup)
    return
  }
  const topicResult = parseTopicResult(parsedLine)
  if (topicResult) {
    socket.end()
    const entry = liveEntry(ctx, topicResult.key)
    if (entry?.threadId === topicResult.threadId) {
      if (topicResult.ok) clearSessionTopicMisses(ctx, entry.key)
      else await noteSessionTopicMiss(ctx, entry.key, topicResult.threadId, topicResult.description)
    }
    return
  }
  // tg-cli#705: an asker (or a wrapper on its behalf — `tg-ctl withdraw`) says its question is
  // no longer relevant. Dispatched before normalization like the lines above; an old daemon
  // drops it as unparsable with a `null` reply, which the client reports as "not withdrawn".
  const withdraw = parseWithdrawLine(parsedLine)
  if (withdraw) {
    const closed = withdrawCards(rt, withdraw)
    log(`ask-withdraw: ${withdraw.kind === "request" ? `req=${withdraw.requestId}` : `hookId=${withdraw.hookId} cwd=${withdraw.cwd ?? "-"}`} closed=${closed}`)
    socket.end(`${JSON.stringify({ tgctl: "withdrawn", closed })}\n`)
    return
  }
  let req: ButtonRequest | null = null
  try {
    req = parsedLine === undefined ? null : normalizeButtonRequest(parsedLine)
  } catch {
    // malformed hook payload: let the local agent UI take over
  }
  if (!req) {
    // A non-forward must NEVER be silent: the question stays in the harness and
    // the operator gets zero signal. Every drop below logs a distinct, greppable
    // `ask-forward` reason so a question that doesn't reach Telegram is visible.
    log(`ask-forward dropped: reason=unparsable-payload line=${describeHookLine(line)}`)
    dropAsk(socket, "unparsable-payload")
    return
  }

  // The asking session (spec §2.6): the hook's own session id, else the asker's TG_SESSION pin
  // (a headless hatch ask has neither pane nor harness id — tg-cli#717), else the session owning
  // the asker's pid chain or pane, else the registry's occupant of the asking pane. Overwrites
  // any client-sent sessionKey.
  const askReg = currentSessionRegistry()
  const pinKey = req.sessionPin && askReg ? pinnedSession(askReg, req.sessionPin)?.key : undefined
  const askerSession = req.asker && askReg ? findSessionForAsker(askReg, req.asker)?.key : undefined
  // The pane fallback only on the asker's own tmux server (or for an asker that did not say):
  // `%1` on another server is another session's pane (tg-cli#722).
  const askerServer = req.asker?.tmuxServerPid ?? null
  const paneEntry = req.paneId && askReg ? sessionAtPane(askReg, req.paneId) : null
  const paneKey = paneEntry && (askerServer === null || paneEntry.locators.tmux?.serverPid === askerServer) ? paneEntry.key : undefined
  req = { ...req, sessionKey: hookSessionKey(req) ?? pinKey ?? askerSession ?? paneKey }
  log(`ask-forward arrived: ${describeAskRequest(req)}`)
  recordHookSession(req)

  // The per-pane registration SET: the question forwards when ITS pane matches
  // ANY registered entry, so EVERY concurrently-registered session forwards
  // (tg-cli#67), not only the single global last-writer. No liveness pruning
  // here — the asking pane is itself live (it is blocking on this very question),
  // and an unrelated dead-pane entry can never match this req's paneId, so a
  // prune would only cost an extra tmux read on the hot forward path.
  const registrations = readRegistrations(ctx.paths)
  // Hatch permissions skip the pane/cwd registration set (tg-cli#333): non-tmux
  // omp sessions are never registered, and hatch is the documented exception to
  // no-long-inline-process. Generic `tg-ctl ask "<question>"` calls skip it too
  // (isGenericAskRequest). canForwardButtonRequest still runs below.
  if (!isHatchPermissionRequest(req) && !isGenericAskRequest(req) && !hookMatchesRegistration(registrations, req)) {
    log(
      `ask-forward dropped: reason=not-registered ${describeAskRequest(req)} reg=${describeRegistration(registrations)}`,
    )
    dropAsk(socket, "not-registered")
    return
  }

  if (!canForwardButtonRequest(req)) {
    log(`ask-forward dropped: reason=not-forwardable ${describeAskRequest(req)}`)
    dropAsk(socket, "not-forwardable")
    void sendMessage(
      ctx,
      `native question forwarding isn't available for \`${req.agent}\` — answer in the terminal`,
    )
    return
  }

  // REMOVED (tg-cli#398): the hatch retry short-circuit that auto-applied a
  // queued tap to ANY retry behind the same hookId (see the note at the old
  // findQueuedHatchDecision site). A plain hatch retry now simply forwards a
  // FRESH card; a late human approval reaches the agent exclusively through
  // the operation-bound, single-use grant consumed via the verify-grant
  // protocol (handleVerifyGrantRequest, dispatched before normalization above).

  const pendingKey = callbackRequestId(req)
  if (rt.activeKeys.has(pendingKey)) {
    log(`ask-forward dropped: reason=duplicate-in-flight ${describeAskRequest(req)} key=${pendingKey}`)
    dropAsk(socket, "duplicate-in-flight")
    return
  }
  // Idempotency across the answer boundary (tg-cli#97): the in-flight dedup above
  // is RELEASED the instant a question is answered, so the SAME requestId
  // re-firing afterwards would post a second, superseded card. If we have a FRESH
  // answer for this key, replay it down the socket — rebuilt against the NEW req so
  // the reply shape matches this re-fire's own kind/event — and post no card. The
  // entry stays replayable for the whole window (a question can re-fire more than
  // once); a STALE entry (a genuinely new question reusing the hash past the TTL)
  // is pruned here so it falls through to a fresh forward. Only QUESTIONS are ever
  // cached (the write is kind-guarded), so consult it only for questions — symmetric
  // with the write and immune to a (practically impossible) cross-kind key clash.
  // Multi-question members also skip the replay READ defensively: they are never
  // written (all-or-nothing, see the answer branch), but an entry persisted by an
  // older daemon must not replay into a new round either.
  const prior = req.kind === "question" && !req.multiQuestion ? rt.answered.get(pendingKey) : undefined
  if (prior) {
    if (Date.now() - prior.at <= ANSWERED_REPLAY_MS) {
      if (prior.delivery === "pane") {
        // The answer was already LATE-DELIVERED into the pane (this PR). A hook that
        // reconnects (the restart race) or re-fires must NOT also have it replayed
        // down the socket — that delivers the answer twice. Return null with NO card:
        // a still-blocked hook falls back to the terminal, where the pane injection
        // lands, so the agent gets the chosen option exactly once.
        log(`ask-forward already-pane-delivered: ${describeAskRequest(req)} key=${pendingKey} label=${prior.label}`)
        dropAsk(socket, "already-pane-delivered")
        return
      }
      const replayAnswer: ButtonAnswer = {
        status: "answered",
        requestId: req.requestId,
        label: prior.label,
        value: prior.value,
        decision: prior.decision,
      }
      const output = formatAgentHookOutput(req, replayAnswer)
      log(`ask-forward replayed-answer: ${describeAskRequest(req)} key=${pendingKey} label=${prior.label}`)
      socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
      return
    }
    rt.answered.delete(pendingKey)
  }
  // RECONNECT re-attach (lossless restart): the SAME question or permission re-arriving
  // while we still RETAIN it — its socket died because the 120s window closed OR a
  // daemon restart restored it from disk — re-attaches THIS new socket to the existing
  // card instead of posting a duplicate. The agent's `tg-ctl ask` reconnect-and-resend
  // (byte-identical requestId, still inside its hook budget) lands here. We require an
  // EXACT requestId match (not just the callbackRequestId hash) so a genuinely different
  // request that merely hash-collides falls through to a fresh card. A late TAP that
  // already late-delivered moved the entry to `answered` (replayed above), so a tap and
  // a reconnect never fight over the same key. Only SCOPED entries are ever retained,
  // so the revived entry needs no unscoped timer.
  const retained = rt.abandoned.get(pendingKey)
  if (retained) {
    if (retained.req.requestId === req.requestId) {
      rt.abandoned.delete(pendingKey)
      // A Telegram tap already chose a permission decision WHILE this hook was
      // disconnected (queued by lateDeliverAbandonedQuestion, since a permission has
      // no pane-text fallback). Deliver it down THIS reconnecting socket right away
      // instead of re-showing a live prompt the human already answered — this is
      // what makes abandonedPermissionText's "delivered the moment it reconnects"
      // claim true rather than aspirational.
      // Only auto-deliver when the reconnecting request is PROVABLY the same prompt
      // the human read and decided on — requestId alone is a hash of session+question
      // text (tg-cli#97) and normally can't collide across different prompts, but a
      // harness that reused a stale requestId against a MUTATED payload must not
      // have that old decision silently rubber-stamped onto a request the human
      // never actually saw (review finding). This must compare the FULL approved
      // surface, not just the displayed question text: `toolInput` can carry
      // content (an edit's diff, a write's contents, structured args) the question
      // string never shows, so two requests can read identically to the human while
      // asking for materially different actions. A mismatch on EITHER is treated as
      // "no queued decision": fall through to the ordinary re-attach so the human is
      // shown a fresh live prompt and taps it explicitly.
      //
      // Not time-bounded (tg-cli#705 removed the retention window): delivery is safe
      // because the identity check itself is airtight for permissions — requestId folds in
      // `env.invocationNonce` (hook-normalize.ts), a random id generated ONCE PER
      // `tg-ctl ask` PROCESS. Claude's `prompt_id` / Codex's `turn_id` alone are
      // NOT sufficient here (they scope to the whole prompt TURN, not the
      // individual tool call — two distinct calls in the same turn could still
      // share a requestId under turn-id-only scoping; caught in review), so a
      // materially later, only-coincidentally-identical-looking request (whether a
      // later turn OR a second call within the same turn) can never reach this
      // branch at all — it's always a NEW process with a NEW nonce, hashing to a
      // DIFFERENT requestId that never matches `retained.req.requestId ===
      // req.requestId` above. permissionPayloadMatches remains as defense-in-depth
      // against the narrower residual risk of a lossy `summarizeInput` digest
      // collision (two DIFFERENT toolInputs summarizing to the same short string).
      //
      // `retained.req.promptTurnId` is REQUIRED (not just permissionPayloadMatches):
      // it's the proof that THIS retained request was actually captured with
      // turn-level identity in the first place. Without it (an older Claude Code
      // <v2.1.196, a harness with no turn_id equivalent, or a manual/back-compat
      // caller), requestId is only session-scoped, and a same-session re-run of an
      // identical command is a routine, non-malicious occurrence — auto-delivering
      // onto it would be exactly the "different prompt, same-looking request"
      // hazard this whole check exists to prevent (review finding). Refusing
      // auto-delivery there does NOT silently drop the tap: the fallthrough below
      // restores the card to a LIVE, freshly-buttoned prompt (buildButtonMessage)
      // — visibly pending again, not a dead/expired card and not a false "queued"
      // claim — so the human sees exactly what's happening and can re-decide. The
      // OLD queued value itself is NOT carried forward into that fresh prompt
      // (PendingButton has no queuedDecision slot): once identity can't be proven,
      // presenting a genuinely fresh choice is the honest, safe behavior, not a
      // stale tap silently reapplied.
      const outcome = decideQueuedPermissionReconnect(retained, req)
      switch (outcome.kind) {
        case "deliver": {
          const qd = outcome.queuedDecision
          const answer: ButtonAnswer = {
            status: "answered",
            requestId: req.requestId,
            label: qd.label,
            value: qd.value,
            decision: qd.decision,
          }
          const output = formatAgentHookOutput(req, answer)
          socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
          // Deliberately NOT added to `rt.answered` (the question-only replay cache —
          // see the "Scoped to questions on purpose" comment in the live-tap handler
          // below): silently replaying a permission decision to a LATER unrelated
          // re-fire that happens to reuse the same key would be exactly the
          // behavioral/security change that cache was built to avoid (review
          // finding). The entry is already gone from `rt.abandoned` above, so a
          // genuinely fresh re-fire of this requestId just forwards as a normal new
          // prompt — no double-delivery risk without the cache.
          rt.persist()
          if (retained.messageId !== null) {
            void clearMessageKeyboard(ctx, retained.messageId)
            void editMessageText(ctx, retained.messageId, buildAnsweredQuestionText(req, qd.label), undefined, hatchParseMode(req))
          }
          log(`ask-forward queued-decision-delivered: ${describeAskRequest(req)} key=${pendingKey} label=${qd.label}`)
          return
        }
        case "no-turn-proof":
          log(`ask-forward queued-decision-discarded: retained request has no promptTurnId (no per-invocation identity proof) — refusing auto-delivery, showing a fresh live prompt instead. key=${pendingKey}`)
          break
        case "turn-mismatch":
          // Distinct from the generic payload-mismatch case below (review finding:
          // this log used to blame "question text or toolInput" even when the REAL
          // mismatch was promptTurnId — e.g. a manual/back-compat caller reusing the
          // same requestId while omitting or changing the field).
          log(`ask-forward queued-decision-discarded: reconnecting request's promptTurnId does not match the queued decision's (permissionPayloadMatches) — showing a fresh live prompt instead. key=${pendingKey}`)
          break
        case "payload-mismatch":
          log(`ask-forward queued-decision-discarded: reconnecting request's question text or toolInput no longer matches the queued decision's (permissionPayloadMatches) — showing a fresh live prompt instead. key=${pendingKey}`)
          break
        case "no-queued-decision":
          break // ordinary reconnect, nothing queued — nothing to log
      }
      rt.activeKeys.add(pendingKey)
      const entry: PendingButton = {
        req,
        socket,
        messageId: retained.messageId,
        at: Date.now(),
      }
      rt.pending.set(pendingKey, entry)
      armPendingSocketClose(ctx, rt, entry, pendingKey)
      // tg-cli#317 review finding: a reconnect landing HERE (the daemon reattaching
      // an already-posted-but-undecided card after a restart or a transient socket
      // drop) previously wrote no status line at all. If this new connection then
      // also drops or times out with no tap, describeAskOutcome saw an empty
      // `statuses` array and reported "unreachable"/"no status line" for a card
      // that is genuinely live and answerable in Telegram — the exact incident
      // this file exists to fix, recreated in the one path the first pass missed.
      if (retained.messageId !== null) {
        writeAskStatus(socket, { tgctl: "ask-status", state: "posted", messageId: retained.messageId })
      }
      rt.persist()
      // The card is LIVE again — restore the original prompt text, which the
      // socket-close path replaced with "window closed …" (actively misleading
      // for a multi-question member: it tells the user NOT to tap the one card
      // that now works — review finding). The keyboard rides along explicitly:
      // Telegram's editMessageText DETACHES the inline keyboard when
      // reply_markup is omitted. Best-effort like every card edit (a restart-
      // restored card that was never edited yields "message is not modified",
      // which botPostResult counts as success — tg-cli#728).
      if (retained.messageId !== null) {
        const restored = buildButtonMessage(ctx.chatId, req)
        void editMessageText(ctx, retained.messageId, restored.text, restored.reply_markup, restored.parse_mode)
      }
      log(`ask-forward reattached: ${describeAskRequest(req)} key=${pendingKey} messageId=${retained.messageId ?? "-"}`)
      return
    }
    rt.abandoned.delete(pendingKey) // stale hash-collision → fall through to a fresh forward
  }
  await forwardAndPostQuestion(ctx, rt, req, socket, pendingKey)
}

// --- Grant protocol v1.1 (tg-cli#398): the verify-grant exchange ---
//
// The daemon is the ONLY grant authority. A `{"tgctl":"verify-grant",…}` line
// (dispatched from handleHookSocketLine BEFORE normalization) carries:
//   hookId     — RIG_HATCH_REQUEST_<HOOK_ID>'s hook id (required)
//   approvalId — TOKEN path (contract §5): explicit id, route-agnostic (the
//                agent was told the id out-of-band)
//   pull: true — PULL path: no id; matched by hook_id + operation + ROUTE
//                EQUALITY (routeForRequest recomputed from `payload`, never a
//                client-sent route field). NO blank-route fallback.
//   payload    — the normalized ask (carries the recomputed `operation`)
// The reply is the SAME hookSpecificOutput allow/deny JSON shape a normal ask
// reply uses (formatAgentHookOutput where the payload normalizes, a
// PermissionRequest envelope otherwise), PLUS the original ask's `requestId`
// at TOP level (the pinned shape the agent-tools lib reads; it also parses
// hookSpecificOutput.requestId tolerantly) and `approvalId` on allow.

// Deny envelope: constructed directly (not via formatAgentHookOutput) so the
// deny REASON always reaches the caller — formatAgentHookOutput only conveys
// a reason for a RELABELED deny (plan-approval), not a bare Approve/Reject.
function buildVerifyGrantDeny(payloadReq: ButtonRequest | null, reasonText: string, requestId: string | null): Record<string, unknown> {
  if (payloadReq?.permissionEvent === "PreToolUse") {
    return {
      requestId,
      hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: reasonText },
    }
  }
  return {
    requestId,
    hookSpecificOutput: { hookEventName: "PermissionRequest", decision: { behavior: "deny", message: reasonText } },
  }
}

function buildVerifyGrantAllow(payloadReq: ButtonRequest | null, grant: { approval_id: string; request_id: string }): Record<string, unknown> {
  let out: unknown = null
  if (payloadReq) {
    const answer: ButtonAnswer = {
      status: "answered",
      requestId: grant.request_id,
      label: "Approve",
      value: "allow",
      decision: "allow",
    }
    out = formatAgentHookOutput(payloadReq, answer)
  }
  if (!out || typeof out !== "object") {
    out = { hookSpecificOutput: { hookEventName: "PermissionRequest", decision: { behavior: "allow" } } }
  }
  return { requestId: grant.request_id, approvalId: grant.approval_id, ...(out as Record<string, unknown>) }
}

// Consume-on-allow, FAIL-CLOSED: mutate consumed_at and persist BEFORE
// replying; if the atomic write fails the mutation is rolled back and the
// reply is a DENY — otherwise a daemon restart would resurrect the grant as
// unconsumed and permit a single-use replay (security invariant §6).
async function handleVerifyGrantRequest(ctx: Ctx, rt: QuestionRuntime, socket: Socket, rec: Record<string, unknown>): Promise<void> {
  const hookId = typeof rec.hookId === "string" && rec.hookId ? rec.hookId : null
  const approvalId = typeof rec.approvalId === "string" && rec.approvalId ? rec.approvalId : null
  const pull = rec.pull === true
  const payloadReq = rec.payload ? normalizeButtonRequest(rec.payload) : null
  const reply = (obj: Record<string, unknown>): void => {
    socket.end(`${JSON.stringify(obj)}\n`)
  }
  if (!hookId || (!pull && !approvalId)) {
    log(`grant-deny: reason=malformed-request hookId=${hookId ?? "-"} approvalId=${approvalId ?? "-"} pull=${pull}`)
    reply(buildVerifyGrantDeny(payloadReq, "malformed verify-grant request (needs --hook <hook_id>, and an approval id or --pull)", null))
    return
  }
  const now = Date.now()
  const operation = payloadReq?.operation
  // TOKEN path: explicit approval id, route-agnostic. PULL path: no id —
  // matched by hook_id + operation + route equality, route recomputed
  // daemon-side from the query payload's routing fields.
  const outcome = pull
    ? pullGrant(rt.grants.grants, hookId, operation, payloadReq ? routeForRequest(payloadReq) : null, now)
    : verifyGrant(rt.grants.grants, approvalId!, hookId, operation, now)
  if (outcome.kind === "deny") {
    const existing = pull ? null : (rt.grants.grants.find((g) => g.approval_id === approvalId) ?? null)
    log(
      `grant-deny: via=${pull ? "pull" : "token"} hookId=${hookId} approvalId=${approvalId ?? "-"} reason=${outcome.reason}` +
        ` cwd=${operation?.cwd ?? "-"} route=${pull ? (payloadReq ? routeForRequest(payloadReq) : null) ?? "-" : "(n/a)"}`,
    )
    // Top-level requestId (the pinned shape the lib reads): the ORIGINAL ask's
    // when the grant is known, else the retry payload's own (the lib correlates
    // either), never a missing key.
    reply(
      buildVerifyGrantDeny(
        payloadReq,
        grantDenyReasonText(outcome.reason, hookId),
        existing?.request_id ?? payloadReq?.requestId ?? null,
      ),
    )
    return
  }
  const grant = outcome.grant
  grant.consumed_at = now
  if (!rt.persistGrants()) {
    grant.consumed_at = null
    log(`grant-deny: via=${pull ? "pull" : "token"} approvalId=${grant.approval_id} reason=persist-failed — rolled back, NOT consumed`)
    reply(buildVerifyGrantDeny(payloadReq, "grant store write failed — denying fail-closed (the grant was NOT consumed); retry", grant.request_id))
    return
  }
  log(`grant-consume: via=${pull ? "pull" : "token"} approvalId=${grant.approval_id} hookId=${hookId} req=${grant.request_id}`)
  reply(buildVerifyGrantAllow(payloadReq, grant))
  // The agent got its decision through the grant: every other open card of this hatch is moot.
  for (const key of hatchSiblingKeys(rt.closableCards(), grant.hook_id, grant.operation?.cwd ?? payloadReq?.cwd, null)) {
    rt.closeCard(key, CLOSE_STATUS.decided)
  }
}

// The agent kind the hook was installed for (`tg-ctl ask --agent codex`). Decides
// how the raw payload is normalized + formatted. The accepted set is
// HOOK_AGENT_KINDS (features/tg-ctl/types.ts) — an exhaustiveness-checked single
// source, so a future harness kind forces a compile error there, never a silent
// fallthrough. An ABSENT flag defaults to claude (back-compat with hook installs
// older than the selector); a PRESENT-but-unrecognized value still defaults to
// claude but logs a warning — coercing it silently would hand a typo'd or
// newer-than-the-daemon kind claude semantics with zero signal.
function hookAgentFromArgv(): HookAgentKind {
  const i = process.argv.indexOf("--agent")
  const v = i >= 0 ? process.argv[i + 1] : undefined
  if (v && isHookAgentKind(v)) return v
  if (v) log(`ask: unrecognized --agent '${v}' — falling back to claude (known: ${HOOK_AGENT_KINDS.join("/")})`)
  return "claude"
}

function tmuxSessionName(): string | undefined {
  return tmuxDisplay("#{session_name}")
}

function tmuxWindowName(): string | undefined {
  return tmuxDisplay("#{window_name}")
}

function tmuxDisplay(format: string): string | undefined {
  if (!process.env.TMUX) return undefined
  try {
    const r = Bun.spawnSync(["tmux", "display-message", "-p", format], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    if (r.exitCode === 0) return r.stdout.toString().trim() || undefined
  } catch {}
  return undefined
}

// One result of a single hook-socket attempt. `response` is a COMPLETE reply (a
// newline-terminated line the daemon wrote before closing — including a legitimate
// "null" decline); `dropped` is a connection that closed/errored WITHOUT a complete
// reply (daemon down, restarting, or died mid-block); `timeout` is the overall
// budget elapsing. The distinction is what makes reconnect safe: only `dropped` is
// retried — a real "null" decline is honored, not looped.
type AskAttempt = { kind: "response" | "dropped" | "timeout"; raw: string | null; statuses: AskStatusLine[] }

function parseAskStatus(line: string): AskStatusLine | null {
  try {
    const v = JSON.parse(line) as { tgctl?: unknown; state?: unknown }
    if (v && typeof v === "object" && v.tgctl === "ask-status" && typeof v.state === "string") {
      return v as AskStatusLine
    }
  } catch {}
  return null
}

// Everything the daemon wrote before the socket went away: status lines (kept) and the
// final reply (the LAST newline-terminated non-status line; `null` is a real decline).
// `end` with no complete reply line is a drop (the daemon closed mid-block) — a status
// line alone does not make a response, so the reconnect loop still resends.
function parseAskStream(raw: string, how: "end" | "dropped" | "timeout"): AskAttempt {
  const statuses: AskStatusLine[] = []
  let reply: string | null | undefined
  for (const line of raw.split("\n").slice(0, -1)) {
    const status = parseAskStatus(line)
    if (status) statuses.push(status)
    else reply = line.trim() || null
  }
  if (how !== "end") return { kind: how, raw: null, statuses }
  if (reply === undefined) return { kind: "dropped", raw: null, statuses }
  return { kind: "response", raw: reply, statuses }
}

// `tg-ctl ask --verify-grant <approval_id> --hook <hook_id>` (TOKEN path) or
// `tg-ctl ask --verify-grant --pull --hook <hook_id>` (PULL path) — the grant
// consume client (contract §5 + pull-model, tg-cli#398). stdin carries the
// normalized payload (with the recomputed `operation`); the daemon answers
// immediately. Modeled on hookAgentFromArgv's argv-scan style.
interface VerifyGrantArgv {
  approvalId?: string
  pull: boolean
  hookId?: string
}
function verifyGrantArgvFrom(args: string[]): VerifyGrantArgv | null {
  const i = args.indexOf("--verify-grant")
  if (i < 0) return null
  const out: VerifyGrantArgv = { pull: args.includes("--pull") }
  const maybeId = args[i + 1]
  if (maybeId && !maybeId.startsWith("--")) out.approvalId = maybeId
  const h = args.indexOf("--hook")
  const hookId = h >= 0 ? args[h + 1] : undefined
  if (hookId && !hookId.startsWith("--")) out.hookId = hookId
  return out
}

// The verify-grant round-trip: one short socket exchange (the daemon answers
// immediately — no human in the loop — so 30s is a generous ceiling), then
// print the daemon's reply JSON VERBATIM on stdout. Exit 0 ALWAYS; the outcome
// rides stderr. Fail CLOSED on any transport failure (daemon down, old daemon
// that drops the unknown marker with `null`, timeout): a deny envelope on
// stdout so the calling hook blocks the operation — never an empty stdout that
// a lenient caller could misread as "no objection".
async function verifyGrantDaemon(ctx: Ctx, argv: VerifyGrantArgv, stdinPayload: unknown): Promise<void> {
  const denyUnreachable = (why: string): void => {
    log(`verify-grant failed-closed: ${why}`)
    console.log(
      JSON.stringify({
        requestId: null,
        hookSpecificOutput: {
          hookEventName: "PermissionRequest",
          decision: { behavior: "deny", message: `tg-ctl grant verification failed closed: ${why}` },
        },
      }),
    )
  }
  if (!argv.hookId || (!argv.pull && !argv.approvalId)) {
    denyUnreachable("malformed invocation — need --hook <hook_id> and either --verify-grant <approval_id> or --verify-grant --pull")
    return
  }
  const line = JSON.stringify({
    tgctl: "verify-grant",
    hookId: argv.hookId,
    ...(argv.pull ? { pull: true } : { approvalId: argv.approvalId }),
    payload: stdinPayload ?? null,
  })
  const attempt = await oneAskAttempt(ctx, line, 30_000)
  if (attempt.kind === "response" && attempt.raw && attempt.raw !== "null") {
    console.log(attempt.raw)
    // Outcome on stderr (contract §5: exit 0 always, verdict rides stderr) —
    // the human/lib reading the terminal sees WHY alongside the stdout JSON.
    try {
      const parsed = JSON.parse(attempt.raw) as { approvalId?: string; requestId?: string | null }
      log(
        parsed.approvalId
          ? `grant consumed: approvalId=${parsed.approvalId} requestId=${parsed.requestId ?? "-"}`
          : `grant denied: requestId=${parsed.requestId ?? "-"}`,
      )
    } catch {
      log(`grant verify reply (unparsable): ${attempt.raw}`)
    }
    return
  }
  // An OLD daemon doesn't know the marker: it drops the line as
  // unparsable-payload and replies `null` — fail closed (the correct
  // self-healing behavior; the lib surfaces this as a deny).
  denyUnreachable(
    attempt.kind === "response"
      ? "daemon declined the verify-grant request (older daemon without grant support)"
      : `daemon unreachable (${attempt.kind})`,
  )
}

// Overall hook budget. Kept UNDER the 120s the harness gives the hook process so the
// reconnect loop returns a real answer (or null) before the harness kills it. Skipped
// entirely for a CRITICAL ask (tg-cli#403) — see askDaemon's deadline computation.
// Env-overridable ONLY for tests to prove the non-critical/critical contrast without a
// real 115s wait (mirrors UNSCOPED_ABANDON_MS's own clamp: setTimeout silently clamps
// any delay > 2^31-1 ms to ~1ms, so an oversized override is clamped rather than
// flipping into an immediate false timeout); production never sets it.
const ASK_TOTAL_TIMEOUT_MS = (() => {
  const raw = Number(process.env.TG_CTL_ASK_TOTAL_TIMEOUT_MS)
  const TIMEOUT_MAX = 2_147_483_647
  return Number.isFinite(raw) && raw > 0 ? Math.min(raw, TIMEOUT_MAX) : 115_000
})()
// How often `tg-ctl ask` checks that the process that asked is still alive (tg-cli#717).
const ORPHAN_CHECK_MS = 2_000
// Backoff between reconnect attempts. Also lets a LIVE daemon's socket-close handler
// run (moving the entry to `abandoned`) BEFORE the resend lands, so the resend
// re-attaches instead of racing the in-flight dedup.
const ASK_RECONNECT_BACKOFF_MS = 250

function oneAskAttempt(ctx: Ctx, requestLine: string, timeoutMs: number): Promise<AskAttempt> {
  return new Promise<AskAttempt>((resolve) => {
    let done = false
    let raw = ""
    let timer: ReturnType<typeof setTimeout> | undefined
    const finish = (how: "end" | "dropped" | "timeout"): void => {
      if (done) return
      done = true
      clearTimeout(timer)
      resolve(parseAskStream(raw, how))
    }
    const socket = createConnection(ctx.paths.socket)
    // tg-cli#403 CRITICAL LANDMINE: `timeoutMs` is `Infinity` for a critical ask
    // (askDaemon's deadline is Infinity, and Date.now() subtracted from Infinity
    // is still Infinity). Node/Bun's setTimeout silently CLAMPS any delay beyond
    // 2^31-1 ms (32-bit signed overflow) to ~1ms and fires almost immediately —
    // passing Infinity straight to setTimeout would flip "wait forever" into "time
    // out instantly", the EXACT OPPOSITE of critical mode's intent. Skip scheduling
    // the timer entirely when the delay isn't finite; the promise then resolves
    // purely from the socket's own data/end/error/close events, with no deadline
    // to race against at all — the "skip scheduling" fix this ticket explicitly
    // prescribes over clamping, since clamping still needs SOME real bound to
    // clamp TO, which a genuinely unbounded critical wait doesn't have.
    timer = Number.isFinite(timeoutMs)
      ? setTimeout(() => {
          socket.destroy()
          finish("timeout")
        }, timeoutMs)
      : undefined
    socket.setEncoding("utf8")
    socket.on("connect", () => socket.write(requestLine + "\n"))
    socket.on("data", (chunk) => {
      raw += chunk
    })
    socket.on("error", () => finish("dropped"))
    // A complete reply always ends in a newline (the daemon's socket.end(`${out}\n`));
    // EOF with no complete reply line means the daemon closed without answering → a drop
    // to retry (parseAskStream decides, so an interim status line alone is not a reply).
    socket.on("end", () => finish("end"))
    socket.on("close", () => finish("dropped"))
  })
}

// Reconnect-and-resend the SAME requestId across a mid-block socket drop (lossless
// restart): a SCOPED question whose daemon restarted (crash-relaunch in ~1s, or a
// deliberate stop+start) keeps trying until the restored daemon answers — it either
// re-attaches the still-pending entry (no duplicate card) or replays the stored
// answer. Bounded by the caller's deadline (shared across a multi-question
// sequence); a real "null" decline returns immediately.
async function requestHookAnswerWithReconnect(ctx: Ctx, requestLine: string, deadline: number): Promise<AskAttempt> {
  let announcedDrop = false
  let last: AskAttempt = { kind: "timeout", raw: null, statuses: [] }
  for (;;) {
    const remaining = deadline - Date.now()
    if (remaining <= 0) return last
    const res = await oneAskAttempt(ctx, requestLine, remaining)
    if (res.kind !== "dropped") return { ...res, statuses: [...last.statuses, ...res.statuses] }
    // ACCUMULATE, never replace (review finding, x2 independent reviewers): a `posted`
    // status learned on an earlier attempt (daemon posted the card, then crashed
    // mid-wait) must survive every later attempt that cannot even connect
    // (`statuses: []` on ECONNREFUSED) — otherwise the deadline verdict below loses
    // the one fact that proves the card is genuinely live in Telegram, reintroducing
    // this file's own incident as "unreachable" for a card that was posted.
    last = { ...res, statuses: [...last.statuses, ...res.statuses] }
    if (!announcedDrop) {
      log("ask reconnect: daemon socket dropped — resending requestId until it comes back")
      announcedDrop = true
    }
    const backoff = Math.min(ASK_RECONNECT_BACKOFF_MS, Math.max(0, deadline - Date.now()))
    if (backoff > 0) await new Promise((r) => setTimeout(r, backoff))
  }
}

// One daemon round-trip for one ButtonRequest, within the caller's deadline.
// SCOPED questions and SCOPED permissions reconnect-and-resend across a daemon
// restart: both are retained on socket close (abandoned map + persist), so a
// resend re-attaches to the existing card rather than posting a duplicate.
// UNSCOPED requests keep the single-attempt path — they aren't retained (no
// pane to late-deliver to), so a resend after a restart would post a duplicate
// card.
async function askDaemonOnce(ctx: Ctx, req: ButtonRequest, deadline: number): Promise<AskAttempt> {
  const requestLine = JSON.stringify(req)
  const reconnectable = Boolean(req.paneId) && (req.kind === "question" || req.kind === "permission")
  if (reconnectable) return requestHookAnswerWithReconnect(ctx, requestLine, deadline)
  const remaining = deadline - Date.now()
  if (remaining <= 0) return { kind: "timeout", raw: null, statuses: [] }
  return oneAskAttempt(ctx, requestLine, remaining)
}

type PostedStatus = Extract<AskStatusLine, { state: "posted" }>
type DroppedStatus = Extract<AskStatusLine, { state: "dropped" }>
type ExpiredStatus = Extract<AskStatusLine, { state: "expired" }>

// The truthful client-side verdict for a request that produced no usable reply
// (tg-cli#317). The asking agent reads this line — the agent-tools hatch helper forwards
// hook stderr into its deny reason — so it must say what the daemon actually did: a card
// that WAS posted is never reported as "not-posted", and a daemon expiry is an expiry.
function describeAskOutcome(req: ButtonRequest, attempt: AskAttempt): string {
  const who = `req=${req.requestId} agent=${req.agent} pane=${req.paneId ?? "-"}`
  const posted = attempt.statuses.find((s): s is PostedStatus => s.state === "posted")
  const dropped = attempt.statuses.find((s): s is DroppedStatus => s.state === "dropped")
  const expired = attempt.statuses.find((s): s is ExpiredStatus => s.state === "expired")
  // A reconnect that lands AFTER the human already tapped the card is answered —
  // the daemon delivered the decision via pane injection (no live socket to answer
  // on) and drops this stale resend with reason=already-pane-delivered (review
  // finding: checked ahead of the generic `posted` branch below, which would
  // otherwise report a real decision as "the daemon closed with no decision" —
  // the exact class of false claim this file exists to eliminate).
  if (dropped?.reason === "already-pane-delivered") {
    return `ask-forward answered-via-pane: ${who} messageId=${posted?.messageId ?? "-"} — the human already answered this card; delivered directly to the pane, not through this hook`
  }
  if (expired) {
    // The unscoped-abandon timer is armed BEFORE `sendMessage` resolves (review
    // finding): if Telegram is slow and the timer fires first, `expired.messageId`
    // is still null — no card was ever posted, and asserting "posted to Telegram"
    // would be exactly the false claim tg-cli#317 exists to eliminate.
    const where = expired.messageId !== null ? "posted to Telegram" : "the send to Telegram had not completed"
    return `ask-forward expired: ${who} messageId=${expired.messageId ?? "-"} — ${where}; no decision within ${expired.ageMs}ms (daemon expiry, nobody tapped)`
  }
  if (posted && attempt.kind === "timeout") {
    return `ask-forward timed-out: ${who} messageId=${posted.messageId} — posted to Telegram; no decision within this hook's ${clampRequestTimeoutMs(req.timeoutMs, ASK_TOTAL_TIMEOUT_MS)}ms budget (the card stays answerable for late delivery)`
  }
  if (posted) {
    // `attempt.kind` here is only ever "response" (an explicit `null` reply) or
    // "dropped" ("timeout" was handled above) — spell those out rather than
    // printing the bare internal enum (review finding: "(response)"/"(dropped)"
    // is jargon to whoever reads the hook/daemon log this line is meant for).
    const how = attempt.kind === "response" ? "explicit null reply" : "connection lost after posting"
    return `ask-forward declined-after-post: ${who} messageId=${posted.messageId} — posted to Telegram; the daemon closed with no decision (${how})`
  }
  if (dropped) return `ask-forward not-posted: ${who} — daemon declined: reason=${dropped.reason}`
  if (attempt.kind === "timeout") {
    return `ask-forward timed-out: ${who} — no reply and no status line from the daemon within ${clampRequestTimeoutMs(req.timeoutMs, ASK_TOTAL_TIMEOUT_MS)}ms`
  }
  if (attempt.kind === "dropped") return `ask-forward unreachable: ${who} — daemon socket closed or errored without a reply`
  return `ask-forward not-posted: ${who} — daemon declined or unreachable (no status line: a daemon older than tg-cli#317 cannot say which)`
}

// Who this `tg-ctl ask` process is (tg-cli#717): its pid chain and its tmux pane — the daemon
// matches them against the session registry so the card lands in the asking session's topic
// (an explicit TG_SESSION pin rides as `sessionPin`). Best effort: a failed `ps` leaves the
// pid chain empty.
function askerIdentity(): AskerIdentity {
  let ancestorPids: number[] = []
  try {
    const ps = Bun.spawnSync(["ps", "-axo", "pid=,ppid=,command="], { stdout: "pipe", stderr: "pipe" })
    if (ps.exitCode === 0) ancestorPids = ancestorPidChain(parseProcList(ps.stdout.toString()), process.ppid)
  } catch {
    // no process table — the session is found by its pin or pane alone
  }
  return {
    ancestorPids,
    tmuxPane: process.env.TMUX_PANE || null,
    tmuxServerPid: tmuxServerPidFromEnv(process.env.TMUX),
  }
}

async function askDaemon(ctx: Ctx): Promise<void> {
  const input = await readStdinText()
  if (!input.trim()) return
  let payload: unknown
  try {
    payload = JSON.parse(input)
  } catch {
    return
  }
  // Normalize the harness's raw hook payload (or an already-normalized request)
  // into ButtonRequests, filling routing fields from the hook process's own
  // env. A claude AskUserQuestion with 2-4 questions yields one request PER
  // question; everything else yields exactly one. null → unsupported shape;
  // emit nothing so the local agent UI takes over.
  //
  // `invocationNonce`: a random id generated ONCE per `tg-ctl ask` PROCESS —
  // the harness spawns a fresh process for EVERY tool/permission/question hook
  // event, so this is a true per-INVOCATION identity, stronger than (and not
  // dependent on) any field the harness itself may or may not send
  // (Claude Code's `prompt_id` / Codex's `turn_id` identify the whole prompt
  // TURN, not the individual tool call — two distinct tool invocations with
  // byte-identical input in the SAME turn would otherwise share a requestId;
  // review finding, tg#9982 follow-up). Threaded into every requestId hash
  // (hook-normalize.ts) and into ButtonRequest.promptTurnId, so a queued
  // permission decision's no-time-bound auto-delivery (see AGENTS.md's "Queued
  // permission decisions") is scoped to THIS exact invocation: the SAME
  // process's own reconnect-and-resend loop reuses this same requestLine/nonce
  // (requestHookAnswerWithReconnect resends the identical serialized `req`), so
  // a genuine reconnect still matches; a genuinely later invocation is always a
  // NEW process with a NEW nonce and can never collide.
  const env: HookEnv = {
    agent: hookAgentFromArgv(),
    paneId: process.env.TMUX_PANE || undefined,
    cwd: process.cwd(),
    sessionName: tmuxSessionName(),
    windowName: tmuxWindowName(),
    subagent: envRole(process.env).label,
    invocationNonce: crypto.randomUUID(),
    sessionPin: process.env.TG_SESSION?.trim() || undefined,
  }
  const normalized = normalizeHookRequests(payload, env)
  if (!normalized) {
    // Unsupported payload shape (multi-select / free-form / an event we don't
    // forward). This never reaches the daemon, so the daemon log can't see it —
    // emit here (hook process stderr) so the drop isn't silent.
    log(`ask-forward dropped: reason=unsupported-payload agent=${env.agent} pane=${env.paneId ?? "-"} cwd=${env.cwd ?? "-"}`)
    return
  }
  // tg-cli#717: who is asking, so the daemon posts the card in the asking session's topic.
  const asker = askerIdentity()
  const reqs = normalized.map((r) => ({ ...r, asker }))
  // A stopped or orphaned asker withdraws its cards — except a hatch ask: its asker being
  // killed (a `gh ship` timeout) is exactly when the #398 late approval matters, and a withdraw
  // would retire the grace record that lets a later Approve mint a grant for the retry. Its card
  // closes on the retry (superseded), a decision, or an explicit `tg-ctl withdraw`.
  const withdrawable = reqs.filter((r) => !isHatchRequest(r)).map((r) => r.requestId)
  withdrawOnSignal(ctx, withdrawable)
  withdrawWhenOrphaned(ctx, withdrawable)
  // ONE deadline shared by the whole call (all cards of a multi-question), kept
  // under the harness's 120s hook budget so we always answer before it kills us.
  //
  // tg-cli#403: a CRITICAL request (never true for a multi-question set in
  // practice — critical is a hatch/permission-only opt-in) removes this bound
  // entirely. `Infinity` is a safe DEADLINE sentinel (never passed directly to
  // setTimeout): `Date.now() < Infinity` is always true, and `Infinity - x` stays
  // `Infinity` through every downstream subtraction (requestHookAnswerWithReconnect's
  // `remaining`, askDaemonOnce's `remaining`) — every one of THOSE call sites turns
  // its own "remaining" into an actual setTimeout delay only inside oneAskAttempt,
  // which explicitly skips scheduling when the delay isn't finite (see its own doc
  // comment on the 32-bit setTimeout overflow clamp this guards against).
  //
  // Contract §1 (tg-cli#398): for a non-critical request, a per-request
  // timeoutMs (the agent-tools lib sends 600000 for hatch asks) extends the
  // deadline instead, clamped to the 15-min cap; absent/invalid → the
  // unchanged 115s default. (A hatch ask carrying 600000 still answers EARLY
  // the moment a tap lands — the deadline is only the wait ceiling.)
  const deadline = reqs.some((r) => r.critical === true)
    ? Infinity
    : Date.now() + clampRequestTimeoutMs(reqs[0].timeoutMs, ASK_TOTAL_TIMEOUT_MS)

  if (reqs.length === 1) {
    const req = reqs[0]
    const attempt = await askDaemonOnce(ctx, req, deadline)
    const output = attempt.raw
    if (output && output !== "null") {
      // Repair a claude-question reply from a STALE RUNNING daemon that predates
      // `hookEventName` in the answer envelope (Claude Code discards the whole
      // hook output without it — tg#5741); anything else passes through verbatim.
      console.log(repairClaudeQuestionReply(req, output) ?? output)
    } else {
      // No usable reply: the harness UI takes over. Say exactly what happened — posted
      // then expired, dropped (with the daemon's reason), timed out, or unreachable —
      // because the asking agent acts on this line (tg-cli#317).
      log(describeAskOutcome(req, attempt))
    }
    return
  }

  // Multi-question (claude AskUserQuestion, 2-4 questions): one SEQUENTIAL card
  // per question — the next card posts only after the previous answer — then ONE
  // combined PreToolUse reply with the full answers record, so the tool completes
  // with no local dialog and no manual Enter (tg#5741). ALL-OR-NOTHING: any
  // decline/timeout emits nothing and the local UI re-asks everything (a partial
  // answers record would silently skip the unanswered questions).
  const answers = await collectQuestionAnswers(reqs, (r) => askDaemonOnce(ctx, r, deadline).then((a) => a.raw))
  const toolInput = reqs[0].toolInput
  if (answers && toolInput) {
    console.log(JSON.stringify(buildClaudeQuestionAnswerOutput(toolInput, answers)))
  } else {
    log(
      `ask-forward multi-question not-completed: req=${reqs[0].requestId} n=${reqs.length} pane=${reqs[0].paneId ?? "-"} — declined, timed out, or partial; local UI takes over`,
    )
  }
}

// Generic blocking approval (tg-cli#149): `tg-ctl ask "<question>"` posts an
// Approve/Reject card and waits. Only a verified Telegram tap exits 0; reject,
// timeout, an unreachable daemon or a malformed reply exit 1 (fail closed).
async function runGenericAsk(ctx: Ctx, question: string, timeout: GenericAskTimeout): Promise<number> {
  if (timeout.warning) console.error(`tg-ctl ask: ${timeout.warning}`)
  const req: ButtonRequest = {
    requestId: crypto.randomUUID(),
    agent: "claude",
    kind: "permission",
    question,
    cwd: process.cwd(),
    // The daemon keeps the card a margin past the client's own deadline, so the
    // client's timeout is the one that fires; clamped to the daemon's 15-min cap.
    timeoutMs: genericAskDaemonAbandonMs(timeout.seconds),
    origin: { agent: GENERIC_ASK_ORIGIN_AGENT },
    asker: askerIdentity(),
  }
  log(`generic-ask requested: requestId=${req.requestId} timeoutS=${timeout.seconds} cwd=${req.cwd}`)
  withdrawOnSignal(ctx, [req.requestId])
  const attempt = await oneAskAttempt(ctx, JSON.stringify(req), timeout.seconds * 1000)
  if (attempt.kind === "dropped") {
    console.error("denied: daemon unreachable — is it running? try `tg-ctl start`")
    log(`generic-ask denied: requestId=${req.requestId} reason=daemon-unreachable`)
    return 1
  }
  if (attempt.kind === "timeout") {
    console.error(`denied: timeout after ${timeout.seconds}s`)
    log(`generic-ask denied: requestId=${req.requestId} reason=timeout`)
    return 1
  }
  const verdict = resolveGenericAskVerdict(attempt.raw)
  if (verdict.exitCode === 0) {
    console.log(verdict.detail ? `approved: ${verdict.detail}` : "approved")
    log(`generic-ask approved: requestId=${req.requestId}`)
    return 0
  }
  console.error(verdict.reason)
  log(`generic-ask denied: requestId=${req.requestId} reason=${verdict.reason}`)
  return 1
}

// One withdraw line to the daemon (tg-cli#705): resolves with how many cards it closed, or
// null when the daemon could not be reached or did not answer within `timeoutMs` (an older
// daemon replies `null` to a line it does not know).
function sendWithdrawLine(ctx: Ctx, line: Record<string, string>, timeoutMs: number): Promise<number | null> {
  const { promise, resolve } = Promise.withResolvers<number | null>()
  let raw = ""
  const socket = createConnection(ctx.paths.socket)
  const timer = setTimeout(() => {
    socket.destroy()
    resolve(null)
  }, timeoutMs)
  socket.setEncoding("utf8")
  socket.on("connect", () => socket.write(`${JSON.stringify(line)}\n`))
  socket.on("data", (chunk) => {
    raw += chunk
  })
  // 'close' follows 'error' too; the first resolve wins.
  socket.on("close", () => {
    clearTimeout(timer)
    let closed: unknown
    try {
      const reply: unknown = JSON.parse(raw.trim())
      closed = reply && typeof reply === "object" ? (reply as Record<string, unknown>).closed : undefined
    } catch {
      closed = undefined
    }
    resolve(typeof closed === "number" ? closed : null)
  })
  socket.on("error", () => {})
  return promise
}

// How long a stopping asker waits for its withdraw to land before it exits anyway.
const WITHDRAW_ON_SIGNAL_MS = 1500
const SIGNAL_NUMBERS: Record<"SIGHUP" | "SIGINT" | "SIGTERM", number> = { SIGHUP: 1, SIGINT: 2, SIGTERM: 15 }

// An asker stopped while it waits (its harness gave up on the hook, the terminal closed,
// Ctrl-C) withdraws its cards so they leave the chat and the 📥 Inbox instead of waiting for a
// Dismiss (tg-cli#705). Best effort: SIGKILL cannot be caught — the daemon then only sees the
// socket close and the card stays open. Exits with the conventional 128+signal status; the
// withdraw itself ends the ask with a `null` reply, so the ask entrypoint awaits
// `signalExit` before its own exit and the signal status wins.
let signalExit: Promise<unknown> | null = null
function withdrawOnSignal(ctx: Ctx, requestIds: readonly string[]): void {
  for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"] as const) {
    process.on(signal, () => {
      if (signalExit) return
      const reason = `the asking process was stopped (${signal})`
      signalExit = Promise.all(requestIds.map((id) => sendWithdrawLine(ctx, { withdraw: id, reason }, WITHDRAW_ON_SIGNAL_MS))).finally(() =>
        process.exit(128 + SIGNAL_NUMBERS[signal]),
      )
    })
  }
}

// tg-cli#717: whoever asked waits on our stdout. If it dies (a `gh ship` killed by its timeout)
// we are reparented and nobody can use the answer: withdraw the cards that are no longer
// relevant (tg-cli#705) and exit, instead of a critical ask waiting forever with its card open.
// The exit closes the socket, which retires anything not withdrawn.
function withdrawWhenOrphaned(ctx: Ctx, requestIds: readonly string[]): void {
  const askerPid = process.ppid
  setInterval(() => {
    // ppid 1: the asker may already be gone before this process read its ppid.
    if (signalExit || (process.ppid === askerPid && process.ppid !== 1)) return
    log(`ask-forward orphaned: asker pid ${askerPid} exited — withdrawing`)
    const reason = "the asking process exited"
    signalExit = Promise.all(requestIds.map((id) => sendWithdrawLine(ctx, { withdraw: id, reason }, WITHDRAW_ON_SIGNAL_MS))).finally(() =>
      process.exit(0),
    )
  }, ORPHAN_CHECK_MS).unref()
}

// `tg-ctl withdraw <requestId> | --hook-id <id> [--cwd <dir>] [--reason <text>]` — close cards
// whose question is no longer relevant (tg-cli#705), for wrappers like the agent-tools hatch
// helper. Exit 0: at least one card closed; 1: no open card matched; 2: usage; 69: the daemon
// is not reachable.
async function runWithdrawCommand(ctx: Ctx, argv: readonly string[]): Promise<number> {
  const parsed = parseWithdrawArgv(argv)
  if ("error" in parsed) {
    console.error(`tg-ctl withdraw: ${parsed.error}\n${WITHDRAW_USAGE}`)
    return 2
  }
  const closed = await sendWithdrawLine(ctx, parsed.line, 5000)
  if (closed === null) {
    console.error("tg-ctl withdraw: the daemon is not reachable (or predates withdraw) — is it running? try `tg-ctl start`")
    return 69
  }
  console.log(closed === 0 ? "no open question matched" : `withdrawn: ${closed} card${closed === 1 ? "" : "s"}`)
  return closed === 0 ? 1 : 0
}

function codexConfigDir(home: string): string {
  const override = process.env.CODEX_HOME?.trim()
  return override ? override : join(home, ".codex")
}

async function readStdinText(): Promise<string> {
  return await new Promise((resolve, reject) => {
    let out = ""
    process.stdin.setEncoding("utf8")
    process.stdin.on("data", (chunk) => {
      out += chunk
    })
    process.stdin.on("end", () => resolve(out))
    process.stdin.on("error", reject)
  })
}

// --- /tasks command (#115): compose task-cli + gh into a rich board table ---

// The pane of the CTO's OWN last resolved inbound delivery (tg-cli#78 anchor
// fix) — shared by the daemon's discoverForInject (message routing) AND
// resolveTasksScopeDir below (`/tasks` default scoping), so both use the SAME
// anchor rather than `/tasks` falling back to the old `lastMessagePane` (any
// pane's last outbound send) after the routing path already moved on to this
// one (review finding: the two surfaces silently disagreeing on "the default
// target" is the exact class of bug tg-cli#78 fixed for inbound routing).
//
// Guards against tmux pane-ID reuse (mirrors routeMatchesPane's reply-route
// protection): a recognized paneId is trusted only if its recorded cwd still
// matches the LIVE candidate's path. A stale/mismatched anchor returns null
// rather than risk mis-routing into a different project that now happens to
// own that pane id.
function resolveLastUserTarget(ctx: Ctx, candidates: TargetPane[]): TargetPane | null {
  const anchor = parseLastUserTarget(readFileOrNull(ctx.paths.lastUserTarget))
  if (!anchor) return null
  // A keyed anchor follows its session (spec §2.4); a gone one never falls back
  // to its old pane, which may host a different session now.
  const target = resolveAnchorTarget(anchor, currentSessionRegistry())
  if (!target) return null
  const hit = candidates.find((c) => c.pane.paneId === target.paneId)
  if (!hit) return null
  return anchorProven(target) || routeMatchesPane({ recognizedCwd: anchor.cwd, panePath: hit.pane.panePath }) ? hit : null
}

// Only a registry this daemon scanned itself may vouch for a pane and skip the
// cwd guard: the persisted one read before the first scan can predate a tmux
// restart that reused the pane id.
function anchorProven(target: { proven: boolean }): boolean {
  return target.proven && sessionRegistryScanned
}

// Same anchor lookup as resolveLastUserTarget, but against the merged
// tmux+omp AgentCandidate view (listAgentCandidates()) instead of the
// tmux-only TargetPane view — used by injectViaTarget's no-tmux-pane
// fallback so the tg-cli#78 anchor also covers out-of-tmux omp agents
// (tg-cli#369).
function resolveLastUserTargetCandidate(ctx: Ctx, candidates: AgentCandidate[]): AgentCandidate | null {
  const anchor = parseLastUserTarget(readFileOrNull(ctx.paths.lastUserTarget))
  if (!anchor) return null
  const target = resolveAnchorTarget(anchor, currentSessionRegistry())
  if (!target) return null
  const hit = candidates.find((c) => c.paneId === target.paneId)
  if (!hit) return null
  return anchorProven(target) || routeMatchesPane({ recognizedCwd: anchor.cwd, panePath: hit.panePath }) ? hit : null
}

// Resolve a `/tasks [<agent>]` selector to the relevant project dir. With no
// selector, replies target the replied-to agent, otherwise the command uses the
// same default target the daemon would route an inbound message to. Ambiguous
// fleets without a reply/last-message signal fail explicitly instead of guessing.
function resolveTasksScopeDir(ctx: Ctx, action: Pick<Extract<Action, { kind: "tasks" }>, "agent" | "replyToMessageId" | "threadId">): string | null {
  const regs = readRegistrations(ctx.paths)
  if (action.agent) {
    const m = matchWindows(action.agent, listAgentCandidates())
    if (!m.confident) return null
    const pane = m.matches[0]
    return pane?.panePath || (pane ? registeredCwdForPane(regs, pane) : null)
  }
  if (action.threadId !== null && action.threadId !== undefined) {
    const topic = findTopic(parseTopics(readFileOrNull(ctx.paths.topics)), action.threadId)
    return topic?.path ?? null
  }
  const routes = parseRoutes(readFileOrNull(ctx.paths.routes))
  if (action.replyToMessageId !== null) {
    const recognized = recognizeRoute(routes, action.replyToMessageId)
    if (recognized?.cwd) return recognized.cwd
  }
  // Ambiguous fleet, no reply/thread anchor: use the SAME default-target anchor
  // the daemon's inbound routing uses (tg-cli#78) rather than the old
  // `lastMessagePane` (whoever spoke last, routes.json) — the two surfaces
  // silently disagreeing on "the default target" was the review finding this
  // replaces. No further fallback: an unresolved anchor stays ambiguous here
  // too, exactly mirroring discoverForInject's own picker fallback.
  const target = discoverTarget(ctx)
  let routed: DiscoverResult = target
  if (!target.ok && target.reason === "ambiguous") {
    const anchor = resolveLastUserTarget(ctx, target.candidates)
    if (anchor) routed = { ok: true, target: anchor }
  }
  if (routed.ok) return routed.target.pane.panePath || registeredCwdForPane(regs, routed.target.pane)
  if (routed.reason === "no-agent") return singleRegisteredCwd(regs)
  return null
}

async function loadTasks(scopeDir: string | null, status: string | null, includeUnfiltered: boolean): Promise<TaskItem[]> {
  if (status) return loadTaskList(scopeDir, status)
  // task-cli scoped JSON does not provide a reliable "all lifecycle states" view, so the board fans out by canonical state.
  // The explicit All view also merges an unfiltered call so custom states stay visible when task-cli reports them.
  const states: Array<string | null> = includeUnfiltered ? [null, ...TASK_STATES] : [...TASK_STATES]
  const lists = await Promise.all(states.map((state) => loadTaskList(scopeDir, state)))
  const out: TaskItem[] = []
  const seen = new Set<string>()
  for (const task of lists.flat()) {
    const key = taskKey(task)
    if (seen.has(key)) continue
    seen.add(key)
    out.push(task)
  }
  return out
}

async function loadTaskList(scopeDir: string | null, status: string | null): Promise<TaskItem[]> {
  const argv = ["task", "list", "--json", "--no-pager", "-n", "100"]
  if (status) argv.push("--state", status)
  if (scopeDir) argv.push("-C", scopeDir)
  const r = await spawnGuarded(argv, 15_000)
  if (r.exitCode !== 0) {
    log(`/tasks: 'task list' failed (${r.exitCode}): ${r.stderr.slice(0, 200)}`)
    return []
  }
  try {
    const parsed = JSON.parse(r.stdout)
    return flattenTaskListJson(parsed)
  } catch {
    return []
  }
}

function flattenTaskListJson(parsed: unknown): TaskItem[] {
  if (!Array.isArray(parsed)) return []
  const out: TaskItem[] = []
  for (const item of parsed) {
    if (!item || typeof item !== "object") continue
    const rec = item as { id?: unknown; project?: unknown; tickets?: unknown }
    if (typeof rec.id === "string") {
      out.push({ ...(item as TaskItem), project: typeof rec.project === "string" ? rec.project : undefined })
      continue
    }
    if (typeof rec.project !== "string" || !Array.isArray(rec.tickets)) continue
    for (const ticket of rec.tickets) {
      if (!ticket || typeof ticket !== "object" || typeof (ticket as { id?: unknown }).id !== "string") continue
      out.push({ ...(ticket as TaskItem), project: rec.project })
    }
  }
  return out
}

async function loadPrRefs(scopeDir: string | null): Promise<PrRef[]> {
  const argv = ["gh", "pr", "list", "--state", "all", "--limit", "100", "--json", "number,title,url,body,statusCheckRollup,reviewDecision,isDraft"]
  const r = await spawnGuarded(argv, 20_000, scopeDir ? { cwd: scopeDir } : {})
  if (r.exitCode !== 0) {
    log(`/tasks: 'gh pr list' failed (${r.exitCode}): ${r.stderr.slice(0, 200)}`)
    return []
  }
  try {
    const parsed = JSON.parse(r.stdout)
    if (!Array.isArray(parsed)) return []
    return parsed
      .filter((p) => p && typeof p.number === "number")
      .map((p) => {
        const url = typeof p.url === "string" ? p.url : ""
        return {
          number: p.number,
          url,
          title: p.title ?? "",
          body: p.body ?? "",
          ci: rollupCiState(p.statusCheckRollup),
          review: rollupReviewState(p.reviewDecision, p.isDraft),
          project: projectFromPrUrl(url),
        }
      })
  } catch {
    return []
  }
}

function projectFromPrUrl(rawUrl: string): string | undefined {
  try {
    const url = new URL(rawUrl)
    const parts = url.pathname.split("/").filter(Boolean)
    const pullIndex = parts.indexOf("pull")
    if (pullIndex < 2) return undefined
    return `${parts[pullIndex - 2]}/${parts[pullIndex - 1]}`
  } catch {
    return undefined
  }
}

interface TaskBoardState {
  scopeDir: string | null
  agent: string | null
  status: string | null
  threadId: number | null
}

// Best-effort in-memory callback scope; a daemon restart intentionally expires old /tasks boards.
const taskBoardStates = new Map<string, TaskBoardState>()
const MAX_TASK_BOARD_STATES = 50

function taskBoardStateKey(chatId: number | string, messageId: number): string {
  return `${chatId}:${messageId}`
}

function rememberTaskBoardState(chatId: number | string, messageId: number | null, state: TaskBoardState): void {
  if (messageId === null) return
  const key = taskBoardStateKey(chatId, messageId)
  taskBoardStates.delete(key)
  taskBoardStates.set(key, state)
  while (taskBoardStates.size > MAX_TASK_BOARD_STATES) {
    const first = taskBoardStates.keys().next().value
    if (typeof first !== "string") break
    taskBoardStates.delete(first)
  }
}

async function runTasksCommand(ctx: Ctx, action: Extract<Action, { kind: "tasks" }>): Promise<void> {
  const prior = priorTaskBoardState(ctx, action)
  if (action.callbackQueryId && !prior) {
    await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
    return
  }
  if (action.callbackQueryId) await answerCallbackQuery(ctx, action.callbackQueryId, "updating")
  const scopeDir = prior ? prior.scopeDir : resolveTasksScopeDir(ctx, action)
  const agent = prior ? prior.agent : action.agent
  const status = taskBoardStatusForAction(action, prior)
  const threadId = prior ? prior.threadId : action.threadId ?? null
  const messageContext: { message_thread_id?: number; reply_parameters?: { message_id: number } } = {}
  if (threadId !== null) messageContext.message_thread_id = threadId
  if (!action.callbackQueryId && action.replyToMessageId !== null) messageContext.reply_parameters = { message_id: action.replyToMessageId }
  if (!scopeDir && !action.callbackQueryId) {
    const suffix = agent ? ` for /tasks ${agent}` : " for /tasks"
    await sendMessage(ctx, `couldn't resolve a project${suffix} — reply to an agent message or use /tasks <agent>`, messageContext)
    return
  }
  const viewOptions = tasksViewOptions(action, status)
  const [tasks, prs] = await Promise.all([loadTasks(scopeDir, status, viewOptions.view === "all" && status === null), scopeDir ? loadPrRefs(scopeDir) : Promise.resolve([])])
  const prsByTask = matchPrsToTasks(tasks, prs)
  const view = composeTasksView(annotateTasksWithAgents(tasks, agent), prsByTask, { agent, status }, viewOptions)
  const sent = await sendRich(ctx, view.html, { ...messageContext, reply_markup: view.reply_markup })
  rememberTaskBoardState(ctx.chatId, sent, { scopeDir, agent, status, threadId })
  if (sent === null) await sendMessage(ctx, "couldn't render the task board — see the daemon log", messageContext)
}

function priorTaskBoardState(ctx: Ctx, action: Extract<Action, { kind: "tasks" }>): TaskBoardState | undefined {
  if (!action.callbackQueryId || action.messageId == null) return undefined
  if (action.chatId == null || String(action.chatId) !== String(ctx.chatId)) return undefined
  return taskBoardStates.get(taskBoardStateKey(action.chatId, action.messageId))
}

function taskBoardStatusForAction(action: Extract<Action, { kind: "tasks" }>, prior: TaskBoardState | undefined): string | null {
  if (!prior) return action.status
  // Filter taps switch back to the full lifecycle view, dropping any prior /tasks <status> scope.
  return action.callbackKind === "filter" ? null : prior.status
}

function tasksViewOptions(action: Extract<Action, { kind: "tasks" }>, status: string | null): { view: TaskViewFilter; page: number; pageSize: number; label?: string } {
  const view = isTaskViewFilter(action.view) ? action.view : status ? "all" : DEFAULT_TASK_VIEW
  return { view, page: action.page ?? 0, pageSize: TASKS_PAGE_SIZE, label: status ? taskStatusViewLabel(status) : undefined }
}

function taskStatusViewLabel(status: string): string {
  switch (status) {
    case "done":
      return "Done"
    case "in-progress":
    case "in-review":
      return "Active"
    case "todo":
      return "Ready"
    case "cancelled":
      return "Cancelled"
    default:
      return status
        .split(/[-_\s]+/)
        .filter(Boolean)
        .map((part) => `${part.slice(0, 1).toUpperCase()}${part.slice(1)}`)
        .join(" ")
  }
}

function annotateTasksWithAgents(tasks: TaskItem[], fallbackAgent: string | null): TaskItem[] {
  const candidates = listAgentCandidates()
  return tasks.map((task) => {
    const agent = task.agent || fallbackAgent || agentForTaskProject(task, candidates)
    return agent ? { ...task, agent } : task
  })
}

function agentForTaskProject(task: TaskItem, candidates: AgentCandidate[]): string | null {
  const short = task.project ? shortProjectName(task.project) : null
  if (!short) return null
  const matches = candidates.filter((candidate): candidate is AgentCandidate & { panePath: string } => Boolean(candidate.panePath) && basename(candidate.panePath) === short)
  if (matches.length !== 1) return null
  const match = matches[0]
  return isBareWindowName(match.windowName) ? basename(match.panePath) : match.windowName
}

// --- harness-event subcommand (#113): notify on a StopFailure hook ---

interface HarnessEventFlags {
  dryRun: boolean
  paneId: string | null
  agent: string | null
  windowName: string | null
  reason: string | null
  resetAtIso: string | null
  sourceMessageId: number | null
  transcriptPath: string | null
  language: string | null
}

function parseHarnessEventFlags(argv: string[]): HarnessEventFlags {
  const flags: HarnessEventFlags = {
    dryRun: false,
    paneId: process.env.TMUX_PANE ?? null,
    agent: null,
    windowName: null,
    reason: null,
    resetAtIso: null,
    sourceMessageId: null,
    transcriptPath: null,
    language: null,
  }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    const next = (): string => argv[++i] ?? ""
    if (a === "--dry-run") flags.dryRun = true
    else if (a === "--pane") flags.paneId = next()
    else if (a === "--agent") flags.agent = next()
    else if (a === "--window-name") flags.windowName = next()
    else if (a === "--reason") flags.reason = next()
    else if (a === "--reset-at") flags.resetAtIso = next()
    else if (a === "--source-message-id") flags.sourceMessageId = Number(next()) || null
    else if (a === "--transcript") flags.transcriptPath = next()
    else if (a === "--language" || a === "--lang" || a === "--locale") flags.language = next()
  }
  return flags
}

function strField(obj: unknown, key: string): string {
  const v = obj && typeof obj === "object" ? (obj as Record<string, unknown>)[key] : undefined
  return typeof v === "string" ? v : ""
}

const USAGE_WARNING_COOLDOWN_MS = 60 * 60_000
const USAGE_WARNING_STORE_MAX = 100
const USAGE_LATEST_NO_RESET_MAX_AGE_MS = 24 * 60 * 60_000

interface UsageWarningRecord {
  key: string
  lastSentAt: number
  resetAt: number | null
}

interface UsageLatestRecord {
  agent: string
  limitName: string | null
  percent: number
  resetAt: number | null
  language: string
  detail: string
  sampledAt: number
}

interface OverloadRetryRecord {
  key: string
  attempt: number
  pid: number | null
  lastFailureAt: number
  nextAt: number
}

const OVERLOAD_RETRY_RESET_MS = 30 * 60_000
const OVERLOAD_RETRY_STORE_MAX = 100
const OVERLOAD_AUTO_CONTINUE_MAX_ATTEMPTS = 8
const OVERLOAD_RETRY_LOCK_ATTEMPTS = 200
const OVERLOAD_RETRY_LOCK_DELAY_MS = 10

function usageWarningKey(ev: UsageLimitEvent): string {
  return JSON.stringify([ev.agent, ev.limitName ?? ""])
}

function usageWarningLockPath(path: string): string {
  return `${path}.lock`
}

function usageLatestKey(rec: Pick<UsageLatestRecord, "agent" | "limitName">): string {
  return JSON.stringify([rec.agent, rec.limitName ?? ""])
}

function usageLatestLockPath(path: string): string {
  return `${path}.lock`
}

function overloadRetryLockPath(path: string): string {
  return `${path}.lock`
}

function overloadRetryKey(ev: HarnessFailureEvent, windowName: string): string {
  return JSON.stringify([ev.paneId ?? "", ev.sessionId ?? "", windowName])
}

function overloadRetryScope(key: string): { paneId: string; windowName: string } | null {
  try {
    const parsed = JSON.parse(key) as unknown
    if (!Array.isArray(parsed)) return null
    if (parsed.length >= 3 && typeof parsed[0] === "string" && typeof parsed[2] === "string") {
      return { paneId: parsed[0], windowName: parsed[2] }
    }
    if (parsed.length === 2 && typeof parsed[0] === "string" && typeof parsed[1] === "string") {
      return { paneId: parsed[0], windowName: parsed[1] }
    }
  } catch {
    return null
  }
  return null
}

function overloadRetrySameScope(rec: OverloadRetryRecord, paneId: string, windowName: string): boolean {
  const scope = overloadRetryScope(rec.key)
  return scope !== null && scope.paneId === paneId && scope.windowName === windowName
}

function parseUsageLatestRecordsRaw(blob: string | null): UsageLatestRecord[] {
  if (!blob) return []
  try {
    const parsed = JSON.parse(blob) as { samples?: unknown }
    if (!Array.isArray(parsed.samples)) return []
    return parsed.samples
      .filter((item): item is UsageLatestRecord => {
        if (!item || typeof item !== "object") return false
        const rec = item as Record<string, unknown>
        const resetAt = rec.resetAt
        return (
          typeof rec.agent === "string" &&
          (rec.limitName === null || typeof rec.limitName === "string") &&
          typeof rec.percent === "number" &&
          Number.isFinite(rec.percent) &&
          rec.percent >= 0 &&
          rec.percent <= 100 &&
          (resetAt === null || (typeof resetAt === "number" && Number.isFinite(resetAt) && resetAt > 0)) &&
          typeof rec.language === "string" &&
          typeof rec.detail === "string" &&
          typeof rec.sampledAt === "number" &&
          Number.isFinite(rec.sampledAt) &&
          rec.sampledAt > 0
        )
      })
  } catch {
    return []
  }
}

function parseUsageLatestRecords(blob: string | null, now: number): UsageLatestRecord[] {
  return parseUsageLatestRecordsRaw(blob)
    .filter((rec) => (rec.resetAt !== null ? rec.resetAt > now : rec.sampledAt > now - USAGE_LATEST_NO_RESET_MAX_AGE_MS))
}

function parseOverloadRetryRecords(blob: string | null, now: number): OverloadRetryRecord[] {
  if (!blob) return []
  try {
    const parsed = JSON.parse(blob) as { retries?: unknown }
    if (!Array.isArray(parsed.retries)) return []
    const records: OverloadRetryRecord[] = []
    for (const item of parsed.retries) {
      if (!item || typeof item !== "object") continue
      const rec = item as Record<string, unknown>
      const pid = rec.pid
      if (
        typeof rec.key !== "string" ||
        typeof rec.attempt !== "number" ||
        !Number.isInteger(rec.attempt) ||
        rec.attempt <= 0 ||
        typeof rec.lastFailureAt !== "number" ||
        !Number.isFinite(rec.lastFailureAt) ||
        rec.lastFailureAt <= 0 ||
        typeof rec.nextAt !== "number" ||
        !Number.isFinite(rec.nextAt) ||
        rec.nextAt <= 0 ||
        !(pid === undefined || pid === null || (typeof pid === "number" && Number.isInteger(pid) && pid > 0))
      ) {
        continue
      }
      records.push({
        key: rec.key,
        attempt: rec.attempt,
        pid: typeof pid === "number" ? pid : null,
        lastFailureAt: rec.lastFailureAt,
        nextAt: rec.nextAt,
      })
    }
    return records
      .filter((rec) => rec.lastFailureAt > now - 24 * OVERLOAD_RETRY_RESET_MS)
      .slice(-OVERLOAD_RETRY_STORE_MAX)
  } catch {
    return []
  }
}

function writeOverloadRetryRecords(path: string, records: OverloadRetryRecord[]): void {
  atomicWrite(path, `${JSON.stringify({ version: 1, retries: records.slice(-OVERLOAD_RETRY_STORE_MAX) })}\n`)
}

function runtimeOverloadAutoContinueDelayMs(delayMs: number): number {
  const raw = Number(process.env.TG_CTL_OVERLOAD_AUTO_CONTINUE_TEST_DELAY_MS)
  if (Number.isFinite(raw) && raw >= 1000) return raw
  return delayMs
}

function overloadRetryChildAlive(rec: OverloadRetryRecord): boolean {
  if (rec.pid === null) return false
  const match = overloadRetryChildMatchState(rec.pid, rec.key)
  return match === true || match === null
}

function terminateSpawnedRetry(pid: number): void {
  try {
    process.kill(pid, "SIGTERM")
  } catch {
    /* best effort: the child may already have exited */
  }
}

function overloadRetryChildMatches(pid: number, retryKey: string): boolean {
  return overloadRetryChildMatchState(pid, retryKey) === true
}

function overloadRetryChildMatchState(pid: number, retryKey: string): boolean | null {
  if (!kill0(pid)) return false
  const proc = Bun.spawnSync(["ps", "-ww", "-p", String(pid), "-o", "command="], { stdout: "pipe", stderr: "ignore" })
  if (proc.exitCode !== 0) return null
  const command = new TextDecoder().decode(proc.stdout).trim()
  return command.includes("auto-continue-once") && command.includes("--retry-key") && command.includes(retryKey)
}

function finishOverloadRetryRecord(records: OverloadRetryRecord[], retryKey: string, pid: number, now: number): OverloadRetryRecord[] {
  return records.map((rec) => (rec.key === retryKey && rec.pid === pid ? { ...rec, pid: null, nextAt: now } : rec))
}

function claimOverloadAutoContinue(
  ctx: Ctx,
  ev: HarnessFailureEvent,
  now: number,
  language: string | null,
  windowName: string | null,
): TransientAutoContinuePlan | null {
  if (!ev.paneId || !windowName) return null
  const paneId = ev.paneId
  try {
    const claimed = withRoutesLock(
      fsRoutesLockIo(overloadRetryLockPath(ctx.paths.overloadRetries)),
      () => {
        const key = overloadRetryKey(ev, windowName)
        const records = parseOverloadRetryRecords(readFileOrNull(ctx.paths.overloadRetries), now)
        const prev = records.find((rec) => rec.key === key)
        if (prev && prev.nextAt > now && overloadRetryChildAlive(prev)) return null
        const rearmingLostChild = Boolean(prev && prev.nextAt > now)
        if (!rearmingLostChild && prev && prev.lastFailureAt > now - OVERLOAD_RETRY_RESET_MS && prev.attempt >= OVERLOAD_AUTO_CONTINUE_MAX_ATTEMPTS) {
          return null
        }
        const attempt = rearmingLostChild && prev
          ? prev.attempt
          : prev && prev.lastFailureAt > now - OVERLOAD_RETRY_RESET_MS
            ? prev.attempt + 1
            : 1
        const built = buildTransientAutoContinue(ev, { attempt, language })
        if (!built) return null
        const plan = { ...built, delayMs: runtimeOverloadAutoContinueDelayMs(built.delayMs) }
        const spawned = spawnDelayedAutoContinue(ctx, ev, plan, windowName, key)
        if (!spawned) return null
        const replaced = records.filter((rec) => overloadRetrySameScope(rec, paneId, windowName))
        const next = records.filter((rec) => !overloadRetrySameScope(rec, paneId, windowName))
        next.push({
          key,
          attempt,
          pid: spawned.pid,
          lastFailureAt: now,
          nextAt: now + plan.delayMs,
        })
        try {
          writeOverloadRetryRecords(ctx.paths.overloadRetries, next)
        } catch (err) {
          terminateSpawnedRetry(spawned.pid)
          throw err
        }
        for (const rec of replaced) {
          if (rec.pid !== null && rec.pid !== spawned.pid && overloadRetryChildMatches(rec.pid, rec.key)) terminateSpawnedRetry(rec.pid)
        }
        return plan
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
    return claimed ?? null
  } catch (err) {
    log(`harness-event: overload auto-continue claim failed: ${err}`)
    return null
  }
}

function writeUsageLatestRecords(path: string, records: UsageLatestRecord[]): void {
  atomicWrite(path, `${JSON.stringify({ version: 1, samples: records })}\n`)
}

function recordUsageLatest(path: string, events: UsageLimitEvent[], now: number): void {
  if (events.length === 0) return
  try {
    withRoutesLock(
      fsRoutesLockIo(usageLatestLockPath(path)),
      () => {
        const byKey = new Map<string, UsageLatestRecord>()
        for (const rec of parseUsageLatestRecords(readFileOrNull(path), now)) byKey.set(usageLatestKey(rec), rec)
        for (const ev of events) {
          const rec: UsageLatestRecord = {
            agent: ev.agent,
            limitName: ev.limitName,
            percent: ev.percent,
            resetAt: ev.resetAt,
            language: ev.language,
            detail: ev.detail,
            sampledAt: now,
          }
          byKey.set(usageLatestKey(rec), rec)
        }
        writeUsageLatestRecords(path, [...byKey.values()].sort(compareUsageLatestRecords))
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
  } catch (err) {
    log(`harness-event: usage latest store failed: ${err}`)
  }
}

function latestRecentUsageLatest(path: string, agent: string, now: number): UsageLatestRecord | null {
  const normalized = agent.trim().toLowerCase()
  return parseUsageLatestRecords(readFileOrNull(path), now)
    .filter((rec) => rec.agent.toLowerCase() === normalized)
    .sort((a, b) => b.sampledAt - a.sampledAt || b.percent - a.percent)[0] ?? null
}

function latestAnyUsageLatest(path: string, agent: string): UsageLatestRecord | null {
  const normalized = agent.trim().toLowerCase()
  return parseUsageLatestRecordsRaw(readFileOrNull(path))
    .filter((rec) => rec.agent.toLowerCase() === normalized)
    .sort((a, b) => b.sampledAt - a.sampledAt || b.percent - a.percent)[0] ?? null
}

function compareUsageLatestRecords(a: UsageLatestRecord, b: UsageLatestRecord): number {
  const agent = a.agent.localeCompare(b.agent)
  if (agent !== 0) return agent
  return usageLimitRank(a.limitName) - usageLimitRank(b.limitName) || (a.limitName ?? "").localeCompare(b.limitName ?? "")
}

function usageLimitRank(limitName: string | null): number {
  if (limitName === "5-hour") return 0
  if (limitName === "weekly") return 1
  if (limitName === "context window") return 2
  if (limitName === "primary") return 3
  if (limitName === "secondary") return 4
  return 10
}

function formatUsagePercent(percent: number): string {
  return Number.isInteger(percent) ? String(percent) : percent.toFixed(1).replace(/\.0$/, "")
}

function composeLimitStatus(ctx: Ctx, agentFilter: string | null, now = Date.now()): string {
  const filter = agentFilter?.trim().toLowerCase() || null
  const records = parseUsageLatestRecords(readFileOrNull(ctx.paths.usageLatest), now)
    .filter((rec) => !filter || rec.agent.toLowerCase() === filter)
    .sort(compareUsageLatestRecords)
  const scope = filter ? ` for ${filter}` : ""
  if (records.length === 0) {
    return `No recent limit telemetry${scope}. Run tg-ctl install-hooks and wait for the agent statusLine/harness telemetry to report.`
  }
  const lines = [`Latest limits${scope}:`]
  let currentAgent = ""
  for (const rec of records) {
    if (rec.agent !== currentAgent) {
      currentAgent = rec.agent
      lines.push(`${rec.agent}:`)
    }
    const limit = rec.limitName ?? "limit"
    const reset = rec.resetAt !== null ? ` · resets ${formatClock(rec.resetAt)} (in ${formatDelta(rec.resetAt - now)})` : ""
    const sampled = ` · updated ${formatDelta(now - rec.sampledAt)} ago`
    lines.push(`- ${limit}: ${formatUsagePercent(rec.percent)}%${reset}${sampled}`)
  }
  return lines.join("\n")
}

// /daily — shells out to `rig daily` (rig-cli's own categorized what-shipped report
// over merged PRs, source of truth `gh pr list --state merged`, never a ticket
// status). Bare `rig daily` with no flags reports since each configured repo's own
// saved watermark and advances it — exactly the semantics wanted for a repeatable
// Telegram command (a second /daily right after the first reports "nothing new",
// same as the CLI itself). 30s timeout: `gh pr list` across a couple of repos is
// normally sub-second, but a slow/rate-limited GitHub API call must not wedge the
// daemon's single event loop past a bounded ceiling (see spawnGuarded's own doc).
// `ok: false` is a failure to RUN rig (nothing was generated, no watermark moved) —
// only an `ok: true` report is worth persisting if its send later fails.
async function composeDailyReport(): Promise<{ ok: boolean; text: string }> {
  const r = await spawnGuarded(["rig", "daily"], 30_000)
  if (r.exitCode === 127) {
    return { ok: false, text: `daily: couldn't run \`rig\` (${r.stderr.trim() || "not found on PATH"}). Is rig-cli installed and on this daemon's PATH?` }
  }
  if (r.exitCode === 124) {
    return { ok: false, text: "daily: `rig daily` timed out after 30s (GitHub API slow/rate-limited?) — try again shortly." }
  }
  if (r.exitCode !== 0) {
    return { ok: false, text: `daily: \`rig daily\` failed (exit ${r.exitCode}): ${r.stderr.trim() || "no error output"}` }
  }
  const report = r.stdout.trim()
  return { ok: true, text: report || "daily: nothing new since the last report." }
}

// Send a plain-text daemon reply as ≤4096-char chunks, in order (Telegram rejects a
// longer sendMessage outright, and botPost only logs that — the user would get an ack
// and no report). Stops at the first failed chunk; returns how many were accepted so the
// caller can persist the rest.
async function sendReportChunks(ctx: Ctx, text: string, extra: Record<string, unknown>): Promise<{ chunks: string[]; delivered: number }> {
  const chunks = splitMessage(text, MESSAGE_LIMIT, "plain")
  let delivered = 0
  for (const chunk of chunks) {
    if ((await sendMessage(ctx, chunk, extra)) === null) break
    delivered++
  }
  return { chunks, delivered }
}

// /daily delivery: `rig daily` advances its watermark while GENERATING the report (rig
// has no commit-after-send verb; --dry-run/--since are read-only), so a report whose
// send fails would otherwise be lost for good — the next /daily says "nothing new". The
// undelivered tail is persisted (per bot, 0600) and prepended to the next /daily reply.
// The pending file is touched only AFTER the send is decided: overwritten (atomically)
// with the new undelivered tail on a partial send, removed only once everything went
// out. Deleting it up front would open a window (a slow `rig daily`, a daemon restart
// mid-action) where the carried report — already consumed from rig's watermark — is
// gone for good; the worst case of this ordering is a benign duplicate carry instead.
async function deliverDailyReport(ctx: Ctx, extra: Record<string, unknown>): Promise<void> {
  const pending = readFileOrNull(ctx.paths.dailyPending)
  const fresh = await composeDailyReport()
  const body = mergePendingDailyReport(pending, fresh.text)
  const { chunks, delivered } = await sendReportChunks(ctx, body, extra)
  const tail = undeliveredReportTail(chunks, delivered)
  if (tail === null) {
    if (pending !== null) unlinkGuarded(ctx.paths.dailyPending, "daily: removing the delivered pending-report file failed")
    return
  }
  // Nothing generated this time (rig failed — its watermark did not move, a plain retry
  // regenerates it): keep the carried report exactly as it was rather than persisting a
  // tail that mixes it with an error text; with nothing carried there is nothing to keep.
  const keep = fresh.ok ? tail : pending
  if (keep === null) return
  try {
    atomicWrite(ctx.paths.dailyPending, keep)
    log(`daily: send failed after ${delivered}/${chunks.length} chunks — kept the undelivered report for the next /daily`)
  } catch (err) {
    log(`daily: send failed AND persisting the undelivered report failed: ${err}`)
  }
}

function unlinkGuarded(path: string, failureNote: string): void {
  try {
    unlinkSync(path)
  } catch (err) {
    log(`${failureNote}: ${err}`)
  }
}

// /spend [day|week|month] — shells out to `rig usage --json`, rig-cli's own
// streaming aggregation over ~/.claude/projects + every ~/.claude-accounts/account-*
// (see rig-cli's riglib/usage.py). Cost is a HYPOTHETICAL estimate at published API
// list prices — these are Claude.ai subscription accounts, never a real bill; that
// disclaimer is threaded through from `rig usage` itself and repeated here so a lone
// forwarded chat message still carries it. No period arg mirrors the CLI's own
// default (both current week AND current month in one report). 30s timeout matches
// composeDailyReport's own ceiling — this is a local, hermetic file scan, not a
// network call, but a very large/first-run ~/.claude/projects tree could still take
// a few seconds and must not wedge the daemon's single event loop past a bound.
// `ok: false` is a failure to RUN rig or to read its output (no report exists) — the
// scheduled push must not treat that text as a delivered report (usage-format.ts owns
// the JSON contract + rendering, unit-tested there).
async function composeUsageReport(period: "day" | "week" | "month" | null): Promise<{ ok: boolean; text: string }> {
  const argv = period ? ["rig", "usage", "--json", "--period", period] : ["rig", "usage", "--json"]
  const r = await spawnGuarded(argv, 30_000)
  if (r.exitCode === 127) {
    return { ok: false, text: `spend: couldn't run \`rig\` (${r.stderr.trim() || "not found on PATH"}). Is rig-cli installed and on this daemon's PATH?` }
  }
  if (r.exitCode === 124) {
    return { ok: false, text: "spend: `rig usage` timed out after 30s — try again shortly." }
  }
  if (r.exitCode !== 0) {
    return { ok: false, text: `spend: \`rig usage\` failed (exit ${r.exitCode}): ${r.stderr.trim() || "no error output"}` }
  }
  return renderUsageReport(r.stdout)
}

function parseUsageWarningRecords(blob: string | null, now: number): UsageWarningRecord[] {
  if (!blob) return []
  try {
    const parsed = JSON.parse(blob) as { warnings?: unknown }
    if (!Array.isArray(parsed.warnings)) return []
    return parsed.warnings
      .filter((item): item is UsageWarningRecord => {
        if (!item || typeof item !== "object") return false
        const rec = item as Record<string, unknown>
        const resetAt = rec.resetAt
        return (
          typeof rec.key === "string" &&
          typeof rec.lastSentAt === "number" &&
          Number.isFinite(rec.lastSentAt) &&
          rec.lastSentAt > 0 &&
          (resetAt === null || (typeof resetAt === "number" && Number.isFinite(resetAt) && resetAt > 0))
        )
      })
      .filter((rec) => (rec.resetAt !== null ? rec.resetAt > now : rec.lastSentAt > now - 24 * USAGE_WARNING_COOLDOWN_MS))
      .slice(-USAGE_WARNING_STORE_MAX)
  } catch {
    return []
  }
}

function usageWarningAlreadyRecorded(records: UsageWarningRecord[], ev: UsageLimitEvent, now: number): boolean {
  const key = usageWarningKey(ev)
  const rec = records.find((item) => item.key === key)
  if (!rec) return false
  return rec.resetAt !== null || now - rec.lastSentAt < USAGE_WARNING_COOLDOWN_MS
}

function writeUsageWarningRecords(path: string, records: UsageWarningRecord[]): void {
  atomicWrite(path, `${JSON.stringify({ version: 1, warnings: records.slice(-USAGE_WARNING_STORE_MAX) })}\n`)
}

function claimUsageWarning(path: string, ev: UsageLimitEvent, now: number): boolean {
  try {
    const claimed = withRoutesLock(
      fsRoutesLockIo(usageWarningLockPath(path)),
      () => {
        const key = usageWarningKey(ev)
        const records = parseUsageWarningRecords(readFileOrNull(path), now)
        if (usageWarningAlreadyRecorded(records, ev, now)) return false
        const next = records.filter((item) => item.key !== key)
        next.push({ key, lastSentAt: now, resetAt: ev.resetAt })
        writeUsageWarningRecords(path, next)
        return true
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
    return claimed === true
  } catch (err) {
    log(`harness-event: usage warning dedupe claim failed: ${err}`)
    return false
  }
}

function clearUsageWarningClaim(path: string, ev: UsageLimitEvent, now: number): void {
  try {
    withRoutesLock(
      fsRoutesLockIo(usageWarningLockPath(path)),
      () => {
        const key = usageWarningKey(ev)
        writeUsageWarningRecords(
          path,
          parseUsageWarningRecords(readFileOrNull(path), now).filter((item) => item.key !== key),
        )
      },
      { onContended: "skip" },
    )
  } catch (err) {
    log(`harness-event: usage warning dedupe cleanup failed: ${err}`)
  }
}

function hasHarnessFailureSignal(payloadText: string, flags: HarnessEventFlags, hasUsageTelemetry = false): boolean {
  if (flags.reason || flags.resetAtIso || flags.transcriptPath) return true
  let payload: unknown = null
  try {
    payload = JSON.parse(payloadText)
  } catch {
    return payloadText.trim().length > 0
  }
  if (!payload || typeof payload !== "object") return false
  const hookEventName = strField(payload, "hook_event_name")
  return Boolean(
    hookEventName === "StopFailure" ||
      strField(payload, "reason") ||
      strField(payload, "matcher") ||
      strField(payload, "error") ||
      strField(payload, "error_type") ||
      (!hookEventName && !hasUsageTelemetry && strField(payload, "transcript_path")),
  )
}

// The failure prose from a Claude transcript (JSONL): the LAST assistant message
// text — where the synthetic session-limit / error message lives. Scanning the
// raw file would pick up per-line ISO timestamps and dump JSON into the alert;
// extractAssistantText pulls clean prose. Bounded read (tail) for a big file.
function transcriptFailureText(path: string | null): string {
  if (!path) return ""
  const raw = readFileOrNull(path)
  if (!raw) return ""
  return extractAssistantText(raw.length > 200_000 ? raw.slice(-200_000) : raw)
}

// Normalize the StopFailure payload + flags into a HarnessFailureEvent. The
// installed hook runs a BARE `tg-ctl harness-event`, so everything but the
// payload/transcript is resolved from the runtime: paneId from TMUX_PANE (flag
// default), agent from the live pane. The failure text comes from the transcript
// (prod) or an inline `message` field / plain-text stdin (tests / manual).
//
// Field names: the REAL bare-hook payload (per the StopFailure hook docs) is
// `{ error_type, error, transcript_path, ... }` — NOT `reason`/`matcher`/
// `message`/`last_message` (those only exist on our own test/manual-invocation
// shape and predate reading the real payload — PR #120 review). `error_type`
// and `error` are read as an ADDITIONAL fallback (not a replacement) so both
// shapes keep working: a bare production hook now classifies on `error_type`
// and shows the real `error` text instead of falling back to "unknown".
//
// `error_type` now feeds classifyFailure's `/limit/i` substring test (review
// round 3): today's documented StopFailure error_type enum (rate_limit,
// overloaded, authentication_failed, oauth_org_not_allowed, billing_error,
// invalid_request, model_not_found, server_error, max_output_tokens, unknown)
// has exactly ONE value containing "limit" — rate_limit — and that IS the
// auto-continue-eligible case. If a future error_type value adds "limit" to
// its name without being a resumable rate/session limit, this substring test
// would need to narrow to an exact match; revisit if the enum changes.
function buildHarnessEvent(payloadText: string, flags: HarnessEventFlags, agent: string, now: number): HarnessFailureEvent {
  let payload: unknown = null
  try {
    payload = JSON.parse(payloadText)
  } catch {
    /* non-JSON stdin (or empty) — treat it as the inline failure text */
  }
  const reason = flags.reason ?? (strField(payload, "reason") || strField(payload, "matcher") || strField(payload, "error_type"))
  const tPath = flags.transcriptPath ?? (strField(payload, "transcript_path") || null)
  // inline: an explicit message field, else plain-text (non-JSON) stdin. NEVER
  // the raw JSON payload — parseResetTime would scan JSON noise (a real bug).
  const inline = strField(payload, "message") || strField(payload, "last_message") || strField(payload, "error") || (payload === null ? payloadText : "")
  const failureText = [inline, transcriptFailureText(tPath)].filter(Boolean).join("\n")
  const extracted = extractFailure(reason, failureText, now, { agent })
  const sessionId = strField(payload, "session_id") || strField(payload, "sessionId") || null
  const explicitReset = flags.resetAtIso ? Date.parse(flags.resetAtIso) : NaN
  const resetAt = Number.isFinite(explicitReset) ? explicitReset : extracted.resetAt
  return {
    kind: resetAt !== null ? "session-limit" : extracted.kind,
    agent,
    paneId: flags.paneId,
    sessionId,
    reason: extracted.reason,
    detail: extracted.detail,
    resetAt,
    sourceMessageId: flags.sourceMessageId,
  }
}

function payloadLanguage(payloadText: string, flags: HarnessEventFlags): string | null {
  if (flags.language) return flags.language
  let payloadLanguage: string | null = null
  try {
    const payload = JSON.parse(payloadText)
    payloadLanguage =
      strField(payload, "language") ||
      strField(payload, "locale") ||
      strField(payload, "user_language") ||
      strField(payload, "userLanguage") ||
      null
  } catch {
    /* fall through to locale environment */
  }
  return payloadLanguage ?? languageFromProcessEnv(process.env)
}

function languageFromProcessEnv(env: NodeJS.ProcessEnv): string | null {
  for (const key of ["LC_ALL", "LC_MESSAGES", "LANG"]) {
    const raw = env[key]
    if (!raw) continue
    const normalized = raw.trim().toLowerCase()
    if (normalized.startsWith("ru")) return "ru"
    if (normalized.startsWith("en")) return "en"
  }
  return null
}

function formatAutoContinueDelay(ms: number): string {
  if (ms < 60_000) return `${Math.ceil(ms / 1000)}s`
  return formatDelta(ms)
}

function spawnDelayedAutoContinue(
  ctx: Ctx,
  ev: HarnessFailureEvent,
  plan: TransientAutoContinuePlan,
  windowName: string,
  retryKey: string,
): { pid: number } | null {
  if (!ev.paneId) return null
  let logFd: number | null = null
  try {
    logFd = openSync(ctx.paths.log, "a")
    const runBin = import.meta.path
    const argv = [
      process.execPath,
      runBin,
      "auto-continue-once",
      "--pane",
      ev.paneId,
      "--delay-ms",
      String(plan.delayMs),
      "--text",
      plan.text,
      "--retry-key",
      retryKey,
    ]
    argv.push("--window-name", windowName)
    const proc = Bun.spawn(argv, {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      cwd: dirname(runBin),
      env: { ...process.env, PWD: dirname(runBin), TG_CTL_CONFIG_DIR: ctx.configDir },
    })
    proc.unref()
    closeSync(logFd)
    logFd = null
    log(`harness-event: auto-continue spawned for ${ev.paneId} in ${plan.delayMs}ms (attempt ${plan.attempt})`)
    return { pid: proc.pid }
  } catch (err) {
    log(`harness-event: auto-continue spawn failed for ${ev.paneId}: ${err}`)
    return null
  } finally {
    if (logFd !== null) closeSync(logFd)
  }
}

interface AutoContinueOnceFlags {
  paneId: string | null
  delayMs: number
  text: string
  windowName: string | null
  retryKey: string | null
}

function parseAutoContinueOnceFlags(argv: string[]): AutoContinueOnceFlags {
  const flags: AutoContinueOnceFlags = { paneId: null, delayMs: 0, text: "", windowName: null, retryKey: null }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    const next = (): string => argv[++i] ?? ""
    if (a === "--pane") flags.paneId = next()
    else if (a === "--delay-ms") flags.delayMs = Number(next())
    else if (a === "--text") flags.text = next()
    else if (a === "--window-name") flags.windowName = next()
    else if (a === "--retry-key") flags.retryKey = next()
  }
  return flags
}

async function runAutoContinueOnce(ctx: Ctx, argv: string[]): Promise<number> {
  const flags = parseAutoContinueOnceFlags(argv)
  if (!flags.paneId || !flags.text || !Number.isFinite(flags.delayMs) || flags.delayMs < 0) return 2
  if (!flags.windowName) return 2
  if (!flags.retryKey) return 2
  if (flags.text !== "continue" && flags.text !== "продолжи") return 2
  if (flags.delayMs > 0) await Bun.sleep(flags.delayMs)
  // Set when the "continue" stayed typed in the box (#463); reported after the lock.
  let unsubmitted: string | null = null
  try {
    const result = withRoutesLock(
      fsRoutesLockIo(overloadRetryLockPath(ctx.paths.overloadRetries)),
      () => {
        const now = Date.now()
        const records = parseOverloadRetryRecords(readFileOrNull(ctx.paths.overloadRetries), now)
        const rec = records.find((item) => item.key === flags.retryKey)
        if (!rec || rec.pid !== process.pid) {
          log(`auto-continue-once skipped: retry state no longer matches ${flags.paneId}`)
          return 0
        }
        const finish = (code: number): number => {
          writeOverloadRetryRecords(ctx.paths.overloadRetries, finishOverloadRetryRecord(records, flags.retryKey!, process.pid, Date.now()))
          return code
        }
        const live = listAgentCandidates().find((c) => c.paneId === flags.paneId)
        if (!live || live.windowName !== flags.windowName) {
          log(`auto-continue-once skipped: ${flags.paneId} no longer hosts ${flags.windowName}`)
          return finish(0)
        }
        const res = executeInjectStepsSync(buildTextInjectPlan(flags.paneId, flags.text))
        if (!res.ok) {
          log(`auto-continue-once inject failed for ${flags.paneId}: ${res.error}`)
          if (res.unsubmitted) unsubmitted = res.error
          return finish(1)
        }
        log(`auto-continue-once fired for ${flags.paneId} (${flags.text})`)
        return finish(0)
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
    if (unsubmitted !== null) await sendMessage(ctx, unsubmitted)
    return result ?? 0
  } catch (err) {
    log(`auto-continue-once failed for ${flags.paneId}: ${err}`)
    return 1
  }
}

// The LIVE harness kind for a pane — so the bare installed hook still labels the
// notification instead of a default "agent". MUST read `.agent` (the process-tree-
// detected harness), not `.windowName`: a window's name is set once at spawn time
// (or by hand) and drifts from whatever's actually running in the pane (tg-cli#263).
function resolveAgentForPane(paneId: string | null): string {
  if (!paneId) return "agent"
  return listAgentCandidates().find((c) => c.paneId === paneId)?.agent ?? "agent"
}

function resolveWindowNameForPane(paneId: string | null): string | null {
  if (!paneId) return null
  return listAgentCandidates().find((c) => c.paneId === paneId)?.windowName ?? null
}

async function runHarnessEvent(ctx: Ctx, argv: string[], now: number): Promise<number> {
  const payloadText = await readStdinText().catch(() => "")
  return runHarnessEventPayload(ctx, argv, now, payloadText)
}

async function runHarnessEventPayload(ctx: Ctx, argv: string[], now: number, payloadText: string): Promise<number> {
  const flags = parseHarnessEventFlags(argv)
  const agent = flags.agent ?? resolveAgentForPane(flags.paneId)
  const windowName = flags.windowName ?? resolveWindowNameForPane(flags.paneId)
  const usageEvents = extractUsageLimitEvents(payloadText, { agent, language: flags.language, env: process.env, now })
  const hasSupportedUsageTelemetry = extractUsageLimitEvents(payloadText, { agent, language: flags.language, env: process.env, now: 0 }).length > 0
  if (!flags.dryRun) recordUsageLatest(ctx.paths.usageLatest, usageEvents, now)
  const sendUsageWarningIfPresent = async (): Promise<boolean> => {
    const usage = usageEvents.slice().sort((a, b) => b.percent - a.percent)[0] ?? null
    if (!usage) return false
    const notif = buildUsageLimitNotification(usage, now)
    if (!notif) {
      if (!flags.dryRun) log(`harness-event: suppressed (usage below threshold) agent=${usage.agent} percent=${usage.percent}`)
      else console.log("harness-event: SUPPRESSED (usage below 90%)")
      return true
    }
    if (flags.dryRun) {
      console.log("=== harness-event DRY-RUN (no send) ===")
      console.log(notif.text)
      return true
    }
    if (!claimUsageWarning(ctx.paths.usageWarnings, usage, now)) {
      log(`harness-event: suppressed (duplicate usage warning) agent=${usage.agent} limit=${usage.limitName ?? "-"} reset=${usage.resetAt ?? "-"}`)
      return true
    }
    const messageId = await sendMessage(ctx, notif.text, { parse_mode: "HTML" })
    if (messageId === null) clearUsageWarningClaim(ctx.paths.usageWarnings, usage, now)
    return true
  }
  const failurePayload = hasHarnessFailureSignal(payloadText, flags, hasSupportedUsageTelemetry)
  if (failurePayload) {
    const ev = buildHarnessEvent(payloadText, flags, agent, now)
    const latestCodexUsage = latestRecentUsageLatest(ctx.paths.usageLatest, "codex", now)
    const anyCodexUsage = latestCodexUsage === null ? latestAnyUsageLatest(ctx.paths.usageLatest, "codex") : latestCodexUsage
    const diagnostic = buildCodexHardLimitDiagnostic(ev, {
      hasSupportedUsageTelemetry: hasSupportedUsageTelemetry || latestCodexUsage !== null,
      latestSupportedUsagePercent: latestCodexUsage?.percent ?? null,
      latestSupportedUsageLimitName: latestCodexUsage?.limitName ?? null,
      hadExpiredSupportedUsageTelemetry: latestCodexUsage === null && anyCodexUsage !== null,
    })
    const notif = buildLimitNotification(ev, now, { diagnostic })
    const overloadLanguage = payloadLanguage(payloadText, flags)
    const retryableOverload = ev.paneId && windowName ? buildTransientAutoContinue(ev, { attempt: 1, language: overloadLanguage }) : null
    if (!notif) {
      if (await sendUsageWarningIfPresent()) return 0
      // Staleness guard (#113): a reset already in the past, or nothing to report.
      if (!flags.dryRun) log(`harness-event: suppressed (stale/none) agent=${ev.agent} reset=${ev.resetAt}`)
      else console.log("harness-event: SUPPRESSED (reset already past or nothing to report)")
      return 0
    }
    if (flags.dryRun) {
      console.log("=== harness-event DRY-RUN (no send) ===")
      console.log(notif.text)
      if (notif.button) console.log(`[button] ${notif.button.label} → ${notif.button.data}`)
      if (retryableOverload) console.log(`[auto-continue] ${retryableOverload.text} in ${formatAutoContinueDelay(retryableOverload.delayMs)} (attempt ${retryableOverload.attempt})`)
      if (ev.sourceMessageId !== null) console.log(`[reaction] ${reactionForStage("stalled")} on message ${ev.sourceMessageId}`)
      return 0
    }
    const keyboard = notif.button ? { inline_keyboard: [[{ text: notif.button.label, callback_data: notif.button.data }]] } : undefined
    const extra: Record<string, unknown> = { parse_mode: "HTML" }
    if (keyboard) extra.reply_markup = keyboard
    const messageId = await sendMessage(ctx, notif.text, extra)
    if (ev.sourceMessageId !== null) await setMessageReaction(ctx, ev.sourceMessageId, reactionForStage("stalled"))
    if (retryableOverload && messageId !== null) {
      claimOverloadAutoContinue(ctx, ev, now, overloadLanguage, windowName)
    }
    return 0
  }
  if (await sendUsageWarningIfPresent()) return 0
  if (!flags.dryRun) log(`harness-event: suppressed (no supported event) agent=${agent}`)
  else console.log("harness-event: SUPPRESSED (no supported event)")
  return 0
}

async function runCodexUsageHook(ctx: Ctx, now: number): Promise<number> {
  const hookPayload = await readStdinText().catch(() => "")
  const transcriptPath = codexUsageTranscriptPath(hookPayload)
  if (!transcriptPath) return 0
  const transcript = readFileTailOrNull(transcriptPath, CODEX_TRANSCRIPT_TAIL_BYTES)
  if (!transcript) return 0
  const payload = latestCodexUsageTelemetryPayload(transcript, { now })
  if (!payload) return 0
  return runHarnessEventPayload(ctx, ["--agent", "codex"], now, payload)
}

// --- run: the daemon itself ---

// Upper bound on a cooperative (SIGTERM) drain: finish the in-flight batch, then
// exit. If some await hangs past this, hard-exit anyway so a reload never stalls.
// Comfortably under launchd's own SIGTERM→SIGKILL grace, and well above a normal
// batch's action time (a few tmux send-keys).
const GRACEFUL_SHUTDOWN_MS = 8000

// How long a starting daemon keeps retrying a taken flock before the idempotent no-op exit. A
// lock probe that takes the flock for an instant (daemonLockFree, where no kernel lock table can
// be read) made a successor whose single attempt landed there exit 0, and `restart` left no
// daemon (tg-cli#490). A live daemon holds the lock for its lifetime, so a duplicate start still
// ends as the no-op — this much later.
const DAEMON_LOCK_GRACE_MS = 1000

async function runDaemon(ctx: Ctx): Promise<never> {
  mkdirSync(ctx.configDir, { recursive: true })

  // flock FIRST (spec §6): bound to the open file description, released by the
  // kernel on ANY exit including SIGKILL. The fd stays open for the daemon's lifetime.
  const lockFd = openSync(ctx.paths.lock, "w")
  if (pollSync(() => (flock(lockFd, LOCK_EX_NB) === 0 ? true : null), DAEMON_LOCK_GRACE_MS) === null) {
    // Another daemon owns this bot — idempotent no-op (spec §6).
    process.exit(0)
  }

  writeFileSync(ctx.paths.pid, `${process.pid}\n`)
  recordRunInfo(ctx)

  // One-time migration (tg-cli#281): best-effort rename a pre-existing
  // last-alex-target.json forward so the CTO's routing anchor survives the
  // upgrade instead of silently resetting to the ambiguity picker — or, if a
  // new-name file already exists, remove the now-redundant legacy file so a
  // FUTURE restart (after a legitimate invalidation clears the new file
  // again) can never resurrect it (review finding, round 3). Deliberately
  // placed AFTER the flock is held (review finding, round 2): running this
  // from every CLI invocation (send/status/ask/etc, not just the daemon)
  // could race a still-running pre-rename daemon and clobber ITS fresh anchor
  // write with the stale legacy file — only the flock-holding daemon may
  // touch either file. Non-fatal: a failed rename/unlink just means the
  // legacy file lingers (still denylisted) or the daemon starts with no
  // anchor, same as a fresh install.
  const legacyAction = planLegacyLastUserTargetMigration(ctx.configDir, ctx.botId, existsSync)
  if (legacyAction) {
    try {
      if (legacyAction.kind === "migrate") renameSync(legacyAction.from, legacyAction.to)
      else unlinkSync(legacyAction.path)
    } catch {
      // best-effort; see comment above
    }
  }
  // Before anything can deliver: every sink consults it (tg-cli#299). The claims and picker
  // holds a previous run left open are reported right before the poll loop starts.
  const ledgerAtStart = openDeliveryLedger(ctx.paths.deliveryLedger, ctx.chatId)
  const interruptedClaims = orphanedClaims(ledgerAtStart)
  const lostPickers = lostPickerHolds(ledgerAtStart)
  const pendingButtons = new Map<string, PendingButton>()
  // Per-resource-key concurrent dispatch (tg-cli#357): actions sharing a key (same topic
  // thread, same pending token, same question requestId) still run strictly in enqueue order;
  // actions with different keys run fully concurrently so one stuck target can never head-of-
  // line-block delivery to any other target. See actionResourceKey below and concurrent-dispatch.ts.
  const dispatchQueues = new TargetDispatchQueues()
  const activeButtonKeys = new Set<string>()
  // Answered-request replay cache (tg-cli#97): requestId → the answer just given,
  // so a re-forward of the same question within ANSWERED_REPLAY_MS replays it
  // instead of posting a duplicate card. Swept on every record (pruneAnsweredButtons)
  // so it stays bounded to the last window's answers, never unbounded.
  const answeredButtons = new Map<string, AnsweredButton>()
  // Socket-closed SCOPED questions retained for late-delivery + reconnect (this PR):
  // a question whose hook socket died (the 120s window OR a daemon restart) but whose
  // chosen answer can still reach the pane it asked from. NOT in `pendingButtons`, so
  // it never defers its pane's inbound. Keyed by callbackRequestId, like the others.
  const abandonedButtons = new Map<string, AbandonedButton>()
  // Every card not yet delivered — live, or retained, including a retained permission with a
  // tap queued on it — oldest first: what a newer hatch request or a sibling's decision makes
  // irrelevant (tg-cli#705). A card still being posted (no message id yet) is not listed.
  const closableCards = (): Array<OpenCard & { messageId: number }> =>
    [
      ...[...pendingButtons].map(([key, e]) => ({ key, req: e.req, at: e.at, messageId: e.messageId })),
      ...[...abandonedButtons].map(([key, e]) => ({ key, req: e.req, at: e.at, messageId: e.messageId })),
    ]
      .filter((c): c is OpenCard & { messageId: number } => c.messageId !== null)
      .sort((a, b) => a.at - b.at)
  // The cards still waiting for the human — closable ones with no tap queued: what the 📥 Inbox
  // mirrors and what an answer typed in chat can answer.
  const openCards = (): Array<OpenCard & { messageId: number }> => closableCards().filter((c) => !abandonedButtons.get(c.key)?.queuedDecision)
  // --- 📥 Inbox (tg-cli#705): one forum topic holding a silent copy of every open card ---
  // Only in topics mode, where a topic can exist; otherwise nothing is posted anywhere. The
  // copies follow the open set: `syncInbox` runs after every questions write and once per poll
  // tick, posts a copy for each open card without one and removes the copy of each card that
  // closed. A failed send records nothing and is retried on the next run.
  const inboxEnabled = ctx.cfg.topics || ctx.cfg.privateTopics
  let inboxState = parseInboxState(readFileOrNull(ctx.paths.questionInbox), ctx.chatId)
  inboxThreadId = inboxState.threadId
  // A deleted Inbox topic is recreated at most this often, so a bot that lost the right to
  // create topics does not create one per tick.
  const INBOX_RECREATE_MIN_MS = 10 * 60_000
  let inboxRecreatedAt = 0
  // Every Inbox state change goes through here, so it also arms the send guard (outsideInbox).
  const persistInbox = (): void => {
    inboxThreadId = inboxState.threadId
    try {
      atomicWrite(ctx.paths.questionInbox, serializeInboxState(inboxState))
    } catch (err) {
      log(`inbox persist failed: ${err}`)
    }
  }
  // The topic, created on first need; null when topics are unavailable or the create failed.
  // Single-flight: a sync and a card posted into the Inbox may both need it at once, and two
  // creates would leave an orphan topic holding live cards.
  let inboxCreating: Promise<number | null> | null = null
  const ensureInboxTopic = (): Promise<number | null> => {
    if (inboxState.threadId !== null) return Promise.resolve(inboxState.threadId)
    inboxCreating ??= (async (): Promise<number | null> => {
      if (!(await topicsCapable(ctx))) return null
      const resp = await botPostResult(ctx, "createForumTopic", { chat_id: ctx.chatId, name: INBOX_TOPIC_NAME })
      const result = resp.ok ? resp.json.result : undefined
      const threadId = result && typeof result === "object" && "message_thread_id" in result ? result.message_thread_id : undefined
      if (typeof threadId !== "number") {
        log(`inbox: createForumTopic failed: ${resp.ok ? "no message_thread_id" : resp.description}`)
        return null
      }
      log(`inbox: topic created ${threadId}`)
      inboxState = { chatId: ctx.chatId, threadId, mirrors: emptyMirrors(), removing: [] }
      persistInbox()
      return threadId
    })().finally(() => {
      inboxCreating = null
    })
    return inboxCreating
  }
  // The Inbox topic is gone (deleted by hand), and every copy with it: forget it so the next
  // ensureInboxTopic creates a new one. The background sync does this at most once per
  // INBOX_RECREATE_MIN_MS (false when the rate limit refuses); a card with nowhere else to go
  // (`force`) always may, or it would land in General.
  const dropDeletedInbox = (threadId: number, why: string | undefined, force = false): boolean => {
    // Another send already found it gone and a new topic replaced it: just use that one.
    if (inboxState.threadId !== threadId) return true
    if (!force && Date.now() - inboxRecreatedAt < INBOX_RECREATE_MIN_MS) return false
    inboxRecreatedAt = Date.now()
    log(`inbox: topic ${threadId} rejected a send (${why}) — recreating it`)
    inboxState = emptyInboxState(ctx.chatId)
    persistInbox()
    return true
  }
  // tg-cli#717: a card whose session has no topic is posted INTO the Inbox, with a notification
  // (it is the card, not a silent copy), and recorded as the key's Inbox entry so the sync never
  // copies it again. Posted directly: the send guard keeps everything else out of the Inbox.
  const postCardToInbox = async (req: ButtonRequest, key: string): Promise<{ messageId: number; threadId: number } | null> => {
    if (!inboxEnabled) return null
    // A second attempt only after the topic was found deleted and recreated.
    for (let attempt = 0; attempt < 2; attempt++) {
      const threadId = await ensureInboxTopic()
      if (threadId === null) return null
      const card = buildButtonMessage(ctx.chatId, req, threadId)
      const resp = await botPostResult(ctx, "sendMessage", {
        chat_id: ctx.chatId,
        message_thread_id: threadId,
        text: card.text,
        reply_markup: card.reply_markup,
        ...(card.parse_mode ? { parse_mode: card.parse_mode } : {}),
      })
      const result = resp.ok ? resp.json.result : undefined
      const messageId = result && typeof result === "object" && "message_id" in result ? result.message_id : undefined
      if (typeof messageId === "number") {
        inboxState.mirrors[key] = { messageId, card: true }
        persistInbox()
        return { messageId, threadId }
      }
      // Only a topic Telegram reports deleted is recreated: a private-topics "thread not found" is
      // transient, and recreating on it would orphan the Inbox and its open cards.
      const topicGone = !resp.ok && isTopicDeletedError(resp.description)
      if (topicGone && attempt === 0 && dropDeletedInbox(threadId, resp.description, true)) continue
      log(`inbox: card ${key} not posted in the Inbox (${resp.ok ? "no message_id" : resp.description}) — General instead`)
      return null
    }
    return null
  }
  const syncInboxOnce = async (): Promise<void> => {
    // `tg auth` rebound the chat: the old topic and its copies are out of reach.
    if (inboxState.chatId !== ctx.chatId) {
      inboxState = emptyInboxState(ctx.chatId)
      persistInbox()
    }
    const open = new Map(openCards().map((c) => [c.key, c]))
    const plan = planInboxSync(open.values(), inboxState)
    for (const key of plan.remove) {
      const mirror = inboxState.mirrors[key]
      delete inboxState.mirrors[key]
      // A card posted INTO the Inbox (tg-cli#717) stays: closing it already edited it in place.
      const isCard = "card" in mirror
      if (!isCard) inboxState.removing.push(mirror.messageId)
      persistInbox()
      log(`inbox: ${isCard ? "dropped the Inbox card" : "removing the copy"} of ${key} (message ${mirror.messageId})`)
    }
    // Every copy still owed — closed just now, or by an earlier sync or run Telegram did not
    // answer (tg-cli#722). A transient failure ends the pass: the next sync tries again, and an
    // outage costs one doomed request per sync, not one per owed copy.
    for (const messageId of [...inboxState.removing]) {
      if (!(await retireMessage(ctx, ctx.chatId, messageId, "✓ no longer open"))) {
        log(`inbox: copy ${messageId} not removed yet — retried next sync`)
        break
      }
      inboxState.removing = inboxState.removing.filter((id) => id !== messageId)
      persistInbox()
      log(`inbox: removed copy ${messageId}`)
    }
    if (plan.post.length === 0) return
    const threadId = await ensureInboxTopic()
    if (threadId === null) return
    const now = Date.now()
    for (const key of plan.post) {
      const card = open.get(key)
      if (!card) continue
      const label = resolveSessionName({ tmuxWindow: card.req.windowName, cwd: card.req.cwd }).primary
      const message = inboxMirrorMessage(card, label, now)
      const resp = await botPostResult(ctx, "sendMessage", {
        chat_id: ctx.chatId,
        message_thread_id: threadId,
        text: message.text,
        reply_markup: message.reply_markup,
        disable_notification: true,
        ...(message.parse_mode ? { parse_mode: message.parse_mode } : {}),
      })
      const result = resp.ok ? resp.json.result : undefined
      const messageId = result && typeof result === "object" && "message_id" in result ? result.message_id : undefined
      if (typeof messageId === "number") {
        // The card may have closed while the copy was in flight: the next run removes it.
        inboxState.mirrors[key] = { messageId, cardId: card.messageId }
        persistInbox()
        log(`inbox: posted copy of ${key} (message ${messageId})`)
        continue
      }
      if (!resp.ok && (isThreadRejection(resp.description) || isTopicDeletedError(resp.description))) {
