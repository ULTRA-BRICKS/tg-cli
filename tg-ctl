function log(msg: string): void {
  console.error(`[${new Date().toISOString()}] ${msg}`)
}

function readFileOrNull(path: string): string | null {
  try {
    return readFileSync(path, "utf8")
  } catch {
    return null
  }
}

function readFileTailOrNull(path: string, maxBytes: number): string | null {
  let fd: number | null = null
  try {
    const stat = statSync(path)
    if (!stat.isFile()) return null
    const size = stat.size
    const length = Math.min(Math.max(0, maxBytes), size)
    const offset = Math.max(0, size - length)
    const buf = Buffer.allocUnsafe(length)
    fd = openSync(path, "r")
    let bytesRead = 0
    while (bytesRead < length) {
      const chunkBytes = readSync(fd, buf, bytesRead, length - bytesRead, offset + bytesRead)
      if (chunkBytes <= 0) break
      bytesRead += chunkBytes
    }
    return buf.subarray(0, bytesRead).toString("utf8")
  } catch {
    return null
  } finally {
    if (fd !== null) {
      try {
        closeSync(fd)
      } catch {
        // ignore close failure on best-effort hook telemetry
      }
    }
  }
}

function readJsonObjectOrNull(path: string): Record<string, unknown> | null {
  const raw = readFileOrNull(path)
  if (!raw) return null
  try {
    const parsed = JSON.parse(raw)
    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? (parsed as Record<string, unknown>) : null
  } catch {
    return null
  }
}

function hasClaudeStatusLineCommand(settings: Record<string, unknown>): boolean {
  const statusLine = settings.statusLine
  if (!statusLine || typeof statusLine !== "object" || Array.isArray(statusLine)) return false
  const command = (statusLine as Record<string, unknown>).command
  return typeof command === "string" && command.trim().length > 0
}

// Crash-safe write: stage into a sibling temp file then rename(2) over the target.
// rename is atomic on the same filesystem, so a reader (or a daemon that died
// mid-write) sees either the old file or the new one whole — never a torn JSON the
// next startup would fail to parse. Used for the durable question state, which is
// rewritten on every mutation of a hot path.
function atomicWrite(path: string, content: string): void {
  const tmp = `${path}.tmp`
  writeFileSync(tmp, content, { mode: 0o600 })
  renameSync(tmp, path)
}

// Append history records to the JSONL log, trimmed to the bound. BEST-EFFORT:
// the recall log is purely informational (like routes), so a read/write error
// must never break the inbound inject path. Shared by the poll loop's inbound
// writer; the `tg` entrypoint has the mirror for outbound.
function appendHistory(path: string, records: HistoryRecord[]): void {
  if (records.length === 0) return
  try {
    // 0o600: the log is a conversation transcript — owner-only, like the socket.
    writeFileSync(path, appendRecordsToBlob(readFileOrNull(path), records), { mode: 0o600 })
    chmodSync(path, 0o600) // enforce on a pre-existing, looser-perm file too
  } catch {
    // best-effort: never let history bookkeeping break an inject
  }
}

function fileMtimeMs(path: string): number | null {
  try {
    return statSync(path).mtimeMs
  } catch {
    return null
  }
}

function kill0(pid: number): boolean {
  try {
    process.kill(pid, 0)
    return true
  } catch {
    return false
  }
}

function api(ctx: Ctx): string {
  return `${ctx.apiBase}/bot${ctx.token}`
}

// Daemon-side Bot API call. Never throws and never exits — a failed notice
// must not take the poll loop down with it.
async function botPost(ctx: Ctx, method: string, body: unknown): Promise<Record<string, unknown> | null> {
  const result = await botPostResult(ctx, method, body)
  // Preserve the legacy wrapper contract: transport-level HTTP errors return null,
  // but Telegram's historical HTTP-200 {ok:false} envelopes remain visible to callers.
  if (!result.ok && typeof result.status === "number") return null
  return result.json ?? null
}

type BotPostResult =
  | { ok: true; json: Record<string, unknown> }
  | { ok: false; status?: number; description: string; json?: Record<string, unknown> }

function telegramErrorDescription(text: string): { description: string; json?: Record<string, unknown> } {
  try {
    const parsed = JSON.parse(text) as unknown
    if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
      const json = parsed as Record<string, unknown>
      if (typeof json.description === "string") return { description: json.description, json }
      return { description: JSON.stringify(json).slice(0, 200), json }
    }
  } catch {
    // Fall through to the raw body; non-JSON upstream failures are still useful diagnostics.
  }
  return { description: text.slice(0, 200) }
}

async function botPostResult(ctx: Ctx, method: string, body: unknown): Promise<BotPostResult> {
  try {
    const resp = await fetch(`${api(ctx)}/${method}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(15_000),
    })
    if (!resp.ok) {
      const text = await resp.text()
      const error = telegramErrorDescription(text)
      log(`${method} failed: ${resp.status} ${text.slice(0, 200)}`)
      return { ok: false, status: resp.status, ...error }
    }
    const json = (await resp.json()) as Record<string, unknown>
    if (!json || typeof json !== "object") return { ok: false, description: "non-object JSON response" }
    if (json.ok === false) {
      const description =
        typeof json.description === "string" ? json.description : JSON.stringify(json).slice(0, 200)
      return { ok: false, description, json }
    }
    return { ok: true, json }
  } catch (err) {
    log(`${method} failed: ${err}`)
    return { ok: false, description: String(err) }
  }
}

async function sendMessage(ctx: Ctx, text: string, extra: Record<string, unknown> = {}): Promise<number | null> {
  const json = await botPost(ctx, "sendMessage", { chat_id: ctx.chatId, text, ...extra })
  const result = json?.result
  if (!result || typeof result !== "object") return null
  const messageId = (result as { message_id?: unknown }).message_id
  return typeof messageId === "number" ? messageId : null
}

// Shared by every initial-post call site (forwardAndPostQuestion, ompPermissionSink) so the
// parse_mode/reply_markup shape can't drift between them — a divergent copy is exactly how a
// hatch card's parse_mode threading silently stops matching between the two flows.
async function sendButtonCard(ctx: Ctx, payload: ButtonMessagePayload): Promise<number | null> {
  const extra: Record<string, unknown> = { reply_markup: payload.reply_markup }
  if (payload.parse_mode) extra.parse_mode = payload.parse_mode
  return sendMessage(ctx, payload.text, extra)
}

async function answerCallbackQuery(ctx: Ctx, callbackQueryId: string, text: string): Promise<void> {
  // A text-reply-synthesized decision (see the 'answer-question' construction in
  // features/tg-ctl/updates.ts) carries an empty callbackQueryId sentinel: there is no real
  // Telegram callback query to acknowledge, so this is a correct no-op on a SUCCESS path — the
  // card's own editMessageText already gives the human visible feedback. It is NOT correct on a
  // pure-toast failure branch (expired / already-answered / mismatched) that posts no edit —
  // those call sites MUST use answerCallbackQueryOrNotify below instead, or the sentinel would
  // silently swallow the only feedback the human would otherwise get (review finding).
  if (!callbackQueryId) return
  await botPost(ctx, "answerCallbackQuery", { callback_query_id: callbackQueryId, text })
}

// For a failure branch that reports its outcome ONLY via the toast (no accompanying card edit):
// a real button tap's `action.callbackQueryId` is always real, so `answerCallbackQuery` reaches
// the human either way. A text-reply-synthesized decision (empty-sentinel `action`, see
// features/tg-ctl/updates.ts) has no callback query to toast — without this, the human's "yes"
// would silently do nothing with zero feedback (review finding: a same-batch race where a button
// tap resolves the card a moment before a text reply to it lands would otherwise vanish
// unexplained). Falls back to a plain chat reply carrying the identical text. Success branches
// that follow up with an editMessageText keep using plain `answerCallbackQuery` — the card edit
// is already sufficient feedback there and a second message would be redundant noise.
async function answerCallbackQueryOrNotify(
  ctx: Ctx,
  action: Extract<Action, { kind: "answer-question" }>,
  text: string,
): Promise<void> {
  if (!action.callbackQueryId) {
    await sendMessage(ctx, text)
    return
  }
  await answerCallbackQuery(ctx, action.callbackQueryId, text)
}

// NOTE: Telegram's editMessageText REPLACES the whole inline keyboard — omitting
// reply_markup detaches it. Pass the markup whenever the edited card must stay
// tappable (e.g. restoring a re-attached question card to its live prompt).
async function editMessageText(
  ctx: Ctx,
  messageId: number,
  text: string,
  replyMarkup?: ButtonMessagePayload["reply_markup"],
  parseMode?: ButtonMessagePayload["parse_mode"],
): Promise<void> {
  const body: Record<string, unknown> = { chat_id: ctx.chatId, message_id: messageId, text }
  if (replyMarkup) body.reply_markup = replyMarkup
  if (parseMode) body.parse_mode = parseMode
  await botPost(ctx, "editMessageText", body)
}

// Remove the inline keyboard from a previously-sent message (forum-topics increment 4): after a
// topic binds we clear the now-stale model buttons so they can't be re-tapped. Omitting
// reply_markup detaches the keyboard. Best-effort — botPost swallows failures (a deleted prompt
// message, a transient API error), never throwing into the poll loop.
async function clearMessageKeyboard(ctx: Ctx, messageId: number): Promise<void> {
  await botPost(ctx, "editMessageReplyMarkup", { chat_id: ctx.chatId, message_id: messageId })
}

// Delete a previously-sent message outright (tg-cli#403: reminder-message
// replacement — a new critical-mode reminder deletes the PREVIOUS reminder
// rather than letting them pile up in the chat). Returns whether Telegram
// actually deleted it; the caller falls back to editMessageText with a short
// placeholder when it didn't (message too old for Bot API delete, already
// gone, etc.) — deleteMessage itself never throws (botPostResult swallows
// transport/HTTP-level failures the same as every other botPost* helper).
async function deleteMessage(ctx: Ctx, messageId: number): Promise<boolean> {
  const result = await botPostResult(ctx, "deleteMessage", { chat_id: ctx.chatId, message_id: messageId })
  return result.ok
}

// Set a reaction on a message (tg-cli#114 lifecycle: 👀 working → 😴 stalled →
// 👌 done). Skips an emoji Telegram would reject (⏳/✅ are REACTION_INVALID) so
// we never waste a call on a guaranteed 400. Best-effort — botPost swallows
// failures; a receipt must never break the caller.
async function setMessageReaction(ctx: Ctx, messageId: number, emoji: string): Promise<void> {
  if (!isAllowedReaction(emoji)) {
    log(`setMessageReaction skipped: ${emoji} is not an allowed reaction`)
    return
  }
  await botPost(ctx, "setMessageReaction", {
    chat_id: ctx.chatId,
    message_id: messageId,
    reaction: [{ type: "emoji", emoji }],
  })
}

// Send a rich-HTML message (Bot API sendRichMessage, `rich_message.html`), the
// path /tasks uses for its table (#115). Normalizes + pre-flights the HTML with
// the same helpers `tg` uses, so an invalid table fails locally with a clear log
// instead of an opaque API 400. Returns the sent message id or null.
async function sendRich(
  ctx: Ctx,
  rawHtml: string,
  extra: { reply_markup?: TasksReplyMarkup; message_thread_id?: number; reply_parameters?: { message_id: number } } = {},
): Promise<number | null> {
  const html = normalizeRichHtml(rawHtml)
  const check = validateRichHtml(html)
  if (!check.ok) {
    log(`sendRich invalid html: ${check.error}`)
    return null
  }
  const json = await botPost(ctx, "sendRichMessage", { chat_id: ctx.chatId, rich_message: { html }, ...extra })
  const result = json?.result
  if (!result || typeof result !== "object") return null
  const messageId = (result as { message_id?: unknown }).message_id
  return typeof messageId === "number" ? messageId : null
}

// Publish the bot's own slash-commands to Telegram's "/" autocomplete + menu
// button (setMyCommands), so `/agent` and the rest are discoverable instead of
// blind-typed. Best-effort and idempotent: a network/API failure is logged and
// ignored — the daemon's job is routing, not the menu. The ENTIRE body is
// wrapped: botPost already swallows transport errors, but the whole publish path
// is belt-and-suspenders try/catch'd so no future regression on this side path
// can ever throw into runDaemon and abort startup. validateBotCommands guards
// the list against Telegram's constraints (the test suite enforces it too).
//
// Scope: the default (global) scope — the menu shows in every chat with the bot.
// tg-ctl is a single-user personal control bot (one TG_CHAT_ID), so global is the
// intended choice; a multi-tenant bot would scope per chat to avoid leaking the
// menu to other chats.
async function publishBotCommands(ctx: Ctx): Promise<void> {
  try {
    validateBotCommands()
    const json = await botPost(ctx, "setMyCommands", { commands: BOT_COMMANDS })
    if (json?.ok === true) log(`setMyCommands ok — published ${BOT_COMMANDS.length} commands`)
    else log("setMyCommands did not confirm ok — menu may be stale (continuing)")
  } catch (err) {
    // Unreachable on today's code (botPost is try/catch'd, validate only throws
    // on a bad list we control) — but startup must survive it regardless.
    log(`setMyCommands failed — menu not published (continuing): ${err}`)
  }
}

// Tab separator — pane_current_path may contain spaces (see discover.ts).
// #{window_name} is carried in the CORE snapshot (a fixed field BEFORE the greedy
// path) so the /agent picker can label by the user-set window name reliably
// (tg-cli#75 fix C); the previous separate window-name tmux call did NOT pass the
// UTF-8 locale env, so under launchd the tab-mangle blanked every name and the
// picker fell back to the cwd basename.
const PANE_FORMAT =
  "#{session_name}\t#{window_index}\t#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{window_name}\t#{@tg_spawn_token}\t#{pane_current_path}"

// Subprocess env with a GUARANTEED UTF-8 locale. THE root cause of the "Claude Code not in tmux"
// saga: under launchd the daemon inherits NO locale (LANG/LC_* unset), and tmux then classifies the
// TAB separator in PANE_FORMAT as non-printable and ESCAPES it to `_` in its `-F` output. Every line
// then collapses to a single field, parsePaneList drops it (<8 fields), snapshot() returns ZERO
// panes, and the daemon reports "not in tmux" for every message despite live agent panes. A UTF-8
// locale makes tmux emit real tabs. It MUST be passed explicitly on the spawn — Bun.spawnSync does
// NOT pick up a runtime `process.env` mutation — so this env is handed to every discovery subprocess.
// (#44/#46 retried a symptom; the output was non-empty but mis-separated, which is why a retry could
// never fix it.)
//
// Set LC_ALL UNCONDITIONALLY. LC_ALL is the top-priority locale var, so this overrides ANY inherited
// state — including the trap where LC_ALL=C coexists with LANG=*.UTF-8 (common in cron/CI profiles):
// a "does any var look UTF-8?" check would see LANG and wrongly leave the effective C locale in place.
// Discovery output is parsed as raw bytes, so the SPECIFIC UTF-8 locale is irrelevant — only that it
// IS UTF-8. Pick one guaranteed to exist on the platform: macOS ships en_US.UTF-8 but not C.UTF-8;
// minimal Linux images often ship C.UTF-8 but not en_US.UTF-8.
const SUBPROC_ENV: Record<string, string> = (() => {
  const env = { ...process.env } as Record<string, string>
  env.LC_ALL = process.platform === "darwin" ? "en_US.UTF-8" : "C.UTF-8"
  return env
})()

// tmux absent / no server / ps failure → empty snapshot, never a crash:
// discovery then degrades to the no-agent reply path.
function snapshot(): { panes: PaneInfo[]; procs: ProcInfo[] } {
  let procs: ProcInfo[] = []
  // Retry a transient empty/failed `tmux list-panes` before accepting "no panes". panesWithRetry is
  // a no-op on the happy path (breaks on the first non-empty read) and pure/unit-tested. The env is
  // forced UTF-8 (see SUBPROC_ENV) so tmux emits real tab separators.
  const panes = panesWithRetry(
    () => {
      try {
        const tmux = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", PANE_FORMAT], {
          stdout: "pipe",
          stderr: "pipe",
          env: SUBPROC_ENV,
        })
        return { exitCode: tmux.exitCode ?? 1, stdout: tmux.stdout.toString() }
      } catch {
        return null // tmux binary missing — retrying cannot help
      }
    },
    { sleep: (ms) => Bun.sleepSync(ms) },
  )
  // The ps query gets the SAME transient-empty resilience as tmux above: `ps -axo` returning an
  // empty list is impossible on a live system (system procs always exist), so an empty/failed read
  // is a launchd-runtime flake — and an empty procs list makes findAgentInPane match nothing, so
  // live agent panes report as "no agent" exactly like an empty tmux read (the gap the tmux-only
  // retry missed). Retry an exit-0-but-empty read; break on the first non-empty or a hard failure.
  for (let i = 0; i < 3; i++) {
    if (i > 0) Bun.sleepSync(120)
    try {
      const ps = Bun.spawnSync(["ps", "-axo", "pid=,ppid=,command="], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (ps.exitCode !== 0) break // ps failed hard — retrying unlikely to help
      procs = parseProcList(ps.stdout.toString())
      if (procs.length > 0) break
    } catch {
      break // ps missing — never on a supported platform
    }
  }
  return { panes, procs }
}

// Read the per-pane registration SET (tg-cli#67). Tolerates the legacy
// single-object file shape (a daemon upgraded in place keeps the live
// registration written by the previous version — see parseRegistrations).
// `livePaneIds` prunes entries whose pane is gone; pass null to skip pruning
// (no snapshot available, or a momentarily-empty/flaky one — pruning on empty
// would wipe every live session at once).
function readRegistrations(paths: CtlPaths, livePaneIds: Set<string> | null = null): Registration[] {
  let raw: string | null
  try {
    raw = readFileSync(paths.registration, "utf8")
  } catch {
    return []
  }
  return pruneRegistrations(parseRegistrations(raw), livePaneIds)
}

// Durably PRUNE dead-pane entries from the on-disk store (review finding): the
// daemon reads-and-prunes in memory every poll, but without writing the pruned
// set back, dead entries accumulate forever — and upsertRegistration's cap
// evicts by insertion order, so 100 piled-up dead entries would eventually evict
// a still-LIVE session and silently drop its questions (the exact failure this
// feature fights). So when discovery sees the store shrink under a TRUSTWORTHY
// live-pane set, persist the smaller set. Race-safe: re-read + re-prune INSIDE
// the registration lock, so a `tg start` that upserted between the poll read and
// here is not clobbered. Best-effort and off the hot path — never throws, and is
// skipped entirely on a flaky/empty snapshot (livePaneIds === null).
function pruneRegistrationsOnDisk(paths: CtlPaths, livePaneIds: Set<string> | null): void {
  if (livePaneIds === null) return
  try {
    withRoutesLock(
      fsRoutesLockIo(`${paths.registration}.lock`),
      () => {
        let raw: string | null
        try {
          raw = readFileSync(paths.registration, "utf8")
        } catch {
          return
        }
        const current = parseRegistrations(raw)
        const pruned = pruneRegistrations(current, livePaneIds)
        if (pruned.length !== current.length) {
          writeFileSync(paths.registration, serializeRegistrations(pruned))
        }
      },
      { onContended: "skip" }, // a live writer holds the lock — let it; we prune next poll
    )
  } catch {
    // best-effort prune — never break the poll loop
  }
}

// Fresh discovery on every call — the registration file may have been
// rewritten by a newer `tg`/`tg-ctl start` since the last poll.
// An explicit `tg-ctl start --session X` (stored in the registration) outranks
// config.yaml's control.session: it is the fresher, more specific intent, and
// the auto-start path never sets it (tg passes only --pane/--cwd).
// Rate-limit the no-agent diagnostic so the per-poll idle check can't spam the log.
let lastNoAgentLogMs = 0
function discoverTarget(ctx: Ctx): DiscoverResult {
  const { panes, procs } = snapshot()
  // Prune dead-pane entries against the live snapshot, but ONLY when the snapshot
  // actually has panes — an empty/flaky read must not wipe every registration
  // (panesWithRetry already retried the transient empty case).
  const livePaneIds = panes.length > 0 ? new Set(panes.map((p) => p.paneId)) : null
  const regs = readRegistrations(ctx.paths, livePaneIds)
  // Persist the prune so dead-pane entries can't accumulate to the cap and evict
  // a live session (review finding). Off the hot path, lock-guarded, no-op when
  // nothing was pruned or the snapshot is untrustworthy.
  pruneRegistrationsOnDisk(ctx.paths, livePaneIds)
  // An explicit `tg-ctl start --session X` (the fresher, more specific intent)
  // outranks config.yaml's control.session; the auto-start path never sets it.
  const sessionPin = regs.find((r) => r.sessionName)?.sessionName ?? ctx.cfg.session
  const result = pickTargetPaneFromSet(panes, procs, regs, sessionPin)
  // OBSERVABILITY: a "no-agent" result is what produces the misleading "Claude Code not in tmux"
  // reply. It has been an UNREPRODUCIBLE intermittent in the launchd runtime, so log the snapshot
  // shape on it — the next occurrence then shows the REAL cause (tmux-empty vs ps-empty vs
  // agent-match-fail vs a stale registration) instead of failing silently. Rate-limited to ≤1/10s.
  if (!result.ok && result.reason === "no-agent") {
    const now = Date.now()
    if (now - lastNoAgentLogMs > 10_000) {
      lastNoAgentLogMs = now
      const agentPanes = panes.filter((p) => findAgentInPane(p, procs)).length
      const regSummary = regs.length > 0 ? regs.map((r) => `${r.paneId ?? "?"}@${r.cwd ?? "?"}`).join(",") : "none"
      log(
        `no-agent reply: panes=${panes.length} procs=${procs.length} agent-panes=${agentPanes} ` +
          `regs=${regs.length} reg=${regSummary}`,
      )
    }
  }
  return result
}

// Git-state-check banner support (git-state.ts): a best-effort, timeout-guarded read of the
// destination pane's cwd, run right before a silent auto-bind delivery. A stuck `git` (lock
// contention, a huge repo, a hung network filesystem) must never block the daemon's single-
// threaded poll loop, so both spawns are killed after GIT_STATE_TIMEOUT_MS; ANY failure — not a
// git repo, the git binary missing, a timeout, a non-zero exit — degrades to null (no banner),
// the same "never breaks delivery" contract every other best-effort read in this file follows.
const GIT_STATE_TIMEOUT_MS = 2000
function gitStateForPath(cwd: string): PaneGitState | null {
  try {
    const branchProc = Bun.spawnSync(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"], {
      stdout: "pipe",
      stderr: "pipe",
      timeout: GIT_STATE_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (branchProc.exitCode !== 0) return null // not a git repo, or git errored — undeterminable
    const statusProc = Bun.spawnSync(["git", "-C", cwd, "status", "--porcelain"], {
      stdout: "pipe",
      stderr: "pipe",
      timeout: GIT_STATE_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (statusProc.exitCode !== 0) return null
    return buildPaneGitState(branchProc.stdout.toString(), statusProc.stdout.toString())
  } catch {
    return null // git binary missing — never break the poll loop
  }
}

// All tmux panes that host an agent, as /agent selection candidates (item 1).
// The window name comes from the CORE snapshot's #{window_name} field (tg-cli#75
// fix C) — NOT a separate tmux call: that call skipped the UTF-8 locale env, so
// under launchd the tab-mangle blanked every name and the picker fell back to the
// cwd basename ("hyperide · claude" instead of "ext · claude"). A pane with no
// usable name (empty / a bare default) is detected downstream (isBareWindowName)
// and the label leans on the cwd basename there; here we fall back to the session
// name only when the snapshot carried no window name at all.
function listAgentCandidates(): AgentCandidate[] {
  const { panes, procs } = snapshot()
  const out: AgentCandidate[] = []
  for (const pane of panes) {
    const found = findAgentInPane(pane, procs)
    if (!found) continue
    out.push({
      paneId: pane.paneId,
      sessionName: pane.sessionName,
      windowIndex: pane.windowIndex,
      windowName: pane.windowName || pane.sessionName,
      agent: found.agent,
      // cwd — the picker derives a distinct project-dir label from its basename
      // when window names collide or are bare defaults (the "4 · claude" ×3 bug).
      panePath: pane.panePath,
    })
  }
  // A pane id is unique per tmux server; dedupe guards a merged/flaky snapshot.
  // Out-of-tmux omp join as paneId omp:<pid> so /agent can pick them; in-tmux
  // omp already have a real pane row and are skipped by the merge.
  return mergeLiveOmpCandidates(dedupeCandidates(out), listLiveOmpAgents())
}

// --- agents OUTSIDE tmux (tg-cli#306) ---
//
// A second, cheap ps read (`pid tty` only) is DISPLAY-ONLY for claude/codex/opencode
// (tg-cli#413 follow-up removed the gate there — see the "Past bug (tg-cli#413
// follow-up)" note above `findUnreachableAgents`); for pi/aider/omp/unknown (no
// per-shape headless detection) it is still load-bearing: `findUnreachableAgents`
// requires a real tty map entry for those kinds before listing one as unreachable.
// Their cwd comes from lsof (one call per such agent — a handful at most). A `ps`
// failure here degrades to an empty map, never a crash — that only suppresses
// pi/aider/omp/unknown (still tty-gated); claude/codex/opencode are listed either way.
function readPidTtyMap(): Map<number, string> {
  try {
    const ps = Bun.spawnSync(["ps", "-axo", "pid=,tty="], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    if (ps.exitCode !== 0) return new Map()
    return parsePidTtyList(ps.stdout.toString())
  } catch {
    return new Map()
  }
}

const LSOF_TIMEOUT_MS = 2000
let lsofMissingWarned = false
// The agent's cwd: `/proc/<pid>/cwd` where it exists (Linux — no external tool),
// else `lsof` (macOS ships it). On a Linux box with neither the cwd is unknown — said
// ONCE in the log, never silently — and the agent is still listed, by its --name or
// pid, just without a cwd-derived inbox key.
function cwdOfPid(pid: number): string | null {
  try {
    return readlinkSync(`/proc/${pid}/cwd`)
  } catch {
    // no procfs (macOS) or the process is gone — fall through to lsof
  }
  try {
    const lsof = Bun.spawnSync(["lsof", "-a", "-p", String(pid), "-d", "cwd", "-Fn", "-n"], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
      timeout: LSOF_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (lsof.exitCode !== 0) return null
    return parseLsofCwd(lsof.stdout.toString())
  } catch (err) {
    if (!lsofMissingWarned) {
      lsofMissingWarned = true
      log(`unreachable scan: cannot resolve the cwd of pid ${pid} — no /proc and lsof failed (${err}); install lsof for cwd-keyed inboxes`)
    }
    return null
  }
}

// Memoized for a short window: the scan is sync (ps + one lsof per agent, up to
// LSOF_TIMEOUT_MS each) and one inbound message can ask for it several times in a row
// (route attempt, then the no-agent reply); a poll tick asks once more. One scan per
// ~2s keeps the single-threaded poll loop responsive (review finding).
const UNREACHABLE_SCAN_TTL_MS = 2000
let unreachableCache: { at: number; agents: UnreachableAgent[] } | null = null
function listUnreachableAgents(): UnreachableAgent[] {
  const now = Date.now()
  if (unreachableCache && now - unreachableCache.at < UNREACHABLE_SCAN_TTL_MS) return unreachableCache.agents
  const ttyByPid = readPidTtyMap()
  const { panes, procs } = snapshot()
  const agents = findUnreachableAgents(panes, procs, ttyByPid)
    .filter((a) => a.agent !== "omp")
    .map((a) => ({ ...a, cwd: cwdOfPid(a.pid) }))
  unreachableCache = { at: now, agents }
  return agents
}

// `lsof -Fn` n-paths for a pid — used to find omp's primary session jsonl.
function jsonlPathsOfPid(pid: number): string[] {
  try {
    const lsof = Bun.spawnSync(["lsof", "-a", "-p", String(pid), "-Fn", "-n"], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
      timeout: LSOF_TIMEOUT_MS,
      killSignal: "SIGKILL",
    })
    if (lsof.exitCode !== 0) return []
    return parseLsofJsonlPaths(lsof.stdout.toString())
  } catch {
    return []
  }
}

let liveOmpCache: { at: number; agents: LiveOmpAgent[] } | null = null
function listLiveOmpAgents(): LiveOmpAgent[] {
  const now = Date.now()
  if (liveOmpCache && now - liveOmpCache.at < UNREACHABLE_SCAN_TTL_MS) return liveOmpCache.agents
  const ttyByPid = readPidTtyMap()
  const { panes, procs } = snapshot()
  const agents = findLiveOmpAgents(panes, procs, ttyByPid).map((a) => {
    const cwd = cwdOfPid(a.pid)
    const files = jsonlPathsOfPid(a.pid)
    const sessionFile = pickPrimaryOmpSessionFile(files)
    let meta = null
    if (sessionFile) {
      try {
        meta = parseOmpSessionMeta(readFileSync(sessionFile, "utf8"))
      } catch {
        meta = null
      }
    }
    return withOmpSession(a, { cwd, sessionFile, meta })
  })
  liveOmpCache = { at: now, agents }
  return agents
}

type OmpAcpClient = {
  proc: ReturnType<typeof Bun.spawn>
  cwd: string
  sessionId: string
  buf: string
  nextId: number
  pending: Map<number, { resolve: (v: unknown) => void; reject: (e: Error) => void }>
  // Updated on every inbound ACP frame (a resolved call, a session/update, or
  // a permission request) -- proof the child is alive, not wedged. Read by
  // promptOmpAcp to tell "still working past the timeout" apart from a
  // genuinely dead pipe.
  lastActivityAt: number
  // Count of session/request_permission calls this client has sent that no
  // reply has been written back for yet. While > 0 a human may be mid-decision
  // on a live Telegram permission prompt (the 12h ABANDONED_PERMISSION_RETAIN_MS
  // guarantee) -- promptOmpAcp must never evict+kill the client that prompt
  // depends on just because session/prompt itself also timed out.
  pendingPermissions: number
  // Non-null id of a `session/prompt` this client has written but not yet had
  // acknowledged (matched by response id) or timed out. ACP `session/prompt`
  // is one turn at a time per session -- the tg-cli#353 wedge is exactly what
  // happens when a second, un-acknowledged prompt races into the same pipe
  // while the session is still owned by the first. A new prompt arriving
  // while this is set queues in promptQueue instead of writing a second frame.
  promptInFlightId: number | null
  promptQueue: string[]
}

const ompAcpClients = new Map<string, OmpAcpClient>()

// Coalesces concurrent ensureOmpAcp calls for the SAME key onto one spawn
// (review finding, 2026-09-18): two Telegram replies to the same not-yet-
// cached session landing in one dispatch batch (agent-route/inject actions
// have no per-session resource key, so same-target messages in one batch
// run concurrently) previously each saw an empty ompAcpClients, each spawned
// its own `omp acp`, and both called session/load on the SAME underlying
// session -- the exact double-ownership wedge this whole file exists to
// prevent, reached through concurrent first-contact instead of a raced
// write. The eviction-redelivery path (evict -> delete key -> respawn)
// reopens the identical window on every wedge cycle, not just first
// contact.
const ompAcpEnsuring = new Map<string, Promise<OmpAcpClient>>()

// Overridable only for tests (regression cover for the wedged-client evict
// path in promptOmpAcp) -- production always gets the 120s default.
const ACP_PROMPT_TIMEOUT_MS = Number(process.env.TG_CTL_ACP_PROMPT_TIMEOUT_MS) || 120_000

function writeAcp(client: OmpAcpClient, msg: object): void {
  // A write against an already-dead pipe (EPIPE / write-after-close) must
  // never throw out of a resolve/reject callback invoked synchronously from
  // pumpAcpClient's read loop (writePrompt's advance/evict paths) -- an
  // uncaught throw there is outside any caller's try/catch and would crash
  // the daemon. The watchdog below still discovers the resulting silence
  // and evicts/redelivers, same as any other genuinely dead client.
  try {
    client.proc.stdin.write(encodeAcpFrame(msg))
  } catch (err) {
    log(`omp-acp: write failed cwd=${client.cwd} session=${client.sessionId || "-"}: ${err instanceof Error ? err.message : String(err)}`)
  }
}

function pumpAcpClient(client: OmpAcpClient, onPermission: (req: ButtonRequest) => void): void {
  const stdout = client.proc.stdout
  const reader = stdout.getReader()
  const decoder = new TextDecoder()
  const loop = async () => {
    while (true) {
      const { done, value } = await reader.read()
      if (done) break
      client.buf += decoder.decode(value, { stream: true })
      const { messages, rest } = decodeAcpFrames(client.buf)
      client.buf = rest
      for (const raw of messages) {
        if (!raw || typeof raw !== "object") continue
        client.lastActivityAt = Date.now()
        const rec = raw as { id?: number; method?: string; result?: unknown; error?: { message?: string } }
        // `rec.method === undefined` is REQUIRED, not just `id` matching: an
        // inbound ACP REQUEST (e.g. session/request_permission) carries its
        // OWN id from the agent's own independent id counter, which can
        // numerically collide with `client.nextId`-assigned ids for OUR
        // outbound requests (both are small sequential integers starting
        // near 1-3 per turn). Matching on id alone would treat a permission
        // REQUEST as the RESPONSE to an outstanding session/prompt: the
        // permission never reaches acpPermissionToButtonRequest below (the
        // human never sees the card) and the prompt's `advance()` fires
        // prematurely, flushing the next queued text into a session that is
        // actually still blocked on that unanswered permission decision --
        // reproducing the exact double-frame wedge this whole file exists to
        // prevent, through the id-collision back door (review finding,
        // 2026-09-18). A genuine JSON-RPC response never carries `method`.
        if (typeof rec.id === "number" && rec.method === undefined && client.pending.has(rec.id)) {
          const wait = client.pending.get(rec.id)!
          client.pending.delete(rec.id)
          if (rec.error) wait.reject(new Error(rec.error.message ?? "ACP error"))
          else wait.resolve(raw)
          continue
        }
        const perm = acpPermissionToButtonRequest(raw)
        if (perm) {
          client.pendingPermissions += 1
          onPermission(perm)
        }
        const title = acpSessionTitleFromUpdate(raw)
        if (title) log(`omp-acp: session title from omp: ${title}`)
      }
    }
  }
  void loop()
}

async function acpCall(client: OmpAcpClient, methodBuilder: (id: number) => object, timeoutMs: number): Promise<unknown> {
  const id = client.nextId++
  const msg = methodBuilder(id)
  return await new Promise((resolve, reject) => {
    const timer = setTimeout(() => {
      client.pending.delete(id)
      reject(new Error(`ACP ${"method" in msg ? (msg as { method: string }).method : "call"} timed out`))
    }, timeoutMs)
    client.pending.set(id, {
      resolve: (v) => {
        clearTimeout(timer)
        resolve(v)
      },
      reject: (e) => {
        clearTimeout(timer)
        reject(e)
      },
    })
    writeAcp(client, msg)
  })
}

let ompPermissionSink: ((req: ButtonRequest) => void) | null = null

type OmpAcpTarget = { cwd?: string | null; sessionId?: string | null; pid?: number }

function ompAcpKey(agent: OmpAcpTarget): string {
  if (agent.sessionId) return `session:${agent.sessionId}`
  if (agent.pid) return `omp:${agent.pid}`
  return `cwd:${agent.cwd ?? "/"}`
}

async function ensureOmpAcp(agent: OmpAcpTarget): Promise<OmpAcpClient> {
  const key = ompAcpKey(agent)
  const existing = ompAcpClients.get(key)
  if (existing && existing.proc.exitCode === null) return existing

  const inFlight = ompAcpEnsuring.get(key)
  if (inFlight) return inFlight

  const attempt = ensureOmpAcpSpawn(agent, key).finally(() => {
    // Only clear if we're still the in-flight attempt for this key -- a
    // later caller may already have started a NEW attempt (e.g. this one
    // failed and a fresh reply retried) whose own entry must not be wiped.
    if (ompAcpEnsuring.get(key) === attempt) ompAcpEnsuring.delete(key)
  })
  ompAcpEnsuring.set(key, attempt)
  return attempt
}

async function ensureOmpAcpSpawn(agent: OmpAcpTarget, key: string): Promise<OmpAcpClient> {
  const cwd = agent.cwd || "/"
  const loadSession = Boolean(agent.sessionId)
  const proc = Bun.spawn(["omp", ...ompAcpSpawnArgv({ cwd, loadSession })], {
    stdin: "pipe",
    stdout: "pipe",
    stderr: "pipe",
    env: { ...process.env, TMUX: "" },
  })
  const client: OmpAcpClient = {
    proc,
    cwd,
    sessionId: "",
    buf: "",
    nextId: 1,
    pending: new Map(),
    lastActivityAt: Date.now(),
    pendingPermissions: 0,
    promptInFlightId: null,
    promptQueue: [],
  }
  pumpAcpClient(client, (req) => {
    ompPermissionSink?.(req)
  })
  await acpCall(client, (id) => buildAcpInitialize(id), 15_000)
  if (agent.sessionId) {
    const loaded = await acpCall(client, (id) => buildAcpSessionLoad(id, cwd, agent.sessionId!), 15_000)
    const sessionId = acpSessionIdFromResult(loaded) ?? agent.sessionId
    if (!sessionId) {
      proc.kill()
      throw new Error("omp acp session/load returned no sessionId")
    }
    client.sessionId = sessionId
    ompAcpClients.set(key, client)
    log(`omp-acp: session/load sessionId=${sessionId} cwd=${cwd} pid=${agent.pid ?? "?"}`)
    return client
  }
  const created = await acpCall(client, (id) => buildAcpSessionNew(id, cwd), 15_000)
  const sessionId = acpSessionIdFromResult(created)
  if (!sessionId) {
    proc.kill()
    throw new Error("omp acp session/new returned no sessionId")
  }
  client.sessionId = sessionId
  ompAcpClients.set(key, client)
  log(`omp-acp: session/new sessionId=${sessionId} cwd=${cwd}`)
  return client
}

async function promptOmpAcp(target: OmpAcpTarget | string, text: string): Promise<{ ok: true } | { ok: false; error: string }> {
  const agent: OmpAcpTarget = typeof target === "string" ? { cwd: target } : target
  const cwd = agent.cwd || "/"
  try {
    const client = await ensureOmpAcp(agent)
    queuePrompt(client, agent, text)
    return { ok: true }
  } catch (err) {
    const error = err instanceof Error ? err.message : String(err)
    log(`omp-acp: prompt delivery failed cwd=${cwd} session=${agent.sessionId ?? "-"}: ${error}`)
    return { ok: false, error }
  }
}

// Writes `text` as this client's next `session/prompt` if none is currently
// outstanding; otherwise appends it to the client's queue. ACP session/prompt
// is one turn at a time per session -- the tg-cli#353 wedge (a session already
// owned by another live process) is exactly what a SECOND, un-acknowledged
// prompt racing into the same pipe produces. Queued texts are flushed in
// order as each prior prompt resolves (a matched response) or times out (the
// eviction watchdog below). Never blocks: always returns immediately,
// preserving the tg-cli#322 fire-and-forget contract.
function queuePrompt(client: OmpAcpClient, agent: OmpAcpTarget, text: string): void {
  if (client.promptInFlightId !== null) {
    client.promptQueue.push(text)
    // Incident-triage visibility (and a deterministic signal integration
    // tests can poll for instead of a blind sleep): a queued prompt is
    // otherwise invisible until it's eventually written or dropped.
    log(
      `omp-acp: session/prompt queued cwd=${agent.cwd || "/"} session=${agent.sessionId ?? client.sessionId ?? "-"} ` +
        `(in flight, ${client.promptQueue.length} queued)`,
    )
    return
  }
  writePrompt(client, agent, text)
}

function writePrompt(client: OmpAcpClient, agent: OmpAcpTarget, text: string): void {
  const cwd = agent.cwd || "/"
  const id = client.nextId++
  client.promptInFlightId = id

  let timer: ReturnType<typeof setTimeout> | null = null

  // Releases the queue for THIS prompt's id only -- a stale advance/evict
  // from an already-superseded id (the other of the two already moved on to
  // a fresh client for a later prompt) is a no-op, since promptInFlightId no
  // longer matches.
  const advance = (): void => {
    if (client.promptInFlightId !== id) return
    if (timer) clearTimeout(timer)
    client.promptInFlightId = null
    const next = client.promptQueue.shift()
    if (next !== undefined) queuePrompt(client, agent, next)
  }

  // Kills the client and redelivers `text` -- the prompt that was in flight
  // when the session turned out to be broken, previously silently dropped --
  // plus everything queued behind it, through a fresh client for this key.
  // Called ONLY by the watchdog's genuinely-dead-pipe branch below (a real
  // ACP error response is handled separately, by `reject` below, WITHOUT
  // eviction -- see its comment for why). Reusing the SAME dead pipe for the
  // next queued text would just repeat the identical failure.
  //
  // Known accepted tradeoff (review finding, 2026-09-18, not fixed here):
  // redelivering the in-flight text turns a false-positive eviction (the
  // session was genuinely still working, just silent -- e.g. one long
  // tool call with no intermediate `session/update` chatter for a full
  // ACP_PROMPT_TIMEOUT_MS) into a DUPLICATE execution of that turn once the
  // original eventually finishes, instead of the pre-fix silent loss. Silent
  // loss is the exact production incident this change targets; a true fix
  // for false-positive duplication needs an ACP-level heartbeat/cancel
  // signal, out of scope here.
  const evict = (reason: string): void => {
    if (client.promptInFlightId !== id) return
    if (timer) clearTimeout(timer)
    client.pending.delete(id)
    const key = ompAcpKey(agent)
    const stillCached = ompAcpClients.get(key) === client
    if (stillCached) ompAcpClients.delete(key)
    const proc = client.proc
    proc.kill("SIGKILL")
    // Only log a real eviction: if a newer client already replaced this one
    // under the same key, killing the orphaned old proc is just cleanup, not
    // an eviction from the live map -- a duplicate/misleading log line here
    // would undermine the incident-triage trust this change exists for.
    if (stillCached) {
      log(`omp-acp: evicted wedged client cwd=${cwd} session=${agent.sessionId ?? "-"} (${reason})`)
    }
    // SEQUENTIALLY awaited, not a fire-and-forget loop: promptOmpAcp only
    // awaits ensureOmpAcp (session spawn/load), not the prompt's own reply,
    // so awaiting it here still returns promptly -- but it guarantees the
    // first redelivered text's ensureOmpAcp call finishes (and registers the
    // fresh client in ompAcpClients) BEFORE the next queued text's
    // promptOmpAcp call reads the map. A concurrent (un-awaited) loop would
    // race N ensureOmpAcp calls against an empty cache and spawn N separate
    // `omp acp` processes for one wedged key instead of one.
    const redeliver = [text, ...client.promptQueue.splice(0)]
    client.promptInFlightId = null
    void (async () => {
      try {
        // Wait for the killed process to actually exit before spawning its
        // replacement (matches spawnGuarded's SIGKILL+await-exited
        // convention elsewhere in this file) -- a still-alive wedged owner
        // racing a fresh session/load on the same session would recreate the
        // exact double-ownership wedge eviction exists to resolve (review
        // finding, 2026-09-18).
        await proc.exited
        for (const redeliverText of redeliver) {
          await promptOmpAcp(agent, redeliverText)
        }
      } catch (err) {
        // Never let redelivery itself throw -- it runs outside promptOmpAcp's
        // own try/catch (a fresh event-loop turn) and would crash the daemon.
        log(`omp-acp: redelivery failed cwd=${cwd} session=${agent.sessionId ?? "-"}: ${err instanceof Error ? err.message : String(err)}`)
      }
    })()
  }

  client.pending.set(id, {
    resolve: () => advance(),
    reject: (err) => {
      // Previously silently discarded -- an explicit ACP error response (e.g.
      // a transient per-turn failure) named the exact failure with zero log
      // line. Log it and advance the queue normally (NOT evict): the client
      // just proved its pipe is alive by replying at all, only this one
      // prompt failed. Treating every error reply as a dead pipe was tried
      // and reverted (review finding, 2026-09-18) -- for a PERSISTENT
      // per-session error (e.g. "session already owned by another live
      // process") it produced an unbounded, zero-backoff evict/respawn loop
      // with no retry cap, since each fresh client's session/prompt would
      // fail identically and immediately re-evict. A genuinely dead pipe is
      // still caught by the watchdog below (paced at ACP_PROMPT_TIMEOUT_MS,
      // not immediate).
      log(`omp-acp: session/prompt error cwd=${cwd} session=${agent.sessionId ?? "-"}: ${err.message}`)
      advance()
    },
  })
  writeAcp(client, buildAcpSessionPrompt(id, client.sessionId, text))

  // Regression (tg-cli#353 relapse, 2026-09-17): the prior design awaited
  // acpCall(...120_000) here, blocking Telegram delivery on the agent's real
  // reply for up to two minutes -- the root cause a rejected prior fix then
  // papered over with a shutdown drain timer instead of removing the wait.
  // This timer is a WATCHDOG, not a wait: promptOmpAcp already returned. It
  // exists purely to evict a client whose pipe is genuinely dead (tg-cli#353:
  // a target session already owned by another live process) so the NEXT
  // prompt gets a fresh child instead of reusing a wedge forever.
  //
  // `checkpoint` is a SLIDING watchdog boundary, not the original prompt-sent
  // time: a still-alive session (streaming session/update notifications, or a
  // human mid-decision on a permission) must never advance the queue while
  // turn 1 is still outstanding -- that would write a SECOND session/prompt
  // frame into the same live pipe, exactly the relapse this change exists to
  // prevent, just delayed past the timeout. Re-arming against a fresh
  // checkpoint (not the original) keeps waiting for the real response (via
  // `advance` above) or genuine silence to drive the queue, instead of ever
  // force-advancing a session that is provably still working.
  const scheduleWatchdog = (checkpoint: number): void => {
    timer = setTimeout(() => {
      try {
        if (client.promptInFlightId !== id) return
        // Strict > (not >=): lastActivityAt can tie with `checkpoint` at
        // millisecond resolution (e.g. a session/load response resolving
        // right as the initial checkpoint is captured) -- a >= comparison
        // would wrongly treat that as "traffic since the checkpoint" and
        // mask a genuinely wedged session/prompt.
        if (client.pendingPermissions > 0 || client.lastActivityAt > checkpoint) {
          scheduleWatchdog(Date.now())
          return
        }
        evict(`no ACP traffic ${ACP_PROMPT_TIMEOUT_MS}ms after prompt`)
      } catch (err) {
        // Never let the deferred timer itself throw -- an uncaught exception
        // here runs outside promptOmpAcp's own try/catch (a fresh event-loop
        // turn) and would crash the daemon, defeating the whole fire-and-
        // forget point of this function.
        log(`omp-acp: eviction check failed cwd=${cwd} session=${agent.sessionId ?? "-"}: ${err instanceof Error ? err.message : String(err)}`)
      }
    }, ACP_PROMPT_TIMEOUT_MS)
  }
  scheduleWatchdog(Date.now())
}

async function replyOmpAcpPermission(req: ButtonRequest, optionId: string): Promise<{ ok: true } | { ok: false; error: string }> {
  const reply = acpPermissionReply(req, optionId)
  if (!reply || !req.omp) return { ok: false, error: "not an omp ACP permission" }
  const client = [...ompAcpClients.values()].find((c) => c.sessionId === req.omp!.sessionId)
  if (!client) return { ok: false, error: "omp ACP session is gone — not injecting into tmux" }
  writeAcp(client, reply)
  client.pendingPermissions = Math.max(0, client.pendingPermissions - 1)
  client.lastActivityAt = Date.now()
  return { ok: true }
}

function liveOmpForPane(paneId: string, agentPid?: number): LiveOmpAgent | null {
  const agents = listLiveOmpAgents()
  return agents.find((a) => a.paneId === paneId || (agentPid !== undefined && a.pid === agentPid)) ?? null
}

function noAgentReplyNow(): string {
  const live = listLiveOmpAgents()
  const unreachable = listUnreachableAgents()
  if (live.length > 0) {
    const lines = live.map((a) => `  - ${describeLiveOmp(a)}`)
    const ompBlock = `omp (ACP, never tmux send-keys):\n${lines.join("\n")}`
    if (unreachable.length === 0) return ompBlock
    return `${ompBlock}\n${noAgentReplyText("", unreachable)}`
  }
  return noAgentReplyText(NO_AGENT_REPLY, unreachable)
}

// Count the lines of a JSONL file (0 when absent/unreadable, or the key is unknown).
function pendingInboxCount(ctx: Ctx, key: string | null): number {
  if (key === null) return 0
  const raw = readFileOrNull(join(inboxDirFor(ctx.configDir, key), PENDING_FILE))
  return raw ? parseInboxLines(raw).entries.length : 0
}

// The inbox holds the user's private Telegram text: directories 0700, files 0600 —
// enforced on every write, including paths that already existed with looser modes
// (review finding: a 022 umask would otherwise leave them world-readable).
function tightenInboxModes(dir: string, file?: string): void {
  chmodSync(inboxRoot(dirname(dirname(dir))), INBOX_DIR_MODE)
  chmodSync(dir, INBOX_DIR_MODE)
  if (file && existsSync(file)) chmodSync(file, INBOX_FILE_MODE)
}

// Append ONE entry to an agent's pending inbox: mkdir -p + a single O_APPEND write of
// one complete line (never a torn record for the consuming Stop hook). Throws on IO
// failure — the caller turns that into an explicit Telegram reply.
function queueToInbox(ctx: Ctx, key: string, entry: InboxEntry): void {
  const dir = inboxDirFor(ctx.configDir, key)
  mkdirSync(dir, { recursive: true, mode: INBOX_DIR_MODE })
  const pending = join(dir, PENDING_FILE)
  appendFileSync(pending, serializeInboxEntry(entry), { mode: INBOX_FILE_MODE })
  tightenInboxModes(dir, pending)
}

// Route the late-approval grant notice (tg-cli#398) to the ask's origin WITHOUT
// depending on a live permission menu or a tmux pane — the production failure
// this exists to fix was exactly that dependency (the pane-injection path in
// lateDeliverAbandonedQuestion logged `ask-late-deliver-permission-pane-skip
// reason=no-menu` and dropped the delivery for headless hatch asks, ≥8
// instances on 2026-09-10). Priority mirrors routeForRequest's identity order
// (grants.ts): a real pane → omp ACP (origin.agent === "omp", preferring
// origin.sessionId, else a live-agent match on subagent name / cwd basename —
// session/load revives a persisted session even after its process exited) →
// the Stop-hook inbox (the default route for paneless agents, THE shared
// contract with agent-tools' inbox reader). Returns whether the notice was
// DELIVERED on any channel; a Telegram ACP/inbox total failure is reported by
// the caller on the card (the grant itself still stands — the token path
// always works).
async function routeGrantNotice(ctx: Ctx, req: ButtonRequest, text: string): Promise<boolean> {
  if (req.paneId) {
    try {
      const res = await executeInjectSteps(buildTextInjectPlan(req.paneId, wrapInbound(ctx.cfg.injectWrap, "tg", text)))
      return res.ok
    } catch (err) {
      log(`grant-notice pane route failed pane=${req.paneId}: ${err instanceof Error ? err.message : String(err)}`)
      return false
    }
  }
  if (req.origin?.agent === "omp") {
    let target: OmpAcpTarget | null = null
    if (req.origin.sessionId) target = { cwd: req.cwd, sessionId: req.origin.sessionId }
    else {
      const agents = listLiveOmpAgents()
      const matched = req.origin.subagent ? matchLiveOmp(req.origin.subagent, agents) : []
      const agent =
        matched[0] ??
        agents.find((a) => Boolean(a.cwd && req.cwd && basename(a.cwd) === basename(req.cwd))) ??
        null
      if (agent) target = { cwd: agent.cwd ?? req.cwd, sessionId: agent.sessionId, pid: agent.pid }
    }
    if (target) {
      const res = await promptOmpAcp(target, text)
      if (res.ok) return true
      log(`grant-notice omp route failed (falling back to inbox) session=${target.sessionId ?? "-"}: ${res.error}`)
    }
  }
  try {
    queueToInbox(ctx, agentInboxKey(req.origin?.subagent ?? req.subagent ?? null, req.cwd ?? "/"), {
      id: null,
      ts: new Date().toISOString(),
      from: "tg",
      text,
      wrapped: text,
    })
    return true
  } catch (err) {
    log(`grant-notice inbox route failed key-cwd=${req.cwd ?? "-"}: ${err instanceof Error ? err.message : String(err)}`)
    return false
  }
}

function listInboxKeys(ctx: Ctx): string[] {
  try {
    return readdirSync(inboxRoot(ctx.configDir), { withFileTypes: true })
      .filter((d) => d.isDirectory())
      .map((d) => d.name)
      .sort()
  } catch {
    return []
  }
}

// React 👌 on a delivered message. Returns false ONLY for a failure worth retrying
// (network error, 5xx, 429) — a definitive Telegram refusal (4xx: message gone,
// REACTION_INVALID) is final and counts as done, so a batch never wedges on it.
async function reactDelivered(ctx: Ctx, messageId: number): Promise<boolean> {
  const emoji = reactionForStage("done")
  if (!isAllowedReaction(emoji)) return true
  const r = await botPostResult(ctx, "setMessageReaction", {
    chat_id: ctx.chatId,
    message_id: messageId,
    reaction: [{ type: "emoji", emoji }],
  })
  if (r.ok) return true
  const retryable = r.status === undefined || r.status === 429 || r.status >= 500
  log(`inbox: 👌 reaction on tg#${messageId} failed (${r.status ?? "network"}: ${r.description}) — ${retryable ? "will retry" : "final"}`)
  return !retryable
}

// Ack what the Stop hook delivered. The hook publishes each consumption as ONE complete
// `delivered-<pid>-<ts>.jsonl` (temp + rename), so a file we see is whole and no in-
// flight hook write can be lost to our unlink. Per file: react 👌 on every Telegram id,
// archive into acked.jsonl, unlink. A batch whose reaction hit a RETRYABLE failure is
// left on disk for the next sweep (review finding: a transient Bot API outage must not
// discard the promised receipt). Never throws into the poll loop.
async function ackDeliveredInboxes(ctx: Ctx): Promise<void> {
  for (const key of listInboxKeys(ctx)) {
    const dir = inboxDirFor(ctx.configDir, key)
    try {
      for (const name of readdirSync(dir)) {
        if (!isDeliveredBatchFile(name)) continue
        const path = join(dir, name)
        const raw = readFileOrNull(path) ?? ""
        const parsed = parseInboxLines(raw)
        let allReacted = true
        for (const id of idsToAck(parsed.entries)) {
          if (!(await reactDelivered(ctx, id))) allReacted = false
        }
        if (!allReacted) continue // keep the batch; retried next sweep
        if (parsed.entries.length > 0 || parsed.malformed > 0) {
          log(`inbox ${key}: ${parsed.entries.length} delivered by the Stop hook (${parsed.malformed} malformed) — acked`)
        }
        if (raw) appendFileSync(join(dir, ACKED_FILE), raw.endsWith("\n") ? raw : `${raw}\n`, { mode: INBOX_FILE_MODE })
        unlinkSync(path)
      }
    } catch (err) {
      log(`inbox ${key}: ack sweep failed: ${err}`)
    }
  }
}

// `tg-ctl inbox [queue <selector> <text…>]` — the CLI view of the tmux-free channel.
function runInboxCommand(ctx: Ctx, argv: string[]): number {
  const agents = listUnreachableAgents()
  if (argv[0] === "queue") {
    const selector = argv[1] ?? ""
    const text = argv.slice(2).join(" ").trim()
    if (!selector || !text) {
      console.error("usage: tg-ctl inbox queue <name|dir> <text…>")
      return 1
    }
    const hits = matchUnreachable(selector, agents)
    if (hits.length !== 1) {
      console.error(
        hits.length === 0
          ? `no agent outside tmux matches '${selector}' (running: ${agents.map(unreachableLabel).join(", ") || "none"})`
          : `'${selector}' is ambiguous: ${hits.map((a) => describeUnreachable(a, 0)).join("; ")}`,
      )
      return 1
    }
    const key = unreachableKey(hits[0])
    if (key === null) {
      console.error(`${unreachableLabel(hits[0])}: inbox key unknown (no --name and its cwd could not be resolved) — cannot queue`)
      return 1
    }
    const clashes = inboxKeyCollisions(hits[0], agents)
    if (clashes.length > 0) {
      console.error(`refusing: inbox key '${key}' is shared with another live session (${clashes.map((a) => describeUnreachable(a, 0)).join("; ")}) — give them distinct --name values`)
      return 1
    }
    try {
      queueToInbox(ctx, key, {
        id: null,
        ts: new Date().toISOString(),
        from: "tg-ctl",
        text,
        wrapped: wrapInbound(ctx.cfg.injectWrap, "tg-ctl", text),
      })
    } catch (err) {
      console.error(`could not write the inbox for ${key}: ${err}`)
      return 1
    }
    console.log(`queued to ${key} (${describeUnreachable(hits[0], pendingInboxCount(ctx, key))})`)
    return 0
  }
  const keys = listInboxKeys(ctx)
  if (agents.length === 0 && keys.length === 0) {
    console.log("inbox: no agent outside tmux, no inbox on disk")
    return 0
  }
  for (const a of agents) console.log(`  - ${describeUnreachable(a, pendingInboxCount(ctx, unreachableKey(a)))}`)
  const live = new Set(agents.map(unreachableKey).filter((k): k is string => k !== null))
  for (const key of keys) {
    if (live.has(key)) continue
    const n = pendingInboxCount(ctx, key)
    if (n > 0) console.log(`  - ${key}: ${n} queued, agent not running (delivered when an agent with this key next ends a turn)`)
  }
  console.log(UNREACHABLE_HINT)
  return 0
}

// Execute an InjectStep plan. verify-pane re-runs discovery on a CURRENT
// snapshot — the agent may have exited between picking the target and typing
// into it, and injecting into a bare shell would EXECUTE the text (spec §5.2).
async function executeInjectSteps(steps: InjectStep[]): Promise<{ ok: true } | { ok: false; error: string }> {
  for (const step of steps) {
    if (step.kind === "verify-pane") {
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === step.paneId)
      if (!pane || findAgentInPane(pane, procs) === null) {
        return { ok: false, error: `pane ${step.paneId} no longer hosts an agent — message not injected` }
      }
    } else if (step.kind === "tmux") {
      const proc = Bun.spawnSync(step.argv, {
        stdin: step.stdin !== undefined ? new TextEncoder().encode(step.stdin) : undefined,
        stdout: "ignore",
        stderr: "pipe",
      })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `${step.argv.join(" ")} failed: ${proc.stderr.toString().trim()}` }
      }
    } else {
      await Bun.sleep(step.ms)
    }
  }
  return { ok: true }
}

function executeInjectStepsSync(steps: InjectStep[]): { ok: true } | { ok: false; error: string } {
  for (const step of steps) {
    if (step.kind === "verify-pane") {
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === step.paneId)
      if (!pane || findAgentInPane(pane, procs) === null) {
        return { ok: false, error: `pane ${step.paneId} no longer hosts an agent — message not injected` }
      }
    } else if (step.kind === "tmux") {
      const proc = Bun.spawnSync(step.argv, {
        stdin: step.stdin !== undefined ? new TextEncoder().encode(step.stdin) : undefined,
        stdout: "ignore",
        stderr: "pipe",
      })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `${step.argv.join(" ")} failed: ${proc.stderr.toString().trim()}` }
      }
    } else {
      Bun.sleepSync(step.ms)
    }
  }
  return { ok: true }
}

// Capture a pane's current visible text (`tmux capture-pane -pJ`), used to
// re-check whether a Claude Code numbered permission menu is STILL showing
// before late-delivering a decision into it (see the permission branch of
// lateDeliverAbandonedQuestion). `-J` joins tmux's internal line-wrap breaks
// back into logical lines — without it, a long command that hard-wraps
// mid-token gets a newline (→ a space, after permission-menu.ts's whitespace
// normalization) inserted INSIDE the token, which can turn a real identity
// match into a false negative for exactly the long commands most likely to
// hit the 120s hook budget in the first place (review finding). Never
// throws: a dead pane / missing tmux yields null, same fail-soft posture as
// the rest of this file's tmux calls.
function capturePane(paneId: string): string | null {
  try {
    const proc = Bun.spawnSync(["tmux", "capture-pane", "-p", "-J", "-t", paneId], {
      stdout: "pipe",
      stderr: "pipe",
      env: SUBPROC_ENV,
    })
    if (proc.exitCode !== 0) return null
    return proc.stdout.toString()
  } catch {
    return null
  }
}

// --- voice transcription (inbound STT) ---

// Configured AND the on-disk artefacts still exist. The config gate
// (isVoiceConfigured) is cheap; this adds the filesystem check the step function
// can't do (it is pure). A deleted model/binary falls back to onboarding instead
// of downloading the note and failing deep inside the runner.
function voiceReady(ctx: Ctx): boolean {
  if (!isVoiceConfigured(ctx.voice)) return false
  if (!existsSync(ctx.voice.binPath)) return false
  // whisper.cpp model is always a path → must exist. faster-whisper model is
  // EITHER a bare size token ('large-v3' — downloaded on demand, no path check)
  // OR a local CT2 directory path; a path-shaped value (contains a slash) must
  // exist on disk, else a stale/moved model would pass the gate and fail in
  // Python after the note was already downloaded.
  if (ctx.voice.runner === "whisper.cpp") {
    if (!existsSync(ctx.voice.modelPath)) return false
  } else if (ctx.voice.modelPath.includes("/")) {
    if (!existsSync(ctx.voice.modelPath)) return false
  }
  return true
}

// Spawn a binary ASYNCHRONOUSLY (Bun.spawn, not spawnSync) with a timeout +
// pipes, NEVER throwing. Async is the key: ffmpeg/whisper can take many seconds,
// and spawnSync would BLOCK the daemon's single event loop — freezing the
// Telegram poll loop AND the Unix hook server (q→buttons) until the child exits.
// `await proc.exited` yields the loop so hooks and other control messages keep
// flowing during a long transcription. The timeout kills the child (and so the
// awaited promise resolves) instead of wedging. A missing executable makes
// Bun.spawn throw ENOENT, which — uncaught — would bubble to the poll loop AFTER
// the offset was persisted and silently lose the note; caught here → exit 127.
async function spawnGuarded(
  argv: string[],
  timeoutMs: number,
  opts: { cwd?: string } = {},
): Promise<{ exitCode: number; stdout: string; stderr: string }> {
  let child: ReturnType<typeof Bun.spawn> | undefined
  try {
    child = Bun.spawn(argv, { stdin: "ignore", stdout: "pipe", stderr: "pipe", ...(opts.cwd ? { cwd: opts.cwd } : {}) })
    const proc = child
    let timedOut = false
    const timer = setTimeout(() => {
      timedOut = true
      proc.kill("SIGKILL")
    }, timeoutMs)
    try {
      const [stdout, stderr] = await Promise.all([
        new Response(proc.stdout).text(),
        new Response(proc.stderr).text(),
      ])
      await proc.exited
      if (timedOut) return { exitCode: 124, stdout, stderr: `${stderr}\ntimed out after ${timeoutMs}ms` }
      return { exitCode: proc.exitCode ?? 1, stdout, stderr }
    } finally {
      clearTimeout(timer)
    }
  } catch (err) {
    return { exitCode: 127, stdout: "", stderr: `spawn ${argv[0]} failed: ${err}` }
  }
}

// Spawn ffmpeg (OGG→WAV 16k mono) then the configured Whisper, returning the
// cleaned transcript or null on failure. Both spawns are ASYNC (event loop stays
// free for hooks/poll during a long transcription), timeout-guarded so a stuck
// binary can't wedge the loop, and exception-guarded so a MISSING binary returns
// null (not an uncaught throw). The WAV is written next to the OGG.
async function runTranscription(ctx: Ctx, oggPath: string): Promise<string | null> {
  const wavPath = oggPath.replace(/\.[^.]+$/, "") + ".wav"
  const ff = await spawnGuarded(buildFfmpegArgv(oggPath, wavPath), 60_000)
  if (ff.exitCode !== 0 || !existsSync(wavPath)) {
    log(`ffmpeg failed: ${ff.stderr.trim()}`)
    return null
  }

  const argv =
    ctx.voice.runner === "whisper.cpp"
      ? buildWhisperCppArgv(ctx.voice, wavPath)
      : buildFasterWhisperArgv(ctx.voice.binPath, fasterWhisperScriptPath(ctx), ctx.voice, wavPath)

  const proc = await spawnGuarded(argv, 300_000)
  try {
    unlinkSync(wavPath)
  } catch {
    // best-effort cleanup
  }
  if (proc.exitCode !== 0) {
    log(`whisper failed (${ctx.voice.runner}): ${proc.stderr.trim()}`)
    return null
  }
  return cleanTranscript(proc.stdout)
}

function formatVoiceConfirmation(text: string): string {
  const prefix = "🎤 Расшифровка: "
  const suffix = "\n… (здесь укорочено; полный текст не обрезается перед маршрутизацией)"
  const maxTelegramText = 4096
  const full = `${prefix}${text}`
  if (full.length <= maxTelegramText) return full

  const maxTextLength = Math.max(0, maxTelegramText - prefix.length - suffix.length)
  const kept: string[] = []
  let keptLength = 0
  for (const char of text) {
    if (keptLength + char.length > maxTextLength) break
    kept.push(char)
    keptLength += char.length
  }
  const out = `${prefix}${kept.join("")}${suffix}`
  if (out.length <= maxTelegramText) return out
  return `${prefix}${suffix}`.slice(0, maxTelegramText)
}

// The faster-whisper runner script: the configured project's own transcriber
// when it ships one (my_faster_whisper.py / transcribe.py), else a generated
// fallback written into the config dir. `main.py` is intentionally NOT trusted
// as a transcriber — uv-init projects ship a "Hello world" main.py that would
// silently produce no text. Resolved at transcription time (not stored) so a
// moved project is tolerated. The fallback is written once and reused.
function fasterWhisperScriptPath(ctx: Ctx): string {
  // binPath is <project>/.venv/bin/python → project root is three dirs up.
  const projectRoot = resolve(ctx.voice.binPath, "..", "..", "..")
  for (const name of ["my_faster_whisper.py", "transcribe.py"]) {
    const candidate = join(projectRoot, name)
    if (existsSync(candidate)) return candidate
  }
  // No project transcriber → write (once) the self-contained fallback.
  const fallback = join(ctx.configDir, "tg-faster-whisper.py")
  if (!existsSync(fallback)) {
    try {
      mkdirSync(ctx.configDir, { recursive: true })
      writeFileSync(fallback, FASTER_WHISPER_FALLBACK_SCRIPT)
    } catch (err) {
      log(`faster-whisper fallback script write failed: ${err}`)
    }
  }
  return fallback
}

// Persist the resolved voice config into <configDir>/config.yaml, replacing any
// existing `voice:` block (or appending one). No secrets here — only
// binary/model paths + language. The config dir is created first (a fresh
// machine running `tg voice setup` before anything else has no ~/.config/tg-cli
// yet). Returns whether the write landed so the caller can avoid claiming
// "configured" on a swallowed ENOENT.
function persistVoiceConfigToDir(configDir: string, cfg: VoiceConfig): boolean {
  try {
    mkdirSync(configDir, { recursive: true })
    const path = join(configDir, "config.yaml")
    const existing = readFileOrNull(path) ?? ""
    writeFileSync(path, upsertVoiceBlock(existing, cfg))
    return true
  } catch (err) {
    log(`voice config persist failed: ${err}`)
    return false
  }
}

// `tg-ctl voice-setup` (invoked by `tg voice setup`): probe the host, decide,
// persist when ready, and print the human guidance to stdout so the CLI relays
// it. Never sends to Telegram — this is the interactive local path. Takes only
// what it needs (no bot token / chatId — the gate is bypassed for this command).
// Returns true on success (config written, or guidance shown for a not-ready
// host), false ONLY when a ready install could not be persisted — the caller
// exits non-zero in that case so scripts/agents don't mistake a failed write for
// a successful setup.
function runVoiceSetup(args: { configDir: string; home: string; language: string }): boolean {
  const verdict = decideOnboarding(probeWhisper(args.home), args.language)
  if (verdict.kind === "ready") {
    if (!persistVoiceConfigToDir(args.configDir, verdict.cfg)) {
      console.error(
        `Found a local Whisper (${verdict.cfg.runner}, ${verdict.cfg.modelPath}) but could not write ` +
          `${join(args.configDir, "config.yaml")}. Fix the permissions and re-run \`tg voice setup\`.`,
      )
      return false
    }
  }
  // This is the CLI path (`tg voice setup`): colorize the ✓/○ status glyph for a
  // terminal (green=configured, yellow=pending), and never when piped/NO_COLOR.
  // The DAEMON path (an unconfigured voice note) sends onboardingMessage to
  // Telegram uncolored — it builds the message directly and never calls this.
  console.log(colorizeVoiceStatus(onboardingMessage(verdict), shouldColorize()))
  return true
}

// Shared by `tg-ctl status` (CLI) and the /status command (TG reply). Works
// with no daemon running — everything is read from files + live discovery.
function findShadowingClaudeStatusLine(home: string, cwd: string, command: string): string | null {
  const userSettingsPath = resolve(home, ".claude", "settings.json")
  let dir = resolve(cwd)
  while (true) {
    for (const name of ["settings.local.json", "settings.json"]) {
      const candidate = resolve(dir, ".claude", name)
      if (candidate === userSettingsPath) continue
      const settings = readJsonObjectOrNull(candidate)
      if (!settings || !hasClaudeStatusLineCommand(settings)) continue
      return claudeStatusLineTelemetryInstalled(settings, command) ? null : candidate
    }
    const parent = dirname(dir)
    if (parent === dir) return null
    dir = parent
  }
}

function newestRegisteredCwd(regs: Registration[]): string | null {
  let best: Registration | null = null
  for (const reg of regs) {
    if (!reg.cwd) continue
    if (!best || (reg.registeredAt ?? 0) > (best.registeredAt ?? 0)) best = reg
  }
  return best?.cwd ?? null
}

function registeredCwdForPane(regs: Registration[], pane: Pick<PaneInfo, "paneId" | "sessionName">): string | null {
  const exact = regs.find((reg) => reg.cwd && reg.paneId && reg.paneId === pane.paneId)
  if (exact?.cwd) return exact.cwd
  const sessionMatches = regs.filter((reg) => reg.cwd && !reg.paneId && reg.sessionName && reg.sessionName === pane.sessionName)
  return sessionMatches.length === 1 ? sessionMatches[0].cwd! : null
}

function singleRegisteredCwd(regs: Registration[]): string | null {
  const unique = [...new Set(regs.map((reg) => reg.cwd).filter((cwd): cwd is string => Boolean(cwd)))]
  return unique.length === 1 ? unique[0] : null
}

function composeStatus(ctx: Ctx, statusCwd: string | null): string {
  const env = autostartEnv(ctx)
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const pidAlive = pid !== null && kill0(pid)
  const lockPid = pidAlive ? null : lockHolderPid(ctx.paths.lock)
  const hintPid = pidAlive ? pid : lockPid
  const launchd = detectLaunchdDaemon(env, hintPid)
  const lines: string[] = [daemonStatusLine(daemonRunState(pid, pidAlive, launchd, lockPid), ctx.botId)]


  // Show every LIVE registered session (the per-pane set), not just one — a
  // multi-session operator must SEE that all their panes are registered to
  // forward. Prune against the live snapshot so closed panes don't show as ghosts
  // (review finding); a flaky/empty snapshot skips pruning (shows all, fail-safe).
  const statusPanes = snapshot().panes
  const statusLive = statusPanes.length > 0 ? new Set(statusPanes.map((p) => p.paneId)) : null
  const regs = readRegistrations(ctx.paths, statusLive)
  if (regs.length === 0) {
    lines.push("registrations: none")
  } else {
    lines.push(`registrations: ${regs.length}`)
    for (const reg of regs) {
      lines.push(
        `  - pane ${reg.paneId ?? "?"}, cwd ${reg.cwd ?? "?"}` +
          (reg.sessionName ? `, session ${reg.sessionName}` : ""),
      )
    }
  }
  const found = discoverTarget(ctx)
  const statusScopeCwd = statusCwd ?? (found.ok ? found.target.pane.panePath : newestRegisteredCwd(regs) ?? ctx.cwd)
  lines.push(
    found.ok
      ? `target: ${found.target.agent} in ${found.target.pane.sessionName}:${found.target.pane.windowIndex} ` +
          `${found.target.pane.paneId}` +
          (found.target.agentPid !== undefined ? ` (pid ${found.target.agentPid})` : "")
      : found.reason === "ambiguous"
        ? `target: ambiguous —\n${formatCandidates(found.candidates)}`
        : "target: no agent pane found",
  )
  // Agents that run OUTSIDE tmux (tg-cli#306) — listed, not omitted, with the reason
  // and how to reach them; the silent-invisibility this replaces was the incident.
  const unreachable = listUnreachableAgents()
  if (unreachable.length > 0) {
    lines.push(`unreachable (not in tmux): ${unreachable.length}`)
    for (const a of unreachable) lines.push(`  - ${describeUnreachable(a, pendingInboxCount(ctx, unreachableKey(a)))}`)
    lines.push(`  ${UNREACHABLE_HINT}`)
  }
  const liveOmp = listLiveOmpAgents()
  if (liveOmp.length > 0) {
    lines.push(`omp (ACP): ${liveOmp.length}`)
    for (const a of liveOmp) lines.push(`  - ${describeLiveOmp(a)}`)
  }
  const offsetMtime = fileMtimeMs(ctx.paths.offset)
  lines.push(
    offsetMtime === null
      ? "offset: none"
      : `offset: ${readOffset(readFileOrNull(ctx.paths.offset))} ` +
          `(file age ${Math.round((Date.now() - offsetMtime) / 1000)}s)`,
  )
  // Guide the user when q→buttons isn't wired (the hook is what forwards an
  // agent's question to Telegram — without it the feature is silently dead).
  const hooksRaw = readFileOrNull(join(ctx.home, ".claude", "settings.json"))
  let questionHooksOk = false
  let harnessHooksOk = false
  let statusLineTelemetryOk = false
  let codexUsageTelemetryOk = false
  let shadowingStatusLine: string | null = null
  if (hooksRaw) {
    try {
      const hooksSettings = JSON.parse(hooksRaw)
      questionHooksOk = claudeHooksInstalled(hooksSettings, CLAUDE_QUESTION_HOOK_CMD)
      harnessHooksOk = harnessHooksInstalled(hooksSettings, CLAUDE_HARNESS_HOOK_CMD)
      statusLineTelemetryOk = claudeStatusLineTelemetryInstalled(hooksSettings, CLAUDE_STATUSLINE_TELEMETRY_CMD)
      if (statusLineTelemetryOk) {
        shadowingStatusLine = findShadowingClaudeStatusLine(ctx.home, statusScopeCwd, CLAUDE_STATUSLINE_TELEMETRY_CMD)
      }
    } catch {}
  }
  const codexHooksRaw = readFileOrNull(join(codexConfigDir(ctx.home), "hooks.json"))
  if (codexHooksRaw) {
    try {
      const codexHooksSettings = JSON.parse(codexHooksRaw)
      codexUsageTelemetryOk = codexUsageHookInstalled(codexHooksSettings, CODEX_USAGE_HOOK_CMD)
    } catch {}
  }
  lines.push(
    questionHooksOk
      ? "q→buttons hooks: installed (Claude Code)"
      : "q→buttons hooks: NOT installed — run `tg-ctl install-hooks`",
  )
  lines.push(
    harnessHooksOk
      ? "limit/error hooks: installed (Claude Code StopFailure)"
      : "limit/error hooks: NOT installed — run `tg-ctl install-hooks`",
  )
  lines.push(
    shadowingStatusLine
      ? `usage telemetry: shadowed by ${shadowingStatusLine} — run \`tg-ctl install-hooks\` from that scope or remove the override`
      : statusLineTelemetryOk
        ? "usage telemetry: installed (Claude Code statusLine)"
        : "usage telemetry: NOT installed — run `tg-ctl install-hooks`",
  )
  lines.push(
    codexUsageTelemetryOk
      ? "Codex usage telemetry: installed (Stop hook transcript collector)"
      : "Codex usage telemetry: NOT installed — run `tg-ctl install-hooks`, then trust it via Codex `/hooks`",
  )
  // Autostart (the shared service-management lifecycle): an installed unit means the daemon
  // comes back at login. Mirrors the q→buttons line — installed reports the kind/label, absent
  // gets a hint. On the no-op fallback (no launchd/systemd) there's no unit to find.
  //
  // Two mechanisms can autostart the daemon: tg-ctl's OWN `enable` unit (the file existence check),
  // OR an EXTERNAL launchd job that supervises this tg-ctl binary, wired outside tg-ctl (e.g. rig's
  // `ai.hyperide.tg-ctl` LaunchAgent). We check the own unit first (it carries the precise kind/label
  // and is cheap), then probe launchd for an external supervisor before declaring "NOT enabled" —
  // otherwise status lies while launchd keeps the daemon alive across reboots (tg-cli#88).
  const kind = autostartKind(env)
  lines.push(composeAutostartLine(env, kind))
  return lines.join("\n")
}

// The three Claude Code hook commands the daemon owns, as one unit. Shared by
// `install-hooks` and the startup self-heal so both target the identical wiring.
const CLAUDE_HOOK_COMMANDS = {
  question: CLAUDE_QUESTION_HOOK_CMD,
  harness: CLAUDE_HARNESS_HOOK_CMD,
  statusLine: CLAUDE_STATUSLINE_TELEMETRY_CMD,
}

// The resolved tg-cli config dir. SINGLE source of truth so the sentinel that
// `install-hooks` writes and the one the daemon self-heal reads resolve identically
// under the same environment (a `TG_CTL_CONFIG_DIR` set in only one of the two
// process contexts would still send them to different dirs — that is a launch-env
// mismatch, not a code divergence). Absolute so `enable` can pin it into the
// launchd/systemd unit.
function resolveConfigDir(home: string): string {
  return resolve(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"))
}

// Opt-in sentinel: `install-hooks` writes this so the daemon self-heal knows the
// user has ADOPTED the Claude hooks and it may restore them if a rewrite drops
// them. Its absence means "never opted in" → the daemon never first-time-installs
// hooks or rewrites a statusLine behind the user's back.
function claudeHooksSentinelPath(configDir: string): string {
  return join(configDir, "claude-hooks-installed")
}

// Startup self-heal: re-merge the Claude Code hooks into ~/.claude/settings.json
// when a rewrite dropped any of them — but ONLY for a user who previously ran
// `install-hooks` (the opt-in sentinel). The merge is purely ADDITIVE (reconcile
// appends missing hook groups and WRAPS any existing statusLine so the user's own
// display output is preserved) and CONVERGES after one write. Idempotent (writes
// only on an actual change) and fully best-effort — every failure is swallowed
// with a log line so the daemon always proceeds to its poll loop. Heals only the
// user-scope file; a shadowing project-scoped statusLine is left to the explicit
// `install-hooks`. The backup uses a self-heal-specific suffix + atomicWrite so an
// unattended heal can never clobber the manual `install-hooks` `.bak` nor truncate
// settings.json into garbage that would wedge the next start.
function ensureClaudeHooksOnStartup(ctx: Ctx): void {
  try {
    const claudeDir = join(ctx.home, ".claude")
    const paths = {
      settingsPath: join(claudeDir, "settings.json"),
      settingsDir: claudeDir,
      sentinelPath: claudeHooksSentinelPath(ctx.configDir),
    }
    const fs = {
      exists: existsSync,
      read: readFileOrNull,
      backup: (p: string, content: string) => {
        try {
          writeFileSync(p, content)
        } catch {}
      },
      writeAtomic: atomicWrite,
      ensureDir: (dir: string) => mkdirSync(dir, { recursive: true }),
    }
    const res = runClaudeHookSelfHeal(fs, paths, CLAUDE_HOOK_COMMANDS)
    if (res.outcome === "healed") {
      log("ensureClaudeHooksOnStartup: re-merged dropped Claude Code hooks into settings.json")
    }
  } catch (err) {
    log(`ensureClaudeHooksOnStartup failed: ${err}`)
  }
}

// Direct fallback writer: merges the Codex Stop usage-telemetry hook straight into
// ~/.codex/hooks.json (backing the file up first). Used when rig is absent, and as the
// telemetry-preservation safety net when rig is present but hasn't provisioned the hook itself
// yet — see installCodexUsageTelemetry below.
function installCodexUsageTelemetryDirect(codexHooksPath: string, codexRaw: string | null, codexExisting: Record<string, unknown>): void {
  const codexUsage = withCodexUsageHook(codexExisting, CODEX_USAGE_HOOK_CMD)
  if (codexUsage.changed) {
    if (codexRaw) {
      try {
        writeFileSync(`${codexHooksPath}.bak`, codexRaw)
      } catch {}
    }
    mkdirSync(dirname(codexHooksPath), { recursive: true })
    writeFileSync(codexHooksPath, `${JSON.stringify(codexUsage.settings, null, 2)}\n`)
    console.log(`tg-ctl: installed Codex Stop usage telemetry collector → ${codexHooksPath}` + (codexRaw ? ` (backup: ${codexHooksPath}.bak)` : ""))
  } else {
    console.log("tg-ctl: Codex Stop usage telemetry collector already installed — nothing to do.")
  }
}

// Rig-aware Codex hook provisioning (tg#8672). When rig is present it owns the codex hook
// bridge (writes ~/.codex/config.toml), so writing tg-ctl's own hook straight into
// ~/.codex/hooks.json makes codex warn about loading hooks from both files. Delegate to
// `rig apply` first; rig does NOT yet fold the usage-telemetry Stop hook into its bridge, so we
// always re-check afterwards and only skip the direct hooks.json write when the hook is actually
// found installed — telemetry must never be silently lost while rig catches up (see
// features/tg-ctl/rig-delegate.ts for the detection/delegation mechanics and the full caveat).
// Returns the exit code the caller should propagate: 0 on success (rig owns it, or telemetry
// written directly), or rig's non-zero exit when a PRESENT rig FAILS (never swallowed into a
// fallback — the shared contract is that fallback is for ABSENT rig only).
function installCodexUsageTelemetry(codexHooksPath: string, codexRaw: string | null, codexExisting: Record<string, unknown>): number {
  const rig = detectRig(process.env)
  if (!rig.present) {
    // rig absent (or its shared helper not installed) — the direct write is the fallback.
    installCodexUsageTelemetryDirect(codexHooksPath, codexRaw, codexExisting)
    return 0
  }
  // Scope the reconcile to `--only harness` — the codex hook bridge is provisioned under the
  // harness layer, so a bare `rig apply` (which would reconcile skills/CI/GitHub/tmux/… too) is
  // both too broad and surprising for an `install-hooks` command.
  const delegated = runRigDelegate(["apply", "--only", "harness"], process.env, process.cwd())
  if (!delegated.ran) {
    // rig binary present but the shared helper couldn't run (e.g. agent-tools not fully
    // deployed) — the delegation never happened, so honor the request via the direct write.
    console.log(`tg-ctl: rig detected (${rig.rigPath}) but the delegation helper could not run — writing the telemetry hook directly.`)
    installCodexUsageTelemetryDirect(codexHooksPath, codexRaw, codexExisting)
    return 0
  }
  if (delegated.exitCode === NO_RIG_EXIT) {
    // The shared helper reports rig ABSENT via its sentinel (agent-tools#282: 97, moved off 3 so
    // it can't be confused with rig's own EXIT_DRIFT=3). detectRig said present, but rig went
    // away between detect and delegate (uninstalled mid-flight) — this is the "rig absent" case,
    // NOT a rig failure, so honor the request with the direct write. Branch on the sentinel
    // EXACTLY: a real rig failure (1/2/3/…) must fall through to the propagate path below.
    // Checked BEFORE the "delegated … (exit N)" log so the absent path never claims provisioning
    // happened.
    console.log(`tg-ctl: rig reported absent (sentinel ${NO_RIG_EXIT}) at delegation time — writing the telemetry hook directly.`)
    installCodexUsageTelemetryDirect(codexHooksPath, codexRaw, codexExisting)
    return 0
  }
  console.log(`tg-ctl: rig detected (${rig.rigPath}) — delegated codex hook provisioning via \`rig apply --only harness\` (exit ${delegated.exitCode})`)
  if (delegated.exitCode !== 0) {
    // A PRESENT rig that FAILS is a real failure — surface it, do NOT fall back to a direct
    // write (that would recreate the dual-source we set out to remove). Propagate the exit code.
    if (delegated.stderr.trim()) {
      console.error(`tg-ctl: rig apply failed: ${delegated.stderr.trim().split("\n").slice(0, 3).join(" | ")}`)
    }
    console.error("tg-ctl: rig apply failed — not writing codex hooks directly. Fix rig and re-run `tg-ctl install-hooks`.")
    return delegated.exitCode ?? 1
  }
  // rig succeeded. Check the AUTHORITATIVE artifact rig actually writes (~/.codex/config.toml),
  // re-read from disk — NOT the pre-delegation snapshot — to see whether rig now provisions the
  // usage-telemetry Stop hook itself.
  const codexConfigToml = readFileOrNull(join(dirname(codexHooksPath), "config.toml"))
  if (codexConfigToml && codexConfigToml.includes(CODEX_USAGE_HOOK_CMD)) {
    console.log("tg-ctl: rig now provisions the codex usage-telemetry Stop hook (~/.codex/config.toml) — skipping the direct hooks.json write.")
    return 0
  }
  // rig does not fold in the telemetry hook yet — write it directly so telemetry is not lost.
  // Re-read hooks.json FRESH (rig apply may have touched ~/.codex) rather than reusing the stale
  // pre-delegation snapshot.
  const freshRaw = readFileOrNull(codexHooksPath)
  let freshExisting: Record<string, unknown> = {}
  if (freshRaw) {
    try {
      const parsed = JSON.parse(freshRaw)
      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) freshExisting = parsed as Record<string, unknown>
    } catch {
      console.error(`tg-ctl: ${codexHooksPath} is not valid JSON after rig apply — fix or move it aside, then re-run`)
      return 1
    }
  }
  console.log(
    "tg-ctl: rig does not yet provision the codex usage-telemetry Stop hook — writing it directly so telemetry is not lost " +
      "(may coexist with rig's ~/.codex/config.toml bridge until rig folds this hook in; tg#8672).",
  )
  installCodexUsageTelemetryDirect(codexHooksPath, freshRaw, freshExisting)
  return 0
}

// Idempotently install the q→buttons agent-question hooks into Claude Code's
// user settings (backing the file up first), then print guidance for the other
// harnesses. Pure JSON merge lives in features/tg-ctl/hook-install.ts.
function installHooks(home: string): number {
  const settingsPath = join(home, ".claude", "settings.json")
  const raw = readFileOrNull(settingsPath)
  let existing: Record<string, unknown> = {}
  if (raw) {
    let parsed: unknown
    try {
      parsed = JSON.parse(raw)
    } catch {
      console.error(`tg-ctl: ${settingsPath} is not valid JSON — fix or move it aside, then re-run`)
      process.exit(1)
    }
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
      console.error(`tg-ctl: ${settingsPath} is not a JSON object — fix or move it aside, then re-run`)
      process.exit(1)
    }
    existing = parsed as Record<string, unknown>
  }
  const codexHooksPath = join(codexConfigDir(home), "hooks.json")
  const codexRaw = readFileOrNull(codexHooksPath)
  let codexExisting: Record<string, unknown> = {}
  if (codexRaw) {
    let parsed: unknown
    try {
      parsed = JSON.parse(codexRaw)
    } catch {
      console.error(`tg-ctl: ${codexHooksPath} is not valid JSON — fix or move it aside, then re-run`)
      process.exit(1)
    }
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
      console.error(`tg-ctl: ${codexHooksPath} is not a JSON object — fix or move it aside, then re-run`)
      process.exit(1)
    }
    codexExisting = parsed as Record<string, unknown>
  }
  // Provision all three Claude channels in ONE pass (q→buttons, StopFailure
  // notifications, and proactive statusLine usage telemetry) — the same shared
  // engine the daemon startup self-heal uses, so both stay in lockstep.
  const { settings, changed } = reconcileClaudeHooks(existing, CLAUDE_HOOK_COMMANDS)
  if (changed) {
    if (raw) {
      try {
        writeFileSync(`${settingsPath}.bak`, raw)
      } catch {}
    }
    mkdirSync(join(home, ".claude"), { recursive: true })
    writeFileSync(settingsPath, `${JSON.stringify(settings, null, 2)}\n`)
    console.log(`tg-ctl: installed Claude Code q→buttons + StopFailure + statusLine usage telemetry → ${settingsPath}` + (raw ? ` (backup: ${settingsPath}.bak)` : ""))
  }
  let shadowChanged = false
  const shadowingStatusLine = findShadowingClaudeStatusLine(home, process.cwd(), CLAUDE_STATUSLINE_TELEMETRY_CMD)
  if (shadowingStatusLine) {
    const shadowRaw = readFileOrNull(shadowingStatusLine)
    const shadowSettings = readJsonObjectOrNull(shadowingStatusLine)
    if (shadowRaw && shadowSettings) {
      const shadowTelemetry = withClaudeStatusLineTelemetry(shadowSettings, CLAUDE_STATUSLINE_TELEMETRY_CMD)
      if (shadowTelemetry.changed) {
        try {
          writeFileSync(`${shadowingStatusLine}.bak`, shadowRaw)
        } catch {}
        mkdirSync(dirname(shadowingStatusLine), { recursive: true })
        writeFileSync(shadowingStatusLine, `${JSON.stringify(shadowTelemetry.settings, null, 2)}\n`)
        console.log(`tg-ctl: installed Claude statusLine usage telemetry → ${shadowingStatusLine} (backup: ${shadowingStatusLine}.bak)`)
        shadowChanged = true
      }
    }
  }
  if (!changed && !shadowChanged) {
    console.log("tg-ctl: Claude Code q→buttons + StopFailure + statusLine usage telemetry already installed — nothing to do.")
  }
  const codexExit = installCodexUsageTelemetry(codexHooksPath, codexRaw, codexExisting)
  console.log("")
  console.log("Codex: trust the `tg-ctl codex-usage-hook` Stop hook via /hooks so quota telemetry can flow; add a PermissionRequest hook running `tg-ctl ask --agent codex` if you also want q→buttons.")
  console.log("opencode: native — the bot subscribes to question/permission SSE events; no hook file needed.")
  console.log("Restart any running agent session so it loads the new hooks.")
  // Record opt-in so the daemon may RESTORE these hooks if a later settings.json
  // rewrite drops them (ensureClaudeHooksOnStartup). Best-effort — never fail the
  // install over the sentinel.
  try {
    const configDir = resolveConfigDir(home)
    mkdirSync(configDir, { recursive: true })
    writeFileSync(claudeHooksSentinelPath(configDir), `${new Date().toISOString()}\n`)
    console.log(
      `The daemon will restore these hooks if a settings.json rewrite drops them. ` +
        `To stop that, delete ${claudeHooksSentinelPath(configDir)}.`,
    )
  } catch {}
  return codexExit
}

// --- start: registration snapshot + detached daemon spawn, then exit ---

function startLauncher(ctx: Ctx, flags: StartFlags): void {
  mkdirSync(ctx.configDir, { recursive: true })
  // UPSERT this session's entry into the per-pane registration SET (tg-cli#67),
  // keyed by paneId — instead of OVERWRITING one global slot. A `tg` send from
  // any OTHER live session no longer clobbers this session's registration, so
  // every concurrently-registered session's questions keep forwarding. Written
  // synchronously EVEN IF the daemon already runs — a fresh `tg` call re-targets
  // a long-lived daemon at the current pane (its own entry only).
  const reg: Registration = { registeredAt: Math.floor(Date.now() / 1000) }
  if (flags.paneId) reg.paneId = flags.paneId
  if (flags.cwd) reg.cwd = flags.cwd
  if (flags.session) reg.sessionName = flags.session
  // Serialize the read-modify-write across concurrent `tg start`s (two sessions
  // racing the upsert would last-writer-wins-clobber each other's entry — the
  // very lost-update the routes lock was built for). Same O_EXCL lockfile +
  // PID-liveness break; onContended:'skip' loses only THIS start's bookkeeping,
  // never another session's entry. Best-effort: a write failure must never block
  // the daemon launch below, so the whole RMW is swallowed.
  try {
    withRoutesLock(
      fsRoutesLockIo(`${ctx.paths.registration}.lock`),
      () => {
        let raw: string | null
        try {
          raw = readFileSync(ctx.paths.registration, "utf8")
        } catch {
          raw = null
        }
        writeFileSync(
          ctx.paths.registration,
          serializeRegistrations(upsertRegistration(parseRegistrations(raw), reg)),
        )
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
  } catch {
    // best-effort registration bookkeeping — never block the daemon launch
  }

  // No lock, no pipes (see header). The daemon flocks first and exits 0 if
  // another instance holds the bot, so double-starts are a cheap no-op.
  const logFd = openSync(ctx.paths.log, "a")
  const runBin = resolveDeployedBin(ctx.home)
  const runCwd = dirname(runBin)
  // Pin cwd + PWD to the deployed bin dir so a caller's worktree can be removed
  // after `start` without leaving the long-lived daemon on a deleted cwd.
  const proc = Bun.spawn([process.execPath, runBin, "run"], {
    detached: true,
    stdio: ["ignore", logFd, logFd],
    cwd: runCwd,
    env: { ...process.env, PWD: runCwd, TG_CTL_CONFIG_DIR: ctx.configDir },
  })
  proc.unref()
  closeSync(logFd) // the child holds its own dup
  console.log(`tg-ctl: daemon launch requested (bot ${ctx.botId}) — log: ${ctx.paths.log}`)
  // Hint at autostart unless it's already installed, so a one-shot `start` doesn't silently die
  // at the next reboot (the shared service-management contract: start HINTS at enable). Skipped
  // on the no-op fallback OS, where there's nothing to enable.
  const env = autostartEnv(ctx)
  if (autostartKind(env) !== "none" && !autostartUnitInstalled(env)) {
    console.log("tg-ctl: not set to start at login — run `tg-ctl enable` to survive reboots.")
  }
}

// --- stop / status ---

function stopDaemon(ctx: Ctx): void {
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const alive = pidStatus(pid, kill0)
  if (alive === "absent") {
    console.log("tg-ctl: not running")
    return
  }
  if (alive === "stale") {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
    console.log(`tg-ctl: not running (cleaned stale pidfile, pid ${pid})`)
    return
  }
  try {
    process.kill(pid!, "SIGTERM")
  } catch (err) {
    console.error(`tg-ctl: SIGTERM failed for pid ${pid}: ${err}`)
    process.exit(1)
  }
  // Wait for the daemon to actually exit — up to the cooperative-drain ceiling
  // plus a margin, NOT a flat 2s. The SIGTERM drain can legitimately hold the
  // flock for up to GRACEFUL_SHUTDOWN_MS while it finishes the in-flight batch;
  // `restart` calls this then immediately startLauncher(), so returning early
  // (while the old daemon still owns the flock) makes the successor no-op-exit on
  // the contended flock and, once the old finally drains, leaves NOTHING running
  // (review: restart can leave no daemon). Poll until the pid is gone or the
  // ceiling elapses.
  const deadlineMs = GRACEFUL_SHUTDOWN_MS + 2000
  for (let waited = 0; waited < deadlineMs && kill0(pid!); waited += 100) Bun.sleepSync(100)
  const stillAlive = kill0(pid!)
  // Only unlink the pidfile when the process is truly gone. The daemon's own
  // cleanExit removes its pidfile (ownsPidFile-guarded); unlinking here while it
  // is STILL ALIVE would strip a live daemon's pidfile — `status` would then read
  // no pid and falsely report "not running" (tg#93 in reverse). Fall back to the
  // unlink only for a daemon that died without cleaning up.
  if (!stillAlive) {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
  }
  console.log(stillAlive ? `tg-ctl: SIGTERM sent (pid ${pid}, still exiting)` : `tg-ctl: stopped (pid ${pid})`)
}

// --- enable / disable: OS autostart self-registration (the agenttools_service contract) ---

// Exit code for an autostart enable/disable that failed to install/remove the OS unit (the OS
// control command returned nonzero, or the unit file could not be written/removed). Mirrors the
// agenttools_service contract's exit-code 4 for "autostart enable/disable failed", so a script
// can branch on "the service is up but autostart is NOT live".
const EXIT_AUTOSTART_FAILED = 4

// Resolve the path the autostart unit should launch. launchd/systemd run the agent with a
// minimal PATH, so argv MUST be absolute. The deployed binary is the ~/.files/bin/tg-ctl symlink
// on PATH; fall back to this script's own path when it isn't installed (e.g. a worktree run) so
// `enable` from a dev checkout still launches the right file.
function resolveDeployedBin(home: string): string {
  const deployed = join(home, ".files", "bin", "tg-ctl")
  return existsSync(deployed) ? deployed : import.meta.path
}

// True when `systemctl --user` is usable on this Linux host. Cheap probe, never throws. macOS
// never calls this (autostartKind short-circuits to launchd before hasSystemd is read).
function hasUserSystemd(): boolean {
  try {
    const r = Bun.spawnSync(["systemctl", "--user", "--version"], { stdout: "ignore", stderr: "ignore" })
    return r.exitCode === 0
  } catch {
    return false
  }
}

function autostartEnv(ctx: Ctx): AutostartEnv {
  return {
    platform: process.platform,
    home: ctx.home,
    binPath: resolveDeployedBin(ctx.home),
    bunPath: process.execPath,
    logPath: ctx.paths.log,
    // The resolved config dir, so a non-default `TG_CTL_CONFIG_DIR=/x tg-ctl enable` pins it into
    // the unit (the OS launches the daemon with a minimal env that wouldn't carry it otherwise).
    configDir: ctx.configDir,
    xdgConfigHome: process.env.XDG_CONFIG_HOME ?? "",
    hasSystemd: process.platform === "linux" ? hasUserSystemd() : false,
  }
}

// The OS unit label/name for an enable-path message. Narrows the type to the kinds that HAVE a unit
// (the "none" fallback installs none) so a fallback can't be mislabeled, and delegates the actual
// mapping to autostartKindLabel — single source of truth shared with the status line, so the two
// can't drift.
function autostartUnitLabel(kind: "launchd" | "systemd"): string {
  return autostartKindLabel(kind)
}

// Is the launchd/systemd unit file already on disk for tg-ctl? Cheap existence check (no plist/
// unit body rendered); on the no-op fallback (no unit file) this returns false.
function autostartUnitInstalled(env: AutostartEnv): boolean {
  const path = autostartUnitPath(env)
  return path !== undefined && existsSync(path)
}

// The impure launchd probe behind detectExternalLaunchdSupervisor, factored out so the detection
// flow can be unit-tested with a fake probe (no real launchctl). `listLabels` runs `launchctl list`;
// `printDump(label)` runs `launchctl print <domain>/<label>`. Each returns undefined on failure so
// the caller skips that job instead of crashing.
interface LaunchctlProbe {
  listLabels(): string[] | undefined
  listJobs(): Array<{ pid: number | null; label: string }> | undefined
  printDump(label: string): string | undefined
}

// The real probe: `launchctl list` for labels, `launchctl print <domain>/<label>` per label. A
// LaunchAgent lives in the per-user `gui/<uid>` domain; under root (uid 0) daemons live in `system`
// instead (`gui/0/<label>` just errors), so pick the domain by uid.
function realLaunchctlProbe(): LaunchctlProbe {
  const uid = process.getuid?.() ?? 0
  const domain = uid === 0 ? "system" : `gui/${uid}`
  const listStdout = (): string | undefined => {
    const r = Bun.spawnSync(["launchctl", "list"], { stdout: "pipe", stderr: "ignore" })
    if (r.exitCode !== 0 || !r.stdout) return undefined
    return new TextDecoder().decode(r.stdout)
  }
  return {
    listLabels() {
      const stdout = listStdout()
      return stdout === undefined ? undefined : parseLaunchctlListLabels(stdout)
    },
    listJobs() {
      const stdout = listStdout()
      return stdout === undefined ? undefined : parseLaunchctlListJobs(stdout)
    },
    printDump(label) {
      const r = Bun.spawnSync(["launchctl", "print", `${domain}/${label}`], { stdout: "pipe", stderr: "ignore" })
      if (r.exitCode !== 0 || !r.stdout) return undefined
      return new TextDecoder().decode(r.stdout)
    },
  }
}


// Probe launchd (macOS only) for an EXTERNAL job that supervises this tg-ctl binary — autostart wired
// outside `tg-ctl enable` (e.g. rig's `ai.hyperide.tg-ctl` LaunchAgent). Returns the supervising
// label, or undefined when none / not macOS / launchctl unavailable. Used by `status` to stop lying
// "NOT enabled" while launchd keeps the daemon alive across reboots (tg-cli#88). Read-only.
//
// Builds a ProbedLaunchdJob per loaded label (its argv + whether it's persistent per the `properties`
// line) from the probe, then hands selection to the PURE selectExternalLaunchdSupervisor (which
// excludes tg-ctl's OWN label, requires the `run` subcommand against THIS binary, and rejects a
// loaded-but-temporary job). `probe` is injectable for tests; defaults to the real launchctl probe.
// Fully wrapped so a launchctl hiccup, a non-macOS host, or a missing binary never crashes `status`.
function detectExternalLaunchdSupervisor(env: AutostartEnv, probe: LaunchctlProbe = realLaunchctlProbe()): string | undefined {
  if (env.platform !== "darwin") return undefined
  if (!env.binPath) return undefined
  try {
    const labels = probe.listLabels()
    if (!labels) return undefined
    const jobs: ProbedLaunchdJob[] = []
    for (const label of labels) {
      if (label === LAUNCHD_LABEL) continue
      const dump = probe.printDump(label)
      if (dump === undefined) continue
      jobs.push({ label, argv: parseLaunchctlPrintArgv(dump), persistent: launchdJobIsPersistent(dump) })
    }
    return selectExternalLaunchdSupervisor(jobs, env.binPath)
  } catch {
    return undefined
  }
}

// Probe launchd for the job that is running THIS bot's daemon right now (tg-cli#316). Unlike
// detectExternalLaunchdSupervisor this includes tg-ctl's own unit, requires a live pid, and matches
// the job's config dir so a test HOME is not reported as ours. Read-only.
//
// Launchd is a LABEL on an already-proven per-bot process (`hintPid` from the pidfile or flock
// holder). It must not invent "running" for a different bot token that shares the config dir
// (review finding). No hint → no launchd claim.
function detectLaunchdDaemon(
  env: AutostartEnv,
  hintPid: number | null,
  probe: LaunchctlProbe = realLaunchctlProbe(),
): { label: string; pid: number } | undefined {
  if (env.platform !== "darwin") return undefined
  if (!env.binPath) return undefined
  if (hintPid === null) return undefined
  try {
    const listed = probe.listJobs()
    if (!listed) return undefined
    const labels = listed.filter((j) => j.pid === hintPid).map((j) => j.label)
    if (labels.length === 0) return undefined
    const jobs: ProbedLaunchdJob[] = []
    for (const label of labels) {
      const dump = probe.printDump(label)
      if (dump === undefined) continue
      jobs.push({
        label,
        argv: parseLaunchctlPrintArgv(dump),
        persistent: launchdJobIsPersistent(dump),
        pid: parseLaunchctlPrintPid(dump),
        configDir: launchdJobConfigDir(parseLaunchctlPrintEnvironment(dump)),
      })
    }
    return selectLaunchdDaemonJob(jobs, env.binPath, env.configDir, defaultConfigDir(env.home))
  } catch {
    return undefined
  }
}


// Pid holding THIS config dir's flock, if any. The flock is the real singleton (spec §6); when
// the pidfile and even the unix socket are gone, the lock holder is still the live daemon.
// lsof -t names the holder. Do NOT skip process.pid: Telegram `/status` runs composeStatus
// inside the daemon, so the holder IS us — that is the pid to report (review finding).
function lockHolderPid(lockPath: string): number | null {
  try {
    const r = Bun.spawnSync(["lsof", "-t", lockPath], { stdout: "pipe", stderr: "ignore" })
    if (r.exitCode !== 0 || !r.stdout) return null
    for (const tok of new TextDecoder().decode(r.stdout).trim().split(/\s+/)) {
      const pid = Number(tok)
      if (pid > 0 && kill0(pid)) return pid
    }
    return null
  } catch {
    return null
  }
}



// The `autostart:` status line. Gathers the impure facts — own-unit file existence and (only when
// that's absent, to skip the launchctl probe otherwise) the external-launchd-supervisor probe — then
// hands them to the PURE autostartStatusLine for precedence + formatting (own-unit before external).
// Keeps composeStatus slim and isolates the one impure probe behind status logic.
function composeAutostartLine(env: AutostartEnv, kind: AutostartKind): string {
  const ownInstalled = kind !== "none" && autostartUnitInstalled(env)
  // Only probe launchd when the own unit is absent — autostartStatusLine prefers the own unit, so the
  // probe would be wasted work otherwise. The probe itself no-ops off launchd / on non-macOS.
  const external = !ownInstalled && kind === "launchd" ? detectExternalLaunchdSupervisor(env) : undefined
  return autostartStatusLine(kind, ownInstalled, external)
}

// Run one plan command. Returns true on success. An `optional` command that fails is treated as
// success (e.g. `launchctl unload` when nothing was loaded yet). stderr is surfaced on a hard
// failure so the user sees the launchctl/systemctl error.
function runAutostartCommand(cmd: AutostartCommand): boolean {
  try {
    const r = Bun.spawnSync(cmd.argv, { stdout: "ignore", stderr: "pipe" })
    if (r.exitCode === 0) return true
    if (cmd.optional) return true
    const stderr = r.stderr ? new TextDecoder().decode(r.stderr).trim() : ""
    console.error(`tg-ctl: ${cmd.describe} failed (${cmd.argv.join(" ")}): exit ${r.exitCode}${stderr ? ` — ${stderr}` : ""}`)
    return false
  } catch (err) {
    if (cmd.optional) return true
    console.error(`tg-ctl: ${cmd.describe} failed to spawn (${cmd.argv.join(" ")}): ${err}`)
    return false
  }
}

// `tg-ctl enable [--dry-run]` — install OS autostart AND start now. Mirrors the lib's
// ServiceManager.enable single-owner contract:
//   - launchd/systemd OWN the process (RunAtLoad / enable --now), so we stop any background
//     (pidfile) instance first to avoid two daemons fighting over the bot, then install the unit;
//     the activating command's exit code decides whether autostart is actually live.
//   - if the OS control command FAILS (sandbox / missing binary), OR there's no supported OS
//     autostart at all (the 'none' fallback), we fall back to a plain background `start` so the
//     service is still up now, and report that it will NOT survive reboot (enabled=false).
// Idempotent: re-running re-writes the same unit and reloads it. `--dry-run` prints the plan
// (unit path + launchctl/systemctl commands) and touches nothing — the e2e test uses it so it
// never loads a real LaunchAgent. Returns the process exit code.
function enableAutostart(ctx: Ctx, dryRun: boolean): number {
  const env = autostartEnv(ctx)
  const plan = buildEnablePlan(env)
  if (dryRun) {
    console.log(`tg-ctl: [dry-run] autostart kind: ${plan.kind}` + (plan.kind !== "none" ? `, ${autostartUnitLabel(plan.kind)}` : ""))
    if (plan.kind === "none") {
      console.log("tg-ctl: [dry-run] no supported OS autostart — would `tg-ctl start` now (no reboot survival)")
    }
    if (plan.file) console.log(`tg-ctl: [dry-run] would write ${plan.file.path}`)
    for (const cmd of plan.commands) console.log(`tg-ctl: [dry-run] would run: ${cmd.argv.join(" ")}`)
    return 0
  }

  // No supported OS autostart: just background-start now (the lib's NoopAutostartBackend path).
  if (plan.kind === "none") {
    startLauncher(ctx, {})
    console.error("tg-ctl: autostart is not supported on this OS — started now, but it will NOT survive reboot.")
    return 0
  }

  // The OS is about to launch its own copy. Stop any background (pidfile) instance first so we
  // don't end up with two processes on the same bot — the no-double-start invariant.
  stopDaemon(ctx)

  if (plan.file) {
    try {
      mkdirSync(dirname(plan.file.path), { recursive: true })
      writeFileSync(plan.file.path, plan.file.content, { mode: plan.file.mode })
    } catch (err) {
      console.error(`tg-ctl: writing ${plan.file.path} failed: ${err}`)
      return EXIT_AUTOSTART_FAILED
    }
  }
  // Run all commands; the LAST one is the activating one (`launchctl load` / `enable --now`)
  // whose success means autostart is live (mirrors the lib gating `enabled` on its exit code).
  let activated = true
  for (const cmd of plan.commands) {
    if (!runAutostartCommand(cmd)) activated = false
  }
  if (!activated) {
    // The unit file is on disk but the OS control command failed — autostart is NOT live. Fall
    // back to a background start so the service is at least up now, and report enabled=false.
    console.error(`tg-ctl: ${plan.kind} autostart command failed — falling back to a one-shot start (will NOT survive reboot).`)
    startLauncher(ctx, {})
    return EXIT_AUTOSTART_FAILED
  }
  // Past the kind === "none" early return, a launchd/systemd plan ALWAYS carries a file; narrow
  // explicitly so the success message doesn't lean on a non-null assertion.
  const where = plan.file ? ` at ${plan.file.path}` : ""
  console.log(
    `tg-ctl: autostart enabled — ${plan.kind} (${autostartUnitLabel(plan.kind)})${where}. ` +
      "The daemon starts at login and is running now.",
  )
  return 0
}

// `tg-ctl disable` — remove OS autostart AND stop the running daemon. Mirrors the lib's
// ServiceManager.disable: run the deactivating command (unload / disable --now) and only remove
// the unit file if it succeeded — a still-loaded unit's file is left in place rather than
// orphaning the live OS process. Then stop any background instance too. Idempotent: a missing
// unit is a no-op, not an error. Returns the process exit code (4 if the OS deactivate failed).
function disableAutostart(ctx: Ctx): number {
  const env = autostartEnv(ctx)
  const plan = buildDisablePlan(env)
  let removeFailed = false
  if (plan.filePath && existsSync(plan.filePath)) {
    // The first command is the deactivator (unload / disable --now); it gates file removal.
    const [deactivateCmd, ...postCmds] = plan.commands
    const ok = deactivateCmd ? runAutostartCommand(deactivateCmd) : true
    if (ok) {
      try {
        unlinkSync(plan.filePath)
      } catch (err) {
        console.error(`tg-ctl: removing ${plan.filePath} failed: ${err}`)
        removeFailed = true
      }
      for (const cmd of postCmds) runAutostartCommand(cmd)
    } else {
      // Deactivate failed — leave the file so `status` doesn't lie about the unit being gone.
      console.error(`tg-ctl: ${plan.kind} deactivate failed — leaving the unit file in place (the OS may still be running it).`)
      removeFailed = true
    }
  }
  // disable also stops the manager-spawned (background) instance. On launchd/systemd the unload/
  // disable above already stopped the OS-owned copy; this is the catch-all for a pidfile instance.
  stopDaemon(ctx)
  if (removeFailed) return EXIT_AUTOSTART_FAILED
  // On the 'none' fallback there was never an OS unit — say what actually happened (stopped the
  // background instance) rather than the misleading "autostart disabled (none)".
  console.log(
    plan.kind === "none"
      ? "tg-ctl: no OS autostart to remove — stopped the background instance."
      : `tg-ctl: autostart disabled (${plan.kind}).`,
  )
  return 0
}

// --- /spend scheduled push (end-of-week / end-of-month) ---

function usageScheduleWatermarkPath(ctx: Ctx): string {
  return ctlPaths(ctx.configDir, botIdFromToken(ctx.token) || "unknown").usageSchedule
}

function usageScheduleEnv(ctx: Ctx): UsageScheduleEnv {
  return {
    home: ctx.home,
    binPath: resolveDeployedBin(ctx.home),
    bunPath: process.execPath,
    logPath: ctx.paths.log,
    configDir: ctx.configDir,
    // Captured from the enabling shell — launchd's own PATH won't include wherever
    // `tg`/`rig` live (see usageScheduleUnitEnv's comment in usage-schedule.ts).
    pathEnv: process.env.PATH ?? '',
  }
}

// `tg-ctl usage-schedule enable [--dry-run]` — install the launchd job that fires
// `usage-schedule-check` daily at 23:50; `--dry-run` prints the plan and touches nothing
// (mirrors enableAutostart's own --dry-run contract). launchd (macOS) only — see
// usage-schedule.ts's SCOPE note.
// Seeded ONLY on a truly first enable (no watermark file yet) so the FIRST scheduled check
// never claims a period was "missed while the machine was asleep" — nothing was scheduled
// yet, so nothing could have been missed. `enable` is also a supported RE-run (retry a
// half-failed load, re-pin PATH after moving `tg`/`rig`) — an unconditional reseed there
// would silently overwrite a real pending/failed period with "already reported" and swallow
// it with neither a report nor a missed notice (review finding, converged on by two
// independent reviewers). An existing watermark — even an all-null one written by a prior
// enable — is therefore left untouched; only a genuinely absent file gets seeded.
function seedUsageScheduleWatermark(watermarkPath: string, now: Date): void {
  if (!shouldSeedUsageScheduleWatermark(readFileOrNull(watermarkPath))) return
  const seed = seedUsageScheduleWatermarkFor(now)
  try {
    atomicWrite(watermarkPath, `${JSON.stringify(seed)}\n`)
  } catch (err) {
    console.error(`tg-ctl: usage-schedule: seeding the watermark failed (a false "missed" notice may fire once): ${err}`)
  }
}

function enableUsageSchedule(ctx: Ctx, dryRun: boolean): number {
  if (process.platform !== "darwin") {
    console.error("tg-ctl: usage-schedule is only implemented for launchd (macOS) — not supported on this OS.")
    return EXIT_AUTOSTART_FAILED
  }
  const env = usageScheduleEnv(ctx)
  const plan = buildUsageScheduleEnablePlan(env)
  if (dryRun) {
    console.log(`tg-ctl: [dry-run] usage-schedule label: ${USAGE_SCHEDULE_LAUNCHD_LABEL}`)
    console.log(`tg-ctl: [dry-run] would write ${plan.file.path}`)
    for (const cmd of plan.commands) console.log(`tg-ctl: [dry-run] would run: ${cmd.argv.join(" ")}`)
    return 0
  }
  try {
    mkdirSync(dirname(plan.file.path), { recursive: true })
    writeFileSync(plan.file.path, plan.file.content, { mode: plan.file.mode })
  } catch (err) {
    console.error(`tg-ctl: writing ${plan.file.path} failed: ${err}`)
    return EXIT_AUTOSTART_FAILED
  }
  seedUsageScheduleWatermark(usageScheduleWatermarkPath(ctx), new Date())
  let activated = true
  for (const cmd of plan.commands) {
    if (!runAutostartCommand(cmd)) activated = false
  }
  if (!activated) {
    console.error("tg-ctl: usage-schedule launchctl command failed — the unit file is on disk but not loaded.")
    return EXIT_AUTOSTART_FAILED
  }
  console.log(`tg-ctl: usage-schedule enabled — ${USAGE_SCHEDULE_LAUNCHD_LABEL} at ${plan.file.path}. Checks daily at 23:50, sends one report per completed week and month (a day missed while asleep is reported as missed, not skipped).`)
  return 0
}

function disableUsageSchedule(ctx: Ctx): number {
  if (process.platform !== "darwin") {
    console.log("tg-ctl: usage-schedule was never installed on this OS — nothing to remove.")
    return 0
  }
  const plan = buildUsageScheduleDisablePlan(ctx.home)
  // The watermark is cleared on EVERY disable call that reaches this function — including
  // the "already gone" early-return paths below — not just the branch that actually
  // unloads/removes a plist. A re-disable after a partial failure, or a disable after the
  // plist was already removed by hand, is still an intentional "stop watching" the user
  // asked for; leaving the watermark behind in either case would make a LATER re-enable
  // (which only reseeds an ABSENT file, see shouldSeedUsageScheduleWatermark) see it as
  // present and skip reseeding, then fire a false "machine was asleep" notice for the whole
  // disabled window — the exact bug an earlier fix (review MEDIUM finding) closed for the
  // plist-present path but left open here (review HIGH finding: the early returns below
  // used to skip this cleanup entirely).
  const clearWatermark = () =>
    unlinkGuarded(usageScheduleWatermarkPath(ctx), "tg-ctl: usage-schedule: removing the watermark failed (harmless — a stale one only delays the next reseed)")
  if (!existsSync(plan.filePath)) {
    clearWatermark()
    console.log("tg-ctl: usage-schedule is not installed — nothing to remove.")
    return 0
  }
  const ok = runAutostartCommand(plan.commands[0])
  if (!ok) {
    console.error("tg-ctl: usage-schedule deactivate failed — leaving the unit file in place.")
    return EXIT_AUTOSTART_FAILED
  }
  try {
    unlinkSync(plan.filePath)
  } catch (err) {
    console.error(`tg-ctl: removing ${plan.filePath} failed: ${err}`)
    return EXIT_AUTOSTART_FAILED
  }
  clearWatermark()
  console.log("tg-ctl: usage-schedule disabled.")
  return 0
}

function writeUsageScheduleWatermark(path: string, watermark: UsageScheduleWatermark): void {
  atomicWrite(path, `${JSON.stringify(watermark)}\n`)
}

// Send one scheduled report through the `tg` CLI. The report body is plain text built
// from `rig usage --json` data (model names, the disclaimer) but `--format html` parses
// it as HTML — `rig usage` really does emit a "<synthetic>" model name, and Telegram
// rejects an unescaped stray "<" — so the body is escaped right here, at the HTML
// boundary (the interactive /spend reply goes out as plain text and must NOT be escaped).
// No splitting here: the `tg` CLI's own transmitter 4096-splits a non-rich HTML body
// (features/auto-attach/transmitter.ts), unlike the daemon's direct Bot API sends.
async function sendScheduledUsageReport(title: string, body: string): Promise<boolean> {
  const r = await spawnGuarded(["tg", "--format", "html", "--tag", "report", "--title", title, escapeHtml(body)], 30_000)
  if (r.exitCode === 0) return true
  console.error(`tg-ctl: usage-schedule: sending "${title}" failed (exit ${r.exitCode}): ${r.stderr.trim() || "no error output"}`)
  return false
}

// What the scheduled check sends for one due period: the real report when the check runs
// ON the boundary day (`rig usage --period X` covers exactly the completing period), an
// explicit missed-report notice when it runs late (rig can only report the CURRENT
// period — see usage-schedule.ts's LIMIT note), or nothing (`null`, period stays due)
// when rig itself failed: an error blurb delivered "successfully" must never advance the
// watermark, or a transient rig failure on the boundary day consumes the period for good.
async function scheduledUsageBody(due: UsageScheduleDuePeriod): Promise<string | null> {
  if (!due.onTime) return missedUsageReportNotice(due)
  const report = await composeUsageReport(due.period)
  if (report.ok) return due.hasGap ? `${report.text}\n\n${usageScheduleGapNote(due.period)}` : report.text
  console.error(`tg-ctl: usage-schedule: "${due.title}" (period ${due.id}) not generated, left due for the next check: ${report.text}`)
  return null
}

// The job the installed launchd unit actually invokes once a day. A no-op unless a
// week/month report is DUE per the persisted watermark (usage-schedule.ts's
// usageSchedulePeriodsDue; both can be due the same day — both are handled). A period
// whose compose or send fails stays due, so the next daily check retries it instead of
// silently losing it. Dry-run (TG_USAGE_SCHEDULE_DRY_RUN=1 in the PROCESS env — not the
// merged .env, so a line left in the config file can't turn the schedule into a permanent
// no-op — or --dry-run) logs what WOULD be sent and never advances the watermark, so a
// manual smoke check neither pushes a message nor masks a pending real report.
async function runUsageScheduleCheck(now: Date, dryRun: boolean, watermarkPath: string): Promise<number> {
  const watermark = parseUsageScheduleWatermark(readFileOrNull(watermarkPath))
  const due = usageSchedulePeriodsDue(now, watermark)
  if (due.length === 0) return 0
  let next = watermark
  for (const item of due) {
    const body = await scheduledUsageBody(item)
    if (body === null) continue
    if (dryRun) {
      console.log(`tg-ctl: [dry-run] would send "${item.title}" (period ${item.id}${item.onTime ? "" : ", LATE"}): ${body.slice(0, 200)}${body.length > 200 ? "…" : ""}`)
      continue
    }
    if (!(await sendScheduledUsageReport(item.title, body))) continue
    next = item.period === "week" ? { ...next, lastWeekReported: item.id } : { ...next, lastMonthReported: item.id }
    // Persisted right after EACH successful send (not once after the whole loop) — a crash
    // between send and write would otherwise leave a delivered report looking "NOT
    // generated" to the next check (review LOW finding).
    try {
      writeUsageScheduleWatermark(watermarkPath, next)
    } catch (err) {
      console.error(`tg-ctl: usage-schedule: sent "${item.title}" but FAILED to persist the watermark — it may be reported as missed again tomorrow: ${err}`)
    }
  }
  return 0
}

// --- hook/client handoff over a local Unix socket ---

const MAX_HOOK_REQUEST_BYTES = 64 * 1024

// How long an UNSCOPED forwarded question (paneId undefined — the hook ran
// without TMUX_PANE) may stay open before it self-clears to "expired — answer in
// terminal". This bound exists ONLY for the unscoped case, because an unscoped
// question defers inbound for ALL panes (paneHasPendingQuestion's fail-closed
// `if (!pb.req.paneId) return true`); without the bound it would wedge every
// pane's routing forever. A SCOPED question gets NO timer and waits indefinitely
// for its Telegram answer or socket close — that is safe (the timer is armed only
// for the `!req.paneId` branch in handleHookSocketLine). Overridable via env only
// so the integration tests can exercise the expiry without a real 110s wait;
// production never sets it.
const UNSCOPED_ABANDON_MS = (() => {
  const raw = Number(process.env.TG_CTL_UNSCOPED_TIMEOUT_MS)
  // setTimeout clamps any delay > 2^31-1 ms to ~1ms in Node/Bun, which would
  // flip a huge "wait longer" override into "expire instantly" — the opposite of
  // intent. Clamp to TIMEOUT_MAX so an oversized value still means "a long wait".
  // A non-positive / non-numeric / absent value (incl. 0) falls back to the 110s
  // default — 0 is NOT "expire instantly" (the bound is a backstop, never zero).
  const TIMEOUT_MAX = 2_147_483_647
  return Number.isFinite(raw) && raw > 0 ? Math.min(raw, TIMEOUT_MAX) : 110_000
})()

interface PendingButton {
  req: ButtonRequest
  socket: Socket
  messageId: number | null
  // ms epoch when this entry was created (or revived). Persisted so a restored
  // entry carries its true age into the retention window, and so the durable file
  // can be ordered/pruned by recency.
  at: number
  // Only a SCOPED-less (unscoped) question arms an abandon timer; a scoped
  // question waits forever, so its timer is undefined. clearTimeout(undefined)
  // is a safe no-op, so every clearTimeout(entry.timer) call site is correct
  // whether or not the timer was armed.
  timer?: ReturnType<typeof setTimeout>
  finalText?: string
  finalReplyMarkup?: ButtonMessagePayload["reply_markup"]
  // tg-cli#403: critical-mode reminder scheduling state (undefined unless
  // req.critical === true). Lives here rather than a parallel store because a
  // critical entry spends most of its life in EXACTLY this map — its
  // underlying process/socket is still connected, simply awaiting a decision
  // (see forwardAndPostQuestion's skip of the raw UNSCOPED_ABANDON_MS timer
  // for a critical request). Carried over into AbandonedButton.criticalState
  // if it later transitions there (retainAbandonedQuestion).
  criticalState?: DaemonCriticalState
}

// A SCOPED question whose hook socket has CLOSED — the agent's 120s hook budget
// elapsed (it fell back to the terminal AskUserQuestion prompt) OR the daemon
// restarted and restored it from disk. Its answer can STILL reach the pane it asked
// from, so we retain {paneId, options, card id} keyed by callbackRequestId. A LATER
// Telegram tap injects the chosen option into that pane (late-delivery), and a
// reconnecting hook with the SAME requestId re-attaches to this card instead of
// posting a duplicate (lossless restart). Unlike a PendingButton it holds NO live
// socket and — crucially — is NOT in `pendingButtons`, so it never defers the pane's
// inbound (the agent moved on / is blocked on its own reconnect).
interface AbandonedButton {
  req: ButtonRequest
  messageId: number | null
  at: number
  // A PERMISSION decision the user already tapped while the hook was disconnected
  // (queued because, unlike a question, a permission has no pane-text-injection
  // fallback — the hook needs a structured JSON reply, not terminal text). Never
  // silently dropped: this is delivered down the socket the instant a reconnecting
  // hook re-attaches to the same requestId AND its payload still matches
  // (permissionPayloadMatches — the RECONNECT re-attach branch in
  // handleHookSocketLine). PERSISTED: `persistQuestions` writes it and the restore
  // path re-reads it (see question-store.ts's RetainedQuestionRecord.queuedDecision),
  // and it is persisted IMMEDIATELY on tap (not only on the next unrelated
  // mutation) — a daemon crash between the tap and the reconnect must not lose the
  // human's decision while the card still claims it is "delivered automatically"
  // (PERM QUEUE RESTART proves this). The card stays visibly "queued" until actually
  // delivered so a re-tap (last tap wins) or a terminal answer both stay available.
  // `decision` is REQUIRED — see question-store.ts's matching RetainedQuestionRecord
  // field for why (review finding: the two types must agree).
  // `notifiedAt`: when the ONE-TIME "still waiting to reconnect" notice
  // (noticeStaleQueuedDecisions, QUEUED_DECISION_NOTICE_MS) fired for this queued
  // tap — undefined until it does. Persisted so a daemon restart doesn't re-fire
  // the notice for an entry that already got one (would read as spam / a false
  // "still no connection" repeat right after a bounce).
  queuedDecision?: { value: string; label: string; decision: PermissionDecision; at: number; notifiedAt?: number }
  // tg-cli#403: see PendingButton.criticalState's doc comment — the same
  // field, carried over by retainAbandonedQuestion when a critical entry's
  // socket closes before a decision lands, and restored from disk (see
  // question-store.ts's matching RetainedQuestionRecord.criticalState).
  criticalState?: DaemonCriticalState
}

// Shared by permissionRequestIdForMessage's two lookups (PendingButton and
// AbandonedButton have compatible {req, messageId} shapes) — a single copy of
// the "is this the one decidable permission card at this message_id" predicate
// instead of two independently-written loops that could silently drift apart
// if the definition of "decidable" ever changes (review finding).
function findDecidablePermissionRequestId(
  entries: Iterable<[string, { req: ButtonRequest; messageId: number | null }]>,
  messageId: number,
): string | null {
  for (const [requestId, entry] of entries) {
    if (entry.messageId === messageId && entry.req.kind === "permission" && !entry.req.multiQuestion) return requestId
  }
  return null
}

// A question that has already been ANSWERED, kept briefly so a re-forward of the
// SAME requestId (a stable hash of session + question text) replays the stored
// answer instead of posting a fresh card. The in-flight dedup (`activeButtonKeys`)
// is released the instant a question is answered, so without this an
// AskUserQuestion that re-fires AFTER its answer would post a second, superseded
// card whose tap reads as "expired" (tg-cli#97). Keyed by `callbackRequestId`.
interface AnsweredButton {
  value: string
  label: string
  decision?: PermissionDecision
  at: number
  // How the answer reached the agent: `socket` (down the hook socket → a re-fire
  // REPLAYS it, #98) or `pane` (late-delivered by pane injection → a reconnecting
  // hook must NOT also replay it, or the agent gets it twice). Defaults to socket.
  delivery: "socket" | "pane"
}

// How long an answered request stays replayable. The re-fire that motivated this
// arrived ~37s after the answer; 5 min is a generous bound that still lets a
// genuinely NEW question reusing the same hash (the human re-asks much later) post
// a fresh card rather than silently replaying a stale answer. Overridable via env
// only so the integration tests can exercise the past-window expiry without a real
// 5-minute wait; production never sets it. Unlike UNSCOPED_ABANDON_MS this is only
// ever compared against (now - answeredAt), never used as a setTimeout delay, so no
// overflow clamp is needed. A non-positive / non-numeric / absent value falls back
// to the 5-minute default.
const ANSWERED_REPLAY_MS = (() => {
  const raw = Number(process.env.TG_CTL_ANSWERED_REPLAY_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 5 * 60_000
})()

// Drop answered entries past the replay window. Called whenever a NEW answer is
// recorded, so the cache stays bounded to ~the questions answered in the last
// window instead of growing for the daemon's whole lifetime (most requestIds are
// unique and never re-forwarded, so access-time pruning alone would leak).
function pruneAnsweredButtons(answered: Map<string, AnsweredButton>, now: number): void {
  for (const [key, entry] of answered) {
    if (now - entry.at > ANSWERED_REPLAY_MS) answered.delete(key)
  }
}

// How long a socket-closed (abandoned) scoped question stays retained for
// late-delivery + reconnect. Longer than the 5-min answered window: the human may
// tap the card minutes after the hook budget elapsed and the agent fell back to the
// terminal, and that answer is still worth delivering to the still-running agent.
// Env-overridable so the integration tests exercise the past-window prune without a
// real 30-min wait; production never sets it.
const ABANDONED_RETAIN_MS = (() => {
  const raw = Number(process.env.TG_CTL_ABANDONED_RETAIN_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 30 * 60_000
})()

// PERMISSIONS get a MUCH longer retention window than questions before the
// daemon gives up and posts abandonedLongOutageText's "never delivered" notice
// (tg-cli#182: Alex reported a permission going stale — and the card claiming
// it was "never delivered" — well before he'd had a realistic chance to check
// his phone, e.g. overnight or a few hours away). A question always has a live
// human decision to make in the moment (its own value fades fast if stale), but
// a permission's answer is still fully actionable hours later: the harness may
// still be sitting on its own terminal fallback prompt (late-delivery via
// pane-digit-injection, tg-cli#267) or a hook may still reconnect and consume a
// queued decision (queuedDecision, above) — neither is time-bounded by anything
// on the harness side, so tg-ctl's own give-up window was the only thing
// artificially cutting this short. Env-overridable for tests; production never
// sets it.
const ABANDONED_PERMISSION_RETAIN_MS = (() => {
  const raw = Number(process.env.TG_CTL_ABANDONED_PERMISSION_RETAIN_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 12 * 60 * 60_000
})()

// Grant protocol v1.1 windows (tg-cli#398): how long an EXPIRED hatch ask stays
// addressable for a late Approve tap (grace), and how long a minted grant stays
// consumable (grant TTL). Both default 24h; env-overridable so integration
// tests can expire a grant/grace without a real 24h wait — production never
// sets them. (Same override style as TG_CTL_UNSCOPED_TIMEOUT_MS.)
const GRACE_WINDOW_MS = (() => {
  const raw = Number(process.env.TG_CTL_GRACE_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 24 * 60 * 60_000
})()
const GRANT_TTL_MS = (() => {
  const raw = Number(process.env.TG_CTL_GRANT_TTL_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 24 * 60 * 60_000
})()

// PURE — the single source of truth for "which retention window applies to
// this entry's kind" (review finding, round 5: this ternary was duplicated
// verbatim at 5+ call sites, risking future drift) and "is it past that
// window right now". EXPORTED for direct unit testing (review finding, round
// 6: forcing the exact race between "expired" and "the periodic sweep
// already caught it" isn't reliable from outside a real running daemon
// process — see tests/ctl-question-durable-integration.test.ts's own comment
// on 'PERM QUEUE EXPIRED AT RECONNECT' — so the boolean logic itself is
// tested directly here instead, deterministically, with no timing race).
// Scalar args, not an entry object (review finding: avoids a throwaway
// wrapper allocation at every restore-loop call site).
// `critical` (tg-cli#403, optional — every pre-existing call/test passes only
// `kind`, unaffected): a critical request's decision must remain deliverable no
// matter how long the human takes, the entire reason critical mode exists —
// bypasses the kind-based window ENTIRELY (Infinity, never a real setTimeout
// delay — this is only ever compared via subtraction, like every other use of
// this function) rather than merely lengthening it. Without this, a critical
// hatch request whose process disconnected would still silently expire (and
// discard a genuinely late human tap) once ABANDONED_PERMISSION_RETAIN_MS
// (12h) elapsed, directly contradicting "wait indefinitely" (review finding).
export function retainMsFor(kind: ButtonRequest["kind"], critical?: boolean): number {
  if (critical === true) return Infinity
  return kind === "permission" ? ABANDONED_PERMISSION_RETAIN_MS : ABANDONED_RETAIN_MS
}
export function isAbandonedExpired(kind: ButtonRequest["kind"], at: number, now: number, critical?: boolean): boolean {
  return now - at > retainMsFor(kind, critical)
}

// PURE decision for what a hook reconnect should do about a retained entry's
// QUEUED permission decision — extracted from handleHookSocketLine (review
// finding, tg-cli#182 round 8: five straight rounds asked for deterministic
// coverage of this exact branch, since exercising it through a REAL daemon
// racing a REAL sweep is not reliably forceable — see this module's unit
// tests for `decideQueuedPermissionReconnect`, which call it directly with
// no daemon, no timing race, no sweep to race against). Order matters and
// mirrors the ORIGINAL single if/else-if chain exactly (round 7's fix): a
// second, independent if-chain re-evaluating overlapping conditions is
// EXACTLY what produced round 7's bug (an expired decision ALSO logging a
// false "payload mismatch") — one function, one return value, one caller
// switch, structurally impossible to double-fire.
export type QueuedPermissionReconnectOutcome =
  | { kind: "no-queued-decision" }
  | { kind: "expired" }
  | { kind: "no-turn-proof" }
  | { kind: "turn-mismatch" }
  | { kind: "payload-mismatch" }
  | { kind: "deliver"; queuedDecision: NonNullable<AbandonedButton["queuedDecision"]> }
export function decideQueuedPermissionReconnect(
  retained: Pick<AbandonedButton, "req" | "at" | "queuedDecision">,
  req: ButtonRequest,
  now: number,
): QueuedPermissionReconnectOutcome {
  if (!retained.queuedDecision) return { kind: "no-queued-decision" }
  if (isAbandonedExpired(retained.req.kind, retained.at, now, retained.req.critical)) return { kind: "expired" }
  if (!queuedDecisionCanAutoDeliver(retained.req)) return { kind: "no-turn-proof" }
  if (retained.req.promptTurnId !== req.promptTurnId) return { kind: "turn-mismatch" }
  if (!permissionPayloadMatches(retained.req, req)) return { kind: "payload-mismatch" }
  return { kind: "deliver", queuedDecision: retained.queuedDecision }
}

// REMOVED (tg-cli#398, grant protocol v1.1): findQueuedHatchDecision and the
// handleHookSocketLine hatch short-circuit it fed. That mechanism authorized
// ANY later operation behind the same hookId — exactly the over-broad silent
// approval v1.1 forbids. A late Approve now mints a single-use,
// operation-bound grant (grants.ts) and a plain retry WITHOUT a grant simply
// posts a FRESH card (or consumes an outstanding grant via --verify-grant
// --pull, route-bound).

// How long a QUEUED permission decision can wait with no reconnect before the
// human gets a PROACTIVE "still waiting to reconnect" notice — a NOTICE
// threshold, not an expiry (Alex tg#9982: a queued tap must never be silently
// dropped/demoted on the SHORT question timer; while it's pending it stays
// pending in Telegram until there's 100% confirmation it's resolved, or the
// daemon genuinely gives up after the full ABANDONED_PERMISSION_RETAIN_MS
// (tg-cli#182, default 12h — NOT the bare ABANDONED_RETAIN_MS question
// window) with its own proactive notice). Past this NOTICE threshold the
// queue is NOT cleared and stays fully eligible for automatic delivery — see
// noticeStaleQueuedDecisions and decideQueuedPermissionReconnect, neither of
// which is bounded by THIS threshold (they ARE bounded by the longer
// retention window above — see isAbandonedExpired).
//
// The identity check that makes delivery safe WITHIN that window lives
// upstream, in hook-normalize.ts's `invocationSeed`: requestId is now scoped to the prompt
// TURN (Claude Code's `prompt_id`, Codex's `turn_id`), not just the session, so
// a materially later, only-coincidentally-identical-looking request (the agent
// re-running the same command in a NEW turn) gets a fresh requestId and can
// never satisfy the reconnect branch's exact-requestId gate in the first
// place — permissionPayloadMatches (full toolInput/agent/pane/event/question
// equality) is defense-in-depth on top of that for the residual, much narrower
// risk of a lossy `summarizeInput` digest collision, not a time bound.
// Env-overridable for tests; production never sets it.
const QUEUED_DECISION_NOTICE_MS = (() => {
  const raw = Number(process.env.TG_CTL_QUEUED_DECISION_NOTICE_MS)
  return Number.isFinite(raw) && raw > 0 ? raw : 10 * 60_000
})()

// Drop abandoned entries past the retention window. Called before every persist so
// the durable file (and the in-memory map) stay bounded to the recent window. The
// optional `onExpire` fires for each entry AT THE MOMENT it is dropped — this is
// the daemon giving up on ever reconnecting it, so it is also the one honest place
// to surface the "still no connection after a long wait" notice (Alex tg
// requirement: a long-running uncertainty must eventually be reported, never left
// silent). Called with the entry BEFORE it is deleted from the map. Permissions use
// ABANDONED_PERMISSION_RETAIN_MS instead of ABANDONED_RETAIN_MS (see its own
// comment, tg-cli#182) — everything else about giving up is unchanged.
function pruneAbandonedButtons(
  abandoned: Map<string, AbandonedButton>,
  now: number,
  onExpire?: (key: string, entry: AbandonedButton) => void,
): void {
  for (const [key, entry] of abandoned) {
    if (isAbandonedExpired(entry.req.kind, entry.at, now, entry.req.critical)) {
      onExpire?.(key, entry)
      abandoned.delete(key)
    }
  }
}

// Exported for tests (same pattern as retainMsFor/isAbandonedExpired above):
// the AUTHORITATIVE socket/disk validator is the boundary the grant protocol's
// additive fields (tg-cli#398) must survive, so tests/ctl-grants.test.ts pins
// its tolerance contract directly instead of through a daemon round-trip.
export function normalizeButtonRequest(value: unknown): ButtonRequest | null {
  if (!value || typeof value !== "object") return null
  const rec = value as Record<string, unknown>
  const requestId = typeof rec.requestId === "string" && rec.requestId ? rec.requestId : null
  const agent = typeof rec.agent === "string" ? rec.agent : null
  const kind = rec.kind === "question" || rec.kind === "permission" ? rec.kind : null
  const question = typeof rec.question === "string" && rec.question ? rec.question : null
  if (!requestId || !agent || !kind || !question) return null
  const options = Array.isArray(rec.options)
    ? rec.options
        .filter((o): o is Record<string, unknown> => Boolean(o) && typeof o === "object")
        .map((o) => {
          const label = typeof o.label === "string" ? o.label : ""
          const description = typeof o.description === "string" ? o.description : undefined
          return label ? (description ? { label, description } : { label }) : null
        })
        .filter((o): o is { label: string; description?: string } => o !== null)
    : undefined

  // Custom allow/deny button wording (plan-approval → Proceed/Keep planning).
  // Both labels must be present + non-empty strings, else fall back to the
  // default Approve/Reject by leaving it undefined.
  const dl = rec.decisionLabels
  const decisionLabels =
    dl && typeof dl === "object" &&
    typeof (dl as Record<string, unknown>).allow === "string" && (dl as Record<string, unknown>).allow &&
    typeof (dl as Record<string, unknown>).deny === "string" && (dl as Record<string, unknown>).deny
      ? { allow: (dl as Record<string, string>).allow, deny: (dl as Record<string, string>).deny }
      : undefined
  // Which Claude hook event fired — decides the reply shape (PreToolUse →
  // permissionDecision; PermissionRequest → decision.behavior). Default
  // PermissionRequest preserves the pre-existing reply for older payloads.
  const permissionEvent = rec.permissionEvent === "PreToolUse" ? "PreToolUse" : undefined
  // The original tool_input MUST survive the socket boundary: a PreToolUse
  // ALLOW (ExitPlanMode Proceed, claude question) echoes it as `updatedInput`,
  // and the live hooks docs say "allow alone is not sufficient" for the
  // user-interactive tools — dropping it here silently downgraded the reply to
  // a bare allow (tg#5741 review finding).
  const toolInput =
    rec.toolInput && typeof rec.toolInput === "object" && !Array.isArray(rec.toolInput)
      ? (rec.toolInput as Record<string, unknown>)
      : undefined

  return {
    requestId,
    buttonId: typeof rec.buttonId === "string" ? rec.buttonId : undefined,
    paneId: typeof rec.paneId === "string" ? rec.paneId : undefined,
    cwd: typeof rec.cwd === "string" ? rec.cwd : undefined,
    sessionName: typeof rec.sessionName === "string" ? rec.sessionName : undefined,
    windowName: typeof rec.windowName === "string" ? rec.windowName : undefined,
    subagent: typeof rec.subagent === "string" ? rec.subagent : undefined,
    agent: agent as ButtonRequest["agent"],
    kind,
    question,
    title: typeof rec.title === "string" ? rec.title : undefined,
    options,
    decisionLabels,
    permissionEvent,
    toolInput,
    // Set-member marker: a multi-question sub-answer must never late-deliver
    // into the pane (all-or-nothing — see ButtonRequest.multiQuestion). Parsed
    // here so it survives BOTH the socket boundary and the disk restore.
    multiQuestion: rec.multiQuestion === true ? true : undefined,
    // The per-turn identity proof (see ButtonRequest.promptTurnId) MUST survive
    // BOTH the socket boundary and the disk restore — it's what the reconnect
    // branch requires before auto-delivering a queued permission decision
    // within its retention window (handleHookSocketLine, tg-cli#182). Dropping
    // it here would silently
    // degrade every restored/reconnected request to the untrusted case.
    promptTurnId: typeof rec.promptTurnId === "string" ? rec.promptTurnId : undefined,
    // tg-cli#403 / agent-tools#754: MUST survive BOTH the socket boundary and
    // the disk restore — it's what gates askDaemon's Infinity deadline,
    // forwardAndPostQuestion's UNSCOPED_ABANDON_MS skip, and the daemon's
    // reminder sweep. This is the SERVER-side (daemon socket) parse; the
    // CLIENT-side counterpart lives in hook-normalize.ts's
    // normalizeHookPayload "already normalized" branch.
    critical: rec.critical === true ? true : undefined,
    // Grant protocol v1.1 additive fields (tg-cli#398) — the AUTHORITATIVE
    // socket/disk validator carries them tolerantly: unknown or malformed
    // subfields are dropped, never a rejection, so an old lib ↔ new daemon
    // (or vice versa) keep interoperating. `operation` is OPAQUE (the lib
    // computes the fingerprint; this daemon only compares it, grants.ts).
    hookId: typeof rec.hookId === "string" && rec.hookId ? rec.hookId : undefined,
    timeoutMs:
      typeof rec.timeoutMs === "number" && Number.isFinite(rec.timeoutMs) && rec.timeoutMs > 0 ? rec.timeoutMs : undefined,
    origin: readAskAdditiveOrigin(rec.origin),
    operation: readAskAdditiveOperation(rec.operation),
  }
}

// Subfield-tolerant readers for the v1.1 additive fields (tg-cli#398) — same
// tolerance contract as hook-normalize.ts's readAskOrigin/readAskOperation,
// duplicated at the authoritative boundary on purpose: the daemon MUST NOT
// trust the client side's normalization for a socket/disk payload.
function readAskAdditiveOrigin(raw: unknown): ButtonRequest["origin"] {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return undefined
  const rec = raw as Record<string, unknown>
  const out: NonNullable<ButtonRequest["origin"]> = {}
  if (typeof rec.agent === "string" && rec.agent) out.agent = rec.agent
  if (typeof rec.sessionId === "string" && rec.sessionId) out.sessionId = rec.sessionId
  if (typeof rec.subagent === "string" && rec.subagent) out.subagent = rec.subagent
  return Object.keys(out).length ? out : undefined
}
function readAskAdditiveOperation(raw: unknown): ButtonRequest["operation"] {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return undefined
  const rec = raw as Record<string, unknown>
  const out: NonNullable<ButtonRequest["operation"]> = {}
  if (typeof rec.kind === "string" && rec.kind) out.kind = rec.kind
  if (typeof rec.fingerprint === "string" && rec.fingerprint) out.fingerprint = rec.fingerprint
  if (typeof rec.cwd === "string" && rec.cwd) out.cwd = rec.cwd
  if (typeof rec.repoRoot === "string" && rec.repoRoot) out.repoRoot = rec.repoRoot
  return Object.keys(out).length ? out : undefined
}

function canForwardButtonRequest(req: ButtonRequest): boolean {
  if (questionCapability(req.agent) !== "buttons") return false
  return !(req.agent === "codex" && req.kind !== "permission")
}

function hookMatchesRegistration(regs: Registration[], req: ButtonRequest): boolean {
  return registrationSetAllowsHook(regs, req, resolve)
}

// One-line, greppable descriptors for the ask-forward log. They identify which
// question arrived and which registration it was matched against, so a silent
// non-forward (the question stays in the harness) becomes a visible log line
// stating exactly why it was dropped — never a bare socket.end("null").
function describeAskRequest(req: ButtonRequest): string {
  return `agent=${req.agent} kind=${req.kind} req=${req.requestId} subagent=${req.subagent ?? "-"} window=${req.windowName ?? "-"} pane=${req.paneId ?? "-"} cwd=${req.cwd ?? "-"} session=${req.sessionName ?? "-"}`
}

// An interim STATUS line the daemon writes to the hook socket BEFORE its final reply
// (tg-cli#317). The final reply is unchanged (`null\n` or `<json>\n`), so a client that
// predates this still works; a client that reads status lines can tell a card that was
// POSTED and then expired from a request DROPPED at the door. Those two used to be one
// bare `null`, and the asking side reported a card the human could see in Telegram as
// "not-posted … daemon declined or unreachable" (messageId=14880, 2026-09-05).
type AskStatusLine =
  | { tgctl: "ask-status"; state: "posted"; messageId: number }
  | { tgctl: "ask-status"; state: "dropped"; reason: string }
  | { tgctl: "ask-status"; state: "expired"; messageId: number | null; ageMs: number }

function writeAskStatus(socket: Socket, status: AskStatusLine): void {
  if (socket.destroyed || socket.writableEnded) return
  socket.write(`${JSON.stringify(status)}\n`)
}

// Decline a forward: the reason travels down the socket as a status line, then the
// unchanged `null` reply. Every drop branch names its reason here AND in the daemon log.
function dropAsk(socket: Socket, reason: string): void {
  writeAskStatus(socket, { tgctl: "ask-status", state: "dropped", reason })
  socket.end("null\n")
}

function describeRegistration(regs: Registration[]): string {
  if (regs.length === 0) return "none"
  return regs
    .map((reg) => `pane=${reg.paneId ?? "-"} cwd=${reg.cwd ?? "-"} session=${reg.sessionName ?? "-"}`)
    .join(" | ")
}

function describeHookLine(line: string): string {
  const one = line.replace(/\s+/g, " ").trim()
  return one.length > 120 ? `${one.slice(0, 120)}…` : one
}

// The in-memory + durable state for forwarded questions, threaded through the hook
// socket handlers. Bundled into one struct so the handlers (and their helpers) take
// a single param instead of a long positional list, and so the durable `persist`
// callback travels with the maps it serializes.
interface QuestionRuntime {
  pending: Map<string, PendingButton>
  activeKeys: Set<string>
  // Socket-closed SCOPED questions retained for late-delivery + reconnect. NEVER in
  // `pending`, so an abandoned question never defers its pane's inbound.
  abandoned: Map<string, AbandonedButton>
  // Answered-request replay cache (tg-cli#97): a re-forward of an already-answered
  // requestId replays the stored answer down the socket and posts NO second card.
  answered: Map<string, AnsweredButton>
  // Persist the durable question state after any mutation (atomic write). A restored
  // daemon late-delivers a late tap and re-attaches a reconnecting hook.
  persist: () => void
  // Release a pane's deferred backlog when its question goes away without an inline
  // answer (timeout / socket close / send failure). Idle panes flush immediately;
  // panes with another live question keep their queue for that question's answer.
  onRelease: (paneId: string) => void
  // A scoped question's hook socket closed, so the harness may have fallen back to
  // the terminal prompt. The Telegram card remains answerable by reply-text, and
  // queued inbound is allowed to flush into the pane instead of requiring a resend.
  onTerminalFallback: (paneId: string) => void
  // Same, for an UNSCOPED question (no paneId): sweep every pane that still holds
  // a backlog. Must run AFTER the entry is deleted from `pending` so the per-pane
  // guard sees the real post-removal state.
  onUnscopedRelease: () => void
  // Grant protocol v1.1 (tg-cli#398): the daemon-owned grant + grace store
  // (in-memory mirror of the 0600 file at paths.grants; grants.ts). The daemon
  // is the ONLY authority — clients never touch this file.
  grants: GrantStoreData
  // Persist the grant store (atomic 0600 write). FAIL-CLOSED, unlike the
  // best-effort question persist: returns false on write failure, and every
  // grant mutation (mint/consume) MUST roll its in-memory change back and
  // deny/report rather than confirm a grant that a restart would replay or
  // lose.
  persistGrants: () => boolean
  // A hatch permission ask EXPIRED (retired from `pending`, both paths —
  // the unscoped backstop timer and the hook socket close): upsert its grace
  // record so a late tap within GRACE_WINDOW_MS stays addressable.
  onHatchExpired: (entry: PendingButton, pendingKey: string) => void
}

// A genuinely dead card: an UNSCOPED question (no pane to late-deliver to) that
// timed out, or a send-failed forward. Its keyboard is cleared so it can't be tapped.
const EXPIRED_TERMINAL_TEXT = "expired — answer in terminal"
// abandonedPermissionText / abandonedMultiText (features/tg-ctl/questions.ts) cover
// a SCOPED permission or multi-question SET MEMBER whose hook socket closed (daemon
// restart mid-block, or the hook's 120s budget elapsed): the keyboard stays live so
// the user can tap once the agent reconnects, and the reconnect re-attach delivers
// the answer down the new socket. A multi-question set member additionally can't be
// late-delivered (the local dialog may be on a DIFFERENT question of the set — see
// ButtonRequest.multiQuestion), so its text points at the terminal instead. Both are
// built at the call site with the pane's resolved label (resolveWindowAgentLabel) so
// the card identifies WHICH agent disconnected instead of a bare, unidentifiable
// message — and phrased as a transient reconnect, not agent death (tg-cli UX fix).

// Whether two permission ButtonRequests represent the SAME approved action —
// the guard a queued decision must pass before it is auto-delivered to a
// reconnecting hook (see handleHookSocketLine). Compares both the displayed
// question text AND the raw toolInput: the text alone is not enough, since
// toolInput can carry content (an edit's diff, a write's body, structured args)
// the question string never shows.
function permissionPayloadMatches(a: ButtonRequest, b: ButtonRequest): boolean {
  // `a` (the retained request) is always a permission — only a permission ever
  // carries a queuedDecision (see AbandonedButton.queuedDecision). `b` (the
  // reconnecting request) is NOT guaranteed to be one: `requestId` equality alone
  // (the caller's outer gate) doesn't prove kind/agent/pane/hook-event also match
  // — a reused or hash-colliding requestId across a DIFFERENT kind/agent/pane/event
  // must never have a permission decision auto-delivered onto it (review finding:
  // "not bound to request provenance"). `permissionEvent` matters too — the reply
  // SHAPE differs between PreToolUse and PermissionRequest.
  if (a.kind !== "permission" || b.kind !== "permission") return false
  if (a.agent !== b.agent) return false
  if (a.paneId !== b.paneId) return false
  if ((a.permissionEvent ?? "PermissionRequest") !== (b.permissionEvent ?? "PermissionRequest")) return false
  if (a.question !== b.question) return false
  // `promptTurnId` (review finding): the caller's outer `requestId` equality
  // isn't itself proof of invocation identity — requestId is a SHORT djb2 hash
  // (hook-normalize.ts), and the whole "a different invocation can't reach this
  // branch" argument for dropping the delivery timer rests on env.invocationNonce
  // being folded into that hash, not on the hash being collision-free. Comparing
  // the raw `promptTurnId` values here closes that gap directly instead of
  // trusting the hash alone. A genuine reconnect (the SAME process's own
  // reconnect-and-resend loop) resends the identical serialized request — same
  // nonce — so this never rejects a real reconnect.
  if (a.promptTurnId !== b.promptTurnId) return false
  return JSON.stringify(a.toolInput ?? null) === JSON.stringify(b.toolInput ?? null)
}

// A SCOPED question (with options) or a SCOPED permission can survive socket close:
// a question still injects into its pane (late-delivery); a permission re-attaches
// when the hook reconnects. Retain both when paneId is set. Returns true when
// retained (caller keeps the keyboard live); unscoped or option-less questions
// fall through to expiry.
function retainAbandonedQuestion(rt: QuestionRuntime, entry: PendingButton, pendingKey: string): boolean {
  const { req } = entry
  if (!req.paneId) {
    // A hatch/RIG_HATCH_REQUEST_* permission has no pane to inject into or
    // reconnect from (see parseHatchHookId's doc comment, questions.ts) — but
    // a human decision on it must still survive the socket closing, so a
    // LATER retry of the same hookId can consume it (handleHookSocketLine's
    // hatch short-circuit) instead of the tap being thrown away. Every other
    // unscoped kind (a plain question with no pane, or a multi-question set
    // member) has no consumer for a retained entry at all and stays
    // fall-through-to-expiry, unchanged.
    if (req.kind !== "permission" || !isHatchRequest(req)) return false
  } else if (req.kind === "question" && !req.options?.length) {
    return false
  }
  rt.abandoned.set(pendingKey, {
    req,
    messageId: entry.messageId,
    at: Date.now(),
    // tg-cli#403: the reminder scheduler's clock must survive this transition —
    // otherwise a socket-close mid-episode would silently reset it and either
    // delay or (worse, if criticalState carried a quietHoursDeferredUntil)
    // double-fire the deferred reminder.
    ...(entry.criticalState ? { criticalState: entry.criticalState } : {}),
  })
  return true
}

// A dead card (unscoped / no options) can never be late-delivered: clear its keyboard
// so it isn't tappable and mark it expired. messageId may still be null mid-send —
// stash the text so the post-send reconciliation applies it.
function expireDeadCard(ctx: Ctx, entry: PendingButton): void {
  if (entry.messageId !== null) {
    void clearMessageKeyboard(ctx, entry.messageId)
    void editMessageText(ctx, entry.messageId, EXPIRED_TERMINAL_TEXT)
  } else {
    entry.finalText = EXPIRED_TERMINAL_TEXT
  }
}

// Both retirement paths — the raw UNSCOPED_ABANDON_MS backstop timer (the
// requesting process is STILL CONNECTED, just past its abandon window — the
// DOMINANT production case for a hatch permission, since a hook process's own
// budget is ~120s, comfortably longer than the 110s default abandon window) and
// the hook socket's 'close' handler (the process already exited) — must retire
// a PendingButton through the SAME retain-or-expire decision. Before this was
// unified, the raw timer called expireDeadCard(ctx, entry) unconditionally, so
// for a still-connected hatch request it always won the race and destroyed the
// card before the socket ever closed and retention could run — silently
// re-breaking tg-cli#349 in the default scenario (review finding on #350,
// which had only fixed the already-exited/socket-close case).
function retireAbandonedEntry(ctx: Ctx, rt: QuestionRuntime, entry: PendingButton, pendingKey: string): void {
  // Grant protocol v1.1 (tg-cli#398): an expiring HATCH permission becomes
  // addressable for a late tap through its 24h grace record REGARDLESS of the
  // retained/expired decision below (retention is 12h; grace outlives it, so a
  // tap after the entry is pruned still mints a grant). Fail-soft with a loud
  // log: grace loss degrades the feature but never authorizes anything.
  if (entry.req.kind === "permission" && isHatchRequest(entry.req)) rt.onHatchExpired(entry, pendingKey)
  if (retainAbandonedQuestion(rt, entry, pendingKey)) {
    if (entry.req.kind === "question" && !entry.req.multiQuestion) {
      rt.onTerminalFallback(entry.req.paneId as string)
      const abandoned = buildPostTimeoutQuestionMessage(ctx.chatId, entry.req)
      if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, abandoned.text, abandoned.reply_markup)
      else {
        entry.finalText = abandoned.text
        entry.finalReplyMarkup = abandoned.reply_markup
      }
    } else {
      // A hatch entry's paneId is always undefined (see parseHatchHookId's
      // doc comment, questions.ts) — rt.onRelease expects a REAL paneId, so
      // calling it here for a hatch entry would release a pane that was
      // never deferred in the first place. onUnscopedRelease is the correct
      // release path for any paneless retained entry, hatch included.
      if (entry.req.paneId) rt.onRelease(entry.req.paneId)
      else rt.onUnscopedRelease()
      const label = resolveWindowAgentLabel(entry.req.windowName, entry.req.cwd)
      const hookId = parseHatchHookId(entry.req.requestId)
      const abandonedText =
        entry.req.kind === "permission"
          ? hookId !== null
            ? hatchAbandonedPermissionText(entry.req, hookId)
            : abandonedPermissionText(entry.req, label)
          : abandonedMultiText(entry.req, label)
      // The keyboard MUST ride along explicitly (see editMessageText's own doc
      // comment: omitting reply_markup DETACHES the current keyboard, it is not
      // preserved) — otherwise this very edit removes the buttons the text just
      // invited a tap on, breaking the whole abandoned-tap/queue feature at the
      // moment it's needed (review finding). Mirrors the question branch above,
      // which already passes `abandoned.reply_markup` for the same reason.
      const abandonedMarkup = buildButtonMessage(ctx.chatId, entry.req).reply_markup
      if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, abandonedText, abandonedMarkup, hatchParseMode(entry.req))
      else {
        entry.finalText = abandonedText
        entry.finalReplyMarkup = abandonedMarkup
      }
    }
  } else {
    if (entry.req.paneId) rt.onRelease(entry.req.paneId)
    else rt.onUnscopedRelease()
    expireDeadCard(ctx, entry)
  }
}

// Arm the hook socket's 'close' handler for a freshly-forwarded or revived pending
// question. On close (the agent's hook process exits, or its 120s budget elapses)
// the entry leaves `pending` so it stops deferring the pane, then retireAbandonedEntry
// converges it through the same retain-or-expire decision the raw UNSCOPED_ABANDON_MS
// backstop timer uses. The pane's deferred backlog is released either way. Returns a
// getter the caller uses to avoid double-ending a socket it still owns.
function armPendingSocketClose(
  ctx: Ctx,
  rt: QuestionRuntime,
  entry: PendingButton,
  pendingKey: string,
): { closed: () => boolean } {
  let socketClosed = false
  entry.socket.on("close", () => {
    socketClosed = true
    if (rt.pending.get(pendingKey) !== entry) return
    clearTimeout(entry.timer)
    rt.pending.delete(pendingKey)
    rt.activeKeys.delete(pendingKey)
    retireAbandonedEntry(ctx, rt, entry, pendingKey)
    rt.persist()
  })
  return { closed: () => socketClosed }
}

// Fresh forward: register the pending entry, arm its socket-close handler, post the
// inline-keyboard card, and reconcile against a socket that closed mid-send. Split
// out of handleHookSocketLine so the dispatcher stays a readable parse→guard→route.
async function forwardAndPostQuestion(
  ctx: Ctx,
  rt: QuestionRuntime,
  req: ButtonRequest,
  socket: Socket,
  pendingKey: string,
): Promise<void> {
  rt.activeKeys.add(pendingKey)
  const entry: PendingButton = { req, socket, messageId: null, at: Date.now() }
  // tg-cli#403: a CRITICAL request's clock for the FIRST reminder starts at
  // the card's post time, not at the first sweep tick that happens to
  // observe it — otherwise a reminder could fire (near-)immediately after
  // the card is posted, since planCriticalReminder treats an undefined
  // lastReminderAt as "infinitely overdue".
  if (req.critical === true) entry.criticalState = { lastReminderAt: entry.at }
  // An UNSCOPED question defers EVERY pane (fail-closed), so it MUST self-clear on a
  // timer or it wedges all routing. A SCOPED question waits forever (no timer): only
  // its socket close releases it (see armPendingSocketClose).
  //
  // tg-cli#403: a CRITICAL unscoped (paneless — the headless hatch case) request
  // is the ONE exception: this timer is exactly what would otherwise force-close
  // its live socket after UNSCOPED_ABANDON_MS (110s default) with a bare "null"
  // reply, defeating "wait indefinitely" for the very use case critical mode
  // exists for (a headless RIG_HATCH_REQUEST_* ask). No timer is armed at all —
  // the entry stays in `pending`, live socket open, until either a real answer
  // arrives (the ordinary tap path, unaffected) or the socket itself closes
  // (the underlying process actually exits/gets killed — armPendingSocketClose's
  // 'close' handler still retires it exactly as for any other request).
  if (!req.paneId && req.critical !== true) {
    entry.timer = setTimeout(() => {
      if (rt.pending.get(pendingKey) !== entry) return
      rt.pending.delete(pendingKey)
      rt.activeKeys.delete(pendingKey)
      retireAbandonedEntry(ctx, rt, entry, pendingKey)
      rt.persist()
      writeAskStatus(socket, {
        tgctl: "ask-status", state: "expired", messageId: entry.messageId, ageMs: Date.now() - entry.at,
      })
      socket.end("null\n")
    // Contract §1 (tg-cli#398): a per-request timeoutMs (hatch asks carry
    // 600000) overrides the unscoped-abandon default, clamped to the 15-min
    // cap (clampRequestTimeoutMs). Absent → UNSCOPED_ABANDON_MS unchanged.
    }, clampRequestTimeoutMs(req.timeoutMs, UNSCOPED_ABANDON_MS))
  }
  rt.pending.set(pendingKey, entry)
  const conn = armPendingSocketClose(ctx, rt, entry, pendingKey)

  const payload = buildButtonMessage(ctx.chatId, req)
  const messageId = await sendButtonCard(ctx, payload)
  if (messageId === null) {
    // botPost already logged the low-level send failure; tie it to THIS abandoned
    // forward so the drop is greppable. No card posted → nothing to late-deliver.
    log(`ask-forward dropped: reason=send-failed ${describeAskRequest(req)}`)
    if (rt.pending.get(pendingKey) === entry) {
      rt.pending.delete(pendingKey)
      rt.activeKeys.delete(pendingKey)
      clearTimeout(entry.timer)
      if (entry.req.paneId) rt.onRelease(entry.req.paneId)
      else rt.onUnscopedRelease()
    } else {
      // The socket closed DURING the failed send, so the close handler already
      // removed the pending entry — and, for a scoped question, RETAINED an abandoned
      // entry with a null card id. But the card never posted, so drop that phantom:
      // left in place it would persist, survive a restart, and let a reconnect
      // re-attach to a card the human never saw (the agent blocked blind).
      const phantom = rt.abandoned.get(pendingKey)
      if (phantom && phantom.req.requestId === req.requestId && phantom.messageId === null) {
        rt.abandoned.delete(pendingKey)
      }
    }
    rt.persist()
    if (!conn.closed()) dropAsk(socket, "send-failed")
    return
  }
  log(`ask-forward posted: ${describeAskRequest(req)} messageId=${messageId}`)
  if (!conn.closed()) writeAskStatus(socket, { tgctl: "ask-status", state: "posted", messageId })
  entry.messageId = messageId
  // If the socket closed DURING the send, the close handler may have retained an
  // abandoned entry with a null card id — backfill it now so late-delivery can edit
  // the right message.
  const ab = rt.abandoned.get(pendingKey)
  if (ab && ab.req.requestId === req.requestId && ab.messageId === null) ab.messageId = messageId
  // Accepted bound: a SIGKILL in the sub-ms window between the card posting above and
  // this persist (the atomicWrite included) leaves a card in Telegram with no on-disk
  // record — a reconnect-resend after restart then finds no retained entry and posts a
  // SECOND card. Same nature as the sub-inject window in lateDeliverAbandonedQuestion;
  // full closure would need a write-ahead marker BEFORE the send, not worth it for a
  // sub-ms window on a crash-relaunch.
  rt.persist() // the card id is now known — persist so a restart can late-deliver/reattach
  // The socket (or unscoped timer) closed DURING the send: the close handler set
  // finalText but, with messageId still null, couldn't touch the card. Apply it now —
  // and for a genuinely-dead card (EXPIRED_TERMINAL_TEXT) clear the keyboard too, so
  // the "dead card → not tappable" guarantee holds even on this race (a scoped
  // ABANDONED_TAP_TEXT card deliberately keeps its keyboard for late-delivery).
  if (rt.pending.get(pendingKey) !== entry || entry.finalText) {
    const finalText = entry.finalText ?? EXPIRED_TERMINAL_TEXT
    if (finalText === EXPIRED_TERMINAL_TEXT) void clearMessageKeyboard(ctx, messageId)
    void editMessageText(ctx, messageId, finalText, entry.finalReplyMarkup, finalText === EXPIRED_TERMINAL_TEXT ? undefined : hatchParseMode(entry.req))
  }
}

function startHookServer(ctx: Ctx, rt: QuestionRuntime): Server | null {
  try {
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    const server = createServer((socket) => {
      socket.setEncoding("utf8")
      let raw = ""
      socket.on("data", (chunk) => {
        raw += chunk
        const newline = raw.indexOf("\n")
        if (newline === -1) {
          // A hook request is a single small JSON line; anything bigger is a
          // misbehaving client trying to grow the buffer forever.
          if (raw.length > MAX_HOOK_REQUEST_BYTES) socket.destroy()
          return
        }
        const line = raw.slice(0, newline).trim()
        raw = raw.slice(newline + 1)
        void handleHookSocketLine(ctx, rt, socket, line)
      })
    })
    server.on("error", (err) => {
      log(`hook socket failed: ${err}`)
    })
    server.listen(ctx.paths.socket, () => {
      // Owner-only: the socket answers with approved hook JSON, so other local
      // users must not be able to connect (the guard trusts client-sent fields).
      try {
        chmodSync(ctx.paths.socket, 0o600)
      } catch {}
    })
    return server
  } catch (err) {
    log(`hook socket failed: ${err}`)
    return null
  }
}

async function handleHookSocketLine(ctx: Ctx, rt: QuestionRuntime, socket: Socket, line: string): Promise<void> {
  // The verify-grant exchange (grant protocol v1.1, tg-cli#398) is NOT a
  // ButtonRequest — it is dispatched by its marker BEFORE normalization so an
  // old/normalized-looking payload can never be confused with a question
  // forward. Cross-repo compatibility: an OLD daemon (no marker handling)
  // receives this line, fails normalizeButtonRequest, and drops it as
  // "unparsable-payload" with a `null` reply — the new lib's client fails
  // CLOSED on that (deny), which is the correct self-healing behavior.
  let parsedLine: unknown
  try {
    parsedLine = JSON.parse(line)
  } catch {
    parsedLine = undefined
  }
  if (parsedLine && typeof parsedLine === "object" && (parsedLine as { tgctl?: unknown }).tgctl === "verify-grant") {
    await handleVerifyGrantRequest(ctx, rt, socket, parsedLine as Record<string, unknown>)
    return
  }
  let req: ButtonRequest | null = null
  try {
    req = parsedLine === undefined ? null : normalizeButtonRequest(parsedLine)
  } catch {
    // malformed hook payload: let the local agent UI take over
  }
  if (!req) {
    // A non-forward must NEVER be silent: the question stays in the harness and
    // the operator gets zero signal. Every drop below logs a distinct, greppable
    // `ask-forward` reason so a question that doesn't reach Telegram is visible.
    log(`ask-forward dropped: reason=unparsable-payload line=${describeHookLine(line)}`)
    dropAsk(socket, "unparsable-payload")
    return
  }

  log(`ask-forward arrived: ${describeAskRequest(req)}`)

  // The per-pane registration SET: the question forwards when ITS pane matches
  // ANY registered entry, so EVERY concurrently-registered session forwards
  // (tg-cli#67), not only the single global last-writer. No liveness pruning
  // here — the asking pane is itself live (it is blocking on this very question),
  // and an unrelated dead-pane entry can never match this req's paneId, so a
  // prune would only cost an extra tmux read on the hot forward path.
  const registrations = readRegistrations(ctx.paths)
  // Hatch permissions skip the pane/cwd registration set (tg-cli#333): non-tmux
  // omp sessions are never registered, and hatch is the documented exception to
  // no-long-inline-process. canForwardButtonRequest still runs below.
  if (!isHatchPermissionRequest(req) && !hookMatchesRegistration(registrations, req)) {
    log(
      `ask-forward dropped: reason=not-registered ${describeAskRequest(req)} reg=${describeRegistration(registrations)}`,
    )
    dropAsk(socket, "not-registered")
    return
  }

  if (!canForwardButtonRequest(req)) {
    log(`ask-forward dropped: reason=not-forwardable ${describeAskRequest(req)}`)
    dropAsk(socket, "not-forwardable")
    void sendMessage(
      ctx,
      `native question forwarding isn't available for \`${req.agent}\` — answer in the terminal`,
    )
    return
  }

  // REMOVED (tg-cli#398): the hatch retry short-circuit that auto-applied a
  // queued tap to ANY retry behind the same hookId (see the note at the old
  // findQueuedHatchDecision site). A plain hatch retry now simply forwards a
  // FRESH card; a late human approval reaches the agent exclusively through
  // the operation-bound, single-use grant consumed via the verify-grant
  // protocol (handleVerifyGrantRequest, dispatched before normalization above).

  const pendingKey = callbackRequestId(req)
  if (rt.activeKeys.has(pendingKey)) {
    log(`ask-forward dropped: reason=duplicate-in-flight ${describeAskRequest(req)} key=${pendingKey}`)
    dropAsk(socket, "duplicate-in-flight")
    return
  }
  // Idempotency across the answer boundary (tg-cli#97): the in-flight dedup above
  // is RELEASED the instant a question is answered, so the SAME requestId
  // re-firing afterwards would post a second, superseded card. If we have a FRESH
  // answer for this key, replay it down the socket — rebuilt against the NEW req so
  // the reply shape matches this re-fire's own kind/event — and post no card. The
  // entry stays replayable for the whole window (a question can re-fire more than
  // once); a STALE entry (a genuinely new question reusing the hash past the TTL)
  // is pruned here so it falls through to a fresh forward. Only QUESTIONS are ever
  // cached (the write is kind-guarded), so consult it only for questions — symmetric
  // with the write and immune to a (practically impossible) cross-kind key clash.
  // Multi-question members also skip the replay READ defensively: they are never
  // written (all-or-nothing, see the answer branch), but an entry persisted by an
  // older daemon must not replay into a new round either.
  const prior = req.kind === "question" && !req.multiQuestion ? rt.answered.get(pendingKey) : undefined
  if (prior) {
    if (Date.now() - prior.at <= ANSWERED_REPLAY_MS) {
      if (prior.delivery === "pane") {
        // The answer was already LATE-DELIVERED into the pane (this PR). A hook that
        // reconnects (the restart race) or re-fires must NOT also have it replayed
        // down the socket — that delivers the answer twice. Return null with NO card:
        // a still-blocked hook falls back to the terminal, where the pane injection
        // lands, so the agent gets the chosen option exactly once.
        log(`ask-forward already-pane-delivered: ${describeAskRequest(req)} key=${pendingKey} label=${prior.label}`)
        dropAsk(socket, "already-pane-delivered")
        return
      }
      const replayAnswer: ButtonAnswer = {
        status: "answered",
        requestId: req.requestId,
        label: prior.label,
        value: prior.value,
        decision: prior.decision,
      }
      const output = formatAgentHookOutput(req, replayAnswer)
      log(`ask-forward replayed-answer: ${describeAskRequest(req)} key=${pendingKey} label=${prior.label}`)
      socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
      return
    }
    rt.answered.delete(pendingKey)
  }
  // RECONNECT re-attach (lossless restart): the SAME question or permission re-arriving
  // while we still RETAIN it — its socket died because the 120s window closed OR a
  // daemon restart restored it from disk — re-attaches THIS new socket to the existing
  // card instead of posting a duplicate. The agent's `tg-ctl ask` reconnect-and-resend
  // (byte-identical requestId, still inside its hook budget) lands here. We require an
  // EXACT requestId match (not just the callbackRequestId hash) so a genuinely different
  // request that merely hash-collides falls through to a fresh card. A late TAP that
  // already late-delivered moved the entry to `answered` (replayed above), so a tap and
  // a reconnect never fight over the same key. Only SCOPED entries are ever retained,
  // so the revived entry needs no unscoped timer.
  const retained = rt.abandoned.get(pendingKey)
  if (retained) {
    if (retained.req.requestId === req.requestId) {
      rt.abandoned.delete(pendingKey)
      // A Telegram tap already chose a permission decision WHILE this hook was
      // disconnected (queued by lateDeliverAbandonedQuestion, since a permission has
      // no pane-text fallback). Deliver it down THIS reconnecting socket right away
      // instead of re-showing a live prompt the human already answered — this is
      // what makes abandonedPermissionText's "delivered the moment it reconnects"
      // claim true rather than aspirational.
      // Only auto-deliver when the reconnecting request is PROVABLY the same prompt
      // the human read and decided on — requestId alone is a hash of session+question
      // text (tg-cli#97) and normally can't collide across different prompts, but a
      // harness that reused a stale requestId against a MUTATED payload must not
      // have that old decision silently rubber-stamped onto a request the human
      // never actually saw (review finding). This must compare the FULL approved
      // surface, not just the displayed question text: `toolInput` can carry
      // content (an edit's diff, a write's contents, structured args) the question
      // string never shows, so two requests can read identically to the human while
      // asking for materially different actions. A mismatch on EITHER is treated as
      // "no queued decision": fall through to the ordinary re-attach so the human is
      // shown a fresh live prompt and taps it explicitly.
      //
      // Bounded by the permission's own retention window (ABANDONED_PERMISSION_RETAIN_MS,
      // default 12h — tg-cli#182 round 7; PREVIOUSLY documented here as "not
      // time-bounded", which stopped being true once that window was added — see
      // the synchronous check below), not the short question one (Alex tg#9982:
      // never demoted onto the SHORT timer). Within that window, delivery is safe
      // because the identity check itself is airtight for permissions — requestId folds in
      // `env.invocationNonce` (hook-normalize.ts), a random id generated ONCE PER
      // `tg-ctl ask` PROCESS. Claude's `prompt_id` / Codex's `turn_id` alone are
      // NOT sufficient here (they scope to the whole prompt TURN, not the
      // individual tool call — two distinct calls in the same turn could still
      // share a requestId under turn-id-only scoping; caught in review), so a
      // materially later, only-coincidentally-identical-looking request (whether a
      // later turn OR a second call within the same turn) can never reach this
      // branch at all — it's always a NEW process with a NEW nonce, hashing to a
      // DIFFERENT requestId that never matches `retained.req.requestId ===
      // req.requestId` above. permissionPayloadMatches remains as defense-in-depth
      // against the narrower residual risk of a lossy `summarizeInput` digest
      // collision (two DIFFERENT toolInputs summarizing to the same short string)
      // — not a stand-in for a time bound.
      //
      // `retained.req.promptTurnId` is REQUIRED (not just permissionPayloadMatches):
      // it's the proof that THIS retained request was actually captured with
      // turn-level identity in the first place. Without it (an older Claude Code
      // <v2.1.196, a harness with no turn_id equivalent, or a manual/back-compat
      // caller), requestId is only session-scoped, and a same-session re-run of an
      // identical command is a routine, non-malicious occurrence — auto-delivering
      // onto it would be exactly the "different prompt, same-looking request"
      // hazard this whole check exists to prevent (review finding). Refusing
      // auto-delivery there does NOT silently drop the tap: the fallthrough below
      // restores the card to a LIVE, freshly-buttoned prompt (buildButtonMessage)
      // — visibly pending again, not a dead/expired card and not a false "queued"
      // claim — so the human sees exactly what's happening and can re-decide. The
      // OLD queued value itself is NOT carried forward into that fresh prompt
      // (PendingButton has no queuedDecision slot): once identity can't be proven,
      // presenting a genuinely fresh choice is the honest, safe behavior, not a
      // stale tap silently reapplied.
      // Synchronous age check, not just the periodic pruneAbandonedButtons sweep
      // (review finding, tg-cli#182 round 4): the sweep only runs on the poll
      // loop's own cadence, so a reconnect landing in the gap between an entry
      // crossing its retention window and the next sweep could otherwise still
      // deliver a queued decision past its own kind's window — the entry's
      // "genuinely still retained" status must be true AT THE MOMENT OF
      // DELIVERY, not merely "not yet swept". This does not weaken the
      // design above (safety WITHIN the window comes from identity, not a
      // timer) — it only closes the race on the boundary that design already
      // assumes pruneAbandonedButtons enforces synchronously. Gated on `queuedDecision`
      // actually being present (review finding, round 5): an ordinary late
      // reconnect with no tap ever made isn't a "decision" expiring — logging
      // it as one would be misleading noise on the common overnight case.
      const outcome = decideQueuedPermissionReconnect(retained, req, Date.now())
      switch (outcome.kind) {
        case "deliver": {
          const qd = outcome.queuedDecision
          const answer: ButtonAnswer = {
            status: "answered",
            requestId: req.requestId,
            label: qd.label,
            value: qd.value,
            decision: qd.decision,
          }
          const output = formatAgentHookOutput(req, answer)
          socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
          // Deliberately NOT added to `rt.answered` (the question-only replay cache —
          // see the "Scoped to questions on purpose" comment in the live-tap handler
          // below): silently replaying a permission decision to a LATER unrelated
          // re-fire that happens to reuse the same key would be exactly the
          // behavioral/security change that cache was built to avoid (review
          // finding). The entry is already gone from `rt.abandoned` above, so a
          // genuinely fresh re-fire of this requestId just forwards as a normal new
          // prompt — no double-delivery risk without the cache.
          rt.persist()
          if (retained.messageId !== null) {
            void clearMessageKeyboard(ctx, retained.messageId)
            void editMessageText(ctx, retained.messageId, buildAnsweredQuestionText(req, qd.label), undefined, hatchParseMode(req))
          }
          log(`ask-forward queued-decision-delivered: ${describeAskRequest(req)} key=${pendingKey} label=${qd.label}`)
          return
        }
        case "expired":
          log(`ask-forward queued-decision-expired-at-reconnect: key=${pendingKey} ageMs=${Date.now() - retained.at}`)
          break
        case "no-turn-proof":
          log(`ask-forward queued-decision-discarded: retained request has no promptTurnId (no per-invocation identity proof) — refusing auto-delivery, showing a fresh live prompt instead. key=${pendingKey}`)
          break
        case "turn-mismatch":
          // Distinct from the generic payload-mismatch case below (review finding:
          // this log used to blame "question text or toolInput" even when the REAL
          // mismatch was promptTurnId — e.g. a manual/back-compat caller reusing the
          // same requestId while omitting or changing the field).
          log(`ask-forward queued-decision-discarded: reconnecting request's promptTurnId does not match the queued decision's (permissionPayloadMatches) — showing a fresh live prompt instead. key=${pendingKey}`)
          break
        case "payload-mismatch":
          log(`ask-forward queued-decision-discarded: reconnecting request's question text or toolInput no longer matches the queued decision's (permissionPayloadMatches) — showing a fresh live prompt instead. key=${pendingKey}`)
          break
        case "no-queued-decision":
          break // ordinary reconnect, nothing queued — nothing to log
      }
      rt.activeKeys.add(pendingKey)
      const entry: PendingButton = {
        req,
        socket,
        messageId: retained.messageId,
        at: Date.now(),
        // tg-cli#403 review finding: a reconnecting SCOPED critical request (a hatch
        // ask that happened to carry a real paneId — best-effort from TMUX_PANE —
        // is the one case reconnectable at all) must carry its reminder-scheduling
        // clock over from the abandoned entry it's reattaching to. Without this, the
        // fresh PendingButton starts with `criticalState: undefined`, which
        // planCriticalReminder treats as "infinitely overdue" — the very next sweep
        // would fire a reminder immediately, and since `lastReminderMessageId` is also
        // lost, the previous reminder (if any) would never get deleted/replaced,
        // violating acceptance criterion (c) on every daemon bounce or transient
        // socket drop for a scoped critical request.
        ...(retained.criticalState ? { criticalState: retained.criticalState } : {}),
      }
      rt.pending.set(pendingKey, entry)
      armPendingSocketClose(ctx, rt, entry, pendingKey)
      // tg-cli#317 review finding: a reconnect landing HERE (the daemon reattaching
      // an already-posted-but-undecided card after a restart or a transient socket
      // drop) previously wrote no status line at all. If this new connection then
      // also drops or times out with no tap, describeAskOutcome saw an empty
      // `statuses` array and reported "unreachable"/"no status line" for a card
      // that is genuinely live and answerable in Telegram — the exact incident
      // this file exists to fix, recreated in the one path the first pass missed.
      if (retained.messageId !== null) {
        writeAskStatus(socket, { tgctl: "ask-status", state: "posted", messageId: retained.messageId })
      }
      rt.persist()
      // The card is LIVE again — restore the original prompt text, which the
      // socket-close path replaced with "window closed …" (actively misleading
      // for a multi-question member: it tells the user NOT to tap the one card
      // that now works — review finding). The keyboard rides along explicitly:
      // Telegram's editMessageText DETACHES the inline keyboard when
      // reply_markup is omitted. Best-effort like every card edit (a restart-
      // restored card that was never edited yields "message is not modified",
      // which botPost swallows).
      if (retained.messageId !== null) {
        const restored = buildButtonMessage(ctx.chatId, req)
        void editMessageText(ctx, retained.messageId, restored.text, restored.reply_markup, restored.parse_mode)
      }
      log(`ask-forward reattached: ${describeAskRequest(req)} key=${pendingKey} messageId=${retained.messageId ?? "-"}`)
      return
    }
    rt.abandoned.delete(pendingKey) // stale hash-collision → fall through to a fresh forward
  }
  await forwardAndPostQuestion(ctx, rt, req, socket, pendingKey)
}

// --- Grant protocol v1.1 (tg-cli#398): the verify-grant exchange ---
//
// The daemon is the ONLY grant authority. A `{"tgctl":"verify-grant",…}` line
// (dispatched from handleHookSocketLine BEFORE normalization) carries:
//   hookId     — RIG_HATCH_REQUEST_<HOOK_ID>'s hook id (required)
//   approvalId — TOKEN path (contract §5): explicit id, route-agnostic (the
//                agent was told the id out-of-band)
//   pull: true — PULL path: no id; matched by hook_id + operation + ROUTE
//                EQUALITY (routeForRequest recomputed from `payload`, never a
//                client-sent route field). NO blank-route fallback.
//   payload    — the normalized ask (carries the recomputed `operation`)
// The reply is the SAME hookSpecificOutput allow/deny JSON shape a normal ask
// reply uses (formatAgentHookOutput where the payload normalizes, a
// PermissionRequest envelope otherwise), PLUS the original ask's `requestId`
// at TOP level (the pinned shape the agent-tools lib reads; it also parses
// hookSpecificOutput.requestId tolerantly) and `approvalId` on allow.

// Deny envelope: constructed directly (not via formatAgentHookOutput) so the
// deny REASON always reaches the caller — formatAgentHookOutput only conveys
// a reason for a RELABELED deny (plan-approval), not a bare Approve/Reject.
function buildVerifyGrantDeny(payloadReq: ButtonRequest | null, reasonText: string, requestId: string | null): Record<string, unknown> {
  if (payloadReq?.permissionEvent === "PreToolUse") {
    return {
      requestId,
      hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: reasonText },
    }
  }
  return {
    requestId,
    hookSpecificOutput: { hookEventName: "PermissionRequest", decision: { behavior: "deny", message: reasonText } },
  }
}

function buildVerifyGrantAllow(payloadReq: ButtonRequest | null, grant: { approval_id: string; request_id: string }): Record<string, unknown> {
  let out: unknown = null
  if (payloadReq) {
    const answer: ButtonAnswer = {
      status: "answered",
      requestId: grant.request_id,
      label: "Approve",
      value: "allow",
      decision: "allow",
    }
    out = formatAgentHookOutput(payloadReq, answer)
  }
  if (!out || typeof out !== "object") {
    out = { hookSpecificOutput: { hookEventName: "PermissionRequest", decision: { behavior: "allow" } } }
  }
  return { requestId: grant.request_id, approvalId: grant.approval_id, ...(out as Record<string, unknown>) }
}

// Consume-on-allow, FAIL-CLOSED: mutate consumed_at and persist BEFORE
// replying; if the atomic write fails the mutation is rolled back and the
// reply is a DENY — otherwise a daemon restart would resurrect the grant as
// unconsumed and permit a single-use replay (security invariant §6).
async function handleVerifyGrantRequest(ctx: Ctx, rt: QuestionRuntime, socket: Socket, rec: Record<string, unknown>): Promise<void> {
  const hookId = typeof rec.hookId === "string" && rec.hookId ? rec.hookId : null
  const approvalId = typeof rec.approvalId === "string" && rec.approvalId ? rec.approvalId : null
  const pull = rec.pull === true
  const payloadReq = rec.payload ? normalizeButtonRequest(rec.payload) : null
  const reply = (obj: Record<string, unknown>): void => {
    socket.end(`${JSON.stringify(obj)}\n`)
  }
  if (!hookId || (!pull && !approvalId)) {
    log(`grant-deny: reason=malformed-request hookId=${hookId ?? "-"} approvalId=${approvalId ?? "-"} pull=${pull}`)
    reply(buildVerifyGrantDeny(payloadReq, "malformed verify-grant request (needs --hook <hook_id>, and an approval id or --pull)", null))
    return
  }
  const now = Date.now()
  const operation = payloadReq?.operation
  // TOKEN path: explicit approval id, route-agnostic. PULL path: no id —
  // matched by hook_id + operation + route equality, route recomputed
  // daemon-side from the query payload's routing fields.
  const outcome = pull
    ? pullGrant(rt.grants.grants, hookId, operation, payloadReq ? routeForRequest(payloadReq) : null, now)
    : verifyGrant(rt.grants.grants, approvalId!, hookId, operation, now)
  if (outcome.kind === "deny") {
    const existing = pull ? null : (rt.grants.grants.find((g) => g.approval_id === approvalId) ?? null)
    log(
      `grant-deny: via=${pull ? "pull" : "token"} hookId=${hookId} approvalId=${approvalId ?? "-"} reason=${outcome.reason}` +
        ` cwd=${operation?.cwd ?? "-"} route=${pull ? (payloadReq ? routeForRequest(payloadReq) : null) ?? "-" : "(n/a)"}`,
    )
    // Top-level requestId (the pinned shape the lib reads): the ORIGINAL ask's
    // when the grant is known, else the retry payload's own (the lib correlates
    // either), never a missing key.
    reply(
      buildVerifyGrantDeny(
        payloadReq,
        grantDenyReasonText(outcome.reason, hookId),
        existing?.request_id ?? payloadReq?.requestId ?? null,
      ),
    )
    return
  }
  const grant = outcome.grant
  grant.consumed_at = now
  if (!rt.persistGrants()) {
    grant.consumed_at = null
    log(`grant-deny: via=${pull ? "pull" : "token"} approvalId=${grant.approval_id} reason=persist-failed — rolled back, NOT consumed`)
    reply(buildVerifyGrantDeny(payloadReq, "grant store write failed — denying fail-closed (the grant was NOT consumed); retry", grant.request_id))
    return
  }
  log(`grant-consume: via=${pull ? "pull" : "token"} approvalId=${grant.approval_id} hookId=${hookId} req=${grant.request_id}`)
  reply(buildVerifyGrantAllow(payloadReq, grant))
}

// The agent kind the hook was installed for (`tg-ctl ask --agent codex`). Decides
// how the raw payload is normalized + formatted. The accepted set is
// HOOK_AGENT_KINDS (features/tg-ctl/types.ts) — an exhaustiveness-checked single
// source, so a future harness kind forces a compile error there, never a silent
// fallthrough. An ABSENT flag defaults to claude (back-compat with hook installs
// older than the selector); a PRESENT-but-unrecognized value still defaults to
// claude but logs a warning — coercing it silently would hand a typo'd or
// newer-than-the-daemon kind claude semantics with zero signal.
function hookAgentFromArgv(): HookAgentKind {
  const i = process.argv.indexOf("--agent")
  const v = i >= 0 ? process.argv[i + 1] : undefined
  if (v && isHookAgentKind(v)) return v
  if (v) log(`ask: unrecognized --agent '${v}' — falling back to claude (known: ${HOOK_AGENT_KINDS.join("/")})`)
  return "claude"
}

function tmuxSessionName(): string | undefined {
  return tmuxDisplay("#{session_name}")
}

function tmuxWindowName(): string | undefined {
  return tmuxDisplay("#{window_name}")
}

function tmuxDisplay(format: string): string | undefined {
  if (!process.env.TMUX) return undefined
  try {
    const r = Bun.spawnSync(["tmux", "display-message", "-p", format], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
    if (r.exitCode === 0) return r.stdout.toString().trim() || undefined
  } catch {}
  return undefined
}

// One result of a single hook-socket attempt. `response` is a COMPLETE reply (a
// newline-terminated line the daemon wrote before closing — including a legitimate
// "null" decline); `dropped` is a connection that closed/errored WITHOUT a complete
// reply (daemon down, restarting, or died mid-block); `timeout` is the overall
// budget elapsing. The distinction is what makes reconnect safe: only `dropped` is
// retried — a real "null" decline is honored, not looped.
type AskAttempt = { kind: "response" | "dropped" | "timeout"; raw: string | null; statuses: AskStatusLine[] }

function parseAskStatus(line: string): AskStatusLine | null {
  try {
    const v = JSON.parse(line) as { tgctl?: unknown; state?: unknown }
    if (v && typeof v === "object" && v.tgctl === "ask-status" && typeof v.state === "string") {
      return v as AskStatusLine
    }
  } catch {}
  return null
}

// Everything the daemon wrote before the socket went away: status lines (kept) and the
// final reply (the LAST newline-terminated non-status line; `null` is a real decline).
// `end` with no complete reply line is a drop (the daemon closed mid-block) — a status
// line alone does not make a response, so the reconnect loop still resends.
function parseAskStream(raw: string, how: "end" | "dropped" | "timeout"): AskAttempt {
  const statuses: AskStatusLine[] = []
  let reply: string | null | undefined
  for (const line of raw.split("\n").slice(0, -1)) {
    const status = parseAskStatus(line)
    if (status) statuses.push(status)
    else reply = line.trim() || null
  }
  if (how !== "end") return { kind: how, raw: null, statuses }
  if (reply === undefined) return { kind: "dropped", raw: null, statuses }
  return { kind: "response", raw: reply, statuses }
}

// `tg-ctl ask --verify-grant <approval_id> --hook <hook_id>` (TOKEN path) or
// `tg-ctl ask --verify-grant --pull --hook <hook_id>` (PULL path) — the grant
// consume client (contract §5 + pull-model, tg-cli#398). stdin carries the
// normalized payload (with the recomputed `operation`); the daemon answers
// immediately. Modeled on hookAgentFromArgv's argv-scan style.
interface VerifyGrantArgv {
  approvalId?: string
  pull: boolean
  hookId?: string
}
function verifyGrantArgvFrom(args: string[]): VerifyGrantArgv | null {
  const i = args.indexOf("--verify-grant")
  if (i < 0) return null
  const out: VerifyGrantArgv = { pull: args.includes("--pull") }
  const maybeId = args[i + 1]
  if (maybeId && !maybeId.startsWith("--")) out.approvalId = maybeId
  const h = args.indexOf("--hook")
  const hookId = h >= 0 ? args[h + 1] : undefined
  if (hookId && !hookId.startsWith("--")) out.hookId = hookId
  return out
}

// The verify-grant round-trip: one short socket exchange (the daemon answers
// immediately — no human in the loop — so 30s is a generous ceiling), then
// print the daemon's reply JSON VERBATIM on stdout. Exit 0 ALWAYS; the outcome
// rides stderr. Fail CLOSED on any transport failure (daemon down, old daemon
// that drops the unknown marker with `null`, timeout): a deny envelope on
// stdout so the calling hook blocks the operation — never an empty stdout that
// a lenient caller could misread as "no objection".
async function verifyGrantDaemon(ctx: Ctx, argv: VerifyGrantArgv, stdinPayload: unknown): Promise<void> {
  const denyUnreachable = (why: string): void => {
    log(`verify-grant failed-closed: ${why}`)
    console.log(
      JSON.stringify({
        requestId: null,
        hookSpecificOutput: {
          hookEventName: "PermissionRequest",
          decision: { behavior: "deny", message: `tg-ctl grant verification failed closed: ${why}` },
        },
      }),
    )
  }
  if (!argv.hookId || (!argv.pull && !argv.approvalId)) {
    denyUnreachable("malformed invocation — need --hook <hook_id> and either --verify-grant <approval_id> or --verify-grant --pull")
    return
  }
  const line = JSON.stringify({
    tgctl: "verify-grant",
    hookId: argv.hookId,
    ...(argv.pull ? { pull: true } : { approvalId: argv.approvalId }),
    payload: stdinPayload ?? null,
  })
  const attempt = await oneAskAttempt(ctx, line, 30_000)
  if (attempt.kind === "response" && attempt.raw && attempt.raw !== "null") {
    console.log(attempt.raw)
    // Outcome on stderr (contract §5: exit 0 always, verdict rides stderr) —
    // the human/lib reading the terminal sees WHY alongside the stdout JSON.
    try {
      const parsed = JSON.parse(attempt.raw) as { approvalId?: string; requestId?: string | null }
      log(
        parsed.approvalId
          ? `grant consumed: approvalId=${parsed.approvalId} requestId=${parsed.requestId ?? "-"}`
          : `grant denied: requestId=${parsed.requestId ?? "-"}`,
      )
    } catch {
      log(`grant verify reply (unparsable): ${attempt.raw}`)
    }
    return
  }
  // An OLD daemon doesn't know the marker: it drops the line as
  // unparsable-payload and replies `null` — fail closed (the correct
  // self-healing behavior; the lib surfaces this as a deny).
  denyUnreachable(
    attempt.kind === "response"
      ? "daemon declined the verify-grant request (older daemon without grant support)"
      : `daemon unreachable (${attempt.kind})`,
  )
}

// Overall hook budget. Kept UNDER the 120s the harness gives the hook process so the
// reconnect loop returns a real answer (or null) before the harness kills it. Skipped
// entirely for a CRITICAL ask (tg-cli#403) — see askDaemon's deadline computation.
// Env-overridable ONLY for tests to prove the non-critical/critical contrast without a
// real 115s wait (mirrors UNSCOPED_ABANDON_MS's own clamp: setTimeout silently clamps
// any delay > 2^31-1 ms to ~1ms, so an oversized override is clamped rather than
// flipping into an immediate false timeout); production never sets it.
const ASK_TOTAL_TIMEOUT_MS = (() => {
  const raw = Number(process.env.TG_CTL_ASK_TOTAL_TIMEOUT_MS)
  const TIMEOUT_MAX = 2_147_483_647
  return Number.isFinite(raw) && raw > 0 ? Math.min(raw, TIMEOUT_MAX) : 115_000
})()
// Backoff between reconnect attempts. Also lets a LIVE daemon's socket-close handler
// run (moving the entry to `abandoned`) BEFORE the resend lands, so the resend
// re-attaches instead of racing the in-flight dedup.
const ASK_RECONNECT_BACKOFF_MS = 250

function oneAskAttempt(ctx: Ctx, requestLine: string, timeoutMs: number): Promise<AskAttempt> {
  return new Promise<AskAttempt>((resolve) => {
    let done = false
    let raw = ""
    let timer: ReturnType<typeof setTimeout> | undefined
    const finish = (how: "end" | "dropped" | "timeout"): void => {
      if (done) return
      done = true
      clearTimeout(timer)
      resolve(parseAskStream(raw, how))
    }
    const socket = createConnection(ctx.paths.socket)
    // tg-cli#403 CRITICAL LANDMINE: `timeoutMs` is `Infinity` for a critical ask
    // (askDaemon's deadline is Infinity, and Date.now() subtracted from Infinity
    // is still Infinity). Node/Bun's setTimeout silently CLAMPS any delay beyond
    // 2^31-1 ms (32-bit signed overflow) to ~1ms and fires almost immediately —
    // passing Infinity straight to setTimeout would flip "wait forever" into "time
    // out instantly", the EXACT OPPOSITE of critical mode's intent. Skip scheduling
    // the timer entirely when the delay isn't finite; the promise then resolves
    // purely from the socket's own data/end/error/close events, with no deadline
    // to race against at all — the "skip scheduling" fix this ticket explicitly
    // prescribes over clamping, since clamping still needs SOME real bound to
    // clamp TO, which a genuinely unbounded critical wait doesn't have.
    timer = Number.isFinite(timeoutMs)
      ? setTimeout(() => {
          socket.destroy()
          finish("timeout")
        }, timeoutMs)
      : undefined
    socket.setEncoding("utf8")
    socket.on("connect", () => socket.write(requestLine + "\n"))
    socket.on("data", (chunk) => {
      raw += chunk
    })
    socket.on("error", () => finish("dropped"))
    // A complete reply always ends in a newline (the daemon's socket.end(`${out}\n`));
    // EOF with no complete reply line means the daemon closed without answering → a drop
    // to retry (parseAskStream decides, so an interim status line alone is not a reply).
    socket.on("end", () => finish("end"))
    socket.on("close", () => finish("dropped"))
  })
}

// Reconnect-and-resend the SAME requestId across a mid-block socket drop (lossless
// restart): a SCOPED question whose daemon restarted (crash-relaunch in ~1s, or a
// deliberate stop+start) keeps trying until the restored daemon answers — it either
// re-attaches the still-pending entry (no duplicate card) or replays the stored
// answer. Bounded by the caller's deadline (shared across a multi-question
// sequence); a real "null" decline returns immediately.
async function requestHookAnswerWithReconnect(ctx: Ctx, requestLine: string, deadline: number): Promise<AskAttempt> {
  let announcedDrop = false
  let last: AskAttempt = { kind: "timeout", raw: null, statuses: [] }
  for (;;) {
    const remaining = deadline - Date.now()
    if (remaining <= 0) return last
    const res = await oneAskAttempt(ctx, requestLine, remaining)
    if (res.kind !== "dropped") return { ...res, statuses: [...last.statuses, ...res.statuses] }
    // ACCUMULATE, never replace (review finding, x2 independent reviewers): a `posted`
    // status learned on an earlier attempt (daemon posted the card, then crashed
    // mid-wait) must survive every later attempt that cannot even connect
    // (`statuses: []` on ECONNREFUSED) — otherwise the deadline verdict below loses
    // the one fact that proves the card is genuinely live in Telegram, reintroducing
    // this file's own incident as "unreachable" for a card that was posted.
    last = { ...res, statuses: [...last.statuses, ...res.statuses] }
    if (!announcedDrop) {
      log("ask reconnect: daemon socket dropped — resending requestId until it comes back")
      announcedDrop = true
    }
    const backoff = Math.min(ASK_RECONNECT_BACKOFF_MS, Math.max(0, deadline - Date.now()))
    if (backoff > 0) await new Promise((r) => setTimeout(r, backoff))
  }
}

// One daemon round-trip for one ButtonRequest, within the caller's deadline.
// SCOPED questions and SCOPED permissions reconnect-and-resend across a daemon
// restart: both are retained on socket close (abandoned map + persist), so a
// resend re-attaches to the existing card rather than posting a duplicate.
// UNSCOPED requests keep the single-attempt path — they aren't retained (no
// pane to late-deliver to), so a resend after a restart would post a duplicate
// card.
async function askDaemonOnce(ctx: Ctx, req: ButtonRequest, deadline: number): Promise<AskAttempt> {
  const requestLine = JSON.stringify(req)
  const reconnectable = Boolean(req.paneId) && (req.kind === "question" || req.kind === "permission")
  if (reconnectable) return requestHookAnswerWithReconnect(ctx, requestLine, deadline)
  const remaining = deadline - Date.now()
  if (remaining <= 0) return { kind: "timeout", raw: null, statuses: [] }
  return oneAskAttempt(ctx, requestLine, remaining)
}

type PostedStatus = Extract<AskStatusLine, { state: "posted" }>
type DroppedStatus = Extract<AskStatusLine, { state: "dropped" }>
type ExpiredStatus = Extract<AskStatusLine, { state: "expired" }>

// The truthful client-side verdict for a request that produced no usable reply
// (tg-cli#317). The asking agent reads this line — the agent-tools hatch helper forwards
// hook stderr into its deny reason — so it must say what the daemon actually did: a card
// that WAS posted is never reported as "not-posted", and a daemon expiry is an expiry.
function describeAskOutcome(req: ButtonRequest, attempt: AskAttempt): string {
  const who = `req=${req.requestId} agent=${req.agent} pane=${req.paneId ?? "-"}`
  const posted = attempt.statuses.find((s): s is PostedStatus => s.state === "posted")
  const dropped = attempt.statuses.find((s): s is DroppedStatus => s.state === "dropped")
  const expired = attempt.statuses.find((s): s is ExpiredStatus => s.state === "expired")
  // A reconnect that lands AFTER the human already tapped the card is answered —
  // the daemon delivered the decision via pane injection (no live socket to answer
  // on) and drops this stale resend with reason=already-pane-delivered (review
  // finding: checked ahead of the generic `posted` branch below, which would
  // otherwise report a real decision as "the daemon closed with no decision" —
  // the exact class of false claim this file exists to eliminate).
  if (dropped?.reason === "already-pane-delivered") {
    return `ask-forward answered-via-pane: ${who} messageId=${posted?.messageId ?? "-"} — the human already answered this card; delivered directly to the pane, not through this hook`
  }
  if (expired) {
    // The unscoped-abandon timer is armed BEFORE `sendMessage` resolves (review
    // finding): if Telegram is slow and the timer fires first, `expired.messageId`
    // is still null — no card was ever posted, and asserting "posted to Telegram"
    // would be exactly the false claim tg-cli#317 exists to eliminate.
    const where = expired.messageId !== null ? "posted to Telegram" : "the send to Telegram had not completed"
    return `ask-forward expired: ${who} messageId=${expired.messageId ?? "-"} — ${where}; no decision within ${expired.ageMs}ms (daemon expiry, nobody tapped)`
  }
  if (posted && attempt.kind === "timeout") {
    return `ask-forward timed-out: ${who} messageId=${posted.messageId} — posted to Telegram; no decision within this hook's ${clampRequestTimeoutMs(req.timeoutMs, ASK_TOTAL_TIMEOUT_MS)}ms budget (the card stays answerable for late delivery)`
  }
  if (posted) {
    // `attempt.kind` here is only ever "response" (an explicit `null` reply) or
    // "dropped" ("timeout" was handled above) — spell those out rather than
    // printing the bare internal enum (review finding: "(response)"/"(dropped)"
    // is jargon to whoever reads the hook/daemon log this line is meant for).
    const how = attempt.kind === "response" ? "explicit null reply" : "connection lost after posting"
    return `ask-forward declined-after-post: ${who} messageId=${posted.messageId} — posted to Telegram; the daemon closed with no decision (${how})`
  }
  if (dropped) return `ask-forward not-posted: ${who} — daemon declined: reason=${dropped.reason}`
  if (attempt.kind === "timeout") {
    return `ask-forward timed-out: ${who} — no reply and no status line from the daemon within ${clampRequestTimeoutMs(req.timeoutMs, ASK_TOTAL_TIMEOUT_MS)}ms`
  }
  if (attempt.kind === "dropped") return `ask-forward unreachable: ${who} — daemon socket closed or errored without a reply`
  return `ask-forward not-posted: ${who} — daemon declined or unreachable (no status line: a daemon older than tg-cli#317 cannot say which)`
}

async function askDaemon(ctx: Ctx): Promise<void> {
  const input = await readStdinText()
  if (!input.trim()) return
  let payload: unknown
  try {
    payload = JSON.parse(input)
  } catch {
    return
  }
  // Normalize the harness's raw hook payload (or an already-normalized request)
  // into ButtonRequests, filling routing fields from the hook process's own
  // env. A claude AskUserQuestion with 2-4 questions yields one request PER
  // question; everything else yields exactly one. null → unsupported shape;
  // emit nothing so the local agent UI takes over.
  //
  // `invocationNonce`: a random id generated ONCE per `tg-ctl ask` PROCESS —
  // the harness spawns a fresh process for EVERY tool/permission/question hook
  // event, so this is a true per-INVOCATION identity, stronger than (and not
  // dependent on) any field the harness itself may or may not send
  // (Claude Code's `prompt_id` / Codex's `turn_id` identify the whole prompt
  // TURN, not the individual tool call — two distinct tool invocations with
  // byte-identical input in the SAME turn would otherwise share a requestId;
  // review finding, tg#9982 follow-up). Threaded into every requestId hash
  // (hook-normalize.ts) and into ButtonRequest.promptTurnId, so a queued
  // permission decision's no-time-bound auto-delivery (see AGENTS.md's "Queued
  // permission decisions") is scoped to THIS exact invocation: the SAME
  // process's own reconnect-and-resend loop reuses this same requestLine/nonce
  // (requestHookAnswerWithReconnect resends the identical serialized `req`), so
  // a genuine reconnect still matches; a genuinely later invocation is always a
  // NEW process with a NEW nonce and can never collide.
  const env: HookEnv = {
    agent: hookAgentFromArgv(),
    paneId: process.env.TMUX_PANE || undefined,
    cwd: process.cwd(),
    sessionName: tmuxSessionName(),
    windowName: tmuxWindowName(),
    subagent: detectAgentLabel(process.env) || undefined,
    invocationNonce: crypto.randomUUID(),
  }
  const reqs = normalizeHookRequests(payload, env)
  if (!reqs) {
    // Unsupported payload shape (multi-select / free-form / an event we don't
    // forward). This never reaches the daemon, so the daemon log can't see it —
    // emit here (hook process stderr) so the drop isn't silent.
    log(`ask-forward dropped: reason=unsupported-payload agent=${env.agent} pane=${env.paneId ?? "-"} cwd=${env.cwd ?? "-"}`)
    return
  }
  // ONE deadline shared by the whole call (all cards of a multi-question), kept
  // under the harness's 120s hook budget so we always answer before it kills us.
  //
  // tg-cli#403: a CRITICAL request (never true for a multi-question set in
  // practice — critical is a hatch/permission-only opt-in) removes this bound
  // entirely. `Infinity` is a safe DEADLINE sentinel (never passed directly to
  // setTimeout): `Date.now() < Infinity` is always true, and `Infinity - x` stays
  // `Infinity` through every downstream subtraction (requestHookAnswerWithReconnect's
  // `remaining`, askDaemonOnce's `remaining`) — every one of THOSE call sites turns
  // its own "remaining" into an actual setTimeout delay only inside oneAskAttempt,
  // which explicitly skips scheduling when the delay isn't finite (see its own doc
  // comment on the 32-bit setTimeout overflow clamp this guards against).
  //
  // Contract §1 (tg-cli#398): for a non-critical request, a per-request
  // timeoutMs (the agent-tools lib sends 600000 for hatch asks) extends the
  // deadline instead, clamped to the 15-min cap; absent/invalid → the
  // unchanged 115s default. (A hatch ask carrying 600000 still answers EARLY
  // the moment a tap lands — the deadline is only the wait ceiling.)
  const deadline = reqs.some((r) => r.critical === true)
    ? Infinity
    : Date.now() + clampRequestTimeoutMs(reqs[0].timeoutMs, ASK_TOTAL_TIMEOUT_MS)

  if (reqs.length === 1) {
    const req = reqs[0]
    const attempt = await askDaemonOnce(ctx, req, deadline)
    const output = attempt.raw
    if (output && output !== "null") {
      // Repair a claude-question reply from a STALE RUNNING daemon that predates
      // `hookEventName` in the answer envelope (Claude Code discards the whole
      // hook output without it — tg#5741); anything else passes through verbatim.
      console.log(repairClaudeQuestionReply(req, output) ?? output)
    } else {
      // No usable reply: the harness UI takes over. Say exactly what happened — posted
      // then expired, dropped (with the daemon's reason), timed out, or unreachable —
      // because the asking agent acts on this line (tg-cli#317).
      log(describeAskOutcome(req, attempt))
    }
    return
  }

  // Multi-question (claude AskUserQuestion, 2-4 questions): one SEQUENTIAL card
  // per question — the next card posts only after the previous answer — then ONE
  // combined PreToolUse reply with the full answers record, so the tool completes
  // with no local dialog and no manual Enter (tg#5741). ALL-OR-NOTHING: any
  // decline/timeout emits nothing and the local UI re-asks everything (a partial
  // answers record would silently skip the unanswered questions).
  const answers = await collectQuestionAnswers(reqs, (r) => askDaemonOnce(ctx, r, deadline).then((a) => a.raw))
  const toolInput = reqs[0].toolInput
  if (answers && toolInput) {
    console.log(JSON.stringify(buildClaudeQuestionAnswerOutput(toolInput, answers)))
  } else {
    log(
      `ask-forward multi-question not-completed: req=${reqs[0].requestId} n=${reqs.length} pane=${reqs[0].paneId ?? "-"} — declined, timed out, or partial; local UI takes over`,
    )
  }
}

function codexConfigDir(home: string): string {
  const override = process.env.CODEX_HOME?.trim()
  return override ? override : join(home, ".codex")
}

async function readStdinText(): Promise<string> {
  return await new Promise((resolve, reject) => {
    let out = ""
    process.stdin.setEncoding("utf8")
    process.stdin.on("data", (chunk) => {
      out += chunk
    })
    process.stdin.on("end", () => resolve(out))
    process.stdin.on("error", reject)
  })
}

// --- /tasks command (#115): compose task-cli + gh into a rich board table ---

// The pane of the CTO's OWN last resolved inbound delivery (tg-cli#78 anchor
// fix) — shared by the daemon's discoverForInject (message routing) AND
// resolveTasksScopeDir below (`/tasks` default scoping), so both use the SAME
// anchor rather than `/tasks` falling back to the old `lastMessagePane` (any
// pane's last outbound send) after the routing path already moved on to this
// one (review finding: the two surfaces silently disagreeing on "the default
// target" is the exact class of bug tg-cli#78 fixed for inbound routing).
//
// Guards against tmux pane-ID reuse (mirrors routeMatchesPane's reply-route
// protection): a recognized paneId is trusted only if its recorded cwd still
// matches the LIVE candidate's path. A stale/mismatched anchor returns null
// rather than risk mis-routing into a different project that now happens to
// own that pane id.
function resolveLastUserTarget(ctx: Ctx, candidates: TargetPane[]): TargetPane | null {
  const anchor = parseLastUserTarget(readFileOrNull(ctx.paths.lastUserTarget))
  if (!anchor) return null
  const hit = candidates.find((c) => c.pane.paneId === anchor.paneId)
  if (!hit) return null
  return routeMatchesPane({ recognizedCwd: anchor.cwd, panePath: hit.pane.panePath }) ? hit : null
}

// Same anchor lookup as resolveLastUserTarget, but against the merged
// tmux+omp AgentCandidate view (listAgentCandidates()) instead of the
// tmux-only TargetPane view — used by injectViaTarget's no-tmux-pane
// fallback so the tg-cli#78 anchor also covers out-of-tmux omp agents
// (tg-cli#369).
function resolveLastUserTargetCandidate(ctx: Ctx, candidates: AgentCandidate[]): AgentCandidate | null {
  const anchor = parseLastUserTarget(readFileOrNull(ctx.paths.lastUserTarget))
  if (!anchor) return null
  const hit = candidates.find((c) => c.paneId === anchor.paneId)
  if (!hit) return null
  return routeMatchesPane({ recognizedCwd: anchor.cwd, panePath: hit.panePath }) ? hit : null
}

// Resolve a `/tasks [<agent>]` selector to the relevant project dir. With no
// selector, replies target the replied-to agent, otherwise the command uses the
// same default target the daemon would route an inbound message to. Ambiguous
// fleets without a reply/last-message signal fail explicitly instead of guessing.
function resolveTasksScopeDir(ctx: Ctx, action: Pick<Extract<Action, { kind: "tasks" }>, "agent" | "replyToMessageId" | "threadId">): string | null {
  const regs = readRegistrations(ctx.paths)
  if (action.agent) {
    const m = matchWindows(action.agent, listAgentCandidates())
    if (!m.confident) return null
    const pane = m.matches[0]
    return pane?.panePath || (pane ? registeredCwdForPane(regs, pane) : null)
  }
  if (action.threadId !== null && action.threadId !== undefined) {
    const topic = findTopic(parseTopics(readFileOrNull(ctx.paths.topics)), action.threadId)
    return topic?.path ?? null
  }
  const routes = parseRoutes(readFileOrNull(ctx.paths.routes))
  if (action.replyToMessageId !== null) {
    const recognized = recognizeRoute(routes, action.replyToMessageId)
    if (recognized?.cwd) return recognized.cwd
  }
  // Ambiguous fleet, no reply/thread anchor: use the SAME default-target anchor
  // the daemon's inbound routing uses (tg-cli#78) rather than the old
  // `lastMessagePane` (whoever spoke last, routes.json) — the two surfaces
  // silently disagreeing on "the default target" was the review finding this
  // replaces. No further fallback: an unresolved anchor stays ambiguous here
  // too, exactly mirroring discoverForInject's own picker fallback.
  const target = discoverTarget(ctx)
  let routed: DiscoverResult = target
  if (!target.ok && target.reason === "ambiguous") {
    const anchor = resolveLastUserTarget(ctx, target.candidates)
    if (anchor) routed = { ok: true, target: anchor }
  }
  if (routed.ok) return routed.target.pane.panePath || registeredCwdForPane(regs, routed.target.pane)
  if (routed.reason === "no-agent") return singleRegisteredCwd(regs)
  return null
}

async function loadTasks(scopeDir: string | null, status: string | null, includeUnfiltered: boolean): Promise<TaskItem[]> {
  if (status) return loadTaskList(scopeDir, status)
  // task-cli scoped JSON does not provide a reliable "all lifecycle states" view, so the board fans out by canonical state.
  // The explicit All view also merges an unfiltered call so custom states stay visible when task-cli reports them.
  const states: Array<string | null> = includeUnfiltered ? [null, ...TASK_STATES] : [...TASK_STATES]
  const lists = await Promise.all(states.map((state) => loadTaskList(scopeDir, state)))
  const out: TaskItem[] = []
  const seen = new Set<string>()
  for (const task of lists.flat()) {
    const key = taskKey(task)
    if (seen.has(key)) continue
    seen.add(key)
    out.push(task)
  }
  return out
}

async function loadTaskList(scopeDir: string | null, status: string | null): Promise<TaskItem[]> {
  const argv = ["task", "list", "--json", "--no-pager", "-n", "100"]
  if (status) argv.push("--state", status)
  if (scopeDir) argv.push("-C", scopeDir)
  const r = await spawnGuarded(argv, 15_000)
  if (r.exitCode !== 0) {
    log(`/tasks: 'task list' failed (${r.exitCode}): ${r.stderr.slice(0, 200)}`)
    return []
  }
  try {
    const parsed = JSON.parse(r.stdout)
    return flattenTaskListJson(parsed)
  } catch {
    return []
  }
}

function flattenTaskListJson(parsed: unknown): TaskItem[] {
  if (!Array.isArray(parsed)) return []
  const out: TaskItem[] = []
  for (const item of parsed) {
    if (!item || typeof item !== "object") continue
    const rec = item as { id?: unknown; project?: unknown; tickets?: unknown }
    if (typeof rec.id === "string") {
      out.push({ ...(item as TaskItem), project: typeof rec.project === "string" ? rec.project : undefined })
      continue
    }
    if (typeof rec.project !== "string" || !Array.isArray(rec.tickets)) continue
    for (const ticket of rec.tickets) {
      if (!ticket || typeof ticket !== "object" || typeof (ticket as { id?: unknown }).id !== "string") continue
      out.push({ ...(ticket as TaskItem), project: rec.project })
    }
  }
  return out
}

async function loadPrRefs(scopeDir: string | null): Promise<PrRef[]> {
  const argv = ["gh", "pr", "list", "--state", "all", "--limit", "100", "--json", "number,title,url,body,statusCheckRollup,reviewDecision,isDraft"]
  const r = await spawnGuarded(argv, 20_000, scopeDir ? { cwd: scopeDir } : {})
  if (r.exitCode !== 0) {
    log(`/tasks: 'gh pr list' failed (${r.exitCode}): ${r.stderr.slice(0, 200)}`)
    return []
  }
  try {
    const parsed = JSON.parse(r.stdout)
    if (!Array.isArray(parsed)) return []
    return parsed
      .filter((p) => p && typeof p.number === "number")
      .map((p) => {
        const url = typeof p.url === "string" ? p.url : ""
        return {
          number: p.number,
          url,
          title: p.title ?? "",
          body: p.body ?? "",
          ci: rollupCiState(p.statusCheckRollup),
          review: rollupReviewState(p.reviewDecision, p.isDraft),
          project: projectFromPrUrl(url),
        }
      })
  } catch {
    return []
  }
}

function projectFromPrUrl(rawUrl: string): string | undefined {
  try {
    const url = new URL(rawUrl)
    const parts = url.pathname.split("/").filter(Boolean)
    const pullIndex = parts.indexOf("pull")
    if (pullIndex < 2) return undefined
    return `${parts[pullIndex - 2]}/${parts[pullIndex - 1]}`
  } catch {
    return undefined
  }
}

interface TaskBoardState {
  scopeDir: string | null
  agent: string | null
  status: string | null
  threadId: number | null
}

// Best-effort in-memory callback scope; a daemon restart intentionally expires old /tasks boards.
const taskBoardStates = new Map<string, TaskBoardState>()
const MAX_TASK_BOARD_STATES = 50

function taskBoardStateKey(chatId: number | string, messageId: number): string {
  return `${chatId}:${messageId}`
}

function rememberTaskBoardState(chatId: number | string, messageId: number | null, state: TaskBoardState): void {
  if (messageId === null) return
  const key = taskBoardStateKey(chatId, messageId)
  taskBoardStates.delete(key)
  taskBoardStates.set(key, state)
  while (taskBoardStates.size > MAX_TASK_BOARD_STATES) {
    const first = taskBoardStates.keys().next().value
    if (typeof first !== "string") break
    taskBoardStates.delete(first)
  }
}

async function runTasksCommand(ctx: Ctx, action: Extract<Action, { kind: "tasks" }>): Promise<void> {
  const prior = priorTaskBoardState(ctx, action)
  if (action.callbackQueryId && !prior) {
    await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
    return
  }
  if (action.callbackQueryId) await answerCallbackQuery(ctx, action.callbackQueryId, "updating")
  const scopeDir = prior ? prior.scopeDir : resolveTasksScopeDir(ctx, action)
  const agent = prior ? prior.agent : action.agent
  const status = taskBoardStatusForAction(action, prior)
  const threadId = prior ? prior.threadId : action.threadId ?? null
  const messageContext: { message_thread_id?: number; reply_parameters?: { message_id: number } } = {}
  if (threadId !== null) messageContext.message_thread_id = threadId
  if (!action.callbackQueryId && action.replyToMessageId !== null) messageContext.reply_parameters = { message_id: action.replyToMessageId }
  if (!scopeDir && !action.callbackQueryId) {
    const suffix = agent ? ` for /tasks ${agent}` : " for /tasks"
    await sendMessage(ctx, `couldn't resolve a project${suffix} — reply to an agent message or use /tasks <agent>`, messageContext)
    return
  }
  const viewOptions = tasksViewOptions(action, status)
  const [tasks, prs] = await Promise.all([loadTasks(scopeDir, status, viewOptions.view === "all" && status === null), scopeDir ? loadPrRefs(scopeDir) : Promise.resolve([])])
  const prsByTask = matchPrsToTasks(tasks, prs)
  const view = composeTasksView(annotateTasksWithAgents(tasks, agent), prsByTask, { agent, status }, viewOptions)
  const sent = await sendRich(ctx, view.html, { ...messageContext, reply_markup: view.reply_markup })
  rememberTaskBoardState(ctx.chatId, sent, { scopeDir, agent, status, threadId })
  if (sent === null) await sendMessage(ctx, "couldn't render the task board — see the daemon log", messageContext)
}

function priorTaskBoardState(ctx: Ctx, action: Extract<Action, { kind: "tasks" }>): TaskBoardState | undefined {
  if (!action.callbackQueryId || action.messageId == null) return undefined
  if (action.chatId == null || String(action.chatId) !== String(ctx.chatId)) return undefined
  return taskBoardStates.get(taskBoardStateKey(action.chatId, action.messageId))
}

function taskBoardStatusForAction(action: Extract<Action, { kind: "tasks" }>, prior: TaskBoardState | undefined): string | null {
  if (!prior) return action.status
  // Filter taps switch back to the full lifecycle view, dropping any prior /tasks <status> scope.
  return action.callbackKind === "filter" ? null : prior.status
}

function tasksViewOptions(action: Extract<Action, { kind: "tasks" }>, status: string | null): { view: TaskViewFilter; page: number; pageSize: number; label?: string } {
  const view = isTaskViewFilter(action.view) ? action.view : status ? "all" : DEFAULT_TASK_VIEW
  return { view, page: action.page ?? 0, pageSize: TASKS_PAGE_SIZE, label: status ? taskStatusViewLabel(status) : undefined }
}

function taskStatusViewLabel(status: string): string {
  switch (status) {
    case "done":
      return "Done"
    case "in-progress":
    case "in-review":
      return "Active"
    case "todo":
      return "Ready"
    case "cancelled":
      return "Cancelled"
    default:
      return status
        .split(/[-_\s]+/)
        .filter(Boolean)
        .map((part) => `${part.slice(0, 1).toUpperCase()}${part.slice(1)}`)
        .join(" ")
  }
}

function annotateTasksWithAgents(tasks: TaskItem[], fallbackAgent: string | null): TaskItem[] {
  const candidates = listAgentCandidates()
  return tasks.map((task) => {
    const agent = task.agent || fallbackAgent || agentForTaskProject(task, candidates)
    return agent ? { ...task, agent } : task
  })
}

function agentForTaskProject(task: TaskItem, candidates: AgentCandidate[]): string | null {
  const short = task.project ? shortProjectName(task.project) : null
  if (!short) return null
  const matches = candidates.filter((candidate): candidate is AgentCandidate & { panePath: string } => Boolean(candidate.panePath) && basename(candidate.panePath) === short)
  if (matches.length !== 1) return null
  const match = matches[0]
  return isBareWindowName(match.windowName) ? basename(match.panePath) : match.windowName
}

// --- harness-event subcommand (#113): notify on a StopFailure hook ---

interface HarnessEventFlags {
  dryRun: boolean
  paneId: string | null
  agent: string | null
  windowName: string | null
  reason: string | null
  resetAtIso: string | null
  sourceMessageId: number | null
  transcriptPath: string | null
  language: string | null
}

function parseHarnessEventFlags(argv: string[]): HarnessEventFlags {
  const flags: HarnessEventFlags = {
    dryRun: false,
    paneId: process.env.TMUX_PANE ?? null,
    agent: null,
    windowName: null,
    reason: null,
    resetAtIso: null,
    sourceMessageId: null,
    transcriptPath: null,
    language: null,
  }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    const next = (): string => argv[++i] ?? ""
    if (a === "--dry-run") flags.dryRun = true
    else if (a === "--pane") flags.paneId = next()
    else if (a === "--agent") flags.agent = next()
    else if (a === "--window-name") flags.windowName = next()
    else if (a === "--reason") flags.reason = next()
    else if (a === "--reset-at") flags.resetAtIso = next()
    else if (a === "--source-message-id") flags.sourceMessageId = Number(next()) || null
    else if (a === "--transcript") flags.transcriptPath = next()
    else if (a === "--language" || a === "--lang" || a === "--locale") flags.language = next()
  }
  return flags
}

function strField(obj: unknown, key: string): string {
  const v = obj && typeof obj === "object" ? (obj as Record<string, unknown>)[key] : undefined
  return typeof v === "string" ? v : ""
}

const USAGE_WARNING_COOLDOWN_MS = 60 * 60_000
const USAGE_WARNING_STORE_MAX = 100
const USAGE_LATEST_NO_RESET_MAX_AGE_MS = 24 * 60 * 60_000

interface UsageWarningRecord {
  key: string
  lastSentAt: number
  resetAt: number | null
}

interface UsageLatestRecord {
  agent: string
  limitName: string | null
  percent: number
  resetAt: number | null
  language: string
  detail: string
  sampledAt: number
}

interface OverloadRetryRecord {
  key: string
  attempt: number
  pid: number | null
  lastFailureAt: number
  nextAt: number
}

const OVERLOAD_RETRY_RESET_MS = 30 * 60_000
const OVERLOAD_RETRY_STORE_MAX = 100
const OVERLOAD_AUTO_CONTINUE_MAX_ATTEMPTS = 8
const OVERLOAD_RETRY_LOCK_ATTEMPTS = 200
const OVERLOAD_RETRY_LOCK_DELAY_MS = 10

function usageWarningKey(ev: UsageLimitEvent): string {
  return JSON.stringify([ev.agent, ev.limitName ?? ""])
}

function usageWarningLockPath(path: string): string {
  return `${path}.lock`
}

function usageLatestKey(rec: Pick<UsageLatestRecord, "agent" | "limitName">): string {
  return JSON.stringify([rec.agent, rec.limitName ?? ""])
}

function usageLatestLockPath(path: string): string {
  return `${path}.lock`
}

function overloadRetryLockPath(path: string): string {
  return `${path}.lock`
}

function overloadRetryKey(ev: HarnessFailureEvent, windowName: string): string {
  return JSON.stringify([ev.paneId ?? "", ev.sessionId ?? "", windowName])
}

function overloadRetryScope(key: string): { paneId: string; windowName: string } | null {
  try {
    const parsed = JSON.parse(key) as unknown
    if (!Array.isArray(parsed)) return null
    if (parsed.length >= 3 && typeof parsed[0] === "string" && typeof parsed[2] === "string") {
      return { paneId: parsed[0], windowName: parsed[2] }
    }
    if (parsed.length === 2 && typeof parsed[0] === "string" && typeof parsed[1] === "string") {
      return { paneId: parsed[0], windowName: parsed[1] }
    }
  } catch {
    return null
  }
  return null
}

function overloadRetrySameScope(rec: OverloadRetryRecord, paneId: string, windowName: string): boolean {
  const scope = overloadRetryScope(rec.key)
  return scope !== null && scope.paneId === paneId && scope.windowName === windowName
}

function parseUsageLatestRecordsRaw(blob: string | null): UsageLatestRecord[] {
  if (!blob) return []
  try {
    const parsed = JSON.parse(blob) as { samples?: unknown }
    if (!Array.isArray(parsed.samples)) return []
    return parsed.samples
      .filter((item): item is UsageLatestRecord => {
        if (!item || typeof item !== "object") return false
        const rec = item as Record<string, unknown>
        const resetAt = rec.resetAt
        return (
          typeof rec.agent === "string" &&
          (rec.limitName === null || typeof rec.limitName === "string") &&
          typeof rec.percent === "number" &&
          Number.isFinite(rec.percent) &&
          rec.percent >= 0 &&
          rec.percent <= 100 &&
          (resetAt === null || (typeof resetAt === "number" && Number.isFinite(resetAt) && resetAt > 0)) &&
          typeof rec.language === "string" &&
          typeof rec.detail === "string" &&
          typeof rec.sampledAt === "number" &&
          Number.isFinite(rec.sampledAt) &&
          rec.sampledAt > 0
        )
      })
  } catch {
    return []
  }
}

function parseUsageLatestRecords(blob: string | null, now: number): UsageLatestRecord[] {
  return parseUsageLatestRecordsRaw(blob)
    .filter((rec) => (rec.resetAt !== null ? rec.resetAt > now : rec.sampledAt > now - USAGE_LATEST_NO_RESET_MAX_AGE_MS))
}

function parseOverloadRetryRecords(blob: string | null, now: number): OverloadRetryRecord[] {
  if (!blob) return []
  try {
    const parsed = JSON.parse(blob) as { retries?: unknown }
    if (!Array.isArray(parsed.retries)) return []
    const records: OverloadRetryRecord[] = []
    for (const item of parsed.retries) {
      if (!item || typeof item !== "object") continue
      const rec = item as Record<string, unknown>
      const pid = rec.pid
      if (
        typeof rec.key !== "string" ||
        typeof rec.attempt !== "number" ||
        !Number.isInteger(rec.attempt) ||
        rec.attempt <= 0 ||
        typeof rec.lastFailureAt !== "number" ||
        !Number.isFinite(rec.lastFailureAt) ||
        rec.lastFailureAt <= 0 ||
        typeof rec.nextAt !== "number" ||
        !Number.isFinite(rec.nextAt) ||
        rec.nextAt <= 0 ||
        !(pid === undefined || pid === null || (typeof pid === "number" && Number.isInteger(pid) && pid > 0))
      ) {
        continue
      }
      records.push({
        key: rec.key,
        attempt: rec.attempt,
        pid: typeof pid === "number" ? pid : null,
        lastFailureAt: rec.lastFailureAt,
        nextAt: rec.nextAt,
      })
    }
    return records
      .filter((rec) => rec.lastFailureAt > now - 24 * OVERLOAD_RETRY_RESET_MS)
      .slice(-OVERLOAD_RETRY_STORE_MAX)
  } catch {
    return []
  }
}

function writeOverloadRetryRecords(path: string, records: OverloadRetryRecord[]): void {
  atomicWrite(path, `${JSON.stringify({ version: 1, retries: records.slice(-OVERLOAD_RETRY_STORE_MAX) })}\n`)
}

function runtimeOverloadAutoContinueDelayMs(delayMs: number): number {
  const raw = Number(process.env.TG_CTL_OVERLOAD_AUTO_CONTINUE_TEST_DELAY_MS)
  if (Number.isFinite(raw) && raw >= 1000) return raw
  return delayMs
}

function overloadRetryChildAlive(rec: OverloadRetryRecord): boolean {
  if (rec.pid === null) return false
  const match = overloadRetryChildMatchState(rec.pid, rec.key)
  return match === true || match === null
}

function terminateSpawnedRetry(pid: number): void {
  try {
    process.kill(pid, "SIGTERM")
  } catch {
    /* best effort: the child may already have exited */
  }
}

function overloadRetryChildMatches(pid: number, retryKey: string): boolean {
  return overloadRetryChildMatchState(pid, retryKey) === true
}

function overloadRetryChildMatchState(pid: number, retryKey: string): boolean | null {
  if (!kill0(pid)) return false
  const proc = Bun.spawnSync(["ps", "-ww", "-p", String(pid), "-o", "command="], { stdout: "pipe", stderr: "ignore" })
  if (proc.exitCode !== 0) return null
  const command = new TextDecoder().decode(proc.stdout).trim()
  return command.includes("auto-continue-once") && command.includes("--retry-key") && command.includes(retryKey)
}

function finishOverloadRetryRecord(records: OverloadRetryRecord[], retryKey: string, pid: number, now: number): OverloadRetryRecord[] {
  return records.map((rec) => (rec.key === retryKey && rec.pid === pid ? { ...rec, pid: null, nextAt: now } : rec))
}

function claimOverloadAutoContinue(
  ctx: Ctx,
  ev: HarnessFailureEvent,
  now: number,
  language: string | null,
  windowName: string | null,
): TransientAutoContinuePlan | null {
  if (!ev.paneId || !windowName) return null
  const paneId = ev.paneId
  try {
    const claimed = withRoutesLock(
      fsRoutesLockIo(overloadRetryLockPath(ctx.paths.overloadRetries)),
      () => {
        const key = overloadRetryKey(ev, windowName)
        const records = parseOverloadRetryRecords(readFileOrNull(ctx.paths.overloadRetries), now)
        const prev = records.find((rec) => rec.key === key)
        if (prev && prev.nextAt > now && overloadRetryChildAlive(prev)) return null
        const rearmingLostChild = Boolean(prev && prev.nextAt > now)
        if (!rearmingLostChild && prev && prev.lastFailureAt > now - OVERLOAD_RETRY_RESET_MS && prev.attempt >= OVERLOAD_AUTO_CONTINUE_MAX_ATTEMPTS) {
          return null
        }
        const attempt = rearmingLostChild && prev
          ? prev.attempt
          : prev && prev.lastFailureAt > now - OVERLOAD_RETRY_RESET_MS
            ? prev.attempt + 1
            : 1
        const built = buildTransientAutoContinue(ev, { attempt, language })
        if (!built) return null
        const plan = { ...built, delayMs: runtimeOverloadAutoContinueDelayMs(built.delayMs) }
        const spawned = spawnDelayedAutoContinue(ctx, ev, plan, windowName, key)
        if (!spawned) return null
        const replaced = records.filter((rec) => overloadRetrySameScope(rec, paneId, windowName))
        const next = records.filter((rec) => !overloadRetrySameScope(rec, paneId, windowName))
        next.push({
          key,
          attempt,
          pid: spawned.pid,
          lastFailureAt: now,
          nextAt: now + plan.delayMs,
        })
        try {
          writeOverloadRetryRecords(ctx.paths.overloadRetries, next)
        } catch (err) {
          terminateSpawnedRetry(spawned.pid)
          throw err
        }
        for (const rec of replaced) {
          if (rec.pid !== null && rec.pid !== spawned.pid && overloadRetryChildMatches(rec.pid, rec.key)) terminateSpawnedRetry(rec.pid)
        }
        return plan
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
    return claimed ?? null
  } catch (err) {
    log(`harness-event: overload auto-continue claim failed: ${err}`)
    return null
  }
}

function writeUsageLatestRecords(path: string, records: UsageLatestRecord[]): void {
  atomicWrite(path, `${JSON.stringify({ version: 1, samples: records })}\n`)
}

function recordUsageLatest(path: string, events: UsageLimitEvent[], now: number): void {
  if (events.length === 0) return
  try {
    withRoutesLock(
      fsRoutesLockIo(usageLatestLockPath(path)),
      () => {
        const byKey = new Map<string, UsageLatestRecord>()
        for (const rec of parseUsageLatestRecords(readFileOrNull(path), now)) byKey.set(usageLatestKey(rec), rec)
        for (const ev of events) {
          const rec: UsageLatestRecord = {
            agent: ev.agent,
            limitName: ev.limitName,
            percent: ev.percent,
            resetAt: ev.resetAt,
            language: ev.language,
            detail: ev.detail,
            sampledAt: now,
          }
          byKey.set(usageLatestKey(rec), rec)
        }
        writeUsageLatestRecords(path, [...byKey.values()].sort(compareUsageLatestRecords))
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
  } catch (err) {
    log(`harness-event: usage latest store failed: ${err}`)
  }
}

function latestRecentUsageLatest(path: string, agent: string, now: number): UsageLatestRecord | null {
  const normalized = agent.trim().toLowerCase()
  return parseUsageLatestRecords(readFileOrNull(path), now)
    .filter((rec) => rec.agent.toLowerCase() === normalized)
    .sort((a, b) => b.sampledAt - a.sampledAt || b.percent - a.percent)[0] ?? null
}

function latestAnyUsageLatest(path: string, agent: string): UsageLatestRecord | null {
  const normalized = agent.trim().toLowerCase()
  return parseUsageLatestRecordsRaw(readFileOrNull(path))
    .filter((rec) => rec.agent.toLowerCase() === normalized)
    .sort((a, b) => b.sampledAt - a.sampledAt || b.percent - a.percent)[0] ?? null
}

function compareUsageLatestRecords(a: UsageLatestRecord, b: UsageLatestRecord): number {
  const agent = a.agent.localeCompare(b.agent)
  if (agent !== 0) return agent
  return usageLimitRank(a.limitName) - usageLimitRank(b.limitName) || (a.limitName ?? "").localeCompare(b.limitName ?? "")
}

function usageLimitRank(limitName: string | null): number {
  if (limitName === "5-hour") return 0
  if (limitName === "weekly") return 1
  if (limitName === "context window") return 2
  if (limitName === "primary") return 3
  if (limitName === "secondary") return 4
  return 10
}

function formatUsagePercent(percent: number): string {
  return Number.isInteger(percent) ? String(percent) : percent.toFixed(1).replace(/\.0$/, "")
}

function composeLimitStatus(ctx: Ctx, agentFilter: string | null, now = Date.now()): string {
  const filter = agentFilter?.trim().toLowerCase() || null
  const records = parseUsageLatestRecords(readFileOrNull(ctx.paths.usageLatest), now)
    .filter((rec) => !filter || rec.agent.toLowerCase() === filter)
    .sort(compareUsageLatestRecords)
  const scope = filter ? ` for ${filter}` : ""
  if (records.length === 0) {
    return `No recent limit telemetry${scope}. Run tg-ctl install-hooks and wait for the agent statusLine/harness telemetry to report.`
  }
  const lines = [`Latest limits${scope}:`]
  let currentAgent = ""
  for (const rec of records) {
    if (rec.agent !== currentAgent) {
      currentAgent = rec.agent
      lines.push(`${rec.agent}:`)
    }
    const limit = rec.limitName ?? "limit"
    const reset = rec.resetAt !== null ? ` · resets ${formatClock(rec.resetAt)} (in ${formatDelta(rec.resetAt - now)})` : ""
    const sampled = ` · updated ${formatDelta(now - rec.sampledAt)} ago`
    lines.push(`- ${limit}: ${formatUsagePercent(rec.percent)}%${reset}${sampled}`)
  }
  return lines.join("\n")
}

// /daily — shells out to `rig daily` (rig-cli's own categorized what-shipped report
// over merged PRs, source of truth `gh pr list --state merged`, never a ticket
// status). Bare `rig daily` with no flags reports since each configured repo's own
// saved watermark and advances it — exactly the semantics wanted for a repeatable
// Telegram command (a second /daily right after the first reports "nothing new",
// same as the CLI itself). 30s timeout: `gh pr list` across a couple of repos is
// normally sub-second, but a slow/rate-limited GitHub API call must not wedge the
// daemon's single event loop past a bounded ceiling (see spawnGuarded's own doc).
// `ok: false` is a failure to RUN rig (nothing was generated, no watermark moved) —
// only an `ok: true` report is worth persisting if its send later fails.
async function composeDailyReport(): Promise<{ ok: boolean; text: string }> {
  const r = await spawnGuarded(["rig", "daily"], 30_000)
  if (r.exitCode === 127) {
    return { ok: false, text: `daily: couldn't run \`rig\` (${r.stderr.trim() || "not found on PATH"}). Is rig-cli installed and on this daemon's PATH?` }
  }
  if (r.exitCode === 124) {
    return { ok: false, text: "daily: `rig daily` timed out after 30s (GitHub API slow/rate-limited?) — try again shortly." }
  }
  if (r.exitCode !== 0) {
    return { ok: false, text: `daily: \`rig daily\` failed (exit ${r.exitCode}): ${r.stderr.trim() || "no error output"}` }
  }
  const report = r.stdout.trim()
  return { ok: true, text: report || "daily: nothing new since the last report." }
}

// Send a plain-text daemon reply as ≤4096-char chunks, in order (Telegram rejects a
// longer sendMessage outright, and botPost only logs that — the user would get an ack
// and no report). Stops at the first failed chunk; returns how many were accepted so the
// caller can persist the rest.
async function sendReportChunks(ctx: Ctx, text: string, extra: Record<string, unknown>): Promise<{ chunks: string[]; delivered: number }> {
  const chunks = splitMessage(text, MESSAGE_LIMIT, "plain")
  let delivered = 0
  for (const chunk of chunks) {
    if ((await sendMessage(ctx, chunk, extra)) === null) break
    delivered++
  }
  return { chunks, delivered }
}

// /daily delivery: `rig daily` advances its watermark while GENERATING the report (rig
// has no commit-after-send verb; --dry-run/--since are read-only), so a report whose
// send fails would otherwise be lost for good — the next /daily says "nothing new". The
// undelivered tail is persisted (per bot, 0600) and prepended to the next /daily reply.
// The pending file is touched only AFTER the send is decided: overwritten (atomically)
// with the new undelivered tail on a partial send, removed only once everything went
// out. Deleting it up front would open a window (a slow `rig daily`, a daemon restart
// mid-action) where the carried report — already consumed from rig's watermark — is
// gone for good; the worst case of this ordering is a benign duplicate carry instead.
async function deliverDailyReport(ctx: Ctx, extra: Record<string, unknown>): Promise<void> {
  const pending = readFileOrNull(ctx.paths.dailyPending)
  const fresh = await composeDailyReport()
  const body = mergePendingDailyReport(pending, fresh.text)
  const { chunks, delivered } = await sendReportChunks(ctx, body, extra)
  const tail = undeliveredReportTail(chunks, delivered)
  if (tail === null) {
    if (pending !== null) unlinkGuarded(ctx.paths.dailyPending, "daily: removing the delivered pending-report file failed")
    return
  }
  // Nothing generated this time (rig failed — its watermark did not move, a plain retry
  // regenerates it): keep the carried report exactly as it was rather than persisting a
  // tail that mixes it with an error text; with nothing carried there is nothing to keep.
  const keep = fresh.ok ? tail : pending
  if (keep === null) return
  try {
    atomicWrite(ctx.paths.dailyPending, keep)
    log(`daily: send failed after ${delivered}/${chunks.length} chunks — kept the undelivered report for the next /daily`)
  } catch (err) {
    log(`daily: send failed AND persisting the undelivered report failed: ${err}`)
  }
}

function unlinkGuarded(path: string, failureNote: string): void {
  try {
    unlinkSync(path)
  } catch (err) {
    log(`${failureNote}: ${err}`)
  }
}

// /spend [day|week|month] — shells out to `rig usage --json`, rig-cli's own
// streaming aggregation over ~/.claude/projects + every ~/.claude-accounts/account-*
// (see rig-cli's riglib/usage.py). Cost is a HYPOTHETICAL estimate at published API
// list prices — these are Claude.ai subscription accounts, never a real bill; that
// disclaimer is threaded through from `rig usage` itself and repeated here so a lone
// forwarded chat message still carries it. No period arg mirrors the CLI's own
// default (both current week AND current month in one report). 30s timeout matches
// composeDailyReport's own ceiling — this is a local, hermetic file scan, not a
// network call, but a very large/first-run ~/.claude/projects tree could still take
// a few seconds and must not wedge the daemon's single event loop past a bound.
// `ok: false` is a failure to RUN rig or to read its output (no report exists) — the
// scheduled push must not treat that text as a delivered report (usage-format.ts owns
// the JSON contract + rendering, unit-tested there).
async function composeUsageReport(period: "day" | "week" | "month" | null): Promise<{ ok: boolean; text: string }> {
  const argv = period ? ["rig", "usage", "--json", "--period", period] : ["rig", "usage", "--json"]
  const r = await spawnGuarded(argv, 30_000)
  if (r.exitCode === 127) {
    return { ok: false, text: `spend: couldn't run \`rig\` (${r.stderr.trim() || "not found on PATH"}). Is rig-cli installed and on this daemon's PATH?` }
  }
  if (r.exitCode === 124) {
    return { ok: false, text: "spend: `rig usage` timed out after 30s — try again shortly." }
  }
  if (r.exitCode !== 0) {
    return { ok: false, text: `spend: \`rig usage\` failed (exit ${r.exitCode}): ${r.stderr.trim() || "no error output"}` }
  }
  return renderUsageReport(r.stdout)
}

function parseUsageWarningRecords(blob: string | null, now: number): UsageWarningRecord[] {
  if (!blob) return []
  try {
    const parsed = JSON.parse(blob) as { warnings?: unknown }
    if (!Array.isArray(parsed.warnings)) return []
    return parsed.warnings
      .filter((item): item is UsageWarningRecord => {
        if (!item || typeof item !== "object") return false
        const rec = item as Record<string, unknown>
        const resetAt = rec.resetAt
        return (
          typeof rec.key === "string" &&
          typeof rec.lastSentAt === "number" &&
          Number.isFinite(rec.lastSentAt) &&
          rec.lastSentAt > 0 &&
          (resetAt === null || (typeof resetAt === "number" && Number.isFinite(resetAt) && resetAt > 0))
        )
      })
      .filter((rec) => (rec.resetAt !== null ? rec.resetAt > now : rec.lastSentAt > now - 24 * USAGE_WARNING_COOLDOWN_MS))
      .slice(-USAGE_WARNING_STORE_MAX)
  } catch {
    return []
  }
}

function usageWarningAlreadyRecorded(records: UsageWarningRecord[], ev: UsageLimitEvent, now: number): boolean {
  const key = usageWarningKey(ev)
  const rec = records.find((item) => item.key === key)
  if (!rec) return false
  return rec.resetAt !== null || now - rec.lastSentAt < USAGE_WARNING_COOLDOWN_MS
}

function writeUsageWarningRecords(path: string, records: UsageWarningRecord[]): void {
  atomicWrite(path, `${JSON.stringify({ version: 1, warnings: records.slice(-USAGE_WARNING_STORE_MAX) })}\n`)
}

function claimUsageWarning(path: string, ev: UsageLimitEvent, now: number): boolean {
  try {
    const claimed = withRoutesLock(
      fsRoutesLockIo(usageWarningLockPath(path)),
      () => {
        const key = usageWarningKey(ev)
        const records = parseUsageWarningRecords(readFileOrNull(path), now)
        if (usageWarningAlreadyRecorded(records, ev, now)) return false
        const next = records.filter((item) => item.key !== key)
        next.push({ key, lastSentAt: now, resetAt: ev.resetAt })
        writeUsageWarningRecords(path, next)
        return true
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
    return claimed === true
  } catch (err) {
    log(`harness-event: usage warning dedupe claim failed: ${err}`)
    return false
  }
}

function clearUsageWarningClaim(path: string, ev: UsageLimitEvent, now: number): void {
  try {
    withRoutesLock(
      fsRoutesLockIo(usageWarningLockPath(path)),
      () => {
        const key = usageWarningKey(ev)
        writeUsageWarningRecords(
          path,
          parseUsageWarningRecords(readFileOrNull(path), now).filter((item) => item.key !== key),
        )
      },
      { onContended: "skip" },
    )
  } catch (err) {
    log(`harness-event: usage warning dedupe cleanup failed: ${err}`)
  }
}

function hasHarnessFailureSignal(payloadText: string, flags: HarnessEventFlags, hasUsageTelemetry = false): boolean {
  if (flags.reason || flags.resetAtIso || flags.transcriptPath) return true
  let payload: unknown = null
  try {
    payload = JSON.parse(payloadText)
  } catch {
    return payloadText.trim().length > 0
  }
  if (!payload || typeof payload !== "object") return false
  const hookEventName = strField(payload, "hook_event_name")
  return Boolean(
    hookEventName === "StopFailure" ||
      strField(payload, "reason") ||
      strField(payload, "matcher") ||
      strField(payload, "error") ||
      strField(payload, "error_type") ||
      (!hookEventName && !hasUsageTelemetry && strField(payload, "transcript_path")),
  )
}

// The failure prose from a Claude transcript (JSONL): the LAST assistant message
// text — where the synthetic session-limit / error message lives. Scanning the
// raw file would pick up per-line ISO timestamps and dump JSON into the alert;
// extractAssistantText pulls clean prose. Bounded read (tail) for a big file.
function transcriptFailureText(path: string | null): string {
  if (!path) return ""
  const raw = readFileOrNull(path)
  if (!raw) return ""
  return extractAssistantText(raw.length > 200_000 ? raw.slice(-200_000) : raw)
}

// Normalize the StopFailure payload + flags into a HarnessFailureEvent. The
// installed hook runs a BARE `tg-ctl harness-event`, so everything but the
// payload/transcript is resolved from the runtime: paneId from TMUX_PANE (flag
// default), agent from the live pane. The failure text comes from the transcript
// (prod) or an inline `message` field / plain-text stdin (tests / manual).
//
// Field names: the REAL bare-hook payload (per the StopFailure hook docs) is
// `{ error_type, error, transcript_path, ... }` — NOT `reason`/`matcher`/
// `message`/`last_message` (those only exist on our own test/manual-invocation
// shape and predate reading the real payload — PR #120 review). `error_type`
// and `error` are read as an ADDITIONAL fallback (not a replacement) so both
// shapes keep working: a bare production hook now classifies on `error_type`
// and shows the real `error` text instead of falling back to "unknown".
//
// `error_type` now feeds classifyFailure's `/limit/i` substring test (review
// round 3): today's documented StopFailure error_type enum (rate_limit,
// overloaded, authentication_failed, oauth_org_not_allowed, billing_error,
// invalid_request, model_not_found, server_error, max_output_tokens, unknown)
// has exactly ONE value containing "limit" — rate_limit — and that IS the
// auto-continue-eligible case. If a future error_type value adds "limit" to
// its name without being a resumable rate/session limit, this substring test
// would need to narrow to an exact match; revisit if the enum changes.
function buildHarnessEvent(payloadText: string, flags: HarnessEventFlags, agent: string, now: number): HarnessFailureEvent {
  let payload: unknown = null
  try {
    payload = JSON.parse(payloadText)
  } catch {
    /* non-JSON stdin (or empty) — treat it as the inline failure text */
  }
  const reason = flags.reason ?? (strField(payload, "reason") || strField(payload, "matcher") || strField(payload, "error_type"))
  const tPath = flags.transcriptPath ?? (strField(payload, "transcript_path") || null)
  // inline: an explicit message field, else plain-text (non-JSON) stdin. NEVER
  // the raw JSON payload — parseResetTime would scan JSON noise (a real bug).
  const inline = strField(payload, "message") || strField(payload, "last_message") || strField(payload, "error") || (payload === null ? payloadText : "")
  const failureText = [inline, transcriptFailureText(tPath)].filter(Boolean).join("\n")
  const extracted = extractFailure(reason, failureText, now, { agent })
  const sessionId = strField(payload, "session_id") || strField(payload, "sessionId") || null
  const explicitReset = flags.resetAtIso ? Date.parse(flags.resetAtIso) : NaN
  const resetAt = Number.isFinite(explicitReset) ? explicitReset : extracted.resetAt
  return {
    kind: resetAt !== null ? "session-limit" : extracted.kind,
    agent,
    paneId: flags.paneId,
    sessionId,
    reason: extracted.reason,
    detail: extracted.detail,
    resetAt,
    sourceMessageId: flags.sourceMessageId,
  }
}

function payloadLanguage(payloadText: string, flags: HarnessEventFlags): string | null {
  if (flags.language) return flags.language
  let payloadLanguage: string | null = null
  try {
    const payload = JSON.parse(payloadText)
    payloadLanguage =
      strField(payload, "language") ||
      strField(payload, "locale") ||
      strField(payload, "user_language") ||
      strField(payload, "userLanguage") ||
      null
  } catch {
    /* fall through to locale environment */
  }
  return payloadLanguage ?? languageFromProcessEnv(process.env)
}

function languageFromProcessEnv(env: NodeJS.ProcessEnv): string | null {
  for (const key of ["LC_ALL", "LC_MESSAGES", "LANG"]) {
    const raw = env[key]
    if (!raw) continue
    const normalized = raw.trim().toLowerCase()
    if (normalized.startsWith("ru")) return "ru"
    if (normalized.startsWith("en")) return "en"
  }
  return null
}

function formatAutoContinueDelay(ms: number): string {
  if (ms < 60_000) return `${Math.ceil(ms / 1000)}s`
  return formatDelta(ms)
}

function spawnDelayedAutoContinue(
  ctx: Ctx,
  ev: HarnessFailureEvent,
  plan: TransientAutoContinuePlan,
  windowName: string,
  retryKey: string,
): { pid: number } | null {
  if (!ev.paneId) return null
  let logFd: number | null = null
  try {
    logFd = openSync(ctx.paths.log, "a")
    const runBin = import.meta.path
    const argv = [
      process.execPath,
      runBin,
      "auto-continue-once",
      "--pane",
      ev.paneId,
      "--delay-ms",
      String(plan.delayMs),
      "--text",
      plan.text,
      "--retry-key",
      retryKey,
    ]
    argv.push("--window-name", windowName)
    const proc = Bun.spawn(argv, {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      cwd: dirname(runBin),
      env: { ...process.env, PWD: dirname(runBin), TG_CTL_CONFIG_DIR: ctx.configDir },
    })
    proc.unref()
    closeSync(logFd)
    logFd = null
    log(`harness-event: auto-continue spawned for ${ev.paneId} in ${plan.delayMs}ms (attempt ${plan.attempt})`)
    return { pid: proc.pid }
  } catch (err) {
    log(`harness-event: auto-continue spawn failed for ${ev.paneId}: ${err}`)
    return null
  } finally {
    if (logFd !== null) closeSync(logFd)
  }
}

interface AutoContinueOnceFlags {
  paneId: string | null
  delayMs: number
  text: string
  windowName: string | null
  retryKey: string | null
}

function parseAutoContinueOnceFlags(argv: string[]): AutoContinueOnceFlags {
  const flags: AutoContinueOnceFlags = { paneId: null, delayMs: 0, text: "", windowName: null, retryKey: null }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    const next = (): string => argv[++i] ?? ""
    if (a === "--pane") flags.paneId = next()
    else if (a === "--delay-ms") flags.delayMs = Number(next())
    else if (a === "--text") flags.text = next()
    else if (a === "--window-name") flags.windowName = next()
    else if (a === "--retry-key") flags.retryKey = next()
  }
  return flags
}

async function runAutoContinueOnce(ctx: Ctx, argv: string[]): Promise<number> {
  const flags = parseAutoContinueOnceFlags(argv)
  if (!flags.paneId || !flags.text || !Number.isFinite(flags.delayMs) || flags.delayMs < 0) return 2
  if (!flags.windowName) return 2
  if (!flags.retryKey) return 2
  if (flags.text !== "continue" && flags.text !== "продолжи") return 2
  if (flags.delayMs > 0) await Bun.sleep(flags.delayMs)
  try {
    const result = withRoutesLock(
      fsRoutesLockIo(overloadRetryLockPath(ctx.paths.overloadRetries)),
      () => {
        const now = Date.now()
        const records = parseOverloadRetryRecords(readFileOrNull(ctx.paths.overloadRetries), now)
        const rec = records.find((item) => item.key === flags.retryKey)
        if (!rec || rec.pid !== process.pid) {
          log(`auto-continue-once skipped: retry state no longer matches ${flags.paneId}`)
          return 0
        }
        const finish = (code: number): number => {
          writeOverloadRetryRecords(ctx.paths.overloadRetries, finishOverloadRetryRecord(records, flags.retryKey!, process.pid, Date.now()))
          return code
        }
        const live = listAgentCandidates().find((c) => c.paneId === flags.paneId)
        if (!live || live.windowName !== flags.windowName) {
          log(`auto-continue-once skipped: ${flags.paneId} no longer hosts ${flags.windowName}`)
          return finish(0)
        }
        const res = executeInjectStepsSync(buildTextInjectPlan(flags.paneId, flags.text))
        if (!res.ok) {
          log(`auto-continue-once inject failed for ${flags.paneId}: ${res.error}`)
          return finish(1)
        }
        log(`auto-continue-once fired for ${flags.paneId} (${flags.text})`)
        return finish(0)
      },
      { attempts: OVERLOAD_RETRY_LOCK_ATTEMPTS, delayMs: OVERLOAD_RETRY_LOCK_DELAY_MS, onContended: "skip" },
    )
    return result ?? 0
  } catch (err) {
    log(`auto-continue-once failed for ${flags.paneId}: ${err}`)
    return 1
  }
}

// The LIVE harness kind for a pane — so the bare installed hook still labels the
// notification instead of a default "agent". MUST read `.agent` (the process-tree-
// detected harness), not `.windowName`: a window's name is set once at spawn time
// (or by hand) and drifts from whatever's actually running in the pane (tg-cli#263).
function resolveAgentForPane(paneId: string | null): string {
  if (!paneId) return "agent"
  return listAgentCandidates().find((c) => c.paneId === paneId)?.agent ?? "agent"
}

function resolveWindowNameForPane(paneId: string | null): string | null {
  if (!paneId) return null
  return listAgentCandidates().find((c) => c.paneId === paneId)?.windowName ?? null
}

async function runHarnessEvent(ctx: Ctx, argv: string[], now: number): Promise<number> {
  const payloadText = await readStdinText().catch(() => "")
  return runHarnessEventPayload(ctx, argv, now, payloadText)
}

async function runHarnessEventPayload(ctx: Ctx, argv: string[], now: number, payloadText: string): Promise<number> {
  const flags = parseHarnessEventFlags(argv)
  const agent = flags.agent ?? resolveAgentForPane(flags.paneId)
  const windowName = flags.windowName ?? resolveWindowNameForPane(flags.paneId)
  const usageEvents = extractUsageLimitEvents(payloadText, { agent, language: flags.language, env: process.env, now })
  const hasSupportedUsageTelemetry = extractUsageLimitEvents(payloadText, { agent, language: flags.language, env: process.env, now: 0 }).length > 0
  if (!flags.dryRun) recordUsageLatest(ctx.paths.usageLatest, usageEvents, now)
  const sendUsageWarningIfPresent = async (): Promise<boolean> => {
    const usage = usageEvents.slice().sort((a, b) => b.percent - a.percent)[0] ?? null
    if (!usage) return false
    const notif = buildUsageLimitNotification(usage, now)
    if (!notif) {
      if (!flags.dryRun) log(`harness-event: suppressed (usage below threshold) agent=${usage.agent} percent=${usage.percent}`)
      else console.log("harness-event: SUPPRESSED (usage below 90%)")
      return true
    }
    if (flags.dryRun) {
      console.log("=== harness-event DRY-RUN (no send) ===")
      console.log(notif.text)
      return true
    }
    if (!claimUsageWarning(ctx.paths.usageWarnings, usage, now)) {
      log(`harness-event: suppressed (duplicate usage warning) agent=${usage.agent} limit=${usage.limitName ?? "-"} reset=${usage.resetAt ?? "-"}`)
      return true
    }
    const messageId = await sendMessage(ctx, notif.text, { parse_mode: "HTML" })
    if (messageId === null) clearUsageWarningClaim(ctx.paths.usageWarnings, usage, now)
    return true
  }
  const failurePayload = hasHarnessFailureSignal(payloadText, flags, hasSupportedUsageTelemetry)
  if (failurePayload) {
    const ev = buildHarnessEvent(payloadText, flags, agent, now)
    const latestCodexUsage = latestRecentUsageLatest(ctx.paths.usageLatest, "codex", now)
    const anyCodexUsage = latestCodexUsage === null ? latestAnyUsageLatest(ctx.paths.usageLatest, "codex") : latestCodexUsage
    const diagnostic = buildCodexHardLimitDiagnostic(ev, {
      hasSupportedUsageTelemetry: hasSupportedUsageTelemetry || latestCodexUsage !== null,
      latestSupportedUsagePercent: latestCodexUsage?.percent ?? null,
      latestSupportedUsageLimitName: latestCodexUsage?.limitName ?? null,
      hadExpiredSupportedUsageTelemetry: latestCodexUsage === null && anyCodexUsage !== null,
    })
    const notif = buildLimitNotification(ev, now, { diagnostic })
    const overloadLanguage = payloadLanguage(payloadText, flags)
    const retryableOverload = ev.paneId && windowName ? buildTransientAutoContinue(ev, { attempt: 1, language: overloadLanguage }) : null
    if (!notif) {
      if (await sendUsageWarningIfPresent()) return 0
      // Staleness guard (#113): a reset already in the past, or nothing to report.
      if (!flags.dryRun) log(`harness-event: suppressed (stale/none) agent=${ev.agent} reset=${ev.resetAt}`)
      else console.log("harness-event: SUPPRESSED (reset already past or nothing to report)")
      return 0
    }
    if (flags.dryRun) {
      console.log("=== harness-event DRY-RUN (no send) ===")
      console.log(notif.text)
      if (notif.button) console.log(`[button] ${notif.button.label} → ${notif.button.data}`)
      if (retryableOverload) console.log(`[auto-continue] ${retryableOverload.text} in ${formatAutoContinueDelay(retryableOverload.delayMs)} (attempt ${retryableOverload.attempt})`)
      if (ev.sourceMessageId !== null) console.log(`[reaction] ${reactionForStage("stalled")} on message ${ev.sourceMessageId}`)
      return 0
    }
    const keyboard = notif.button ? { inline_keyboard: [[{ text: notif.button.label, callback_data: notif.button.data }]] } : undefined
    const extra: Record<string, unknown> = { parse_mode: "HTML" }
    if (keyboard) extra.reply_markup = keyboard
    const messageId = await sendMessage(ctx, notif.text, extra)
    if (ev.sourceMessageId !== null) await setMessageReaction(ctx, ev.sourceMessageId, reactionForStage("stalled"))
    if (retryableOverload && messageId !== null) {
      claimOverloadAutoContinue(ctx, ev, now, overloadLanguage, windowName)
    }
    return 0
  }
  if (await sendUsageWarningIfPresent()) return 0
  if (!flags.dryRun) log(`harness-event: suppressed (no supported event) agent=${agent}`)
  else console.log("harness-event: SUPPRESSED (no supported event)")
  return 0
}

async function runCodexUsageHook(ctx: Ctx, now: number): Promise<number> {
  const hookPayload = await readStdinText().catch(() => "")
  const transcriptPath = codexUsageTranscriptPath(hookPayload)
  if (!transcriptPath) return 0
  const transcript = readFileTailOrNull(transcriptPath, CODEX_TRANSCRIPT_TAIL_BYTES)
  if (!transcript) return 0
  const payload = latestCodexUsageTelemetryPayload(transcript, { now })
  if (!payload) return 0
  return runHarnessEventPayload(ctx, ["--agent", "codex"], now, payload)
}

// --- run: the daemon itself ---

// Upper bound on a cooperative (SIGTERM) drain: finish the in-flight batch, then
// exit. If some await hangs past this, hard-exit anyway so a reload never stalls.
// Comfortably under launchd's own SIGTERM→SIGKILL grace, and well above a normal
// batch's action time (a few tmux send-keys).
const GRACEFUL_SHUTDOWN_MS = 8000

async function runDaemon(ctx: Ctx): Promise<never> {
  mkdirSync(ctx.configDir, { recursive: true })

  // flock FIRST (spec §6): bound to the open file description, released by the
  // kernel on ANY exit including SIGKILL. Neither Bun nor Node expose flock
  // and macOS has no flock(1), hence bun:ffi. The fd stays open for the
  // daemon's lifetime.
  const { dlopen, FFIType } = await import("bun:ffi")
  const lib = process.platform === "darwin" ? "libSystem.B.dylib" : "libc.so.6"
  const ffi = dlopen(lib, { flock: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 } })
  const LOCK_EX_NB = 6 // LOCK_EX (2) | LOCK_NB (4)
  const lockFd = openSync(ctx.paths.lock, "w")
  if (ffi.symbols.flock(lockFd, LOCK_EX_NB) !== 0) {
    // Another daemon owns this bot — idempotent no-op (spec §6).
    process.exit(0)
  }

  writeFileSync(ctx.paths.pid, `${process.pid}\n`)

  // One-time migration (tg-cli#281): best-effort rename a pre-existing
  // last-alex-target.json forward so the CTO's routing anchor survives the
  // upgrade instead of silently resetting to the ambiguity picker — or, if a
  // new-name file already exists, remove the now-redundant legacy file so a
  // FUTURE restart (after a legitimate invalidation clears the new file
  // again) can never resurrect it (review finding, round 3). Deliberately
  // placed AFTER the flock is held (review finding, round 2): running this
  // from every CLI invocation (send/status/ask/etc, not just the daemon)
  // could race a still-running pre-rename daemon and clobber ITS fresh anchor
  // write with the stale legacy file — only the flock-holding daemon may
  // touch either file. Non-fatal: a failed rename/unlink just means the
  // legacy file lingers (still denylisted) or the daemon starts with no
  // anchor, same as a fresh install.
  const legacyAction = planLegacyLastUserTargetMigration(ctx.configDir, ctx.botId, existsSync)
  if (legacyAction) {
    try {
      if (legacyAction.kind === "migrate") renameSync(legacyAction.from, legacyAction.to)
      else unlinkSync(legacyAction.path)
    } catch {
      // best-effort; see comment above
    }
  }
  const pendingButtons = new Map<string, PendingButton>()
  // Per-resource-key concurrent dispatch (tg-cli#357): actions sharing a key (same topic
  // thread, same pending token, same question requestId) still run strictly in enqueue order;
  // actions with different keys run fully concurrently so one stuck target can never head-of-
  // line-block delivery to any other target. See actionResourceKey below and concurrent-dispatch.ts.
  const dispatchQueues = new TargetDispatchQueues()
  const activeButtonKeys = new Set<string>()
  // Answered-request replay cache (tg-cli#97): requestId → the answer just given,
  // so a re-forward of the same question within ANSWERED_REPLAY_MS replays it
  // instead of posting a duplicate card. Swept on every record (pruneAnsweredButtons)
  // so it stays bounded to the last window's answers, never unbounded.
  const answeredButtons = new Map<string, AnsweredButton>()
  // Socket-closed SCOPED questions retained for late-delivery + reconnect (this PR):
  // a question whose hook socket died (the 120s window OR a daemon restart) but whose
  // chosen answer can still reach the pane it asked from. NOT in `pendingButtons`, so
  // it never defers its pane's inbound. Keyed by callbackRequestId, like the others.
  const abandonedButtons = new Map<string, AbandonedButton>()
  ompPermissionSink = (req) => {
    void (async () => {
      const payload = buildButtonMessage(ctx.chatId, req)
      const messageId = await sendButtonCard(ctx, payload)
      const key = callbackRequestId(req)
      abandonedButtons.set(key, { req, messageId: messageId ?? null, at: Date.now() })
      persistQuestions()
      log(`omp-acp: posted permission/question ${describeAskRequest(req)} messageId=${messageId ?? "-"}`)
    })()
  }
  // The daemon is giving up on a retained entry (its retention window elapsed with
  // no reconnect and no delivery) — surface that instead of leaving the card
  // silently stuck on "hook disconnected"/"queued" forever (Alex tg requirement:
  // long uncertainty must eventually be reported). Best-effort, like every other
  // card edit in this file: a failed edit just means the card stays as it was.
  const notifyAbandonedLongOutage = (key: string, entry: AbandonedButton): void => {
    const label = resolveWindowAgentLabel(entry.req.windowName, entry.req.cwd)
    if (entry.messageId !== null) {
      void clearMessageKeyboard(ctx, entry.messageId)
      const hookId = parseHatchHookId(entry.req.requestId)
      void editMessageText(
        ctx,
        entry.messageId,
        hookId !== null
          ? hatchAbandonedLongOutageText(entry.req, hookId, entry.queuedDecision?.label)
          : abandonedLongOutageText(entry.req, label, entry.queuedDecision?.label),
        undefined,
        hatchParseMode(entry.req),
      )
    }
    log(`ask-abandoned-long-outage: ${describeAskRequest(entry.req)} key=${key}`)
  }
  // A QUEUED permission decision past QUEUED_DECISION_NOTICE_MS with no reconnect
  // gets a ONE-TIME proactive "still waiting to reconnect" notice (Alex tg#9982:
  // a long-running uncertainty must be reported, but the queued tap itself must
  // NEVER be silently dropped/demoted on a timer). Unlike the pre-fix behavior
  // this replaces, the queue is NOT cleared — it stays fully eligible for
  // automatic delivery (see decideQueuedPermissionReconnect, called from the
  // reconnect branch in handleHookSocketLine) for as long as the entry itself
  // is retained (ABANDONED_PERMISSION_RETAIN_MS for a permission, refreshed
  // by every tap — tg-cli#182), not bounded by THIS shorter notice threshold.
  // `notifiedAt` makes this idempotent: a sweep that finds an
  // already-notified entry does nothing.
  // Returns whether anything changed, so callers know whether a persist is
  // warranted. `now` is caller-supplied (not sampled internally) and MUST be the
  // exact same value the caller then passes to `pruneAbandonedButtons` right
  // after — two independent `Date.now()` reads a few instructions apart can
  // straddle an entry's exact retention boundary, defeating the skip guard
  // below for that narrow window (review finding: one clock reading in, not two).
  const noticeStaleQueuedDecisions = (now: number): boolean => {
    let changed = false
    for (const entry of abandonedButtons.values()) {
      const qd = entry.queuedDecision
      if (!qd || qd.notifiedAt !== undefined || now - qd.at <= QUEUED_DECISION_NOTICE_MS) continue
      // An entry with no `promptTurnId` never auto-delivers on reconnect (see the
      // gate in handleHookSocketLine) — queuedDecisionStillWaitingText's "will
      // still be delivered automatically if it reconnects" would be a straight-up
      // lie for it (review finding: the notice text overpromised for exactly the
      // case the delivery gate carves out). Skip the still-waiting notice
      // entirely here; the entry still gets the accurate, decision-naming give-up
      // notice at its own retention window (ABANDONED_PERMISSION_RETAIN_MS — this
      // whole function only ever processes `queuedDecision` entries, which are
      // permission-only — notifyAbandonedLongOutage), which never
      // claims automatic delivery in the first place.
      if (!queuedDecisionCanAutoDeliver(entry.req)) continue
      // Skip an entry that pruneAbandonedButtons (called right after this with the
      // SAME `now`, same sweep — both persistQuestions and the poll loop run them
      // back to back) is about to delete anyway: two independent fire-and-forget
      // editMessageText calls on the SAME card (this "still waiting" edit + the
      // long-outage give-up edit, which also clears the keyboard) could otherwise
      // land at Telegram out of order, leaving a since-deleted entry's card
      // claiming "still waiting … will still be delivered" with a live keyboard
      // that resolves to nothing (review finding). Let pruneAbandonedButtons's own
      // notify own this entry — reachable in normal production (not just
      // misconfiguration): the daemon can be down from shortly after the tap until
      // past the full ABANDONED_PERMISSION_RETAIN_MS, so `notifiedAt` is still unset on
      // restore and both thresholds are crossed in the very first post-restore
      // sweep. `>=` (not pruneAbandonedButtons's own strict `>`), deliberately
      // ASYMMETRIC with the shared `now`: this must skip everything the prune is
      // about to take (the double-edit hazard, never allowed), even though that
      // means the exact boundary tick (`now - entry.at === retainMsFor(entry.req.kind, entry.req.critical)`)
      // gets neither notice nor prune this ONE sweep (prune's `>` doesn't take it
      // yet either) — resolved trivially on the very next sweep. A stale "neither
      // fired for one tick" beats a card showing two contradictory edits.
      // `queuedDecision` only ever exists on a `permission`-kind entry in
      // practice (see the restore path's explicit `req.kind === "permission"`
      // gate) — this branch is defense-in-depth against that convention ever
      // drifting, matching every OTHER retention-window check in this file
      // (review finding: this was the one site left unconditional).
      if (now - entry.at >= retainMsFor(entry.req.kind, entry.req.critical)) continue
      qd.notifiedAt = now
      changed = true
      const label = resolveWindowAgentLabel(entry.req.windowName, entry.req.cwd)
      if (entry.messageId !== null) {
        void editMessageText(
          ctx,
          entry.messageId,
          queuedDecisionStillWaitingText(entry.req, label, qd.label),
          buildButtonMessage(ctx.chatId, entry.req).reply_markup,
          hatchParseMode(entry.req),
        )
      }
      log(`ask-permission-decision-queue-still-waiting-notice: ${describeAskRequest(entry.req)}`)
    }
    return changed
  }
  // Durable question state (this PR): persist pending + abandoned + answered to disk
  // on every mutation (atomic) so a daemon restart loses nothing — a late tap still
  // late-delivers and a reconnecting hook re-attaches instead of duplicating its card.
  // `nowOverride`: when the caller already ran its OWN notice+prune sweep against
  // a specific clock reading moments ago (the poll loop, which sweeps directly
  // for cheapness and only calls persistQuestions() to write out what changed —
  // see the call site below), pass that SAME reading through so this internal
  // re-sweep doesn't sample a NEW `Date.now()` and re-run notice+prune with two
  // different clocks in one iteration. Two different clocks reopened the exact
  // out-of-order double-edit hazard noticeStaleQueuedDecisions's shared-`now`
  // parameter was added to close — an entry whose retention deadline falls
  // between the two reads got a "still waiting" edit from the FIRST sweep and a
  // give-up edit from the SECOND, independent fire-and-forget calls that can
  // land at Telegram out of order (review finding). Every other call site has no
  // preceding sweep in the same tick, so they omit it and get a fresh clock.
  // CAUTION (review finding, checked — currently safe): every call site in this
  // file invokes `persistQuestions()`/`persistQuestions(sweepNow)` directly, and
  // `rt.persist` (the one place this is exposed by reference, as an object
  // property) is likewise only ever invoked as `rt.persist()` with zero args
  // (grep confirms no `.then(rt.persist)` / event-handler / array-callback usage
  // that would forward an incidental first argument as a bogus `nowOverride`).
  // If a new such reference-passing call site is ever added, it MUST wrap it in
  // an arrow (`() => persistQuestions()`), never pass the function bare.
  const persistQuestions = (nowOverride?: number): void => {
    try {
      // `typeof … === "number"` (not a bare `??`): a positional optional param is
      // exactly the shape a bare-reference callback (`.then(rt.persist)`, an event
      // handler, `arr.forEach(rt.persist)`) would corrupt by forwarding its own
      // first argument — a Promise value, an array index, an event object — as
      // `nowOverride`. Every current call site passes either nothing or a real
      // `number` (see the CAUTION comment above), so this typeof guard is
      // currently a no-op in practice; it exists so a FUTURE bare-reference usage
      // fails safe (falls back to a fresh, correct clock) instead of silently
      // writing disk state — or disabling both sweeps — against a bogus "now"
      // (review finding).
      const now = typeof nowOverride === "number" ? nowOverride : Date.now()
      // Fire the still-waiting notice for any queue past its notice threshold
      // BEFORE writing, so `notifiedAt` is durable the instant it fires (a restart
      // right after must not re-send the notice). Same `now` as the prune call
      // right below — see noticeStaleQueuedDecisions's own doc comment for why.
      noticeStaleQueuedDecisions(now)
      // Prune BOTH maps by age before writing: parse re-filters answered on restore,
      // but pruning here too keeps the on-disk file tight and symmetric with abandoned.
      pruneAbandonedButtons(abandonedButtons, now, notifyAbandonedLongOutage)
      pruneAnsweredButtons(answeredButtons, now)
      const data: QuestionStoreData = {
        questions: [
          // A LIVE pending scoped question and an abandoned one are equivalent on
          // disk — both restore as "abandoned" (no live socket), recoverable by a
          // late tap or a reconnect. Unscoped (paneId-less) pending is skipped: it
          // can't be late-delivered (no pane) and must not resurrect to re-wedge.
          ...[...pendingButtons.values()]
            .filter((e) => e.req.paneId && (e.req.kind === "permission" || e.req.options?.length))
            .map((e) => ({
              req: e.req as unknown as Record<string, unknown>,
              messageId: e.messageId,
              at: e.at,
              // tg-cli#403: a scoped (paneId-set) critical entry's reminder clock
              // must survive a restart too — otherwise every daemon bounce would
              // silently reset the human's reminder cadence.
              ...(e.criticalState ? { criticalState: e.criticalState } : {}),
            })),
          ...[...abandonedButtons.values()].map((e) => ({
            req: e.req as unknown as Record<string, unknown>,
            messageId: e.messageId,
            at: e.at,
            // A queued permission decision MUST survive a restart (see
            // AbandonedButton.queuedDecision) — otherwise the card keeps claiming
            // "delivered automatically once the hook reconnects" for a decision
            // that a restart just silently threw away.
            ...(e.queuedDecision ? { queuedDecision: e.queuedDecision } : {}),
            // tg-cli#403: see the pendingButtons mapper above — same field, same reason.
            ...(e.criticalState ? { criticalState: e.criticalState } : {}),
          })),
        ],
        answered: [...answeredButtons].map(([key, e]) => ({
          key,
          value: e.value,
          label: e.label,
          decision: e.decision,
          at: e.at,
          delivery: e.delivery,
        })),
      }
      atomicWrite(ctx.paths.questions, serializeQuestionStore(data))
    } catch (err) {
      // Best-effort, like routes/topics: a persist failure must never break the hot
      // forward/answer path. The state simply isn't durable until the next mutation.
      log(`question persist failed: ${err}`)
    }
  }
  // --- Late-approval grant protocol v1.1 (tg-cli#398): the daemon-owned stores ---
  // Loaded BEFORE the question restore below: a hatch record that expired while the
  // daemon was DOWN upserts its grace record at restore time (the second of the two
  // retire paths), which needs this store live first. Each grace record's `req` is
  // re-run through the AUTHORITATIVE normalizeButtonRequest — one that no longer
  // validates (schema drift, corruption) is dropped fail-closed, never trusted from
  // disk (parseGrantStore only shape-sniffs `req`; see its doc comment).
  const grantsData = (() => {
    const parsed = parseGrantStore(readFileOrNull(ctx.paths.grants), Date.now())
    parsed.grace = parsed.grace.flatMap((g) => {
      const req = normalizeButtonRequest(g.req)
      if (!req || !(req.kind === "permission" && isHatchRequest(req))) return []
      return [{ ...g, req }]
    })
    return parsed
  })()
  // FAIL-CLOSED persistence (unlike persistQuestions above): every grant mutation
  // (mint/consume) MUST persist before it is confirmed, and a failed write means the
  // mutation is rolled back — otherwise a daemon restart could resurrect a consumed
  // grant as usable (single-use replay) or lose a confirmed one.
  const persistGrants = (): boolean => {
    try {
      const now = Date.now()
      // Prune the LIVE store too (serializeGrantStore only prunes its copy):
      // keeps in-memory scans bounded and memory/disk consistent.
      pruneGrantStore(grantsData, now)
      atomicWrite(ctx.paths.grants, serializeGrantStore(grantsData, now))
      return true
    } catch (err) {
      log(`grant persist failed: ${err}`)
      return false
    }
  }
  // A hatch permission ask EXPIRED (both live retire paths — the unscoped backstop
  // timer and the hook socket close — converge on retireAbandonedEntry, which calls
  // this): upsert its grace record so a late Approve tap stays addressable for
  // GRACE_WINDOW_MS (24h), outliving the 12h abandoned retention. Fail-soft with a
  // loud log: losing grace degrades the feature but never authorizes anything.
  const onHatchExpired = (entry: PendingButton, pendingKey: string): void => {
    const hookId = entry.req.hookId ?? parseHatchHookId(entry.req.requestId)
    if (!hookId) return
    upsertGraceRecord(
      grantsData.grace,
      buildGraceRecord(entry.req, pendingKey, hookId, routeForRequest(entry.req), entry.messageId, Date.now(), GRACE_WINDOW_MS),
    )
    if (!persistGrants()) log(`grace persist failed for ${pendingKey} — late taps on this card will not be addressable`)
  }
  // Restore durable state on bootstrap. A restored scoped question lands in
  // `abandonedButtons` (no live socket) — a late tap injects to its pane, a reconnect
  // re-attaches. Restored scoped permissions land there too so a reconnecting hook can
  // re-attach to its existing card instead of posting a duplicate. Re-normalize each
  // `req` through the AUTHORITATIVE validator and drop anything that isn't scoped (and
  // for questions: carrying options). Answered entries restore the replay cache.
  //
  // Read with an EFFECTIVELY UNBOUNDED question window (not ABANDONED_RETAIN_MS) —
  // deliberately wider than what we actually RESTORE to `abandonedButtons` below.
  // An entry whose retention window elapsed WHILE THE DAEMON WAS DOWN is invisible
  // to both the sweep and the persist-time prune (they only run while the daemon is
  // alive), so without this a card frozen on "hook disconnected"/"queued …
  // delivered automatically" would silently never get its long-outage notice —
  // exactly the failure this whole notice mechanism exists to prevent (review
  // finding). Answered entries still use the real ANSWERED_REPLAY_MS window; only
  // the question side is widened. Bound note: parseQuestionStore still caps to
  // MAX_RETAINED_QUESTIONS (question-store.ts) — the oldest (most-expired) records
  // are dropped first on overflow, before this loop can notify them. The on-disk
  // WRITE side is capped the same way, so the file can't normally exceed that count
  // in practice; this only matters if it somehow does.
  {
    const nowRestore = Date.now()
    const raw = parseQuestionStore(readFileOrNull(ctx.paths.questions), nowRestore, Number.MAX_SAFE_INTEGER, ANSWERED_REPLAY_MS)
    let expiredOnRestore = false
    for (const rec of raw.questions) {
      const req = normalizeButtonRequest(rec.req)
      if (!req) continue
      if (!req.paneId && !(req.kind === "permission" && isHatchRequest(req))) continue
      if (req.kind === "question" && !req.options?.length) continue
      if (isAbandonedExpired(req.kind, rec.at, nowRestore, req.critical)) {
        // Grant protocol v1.1 (tg-cli#398): a hatch permission that expired while
        // the daemon was DOWN never ran retireAbandonedEntry in THIS process —
        // write its grace record here (the restore-time retire path; `rec.at` is
        // its abandon/expiry moment). parseGrantStore prunes past-grace records
        // on load, so an over-aged one simply never materializes.
        const expiredHookId = req.kind === "permission" ? req.hookId ?? parseHatchHookId(req.requestId) : null
        if (expiredHookId !== null) {
          upsertGraceRecord(
            grantsData.grace,
            buildGraceRecord(req, callbackRequestId(req), expiredHookId, routeForRequest(req), rec.messageId, rec.at, GRACE_WINDOW_MS),
          )
          expiredOnRestore = true
        }
        // Carry the queuedDecision through (same rule as the live-abandonedButtons
        // restore below): a tap that was never delivered before the daemon went
        // down for the whole retention window must still be NAMED in the give-up
        // notice (abandonedLongOutageText's queuedDecisionLabel), not silently
        // treated as if nothing was ever chosen.
        const queuedDecision = req.kind === "permission" ? rec.queuedDecision : undefined
        notifyAbandonedLongOutage(callbackRequestId(req), { req, messageId: rec.messageId, at: rec.at, queuedDecision })
        expiredOnRestore = true
        continue
      }
      // Only a PERMISSION can carry a queued decision (see AbandonedButton.queuedDecision) —
      // a stray one on a non-permission record (corrupt/foreign write) is dropped rather
      // than silently auto-answering a question it was never meant for.
      const queuedDecision = req.kind === "permission" ? rec.queuedDecision : undefined
      // tg-cli#403: only meaningful when the restored req is itself critical — a
      // stray criticalState on a non-critical record (corrupt/foreign write) is
      // dropped rather than silently scheduling reminders nobody asked for.
      const criticalState = req.critical === true ? rec.criticalState : undefined
      abandonedButtons.set(callbackRequestId(req), { req, messageId: rec.messageId, at: rec.at, queuedDecision, criticalState })
    }
    const restored = raw
    for (const a of restored.answered) {
      answeredButtons.set(a.key, { value: a.value, label: a.label, decision: a.decision, at: a.at, delivery: a.delivery })
    }
    if (abandonedButtons.size || answeredButtons.size) {
      log(`questions restored: ${abandonedButtons.size} retained, ${answeredButtons.size} answered`)
    }
    // A record notified-and-dropped above was never added to `abandonedButtons`,
    // so it is gone from MEMORY — but the on-disk file still holds it (this block
    // never wrote back). Left alone that stale record would: re-fire the identical
    // (no-op) card edit on every subsequent restart until something else happens to
    // mutate and persist, AND count against MAX_RETAINED_QUESTIONS on a future
    // write, which could starve an actually-recent entry — or even a DIFFERENT
    // still-expired-but-not-yet-notified entry — of its own notice (review
    // finding). Persist once now so the file matches memory immediately — and
    // the grants file with it (the restore-time grace upserts above).
    if (expiredOnRestore) {
      persistQuestions()
      persistGrants()
    }
  }
  // /agent (and unrecognized-reply) selection awaiting a button tap: token →
  // message + candidate list. `prewrapped` = inject the message verbatim (a reply
  // already carries its wrap/anchor) instead of wrapping it again.
  const pendingAgent = new Map<
    string,
    {
      message: string
      candidates: AgentCandidate[]
      messageId: number | null
      sourceMessageId: number | null
      relatedReactionMessageId: number | null
      timer: ReturnType<typeof setTimeout>
      prewrapped?: boolean
      // Select-only picker: there is no message on the button itself. Bare
      // `/agent` uses this to arm a one-shot route for the next ordinary inbound
      // message; control pickers (/stop, /kill) only hand back the selector.
      selectOnly?: boolean
      armNextMessage?: boolean
      threadId?: number | null
    }
  >()
  let agentTokenSeq = 0
  const SELECTED_AGENT_TTL_MS = 10 * 60_000
  type SelectedAgentRoute = {
    token: string
    paneId: string
    label: string
    messageId: number | null
    threadId: number | null
    timer: ReturnType<typeof setTimeout>
  }
  let selectedAgentRoute: SelectedAgentRoute | null = null
  let selectedAgentTokenSeq = 0
  // Must match features/tg-ctl/agent-match.ts's parser prefix.
  const AGENT_CANCEL_CALLBACK_PREFIX = "tgac"
  const cancelSelectedAgentRoute = (): SelectedAgentRoute | null => {
    const selected = selectedAgentRoute
    if (!selected) return null
    selectedAgentRoute = null
    clearTimeout(selected.timer)
    return selected
  }
  const cancelSelectedAgentRouteForAgentCommand = (): void => {
    const previous = cancelSelectedAgentRoute()
    if (previous && previous.messageId !== null) {
      void editMessageText(ctx, previous.messageId, `cancelled ${previous.label} — another /agent command was used`)
    }
  }
  const selectedAgentCancelMarkup = (token: string): ButtonMessagePayload["reply_markup"] => ({
    inline_keyboard: [[{ text: "Cancel", callback_data: `${AGENT_CANCEL_CALLBACK_PREFIX}:${token}` }]],
  })
  // Flat-chat `/new` sessions in flight (issue #27), keyed by an opaque token. IN-MEMORY only:
  // a `/new` interrupted by a daemon restart is simply abandoned (the user re-runs it) — far
  // simpler than the crash-recovery the PERSISTENT forum-topic bindings need, because a flat /new
  // creates a plain pane (addressed by /agent afterwards), not a tracked binding. Sessions older
  // than NEW_SESSION_TTL_MS are reaped lazily so an abandoned awaiting-dir can't capture a much
  // later plain message as its "path answer".
  const pendingNew = new Map<string, NewSession>()
  let newTokenSeq = 0
  const NEW_SESSION_TTL_MS = 10 * 60_000
  // Reap expired /new sessions (lazy GC, called before each read of the store). Keeps an
  // abandoned awaiting-dir from later swallowing an unrelated plain message as a path answer.
  const reapNewSessions = (): void => {
    const cutoff = Math.floor(Date.now() / 1000) - NEW_SESSION_TTL_MS / 1000
    for (const [tok, s] of pendingNew) {
      if (s.ts < cutoff) pendingNew.delete(tok)
    }
  }
  // True while at least one /new session is awaiting its working directory — so stepUpdates
  // treats the next plain prose message as the typed path answer (injected via newSessionAwaitingDir).
  const newSessionAwaitingDir = (): boolean => {
    reapNewSessions()
    for (const s of pendingNew.values()) {
      if (s.status === "awaiting-dir") return true
    }
    return false
  }
  type DeferredInbound = {
    text: string
    sourceMessageId: number | null
    relatedReactionMessageId: number | null
    delivered: boolean
  }
  // Inbound queued behind an agent's outstanding question (defer-while-waiting):
  // pane → already-wrapped texts plus their Telegram source message id, flushed
  // when the question is answered. The flag tells the trailing `ack` to mark the
  // source message with DEFER_REACTION (✍️ "noted, queued") instead of 👀.
  const deferred = new DeferQueues<DeferredInbound>()
  // Panes with an in-flight flushDeferred. While a flush drains a pane, its queue
  // is momentarily empty (taken out per round), so deferred.has() alone would let
  // a live message inject AHEAD of items still being flushed. This flag keeps new
  // inbound deferring for the whole flush, preserving strict FIFO; the drain
  // loop's next round picks up whatever was enqueued meanwhile.
  const flushingPanes = new Set<string>()
  type QueuedAckReaction = {
    messageId: number
    emoji: string
    shouldSend?: () => boolean
  }
  const queuedAckReactions: QueuedAckReaction[] = []
  const queueAckReaction = (messageId: number | null, emoji: string, shouldSend?: () => boolean): void => {
    if (messageId === null) return
    queuedAckReactions.push({ messageId, emoji, shouldSend })
  }
  const takeAckReaction = (messageId: number): QueuedAckReaction | null => {
    const index = queuedAckReactions.findIndex((reaction) => reaction.messageId === messageId)
    if (index < 0) return null
    const [reaction] = queuedAckReactions.splice(index, 1)
    return reaction ?? null
  }
  const paneHasPendingQuestion = (paneId: string): boolean => {
    for (const pb of pendingButtons.values()) {
      // tg#30: an UNSCOPED question — paneId undefined because the hook subprocess ran WITHOUT
      // TMUX_PANE (the common Claude Code case) — defers inbound for ANY pane (fail CLOSED). The
      // old guard required `pb.req.paneId && === paneId`, so a paneId-less question matched NO pane,
      // inbound was NOT deferred, and the next message was send-keys'd into the open prompt. We
      // can't prove an unscoped question is a DIFFERENT pane than the inject target, so don't paste.
      // This can NEVER wedge routing: every entry self-clears in ≤110s (the abandon timer above),
      // unlike a stale queue (which is intentionally NOT treated as a defer).
      //
      // tg-cli#403 EXCEPTION: a CRITICAL unscoped request (the common headless hatch
      // case) deliberately does NOT self-clear in ≤110s anymore — forwardAndPostQuestion
      // skips the UNSCOPED_ABANDON_MS backstop for it entirely, by design, so it can wait
      // indefinitely for a human decision. Without this carve-out, that same "fail closed,
      // never wedges because it always self-clears fast" reasoning above would silently
      // become FALSE the moment a critical hatch request is pending: it would defer EVERY
      // agent's inbound Telegram traffic — not just the (nonexistent) pane it's asking
      // from — for as long as the human hasn't tapped, which could be hours (multi-model
      // review finding on this exact feature). A critical unscoped entry was never asking
      // from any real pane in the first place (see parseHatchHookId's doc comment,
      // questions.ts — hatch is structurally headless), so there is no live prompt here
      // for an inbound message to actually collide with; excluding it restores the
      // original bounded-wedge invariant for everything else, unchanged.
      if (!pb.req.paneId && pb.req.critical !== true) return true
      if (pb.req.paneId === paneId) return true
    }
    return false
  }
  // A live inbound message defers behind an OPEN question OR an in-flight flush
  // (which sets flushingPanes for its whole duration, incl. the 800ms settle and
  // every inter-paste gap). Those two cover every window where injecting now would
  // either hit an open prompt or jump ahead of older queued items.
  //
  // It deliberately does NOT defer merely because the queue is non-empty: a queue
  // can outlive its question (the Telegram prompt expires / its hook socket closes
  // WITHOUT a terminal answer — the agent is still blocked locally, so we must not
  // flush, but no future answer will arrive to drain it either). Treating a
  // non-empty queue as "defer" would then wedge EVERY later message to that pane
  // forever (review finding). FIFO during a real flush is preserved by
  // flushingPanes; a question (live or expired-in-terminal) is preserved by
  // paneHasPendingQuestion while the prompt is open.
  const shouldDeferInbound = (paneId: string): boolean =>
    paneHasPendingQuestion(paneId) || flushingPanes.has(paneId)
  // Persist the defer-while-waiting backlog to disk so a reload (a deliberate
  // `tg-ctl restart`, a launchd bootout/bootstrap, or a crash-relaunch) doesn't
  // silently drop the human's queued messages (graceful-reload). Best-effort like
  // routes/questions: a persist failure must never break the hot enqueue/flush
  // path — the backlog simply isn't durable until the next mutation. The runtime
  // `delivered` flag is dropped; a restored item is re-created with delivered:false.
  const persistDeferred = (): void => {
    try {
      atomicWrite(
        ctx.paths.deferred,
        serializeDeferredStore({
          panes: deferred.snapshot().map(([paneId, items]) => ({
            paneId,
            items: items.map((i) => ({
              text: i.text,
              sourceMessageId: i.sourceMessageId,
              relatedReactionMessageId: i.relatedReactionMessageId,
            })),
          })),
        }),
      )
    } catch (err) {
      log(`deferred backlog persist failed: ${err}`)
    }
  }
  // Restore the durable backlog on bootstrap. Items re-enter the SAME per-pane
  // queues; each pane's restored question (restored into abandonedButtons above)
  // flushes this backlog when it is answered (lateDeliver → onQuestionReleased).
  // Until then the items wait — never pasted into a still-open prompt. Malformed
  // state degrades to "no restored backlog" (parseDeferredStore never throws).
  {
    const restored = parseDeferredStore(readFileOrNull(ctx.paths.deferred))
    if (restored.panes.length) {
      deferred.restore(
        restored.panes.map(
          (p): [string, DeferredInbound[]] => [
            p.paneId,
            p.items.map((i) => ({
              text: i.text,
              sourceMessageId: i.sourceMessageId,
              relatedReactionMessageId: i.relatedReactionMessageId,
              delivered: false,
            })),
          ],
        ),
      )
      const count = restored.panes.reduce((n, p) => n + p.items.length, 0)
      log(`deferred backlog restored: ${count} message(s) across ${restored.panes.length} pane(s)`)
    }
  }
  // Enqueue only — the caller queues the source-message ack reaction when this
  // came from a MESSAGE action (which earns a ⏳ ack); a button-callback defer
  // edits its prompt instead and must NOT leak onto the next message's ack.
  const enqueueDeferred = (
    paneId: string,
    wrappedText: string,
    sourceMessageId: number | null,
    relatedReactionMessageId: number | null = null,
  ): DeferredInbound => {
    const item = { text: wrappedText, sourceMessageId, relatedReactionMessageId, delivered: false }
    deferred.enqueue(paneId, item)
    persistDeferred()
    return item
  }
  const markDeferredForAck = (item: DeferredInbound): void => {
    queueAckReaction(item.sourceMessageId, DEFER_REACTION, () => !item.delivered)
  }
  const injectDeferredOne = async (paneId: string, item: DeferredInbound): Promise<boolean> => {
    // Must NEVER throw: a throw here rejects driveFlush, which (a) loses the
    // already-taken batch and (b) becomes an unhandled rejection in the
    // fire-and-forget flushDeferred call. executeInjectSteps normally returns
    // {ok:false} on tmux errors, but a spawn/exception could still escape — treat
    // any throw as a failed paste (drop + log), exactly like {ok:false}.
    try {
      const res = await executeInjectSteps(buildTextInjectPlan(paneId, item.text))
      if (!res.ok) log(`deferred flush into ${paneId} failed: ${res.error}`)
      if (!res.ok) return false
    } catch (err) {
      log(`deferred flush into ${paneId} threw: ${err}`)
      return false
    }
    item.delivered = true
    await setSeenReactions(item.sourceMessageId, item.relatedReactionMessageId)
    return true
  }
  const flushDeferred = async (paneId: string): Promise<void> => {
    if (!deferred.has(paneId)) return
    // Re-entrancy guard: two answers for the same pane could both reach here (the
    // action loop awaits each, but flushDeferred is fire-and-forget). The flag
    // also routes new inbound into the queue for the whole flush (FIFO).
    if (flushingPanes.has(paneId)) return
    flushingPanes.add(paneId)
    try {
      // Let the agent consume the just-delivered answer before the first paste.
      await Bun.sleep(800)
      // Drain in rounds: each round takes the current queue and feeds it to
      // driveFlush (which re-checks paneHasPendingQuestion before EVERY paste).
      // A round can leave a tail only when a NEW question opens between pastes.
      // Re-defer that tail and pause until that question's answer/release runs
      // flushDeferred again. Fresh messages enqueued DURING a round are drained
      // next round while the pane stays free; otherwise they'd sit until the next
      // unrelated question. Inject FAILURES do NOT re-defer: there may be no
      // future question to flush them, so they are logged + dropped rather than
      // wedging the queue forever (review finding).
      for (;;) {
        const queue = deferred.take(paneId)
        if (queue.length === 0) return
        const outcome = await driveFlush(
          queue,
          () => paneHasPendingQuestion(paneId),
          (item) => injectDeferredOne(paneId, item),
        )
        if (outcome.reDeferred.length > 0) {
          deferred.redefer(paneId, outcome.reDeferred)
          log(`deferred flush into ${paneId} paused — ${outcome.reDeferred.length} item(s) re-queued behind a new question`)
          return
        }
        // Stop if a question is now open (its answer re-triggers the flush) or the
        // queue is empty; else loop to drain anything enqueued during this round.
        if (paneHasPendingQuestion(paneId) || !deferred.has(paneId)) return
      }
    } finally {
      flushingPanes.delete(paneId)
      // The queue changed (drained and/or re-deferred) — keep the durable backlog
      // in sync so a reload restores exactly what is still queued. Persisting once
      // HERE (not per delivered item) means a hard SIGKILL mid-flush — after some
      // items typed into the pane but before this runs — leaves those already-
      // delivered items still on disk, so a restart RE-PASTES them: at-least-once,
      // a deliberate bias to no-LOSS over no-duplicate (persisting after each take
      // would instead lose the not-yet-injected tail on a mid-flush crash — worse).
      // The GRACEFUL path never hits this: the cooperative drain lets the flush
      // finish before exit; only a SIGKILL escalation (past GRACEFUL_SHUTDOWN_MS)
      // can duplicate, and a duplicate queued line is far less bad than a lost one.
      persistDeferred()
    }
  }
  // A scoped question's hook socket closed while the agent may still be waiting in
  // its terminal fallback. Unlike a true abandon/dead card, the Telegram question
  // remains visible and answerable by reply-text, so the pane backlog should not be
  // reported as lost. Let the normal drain deliver queued messages in FIFO order.
  const releaseQueuedBacklog = (paneId: string, label: string, errorLabel: string): void => {
    // A flush is already draining this pane, so it owns the queue and will flip
    // source reactions on delivery. Nothing else to schedule here.
    if (flushingPanes.has(paneId)) {
      log(`${label} on ${paneId} mid-flush — drain already owns queued message(s)`)
      return
    }
    if (!deferred.has(paneId)) {
      log(`${label} on ${paneId} — no queued message(s)`)
      return
    }
    // Another question is still pending on this pane: its answer will flush the
    // queue legitimately, so leave it (the queue is keyed by PANE, not question).
    if (paneHasPendingQuestion(paneId)) {
      log(`${label} on ${paneId} — queued message(s) remain behind another live question`)
      return
    }
    log(`${label} on ${paneId} — flushing queued message(s)`)
    flushDeferred(paneId).catch((err) => log(`flushDeferred ${errorLabel} error: ${err}`))
  }
  const onQuestionTerminalFallback = (paneId: string): void =>
    releaseQueuedBacklog(paneId, "question terminal-fallback", "terminal-fallback")
  // A forwarded question was removed WITHOUT a Telegram answer (timeout / hook
  // socket close / send failure). Once the pending guard is gone, queued inbound
  // should be delivered in FIFO order rather than forcing the user to resend it.
  //
  // The queue is keyed by PANE, not by question, so it may hold items that belong
  // to a DIFFERENT outstanding handler on the same pane. Flush ONLY when the pane
  // is otherwise idle: skip if a flush is in flight (it owns + will deliver the
  // queue) or another question is still pending (its answer will flush). Flushing
  // in either case would disturb another handler's messages (review finding).
  const onQuestionReleased = (paneId: string): void =>
    releaseQueuedBacklog(paneId, "question released", "question-release")
  // An UNSCOPED question (no paneId — hook ran without TMUX_PANE) was removed
  // WITHOUT a Telegram answer (timeout / socket close / send failure). It defers
  // inbound for ANY pane (paneHasPendingQuestion's `if (!pb.req.paneId) return
  // true`), so its stranded backlog can sit on SEVERAL panes at once and there is
  // no single pane id on the question itself. Sweep every pane that still holds a
  // backlog through the SAME per-pane release guard: onQuestionReleased skips a
  // pane that has ANOTHER pending question (its answer flushes legitimately) or an
  // in-flight flush (it owns the queue), so this never disturbs a different live
  // question's items.
  //
  // CALLER CONTRACT: invoke this only AFTER the unscoped entry is removed from
  // `pendingButtons`. While it is still present, paneHasPendingQuestion returns
  // true for EVERY pane (its own `!paneId` arm), so every sweep call would skip.
  // Removing it first lets the guard see the real post-removal state (flush an
  // idle pane, leave one with a live question).
  const onUnscopedRelease = (): void => {
    for (const paneId of deferred.panesWithBacklog()) onQuestionReleased(paneId)
  }
  const questionRuntime: QuestionRuntime = {
    pending: pendingButtons,
    activeKeys: activeButtonKeys,
    abandoned: abandonedButtons,
    answered: answeredButtons,
    persist: persistQuestions,
    onRelease: onQuestionReleased,
    onTerminalFallback: onQuestionTerminalFallback,
    onUnscopedRelease,
    grants: grantsData,
    persistGrants,
    onHatchExpired,
  }
  let hookServer: Server | null = null
  const cleanExit = (code: number): never => {
    // Flush the durable defer-while-waiting backlog on EVERY exit path (graceful
    // drain, idle-exit, SIGINT, AND the hard-exit fallback timer) so the last
    // queue mutations are never lost — the timer used to call cleanExit directly,
    // skipping the persist the cooperative paths do. Best-effort; a persist error
    // must never keep the daemon from vacating.
    try {
      persistDeferred()
    } catch {}
    // Remove the pidfile ONLY when it still names OUR pid (tg#93). On a launchd
    // relaunch a newer instance can take ownership and rewrite the pidfile with
    // ITS pid before this departing daemon's cleanExit runs; a blind unlink would
    // then delete the LIVE successor's pidfile, and `tg-ctl status` would read no
    // pid and falsely report "not running" while the real daemon is long-polling.
    try {
      if (ownsPidFile(readFileOrNull(ctx.paths.pid), process.pid)) unlinkSync(ctx.paths.pid)
    } catch {}
    try {
      hookServer?.close()
    } catch {}
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    process.exit(code)
  }
  // Graceful exit that first DRAINS any in-flight deferred flush (codex #198).
  // Answering a question starts flushDeferred(pane) fire-and-forget — an 800ms
  // settle, then the queued backlog is pasted and the store re-persisted. Exiting
  // (cleanExit) while that flush is mid-settle would snapshot a queue that is
  // either still full but has no pending question left to release it (wedged after
  // restart) or half-taken by the flush (dropped items). So wait for flushingPanes
  // to empty before cleanExit persists the now-consistent backlog. Bounded: the
  // GRACEFUL_SHUTDOWN_MS backstop timer (beginGracefulShutdown) force-cleanExits a
  // flush that hangs, and a second SIGTERM gives up immediately.
  const cleanExitAfterFlushDrain = async (): Promise<never> => {
    while (flushingPanes.size > 0) await Bun.sleep(50)
    return cleanExit(0)
  }
  // Cooperative graceful shutdown (graceful-reload). A launchd bootout/bootstrap
  // reload — and `tg-ctl restart` — SIGTERMs the daemon. An IMMEDIATE cleanExit
  // mid-batch would drop the current getUpdates batch's not-yet-executed actions
  // (the offset is persisted BEFORE acting → at-most-once: those messages are lost
  // and Telegram won't redeliver them). Instead, SIGTERM sets a flag and aborts
  // only the IDLE long-poll; the loop finishes the in-flight batch's actions, then
  // exits at the top of the next iteration — so a batch that drains within
  // GRACEFUL_SHUTDOWN_MS misses no update across the swap. The hard-exit fallback
  // bounds a hung/oversized batch: if the remaining actions exceed the ceiling it
  // exits mid-batch and that tail is lost at-most-once (the normal non-graceful
  // behaviour) — in practice a batch is a few send-keys, far under the ceiling.
  // (launchd would SIGKILL after its own grace period regardless.)
  let shuttingDown = false
  let pollAbort: AbortController | null = null
  const beginGracefulShutdown = (): void => {
    if (shuttingDown) {
      cleanExit(0) // a second SIGTERM → give up on draining and go now
    }
    shuttingDown = true
    log("SIGTERM — draining in-flight batch, then exiting (graceful reload)")
    pollAbort?.abort() // wake the idle long-poll immediately
    setTimeout(() => cleanExit(0), GRACEFUL_SHUTDOWN_MS).unref?.()
  }
  process.on("SIGTERM", beginGracefulShutdown)
  // SIGINT (interactive Ctrl-C / explicit kill -INT) exits immediately — a human
  // at a terminal wants it gone now, not a drain.
  process.on("SIGINT", () => cleanExit(0))
  // A backoff/idle sleep that returns EARLY once a graceful shutdown begins, so a
  // reload during an error/409 backoff doesn't wait out the full delay before the
  // loop can see `shuttingDown` and exit (keeping the drain — and thus the
  // restart hand-off — snappy). Polled in small steps rather than racing a timer
  // against the signal.
  const drainAwareSleep = async (ms: number): Promise<void> => {
    const start = Date.now()
    while (!shuttingDown) {
      const remaining = ms - (Date.now() - start)
      if (remaining <= 0) return
      await Bun.sleep(Math.min(200, remaining))
    }
  }

  hookServer = startHookServer(ctx, questionRuntime)

  if (ctx.cfg.transport === "channel") {
    log("transport 'channel' is reserved for v1.2+ — falling back to tmux")
  }

  let offset = readOffset(readFileOrNull(ctx.paths.offset))
  let lastAgentSeenMs = Date.now() // grace period from daemon start
  let consecutive409 = 0
  let warned409 = false

  // The pane of the CTO's OWN last resolved inbound delivery (tg-cli#78 anchor
  // fix, live incident 2026-08-19/20). The PRIOR mechanism (`lastMessagePane`
  // over routes.json) tracked "who spoke last" — ANY pane's outbound `tg` send,
  // including an agent proactively messaging the CTO unprompted. That was the
  // wrong anchor for a fresh non-reply: it let an unrelated agent's inbound-to-CTO
  // message hijack the CTO's very next message. His own fix, verbatim: "всегда
  // есть самое последнее сообщение его и нужно использовать для определения
  // адресата". Written only in recordLastUserTarget below, on a CONFIRMED
  // delivery to the CTO's own inbound (auto-bound, a picker/`/agent` selection,
  // or a recognized reply) — never on an agent's own outbound send, and never on
  // a failed/unconfirmed attempt. `resolveLastUserTarget` itself (pane-id-reuse
  // guard included) is shared with resolveTasksScopeDir's `/tasks` default
  // scoping (top-level function, above) so both surfaces agree on "the default
  // target" — see that function's docstring.

  // `cwd` is REQUIRED (not optional) — a delivery whose target pane has no known
  // panePath is skipped entirely rather than recorded with an empty cwd: an empty
  // cwd can never pass routeMatchesPane's guard on a later resolve (it fails
  // closed), so writing it would just poison the anchor file with a permanently
  // dead entry until some later delivery happens to overwrite it (review
  // finding). No dedupe-on-unchanged check — see the module docstring on why `ts`
  // is intentionally not staleness-bearing; a plain unconditional write keeps this
  // simple and correct (the write itself is a trivial tmp+rename, not worth an
  // extra disk read to maybe skip).
  const invalidateLastUserTarget = (): void => {
    try {
      unlinkSync(ctx.paths.lastUserTarget)
    } catch {
      // Already absent (or unremovable) — either way there's no stale anchor
      // left to worry about.
    }
  }
  // Explicit routing (a picker tap, a confirmed reply, a named /agent) shares
  // this SAME no-cwd/write-failure fail-closed logic with an ordinary auto-bind
  // delivery, deliberately (Opus review finding raised this as asymmetric —
  // "the CTO just explicitly named this pane"). But an explicit choice of a
  // cwd-less pane still can't be recorded as a pane-id-reuse-safe anchor
  // (architecture review, module docstring: cwd is REQUIRED, invalid states are
  // not representable), and silently KEEPING a stale anchor pointing at whatever
  // pane the CTO addressed BEFORE this explicit choice would be actively wrong,
  // not just imprecise — he just moved away from it. Between "the next ambiguous
  // message asks once more" and "silently routes to a pane the CTO explicitly
  // left", asking is the safer failure, so both paths invalidate the same way.
  const recordLastUserTarget = (paneId: string, cwd: string | undefined): void => {
    // "does the anchor already point at THIS pane" is read LAZILY — only inside
    // the two branches that actually need it (the no-cwd branch, the
    // write-failure catch) — not unconditionally up front (performance review
    // finding, raised twice): the overwhelmingly common case (cwd present,
    // write+rename succeeds) never touches this read at all.
    const readCurrent = (): LastUserTarget | null => parseLastUserTarget(readFileOrNull(ctx.paths.lastUserTarget))
    if (!cwd) {
      // A confirmed delivery whose pane has no known cwd can't record a
      // pane-id-reuse-safe anchor. If the CURRENT anchor already points at this
      // SAME pane, it already carries a good cwd from an earlier delivery —
      // invalidating here would be pure loss, not a safety fix (Opus review
      // finding: an ordinary auto-bound delivery to the pane the anchor already
      // trusts would otherwise wipe it every time panePath happens to come back
      // empty). Only when the anchor points elsewhere (or doesn't exist) is a
      // missing cwd genuinely ambiguous about which pane the CTO is actually
      // addressing now — invalidate so the next ambiguous message asks rather
      // than trusting outdated state (design review finding: that's fail-OPEN on
      // the wrong pane, not fail-closed).
      if (readCurrent()?.paneId === paneId) return
      invalidateLastUserTarget()
      return
    }
    const tmp = `${ctx.paths.lastUserTarget}.tmp.${process.pid}`
    try {
      writeFileSync(tmp, serializeLastUserTarget({ paneId, cwd, ts: Math.floor(Date.now() / 1000) }), { mode: 0o600 })
      renameSync(tmp, ctx.paths.lastUserTarget)
    } catch {
      // A failed renameSync (write succeeded, rename didn't) leaves the tmp file
      // on disk carrying the same sensitive pane id + cwd the denylist protects
      // (Opus review finding) — clean it up best-effort rather than leaving an
      // orphan. The pid suffix means it would be overwritten next time anyway,
      // but a crash before that next call would otherwise leave it indefinitely.
      try {
        unlinkSync(tmp)
      } catch {
        // Nothing to clean up, or unremovable — either way, not worth failing over.
      }
      // A transient write failure (disk full, EINTR) while RE-AFFIRMING the
      // SAME target the anchor already correctly holds must NOT destroy that
      // still-valid on-disk copy (Opus review finding) — the stale write only
      // meant to refresh `ts`, so leaving the existing good record in place is
      // strictly better than deleting it. Only a failure to persist a GENUINE
      // target CHANGE is invalidated: leaving the PRIOR (different) anchor in
      // place there would silently keep routing to a stale pane instead of
      // falling back to the picker as intended (review finding).
      if (readCurrent()?.paneId === paneId) return
      invalidateLastUserTarget()
    }
  }

  // The base discovery: §10 priority chain + liveness bookkeeping, NO last-message
  // bind. Used by liveness/history paths that must NOT silently pick an agent. The
  // no-reply bind lives ONLY in discoverForInject below, so it can never leak onto
  // the reply path (which uses handleReplyRoute's own #49 fail-closed, not discover())
  // or the history-attribution path.
  const discover = (): DiscoverResult => {
    const result = discoverTarget(ctx)
    // Agent panes existing — even ambiguous ones — keep the daemon alive.
    if (result.ok || result.candidates.length > 0) lastAgentSeenMs = Date.now()
    return result
  }

  // discover() PLUS the no-reply last-user-message bind (tg-cli#78, anchor fixed
  // 2026-08-20/21): an otherwise-ambiguous NON-reply inbound binds to the pane of
  // the CTO's OWN last resolved message, never to "whichever agent spoke most
  // recently" (routes.json's outbound-send history) — that let an unrelated agent's
  // unprompted message to the CTO hijack his very next message (live incident).
  // This runs BEFORE #76's ambiguous-picker: a fresh message after the CTO's own
  // last one lands in the same place directly; the picker fires only when there is
  // no last-user-target, or its pane is gone / not a candidate. The lookup is LAZY
  // — only on a genuinely ambiguous base result — so the common ok/no-agent path
  // never reads the store. This is the ONLY discovery used by the non-reply INJECT
  // paths (injectViaTarget with autoBind). A no-last-target case stays ambiguous →
  // #76's picker (the unscoped fail-closed, #49).
  const discoverForInject = (): DiscoverResult => {
    const result = discover()
    if (result.ok || result.reason !== "ambiguous") return result
    const hit = resolveLastUserTarget(ctx, result.candidates)
    return hit ? { ok: true, target: hit } : result
  }

  // Prepend the git-state-check banner (git-state.ts) to `text` when `control.git_state_banner`
  // is on (default) AND the destination pane's cwd is mid-flight — uncommitted changes or a
  // non-main/master branch. Scoped to the SILENT auto-bind deliveries only: a fresh, non-reply
  // message that lands in the discovered pane with no human/reply anchor choosing it (plain
  // inject-text, a photo/document notice, a standalone voice transcript). Deliberately NOT applied
  // to reply-route (anchored to a specific prior message — on-topic by construction), topic-route
  // (a per-topic pane, a different targeting model entirely), a /new spawn (a brand-new pane has no
  // prior work to protect), a picker tap (the human explicitly chose that pane), or a message
  // deferred behind an open question (flushed through a separate code path, out of scope here).
  //
  // Never banner a COMMAND passthrough (review catch, PR #153): the flat inject-text action also
  // carries an unrecognized `/command` (e.g. `/compact`, `/clear`) or a `!shell` command VERBATIM so
  // the harness TUI can execute it — updates.ts's textAction only wraps ordinary prose, never a
  // passthrough command. Prepending a banner line ahead of it would push the leading `/` or `!` off
  // the first character, so the harness reads it as plain prompt text instead of a command. A wrapped
  // inject (the normal case) always starts with the injectWrap template, never `/`/`!`, so this guard
  // only ever skips a real passthrough.
  const withGitStateBanner = (panePath: string, text: string): string => {
    // An EMPTY panePath (tmux reporting no pane_current_path) must never reach
    // gitStateForPath (review finding, same bug class as the routeMatchesPane
    // empty-path fix above): `git -C ''` leaves the cwd UNCHANGED, so it would
    // silently check the DAEMON's own inherited cwd — an unrelated repo — and
    // could prepend that repo's git state to a message delivered to an
    // unrelated agent. No path to check → no banner, same as the disabled/
    // command-passthrough cases below.
    if (!ctx.cfg.gitStateBanner || !panePath || text.startsWith("/") || text.startsWith("!")) return text
    const banner = buildGitStateBanner(gitStateForPath(panePath))
    return banner ? `${banner}\n${text}` : text
  }

  const replyContext = (threadId?: number | null): Record<string, unknown> =>
    typeof threadId === "number" ? { message_thread_id: threadId } : {}

  // Resolve a DiscoverResult's ambiguous `TargetPane[]` to the picker's
  // `AgentCandidate[]` (window names + cwd → distinct labels). The TargetPane
  // shape carries no window name, so re-derive over a fresh listAgentCandidates()
  // snapshot, keeping ONLY the discovery-narrowed panes that are STILL a live
  // agent candidate. A pane that raced away between the two snapshots (or no
  // longer passes the agent-candidate criterion) drops out — the picker shows
  // only panes a tap can actually route into, never a synthetic button into a
  // dead/non-agent pane. The set/discovery layer already guarantees ≥2 live
  // candidates on the ambiguous path, so the result is non-empty in practice; if
  // a freak full race emptied it, postRoutePicker/postSelectPicker fall back to
  // the no-agent reply rather than an empty button set.
  const candidatesForPicker = (panes: TargetPane[]): AgentCandidate[] => {
    const want = new Set(panes.map((c) => c.pane.paneId))
    return listAgentCandidates().filter((c) => want.has(c.paneId))
  }

  // The "not found" reply for a target that genuinely has NO agent. The ambiguous
  // case never reaches here anymore — it posts the inline-keyboard PICKER (buttons,
  // like /agent) instead of the old plain-text candidate dump (tg-cli#72). Kept as
  // a tiny helper for the no-agent message + the /kill path's reuse.
  const replyNoAgent = async (): Promise<void> => {
    await sendMessage(ctx, noAgentReplyNow())
  }

  // Pick a target, run the plan; every failure mode turns into a TG reply so
  // the human is never left wondering whether the message landed. Returns
  // true only when the plan actually executed — the caller uses it to decide
  // whether the source message earns its 👀 delivery receipt.
  //
  // `autoBind` (default off, tg-cli#78) opts a HARMLESS content inject
  // (text/photo/voice) into the no-reply last-message bind: an otherwise-ambiguous
  // non-reply message lands on the agent of the LAST MESSAGE in the chat FIRST
  // (discoverForInject), so the picker below fires LESS often. It is OFF for control
  // keys (/stop's Escape) — interrupting a GUESSED agent is the wrong default; an
  // ambiguous control verb asks.
  //
  // When the target is STILL ambiguous (auto-bind off, or no last message to prefer)
  // and the inject carries routable text, it posts the agent PICKER (tappable buttons,
  // tg-cli#76) and arms the pending route — a tap injects `deferText` verbatim, exactly
  // like the /agent picker. A control verb with no text (inject-key /stop) has nothing
  // to route through a tap, so it falls back to the picker WITHOUT a pending route
  // (select-only) — the buttons still tell the human which agents are live, not a
  // text dump.
  // `buildPlan` receives the resolved TargetPane (not a bare paneId): the git-state-check banner
  // (git-state.ts) needs the pane's `panePath` (cwd) to check, and that path only exists on the
  // TargetPane `found` resolves to HERE — never re-`discover()`/re-`snapshot()` inside a caller to
  // look it up by paneId alone, which would race against (and could disagree with) the pane this
  // function actually delivers into.
  const injectViaTarget = async (
    buildPlan: (target: TargetPane) => InjectStep[],
    deferText?: string,
    autoBind = false,
    sourceMessageId: number | null = null,
  ): Promise<boolean> => {
    const found = autoBind ? discoverForInject() : discover()
    if (!found.ok) {
      // Routable text present (a real message) → route picker: a tap injects it
      // verbatim. Empty/whitespace deferText is treated as "no text" (same rule as
      // postAgentPicker's selectOnly), so it never arms a pending route that would
      // inject nothing on tap.
      if (found.reason === "ambiguous" && deferText !== undefined && deferText.trim() !== "") {
        return postRoutePicker(candidatesForPicker(found.candidates), deferText, undefined, sourceMessageId)
      }
      if (found.reason === "ambiguous") {
        // No routable text (a /stop with several agents): show the live agents as
        // a select-only picker rather than dumping them as text. A select-only tap
        // does NOT re-run the control verb (it only hands back the selector), so
        // the verb did NOT execute — return false so the source message earns no
        // 👀 "delivered" receipt (matching the kill-agent ambiguous branch below
        // and this function's "true only when the plan executed" contract).
        await postSelectPicker(candidatesForPicker(found.candidates))
        return false
      }
      if (found.reason === "no-agent" && deferText !== undefined && deferText.trim() !== "") {
        const candidates = listAgentCandidates()
        if (candidates.length === 1) {
          log(`inject: no tmux pane, sole candidate ${candidates[0].paneId}/${candidates[0].windowName}`)
          return injectPrewrappedToPane(candidates[0].paneId, deferText, sourceMessageId, candidates[0].panePath ?? "/")
        }
        if (candidates.length > 1) {
          if (autoBind) {
            const anchored = resolveLastUserTargetCandidate(ctx, candidates)
            if (anchored) {
              log(`inject: no tmux pane, anchor bind ${anchored.paneId}/${anchored.windowName}`)
              return injectPrewrappedToPane(anchored.paneId, deferText, sourceMessageId, anchored.panePath ?? "/")
            }
          }
          return postRoutePicker(candidates, deferText, undefined, sourceMessageId)
        }
      }
      await replyNoAgent()
      return false
    }
    const paneId = found.target.pane.paneId
    const textPreview = deferText?.slice(0, 60).replace(/\n/g, " ")
    log(`inject: target=${paneId} autoBind=${autoBind} text="${textPreview ?? "(key)"}"`)
    const recordIfAutoBound = () => {
      if (autoBind) recordLastUserTarget(paneId, found.target.pane.panePath)
    }
    if (preferOmpApiOverTmux(found.target.agent)) {
      if (deferText === undefined) {
        log(`inject: omp target=${paneId} — refusing tmux send-keys for a control verb`)
        await sendMessage(ctx, "omp is controlled via ACP — not injecting keys into the pane")
        return false
      }
      if (shouldDeferInbound(paneId)) {
        markDeferredForAck(enqueueDeferred(paneId, deferText, sourceMessageId))
        recordIfAutoBound()
        return true
      }
      const live = liveOmpForPane(paneId, found.target.agentPid)
      const cwd = found.target.pane.panePath || live?.cwd || "/"
      log(`inject: omp ACP pane=${paneId} cwd=${cwd} (not tmux send-keys)`)
      const result = await promptOmpAcp(live ?? { cwd, pid: found.target.agentPid }, deferText)
      if (!result.ok) {
        log(`inject aborted: ${result.error}`)
        await sendMessage(ctx, result.error)
        return false
      }
      recordIfAutoBound()
      return true
    }
    if (deferText !== undefined && shouldDeferInbound(paneId)) {
      markDeferredForAck(enqueueDeferred(paneId, deferText, sourceMessageId))
      recordIfAutoBound()
      return true
    }
    const result = await executeInjectSteps(buildPlan(found.target))
    if (!result.ok) {
      log(`inject aborted: ${result.error}`)
      await sendMessage(ctx, result.error)
      return false
    }
    recordIfAutoBound()
    return true
  }

  // Inject a wrapped message into ONE specific pane (the /agent target). The
  // plan's verify-pane step still re-checks the pane hosts an agent first.
  const injectToPane = async (
    paneId: string,
    from: string,
    msg: string,
    sourceMessageId: number | null,
    deferReactionViaAck = false,
  ): Promise<{ ok: boolean; error?: string; deferred?: boolean; deferredItem?: DeferredInbound }> => {
    // `sourceMessageId` was accepted here for deferred-queue bookkeeping (see
    // enqueueDeferred below) but never forwarded into wrapInbound — every
    // /agent-routed inbound (direct hit, defer flush, and the ambiguous-picker
    // confirm) silently lost its `tg#<id>` wrap tag while the generic
    // auto-bind inject path (which does pass its messageId) kept it. Forward
    // it here so `/agent <selector> <text>` gets the same `tg#<id>` tag as
    // every other inbound path.
    const wrapped = wrapInbound(ctx.cfg.injectWrap, from, msg, sourceMessageId ?? undefined)
    if (paneId.startsWith("omp:")) {
      const pid = Number(paneId.slice("omp:".length))
      const live = listLiveOmpAgents().find((a) => a.pid === pid)
      if (!live) return { ok: false, error: `omp ${paneId} is no longer running` }
      const cwd = live.cwd ?? "/"
      log(`injectToPane: omp ACP pane=${paneId} cwd=${cwd} (not tmux send-keys)`)
      const res = await promptOmpAcp(live, wrapped)
      return res.ok ? { ok: true } : { ok: false, error: res.error }
    }
    if (shouldDeferInbound(paneId)) {
      const item = enqueueDeferred(paneId, wrapped, sourceMessageId)
      if (deferReactionViaAck) markDeferredForAck(item)
      return { ok: true, deferred: true, deferredItem: item }
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === paneId)
    const hosted = pane ? findAgentInPane(pane, procs) : null
    if (hosted?.agent === "omp") {
      const live = liveOmpForPane(paneId, hosted.pid)
      const cwd = pane?.panePath || live?.cwd || "/"
      log(`injectToPane: omp ACP pane=${paneId} cwd=${cwd} (not tmux send-keys)`)
      const res = await promptOmpAcp(live ?? { cwd, pid: hosted.pid }, wrapped)
      return res.ok ? { ok: true } : { ok: false, error: res.error }
    }
    const res = await executeInjectSteps(buildTextInjectPlan(paneId, wrapped))
    return res.ok ? { ok: true } : { ok: false, error: res.error }
  }

  // `label` identifies the chosen agent: `<window> · <agent>` for a direct/
  // confident route, or the picker's DISTINCT label (cwd-derived) when several
  // agents shared a bare window name — so the confirmation never reads an
  // ambiguous "4 · claude".
  const routedReply = (label: string, deferred?: boolean): string =>
    deferred ? `⏳ queued for ${label} (answering a question)` : `→ ${label}`

  // The distinct label for `target` within `fleet` (cwd-derived disambiguation),
  // falling back to `<window> · <agent>` if the target isn't in the fleet.
  const labelFor = (target: AgentCandidate, fleet: AgentCandidate[]): string => {
    const i = fleet.indexOf(target)
    return i >= 0 ? distinctLabels(fleet)[i] : `${target.windowName} · ${target.agent}`
  }

  // Resolve + log the gone-agent anchor fallback target shared by handleAgentRoute (text)
  // and routePrewrappedAgentMessage (media) — see agent-match.ts's "gone-agent (dead
  // subagent) fallback" comment for the full rationale. `allowed` is the caller's
  // topic-scope gate (the text route passes `action.threadId == null`; the media route
  // always passes `true` — a topic message never carries media through this handler at
  // all, `topicActionFor` acks it before the flat photo/document dispatch ever runs, so
  // no such guard is needed there). Returns null when there is no live anchor to try (or
  // the caller disallowed it); the caller then keeps its explicit "no agent matching" error.
  const resolveGoneAgentAnchor = (
    logPrefix: string,
    selector: string,
    candidates: AgentCandidate[],
    allowed: boolean,
  ): { anchor: AgentCandidate; label: string } | null => {
    if (!allowed) return null
    const anchor = resolveLastUserTargetCandidate(ctx, candidates)
    if (!anchor) return null
    const label = labelFor(anchor, candidates)
    log(`${logPrefix}: selector="${selector}" → gone → anchor fallback ${anchor.paneId}/${anchor.windowName}`)
    return { anchor, label }
  }

  const armSelectedAgentRoute = (target: AgentCandidate, label: string, messageId: number | null, threadId: number | null): string => {
    const previous = cancelSelectedAgentRoute()
    if (previous && previous.messageId !== null && previous.messageId !== messageId) {
      void editMessageText(ctx, previous.messageId, `cancelled ${previous.label} — replaced by another selection`)
    }
    const token = `s${++selectedAgentTokenSeq}`
    const timer = setTimeout(() => {
      if (selectedAgentRoute?.token !== token) return
      selectedAgentRoute = null
      if (messageId !== null) void editMessageText(ctx, messageId, `selected ${label} — expired`)
    }, SELECTED_AGENT_TTL_MS)
    selectedAgentRoute = { token, paneId: target.paneId, label, messageId, threadId, timer }
    return token
  }

  // Post the session-grouped inline-keyboard agent PICKER and arm its pending
  // selection. `message` empty ⇒ a select-only picker; bare `/agent` additionally
  // sets `armNextMessage` so a tap routes the next ordinary inbound message.
  // Non-empty ⇒ the route picker (a tap injects the message). Returns false only
  // when the picker send itself failed.
  const postAgentPicker = async (
    subset: AgentCandidate[],
    message: string,
    sourceMessageId: number | null,
    options: { armNextMessage?: boolean; messageExtra?: Record<string, unknown>; threadId?: number | null; notice?: string } = {},
  ): Promise<boolean> => {
    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, message, false, options.notice)
    const messageExtra = options.messageExtra ?? {}
    const messageId = await sendMessage(ctx, payload.text, { ...messageExtra, reply_markup: payload.reply_markup })
    // Picker send failed (Telegram rejected / >4096-char list / network): do NOT
    // store a pending route it can never resolve, and do NOT earn a 👀 receipt.
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>", messageExtra)
      return false
    }
    const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
    pendingAgent.set(token, {
      message,
      candidates: subset,
      messageId,
      sourceMessageId,
      relatedReactionMessageId: null,
      timer,
      selectOnly: message.trim() === "",
      armNextMessage: message.trim() === "" && options.armNextMessage === true,
      threadId: options.threadId ?? null,
    })
    if (message.trim() !== "") queueAckReaction(sourceMessageId, DEFER_REACTION)
    return true
  }

  // Select-only picker (buttons, no pending route): fallback for an ambiguous
  // control verb that carries no routable text (a /stop or /kill across several
  // agents) — the buttons show the live agents instead of a plain-text dump, and
  // a tap hands back the selector to address one.
  // Guards an empty subset (a freak full race where candidatesForPicker filtered
  // every discovery pane out) → the no-agent reply, never a button-less picker
  // (mirrors postRoutePicker; matches the candidatesForPicker fallback comment).
  const postSelectPicker = async (subset: AgentCandidate[]): Promise<boolean> => {
    if (subset.length === 0) {
      await replyNoAgent()
      return false
    }
    return postAgentPicker(subset, "", null)
  }

  // Route picker for ALREADY-WRAPPED text (a tap injects it VERBATIM, prewrapped:
  // true) — the ambiguous-target path (injectViaTarget) and, with a gone-target
  // `notice`, the reply-route picker. Unlike postReplyPicker it does NOT reorder by
  // LRU/MRU: the ambiguous fleet has no prior reply usage to rank by. Returns false
  // only when the picker send itself failed.
  const postRoutePicker = async (
    subset: AgentCandidate[],
    prewrappedText: string,
    notice?: string,
    sourceMessageId: number | null = null,
    relatedReactionMessageId: number | null = null,
  ): Promise<boolean> => {
    if (subset.length === 0) {
      await replyNoAgent()
      return false
    }
    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, prewrappedText, false, notice)
    const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>")
      return false
    }
    const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
    pendingAgent.set(token, {
      message: prewrappedText,
      candidates: subset,
      messageId,
      sourceMessageId,
      relatedReactionMessageId,
      timer,
      prewrapped: true,
    })
    queueAckReaction(sourceMessageId, DEFER_REACTION)
    return true
  }

  const injectPrewrappedToPane = async (
    paneId: string,
    prewrappedText: string,
    sourceMessageId: number | null,
    // REQUIRED, not optional (review finding): both call sites already have the
    // target's live `panePath` on hand, and an optional `cwd` would let a future
    // caller silently omit it — recordLastUserTarget then treats a missing cwd
    // as "invalidate the anchor" (tg-cli#78), so a forgotten argument here would
    // silently wipe the CTO's anchor on every delivery through this path.
    cwd: string,
  ): Promise<boolean> => {
    if (paneId.startsWith("omp:")) {
      const pid = Number(paneId.slice("omp:".length))
      const live = listLiveOmpAgents().find((a) => a.pid === pid)
      if (!live) {
        await sendMessage(ctx, `omp ${paneId} is no longer running`)
        return false
      }
      const ompCwd = live.cwd ?? "/"
      log(`injectPrewrapped: omp ACP pane=${paneId} cwd=${ompCwd} (not tmux send-keys)`)
      const res = await promptOmpAcp(live, prewrappedText)
      if (!res.ok) {
        await sendMessage(ctx, res.error)
        return false
      }
      recordLastUserTarget(paneId, ompCwd)
      return true
    }
    if (shouldDeferInbound(paneId)) {
      markDeferredForAck(enqueueDeferred(paneId, prewrappedText, sourceMessageId))
      // A media `/agent` caption is an explicit CTO routing choice, same as its
      // text equivalent — record the tg-cli#78 anchor (review finding: this path
      // was the one remaining explicit-routing gap).
      recordLastUserTarget(paneId, cwd)
      return true
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === paneId)
    const hosted = pane ? findAgentInPane(pane, procs) : null
    if (hosted?.agent === "omp") {
      const live = liveOmpForPane(paneId, hosted.pid)
      log(`injectPrewrapped: omp ACP pane=${paneId} cwd=${cwd} (not tmux send-keys)`)
      const res = await promptOmpAcp(live ?? { cwd: cwd || "/", pid: hosted.pid }, prewrappedText)
      if (!res.ok) {
        await sendMessage(ctx, res.error)
        return false
      }
      recordLastUserTarget(paneId, cwd)
      return true
    }
    const res = await executeInjectSteps(buildTextInjectPlan(paneId, prewrappedText))
    if (!res.ok) {
      await sendMessage(ctx, res.error)
      return false
    }
    recordLastUserTarget(paneId, cwd)
    return true
  }

  // A `/agent <selector> <message>` whose selector matched NO tmux pane: try the agents
  // running OUTSIDE tmux (tg-cli#306). An exact match queues the (already wrapped) text
  // to that agent's Stop-hook inbox and replies with WHERE it went and WHEN it arrives;
  // an ambiguous match lists the choices; no match returns null so the caller keeps its
  // legacy "no agent matching" error. Never a silent drop.
  const tryQueueUnreachable = async (
    selector: string,
    from: string,
    text: string,
    wrapped: string,
    messageId: number | null,
    out: Record<string, unknown> = {},
  ): Promise<boolean | null> => {
    const ompHits = matchLiveOmp(selector, listLiveOmpAgents())
    if (ompHits.length > 1) {
      const lines = ompHits.map((a) => `  - ${describeLiveOmp(a)}`)
      await sendMessage(ctx, `'${selector}' matches several omp sessions:\n${lines.join("\n")}`, out)
      return false
    }
    if (ompHits.length === 1) {
      const target = ompHits[0]
      const cwd = target.cwd ?? "/"
      log(`agent-route: selector="${selector}" → omp ACP pid=${target.pid} title=${liveOmpLabel(target)} cwd=${cwd}`)
      const res = await promptOmpAcp(target, wrapped)
      if (!res.ok) {
        await sendMessage(ctx, res.error, out)
        return false
      }
      await sendMessage(ctx, `→ ${liveOmpLabel(target)} · omp (ACP)`, out)
      return true
    }
    const agents = listUnreachableAgents()
    const hits = matchUnreachable(selector, agents)
    if (hits.length === 0) return null
    if (hits.length > 1) {
      const lines = hits.map((a) => `  - ${describeUnreachable(a, 0)}`)
      await sendMessage(ctx, `'${selector}' matches several agents outside tmux — give them distinct --name values:\n${lines.join("\n")}`, out)
      return false
    }
    const target = hits[0]
    const key = unreachableKey(target)
    if (key === null) {
      await sendMessage(ctx, `${unreachableLabel(target)} is outside tmux and has no inbox key (no --name, cwd unresolved) — restart it with --name or inside tmux`, out)
      return false
    }
    // Two live sessions reading ONE inbox (names that sanitize alike, or two unnamed
    // sessions in one cwd) could hand this message to the wrong one — refuse, never guess.
    const clashes = inboxKeyCollisions(target, agents)
    if (clashes.length > 0) {
      const lines = [target, ...clashes].map((a) => `  - ${describeUnreachable(a, 0)}`)
      await sendMessage(ctx, `refusing: inbox key '${key}' is shared by several live sessions — give them distinct --name values:\n${lines.join("\n")}`, out)
      return false
    }
    try {
      queueToInbox(ctx, key, { id: messageId, ts: new Date().toISOString(), from, text, wrapped })
    } catch (err) {
      log(`agent-route: inbox write failed for ${key}: ${err}`)
      await sendMessage(ctx, `${unreachableLabel(target)} is outside tmux and its inbox could not be written: ${err}`, out)
      return false
    }
    log(`agent-route: selector="${selector}" → outside tmux ${key} (pid ${target.pid}) — queued to inbox`)
    await sendMessage(ctx, queuedReplyText(target), out)
    return true
  }

  const routePrewrappedAgentMessage = async (
    route: ParsedAgentCommand,
    prewrappedText: string,
    sourceMessageId: number,
  ): Promise<boolean> => {
    cancelSelectedAgentRouteForAgentCommand()
    const candidates = listAgentCandidates()
    const msgPreview = prewrappedText.slice(0, 60).replace(/\n/g, " ")
    if (candidates.length === 0) {
      if (route.selector) {
        const queued = await tryQueueUnreachable(route.selector, "tg", route.rest, prewrappedText, sourceMessageId)
        if (queued !== null) return queued
      }
      log(`media-agent-route: no candidates — selector=${route.selector || "(none)"} msg="${msgPreview}"`)
      await sendMessage(ctx, noAgentReplyNow())
      return false
    }

    if (route.selector) {
      const m = matchWindows(route.selector, candidates)
      if (m.matches.length > 0) {
        if (m.confident) {
          const target = m.matches[0]
          log(`media-agent-route: selector="${route.selector}" → ${target.paneId}/${target.windowName} confident=true msg="${msgPreview}"`)
          return injectPrewrappedToPane(target.paneId, prewrappedText, sourceMessageId, target.panePath)
        }
        const names = m.matches.map((c) => c.windowName).join(", ")
        log(`media-agent-route: selector="${route.selector}" → ambiguous (${m.matches.length} matches: ${names}) → picker`)
        return postRoutePicker(m.matches, prewrappedText, undefined, sourceMessageId)
      }
      const queued = await tryQueueUnreachable(route.selector, "tg", route.rest, prewrappedText, sourceMessageId)
      if (queued !== null) return queued
      const found = resolveGoneAgentAnchor("media-agent-route", route.selector, candidates, true)
      if (found) {
        const { anchor, label } = found
        const ok = await injectPrewrappedToPane(anchor.paneId, prewrappedText, sourceMessageId, anchor.panePath ?? "/")
        if (ok) {
          recordLastUserTarget(anchor.paneId, anchor.panePath)
          await sendMessage(ctx, goneAgentFallbackReplyText(route.selector, label))
        }
        return ok
      }
      const names = candidates.map((c) => c.windowName).join(", ")
      log(`media-agent-route: selector="${route.selector}" → NO match among [${names}] — reporting error`)
      await sendMessage(ctx, `no agent matching '${route.selector}' (running: ${names}) — try /agent to pick`)
      return false
    }

    if (candidates.length === 1) {
      const target = candidates[0]
      log(`media-agent-route: no selector, single candidate → ${target.paneId}/${target.windowName} msg="${msgPreview}"`)
      return injectPrewrappedToPane(target.paneId, prewrappedText, sourceMessageId, target.panePath)
    }

    log(`media-agent-route: no selector, ${candidates.length} candidates → picker msg="${msgPreview}"`)
    return postRoutePicker(candidates, prewrappedText, undefined, sourceMessageId)
  }

  const injectIntoSelectedAgent = async (prewrappedText: string, sourceMessageId: number): Promise<boolean | null> => {
    const selected = cancelSelectedAgentRoute()
    if (!selected) return null
    const liveFleet = listAgentCandidates()
    const liveTarget = liveFleet.find((c) => c.paneId === selected.paneId)
    if (!liveTarget) {
      await sendMessage(ctx, `selected ${selected.label} is no longer running — routing this message normally`, replyContext(selected.threadId))
      if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, `selected ${selected.label} — agent is no longer running`)
      return null
    }
    const label = labelFor(liveTarget, liveFleet)
    log(`agent-select: next message → ${liveTarget.paneId}/${liveTarget.windowName}`)
    if (!liveTarget.paneId.startsWith("omp:") && shouldDeferInbound(liveTarget.paneId)) {
      markDeferredForAck(enqueueDeferred(liveTarget.paneId, prewrappedText, sourceMessageId))
      if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, routedReply(label, true))
      // An armed one-shot route is the CTO's own prior explicit choice — record
      // it as the tg-cli#78 anchor (review finding: `/agent`-driven routing
      // previously never updated it).
      recordLastUserTarget(liveTarget.paneId, liveTarget.panePath)
      return true
    }
    const text = withGitStateBanner(liveTarget.panePath, prewrappedText)
    const ok = await injectPrewrappedToPane(liveTarget.paneId, text, sourceMessageId, liveTarget.panePath ?? "/")
    if (!ok) {
      if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, "inject failed")
      return false
    }
    if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, routedReply(label, false))
    return true
  }

  // /agent routing (item 1): bare `/agent` → an inline-keyboard PICKER (tappable
  // buttons, one distinct-labelled button per agent); confident phonetic match →
  // direct inject; ambiguous → the same session-grouped picker carrying the pending
  // message; named selector with NO match → error reply, never silent fallback.
  const handleAgentRoute = async (action: Extract<Action, { kind: "agent-route" }>): Promise<boolean> => {
    const out = replyContext(action.threadId)
    cancelSelectedAgentRouteForAgentCommand()
    const candidates = listAgentCandidates()
    const msgPreview = action.all.slice(0, 60).replace(/\n/g, " ")
    if (candidates.length === 0) {
      if (action.selector && action.rest.trim()) {
        const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, action.rest, action.messageId)
        const queued = await tryQueueUnreachable(action.selector, action.from, action.rest, wrapped, action.messageId, out)
        if (queued !== null) return queued
      }
      log(`agent-route: no candidates — selector=${action.selector || "(none)"} msg="${msgPreview}"`)
      await sendMessage(ctx, noAgentReplyNow(), out)
      return false
    }
    if (!action.all.trim()) {
      // Bare `/agent`: tappable picker over EVERY live agent, including
      // out-of-tmux omp (paneId omp:<pid> → ACP). No outside-tmux notice.
      log(`agent-route: bare /agent → picker over ${candidates.length} candidates`)
      return postAgentPicker(candidates, "", null, { armNextMessage: true, messageExtra: out, threadId: action.threadId ?? null })
    }

    if (action.selector) {
      const m = matchWindows(action.selector, candidates)
      if (m.matches.length > 0) {
        if (!action.rest.trim()) {
          // `/agent <name>` with NO message: SELECT that agent as the routing
          // target for the next ordinary message (repair of #158 — a named
          // selection used to only print a hint and never arm a route). A
          // confident single match arms directly; an ambiguous match shows the
          // same select-only picker bare `/agent` uses (a tap arms the route).
          //
          // The one-shot route is a FLAT-CHAT concept: injectIntoSelectedAgent is
          // only consulted on flat inject-text / media, never on a topic-route.
          // A topic-originated `/agent <name>` (threadId set) therefore keeps the
          // plain hint — arming a global route there would only leak into a later
          // flat message and mislead ("send the next message here", codex review).
          if (action.threadId != null) {
            const names = m.matches.map((c) => c.windowName).join(", ")
            await sendMessage(ctx, `matched ${names} — add a message: /agent ${action.selector} <message>`, out)
            return true
          }
          if (m.confident) {
            const target = m.matches[0]
            const label = labelFor(target, candidates)
            log(`agent-route: selector="${action.selector}" → select-only arm ${target.paneId}/${target.windowName}`)
            const cardId = await sendMessage(ctx, `selected ${label}`, out)
            const routeToken = armSelectedAgentRoute(target, label, cardId, null)
            if (cardId !== null) {
              void editMessageText(ctx, cardId, `selected ${label} — send the next message here`, selectedAgentCancelMarkup(routeToken))
            }
            return true
          }
          log(`agent-route: selector="${action.selector}" → ambiguous select-only picker over ${m.matches.length} matches`)
          return postAgentPicker(m.matches, "", action.messageId, { armNextMessage: true, messageExtra: out })
        }
        if (m.confident) {
          const target = m.matches[0]
          log(`agent-route: selector="${action.selector}" → ${target.paneId}/${target.windowName} confident=true msg="${msgPreview}"`)
          const res = await injectToPane(target.paneId, action.from, action.rest, action.messageId, true)
          if (!res.ok) {
            log(`agent-route: inject failed → ${target.paneId}: ${res.error}`)
            await sendMessage(ctx, res.error ?? "inject failed", out)
            return false
          }
          // A named `/agent <name> <msg>` is the CTO explicitly addressing this
          // pane — record it as the tg-cli#78 anchor (review finding: `/agent`
          // routing previously never updated it, unlike the ambiguous picker).
          recordLastUserTarget(target.paneId, target.panePath)
          if (target.paneId.startsWith("omp:")) {
            await sendMessage(ctx, routedReply(labelFor(target, candidates), res.deferred), out)
          }
          return true
        }
        // Ambiguous: multiple matches — show picker over matched subset
        const names = m.matches.map((c) => c.windowName).join(", ")
        log(`agent-route: selector="${action.selector}" → ambiguous (${m.matches.length} matches: ${names}) → picker`)
        return postAgentPicker(m.matches, action.rest, action.messageId, { messageExtra: out, threadId: action.threadId ?? null })
      }
      // Named selector matched NOTHING — never silently fall back to a random agent.
      // Report the miss clearly so the user knows their intent was not routed.
      if (action.rest.trim()) {
        const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, action.rest, action.messageId)
        const queued = await tryQueueUnreachable(action.selector, action.from, action.rest, wrapped, action.messageId, out)
        if (queued !== null) return queued
        // The named target is not live ANYWHERE tg-ctl can see — see agent-match.ts's
        // "gone-agent (dead subagent) fallback" comment for the full rationale. FLAT
        // chat only: a bound topic already carries its own stronger routing signal (the
        // topic's bound pane), so this flat last-user-target anchor — which may point at
        // a DIFFERENT project's pane entirely — must not override it, matching this
        // function's existing "topic-originated /agent keeps the plain hint" precedent
        // above.
        const found = resolveGoneAgentAnchor("agent-route", action.selector, candidates, action.threadId == null)
        if (found) {
          const { anchor, label } = found
          const res = await injectToPane(anchor.paneId, action.from, action.rest, action.messageId, true)
          if (!res.ok) {
            await sendMessage(ctx, res.error ?? "inject failed", out)
            return false
          }
          recordLastUserTarget(anchor.paneId, anchor.panePath)
          await sendMessage(ctx, goneAgentFallbackReplyText(action.selector, label, res.deferred), out)
          return true
        }
      }
      const names = candidates.map((c) => c.windowName).join(", ")
      log(`agent-route: selector="${action.selector}" → NO match among [${names}] — reporting error`)
      await sendMessage(ctx, `no agent matching '${action.selector}' (running: ${names}) — try /agent to pick`, out)
      return false
    }

    // No selector (bare `/agent <message>` with no agent name): route to single
    // candidate directly, or show picker when multiple are running.
    if (candidates.length === 1) {
      const target = candidates[0]
      log(`agent-route: no selector, single candidate → ${target.paneId}/${target.windowName} msg="${msgPreview}"`)
      const res = await injectToPane(target.paneId, action.from, action.all, action.messageId, true)
      if (!res.ok) {
        await sendMessage(ctx, res.error ?? "inject failed", out)
        return false
      }
      // A bare `/agent <message>` with a single live candidate is still a
      // confirmed CTO-explicit delivery — record it as the tg-cli#78 anchor
      // (review finding: this was one of two remaining gaps where a successful
      // delivery never updated the anchor, leaving it stale once a second pane
      // later appears).
      recordLastUserTarget(target.paneId, target.panePath)
      await sendMessage(ctx, routedReply(labelFor(target, candidates), res.deferred), out)
      return true
    }

    log(`agent-route: no selector, ${candidates.length} candidates → picker msg="${msgPreview}"`)
    return postAgentPicker(candidates, action.all, action.messageId, { messageExtra: out, threadId: action.threadId ?? null })
  }

  const handleAgentCallback = async (action: Extract<Action, { kind: "agent-callback" }>): Promise<boolean> => {
    const pending = pendingAgent.get(action.token)
    if (!pending) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    // A tap must come from THIS prompt's Telegram message. After a restart
    // agentTokenSeq reuses tokens (a1, a2…), so a tap on an OLD prompt that
    // reused the token must not consume the new pending route (codex P2).
    if (pending.messageId !== null && action.messageId !== null && action.messageId !== pending.messageId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    const target = pending.candidates[action.index]
    if (!target) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    pendingAgent.delete(action.token)
    clearTimeout(pending.timer)
    // Select-only picker: bare `/agent` arms a one-shot target for the next
    // ordinary inbound message; control pickers only return the selector hint.
    if (pending.selectOnly) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "selected")
      if (pending.messageId !== null) {
        // Build selector/label against the full live fleet, not only the button
        // subset, so a suggested selector can never confidently route elsewhere.
        const live = listAgentCandidates()
        const fleet = live.some((c) => c.paneId === target.paneId) ? live : pending.candidates
        const liveTarget = fleet.find((c) => c.paneId === target.paneId) ?? target
        const label = labelFor(liveTarget, fleet)
        if (pending.armNextMessage) {
          const token = armSelectedAgentRoute(liveTarget, label, pending.messageId, pending.threadId ?? null)
          void editMessageText(ctx, pending.messageId, `selected ${label} — send the next message here`, selectedAgentCancelMarkup(token))
        } else {
          const selector = suggestSelector(liveTarget, fleet)
          void editMessageText(ctx, pending.messageId, `selected ${label} — send: /agent ${selector} <message>`)
        }
      }
      return true
    }
    // A reply's pending text already carries its wrap/anchor → inject verbatim;
    // a /agent message is raw → wrap it. Both defer behind an open question. The
    // callback has no trailing ack, so it updates the source reaction directly.
    let res: { ok: boolean; error?: string; deferred?: boolean; deferredItem?: DeferredInbound }
    if (pending.prewrapped) {
      if (!target.paneId.startsWith("omp:") && shouldDeferInbound(target.paneId)) {
        const item = enqueueDeferred(target.paneId, pending.message, pending.sourceMessageId, pending.relatedReactionMessageId)
        res = { ok: true, deferred: true, deferredItem: item }
      } else {
        const ok = await injectPrewrappedToPane(target.paneId, pending.message, pending.sourceMessageId, target.panePath ?? "/")
        res = ok ? { ok: true } : { ok: false, error: "inject failed" }
      }
    } else {
      res = await injectToPane(target.paneId, action.from, pending.message, pending.sourceMessageId)
    }
    // An explicit picker tap is the CTO deliberately choosing this pane — record
    // it as the tg-cli#78 anchor on any confirmed outcome (delivered or queued),
    // never on a failed inject (codex/Opus review finding: explicit routing
    // previously never updated the anchor, leaving an ambiguous fleet asking
    // forever after the very first pick). Every `res` construction above already
    // sets `ok: true` for a deferred outcome too, so `res.ok` alone covers both
    // today — `res.deferred` is included explicitly anyway (Opus review finding)
    // so this stays correct even if a future refactor ever decouples the two.
    if (res.ok || res.deferred) recordLastUserTarget(target.paneId, target.panePath)
    if (res.deferred && pending.sourceMessageId !== null && !res.deferredItem?.delivered) {
      await setReaction(pending.sourceMessageId, DEFER_REACTION)
    } else if (res.ok) {
      await setSeenReactions(pending.sourceMessageId, pending.relatedReactionMessageId)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, res.ok ? (res.deferred ? "queued" : "sent") : "failed")
    if (pending.messageId !== null) {
      void editMessageText(
        ctx,
        pending.messageId,
        res.ok ? routedReply(labelFor(target, pending.candidates), res.deferred) : `inject failed: ${res.error ?? ""}`,
      )
    }
    return res.ok
  }

  const handleAgentCancelCallback = async (action: Extract<Action, { kind: "agent-cancel" }>): Promise<boolean> => {
    const selected = selectedAgentRoute
    if (
      !selected ||
      selected.token !== action.token ||
      (selected.messageId !== null && action.messageId !== null && selected.messageId !== action.messageId)
    ) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    cancelSelectedAgentRoute()
    await answerCallbackQuery(ctx, action.callbackQueryId, "cancelled")
    if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, `cancelled ${selected.label}`)
    return true
  }

  // A reply: route to the recognized origin pane (routes map) or, when unknown,
  // a session-grouped picker ordered LRU/MRU. injectText is injected verbatim
  // everywhere here — for a prose reply it already carries the wrap + quote
  // anchor; for a `!shell` reply it is the RAW `!…` text (codex #192), so `!`
  // stays at column 0 for the harness passthrough.
  const handleReplyRoute = async (
    action: Extract<Action, { kind: "reply-route" }>,
    relatedReactionMessageId: number | null = null,
  ): Promise<boolean> => {
    const routes = parseRoutes(readFileOrNull(ctx.paths.routes))
    const recognized = recognizeRoute(routes, action.replyToMessageId)
    const injectVerbatim = async (paneId: string): Promise<boolean> => {
      const live = matchLiveOmpOrigin(paneId, listLiveOmpAgents())
      if (live) {
        const res = await promptOmpAcp(live, action.injectText)
        if (!res.ok) {
          await sendMessage(ctx, res.error)
          return false
        }
        await setSeenReactions(null, relatedReactionMessageId)
        return true
      }
      if (shouldDeferInbound(paneId)) {
        markDeferredForAck(enqueueDeferred(paneId, action.injectText, action.messageId, relatedReactionMessageId))
        return true
      }
      const res = await executeInjectSteps(buildTextInjectPlan(paneId, action.injectText))
      if (!res.ok) {
        await sendMessage(ctx, res.error)
        return false
      }
      // The source message's own receipt is still handled by the trailing ack
      // action. This branch only adds the related replied-to message receipt.
      await setSeenReactions(null, relatedReactionMessageId)
      return true
    }

    // Post the LRU/MRU-ordered agent picker for this reply and arm its pending
    // selection. Shared by the unrecognized-multi-agent case AND the
    // recognized-but-unconfirmed origin case (a known origin we currently can't
    // SEE must never auto-collapse onto the wrong agent — let the human pick).
    // `notice` prepends a gone-target line ("That agent … is no longer running")
    // when the reply's recorded origin pane is no longer a live, same-project agent.
    const postReplyPicker = async (candidates: AgentCandidate[], notice?: string): Promise<boolean> => {
      const usage = aggregateUsage(routes)
      const order = orderByLruMru(candidates.map((c) => c.paneId), usage)
      const byPane = new Map(candidates.map((c) => [c.paneId, c]))
      const sorted = order.map((pid) => byPane.get(pid)!).filter(Boolean)
      const token = `a${++agentTokenSeq}`
      // preserveOrder: keep the LRU/MRU ranking — groupBySession must not re-sort.
      const payload = buildAgentSelectMessage(ctx.chatId, sorted, token, action.injectText, true, notice)
      const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
      if (messageId === null) {
        await sendMessage(ctx, "couldn't post the reply picker")
        return false
      }
      const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
      pendingAgent.set(token, {
        message: action.injectText,
        candidates: sorted,
        messageId,
        sourceMessageId: action.messageId,
        relatedReactionMessageId,
        timer,
        prewrapped: true,
      })
      queueAckReaction(action.messageId, DEFER_REACTION)
      return true
    }

    // A human label for the GONE origin agent of this recognized reply — the
    // project dir (cwd basename) it was recorded against, else its pane id. Used
    // in the picker notice so the CTO sees WHICH agent vanished, not just "an agent".
    const goneOriginLabel = (): string => {
      const cwd = recognized?.cwd
      if (cwd) {
        const base = cwd.replace(/\/+$/, "").split("/").pop()
        if (base) return base
      }
      return recognized?.paneId ?? "the agent you replied to"
    }
    const goneNotice = (): string => `That agent (${goneOriginLabel()}) is no longer running — pick a live one:`

    const msgPreview = action.injectText.slice(0, 60).replace(/\n/g, " ")
    if (recognized) {
      const liveHit = matchLiveOmpOrigin(recognized.paneId, listLiveOmpAgents())
      if (liveHit) {
        // omp:<pid> is the live process (pid identity). Do not require cwd match:
        // tg often runs from /tmp while liveHit.cwd is the session dir (Codex P1 #340).
        if (ompReplyOriginMatches(recognized, liveHit)) {
          log(`reply-route: replyTo=${action.replyToMessageId} → ${recognized.paneId} omp ACP pid=${liveHit.pid} msg="${msgPreview}"`)
          const delivered = await injectVerbatim(recognized.paneId)
          if (delivered) recordLastUserTarget(recognized.paneId, liveHit.cwd ?? "/")
          return delivered
        }
      }
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === recognized.paneId)
      // Route to the origin pane ONLY if it still hosts an agent AND is still the
      // SAME project: a tmux pane id is reused after kill-pane, so a stale
      // message_id→%N map could otherwise inject a reply into a DIFFERENT
      // project's agent — leaking project A's reply into project B (review
      // --brainstorm finding). routeMatchesPane validates the recorded send-path
      // (now the origin pane's path — see tg recordRoute) against the live pane's
      // path; on mismatch (or no recorded cwd for an old route) fall through to
      // the picker rather than risk mis-routing.
      const sameProject = routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: pane?.panePath })
      if (pane && sameProject && findAgentInPane(pane, procs)) {
        log(`reply-route: replyTo=${action.replyToMessageId} → ${recognized.paneId} recognized=true sameProject=true msg="${msgPreview}"`)
        // A confirmed reply is the CTO explicitly addressing this pane — the
        // clearest possible signal for the tg-cli#78 anchor. Recorded only once
        // injectVerbatim confirms delivery (queued-deferred or actually injected),
        // never on a failed inject (codex/Opus review finding).
        const delivered = await injectVerbatim(recognized.paneId)
        if (delivered) recordLastUserTarget(recognized.paneId, pane.panePath)
        return delivered
      }

      // We KNOW the origin pane but the snapshot can't CONFIRM it. snapshot()
      // already retried the transient empty/partial `tmux list-panes` read
      // (panesWithRetry); if it STILL can't see the recognized pane there are two
      // shapes — and the launchd no-locale flake (`no-agent reply: panes=0`) makes
      // a zero/partial snapshot a real, recurring runtime state, not a one-off:
      //   (a) the snapshot returned ZERO/partial panes — origin almost certainly
      //       still alive, just invisible. The OLD code fell through and, when the
      //       partial snapshot left exactly ONE agent visible (deterministically
      //       the last writer of the single global registration slot — [rig]/%2),
      //       silently injected the recognized reply into THAT wrong agent. A
      //       recognized reply must NEVER lose to whatever single agent is visible.
      //   (b) the origin pane is genuinely gone/reused/different-project — the
      //       legitimate fall-through to the picker (04cb6e5).
      // Tell them apart by whether the origin pane appears in the snapshot AT ALL
      // (`pane` IS that lookup — undefined ⇔ not visible). When it is NOT visible,
      // post the PICKER (human disambiguates) instead of the single-candidate
      // auto-inject — never the registration's last-writer pane.
      if (!pane) {
        const candidates = listAgentCandidates()
        if (candidates.length === 0) {
          log(`reply-route: replyTo=${action.replyToMessageId} → origin ${recognized.paneId} invisible, no candidates`)
          await sendMessage(ctx, noAgentReplyNow())
          return false
        }
        // DEAD-SENDER FALLBACK: the origin was a disposable/one-shot sender —
        // a subagent process (or a synthetic omp:<pid> from a headless script,
        // tg-cli#363) dispatched by a live orchestrator, sent once, and exited —
        // so its pane/pid will NEVER become visible again. routes.json still
        // names it, but forcing the human to pick every time loses the reply's
        // content behind a card when the right target is obvious: the live
        // agent that owns the SAME project directory (recognized.cwd) is that
        // sender's parent/active session, and the natural place for a reply
        // meant for its now-gone child. Scoping the auto-route to an EXACT cwd
        // match keeps this narrower than "trust any single visible candidate"
        // (the bug this guard replaced, tg-cli#53): a flaky/partial snapshot
        // that merely drops the origin pane cannot spuriously produce a
        // DIFFERENT pane sharing the exact recorded cwd, so it cannot resurrect
        // that regression. Several same-project candidates are still genuinely
        // ambiguous (which one is "the parent"?) and fall through to the picker.
        const sameProjectCandidates = recognized.cwd
          ? candidates.filter((c) => routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: c.panePath }))
          : []
        if (sameProjectCandidates.length === 1) {
          const parent = sameProjectCandidates[0]
          log(`reply-route: replyTo=${action.replyToMessageId} → origin ${recognized.paneId} gone, routing to live parent ${parent.paneId} (same project ${recognized.cwd}) msg="${msgPreview}"`)
          const delivered = await injectVerbatim(parent.paneId)
          if (delivered && parent.panePath) recordLastUserTarget(parent.paneId, parent.panePath)
          return delivered
        }
        // No single live parent for this project (none, or more than one) —
        // the recognized origin is unconfirmed and ambiguous, so post the
        // picker rather than guess. Name the agent they meant so a genuinely
        // terminated one reads as "that agent is gone" rather than a silent re-ask (CTO ask, #72).
        log(`reply-route: replyTo=${action.replyToMessageId} → origin ${recognized.paneId} NOT visible in snapshot → picker (${candidates.length} candidates, ${sameProjectCandidates.length} same-project)`)
        return postReplyPicker(candidates, goneNotice())
      }
      // origin pane visible but not a same-project agent → genuinely reused/gone;
      // fall through to the normal picker path below (with the gone notice).
      log(`reply-route: replyTo=${action.replyToMessageId} → origin ${recognized.paneId} visible but sameProject=${sameProject} hasAgent=${!!findAgentInPane(pane, procs)} → picker (gone/reused)`)
    }

    const candidates = listAgentCandidates()
    if (candidates.length === 0) {
      log(`reply-route: replyTo=${action.replyToMessageId} → no candidates recognized=${!!recognized}`)
      await sendMessage(ctx, noAgentReplyNow())
      return false
    }
    // An UNRECOGNIZED reply (no origin known) with a single agent is unambiguous —
    // inject there. The recognized-but-unconfirmed case above never reaches here.
    if (!recognized && candidates.length === 1) {
      log(`reply-route: replyTo=${action.replyToMessageId} → unrecognized, single candidate ${candidates[0].paneId}/${candidates[0].windowName} → inject msg="${msgPreview}"`)
      const delivered = await injectVerbatim(candidates[0].paneId)
      // Still a confirmed CTO-explicit delivery — record it as the tg-cli#78
      // anchor (review finding: this was the other remaining gap where a
      // successful delivery never updated the anchor).
      if (delivered) recordLastUserTarget(candidates[0].paneId, candidates[0].panePath)
      return delivered
    }

    // Anything else — several agents, OR a recognized reply that fell through
    // (origin visible but reused/gone) — goes to the LRU/MRU-ordered picker. A
    // recognized reply that reached here KNEW an origin that's now gone (its pane
    // was reused by a different project), so it carries the gone notice; an
    // unrecognized reply never knew an origin, so no notice.
    log(`reply-route: replyTo=${action.replyToMessageId} → ${candidates.length} candidates recognized=${!!recognized} → picker`)
    return postReplyPicker(candidates, recognized ? goneNotice() : undefined)
  }

  // --- forum topics (docs/specs/tg-forum-topics.md §7, §8) ---
  // The binding store is read fresh on each access (like routes) and rewritten on every
  // transition. It is only consulted when control.topics is enabled; with the flag off the
  // store stays empty and topicStatusOf below is never wired into stepUpdates, so the flat
  // 1:1 path is byte-identical.
  const loadTopics = (): TopicBinding[] => parseTopics(readFileOrNull(ctx.paths.topics))
  // A strictly-monotonic nonce for path-button prompts (codex r4 P1): each awaiting-path prompt gets
  // a UNIQUE value so a button from a superseded prompt can be told apart. A wall-clock second is NOT
  // unique enough — two restarts in the same second would reuse it. Seed above `Date.now()` ms so a
  // restart of the DAEMON itself can't collide with a nonce already baked into a live keyboard.
  let pathNonceSeq = Date.now()
  const nextPathNonce = (): number => ++pathNonceSeq
  const persistTopics = (topics: TopicBinding[]): void => {
    // Best-effort, off the inject path: a write error must never break the poll loop — it is
    // logged, not thrown. A lost close/reopen transition leaves the binding at its prior status
    // (e.g. still `bound` after a swallowed close), but that does NOT mis-route: handleTopicRoute
    // re-verifies the pane on the NEXT message and closes a binding whose pane is gone. So the
    // store self-heals on the next routed message rather than relying on another service message.
    try {
      writeFileSync(ctx.paths.topics, serializeTopics(topics), { mode: 0o600 })
    } catch (err) {
      log(`topics persist failed: ${err}`)
    }
  }
  // threadId → current binding status (or null when untracked) for stepUpdates' pure routing.
  const topicStatusOf = (threadId: number): TopicStatus | null => findTopic(loadTopics(), threadId)?.status ?? null
  // sendMessage threaded into a topic — all topic-originated daemon output MUST carry
  // message_thread_id or it lands in General (spec §3).
  const sendToTopic = (threadId: number, text: string): Promise<number | null> =>
    sendMessage(ctx, text, { message_thread_id: threadId })

  // Route an inbound message inside a BOUND topic into that topic's mapped pane. The
  // injectText is already wrapped by stepUpdates. Safety (mirrors handleReplyRoute's
  // routeMatchesPane defense): a tmux pane id is REUSED after kill-pane, so before injecting we
  // require (a) the pane still hosts an agent AND (b) — when the binding recorded a working
  // `path` (every spawn-created binding does) — the live pane's path still matches it, so a
  // DIFFERENT project's agent that inherited the old `%N` can never receive this topic's
  // message. Any failure marks the binding closed and reports into the topic; it NEVER falls
  // through to the flat discovered target (which would leak a topic message into a 1:1 agent).
  const handleTopicRoute = async (action: Extract<Action, { kind: "topic-route" }>): Promise<boolean> => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding || binding.status !== "bound" || !binding.paneId) {
      // stepUpdates saw this topic as 'bound', but a PRIOR action in the SAME batch (a first message
      // to a dead pane) may have already transitioned it. Route this stale second message through the
      // recovery rather than the old "recreate the topic" dead-end (codex r2#1):
      //   - closed → the throttled re-spawn offer (recoverDeadTopic);
      //   - awaiting-* → the first action ALREADY restarted the /new flow (no path/model case), so
      //     the prompt is up; stay quiet (codex r3 P2 — don't re-post the dead-end on top of it).
      // Only a genuinely untracked binding (none) gets the legacy "recreate" hint.
      if (binding && binding.status === "closed") await recoverDeadTopic(binding)
      else if (!binding) await sendToTopic(action.threadId, "this topic's agent is no longer bound — recreate the topic")
      return false
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === binding.paneId)
    if (!pane || findAgentInPane(pane, procs) === null) {
      // FLAKE GUARD (codex r24 P1a, narrowed r26): the flake signature is an EMPTY `procs` read (ps
      // failed/flaked) while the pane IS still visible — findAgentInPane then returns null for a
      // STILL-RUNNING agent, and closing + offering a re-spawn off that blind read would let a tap
      // DUPLICATE the live agent. Gate ONLY on `procs.length === 0` (the actual flake), NOT on "no
      // agent found anywhere": when ps DID return processes but none under this pane is an agent, the
      // agent GENUINELY exited (back to a shell) — that's the real-death case and must still close +
      // offer, even if no other agent happens to be live (codex r26). A gone pane also closes.
      if (pane && procs.length === 0) {
        await sendToTopic(action.threadId, "couldn't confirm this topic's agent right now — try again")
        return false
      }
      // The agent's pane is genuinely GONE / the agent exited → terminal. Mark the binding closed and
      // OFFER A RE-SPAWN (increment 4) — a one-tap re-launch with the retained path + model.
      const closed = markClosed(binding, Math.floor(Date.now() / 1000))
      persistTopics(appendTopic(topics, closed))
      await recoverDeadTopic(closed)
      return false
    }
    // The pane hosts an agent but its path no longer matches the binding's recorded project
    // (pane-id reuse guard). Treat this as NON-terminal and recoverable: a path mismatch can be a
    // tmux pane-id REUSE by another project's agent (must not inject — leak) BUT also a transient
    // empty pane_current_path read or the agent doing a legitimate `cd`. So SKIP this message
    // (never leak into a stranger) WITHOUT closing the binding — a true reuse keeps failing the
    // same way (no harm), while a transient/cd self-heals on the next message. (markClosed here
    // would irreversibly kill a still-live topic with no respawn path until increment 2.)
    if (binding.path !== undefined && !routeMatchesPane({ recognizedCwd: binding.path, panePath: pane.panePath })) {
      await sendToTopic(action.threadId, "this topic's agent pane can't be confirmed right now — try again")
      return false
    }
    if (shouldDeferInbound(binding.paneId)) {
      // The pane passed the same-project guard above, so we defer behind its open question /
      // backlog exactly like the flat path. KNOWN GAP (increment-2 hardening): the shared
      // deferred-flush drain re-verifies agent-presence but NOT panePath, so a kill-pane + id
      // reuse in the narrow enqueue→flush window could still flush into a stranger's pane. This
      // is a property of the shared flush mechanism (flat 1:1 shares it); tightening it means
      // teaching the flush drain about per-route project identity, deferred to the spawn increment.
      markDeferredForAck(enqueueDeferred(binding.paneId, action.injectText, action.messageId))
      return true
    }
    const res = await executeInjectSteps(buildTextInjectPlan(binding.paneId, action.injectText))
    if (!res.ok) {
      await sendToTopic(action.threadId, res.error)
      return false
    }
    return true
  }

  // forum_topic_closed / reopened on a tracked topic → persist the status transition. The
  // binding is retained (closed keeps the path/model for a later re-spawn); reopen drops back
  // into the /new flow (increment 2 owns the actual re-attach/spawn).
  const handleTopicLifecycle = (action: Extract<Action, { kind: "topic-close" | "topic-reopen" }>): boolean => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) return false // untracked — stepUpdates already filtered, defensive only
    const ts = Math.floor(Date.now() / 1000)
    const next = action.kind === "topic-close" ? markClosed(binding, ts) : markReopened(binding, ts)
    persistTopics(appendTopic(topics, next))
    return true
  }

  // §11 deferral 3: forum_topic_edited (rename) → persist TopicBinding.name and rename the live
  // tmux window slug so the window title stays in sync with the Telegram topic name.
  const handleTopicRename = (action: Extract<Action, { kind: "topic-rename" }>): boolean => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) return true // untracked — stepUpdates already filtered, defensive only
    const ts = Math.floor(Date.now() / 1000)
    persistTopics(appendTopic(topics, markRenamed(binding, action.name, ts)))
    if (binding.paneId && binding.status === "bound") {
      const slug = slugifyTopicName(action.name, action.threadId)
      try {
        const proc = Bun.spawnSync(["tmux", "rename-window", "-t", binding.paneId, slug], {
          stdout: "pipe",
          stderr: "pipe",
          env: SUBPROC_ENV,
        })
        if (proc.exitCode !== 0) {
          log(`rename-window ${binding.paneId} → ${slug} exited ${proc.exitCode}: ${proc.stderr.toString().trim()}`)
        }
      } catch (err) {
        log(`rename-window failed for pane ${binding.paneId}: ${err}`)
      }
    }
    return true
  }

  // --- forum-topics SPAWN executor (docs/specs/tg-forum-topics.md §5, increment 2) ---
  // The /new flow that creates a binding and launches a fresh agent into its own tmux window.
  // SAFETY (this is the CTO's daily lifeline daemon): every step is exception-guarded — a bad
  // path, a missing tmux, an unknown model, or a spawn error NEVER throws into the poll loop;
  // it logs, posts a human-readable error INTO the topic, and leaves the binding mid-flow so the
  // human can retry. The whole feature only runs when ctx.cfg.topics is on (the flag default-off
  // keeps 1:1 behaviour byte-identical), and the spawn refuses for an already-bound topic, so a
  // duplicate forum_topic_created or a daemon restart can never double-spawn into a live topic.

  // statSync throws on a broken symlink / EACCES — guard so a malformed path answer can never
  // bubble into the poll loop. A non-existent or non-directory path → false (re-ask the human).
  const isExistingDirectory = (path: string): boolean => {
    try {
      return statSync(path).isDirectory()
    } catch {
      return false
    }
  }

  // The tmux session to spawn the new window into: the configured pin, else the session a live
  // agent already runs in (so the new window lands beside the existing agents), else undefined
  // (tmux new-window without -t targets the current/only session). Best-effort, never throws.
  const sessionForSpawn = (): string | undefined => {
    if (ctx.cfg.session) return ctx.cfg.session
    const { panes, procs } = snapshot()
    for (const p of panes) {
      if (findAgentInPane(p, procs) !== null) return p.sessionName
    }
    return panes[0]?.sessionName
  }

  // Run `tmux new-window … -- <agent argv>` and return the created pane id, or an error.
  // -P -F '#{pane_id}' prints the new pane id on stdout → bound immediately (no discovery race,
  // spec §5). `-e TG_TOPIC=<threadId>` stamps the topic id into the NEW window's environment so the
  // spawned agent's plain `tg "reply"` threads back INTO this topic automatically — no `--topic`
  // needed (spec §9.4 deferral; codex r8 #1). The `tg` send side already reads TG_TOPIC and fails
  // soft on a stale/closed topic. Fully guarded: a spawn throw (tmux missing) or a non-zero exit
  // becomes a typed error, never an exception. `task` is passed through the model catalog as the
  // spawned agent's initial prompt. The path + argv are discrete argv elements (never shell-split),
  // so a directory with spaces is safe.
  const spawnTopicWindow = (
    threadId: number,
    windowSlug: string,
    path: string,
    model: string,
    task = "",
  ): { ok: true; paneId: string } | { ok: false; error: string } => {
    const argvBase = spawnArgvWithTask(model, path, task)
    if (!argvBase) return { ok: false, error: `unknown model \`${model}\` — pick a model again` }
    // tg#8708 (option a): add codex --dangerously-bypass-hook-trust ONLY when codex hooks are
    // rig-managed (rig vouches for them); never bypass a user's own untrusted hooks.
    const argv = applyCodexHookTrustBypass(argvBase, findModel(model)?.kind, process.env)
    try {
      // sessionForSpawn() runs snapshot() (tmux list-panes / ps), which CAN throw if a binary is
      // missing — it MUST be inside this try, else the throw escapes the local guard, past
      // handleTopicModel, into the poll loop (exactly the "never throws" guarantee this defends).
      const session = sessionForSpawn()
      const tmuxArgv = [
        "tmux",
        "new-window",
        // `=<session>:` (not a bare name) so a NUMERIC session name isn't misparsed as a window
        // index — a bare `-t 1` fails `create window failed: index 1 in use`. See sessionTargetArgs.
        ...sessionTargetArgs(session),
        // -e sets the spawned PROCESS env so the agent's plain `tg` threads back into this topic.
        "-e",
        `TG_TOPIC=${threadId}`,
        "-n",
        windowSlug,
        "-c",
        path,
        "-P",
        "-F",
        "#{pane_id}",
        "--",
        ...argv,
      ]
      const proc = Bun.spawnSync(tmuxArgv, { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `couldn't start the agent (tmux: ${proc.stderr.toString().trim() || `exit ${proc.exitCode}`})` }
      }
      const paneId = proc.stdout.toString().trim()
      if (!paneId) return { ok: false, error: "tmux did not return a pane id — agent not started" }
      return { ok: true, paneId }
    } catch (err) {
      return { ok: false, error: `couldn't start the agent (${err})` }
    }
  }

  // Stamp the per-spawn token as a WINDOW USER OPTION on the just-created pane (codex r11): a
  // `@user_option` IS queryable after a restart via `#{@tg_spawn_token}` in PANE_FORMAT, unlike
  // `new-window -e` process env. Best-effort — a failure only weakens token-based orphan adoption
  // (the recorded paneId is the fallback proof — codex r12 P1), never the spawn. Never throws.
  const stampSpawnToken = (paneId: string, spawnToken: string): void => {
    try {
      const proc = Bun.spawnSync(["tmux", "set-option", "-w", "-t", paneId, "@tg_spawn_token", spawnToken], {
        stdout: "pipe",
        stderr: "pipe",
        env: SUBPROC_ENV,
      })
      // LOG a non-zero exit (codex r19 P2): the stamp is best-effort (the recorded paneId is the
      // fallback proof), but a silent failure would quietly weaken token-based orphan adoption — so
      // surface it for observability rather than swallowing it.
      if (proc.exitCode !== 0) {
        log(`set @tg_spawn_token for ${paneId} exited ${proc.exitCode}: ${proc.stderr.toString().trim()}`)
      }
    } catch (err) {
      log(`set @tg_spawn_token failed for ${paneId}: ${err}`)
    }
  }

  // (The per-spawn token is now read directly from each pane's snapshot `spawnToken` field — the
  // `@tg_spawn_token` window user option in PANE_FORMAT — so no extra per-candidate tmux call.)

  // The recent project paths to offer as awaiting-path buttons (increment 4), most-recent first.
  // Source: the routes store (every `tg` send stamps its pane's cwd) + the per-pane registrations
  // (every live agent session's cwd), newest first. recentPathChoices dedupes and keeps only
  // absolute existing dirs (a button must point at a spawn-able cwd). Best-effort — any read error
  // degrades to an empty list (free-text only), never throwing into the flow.
  const gatherRecentPaths = (): string[] => {
    try {
      // MERGE routes + registrations by their OWN timestamps and sort newest-first GLOBALLY (codex
      // r25): concatenating all-routes-then-all-registrations let an old route crowd out a newer
      // registration past MAX_PATH_CHOICES. Routes carry `ts` (send time); registrations carry
      // `registeredAt` (start time, optional → 0 = oldest). Stable sort, then recentPathChoices
      // dedupes (first-seen wins) and keeps absolute existing dirs.
      const stamped: Array<{ cwd: string | undefined; ts: number }> = [
        ...parseRoutes(readFileOrNull(ctx.paths.routes)).map((r) => ({ cwd: r.cwd, ts: r.ts })),
        ...parseRegistrations(readFileOrNull(ctx.paths.registration)).map((r) => ({ cwd: r.cwd, ts: r.registeredAt ?? 0 })),
      ]
      stamped.sort((a, b) => b.ts - a.ts) // newest first
      return recentPathChoices(stamped.map((s) => s.cwd), (p) => isAbsolute(p) && isExistingDirectory(p))
    } catch (err) {
      log(`gatherRecentPaths failed: ${err}`)
      return []
    }
  }

  // Begin (or restart) the /new flow for a topic: PERSIST a fresh awaiting-path binding FIRST,
  // THEN post the prompt. Persisting before the async send closes the crash window (review #4) —
  // a crash after the send but before a persist would otherwise leave a prompt with no binding, so
  // the user's path answer wouldn't be recognized. When recent repos are known they're offered as
  // one-tap buttons (callback tgp:<threadId>:<index>) and the chosen list is stored on the binding
  // so the tap recovers the path by index. Free-text always remains a fallback. Shared by
  // handleTopicNew and both restart branches (no-path/model re-spawn).
  const startTopicPathFlow = async (threadId: number, name: string): Promise<void> => {
    const choices = gatherRecentPaths()
    // A UNIQUE per-prompt NONCE (codex r4 P1 — NOT the wall-clock second, which collides on two
    // restarts in one second): a button from a SUPERSEDED prompt carries an old nonce and is rejected.
    const nonce = nextPathNonce()
    const created = createTopic(threadId, name, Math.floor(Date.now() / 1000))
    persistTopics(
      appendTopic(loadTopics(), choices.length > 0 ? { ...created, pathChoices: choices, pathChoicesNonce: nonce } : created),
    )
    const extra: Record<string, unknown> =
      choices.length > 0
        ? { message_thread_id: threadId, reply_markup: { inline_keyboard: buildPathKeyboard(threadId, choices, nonce) } }
        : { message_thread_id: threadId }
    const prompt =
      choices.length > 0
        ? "New agent for this topic. Pick a recent project below, or send an absolute path (e.g. /Users/you/project)."
        : "New agent for this topic. Which directory should it work in? Send an absolute path (e.g. /Users/you/project)."
    await sendMessage(ctx, prompt, extra)
  }

  // A new forum topic was created → begin the /new flow. stepUpdates already filtered a duplicate
  // create for an in-flight/bound topic, so reaching here means an untracked or previously-closed
  // topic; startTopicPathFlow's createTopic upsert resets it to awaiting-path either way.
  const handleTopicNew = async (action: Extract<Action, { kind: "topic-new" }>): Promise<boolean> => {
    await startTopicPathFlow(action.threadId, action.name)
    return true
  }

  // A recent-path button tap (tgp:<threadId>:<index>:<nonce>) → resolve the index against the
  // binding's persisted pathChoices and advance exactly like a typed path. A stale/forged index
  // (out of range, or the topic no longer awaiting-path) re-asks rather than spawning into a guessed
  // dir. The path is RE-VALIDATED (a repo can vanish between the prompt and the tap) before advancing.
  const handleTopicPath = async (action: Extract<Action, { kind: "topic-path" }>): Promise<boolean> => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding || binding.status !== "awaiting-path") {
      await answerCallbackQuery(ctx, action.callbackQueryId, "send a directory")
      return false
    }
    // STALE-BUTTON guard (codex r3 P1): the tap's nonce MUST match the binding's current
    // pathChoicesNonce. A mismatch means the button came from a SUPERSEDED prompt (a setup restart
    // replaced pathChoices) — its index would resolve against the wrong list. Reject + re-ask.
    if (action.nonce !== binding.pathChoicesNonce) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that menu expired — pick again")
      return false
    }
    const path = binding.pathChoices?.[action.index]
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that path is gone — send one")
      await sendToTopic(action.threadId, `\`${path ?? "(unknown)"}\` is no longer an existing directory — send an absolute path.`)
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "ok")
    // PERSIST the awaiting-model transition FIRST, THEN do cosmetic cleanup (codex r15 #2): the poll
    // loop persists the Telegram offset BEFORE running actions, so a crash/kill during the async
    // editMessageReplyMarkup would otherwise lose this tap permanently AND leave the buttons cleared
    // (un-retappable). Persisting the state first makes the tap durable; clearing the keyboard is
    // best-effort after.
    persistTopics(appendTopic(loadTopics(), applyPathAnswer(binding, path, Math.floor(Date.now() / 1000))))
    if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
    await askTopicModel(action.threadId)
    return true
  }

  // Post the awaiting-model prompt with one inline button per catalog model. The callback data
  // (tgm:<threadId>:<modelId>) routes the tap back to handleTopicModel. Reused by handleTopicNew's
  // path step AND by a reopen that resumed at awaiting-model.
  const askTopicModel = (threadId: number): Promise<number | null> =>
    sendMessage(ctx, "Which model should this agent run?", {
      message_thread_id: threadId,
      reply_markup: { inline_keyboard: buildModelKeyboard(threadId, MODEL_CATALOG) },
    })

  // A user message inside an awaiting-* topic → the path answer. Validate the directory (must
  // exist + be a dir, spec §10) before advancing; a bad path re-asks WITHOUT advancing so the
  // human just resends. On a good path → awaiting-model + the model button prompt.
  const handleTopicAnswer = async (action: Extract<Action, { kind: "topic-answer" }>): Promise<boolean> => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) return false // untracked — defensive (stepUpdates only emits for awaiting-*)
    if (binding.status === "awaiting-model") {
      // The model is chosen by BUTTON, not text — a stray message here just re-shows the buttons
      // rather than mis-reading prose as a model id.
      await askTopicModel(action.threadId)
      return true
    }
    // ONLY awaiting-path text is a path answer. The binding is reloaded fresh here, so a status
    // that already advanced past awaiting-path must be respected: a model tap + a text message in
    // the SAME getUpdates batch emits topic-model (→ bound) THEN this stale topic-answer; without
    // this guard the else-branch would call applyPathAnswer on the now-`bound` binding and move it
    // back to awaiting-model — stranding the live spawned pane (codex P2, real race). For a bound
    // (or closed) topic the stale answer is ignored: a message to a bound topic routes via
    // topic-route, not here, so dropping this stale one loses nothing.
    if (binding.status !== "awaiting-path") return false
    const path = action.text.trim()
    // Require an ABSOLUTE path: isExistingDirectory (statSync) resolves a relative path against the
    // DAEMON's cwd, but `tmux new-window -c <path>` resolves it against the tmux SERVER's cwd — a
    // relative path could validate here yet spawn the agent in a different directory (or fail). An
    // absolute path resolves identically for both, so validation and spawn always see the same dir.
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      await sendToTopic(action.threadId, `\`${path || "(empty)"}\` is not an absolute path to an existing directory — send a full path like /Users/you/project.`)
      return false
    }
    persistTopics(appendTopic(topics, applyPathAnswer(binding, path, Math.floor(Date.now() / 1000))))
    await askTopicModel(action.threadId)
    return true
  }

  // A model button tap → spawn the agent and bind the topic. Refuses a second spawn for an
  // already-bound topic (idempotency: a late/duplicate tap can't launch a second agent), and
  // re-asks on an unknown model id. On success the new pane is bound immediately and a
  // confirmation posts into the topic; on a spawn failure the binding stays awaiting-model so
  // the human can re-pick (no half-state, no crash).
  const handleTopicModel = async (action: Extract<Action, { kind: "topic-model" }>): Promise<boolean> => {
    // Answer the tap with a CONTEXT toast — not a blanket "starting…" that misleads on a refuse
    // branch (already-bound / wrong state / unknown model). Each early return answers its own.
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "not in setup")
      await sendToTopic(action.threadId, "this topic isn't in setup — recreate it to spawn an agent")
      return false
    }
    if (binding.status === "bound") {
      // Answer ONLY the transient callback toast — NOT a fresh sendToTopic per tap — so even a
      // dangling button (e.g. cleared a beat too late) can't flood the topic with messages.
      await answerCallbackQuery(ctx, action.callbackQueryId, "an agent is already running here")
      return false
    }
    if (binding.status !== "awaiting-model" || !binding.path) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "send a directory first")
      await sendToTopic(action.threadId, "send the working directory first, then pick a model")
      return false
    }
    // A spawn for this binding is ALREADY in flight (spawnPending) with its own model — a crash may
    // have left a live orphan the JIT probe will adopt. A tap of a DIFFERENT model now must NOT
    // overwrite the model the orphan was actually launched with (codex r16 #1): reject it and keep
    // the in-flight model. Re-tapping the SAME model is fine (it just re-drives the spawn/adopt).
    // BUT FIRST (codex r31): if the pending model is no longer in the catalog (removed/renamed since
    // it was chosen), the mismatch guard would reject EVERY other valid tap and trap the binding. So
    // when the pending model is invalid, RESTART the /new flow so the user re-picks a live model.
    if (binding.spawnPending && binding.model && !findModel(binding.model)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that model is gone — set the topic up again")
      await startTopicPathFlow(action.threadId, binding.name)
      return false
    }
    if (binding.spawnPending && binding.model && binding.model !== action.modelId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, `already starting \`${binding.model}\` — wait`)
      return false
    }
    // Validate the model id ONCE, up front (applyModelAnswer and spawnArgv both resolve against
    // MODEL_CATALOG — the single source of truth). An unknown id can only arrive via a stale/forged
    // callback (the keyboard emits valid ids); reject it BEFORE the "starting…" toast so the user
    // never sees "starting…" followed by "unknown model", and BEFORE persisting — so a bad id can't
    // strand the binding at awaiting-model with a model that spawn would forever reject.
    const ts = Math.floor(Date.now() / 1000)
    const withModel = applyModelAnswer(binding, action.modelId, ts)
    if (!withModel) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "unknown model")
      await sendToTopic(action.threadId, `unknown model \`${action.modelId}\` — pick a model again`)
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "starting…")
    persistTopics(appendTopic(topics, withModel))
    return spawnAndBindTopic(withModel, action.modelId, action.messageId)
  }

  // Spawn the agent for an awaiting-model binding and bind the returned pane. Shared by the model
  // tap (handleTopicModel) AND the re-spawn tap (handleTopicRespawn) so the spawn/bind/confirm/
  // clear-keyboard logic lives in ONE place. On success: bound + confirmation + (increment 4) the
  // stale model keyboard is cleared so it can't be re-tapped. On failure: the binding stays
  // awaiting-model (retryable) and the error posts into the topic — never half-bound, never throws.
  const spawnAndBindTopic = async (
    binding: TopicBinding,
    modelId: string,
    promptMessageId: number | null,
  ): Promise<boolean> => {
    // RE-VALIDATE the path here (review #5): on a re-spawn the recorded dir can have vanished since
    // it was first chosen. RESTART the /new flow (back to awaiting-path) rather than leaving the
    // binding stuck at awaiting-model — where a follow-up text would only re-show model buttons and
    // never let the user fix the path (codex #1). startTopicPathFlow persists awaiting-path + asks.
    if (!binding.path || !isAbsolute(binding.path) || !isExistingDirectory(binding.path)) {
      // Require ABSOLUTE here too (codex r9 #2): a corrupt/old binding with a relative `path` (e.g.
      // ".") would otherwise spawn with `tmux new-window -c .`, resolving against the tmux SERVER's
      // cwd, NOT the daemon-validated dir. Restart the /new flow so the human picks a real abs path.
      // PERSIST the awaiting-path recovery state FIRST (codex r19 P1) — startTopicPathFlow writes it
      // before its own prompt send, so a crash during the COSMETIC clear/notice below can't strand
      // the binding at awaiting-model with the bad path. Then clear the stale model keyboard (codex
      // r10 P2: a live model button would otherwise re-enter handleTopicModel against the bad path).
      await startTopicPathFlow(binding.threadId, binding.name)
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      await sendToTopic(binding.threadId, `\`${binding.path ?? "(none)"}\` is not an absolute existing directory — set the topic up again.`)
      return false
    }
    const slug = slugifyTopicName(binding.name, binding.threadId)
    // JUST-IN-TIME orphan probe (codex r13 P1): if this binding is ALREADY spawnPending, a prior
    // spawn may have created an orphan that startup reconcile missed (e.g. a flaky/empty snapshot at
    // boot made reconcile skip). Re-probe the LIVE snapshot now and ADOPT that orphan instead of
    // spawning a SECOND agent. Uses the same proof (token OR recorded paneId, same slug + cwd) as
    // reconcileOneTopic. A fresh tap (no spawnPending) skips this and spawns normally.
    if (binding.spawnPending) {
      const { panes, procs } = snapshot()
      const live = panes.filter((p) => findAgentInPane(p, procs) !== null)
      // FLAKE GUARD (codex r17, narrowed r29): the flake signature is an EMPTY `panes` (tmux flaked)
      // or EMPTY `procs` (ps flaked) — the probe is then BLIND and the orphan may be alive but
      // invisible, so spawning would double-spawn. Refuse + retry ONLY for that signature. When BOTH
      // reads returned data but no agent is live, the orphan is genuinely GONE (or a crash hit before
      // new-window) — that's a real no-orphan state, so fall through to a fresh spawn below rather
      // than looping "couldn't read the session" forever (codex r29). The ambiguous-candidate guard
      // further down still refuses if a real same-slug/cwd candidate remains.
      if (panes.length === 0 || procs.length === 0) {
        await sendToTopic(binding.threadId, "couldn't read the session right now — tap the model again in a moment")
        return false
      }
      // PATH-AWARE claimed set (codex r14 #1): a stale reused-`%N` bound topic must NOT block this
      // adoption, or the probe falls through to new-window and double-spawns.
      const claimedNow = legitimatelyClaimedPanes(loadTopics(), live, binding.threadId)
      const adopted = reconcileOneTopic(binding, live, claimedNow, Math.floor(Date.now() / 1000))
      if (adopted !== binding && adopted.status === "bound" && adopted.paneId) {
        persistTopics(appendTopic(loadTopics(), adopted))
        if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
        await sendToTopic(binding.threadId, `re-attached to the existing agent in \`${binding.path}\` (window \`${slug}\`) — send a message to talk to it`)
        return true
      }
      // The probe did NOT adopt. If a same-slug/same-cwd UNCLAIMED candidate pane STILL exists, an
      // orphan likely IS there but couldn't be safely adopted (e.g. ambiguous multi-pane token, codex
      // r28). Spawning now would double-spawn — so REFUSE and ask the user to retry/recreate, never
      // start a second window. Only when NO such candidate exists (the orphan is genuinely gone) do
      // we fall through to a fresh spawn below.
      const candidateRemains = live.some(
        (p) =>
          p.windowName === slug &&
          !claimedNow.has(p.paneId) &&
          routeMatchesPane({ recognizedCwd: binding.path, panePath: p.panePath }),
      )
      if (candidateRemains) {
        await sendToTopic(binding.threadId, "an agent may already be running for this topic but I can't confirm which pane — tap again, or recreate the topic")
        return false
      }
    }
    // Arm the spawn-pending marker AND persist it BEFORE new-window, so a crash in the window between
    // a successful new-window and the `bound` write leaves spawnPending set → startup reconcile knows
    // a live orphan exists and adopts it. A FAILED spawn clears it below (no orphan window was created
    // → reconcile must NOT adopt an unrelated same-slug pane after a restart — codex r7 P1).
    const pendingTs = Math.floor(Date.now() / 1000)
    // A unique per-spawn token, recorded on the binding BEFORE new-window. Adoption requires either
    // (a) the orphan window carries this token (the normal case), OR (b) the recorded paneId (set
    // RIGHT AFTER new-window, below) is a live same-cwd agent — the fallback that closes the
    // crash-AFTER-new-window-BEFORE-token-stamp window (codex r12 P1).
    const spawnToken = `${binding.threadId}-${pendingTs}-${nextPathNonce()}`
    persistTopics(appendTopic(loadTopics(), markSpawnPending(binding, spawnToken, pendingTs)))
    const spawned = spawnTopicWindow(binding.threadId, slug, binding.path, modelId)
    if (!spawned.ok) {
      // Clear the pending marker (no orphan was created) and leave the binding at awaiting-model so a
      // re-tap retries without losing the path.
      persistTopics(appendTopic(loadTopics(), clearSpawnPending(binding, Math.floor(Date.now() / 1000))))
      await sendToTopic(binding.threadId, spawned.error)
      return false
    }
    // STAMP THE TOKEN ONTO THE WINDOW FIRST (codex r15 #1), THEN persist the paneId. The binding's
    // spawnToken was already persisted before new-window (markSpawnPending), so once the WINDOW also
    // carries it, the orphan is token-adoptable even if the paneId persist below never runs. Doing
    // the synchronous set-option before the persist shrinks the unrecoverable gap to the sub-ms
    // window BETWEEN new-window returning and this set-option call — which tmux can't make atomic
    // (no `-o` on new-window). That residual is bounded by the JIT probe (a model re-tap on a still-
    // spawnPending binding re-probes live panes) and is astronomically unlikely; a stranded orphan
    // is also recoverable by hand.
    stampSpawnToken(spawned.paneId, spawnToken)
    const pendingWithPane = { ...markSpawnPending(binding, spawnToken, Math.floor(Date.now() / 1000)), paneId: spawned.paneId }
    persistTopics(appendTopic(loadTopics(), pendingWithPane))
    persistTopics(appendTopic(loadTopics(), markBound(binding, spawned.paneId, Math.floor(Date.now() / 1000))))
    // Clear the stale model/re-spawn keyboard on bind (increment 4) so it can't be re-tapped.
    if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
    await sendToTopic(binding.threadId, `spawned \`${modelId}\` in \`${binding.path}\` (window \`${slug}\`) — send a message to talk to it`)
    return true
  }

  // A re-spawn button tap (tgr:<threadId>) for a topic whose agent died → re-launch with the
  // retained path + model and re-bind. The button is ONLY ever offered for a `closed` topic, so a
  // tap on a binding in ANY OTHER state is STALE (the topic reopened / a new /new flow started since
  // the button was posted) — refuse it as expired rather than re-spawning out of band (codex r4 P1).
  // A model that's no longer in the catalog re-enters the /new flow instead of spawning blind.
  const handleTopicRespawn = async (action: Extract<Action, { kind: "topic-respawn" }>): Promise<boolean> => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "not in setup")
      return false
    }
    if (binding.status !== "closed") {
      // bound → already running; awaiting-* → the flow already moved on. Either way the button is
      // stale; answer the toast and do nothing (no double-spawn, no out-of-flow spawn).
      const toast = binding.status === "bound" ? "an agent is already running here" : "that button expired — continue setup"
      await answerCallbackQuery(ctx, action.callbackQueryId, toast)
      return false
    }
    // The Re-spawn button is ONLY ever posted alongside setting `respawnOffered` (a dead-pane offer).
    // A `closed` binding WITHOUT that flag was closed some OTHER way — most importantly an explicit
    // `forum_topic_closed` (which clears the flag) — so a stale tgr tap there must NOT launch an agent
    // into a deliberately-closed topic (codex r18 #2). Require the live-offer flag.
    if (!binding.respawnOffered) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that button expired — reopen or recreate the topic")
      return false
    }
    if (!binding.path || !binding.model || !findModel(binding.model)) {
      // Not enough to re-spawn (no path/model, or a model that's no longer in the catalog) →
      // restart the /new flow so the human re-picks. PERSIST the awaiting-path state FIRST (codex r19
      // P1) so a crash during the cosmetic keyboard clear can't strand the closed binding; then clear
      // the now-stale Re-spawn button (codex r13 P2).
      await answerCallbackQuery(ctx, action.callbackQueryId, "restarting setup")
      await startTopicPathFlow(action.threadId, binding.name)
      if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "re-spawning…")
    const ts = Math.floor(Date.now() / 1000)
    const reArmed = applyModelAnswer({ ...binding, status: "awaiting-model" }, binding.model, ts)
    if (!reArmed) {
      await sendToTopic(action.threadId, `model \`${binding.model}\` is no longer available — recreate the topic`)
      return false
    }
    persistTopics(appendTopic(topics, reArmed))
    const ok = await spawnAndBindTopic(reArmed, binding.model, action.messageId)
    if (!ok) {
      // The re-spawn FAILED (tmux error / vanished dir). Restore the topic to `closed` and clear the
      // throttle flag (codex r5 #2) so the NEXT message re-OFFERS a fresh re-spawn button — otherwise
      // the binding sits at awaiting-model where the now-stale tgr button is refused with no obvious
      // retry. (Skip when spawnAndBindTopic already moved it elsewhere — e.g. a vanished dir restarted
      // the /new flow to awaiting-path; only restore if it's still the awaiting-model we left.)
      const after = findTopic(loadTopics(), action.threadId)
      if (after?.status === "awaiting-model") {
        persistTopics(appendTopic(loadTopics(), markClosed(after, Math.floor(Date.now() / 1000))))
      }
    }
    return ok
  }

  // A message arrived in a CLOSED topic (its agent died) → offer a one-tap re-spawn instead of a
  // dead-end. Only when the binding still holds a path + a valid model (a full re-spawn is
  // possible); otherwise re-enter the /new flow so the human re-picks. Idempotent toast on a
  // binding that already re-bound (e.g. a queued message after re-spawn) — no false re-offer.
  const handleTopicDead = async (action: Extract<Action, { kind: "topic-dead" }>): Promise<boolean> => {
    const binding = findTopic(loadTopics(), action.threadId)
    if (!binding) return false // untracked — defensive (stepUpdates only emits topic-dead for closed)
    if (binding.status !== "closed") {
      // A SAME-BATCH re-spawn tap already RE-BOUND this topic before this action ran (callbacks run
      // first). Don't drop the user's message (codex r9 #1): if it carried text and the topic is now
      // bound, route it to the live pane via handleTopicRoute (which re-verifies the pane + threads
      // the ack). A media-only message (empty injectText) has nothing to route → just skip.
      if (binding.status === "bound" && action.injectText) {
        return handleTopicRoute({
          kind: "topic-route",
          threadId: action.threadId,
          injectText: action.injectText,
          from: "tg",
          messageId: action.messageId,
        })
      }
      return false
    }
    await recoverDeadTopic(binding)
    // The user's message did NOT reach an agent (the topic is dead) — return false so the trailing
    // ack does NOT set a 👀 "seen" receipt. The re-spawn offer is the visible acknowledgement.
    return false
  }

  // Drive the recovery for a topic that is ALREADY `closed`: offer a re-spawn (or restart the
  // /new flow), THROTTLED so a burst of messages posts at most ONE offer. Shared by handleTopicDead
  // (a message to a closed topic), handleTopicRoute's dead-pane branch (after it closes a live-but-
  // dead bound topic), AND handleTopicRoute's no-longer-bound early branch (a SAME-BATCH second
  // message after the first closed it — codex round-2 #1, which previously hit the old "recreate the
  // topic" dead-end). respawnOffered gates the offer; it's stamped ONLY when the button actually
  // went out (a failed send retries next time — codex #3) AND the topic is still closed (a no-path/
  // model restart moved it to awaiting-path and must not be stamped).
  const recoverDeadTopic = async (binding: TopicBinding): Promise<void> => {
    if (binding.respawnOffered) return // already offered — ack quietly, no spam
    const offered = await offerRespawnOrRestart(binding)
    if (!offered) return
    const after = findTopic(loadTopics(), binding.threadId)
    if (after?.status === "closed") {
      persistTopics(appendTopic(loadTopics(), markRespawnOffered(after, Math.floor(Date.now() / 1000))))
    }
  }

  // Tell the human a topic's agent is dead and give them the fastest path back: a one-tap
  // re-spawn button when the binding still holds a usable path + model, else restart the /new
  // flow (re-ask the path). Shared by handleTopicRoute (a message hit a dead bound pane) and
  // handleTopicDead (a message hit an already-closed topic) so the recovery UX is identical.
  // The caller has already persisted the `closed` transition. Returns TRUE only when the re-spawn
  // BUTTON was actually delivered (a message id came back) — the caller throttles on that, so a
  // transient send failure does NOT suppress future offers (codex #3). The restart-flow branch
  // returns false (no button to re-offer; it already moved the topic to awaiting-path).
  const offerRespawnOrRestart = async (binding: TopicBinding): Promise<boolean> => {
    // Offer the one-tap re-spawn ONLY when a full re-spawn is actually possible: a valid model AND a
    // path that STILL EXISTS (codex r6 — a vanished dir would post an UNUSABLE button and, once the
    // throttle stamps respawnOffered, suppress further messages until the user taps the dead button).
    // If anything is missing/gone, restart the /new flow instead so the human re-picks a live dir.
    if (binding.path && isAbsolute(binding.path) && isExistingDirectory(binding.path) && binding.model && findModel(binding.model)) {
      await sendToTopic(binding.threadId, "this topic's agent has exited — tap to re-spawn it (same project + model).")
      const messageId = await sendMessage(ctx, "Re-spawn?", {
        message_thread_id: binding.threadId,
        reply_markup: { inline_keyboard: buildRespawnKeyboard(binding.threadId) },
      })
      return messageId !== null
    }
    // No usable path/model → restart the /new flow. PERSIST awaiting-path FIRST (codex r19 P1: a
    // crash during the notice send must not strand the closed binding), then post the exited notice.
    await startTopicPathFlow(binding.threadId, binding.name)
    await sendToTopic(binding.threadId, "this topic's agent has exited — set it up again.")
    return false
  }

  // The set of panes a `bound` binding LEGITIMATELY holds (so an orphan adoption never steals one).
  // Only a bound binding whose live pane STILL MATCHES its recorded project counts: a path-mismatched
  // (tmux-reused `%N`) bound pane is NOT a legit claim, so it doesn't block a real spawnPending orphan
  // (codex r8 #2). A pathless bound binding claims by pane id alone. `excludeThreadId` drops the
  // binding being adopted itself. Shared by startup reconcile AND the just-in-time spawn probe (codex
  // r14 #1 — both must use the SAME path-aware logic or the JIT probe could be blocked by a stale
  // reused-pane bound topic and double-spawn).
  const legitimatelyClaimedPanes = (
    topics: TopicBinding[],
    liveAgentPanes: PaneInfo[],
    excludeThreadId?: number,
  ): Set<string | undefined> =>
    new Set(
      topics
        .filter((t) => {
          if (t.threadId === excludeThreadId) return false
          if (t.status !== "bound" || !t.paneId) return false
          if (t.path === undefined) return true
          const live = liveAgentPanes.find((p) => p.paneId === t.paneId)
          return live !== undefined && routeMatchesPane({ recognizedCwd: t.path, panePath: live.panePath })
        })
        .map((t) => t.paneId),
    )

  // Reconcile ONE binding against the live tmux state on startup. Returns the SAME object when
  // nothing changes (the caller uses identity to detect a change), else a new transitioned binding:
  //   - a `bound` binding whose recorded pane is gone → markClosed (agent died while down);
  //   - an `awaiting-model` binding whose topic-slug window hosts a live UNCLAIMED agent → markBound
  //     (adopt the crash-orphan, no second spawn). `claimed` excludes panes already bound elsewhere.
  const reconcileOneTopic = (
    binding: TopicBinding,
    liveAgentPanes: PaneInfo[],
    claimed: Set<string>,
    ts: number,
  ): TopicBinding => {
    if (binding.status === "bound") {
      // Close the binding ONLY when the recorded pane no longer hosts an agent (genuinely gone). A
      // mere PATH MISMATCH on a live pane is NOT closed here: it can be a transient empty-path read
      // (the launchd flake) or a legit `cd`, and closing on that would irreversibly kill a live topic
      // on a flaky startup read — exactly what the routing-time guard deliberately avoids (see the
      // ctl-topics-integration "REUSED pane … NOT closed" test). The ROUTING path already prevents a
      // leak into a reused-pane stranger (it refuses to inject on a mismatch), so a reused-`%N` case
      // is contained there and self-heals; reconcile must not over-close (codex r4 P2 declined — the
      // transient-read safety wins over the re-spawn-offer convenience).
      const stillLive = binding.paneId && liveAgentPanes.some((p) => p.paneId === binding.paneId)
      if (stillLive) return binding
      log(`topic ${binding.threadId}: bound pane ${binding.paneId} gone on startup — marking closed`)
      return markClosed(binding, ts)
    }
    // Adopt a crash-orphan ONLY for the EXACT crash-gap state: `awaiting-model` WITH path + model AND
    // the `spawnPending` marker SET. That marker is armed right before `tmux new-window` and cleared
    // on spawn FAILURE, so only a binding whose new-window actually RAN (and whose `bound` write was
    // lost to a crash) is a real orphan. Without it, a normal awaiting-model (no model / never
    // spawned — codex r5 #1) OR a FAILED spawn left at awaiting-model+model (codex r7 P1) could be
    // wrongly bound to an unrelated same-slug/cwd pane. A `closed` topic is deliberately closed (never
    // resurrect — codex r2 #2); awaiting-path has nothing to adopt against.
    if (
      binding.status !== "awaiting-model" ||
      !binding.spawnPending ||
      !binding.spawnToken ||
      !binding.path ||
      !binding.model ||
      !findModel(binding.model)
    )
      return binding
    // Adopt a live agent pane that is PROVABLY the one we launched. Candidates: an unclaimed pane in
    // the topic-slug window with the same cwd. Among those, the proof is EITHER the recorded paneId
    // (set right after new-window — codex r12 P1) OR our per-spawn token. Since `@tg_spawn_token` is a
    // WINDOW option, EVERY pane in the window exposes it, so a multi-pane window (the user split it)
    // could token-match more than one pane (codex r23 #2): prefer the EXACT recorded paneId; fall back
    // to a token match ONLY when it is UNAMBIGUOUS (exactly one). Never bind a guessed pane.
    const slug = slugifyTopicName(binding.name, binding.threadId)
    const candidates = liveAgentPanes.filter(
      (p) =>
        p.windowName === slug &&
        !claimed.has(p.paneId) &&
        routeMatchesPane({ recognizedCwd: binding.path, panePath: p.panePath }),
    )
    const byPaneId = binding.paneId !== undefined ? candidates.find((p) => p.paneId === binding.paneId) : undefined
    const tokenMatches = candidates.filter((p) => p.spawnToken.length > 0 && p.spawnToken === binding.spawnToken)
    const orphan = byPaneId ?? (tokenMatches.length === 1 ? tokenMatches[0] : undefined)
    if (!orphan) {
      if (tokenMatches.length > 1) log(`topic ${binding.threadId}: ambiguous token match (${tokenMatches.length} panes) — not adopting`)
      return binding
    }
    log(`topic ${binding.threadId}: adopting orphan pane ${orphan.paneId} (window ${slug}) on startup`)
    return markBound(binding, orphan.paneId, ts)
  }

  // --- flat-chat `/new` command (issue #27, NON-topic) ---
  // The flat sibling of the forum-topics /new flow: a `/new [<harness>|<model>] [<dir>] name
  // [<task>]` slash command in the flat chat spawns a fresh agent in a named tmux window. SAFETY
  // (this is the CTO's daily lifeline): every step is exception-guarded — a bad path, missing tmux,
  // unknown model, or spawn error NEVER throws into the poll loop; it logs and replies, leaving the pending
  // session so the user can retry/answer again. Unlike the topic flow there is NO persistent
  // binding: once the agent spawns the pending session is deleted (the new pane is a plain pane,
  // addressed by /agent afterwards). The pending store is in-memory (pendingNew).

  // The recent project dirs to offer as `/new` dir buttons, parents-aware + LRU/MRU (issue #27).
  // Source = the same routes + per-pane registrations gatherRecentPaths uses (already newest-first),
  // but rankNewDirChoices ALSO adds each cwd's `..` parents. Best-effort: any read error → [].
  const gatherNewDirChoices = (): string[] => {
    try {
      const stamped: Array<{ cwd: string | undefined; ts: number }> = [
        ...parseRoutes(readFileOrNull(ctx.paths.routes)).map((r) => ({ cwd: r.cwd, ts: r.ts })),
        ...parseRegistrations(readFileOrNull(ctx.paths.registration)).map((r) => ({ cwd: r.cwd, ts: r.registeredAt ?? 0 })),
      ]
      stamped.sort((a, b) => b.ts - a.ts) // newest first
      return rankNewDirChoices(stamped.map((s) => s.cwd), (p) => isAbsolute(p) && isExistingDirectory(p))
    } catch (err) {
      log(`gatherNewDirChoices failed: ${err}`)
      return []
    }
  }

  // The live tmux window names (for the name-uniqueness warning). Best-effort → [] on any flake.
  const liveWindowNames = (): string[] => {
    try {
      return snapshot().panes.map((p) => p.windowName).filter((n) => n.length > 0)
    } catch {
      return []
    }
  }

  type PrivateTopicResult =
    | { kind: "topic"; threadId: number }
    | { kind: "fallback"; message?: string }
    | { kind: "ask"; message: string }
    | { kind: "waiting" }

  let privateTopicFallbackState: "unknown" | "pending" | "accepted" = "unknown"

  const privateTopicWarning = (reason: string): string =>
    `tg-ctl private_topics is enabled, but ${reason}. This chat does not need to be converted to a forum. Spawning without a topic for now; after the bot capability/provisioning reports true, run \`tg-ctl restart\` and retry \`/new\`.`

  const privateTopicFallbackPrompt = (reason: string): string =>
    `tg-ctl private_topics is enabled, but ${reason}. Continue without topic routing?`

  // Create a private-chat topic via Bot API 9.4 `createForumTopic` and return the new
  // `message_thread_id`, or a user-visible failure reason (the daemon falls back to flat-chat behaviour).
  // Graceful: a failure is logged and returned to the caller so Telegram gets an explicit
  // capability diagnostic instead of hiding "chat is not a forum" in the daemon log.
  const createPrivateTopic = async (name: string): Promise<PrivateTopicResult> => {
    if (privateTopicFallbackState === "accepted") return { kind: "fallback" }
    const me = await botPostResult(ctx, "getMe", {})
    if (me.ok) {
      const user = me.json.result
      if (user && typeof user === "object") {
        const enabled = (user as { has_topics_enabled?: unknown }).has_topics_enabled
        if (enabled === false) {
          log("private chat topic create unavailable — getMe.has_topics_enabled=false")
          if (privateTopicFallbackState === "pending") return { kind: "waiting" }
          if (privateTopicFallbackState === "unknown") {
            privateTopicFallbackState = "pending"
            return {
              kind: "ask",
              message: privateTopicFallbackPrompt("Telegram Bot API currently reports `getMe.has_topics_enabled=false` for this bot, so `createForumTopic` cannot create a private-chat topic"),
            }
          }
        }
      }
    }
    const topicResp = await botPostResult(ctx, "createForumTopic", { chat_id: ctx.chatId, name })
    if (!topicResp.ok) {
      log(`private chat topic create unavailable — createForumTopic: ${topicResp.description}`)
      return {
        kind: "fallback",
        message: privateTopicWarning(`Telegram Bot API rejected \`createForumTopic\`: ${topicResp.description}`),
      }
    }
    const result = topicResp.json.result
    if (!result || typeof result !== "object") {
      log("private chat topic create unavailable — createForumTopic returned no result object")
      return {
        kind: "fallback",
        message: privateTopicWarning("Telegram Bot API returned no topic object from `createForumTopic`"),
      }
    }
    const threadId = (result as { message_thread_id?: unknown }).message_thread_id
    if (typeof threadId !== "number") {
      log("private chat topic create unavailable — createForumTopic returned no message_thread_id")
      return {
        kind: "fallback",
        message: privateTopicWarning("Telegram Bot API returned no `message_thread_id` from `createForumTopic`"),
      }
    }
    return { kind: "topic", threadId }
  }

  // Spawn a flat `/new` agent into a named tmux window and return the pane id, or a typed error.
  // Mirrors spawnTopicWindow but WITHOUT TG_TOPIC (a flat /new agent is not bound to a topic — it
  // registers itself normally via `tg` and is addressed by /agent). When a task is given it is the
  // agent's initial prompt argv (claude accepts a positional prompt), so the agent starts working
  // immediately. Fully guarded: a throw or non-zero exit becomes a typed error, never an exception.
  const spawnNewWindow = (
    windowSlug: string,
    path: string,
    model: string,
    task: string,
    spawnToken: string,
  ): { ok: true; paneId: string } | { ok: false; error: string } => {
    const argvBase = spawnArgvWithTask(model, path, task)
    if (!argvBase) return { ok: false, error: `unknown model \`${model}\` — pick a model again` }
    // tg#8708 (option a): add codex --dangerously-bypass-hook-trust ONLY when codex hooks are
    // rig-managed (rig vouches for them); never bypass a user's own untrusted hooks.
    const argv = applyCodexHookTrustBypass(argvBase, findModel(model)?.kind, process.env)
    try {
      const session = sessionForSpawn()
      const tmuxArgv = [
        "tmux",
        "new-window",
        // `=<session>:` (not a bare name) so a NUMERIC session name isn't misparsed as a window
        // index — a bare `-t 1` fails `create window failed: index 1 in use`. See sessionTargetArgs.
        ...sessionTargetArgs(session),
        // Stamp the per-spawn token into the window env too, mirroring the topic spawn — harmless
        // for a flat /new (no reconcile depends on it) but keeps spawn provenance greppable.
        "-e",
        `TG_SPAWN_TOKEN=${spawnToken}`,
        "-n",
        windowSlug,
        "-c",
        path,
        "-P",
        "-F",
        "#{pane_id}",
        "--",
        ...argv,
      ]
      const proc = Bun.spawnSync(tmuxArgv, { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `couldn't start the agent (tmux: ${proc.stderr.toString().trim() || `exit ${proc.exitCode}`})` }
      }
      const paneId = proc.stdout.toString().trim()
      if (!paneId) return { ok: false, error: "tmux did not return a pane id — agent not started" }
      return { ok: true, paneId }
    } catch (err) {
      return { ok: false, error: `couldn't start the agent (${err})` }
    }
  }

  // Post the dir-pick prompt for a pending /new session (recent dirs as buttons + free-text). The
  // session is already stored (awaiting-dir); this offers the choices and records the prompt id.
  const askNewDir = async (session: NewSession): Promise<void> => {
    const choices = gatherNewDirChoices()
    session.dirChoices = choices
    const out = replyContext(session.threadId)
    const extra: Record<string, unknown> =
      choices.length > 0 ? { ...out, reply_markup: { inline_keyboard: buildNewDirKeyboard(session.token, choices) } } : out
    const prompt =
      choices.length > 0
        ? `New agent \`${session.name}\`. Pick a recent project below, or send an absolute path (e.g. /Users/you/project).`
        : `New agent \`${session.name}\`. Which directory should it work in? Send an absolute path (e.g. /Users/you/project).`
    session.promptMessageId = await sendMessage(ctx, prompt, extra)
  }

  // Post the harness-pick prompt for a pending /new session (one button per agent harness).
  const askNewHarness = async (session: NewSession): Promise<void> => {
    session.status = "awaiting-harness"
    session.ts = Math.floor(Date.now() / 1000)
    session.promptMessageId = await sendMessage(ctx, `Which harness should \`${session.name}\` use?`, {
      ...replyContext(session.threadId),
      reply_markup: { inline_keyboard: buildNewHarnessKeyboard(session.token) },
    })
  }

  // Post the model-pick prompt for a pending /new session (filtered to the chosen harness).
  const askNewModel = async (session: NewSession): Promise<void> => {
    session.status = "awaiting-model"
    session.ts = Math.floor(Date.now() / 1000)
    const catalog = session.harness ? modelsForHarness(session.harness) : MODEL_CATALOG
    const harnessName = session.harness ? `${harnessLabel(session.harness)} ` : ""
    session.promptMessageId = await sendMessage(ctx, `Which ${harnessName}model should \`${session.name}\` run?`, {
      ...replyContext(session.threadId),
      reply_markup: { inline_keyboard: buildNewModelKeyboard(session.token, catalog) },
    })
  }

  const advanceNewAfterDir = async (session: NewSession): Promise<boolean> => {
    if (session.model && findModel(session.model)) return spawnNewSession(session, session.model, null)
    if (session.harness) await askNewModel(session)
    else await askNewHarness(session)
    return true
  }

  // After a spawn FAILURE, report the tmux error ONCE and offer a single "Retry spawn" button —
  // NEVER re-enter the questionnaire (the earlier bug: a failure fell back to re-asking the model,
  // so the user answered the same question in a loop while the real error scrolled away). The
  // session keeps name+dir+harness+model and moves to `awaiting-retry`; a tap re-runs the spawn with
  // those preserved answers. Clears the old prompt keyboard so no stale button lingers.
  const offerNewRetry = async (
    session: NewSession,
    errorText: string,
    oldPromptMessageId: number | null,
  ): Promise<boolean> => {
    if (oldPromptMessageId !== null) await clearMessageKeyboard(ctx, oldPromptMessageId)
    session.status = "awaiting-retry"
    session.ts = Math.floor(Date.now() / 1000)
    session.promptMessageId = await sendMessage(ctx, `${errorText}\n\nYour picks are kept — tap Retry to try again.`, {
      ...replyContext(session.threadId),
      reply_markup: { inline_keyboard: buildNewRetryKeyboard(session.token) },
    })
    return false
  }

  // Do the actual spawn for a session that has name + dir + model, then DELETE the session (the
  // agent is now a plain pane). On a spawn failure the session moves to `awaiting-retry` (all
  // answers preserved) and offers a Retry button — it never re-asks. Clears the prompt keyboard on
  // success so it can't be re-tapped.
  const spawnNewSession = async (session: NewSession, modelId: string, promptMessageId: number | null): Promise<boolean> => {
    const out = replyContext(session.threadId)
    if (!session.dir || !isAbsolute(session.dir) || !isExistingDirectory(session.dir)) {
      // The dir vanished between the prompt and now → back to awaiting-dir so the user re-picks.
      // Clear the stale MODEL keyboard first (review #6) so the user isn't left with two live sets.
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      session.status = "awaiting-dir"
      session.ts = Math.floor(Date.now() / 1000)
      await sendMessage(ctx, `\`${session.dir ?? "(none)"}\` is not an absolute existing directory — send a full path like /Users/you/project.`, out)
      await askNewDir(session)
      return false
    }
    const slug = slugifyTopicName(session.name, 0)
    const spawnToken = `new-${session.token}-${Math.floor(Date.now() / 1000)}`
    // Private-chat topic: try to create a per-session topic BEFORE spawning so the window is born
    // with TG_TOPIC already set. Failure (capability/API error) → graceful flat fallback.
    const privateTopic = ctx.cfg.privateTopics ? await createPrivateTopic(session.name) : null
    if (privateTopic?.kind === "topic") {
      return spawnNewSessionWithTopic(session, modelId, privateTopic.threadId, slug, promptMessageId)
    }
    if (privateTopic?.kind === "ask") {
      session.model = modelId
      session.ts = Math.floor(Date.now() / 1000)
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      const fallbackPromptMessageId = await sendMessage(ctx, privateTopic.message, {
        ...out,
        reply_markup: { inline_keyboard: buildNewPrivateTopicFallbackKeyboard(session.token) },
      })
      if (fallbackPromptMessageId === null) {
        privateTopicFallbackState = "unknown"
        session.status = "awaiting-model"
        await askNewModel(session)
        return false
      }
      session.status = "awaiting-private-topic-fallback"
      session.promptMessageId = fallbackPromptMessageId
      return false
    }
    if (privateTopic?.kind === "fallback" && privateTopic.message) {
      await sendMessage(ctx, privateTopic.message, out)
    }
    if (privateTopic?.kind === "waiting") {
      await sendMessage(ctx, "private-topic fallback choice is already open — tap Continue without topics or Cancel this spawn.", out)
      return false
    }
    // Flat spawn path (no private topic, or createForumTopic failed gracefully).
    const spawned = spawnNewWindow(slug, session.dir, modelId, session.task, spawnToken)
    if (!spawned.ok) {
      // Spawn FAILED → report the error once and offer a Retry button (answers preserved), NEVER
      // re-ask the model. See offerNewRetry.
      return offerNewRetry(session, spawned.error, promptMessageId)
    }
    stampSpawnToken(spawned.paneId, spawnToken)
    pendingNew.delete(session.token)
    if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
    const taskNote = session.task.trim().length > 0 ? ` with task: ${session.task.trim()}` : ""
    await sendMessage(ctx, `spawned \`${modelId}\` in \`${session.dir}\` (window \`${slug}\`)${taskNote} — use \`/agent ${slug}\` to talk to it`, out)
    return true
  }

  // Private-chat topic spawn path: topic was created (threadId known), now spawn and bind. Extracted
  // from spawnNewSession to keep it under ~50 lines each. Handles the full lifecycle:
  //   - Write a preliminary awaiting-model binding BEFORE spawn so the forum_topic_created echo
  //     (already in flight from Telegram) is silently absorbed whether the spawn succeeds or fails.
  //   - On spawn FAILURE: the preliminary binding stays → echo is absorbed, user retries via model tap.
  //   - On spawn SUCCESS: upgrade to a `bound` binding; call stampSpawnToken for log greppability.
  // Supergroup topic /new has no task tail, but private-chat flat /new can pass one through here.
  const spawnNewSessionWithTopic = async (
    session: NewSession,
    modelId: string,
    threadId: number,
    slug: string,
    promptMessageId: number | null,
  ): Promise<boolean> => {
    const out = replyContext(session.threadId)
    const ts = Math.floor(Date.now() / 1000)
    // Write a preliminary binding BEFORE spawn so the forum_topic_created echo is absorbed even if
    // the spawn fails (no dangling untracked threadId that triggers the /new flow from a Telegram echo).
    const preliminary = { threadId, name: session.name, status: "awaiting-model" as const, path: session.dir, model: modelId, ts }
    const spawnToken = `${threadId}-${ts}-${nextPathNonce()}`
    persistTopics(appendTopic(loadTopics(), markSpawnPending(preliminary, spawnToken, ts)))
    const spawned = spawnTopicWindow(threadId, slug, session.dir, modelId, session.task)
    if (!spawned.ok) {
      persistTopics(appendTopic(loadTopics(), clearSpawnPending(preliminary, Math.floor(Date.now() / 1000))))
      // Report the error once and offer a Retry button (answers preserved), never re-ask the model.
      return offerNewRetry(session, spawned.error, promptMessageId)
    }
    // Upgrade the preliminary binding to `bound` now that the pane exists. Do not persist a
    // spawnPending record with paneId: a crash between that write and markBound would leave a
    // contradictory durable state.
    stampSpawnToken(spawned.paneId, spawnToken)
    const boundTs = Math.floor(Date.now() / 1000)
    persistTopics(appendTopic(loadTopics(), markBound(preliminary, spawned.paneId, boundTs)))
    pendingNew.delete(session.token)
    if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
    const taskNote = session.task.trim().length > 0 ? ` with task: ${session.task.trim()}` : ""
    await sendMessage(ctx, `spawned \`${modelId}\` in \`${session.dir}\` (window \`${slug}\`)${taskNote} — use \`/agent ${slug}\` to talk to it`, out)
    return true
  }

  // A `/new [<harness>|<model>] [<dir>] name [<task>]` command → start (or short-circuit) the
  // flow. With a name+dir+model all supplied the agent spawns immediately; otherwise the missing
  // piece is asked via buttons. A name collision with a live window is a non-fatal WARNING (tmux
  // allows dup names).
  const handleNewCommand = async (action: Extract<Action, { kind: "new-command" }>): Promise<boolean> => {
    reapNewSessions()
    const out = replyContext(action.threadId)
    if (!action.name) {
      await sendMessage(ctx, "usage: /new [<harness>|<model>] [<dir>] <name> [<task>] — e.g. `/new codex /Users/you/app api fix the build`", out)
      return false
    }
    if (privateTopicFallbackState === "pending") {
      const hasPendingFallback = [...pendingNew.values()].some((s) => s.status === "awaiting-private-topic-fallback")
      if (hasPendingFallback) {
        await sendMessage(ctx, "private-topic fallback choice is already open — tap Continue without topics or Cancel this spawn.", out)
        return false
      }
      privateTopicFallbackState = "unknown"
    }
    // Name-uniqueness WARNING (issue #27): warn if the resulting window slug collides, don't block.
    const slug = slugifyTopicName(action.name, 0)
    if (nameCollides(slug, liveWindowNames())) {
      await sendMessage(ctx, `⚠️ a window named \`${slug}\` already exists — the new agent will share the name. Continuing.`, out)
    }
    // A flat chat has at most ONE /new in flight (review #2): a second /new normally REPLACES any
    // prior pending session, so a typed path can never be mis-applied to a stale earlier session.
    // Exception: an open private-topic fallback confirmation is a live user decision, so it blocks
    // replacement until Continue/Cancel or expiry (handled above).
    pendingNew.clear()
    // Validate a supplied dir up front; an invalid one is dropped (→ asked) rather than failing.
    let dir = action.dir
    let task = action.task
    if (dir && (!isAbsolute(dir) || !isExistingDirectory(dir))) {
      if (action.dirAfterName && isLikelySlashCommand(dir)) {
        // A COMMAND-SHAPED inline token after the name (`/compact`, `/clear`) is a
        // harness passthrough, not a dir (codex #187). Preserve it at the FRONT of
        // the task instead of dropping it, then ask for a dir normally. A
        // multi-component path that merely doesn't exist (`/does/not/exist`) is a
        // genuine dir typo, NOT command-shaped → it still errors + drops below,
        // mirroring the typed-path flow (handleNewAnswer) which gates on the same
        // isLikelySlashCommand. (A dir BEFORE the name is always a dir attempt —
        // dirAfterName is false there — so it errors too.)
        task = task ? `${dir} ${task}` : dir
        dir = null
      } else {
        await sendMessage(ctx, `\`${dir}\` is not an absolute existing directory — pick one below or send a full path.`, out)
        dir = null
      }
    }
    const token = `n${++newTokenSeq}`
    const modelEntry = action.model ? findModel(action.model) : null
    const session: NewSession = {
      token,
      name: action.name,
      status: "awaiting-dir",
      task,
      ts: Math.floor(Date.now() / 1000),
      threadId: action.threadId ?? null,
      ...(dir ? { dir } : {}),
      ...(action.harness ? { harness: action.harness } : {}),
    }
    if (modelEntry) {
      session.model = modelEntry.id
      session.harness = modelEntry.kind
    }
    pendingNew.set(token, session)
    // Model already supplied AND dir resolved → spawn straight away (no buttons).
    if (dir && session.model) return spawnNewSession(session, session.model, null)
    // Model supplied but dir missing → ask dir; we'll spawn with the supplied model once dir lands.
    if (dir) return advanceNewAfterDir(session)
    else await askNewDir(session)
    return true
  }

  // A typed path answer to an awaiting-dir /new session. Matches the SINGLE awaiting-dir session
  // (a flat chat has at most one /new in flight). Validates the abs path, then advances: if a model
  // was already supplied on the command line, spawn now; else ask the model.
  const handleNewAnswer = async (action: Extract<Action, { kind: "new-answer" }>): Promise<boolean> => {
    reapNewSessions()
    // The NEWEST awaiting-dir session owns the typed path (review #2): even though handleNewCommand
    // clears prior sessions on a fresh /new, take the newest as a belt-and-suspenders so the path
    // always lands on the prompt the user is actually answering.
    const session = [...pendingNew.values()]
      .filter((s) => s.status === "awaiting-dir")
      .sort((a, b) => b.ts - a.ts)[0]
    if (!session) return false // no /new awaiting a dir — defensive (stepUpdates only emits when one is)
    const out = replyContext(session.threadId)
    const path = action.text.trim()
    // Reject the filesystem ROOT as a typed cwd (review #4): the dir BUTTONS already exclude `/`
    // (parentDirs stops above root — spawning an agent at `/` is never the intent), so mirror that
    // guard for a typed `/` instead of letting it slip past `isExistingDirectory('/')`.
    if (path === "/") {
      await sendMessage(ctx, "the filesystem root `/` isn't a project directory — send a real project path like /Users/you/project.", out)
      return false
    }
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      // The text isn't a usable directory. A BARE `/word` (isLikelySlashCommand) is most likely a
      // HARNESS passthrough command — `/compact`, `/clear` — meant for the live 1:1 agent, NOT a
      // path attempt (review #1, second pass): so inject it through instead of erroring, preserving
      // 1:1 passthrough even mid-/new. The session stays awaiting-dir (the user can still answer the
      // dir prompt). A `/path/with/slashes` that doesn't exist IS a genuine bad-path attempt → the
      // dir error. An empty / non-slash answer (the stepUpdates gate only emits slash text, but be
      // defensive) also re-asks.
      if (path.startsWith("/") && isLikelySlashCommand(path)) {
        // A harness control-command passthrough (/compact, /clear), not new content — no
        // git-state banner (see withGitStateBanner's scope note).
        return injectViaTarget((target) => buildTextInjectPlan(target.pane.paneId, path), path, true, action.messageId)
      }
      await sendMessage(ctx, `\`${path || "(empty)"}\` is not an absolute path to an existing directory — send a full path like /Users/you/project.`, out)
      return false
    }
    session.dir = path
    session.ts = Math.floor(Date.now() / 1000)
    if (session.promptMessageId != null) await clearMessageKeyboard(ctx, session.promptMessageId)
    // If a model was supplied on the /new line, spawn immediately; else ask harness/model.
    return advanceNewAfterDir(session)
  }

  // A recent-dir button tap (tnp:<token>:<index>) → resolve the index against the session's
  // dirChoices and advance like a typed path. A stale/forged tap (no session, wrong state, bad
  // index, vanished dir) re-asks rather than spawning into a guessed dir.
  const handleNewDir = async (action: Extract<Action, { kind: "new-dir" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session || session.status !== "awaiting-dir") {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that menu expired — send a directory")
      return false
    }
    const path = session.dirChoices?.[action.index]
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that path is gone — send one")
      await sendMessage(ctx, `\`${path ?? "(unknown)"}\` is no longer an existing directory — send an absolute path.`, replyContext(session.threadId))
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "ok")
    session.dir = path
    session.ts = Math.floor(Date.now() / 1000)
    if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
    return advanceNewAfterDir(session)
  }

  // A harness button tap (tnh:<token>:<harness>) → ask the model picker for that harness only.
  const handleNewHarness = async (action: Extract<Action, { kind: "new-harness" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (session.status !== "awaiting-harness" || !session.dir) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "pick a directory first")
      return false
    }
    const catalog = modelsForHarness(action.harness)
    if (catalog.length === 0) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "no models")
      await sendMessage(ctx, `no models configured for \`${harnessLabel(action.harness)}\``, replyContext(session.threadId))
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "ok")
    session.harness = action.harness
    session.ts = Math.floor(Date.now() / 1000)
    if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
    await askNewModel(session)
    return true
  }

  // A model button tap (tnm:<token>:<modelId>) → spawn the agent with that model. Refuses an
  // unknown model id (stale/forged callback) and an out-of-state session (already spawned / gone).
  const handleNewModel = async (action: Extract<Action, { kind: "new-model" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (session.status !== "awaiting-model" || !session.dir) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "send a directory first")
      return false
    }
    const modelEntry = findModel(action.modelId)
    if (!modelEntry) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "unknown model")
      await sendMessage(ctx, `unknown model \`${action.modelId}\` — pick a model again`, replyContext(session.threadId))
      return false
    }
    if (session.harness && modelEntry.kind !== session.harness) {
      await answerCallbackQuery(ctx, action.callbackQueryId, `pick a ${harnessLabel(session.harness)} model`)
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "starting…")
    session.model = action.modelId
    session.harness = modelEntry.kind
    return spawnNewSession(session, action.modelId, action.messageId)
  }

  // A "Retry spawn" tap (tnr:<token>) after a spawn failure → re-run the spawn with the session's
  // preserved name/dir/harness/model. Refuses a stale/forged tap (no session, wrong state, or a
  // model that vanished from the catalog). NEVER re-asks — the whole point of the retry button.
  const handleNewRetry = async (action: Extract<Action, { kind: "new-retry" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (session.status !== "awaiting-retry" || !session.model || !findModel(session.model)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "nothing to retry — run /new again")
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "retrying…")
    return spawnNewSession(session, session.model, action.messageId)
  }

  const handleNewPrivateTopicFallback = async (action: Extract<Action, { kind: "new-private-topic-fallback" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session || session.status !== "awaiting-private-topic-fallback" || !session.dir || !session.model) {
      // A stale/reaped token must NOT clobber a DIFFERENT session's live pending fallback
      // decision -- only fall back to "unknown" when nothing is actually awaiting an answer
      // (mirrors the `hasPendingFallback` guard in handleNewCommand, tg-cli#181).
      if (privateTopicFallbackState === "pending") {
        const hasPendingFallback = [...pendingNew.values()].some((s) => s.status === "awaiting-private-topic-fallback")
        if (!hasPendingFallback) privateTopicFallbackState = "unknown"
      }
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (action.choice === NEW_PRIVATE_TOPIC_FALLBACK_CANCEL) {
      privateTopicFallbackState = "unknown"
      pendingNew.delete(action.token)
      await answerCallbackQuery(ctx, action.callbackQueryId, "cancelled")
      if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
      await sendMessage(ctx, "cancelled — no agent was spawned", replyContext(session.threadId))
      return false
    }
    if (action.choice === NEW_PRIVATE_TOPIC_FALLBACK_CONTINUE) {
      privateTopicFallbackState = "accepted"
      await answerCallbackQuery(ctx, action.callbackQueryId, "starting without topics…")
      if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
      return spawnNewSession(session, session.model, action.messageId)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
    return false
  }

  // --- crash-window orphan reconcile (docs/specs/tg-forum-topics.md §9 increment 4) ---
  // CRASH GAP (spec §9.4a): handleTopicModel persists awaiting-model → `tmux new-window` →
  // persists `bound`. A daemon crash BETWEEN a successful new-window and the `bound` write leaves
  // a LIVE orphan pane plus an `awaiting-model` binding — and a later re-tap then spawns a SECOND
  // agent (the "restart can't double-spawn" guarantee only covers `bound` topics). On startup,
  // reconcile each non-bound binding against the live tmux windows by SLUG: if the topic-slug
  // window already hosts a live agent, RE-BIND that pane (adopt the orphan, no second spawn);
  // also mark any `bound` binding whose recorded pane is gone as `closed` (its agent died while
  // the daemon was down) so the next message offers a re-spawn instead of injecting into nothing.
  // Runs ONCE at startup when either public forum topics or private-chat topics use the TopicBinding
  // store, fully guarded (never aborts startup).
  const reconcileTopicsOnStartup = (): void => {
    if (!ctx.cfg.topics && !ctx.cfg.privateTopics) return
    try {
      const topics = loadTopics()
      if (topics.length === 0) return
      const { panes, procs } = snapshot()
      // An empty/flaky snapshot (the known launchd no-locale read) must NOT trigger reconciliation:
      // it would mass-close every live binding. Skip when no panes are visible.
      if (panes.length === 0) return
      const liveAgentPanes = panes.filter((p) => findAgentInPane(p, procs) !== null)
      // SECOND flake guard: a non-empty `panes` but ZERO live-agent panes most likely means the
      // `procs` (ps) read flaked (panesWithRetry resilience is per-source). Closing every `bound`
      // binding off that empty procs read would falsely kill live topics. So when we have bound
      // bindings to reconcile yet found NO agent anywhere, treat it as a flaky read and skip — a
      // genuinely all-dead fleet self-heals on the next message (handleTopicRoute re-probes per pane).
      const hasBound = topics.some((t) => t.status === "bound")
      if (liveAgentPanes.length === 0 && hasBound) return
      const ts = Math.floor(Date.now() / 1000)
      // Panes a `bound` binding LEGITIMATELY holds — never adopt one for an orphan. Mutated as we
      // adopt (a pane adopted by one binding can't ALSO be adopted by a slug-colliding sibling).
      const claimed = legitimatelyClaimedPanes(topics, liveAgentPanes)
      let changed = false
      const reconciled = topics.map((binding) => {
        const next = reconcileOneTopic(binding, liveAgentPanes, claimed, ts)
        if (next !== binding) {
          changed = true
          if (next.status === "bound" && next.paneId) claimed.add(next.paneId) // reserve the adopted pane
        }
        return next
      })
      if (changed) persistTopics(reconciled)
    } catch (err) {
      log(`reconcileTopicsOnStartup failed: ${err}`)
    }
  }

  // getFile → /file/ download into ~/.cache/tg-cli/inbound under the daemon-
  // chosen name (never the Telegram basename, spec §5.2). Returns the local path
  // or null (already logged + replied). Shared by media + voice download. The
  // WHOLE body is exception-guarded: a getFile timeout, a non-JSON body, a
  // download read error or a disk-write failure THROWS otherwise, and since the
  // poll loop persists the offset BEFORE acting, an uncaught throw loses the note
  // permanently with no reply. Catch → "media download failed" → null.
  const downloadFileToCache = async (fileId: string, suggestedName: string): Promise<string | null> => {
    // Log each retry of a network step with its label, the file id, and the
    // attempt count — shared by both steps so the message format stays in sync.
    const retryLog = (step: string) => (i: RetryInfo) =>
      log(`${step} retry ${i.attempt}/${i.maxAttempts} for ${fileId} in ${i.delayMs}ms`)
    try {
      // BOTH network steps run under bounded retry-with-backoff (default 3
      // attempts, ~300ms→900ms→2.7s jittered) so a single transient blip —
      // dropped connection, 5xx, timeout — no longer silently loses the inbound
      // note. Worst case wall time per step ≈ maxAttempts·timeout + backoffs
      // (getFile ~30s/try, file bytes ~120s/try). retryFetch only retries a
      // thrown error / non-2xx HTTP; a 200-with-{ok:false} getFile body is a
      // PERMANENT Telegram error (e.g. file gone) and is handled below, not
      // retried — same for a final non-2xx from either step, which is returned
      // for the local `!resp.ok` checks rather than thrown.
      const getFile = () =>
        fetch(`${api(ctx)}/getFile?file_id=${encodeURIComponent(fileId)}`, {
          signal: AbortSignal.timeout(30_000),
        })
      const fileResp = await retryFetch(getFile, { onRetry: retryLog("getFile") })
      const fileJson = (await fileResp.json()) as { ok: boolean; result?: { file_path?: string } }
      const remotePath = fileJson.ok ? fileJson.result?.file_path : undefined
      if (!remotePath) {
        log(`getFile failed for ${fileId}`)
        await sendMessage(ctx, "media download failed")
        return null
      }
      const fetchBytes = () =>
        fetch(`${ctx.apiBase}/file/bot${ctx.token}/${remotePath}`, {
          signal: AbortSignal.timeout(120_000),
        })
      const dataResp = await retryFetch(fetchBytes, { onRetry: retryLog("file download") })
      if (!dataResp.ok) {
        log(`file download failed: HTTP ${dataResp.status} for ${fileId} after retries`)
        await sendMessage(ctx, "media download failed")
        return null
      }
      const dir = join(ctx.home, ".cache", "tg-cli", "inbound")
      mkdirSync(dir, { recursive: true })
      const dest = join(dir, suggestedName)
      writeFileSync(dest, new Uint8Array(await dataResp.arrayBuffer()))
      return dest
    } catch (err) {
      log(`media download error for ${fileId}: ${err}`)
      await sendMessage(ctx, "media download failed")
      return null
    }
  }

  const downloadMedia = async (action: Extract<Action, { kind: "download-media" }>): Promise<boolean> => {
    const dest = await downloadFileToCache(action.fileId, action.suggestedName)
    if (dest === null) return false
    const noun = action.mediaKind === "photo" ? "photo" : "file"
    const routedCaption = action.agentRoute ? action.agentRoute.rest : action.caption
    const msg = `sent ${noun}: ${dest}` + (routedCaption ? `\n${routedCaption}` : "")
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, msg, action.messageId)
    if (action.agentRoute) {
      return routePrewrappedAgentMessage(action.agentRoute, wrapped, action.messageId)
    }
    if (action.replyToMessageId !== undefined) {
      const injectText = `${action.replyAnchor ?? ""}\n${wrapped}`.replace(/^\n/, "")
      return handleReplyRoute({
        kind: "reply-route",
        replyToMessageId: action.replyToMessageId,
        injectText,
        from: action.from,
        messageId: action.messageId,
      })
    }
    if (selectedAgentRoute) {
      const selectedResult = await injectIntoSelectedAgent(wrapped, action.messageId)
      if (selectedResult !== null) return selectedResult
    }
    // A non-reply photo/file → auto-bind to the last-active agent like a text msg, with the
    // git-state-check banner (withGitStateBanner) prepended when that pane is mid-flight.
    return injectViaTarget(
      (target) => buildTextInjectPlan(target.pane.paneId, withGitStateBanner(target.pane.panePath, wrapped)),
      wrapped,
      true,
      action.messageId,
    )
  }

  // Voice note → text (inbound STT). Unconfigured? Walk the user through setup
  // instead of dropping it (the CTO's "если не настроено — бот проводит через
  // настройку"). Otherwise: download OGG → ffmpeg WAV 16k mono → local Whisper →
  // clean → route EXACTLY like a typed message (reply-route when it was a reply,
  // else inject into the discovered pane). The 👀 ack still fires via the step's
  // trailing ack action when this returns true.
  const transcribeVoice = async (action: Extract<Action, { kind: "transcribe-voice" }>): Promise<boolean> => {
    // Reload the voice config from disk EVERY note: a `tg voice setup` run while
    // this daemon was already up must take effect without a restart. The parsed
    // PARTIAL is kept too, to tell "explicitly disabled" from "not configured".
    const rawYaml = readFileOrNull(join(ctx.configDir, "config.yaml")) ?? ""
    const voicePartial = parseVoiceConfig(rawYaml)
    ctx.voice = resolveVoiceConfig(voicePartial)

    // Master switch: an explicit `voice.enabled: false` means OFF — drop the
    // note silently (no onboarding, no re-enable). The documented opt-out must
    // survive a discoverable Whisper still being on the box.
    if (voicePartial.enabled === false) {
      log("voice note ignored — voice.enabled: false")
      return false
    }

    if (!voiceReady(ctx)) {
      // Not yet configured → auto-onboarding reply. No ack (the reply IS the
      // signal); returning false marks the action unhandled for the ack gate.
      const verdict = decideOnboarding(probeWhisper(ctx.home), ctx.voice.language)
      if (verdict.kind === "ready") {
        // We discovered a working install on the fly — persist it so the NEXT
        // voice note transcribes without re-prompting. But only CLAIM success if
        // the write actually landed: a read-only config.yaml would otherwise tell
        // the user "configured" while the next note loops back to onboarding.
        if (persistVoiceConfigToDir(ctx.configDir, verdict.cfg)) {
          ctx.voice = verdict.cfg
          await sendMessage(ctx, onboardingMessage(verdict))
        } else {
          await sendMessage(
            ctx,
            `🎙️ Found a local Whisper (${verdict.cfg.runner}, ${verdict.cfg.modelPath}) but could not save ` +
              `the config. Fix write permissions on ${join(ctx.configDir, "config.yaml")} and resend, or run \`tg voice setup\`.`,
          )
        }
      } else {
        await sendMessage(ctx, onboardingMessage(verdict))
      }
      return false
    }

    const dest = await downloadFileToCache(action.fileId, action.suggestedName)
    if (dest === null) return false

    const text = await runTranscription(ctx, dest)
    if (text === null) {
      await sendMessage(ctx, "voice transcription failed — see daemon log")
      return false
    }
    if (text.trim() === "") {
      await sendMessage(ctx, "voice note had no recognizable speech")
      return false
    }

    // This is an STT confirmation only, not a delivery receipt. Routing below may
    // still produce a separate no-agent / picker / inject-failed signal.
    await sendMessage(ctx, formatVoiceConfirmation(text), { reply_to_message_id: action.messageId })

    // Route exactly like a typed message, but present the transcript as a 🎤-marked
    // quote (formatVoiceTranscript) so the agent can tell it's transcribed speech, not
    // typed text: a reply note carries the quote anchor and goes through the SAME
    // reply-route path; a standalone note injects into the discovered pane.
    const quoted = formatVoiceTranscript(text)
    if (action.replyToMessageId !== undefined) {
      const injectText = `${action.replyAnchor ?? ""}\n${wrapInbound(
        ctx.cfg.injectWrap,
        action.from,
        quoted,
        action.messageId,
      )}`.replace(/^\n/, "")
      return handleReplyRoute(
        {
          kind: "reply-route",
          replyToMessageId: action.replyToMessageId,
          injectText,
          from: action.from,
          messageId: action.messageId,
        },
        action.replyToMessageId,
      )
    }
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, quoted, action.messageId)
    if (selectedAgentRoute) {
      const selectedResult = await injectIntoSelectedAgent(wrapped, action.messageId)
      if (selectedResult !== null) return selectedResult
    }
    // A non-reply voice note → auto-bind to the last-active agent like a text msg, with the
    // git-state-check banner (withGitStateBanner) prepended when that pane is mid-flight.
    return injectViaTarget(
      (target) => buildTextInjectPlan(target.pane.paneId, withGitStateBanner(target.pane.panePath, wrapped)),
      wrapped,
      true,
      action.messageId,
    )
  }

  // Best-effort delivery receipt (spec §10): 👀 on the source message. A
  // failed reaction is logged and otherwise ignored — receipts must never
  // break the poll loop (e.g. a Bot API fake without the endpoint).
  const setReaction = async (messageId: number, emoji: string): Promise<void> => {
    try {
      const resp = await fetch(`${api(ctx)}/setMessageReaction`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          chat_id: ctx.chatId,
          message_id: messageId,
          reaction: [{ type: "emoji", emoji }],
        }),
        signal: AbortSignal.timeout(15_000),
      })
      if (!resp.ok) log(`setMessageReaction failed: ${resp.status}`)
    } catch (err) {
      log(`setMessageReaction failed: ${err}`)
    }
  }
  const setSeenReaction = (messageId: number): Promise<void> => setReaction(messageId, "👀")
  const setSeenReactions = async (
    primaryMessageId: number | null,
    relatedMessageId: number | null | undefined,
  ): Promise<void> => {
    // setReaction is best-effort and already catches/logs Bot API failures.
    const ids = Array.from(new Set([primaryMessageId, relatedMessageId].filter((id): id is number => typeof id === "number")))
    for (const id of ids) await setSeenReaction(id)
  }
  // ⏳ is NOT in Telegram's allowed reaction set; ✍️ ("noted, queued") is the
  // closest allowed emoji for "deferred behind the agent's open question".
  const DEFER_REACTION = "✍️"

  // --- auto-continue schedules (#113) — durable, re-armed on restart ---
  // A button tap arms a setTimeout to inject "continue" into the stalled pane at
  // reset time. The schedule is persisted so a daemon restart between the tap and
  // the reset re-arms it (a past reset fires immediately). One pending continue
  // per pane; on fire we inject, flip the card's reaction back to 👀, and drop it.
  let scheduleStore: ScheduleStoreData = parseSchedules(readFileOrNull(ctx.paths.schedules), Date.now())
  const continueTimers = new Map<string, ReturnType<typeof setTimeout>>()
  const persistSchedules = (): void => {
    try {
      atomicWrite(ctx.paths.schedules, serializeSchedules(scheduleStore, Date.now()))
    } catch (err) {
      log(`persistSchedules failed: ${err}`)
    }
  }

  // --- tg-awareness-nudge (tg-cli#363) — durable per-agent silence-nudge state ---
  // Mirrors scheduleStore's own load/persist shape exactly (parse-on-load,
  // atomic-write-on-mutation, best-effort — a corrupt/unwritable file degrades
  // to "no nudges yet remembered", never breaks the poll loop).
  let awarenessNudgeStore: AwarenessNudgeStore = parseAwarenessNudgeStore(readFileOrNull(ctx.paths.awarenessNudge))
  const persistAwarenessNudge = (): void => {
    try {
      atomicWrite(ctx.paths.awarenessNudge, serializeAwarenessNudgeStore(awarenessNudgeStore))
    } catch (err) {
      log(`persistAwarenessNudge failed: ${err}`)
    }
  }
  const fireAutoContinue = async (s: AutoContinueSchedule): Promise<void> => {
    // A reset > ~24.8 days out is clamped to MAX_TIMER_MS, so the timer can wake
    // BEFORE the real reset — re-arm instead of injecting early.
    if (Date.now() < s.resetAt) {
      armAutoContinue(s)
      return
    }
    continueTimers.delete(s.paneId)
    scheduleStore = removeSchedule(scheduleStore, s.paneId)
    persistSchedules()
    // A tmux restart recycles pane ids — %N may now host a DIFFERENT agent (or a
    // bare shell). If we knew the agent at arm time, refuse to inject "continue"
    // into a pane that no longer maps to it (executeInjectSteps only checks that
    // SOME agent is there, not WHICH). Skip quietly rather than poke the wrong one.
    if (s.agent) {
      const live = listAgentCandidates().find((c) => c.paneId === s.paneId)
      if (!live || (live.windowName && live.windowName !== s.agent)) {
        log(`auto-continue skipped: ${s.paneId} no longer hosts ${s.agent}`)
        return
      }
    }
    // Clear the card's button first so a stale card can't re-arm a second inject.
    if (s.cardMessageId !== null) await clearMessageKeyboard(ctx, s.cardMessageId)
    const res = await executeInjectSteps(buildTextInjectPlan(s.paneId, "continue"))
    if (!res.ok) log(`auto-continue inject failed for ${s.paneId}: ${res.error}`)
    else log(`auto-continue fired for ${s.paneId} (agent=${s.agent})`)
    // Resume: flip the ORIGINAL inbound message (😴 → 👀), not the bot's card.
    if (s.sourceMessageId !== null) await setMessageReaction(ctx, s.sourceMessageId, reactionForStage("working"))
  }
  const armAutoContinue = (s: AutoContinueSchedule): void => {
    const existing = continueTimers.get(s.paneId)
    if (existing) clearTimeout(existing)
    const timer = setTimeout(() => void fireAutoContinue(s), autoContinueDelayMs(s.resetAt, Date.now()))
    continueTimers.set(s.paneId, timer)
  }
  const handleLimitContinue = async (action: Extract<Action, { kind: "limit-continue" }>): Promise<boolean> => {
    // Reject a stale FIRST-TIME tap before arming (PR #120 review): an inline
    // keyboard tapped long after its reset would otherwise upsert + arm with
    // autoContinueDelayMs() clamped to 0, injecting "continue" INSTANTLY into
    // whatever now occupies that pane id — possibly a different session. A
    // restart re-arm already drops resets this old via the schedule store's
    // own prune(); apply the identical threshold here so a first-time tap
    // (which never goes through prune) can't bypass it.
    if (isDeadReset(action.resetAt, Date.now())) {
      log(`limit-continue rejected: stale resetAt for ${action.paneId} (reset=${action.resetAt})`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "This auto-continue has expired — continue manually.")
      return true
    }
    // The agent name isn't in the callback_data — recover it from the live pane.
    const agent = listAgentCandidates().find((c) => c.paneId === action.paneId)?.windowName ?? ""
    const schedule: AutoContinueSchedule = {
      paneId: action.paneId,
      resetAt: action.resetAt,
      agent,
      // The ORIGINAL inbound message (from the callback_data) is the reaction
      // target; action.messageId is the bot's card, whose button we clear on fire.
      sourceMessageId: action.sourceMessageId,
      cardMessageId: action.messageId,
      armedAt: Date.now(),
    }
    scheduleStore = upsertSchedule(scheduleStore, schedule)
    persistSchedules()
    armAutoContinue(schedule)
    await answerCallbackQuery(ctx, action.callbackQueryId, `auto-continue armed for ${formatClock(action.resetAt)}`)
    return true
  }
  // Re-arm any schedule that survived a restart (fires now if its reset passed).
  for (const s of scheduleStore.schedules) armAutoContinue(s)

  // Late-delivery (this PR — the CTO's "I pressed a button but it didn't reach the
  // harness" bug): a Telegram tap arrived for a SCOPED question whose hook socket
  // already CLOSED (its 120s window elapsed → terminal fallback, OR a daemon restart
  // restored it from disk). The agent is no longer blocked on the socket, but the
  // chosen option can still reach the pane it asked from — inject it like any inbound
  // reply (the established voice/text-reply path). Record the answer so a hook that
  // reconnects with the SAME requestId replays it instead of re-forwarding, then drop
  // the retained entry. Returns false when there is nothing to late-deliver (no
  // retained entry, or the tap doesn't resolve to an option), so the caller falls
  // back to the expired/already-answered toast.
  // Grant protocol v1.1 (tg-cli#398): a late tap on an EXPIRED hatch card. This
  // REPLACES the old silent queuedDecision mechanism for hatch requests, which
  // authorized ANY later operation behind the same hookId. A late Approve inside
  // the 24h grace window mints a single-use grant (bound to hook_id + operation
  // fingerprint + cwd + the daemon-observed route), confirms on the card, and
  // routes the contract's consume-instructions message to the origin (omp ACP /
  // inbox — never a live permission menu, the exact no-menu skip this fixes); a
  // tap beyond grace is told it is too late (the agent must re-request) and
  // mints NOTHING. A belated Deny has nothing to deliver (no deny-grant exists
  // in the contract) — it just retires the card. `expiredAt` is the ask's
  // expiry moment (the grace anchor): the retained entry's `at` on the retained
  // path, the grace record's `expiredAt` on the grace-only path.
  const handleHatchLateTap = async (
    action: Extract<Action, { kind: "answer-question" }>,
    req: ButtonRequest,
    cardId: number | null,
    answer: ButtonAnswer,
    expiredAt: number,
  ): Promise<boolean> => {
    const now = Date.now()
    if (answer.decision === "deny") {
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(ctx, cardId, buildAnsweredQuestionText(req, answer.label), undefined, hatchParseMode(req))
      }
      log(`hatch-late-deny: ${describeAskRequest(req)} key=${action.requestId} — expired ask, nothing to deliver`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "denied — the request had already expired; the agent must re-request")
      return true
    }
    if (now >= expiredAt + GRACE_WINDOW_MS) {
      // Beyond the 24h grace window: NO grant (contract §4's too-late branch).
      // Retire the stale grace record so this card can never mint later.
      const i = grantsData.grace.findIndex((g) => g.key === action.requestId)
      if (i >= 0) {
        grantsData.grace.splice(i, 1)
        persistGrants()
      }
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(ctx, cardId, "too late — the 24h late-approval window has closed; the agent must request approval again")
      }
      log(`hatch-grant-too-late: ${describeAskRequest(req)} key=${action.requestId} ageMs=${now - expiredAt}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "too late — the agent must re-request")
      return true
    }
    // Fail-closed mint gate: a grant is useless unless it can be BOUND (an
    // old-lib ask carries no hookId/operation fields — grants.ts's
    // isGrantableRequest). Tell the user plainly instead of minting an
    // unconsumable grant.
    if (!isGrantableRequest(req)) {
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(
          ctx,
          cardId,
          "this expired request came from an older agent-tools version without grant fields — a late approval cannot be bound to it; the agent must re-request",
        )
      }
      log(`hatch-grant-not-grantable: ${describeAskRequest(req)} key=${action.requestId} — no hookId/operation on the ask`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "cannot grant — the agent must re-request")
      return true
    }
    let grant = grantsData.grants.find((g) => g.request_id === req.requestId) ?? null
    if (grant && grant.consumed_at !== null) {
      // Double-mint guard: this approval was already USED — never mint another.
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(ctx, cardId, `grant ${grant.approval_id} was already used — grants are single-use; the agent must re-request`)
      }
      log(`hatch-grant-already-used: ${describeAskRequest(req)} key=${action.requestId} approvalId=${grant.approval_id}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "a grant for this request was already used")
      return true
    }
    if (!grant) {
      const approvalId = `hgr-${Array.from(crypto.getRandomValues(new Uint8Array(6)), (b) => b.toString(16).padStart(2, "0")).join("")}`
      grant = buildGrantRecord(req, approvalId, routeForRequest(req), now, GRANT_TTL_MS)
      grantsData.grants.push(grant)
      // Durable BEFORE confirming (single-use invariant): a failed write rolls
      // the mint back — the user is told to tap again rather than being handed
      // an approval a restart would lose.
      if (!persistGrants()) {
        grantsData.grants.pop()
        log(`hatch-grant-mint-failed: ${describeAskRequest(req)} key=${action.requestId} — grant store write failed`)
        await answerCallbackQuery(ctx, action.callbackQueryId, "could not record the grant — tap again")
        return true
      }
      log(
        `hatch-grant-minted: ${describeAskRequest(req)} key=${action.requestId} hookId=${grant.hook_id} approvalId=${grant.approval_id} route=${grant.route ?? "-"}`,
      )
    }
    // An unconsumed grant already existed (a re-tap — e.g. after a delivery
    // failure or a duplicate tap): RE-ROUTE the notice instead of minting.
    const notice = hatchGrantNoticeText({
      requestId: req.requestId,
      question: req.question,
      hookId: grant.hook_id,
      approvalId: grant.approval_id,
      approvedAt: grant.approved_at,
      expiresAt: grant.expires_at,
    })
    const delivered = await routeGrantNotice(ctx, req, notice)
    if (cardId !== null) {
      void clearMessageKeyboard(ctx, cardId)
      void editMessageText(ctx, cardId, hatchGrantApprovedText(req, grant.approval_id, delivered), undefined, hatchParseMode(req))
    }
    log(`hatch-grant-notice-${delivered ? "delivered" : "failed"}: approvalId=${grant.approval_id} route=${grant.route ?? "-"} key=${action.requestId}`)
    await answerCallbackQuery(
      ctx,
      action.callbackQueryId,
      delivered ? "✓ grant issued and sent to the agent" : "grant issued — could not reach the agent (the token path still works)",
    )
    return true
  }

  // A tap on an expired hatch card whose abandoned entry is GONE (pruned at the
  // 12h retention, or the daemon restarted since) — the grace store (grants.ts)
  // is what keeps it addressable through 24h. Only hatch asks ever grow grace
  // records, so a non-hatch tap falls straight through to the existing toasts.
  const handleGraceStoreTap = async (action: Extract<Action, { kind: "answer-question" }>): Promise<boolean> => {
    const rec = grantsData.grace.find((g) => g.key === action.requestId)
    if (!rec) return false
    // Same own-card guard as the retained path: a stale card must not resolve a
    // different record that happens to share the callback key.
    if (rec.messageId !== null && action.messageId !== null && action.messageId !== rec.messageId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    const answer = resolveButtonCallback(rec.req, { requestId: action.requestId, value: action.value })
    if (answer.status !== "answered") {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    return handleHatchLateTap(action, rec.req, action.messageId ?? rec.messageId, answer, rec.expiredAt)
  }

  const lateDeliverAbandonedQuestion = async (
    action: Extract<Action, { kind: "answer-question" }>,
  ): Promise<boolean> => {
    const retained = abandonedButtons.get(action.requestId)
    if (!retained) return false
    // A hatch/RIG_HATCH_REQUEST_* permission (see parseHatchHookId) is
    // retained with no paneId (retainAbandonedQuestion's paneless carve-out)
    // specifically so a late tap here CAN still be recorded as a queuedDecision
    // — this early "nothing to inject into" bail-out must not reject it before
    // the permission branch below ever runs.
    if (!retained.req.omp && !retained.req.paneId && !(retained.req.kind === "permission" && isHatchRequest(retained.req))) return false
    if (retained.req.omp) {
      const answer = resolveButtonCallback(retained.req, { requestId: action.requestId, value: action.value })
      if (answer.status !== "answered") return false
      const optionId = optionIdForAnswer(retained.req, answer.value, answer.label)
      const answeredAt = Date.now()
      abandonedButtons.delete(action.requestId)
      pruneAnsweredButtons(answeredButtons, answeredAt)
      answeredButtons.set(action.requestId, { value: answer.value, label: answer.label, decision: answer.decision, at: answeredAt, delivery: "socket" })
      persistQuestions()
      const res = await replyOmpAcpPermission(retained.req, optionId)
      if (!res.ok) {
        answeredButtons.delete(action.requestId)
        abandonedButtons.set(action.requestId, { req: retained.req, messageId: retained.messageId, at: retained.at })
        persistQuestions()
        await answerCallbackQueryOrNotify(ctx, action, "could not reach omp ACP — tap again")
        return true
      }
      await answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
      const cardId = retained.messageId ?? action.messageId
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(ctx, cardId, buildAnsweredQuestionText(retained.req, answer.label), undefined, hatchParseMode(retained.req))
      }
      log(`omp-acp: tap delivered via session/request_permission reply optionId=${optionId}`)
      return true
    }
    // A tap must come from THIS retained entry's OWN Telegram message — mirrors the
    // live-prompt path's same guard (case "answer-question" below). Without it, a
    // stale card reusing a deterministic callback key (callbackRequestId is a
    // stable hash of session+question) could queue or overwrite the decision for a
    // DIFFERENT, newer retained entry that happens to hash-collide (review
    // finding). Skipped only while the card's own messageId is still unknown
    // (send in flight) — same as the live path.
    if (
      retained.messageId !== null &&
      action.messageId !== null &&
      action.messageId !== retained.messageId
    ) {
      await answerCallbackQueryOrNotify(ctx, action, "expired")
      return true
    }
    // Enforce the retention window at DELIVERY time, not only on persist/restore. On a
    // QUIET daemon (no mutation since the abandon) pruneAbandonedButtons never runs, so
    // without this check an arbitrarily-stale answer would still be injected into a pane
    // whose agent has long since moved on. Past the window → drop the entry, retire the
    // now-dead card, and fall through to the "expired" toast. Applies to every kind
    // (question, permission, multi-question member) — a permission's QUEUING below must
    // not queue against an entry the daemon has already given up on — but a permission
    // uses ABANDONED_PERMISSION_RETAIN_MS here, matching pruneAbandonedButtons's own
    // per-kind window (tg-cli#182): otherwise a tap could be rejected as "expired" here
    // for an entry pruneAbandonedButtons has NOT actually deleted yet.
    if (isAbandonedExpired(retained.req.kind, retained.at, Date.now(), retained.req.critical)) {
      abandonedButtons.delete(action.requestId)
      persistQuestions()
      const staleCardId = retained.messageId ?? action.messageId
      if (staleCardId !== null) {
        void clearMessageKeyboard(ctx, staleCardId)
        void editMessageText(ctx, staleCardId, EXPIRED_TERMINAL_TEXT)
      }
      log(`ask-late-deliver-expired: ${describeAskRequest(retained.req)} key=${action.requestId} ageMs=${Date.now() - retained.at}`)
      return false
    }
    // A permission's LIVE hook needs a structured JSON reply, not terminal text —
    // but once that hook has closed, the harness has ALREADY fallen back to its own
    // terminal prompt, and for claude that prompt is directly answerable by
    // re-checking the pane and injecting the matching digit (see the pane-recheck
    // block right below, tg-cli#267). That covers claude; every other agent kind,
    // and claude when the menu can't be re-verified live, still can't be delivered
    // to right now and must NOT be silently dropped either (Alex tg requirement:
    // never lose a tapped decision) — QUEUE it on the retained entry so a
    // reconnecting hook delivers it automatically the instant it re-attaches (see
    // handleHookSocketLine's RECONNECT re-attach branch). A later re-tap overwrites
    // the queued value (last tap wins, covers a misclick).
    if (retained.req.kind === "permission") {
      // `resolveButtonCallback` (features/tg-ctl/questions.ts) always sets a real
      // 'allow'|'deny' `decision` when it returns status:"answered" for a
      // permission — there is no answered-but-undefined-decision case — so
      // `answer.decision` below is never undefined here (verified: PermissionDecision
      // is exactly 'allow'|'deny', and both permission branches of
      // resolveButtonCallback set it alongside status:"answered"). This is the same
      // invariant question-store.ts's parseQueuedDecision enforces for the on-disk
      // path (review finding: the two paths must agree), so the queue is never
      // created with a decision the restore-time validator would reject.
      const answer = resolveButtonCallback(retained.req, { requestId: action.requestId, value: action.value })
      if (answer.status !== "answered") return false

      // HATCH DIVERSION (grant protocol v1.1, tg-cli#398): a late tap on a
      // retained hatch card mints a single-use, operation-bound GRANT and routes
      // the consume instructions to the origin — it must NEVER record a
      // queuedDecision (the removed mechanism authorized ANY later operation
      // behind the same hookId, exactly what v1.1 forbids). The entry is
      // resolved by the grant; drop it so a re-tap exercises the grace store
      // (idempotent re-route of the existing grant, handleHatchLateTap).
      if (parseHatchHookId(retained.req.requestId) !== null) {
        abandonedButtons.delete(action.requestId)
        persistQuestions()
        return handleHatchLateTap(action, retained.req, retained.messageId ?? action.messageId, answer, retained.at)
      }
      const label = resolveWindowAgentLabel(retained.req.windowName, retained.req.cwd)
      const paneId = retained.req.paneId

      // QUEUE FIRST, unconditionally, BEFORE any pane-inject attempt below —
      // durable on disk before we ever touch tmux. This ordering matters: a
      // daemon crash between an inject attempt and its post-inject confirm
      // (an await on a subprocess plus a pacing sleep — not a negligible
      // window) must NEVER lose the tap (Alex tg#9982 requirement, the exact
      // guarantee the queuedDecision mechanism exists to provide). If the tap
      // were instead recorded as "answered" only AFTER a successful confirm,
      // a crash in that window would persist NOTHING — no queuedDecision to
      // recover from, no live socket to deliver to, and a re-tap would find
      // nothing retained (review finding: an earlier version of this claimed
      // "answered" BEFORE the inject even ran, regressing exactly this
      // invariant). Queuing first means the worst case of a crash mid-inject
      // is simply the pre-existing, already-durable "queued" state — a
      // pane-inject success below UPGRADES this record to answered/delivered;
      // it never has to roll one back.
      const queuedAt = Date.now()
      retained.queuedDecision = { value: answer.value, label: answer.label, decision: answer.decision, at: queuedAt }
      // A fresh tap is itself activity worth restarting the retention clock for —
      // without this, a tap made near the end of the window would still expire on
      // the very next sweep seconds later, flipping the card from "queued …
      // delivered automatically" to "never delivered" despite the human just having
      // acted (review finding). Accepted (not a bug, review finding): a human who
      // keeps RE-tapping (last tap wins) keeps postponing the window indefinitely —
      // that's fine, each tap is genuine fresh activity re-confirming the decision,
      // the same way any other mutation legitimately resets other windows in this
      // file (e.g. ANSWERED_REPLAY_MS on a fresh answer).
      retained.at = queuedAt
      persistQuestions() // durable NOW — a restart before any other mutation must not lose this tap

      // The CTO's spec (verbatim): "no waiting process — check via tmux
      // whether the permission request is still showing, and send the
      // keypresses." Claude Code's own numbered "Do you want to proceed?"
      // menu is answerable directly this way — the harness has already
      // fallen back to ITS OWN terminal prompt, so nothing causes a fresh
      // hook to fire and reconnect; queuing-and-waiting (below) can wait
      // forever. Scoped to claude (tg-cli#267): its menu layout and
      // bare-digit-submits-instantly behavior are the only ones verified
      // live (tmux capture-pane test, 2026-08-18) — every other agent kind
      // falls straight through to the existing queue-and-wait path,
      // unchanged. KNOWN RESIDUAL LIMITATIONS, accepted rather than silently
      // ignored (tg-cli#268 tracks broadening/verifying these further): a
      // command containing a real newline (heredocs, multi-line strings) can
      // never line-match in permissionMenuMatchesRequest and always falls
      // through to queuing (tracked separately as tg-cli#283, needing live
      // verification of how Claude Code actually renders a multi-line
      // command's box before a fix can be trusted — see that issue); and
      // there is a millisecond TOCTOU between the
      // pre-inject capture/identity-check and the actual `send-keys` where
      // the human could resolve THIS menu at the keyboard and a genuinely
      // DIFFERENT permission's menu could appear before the digit lands —
      // the post-inject re-verify below narrows this but cannot fully close
      // it from outside the app.
      if (paneId && retained.req.agent === "claude" && !shouldDeferInbound(paneId)) {
        const captured = capturePane(paneId)
        // BOTH must hold: the menu is showing, AND its BOUNDED context (never
        // the whole pane — see ParsedPermissionMenu.context) still identifies
        // THIS request's own command/question — not a newer, unrelated
        // permission the harness has since moved on to within the retention
        // window. Skipping the identity check, or checking it against the
        // whole pane instead of the menu's own context, would let a stale tap
        // inject "Yes" into whatever happens to be pending right now (review
        // finding — two independent reviewers found the whole-pane version of
        // this check bypassable via an older command's leftover scrollback).
        // hasLiveCursor gates injection the same way it gates the post-inject
        // confirmation below: text alone doesn't prove this menu is the
        // currently-answerable one — the cursor does (see
        // ParsedPermissionMenu.hasLiveCursor). Injecting a digit at a menu
        // that's already resolved (text still visible in scrollback, cursor
        // gone) would land the keypress on whatever's actually focused now,
        // not this request.
        const menu = captured ? parsePermissionMenu(captured) : null
        const menuIsLive = menu?.hasLiveCursor ?? false
        const identityMatches = menuIsLive ? permissionMenuMatchesRequest(menu.context, extractPermissionIdentity(retained.req)) : false
        const digit = menu && identityMatches ? pickPermissionMenuDigit(menu.options, answer.decision) : null
        if (digit !== null) {
          let deliveryFailure: string | null = null
          try {
            const res = await executeInjectSteps(buildDigitInjectPlan(paneId, digit))
            deliveryFailure = res.ok ? null : res.error
          } catch (err) {
            // Bun.spawnSync can throw (missing tmux binary, broken PATH) —
            // this call site is the one explicitly claiming rollback-safe
            // semantics, so it must not let a throw skip straight past the
            // "already safely queued" fallback below (review finding).
            deliveryFailure = `inject threw: ${err instanceof Error ? err.message : String(err)}`
          }
          // A tmux exit-0 only proves the keypress was SENT, not that Claude
          // Code actually consumed it as the menu choice — e.g. the pane is
          // in tmux copy-mode (scrolled up), where a literal digit is
          // swallowed by copy-mode's own key table instead of reaching the
          // app underneath (review finding). Re-capture after a short pace
          // and require the SAME identified menu to still be LIVE (its
          // cursor glyph still present, see ParsedPermissionMenu.hasLiveCursor)
          // before claiming non-delivery — this is what actually verifies the
          // tap worked. Gating on the marker/option TEXT being gone (an
          // earlier version) is unsound: we have no confirmed evidence
          // Claude Code erases a resolved menu from the pane rather than
          // leaving it visible as scrollback history, and a real terminal
          // that retains it would make every successful delivery misread as
          // "still pending" forever (review finding). The cursor is specific
          // to the currently-answerable widget either way — gone means
          // resolved, whether or not the surrounding text sticks around. A
          // FAILED re-capture (tmux error, dead pane) proves NOTHING about
          // the menu and must be treated as NOT confirmed, never as
          // confirmed-by-default (review finding: an earlier version was
          // fail-open here — a null capture made `stillPending` false, which
          // read as "confirmed delivered").
          if (deliveryFailure === null) {
            await Bun.sleep(400)
            const after = capturePane(paneId)
            if (after === null) {
              deliveryFailure = "post-inject re-capture failed — cannot confirm delivery"
            } else {
              const afterMenu = parsePermissionMenu(after)
              const stillPending =
                afterMenu !== null &&
                afterMenu.hasLiveCursor &&
                permissionMenuMatchesRequest(afterMenu.context, extractPermissionIdentity(retained.req))
              if (stillPending) deliveryFailure = "delivery not confirmed — the same menu is still showing after inject"
            }
          }
          if (deliveryFailure === null) {
            // Confirmed delivered — UPGRADE the already-queued entry to
            // answered/pane-delivered (never a rollback needed on this path:
            // nothing was ever recorded as "answered" before this point).
            abandonedButtons.delete(action.requestId)
            pruneAnsweredButtons(answeredButtons, Date.now())
            answeredButtons.set(action.requestId, { value: answer.value, label: answer.label, decision: answer.decision, at: Date.now(), delivery: "pane" })
            persistQuestions()
            log(`ask-late-deliver-permission-pane: ${describeAskRequest(retained.req)} key=${action.requestId} label=${answer.label} pane=${paneId} digit=${digit}`)
            await answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
            const cardId = retained.messageId ?? action.messageId
            if (cardId !== null) {
              void clearMessageKeyboard(ctx, cardId)
              void editMessageText(ctx, cardId, buildAnsweredQuestionText(retained.req, answer.label), undefined, hatchParseMode(retained.req))
            }
            return true
          }
          // Not confirmed — the entry is ALREADY safely queued (from the top
          // of this block), so there is nothing to roll back; just log why
          // the optimization didn't apply and fall through to the normal
          // queued-decision UI below.
          log(`ask-late-deliver-permission-pane-failed: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} err=${deliveryFailure}`)
        } else {
          // No live, identity-matching menu to inject into right now — log
          // WHY, so a genuinely-dead pane-inject path (e.g. an unverified
          // real-world deny label, tg-cli#268) is distinguishable in the
          // field from "menu already resolved" instead of reading identical
          // to the ordinary queuing case (review finding). `no-live-cursor`
          // is its own reason, not folded into `identity-mismatch` — a
          // resolved-but-retained menu box (text present, cursor gone) is a
          // DIFFERENT cause than "a live menu is showing a different
          // command," and conflating them points field debugging at the
          // wrong one (review finding).
          const reason = !menu ? "no-menu" : !menuIsLive ? "no-live-cursor" : !identityMatches ? "identity-mismatch" : "no-pickable-option"
          log(`ask-late-deliver-permission-pane-skip: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} reason=${reason}`)
        }
      }

      // Not delivered via pane-inject (unsupported agent kind, deferred pane,
      // no live/identity-matching menu, or unconfirmed injection) — already
      // durably queued above; render the existing queued-decision UI. A HATCH
      // entry never reaches here (the grant diversion above returned first) —
      // this is exclusively the scoped-permission reconnect queue.
      const cardId = retained.messageId ?? action.messageId
      // The keyboard MUST ride along explicitly here too (see the disconnect-edit
      // comment in armPendingSocketClose) — "tap again to change it" is a lie if
      // THIS edit is what removes the buttons (review finding).
      if (cardId !== null) {
        void editMessageText(
          ctx,
          cardId,
          // Card text reads `retained.req` — the toast below MUST read the SAME
          // object (never the incoming `req`/`action`), or queuedDecisionCanAutoDeliver's
          // "single source of truth" guarantee is only nominal (review finding).
          queuedPermissionDecisionText(retained.req, label, answer.label),
          buildButtonMessage(ctx.chatId, retained.req).reply_markup,
          hatchParseMode(retained.req),
        )
      }
      // Hatch's proactive push lives entirely in routeGrantNotice (this
      // file), exercised via handleHatchLateTap.
      log(`ask-permission-decision-queued: ${describeAskRequest(retained.req)} key=${action.requestId} label=${answer.label}`)
      // The ephemeral toast must make the SAME promise as the card text — both
      // branch on the SAME shared predicate (queuedDecisionCanAutoDeliver)
      // instead of independently re-deriving the same truthiness check, so they
      // can never silently drift apart again (Codex review finding + follow-up
      // review finding on this fix itself).
      await answerCallbackQuery(
        ctx,
        action.callbackQueryId,
        queuedDecisionCanAutoDeliver(retained.req) ? "queued — will send once the hook reconnects" : "queued — tap again once it reconnects",
      )
      return true
    }
    // A multi-question SET MEMBER is retained ONLY for reconnect re-attach. Its
    // lone answer must never inject into the pane: the local multi-question
    // dialog that took over may be showing a DIFFERENT question, so the injected
    // text would answer the wrong prompt (all-or-nothing — see
    // ButtonRequest.multiQuestion). Refuse WITHOUT mutating state: the retained
    // entry and the card's keyboard survive, so a `tg-ctl ask` resend across a
    // daemon bounce still re-attaches to the original card (no duplicate), and
    // an in-window re-fire of the whole set replays normally. A genuinely-stale
    // member is cleaned up by the retention-window branch above.
    if (retained.req.multiQuestion) {
      log(`ask-late-deliver-refused: multi-question member ${describeAskRequest(retained.req)} key=${action.requestId}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "the terminal took over — answer all questions there")
      return true
    }
    const answer = resolveButtonCallback(retained.req, { requestId: action.requestId, value: action.value })
    if (answer.status !== "answered") return false
    // Inject the chosen option into the asking pane, wrapped like any inbound reply.
    // We do NOT enqueue it on the pane's defer queue: if the pane is BUSY we decline
    // and keep the entry retained for a re-tap (the busy guard below) — a queued
    // late-answer could be delivered behind the wrong live question after we'd
    // already claimed "sent". NOTE (known bound): the pane
    // is verified to still host an agent, but not that it is the SAME session as when
    // the question was asked (a repurposed pane within the retention window receives a
    // clearly-attributed "[TG from …] <label>" message, not a silent wrong action) —
    // see issue tracker.
    const paneId = retained.req.paneId
    // The pane is BUSY (another live question, or a flush in progress) → do NOT
    // deliver now. Injecting would hit the open prompt; ENQUEUING would risk the
    // answer being delivered after that other question releases, while we'd already
    // have claimed "sent". Keep the entry RETAINED and ask
    // the user to re-tap once the agent is free; never falsely confirm delivery.
    if (shouldDeferInbound(paneId)) {
      log(`ask-late-deliver-busy: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "agent is busy — tap again shortly")
      return true
    }
    const wrapped = wrapInbound(ctx.cfg.injectWrap, "tg", answer.label)
    // CLAIM the entry BEFORE the inject await (consume it from `abandoned`, record the
    // answer as PANE-delivered) instead of after. A daemon restart can deliver a
    // queued tap and the reconnecting hook's resend at nearly the same instant; if we
    // claimed only AFTER the await, a reconnect landing mid-inject would still find the
    // entry in `abandoned` and either re-attach a LIVE socket (hanging the agent until
    // ASK_TOTAL_TIMEOUT_MS) or fresh-forward a DUPLICATE card — and a later re-tap would
    // inject the answer a SECOND time. Claiming first makes that concurrent reconnect
    // hit the `already-pane-delivered` branch (it returns null → the agent falls back to
    // the terminal where THIS injection lands), so the answer reaches the agent exactly
    // once. Rolled back below if the inject fails, so a re-tap can still retry.
    //
    // Accepted bound: a daemon CRASH in the sub-inject window between this persist and
    // the inject completing leaves the answer marked pane-delivered on disk though the
    // injection may not have landed — a re-fire/re-tap then sees already-pane-delivered
    // with no recovery. The window is shorter than one tmux send-keys (fast), and this
    // is strictly better than the pre-PR behavior (a tap after the socket closed was
    // dropped outright). A persisted "delivering" tri-state would close it but isn't
    // worth the complexity for a sub-50ms window.
    const answeredAt = Date.now()
    abandonedButtons.delete(action.requestId)
    pruneAnsweredButtons(answeredButtons, answeredAt)
    answeredButtons.set(action.requestId, { value: answer.value, label: answer.label, decision: answer.decision, at: answeredAt, delivery: "pane" })
    persistQuestions()
    const res = retained.req.omp
      ? await replyOmpAcpPermission(retained.req, optionIdForAnswer(retained.req, answer.value, answer.label))
      : retained.req.agent === "omp"
        ? await promptOmpAcp(liveOmpForPane(paneId) ?? { cwd: retained.req.cwd ?? "/" }, wrapInbound(ctx.cfg.injectWrap, "tg", answer.label))
        : await executeInjectSteps(buildTextInjectPlan(paneId, wrapped))
    if (!res.ok) {
      // The pane is unreachable (gone / no longer an agent). ROLL BACK the claim:
      // restore the retained entry (with its ORIGINAL `at`, so a failed attempt doesn't
      // extend its retention window) and drop the provisional answer — so a RE-TAP can
      // retry and the answer isn't lost.
      answeredButtons.delete(action.requestId)
      abandonedButtons.set(action.requestId, { req: retained.req, messageId: retained.messageId, at: retained.at })
      persistQuestions()
      log(`ask-late-deliver-failed: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} err=${res.error}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "could not reach the terminal — tap again")
      return true
    }
    log(`ask-late-delivered: ${describeAskRequest(retained.req)} key=${action.requestId} label=${answer.label} pane=${paneId}`)
    // The pane's question is now answered — flush any defer-while-waiting backlog
    // queued behind it (in FIFO order, after the agent consumes this answer). This
    // is what makes a RESTORED backlog deliverable after a reload: the restored
    // question lives in `abandonedButtons`, so only its late-delivery reaches here
    // to release the queue. (Also closes a latent gap: answering a socket-closed
    // question never used to flush its pane backlog.) onQuestionReleased self-guards
    // against an in-flight flush or another live question on the pane.
    if (paneId) onQuestionReleased(paneId)
    await answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
    const cardId = retained.messageId ?? action.messageId
    if (cardId !== null) {
      // Clear the keyboard now the answer landed: this card explicitly invited a tap
      // ("window closed — tap still delivers …"), so once delivered it must stop being
      // tappable. Otherwise a re-tap in the gap between the answered-replay window
      // (ANSWERED_REPLAY_MS, 5 min) and the abandoned-retention window
      // (ABANDONED_RETAIN_MS, 30 min) finds neither entry and shows a misleading
      // "expired" on a card that WAS answered.
      void clearMessageKeyboard(ctx, cardId)
      void editMessageText(ctx, cardId, buildAnsweredQuestionText(retained.req, answer.label), undefined, hatchParseMode(retained.req))
    }
    return true
  }

  const retireExpiredAbandonedQuestion = (
    requestId: string,
    retained: AbandonedButton,
    messageId: number | null,
  ): void => {
    abandonedButtons.delete(requestId)
    persistQuestions()
    const staleCardId = retained.messageId ?? messageId
    if (staleCardId !== null) {
      void clearMessageKeyboard(ctx, staleCardId)
      void editMessageText(ctx, staleCardId, EXPIRED_TERMINAL_TEXT)
    }
  }

  const handlePostTimeoutQuestionReply = async (
    action: Extract<Action, { kind: "post-timeout-question-reply" }>,
  ): Promise<boolean> => {
    const retained = abandonedButtons.get(action.requestId)
    if (
      !retained ||
      !retained.req.paneId ||
      retained.req.kind !== "question" ||
      retained.req.multiQuestion ||
      retained.messageId !== action.questionMessageId
    ) {
      await sendMessage(ctx, "that question is no longer waiting — resend if needed")
      return false
    }
    if (Date.now() - retained.at > ABANDONED_RETAIN_MS) {
      retireExpiredAbandonedQuestion(action.requestId, retained, action.questionMessageId)
      log(`ask-post-timeout-reply-expired: ${describeAskRequest(retained.req)} key=${action.requestId} ageMs=${Date.now() - retained.at}`)
      await sendMessage(ctx, "that question expired — resend if needed")
      return false
    }
    const paneId = retained.req.paneId
    if (shouldDeferInbound(paneId)) {
      log(`ask-post-timeout-reply-busy: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await sendMessage(ctx, "agent is busy — reply to the question again shortly")
      return false
    }

    const answer = action.text.trim()
    const answeredAt = Date.now()
    abandonedButtons.delete(action.requestId)
    pruneAnsweredButtons(answeredButtons, answeredAt)
    answeredButtons.set(action.requestId, { value: answer, label: answer, at: answeredAt, delivery: "pane" })
    persistQuestions()

    const res = await executeInjectSteps(buildTextInjectPlan(paneId, answer))
    if (!res.ok) {
      answeredButtons.delete(action.requestId)
      abandonedButtons.set(action.requestId, { req: retained.req, messageId: retained.messageId, at: retained.at })
      persistQuestions()
      log(`ask-post-timeout-reply-failed: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} err=${res.error}`)
      await sendMessage(ctx, "could not reach the terminal — reply to the question again")
      return false
    }

    log(`ask-post-timeout-reply-delivered: ${describeAskRequest(retained.req)} key=${action.requestId} answer=${answer} pane=${paneId}`)
    void clearMessageKeyboard(ctx, action.questionMessageId)
    void editMessageText(ctx, action.questionMessageId, buildAnsweredQuestionText(retained.req, answer))
    flushDeferred(paneId).catch((err) => log(`flushDeferred post-timeout-reply error: ${err}`))
    return true
  }

  const handleCloseQuestionCard = async (
    action: Extract<Action, { kind: "close-question-card" }>,
  ): Promise<boolean> => {
    const retained = abandonedButtons.get(action.requestId)
    if (retained && (action.messageId === null || retained.messageId === action.messageId)) {
      abandonedButtons.delete(action.requestId)
      persistQuestions()
    }
    if (action.messageId !== null) void clearMessageKeyboard(ctx, action.messageId)
    await answerCallbackQuery(ctx, action.callbackQueryId, "closed")
    return true
  }

  // The shared-state key for actions that read-then-write a Map keyed by a shared identifier
  // (tg-cli#357): actions carrying the same key still run strictly in enqueue order via
  // dispatchQueues below (preserving every existing double-tap/race guard); `null` means the
  // action touches no shared keyed state and is always safe to run fully concurrently.
  const actionResourceKey = (action: Action): string | null => {
    switch (action.kind) {
      case "topic-new":
      case "topic-answer":
      case "topic-route":
      case "topic-dead":
      case "topic-close":
      case "topic-reopen":
      case "topic-model":
      case "topic-path":
      case "topic-respawn":
        return `thread:${action.threadId}`
      case "agent-callback":
      case "agent-cancel":
        return `token:${action.token}`
      case "new-dir":
      case "new-model":
      case "new-retry":
        return `token:${action.token}`
      case "answer-question":
      case "close-question-card":
      case "post-timeout-question-reply":
        return `req:${action.requestId}`
      case "limit-continue":
        return `pane:${action.paneId}`
      default:
        return null
    }
  }

  // Returns true when the action was handled successfully — the 'ack' case
  // reads the PRECEDING action's verdict (passed in, not a shared mutable variable — tg-cli#357:
  // concurrent dispatch across different resource keys means a closure variable updated by another
  // in-flight group could otherwise leak across groups) to decide whether the source message earns
  // its 👀 receipt (actions for one message are contiguous, ack last).
  const executeAction = async (action: Action, precedingOk: boolean): Promise<boolean> => {
    switch (action.kind) {
      case "reply":
        await sendMessage(ctx, action.text, replyContext(action.threadId))
        return true
      case "answer-callback":
        await answerCallbackQuery(ctx, action.callbackQueryId, action.text)
        return true
      case "close-question-card":
        return handleCloseQuestionCard(action)
      case "post-timeout-question-reply":
        return handlePostTimeoutQuestionReply(action)
      case "answer-question": {
        const pending = pendingButtons.get(action.requestId)
        if (!pending) {
          // No LIVE prompt for this key. FIRST try late-delivery: a tap on a still-
          // retained (abandoned) question injects the chosen option into its pane
          // instead of being dropped (this PR). Only if there is nothing to deliver
          // do we fall back to the toasts below.
          if (await lateDeliverAbandonedQuestion(action)) return true
          // Grant protocol v1.1 (tg-cli#398): a tap on an expired HATCH card whose
          // retained entry is gone (12h retention pruned it / daemon restarted) —
          // the 24h grace store keeps it addressable, so a late Approve can still
          // mint a grant. Non-hatch taps fall straight through.
          if (await handleGraceStoreTap(action)) return true
          // If we ANSWERED it WITHIN the replay window the tap is on an already-
          // resolved card, not a truly-expired prompt — say so plainly instead of the
          // misleading "expired" (tg-cli#97). Gated on the same window as the hook-
          // path replay so the two never disagree on whether an entry is still
          // "answered" vs aged-out.
          const priorAnswer = answeredButtons.get(action.requestId)
          const stillAnswered = priorAnswer !== undefined && Date.now() - priorAnswer.at <= ANSWERED_REPLAY_MS
          await answerCallbackQueryOrNotify(ctx, action, stillAnswered ? "already answered" : "expired")
          return true
        }
        // A tap must come from THIS prompt's Telegram message: a stale tap on
        // an earlier prompt that reused the callback key must not answer this
        // one. Skipped only while sendMessage is still in flight (messageId
        // unknown) — that race is resolved in the tap's favor by design.
        if (
          pending.messageId !== null &&
          action.messageId !== null &&
          action.messageId !== pending.messageId
        ) {
          await answerCallbackQueryOrNotify(ctx, action, "expired")
          return true
        }
        const answer = resolveButtonCallback(pending.req, { requestId: action.requestId, value: action.value })
        if (answer.status !== "answered") {
          await answerCallbackQueryOrNotify(ctx, action, "expired")
          return true
        }
        pendingButtons.delete(action.requestId)
        activeButtonKeys.delete(action.requestId)
        // A stale abandoned twin (a reconnect re-attach raced a tap) must not linger
        // and resurrect on the next restart — the live answer below supersedes it.
        abandonedButtons.delete(action.requestId)
        // Remember a QUESTION's answer briefly so a re-forward of the SAME requestId
        // (the AskUserQuestion double-cover / re-fire race) replays it instead of
        // posting a second card (tg-cli#97). Scoped to questions on purpose: a
        // permission's requestId is also stable, but silently replaying a prior
        // allow/deny without re-prompting would be a behavioral/security change the
        // bug never asked for — and permissions have no double-card problem (they
        // forward via a single catch-all matcher, not a dedicated + catch-all pair).
        // Recorded AFTER the in-flight key is released, so the replay cache takes
        // over exactly where the in-flight dedup leaves off. Sweep stale entries on
        // each record so the cache can't grow unbounded.
        //
        // A multi-question SET MEMBER is never cached: the group is
        // all-or-nothing — if a later member aborts, the whole call is re-asked,
        // and a replayed member would silently stitch a STALE answer into the
        // NEW round without ever showing its card (review finding). The cost is
        // symmetric honesty: a re-fired identical set re-posts its cards.
        if (pending.req.kind === "question" && !pending.req.multiQuestion) {
          const answeredAt = Date.now()
          pruneAnsweredButtons(answeredButtons, answeredAt)
          answeredButtons.set(action.requestId, {
            value: answer.value,
            label: answer.label,
            decision: answer.decision,
            at: answeredAt,
            delivery: "socket", // answered down the live hook socket → re-fire replays (#98)
          })
        }
        // Persist the answer so a hook that reconnects after a restart replays it
        // (no duplicate card) instead of re-forwarding the now-answered question.
        persistQuestions()
        clearTimeout(pending.timer)
        const finalText = buildAnsweredQuestionText(pending.req, answer.label)
        if (pending.messageId === null) pending.finalText = finalText
        const output = formatAgentHookOutput(pending.req, answer)
        pending.socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
        // Previously silent — a question reaching the agent left no daemon trace,
        // making the duplicate-card report impossible to confirm from logs.
        log(`ask-answered: ${describeAskRequest(pending.req)} key=${action.requestId} label=${answer.label} messageId=${pending.messageId ?? "-"}`)
        void answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
        if (pending.messageId !== null) void editMessageText(ctx, pending.messageId, finalText, undefined, hatchParseMode(pending.req))
        // The agent is unblocked → deliver anything queued behind this question.
        // Fire-and-forget, but guard the promise: an error here must never become
        // an unhandled rejection that takes down the daemon.
        if (pending.req.paneId) {
          flushDeferred(pending.req.paneId).catch((err) => log(`flushDeferred error: ${err}`))
        }
        return true
      }
      case "status":
        await sendMessage(ctx, composeStatus(ctx, null), replyContext(action.threadId))
        return true
      case "limit-status":
        await sendMessage(ctx, composeLimitStatus(ctx, action.agent), replyContext(action.threadId))
        return true
      case "daily-report":
        await deliverDailyReport(ctx, replyContext(action.threadId))
        return true
      case "usage-report":
        await sendReportChunks(ctx, (await composeUsageReport(action.period)).text, replyContext(action.threadId))
        return true
      case "tasks":
        await runTasksCommand(ctx, action)
        return true
      case "limit-continue":
        return handleLimitContinue(action)
      case "agent-route":
        return handleAgentRoute(action)
      case "agent-callback":
        return handleAgentCallback(action)
      case "agent-cancel":
        return handleAgentCancelCallback(action)
      case "inject-text":
        if (selectedAgentRoute) {
          const selectedResult = await injectIntoSelectedAgent(action.text, action.messageId)
          if (selectedResult !== null) return selectedResult
        }
        // A plain non-reply message → opt into the no-reply auto-bind (fix B). This is the exact
        // HYP-915 shape (a fresh, unrelated message silently landing in an occupied pane), so the
        // git-state-check banner (withGitStateBanner) is prepended here when that pane is
        // mid-flight.
        return injectViaTarget(
          (target) => buildTextInjectPlan(target.pane.paneId, withGitStateBanner(target.pane.panePath, action.text)),
          action.text,
          true,
          action.messageId,
        )
      case "reply-route":
        return handleReplyRoute(action)
      case "inject-key":
        // A control verb (Escape/`/stop`) — no text to bank a banner into.
        return injectViaTarget((target) => buildKeyInjectPlan(target.pane.paneId, action.key))
      case "kill-agent": {
        // /kill sends SIGINT — a DESTRUCTIVE verb. It must NOT auto-bind to a
        // guessed agent (killing the wrong one is unrecoverable); on an ambiguous
        // fleet it asks (the select-picker below) rather than the no-reply auto-bind
        // that resolves a harmless content inject. So this uses the base discover(),
        // not discoverForInject (tg-cli#75 review).
        const found = discover()
        if (!found.ok) {
          // Ambiguous /kill (several live agents) → show the live agents as a
          // select-only picker (buttons) instead of a plain-text candidate dump;
          // no-agent → the no-agent reply. (A tap on the picker hands back the
          // selector to re-issue against one agent — kill-on-tap is out of scope.)
          if (found.reason === "ambiguous") {
            await postSelectPicker(candidatesForPicker(found.candidates))
          } else {
            await replyNoAgent()
          }
          return false
        }
        if (found.target.agentPid === undefined) {
          await sendMessage(ctx, "agent pid unknown — not killed")
          return false
        }
        try {
          // SIGINT kills the interactive agent (~1s) — spec §5.2 reserves it
          // for the explicit /kill verb. /stop is the survivable Escape.
          process.kill(found.target.agentPid, "SIGINT")
          await sendMessage(ctx, "session killed — restore via `claude --resume`")
          return true
        } catch (err) {
          await sendMessage(ctx, `kill failed: ${err}`)
          return false
        }
      }
      case "download-media":
        return downloadMedia(action)
      case "transcribe-voice":
        return transcribeVoice(action)
      case "topic-route":
        return handleTopicRoute(action)
      case "topic-dead":
        return handleTopicDead(action)
      case "topic-close":
      case "topic-reopen":
        return handleTopicLifecycle(action)
      case "topic-rename":
        return handleTopicRename(action)
      case "topic-new":
        return handleTopicNew(action)
      case "topic-answer":
        return handleTopicAnswer(action)
      case "topic-model":
        return handleTopicModel(action)
      case "topic-path":
        return handleTopicPath(action)
      case "topic-respawn":
        return handleTopicRespawn(action)
      case "new-command":
        return handleNewCommand(action)
      case "new-answer":
        return handleNewAnswer(action)
      case "new-dir":
        return handleNewDir(action)
      case "new-harness":
        return handleNewHarness(action)
      case "new-model":
        return handleNewModel(action)
      case "new-retry":
        return handleNewRetry(action)
      case "new-private-topic-fallback":
        return handleNewPrivateTopicFallback(action)
      case "ack":
      {
        const queuedReaction = takeAckReaction(action.messageId)
        if (queuedReaction) {
          if (!queuedReaction.shouldSend || queuedReaction.shouldSend()) {
            await setReaction(action.messageId, queuedReaction.emoji)
          }
        } else if (precedingOk) {
          await setSeenReaction(action.messageId)
        }
        return true
      }
    }
  }

  // Publish the command menu once on startup, before entering the poll loop.
  // Best-effort — publishBotCommands swallows every failure so a Telegram
  // hiccup can never block routing.
  await publishBotCommands(ctx)

  // Reconcile forum-topic bindings against the live tmux state once on startup (increment 4):
  // adopt a crash-orphaned topic-slug window, close a bound binding whose pane died while down.
  // No-op when topics mode is off (1:1 startup byte-identical) and fully guarded.
  reconcileTopicsOnStartup()

  // Self-heal the Claude Code hooks on startup. Claude Code can re-emit
  // ~/.claude/settings.json with only its own managed keys, silently dropping our
  // q→buttons, StopFailure, and statusLine-telemetry channels — the daemon then
  // keeps running but "question asked" / "tokens running low" never surface until
  // a manual `tg-ctl install-hooks`. Re-merge idempotently here (same pattern as
  // reconcileTopicsOnStartup): a no-op when the hooks are already present, so it
  // only writes when a rewrite actually gutted them. Best-effort — a failure here
  // must never block the daemon from entering its poll loop.
  ensureClaudeHooksOnStartup(ctx)

  log(`daemon up — pid ${process.pid}, bot ${ctx.botId}, offset ${offset}`)

  let recoveryQueue: TgUpdate[] | null = null
  {
    const leftover = parsePendingBatch(readFileOrNull(ctx.paths.pendingBatch))
    if (leftover.length > 0) {
      log(`recovering ${leftover.length} update(s) from a pending batch left by a prior crash/kill`)
      recoveryQueue = leftover
    }
  }

  for (;;) {
    // Graceful shutdown lands here BETWEEN batches — after the previous batch's
    // actions fully executed, before the next long-poll — so a reload never drops
    // an in-flight batch. Wait out any in-flight deferred flush before exiting so
    // an answered-question backlog is drained, not wedged/dropped (codex #198);
    // cleanExit then persists the durable backlog on its way out.
    if (shuttingDown) await cleanExitAfterFlushDrain()
    try {
      // Idle TTL first, so even an error-backoff loop eventually exits. A
      // newer registration file also counts as agent activity (the daemon may
      // have been retargeted while no pane was discoverable yet).
      const regMtime = fileMtimeMs(ctx.paths.registration)
      if (regMtime !== null && regMtime > lastAgentSeenMs) lastAgentSeenMs = regMtime
      discover()
      // An agent running OUTSIDE tmux keeps the daemon alive too (tg-cli#306): idle-exiting
      // while one is up would make its queued inbox messages vanish exactly the way the
      // incident did. The same sweep acks what the Stop hook delivered since last poll.
      if (listUnreachableAgents().length > 0 || listLiveOmpAgents().length > 0) lastAgentSeenMs = Date.now()
      await ackDeliveredInboxes(ctx)
      if (Date.now() - lastAgentSeenMs > ctx.cfg.idleExitMin * 60_000) {
        log(`no agent pane for ${ctx.cfg.idleExitMin} min — idle exit`)
        cleanExit(0)
      }

      // Sweep the retention window every loop iteration (roughly once per ~50s
      // long-poll, sooner if messages keep arriving) so an entry past its
      // applicable retention window (retainMsFor — ABANDONED_RETAIN_MS for a
      // question, the much longer ABANDONED_PERMISSION_RETAIN_MS for a
      // permission, tg-cli#182) gets its long-outage notice promptly even on an
      // otherwise-idle bot — persistQuestions only runs on a mutation, and on a
      // quiet channel nothing else may mutate for a long time. Prune directly
      // (cheap: an in-memory Map scan) rather than calling the full persistQuestions
      // every iteration (an atomic serialize+rename) — only persist when the sweep
      // actually dropped something, e.g. under a fast-returning long-poll with
      // nothing pending expiry this would otherwise be a disk write per batch
      // (review finding).
      if (abandonedButtons.size > 0) {
        const before = abandonedButtons.size
        const sweepNow = Date.now()
        const noticed = noticeStaleQueuedDecisions(sweepNow)
        pruneAbandonedButtons(abandonedButtons, sweepNow, notifyAbandonedLongOutage)
        if (noticed || abandonedButtons.size !== before) persistQuestions(sweepNow)
      }

      // tg-cli#403: critical-mode reminder cadence. A critical request never
      // times out — askDaemon skips ASK_TOTAL_TIMEOUT_MS for it and
      // forwardAndPostQuestion never arms the raw UNSCOPED_ABANDON_MS backstop
      // for it either — so without this sweep a decision it's waiting on could
      // sit silently forgotten in Telegram indefinitely. This is the sanctioned
      // exception to tg-cli#360/#380's "no new timers" rule (Alex's own
      // verbatim ask in the tg-cli#403 ticket body). A critical entry can be
      // waiting in EITHER map depending on whether its underlying process/
      // socket is still connected (pendingButtons — the common case: the
      // process is alive and simply hasn't gotten a decision yet) or has
      // already disconnected without one (abandonedButtons, retained the same
      // way tg-cli#349 retains any hatch/permission) — both are swept
      // identically since a human reminder doesn't care which map it's in.
      if (pendingButtons.size > 0 || abandonedButtons.size > 0) {
        const sweepNow = Date.now()
        let criticalChanged = false
        const sweepOneCritical = async (
          key: string,
          req: ButtonRequest,
          messageId: number | null,
          priorState: DaemonCriticalState | undefined,
          setState: (s: DaemonCriticalState) => void,
          stillPresent: () => boolean,
        ): Promise<void> => {
          if (req.critical !== true) return
          const state: DaemonCriticalState = priorState ?? {}
          const plan = planCriticalReminder(state, sweepNow)
          if (!plan.due) {
            // Persist a newly-computed quiet-hours deferral so a restart mid-quiet-hours
            // doesn't silently reset it and risk a second "morning" reminder.
            if (plan.nextState.quietHoursDeferredUntil !== state.quietHoursDeferredUntil) {
              setState({ ...state, quietHoursDeferredUntil: plan.nextState.quietHoursDeferredUntil })
              criticalChanged = true
            }
            return
          }
          const hookId = parseHatchHookId(req.requestId)
          const label = resolveWindowAgentLabel(req.windowName, req.cwd)
          const pointer = messageId !== null ? " (see the original card above)" : ""
          const text =
            hookId !== null
              ? `⏳ still waiting on your decision for hatch request ${hookId}${pointer}`
              : `⏳ still waiting on your decision — ${label}${pointer}`
          const sentId = await sendMessage(ctx, text)
          if (sentId === null) {
            // Send failed — never mark sent (see markCriticalReminderSent's own doc
            // comment): this reminder stays due and is retried next sweep instead of
            // silently skipping a whole interval for a ping the human never saw.
            log(`hatch-critical-reminder-send-failed: key=${key} hookId=${hookId ?? "-"}`)
            return
          }
          // Review finding (round 1): the entry's underlying socket can close mid-`await`
          // above — retainAbandonedQuestion then migrates it from pendingButtons into a
          // NEW AbandonedButton object in abandonedButtons, carrying a COPY of the
          // pre-send `criticalState`. `entry`/`setState` in THIS closure still point at
          // the now-orphaned pending slot; committing here would be invisible to the
          // freshly-migrated slot, which independently re-plans against its own stale
          // state and would send a SECOND reminder in the very same sweep tick (and
          // delete the wrong prior message, since its own `priorMessageId` is stale
          // too). Bail without committing so the next sweep retries cleanly against
          // whichever map now actually holds the entry — this reminder's Telegram
          // message is a harmless one-off orphan in that narrow window, never a
          // duplicate.
          if (!stillPresent()) {
            log(`hatch-critical-reminder-stale-entry: key=${key} hookId=${hookId ?? "-"} messageId=${sentId} — entry moved to a different map mid-send; not committing (will retry next sweep)`)
            return
          }
          const priorMessageId = state.lastReminderMessageId ?? null
          if (priorMessageId !== null) {
            // Replace, never accumulate (acceptance criterion (c)): delete the
            // PREVIOUS reminder, falling back to an edit-to-placeholder if Telegram
            // refuses the delete (message too old, already gone, …). The ORIGINAL
            // request card is never touched here — only prior reminder pings.
            const deleted = await deleteMessage(ctx, priorMessageId)
            if (!deleted) void editMessageText(ctx, priorMessageId, "⏰ reminder superseded by a newer one")
          }
          setState(markCriticalReminderSent(sweepNow, sentId))
          criticalChanged = true
          log(`hatch-critical-reminder-sent: key=${key} hookId=${hookId ?? "-"} messageId=${sentId}`)
        }
        for (const [key, entry] of pendingButtons) {
          await sweepOneCritical(key, entry.req, entry.messageId, entry.criticalState, (s) => {
            entry.criticalState = s
          }, () => pendingButtons.get(key) === entry)
        }
        for (const [key, entry] of abandonedButtons) {
          // Review finding (round 1): once a tap has landed (queuedDecision set), the
          // human's decision is already made and recorded — the card was edited to
          // "recorded …" at tap time. Continuing to ping "still waiting on your
          // decision" forever after the decision was already given would directly
          // contradict the card, and nothing ever clears a critical entry's Infinity
          // retention window to stop it on its own.
          if (entry.queuedDecision) continue
          await sweepOneCritical(key, entry.req, entry.messageId, entry.criticalState, (s) => {
            entry.criticalState = s
          }, () => abandonedButtons.get(key) === entry)
        }
        if (criticalChanged) persistQuestions(sweepNow)
      }

      // tg-cli#363: nudge a live omp ACP session that has gone quiet on tg for
      // over an hour — Alex's repeated ask that agents actually use tg-cli.
      // The tg skill's OWN triggers (finish a task, hit a blocker) only fire
      // at a natural decision point; a long heads-down stretch never produces
      // one, so passive discovery alone can never close this gap. Scoped to
      // live omp agents (listLiveOmpAgents, same population/cache the idle-exit
      // check above already uses) because promptOmpAcp is the only channel the
      // daemon can proactively push INTO without the human having typed
      // anything — a tmux-only pane has no equivalent out-of-band channel.
      // Cheap when nothing is live (an empty liveAgents list plans no due keys
      // and returns an empty store) and persisted only when the sweep actually
      // changed something (a nudge fired, or a key's episode/liveness state
      // moved) — same skip-persist-when-unchanged discipline as the
      // abandonedButtons sweep just above, so a quiet bot with no live omp
      // agent never pays a disk write per batch.
      const liveOmpAgentsForNudge = listLiveOmpAgents()
      if (liveOmpAgentsForNudge.length > 0 || Object.keys(awarenessNudgeStore).length > 0) {
        const liveOmpAgentByNudgeKey = new Map(liveOmpAgentsForNudge.map((a) => [a.paneId ?? liveOmpPaneId(a.pid), a]))
        const nudgeKeys = [...liveOmpAgentByNudgeKey.keys()]
        const sessionIdByNudgeKey = new Map([...liveOmpAgentByNudgeKey].map(([key, a]) => [key, a.sessionId]))
        const sentAtByKey = lastTgSentAtByKey(parseHistory(readFileOrNull(ctx.paths.history)))
        const nudgePlan = planAwarenessNudges(nudgeKeys, sentAtByKey, awarenessNudgeStore, Date.now(), sessionIdByNudgeKey)
        awarenessNudgeStore = nudgePlan.store
        if (nudgePlan.keysChanged) persistAwarenessNudge()
        // Only a send that actually SUCCEEDS commits the "nudged" marker
        // (via markAwarenessNudgeSent, below) — a due key stays due next
        // sweep on failure/drop instead of silently losing its one shot at
        // reaching the exact busy/loaded agent this feature targets.
        const sentKeys: string[] = []
        for (const key of nudgePlan.due) {
          const target = liveOmpAgentByNudgeKey.get(key)
          if (!target) continue
          const res = await promptOmpAcp(target, AWARENESS_NUDGE_TEXT)
          log(res.ok ? `awareness-nudge sent to ${key}` : `awareness-nudge failed for ${key}: ${res.error}`)
          if (res.ok) sentKeys.push(key)
        }
        if (sentKeys.length > 0) {
          awarenessNudgeStore = markAwarenessNudgeSent(awarenessNudgeStore, sentKeys, Date.now())
          persistAwarenessNudge()
        }
      }

      let json: { ok: boolean; result?: TgUpdate[]; description?: string }
      if (recoveryQueue !== null) {
        json = { ok: true, result: recoveryQueue }
        recoveryQueue = null
      } else {
      // The idle long-poll is abortable by SIGTERM (beginGracefulShutdown) so a
      // reload doesn't wait out the 50s poll; the timeout is the normal ceiling.
      // Re-check shuttingDown AFTER creating the controller and pre-abort if set:
      // a SIGTERM that landed between the loop-top check and here fired abort() on
      // the PREVIOUS (settled) controller — a no-op — and would otherwise let this
      // fresh long-poll run to its full ceiling (drain would then rely on the 8s
      // fallback instead of the snappy hand-off). Pre-aborting the current
      // controller makes the fetch reject at once → the catch exits gracefully.
      pollAbort = new AbortController()
      if (shuttingDown) pollAbort.abort()
      const resp = await fetch(
        `${api(ctx)}/getUpdates?timeout=50&offset=${offset}&allowed_updates=${encodeURIComponent('["message","callback_query"]')}`,
        { signal: AbortSignal.any([AbortSignal.timeout(60_000), pollAbort.signal]) },
      )
      if (resp.status === 409) {
        // Another consumer is long-polling this bot (other machine, or a
        // lingering server-side poll right after a restart) — the flock can't
        // prevent that. Back off 1,2,4…60s; warn ONCE per streak.
        consecutive409 += 1
        if (consecutive409 === 5 && !warned409) {
          warned409 = true
          log("5 consecutive 409s — another consumer is polling this bot")
          await sendMessage(ctx, "another consumer is polling this bot")
        }
        await drainAwareSleep(Math.min(2 ** (consecutive409 - 1), 60) * 1000)
        continue
      }
      if (!resp.ok) {
        log(`getUpdates HTTP ${resp.status}: ${(await resp.text()).slice(0, 200)}`)
        await drainAwareSleep(5000)
        continue
      }
      json = (await resp.json()) as { ok: boolean; result?: TgUpdate[]; description?: string }
      if (!json.ok || !Array.isArray(json.result)) {
        log(`getUpdates API error: ${json.description ?? "malformed response"}`)
        await drainAwareSleep(5000)
        continue
      }
      consecutive409 = 0
      warned409 = false
      }

      // Durably journal the raw batch BEFORE stepUpdates/offset-advance (tg-cli#322): if this
      // write completes, ANY subsequent crash — including one back inside stepUpdates or during
      // action dispatch — has a durable copy to replay via recoveryQueue on the next startup.
      // Unconditional on the recovery path too: harmless idempotent rewrite of the same content.
      if (json.result.length > 0) {
        atomicWrite(ctx.paths.pendingBatch, serializePendingBatch(json.result))
      }

      const step = stepUpdates(json.result, {
        cfg: ctx.cfg,
        chatId: ctx.chatId,
        nowSec: Math.floor(Date.now() / 1000),
        currentOffset: offset,
        wrap: (name, msg, messageId) => wrapInbound(ctx.cfg.injectWrap, name, msg, messageId),
        // Local-time quote anchor for replies (item 3); pure module defaults to UTC.
        fmtTime: (s) => {
          const d = new Date(s * 1000)
          const p = (n: number): string => String(n).padStart(2, "0")
          return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
        },
        // Forum-topics mode (spec §8). OFF by default: when ctx.cfg.topics is false stepUpdates
        // ignores message_thread_id and the flat 1:1 path is byte-identical to before. When on,
        // topicStatusOf reads the binding store so topic messages route per-topic.
        // privateTopics also uses the same TopicBinding store and the same routing — enabling
        // either flag arms the topic router so private-chat topic messages reach their agent pane.
        topicsEnabled: ctx.cfg.topics || ctx.cfg.privateTopics,
        topicStatusOf: (ctx.cfg.topics || ctx.cfg.privateTopics) ? topicStatusOf : undefined,
        // Flat /new (issue #27): always wired (not gated by topics) — a plain message while a
        // /new awaits its dir is the typed path. When no /new is in flight this is false and the
        // plain-text path is byte-identical to before.
        newSessionAwaitingDir,
        postTimeoutQuestionRequestIdForMessage: (messageId) => {
          for (const [requestId, retained] of abandonedButtons) {
            if (
              retained.messageId === messageId &&
              retained.req.kind === "question" &&
              !retained.req.multiQuestion &&
              retained.req.paneId
            ) {
              return requestId
            }
          }
          return null
        },
        permissionRequestIdForMessage: (messageId) =>
          findDecidablePermissionRequestId(pendingButtons, messageId) ?? findDecidablePermissionRequestId(abandonedButtons, messageId),
      })

      // The batch is durably journaled BEFORE this point (see the atomicWrite above), so
      // persisting the offset here no longer risks losing the update if a kill lands during
      // action dispatch: recovery-on-restart (recoveryQueue, top of runDaemon) replays the
      // pending-batch file. Telegram will redeliver anything whose offset was never advanced —
      // i.e. a crash before this line, including mid-write of the journal itself, which a POSIX
      // atomic rename makes never partially-visible. Anything past this line is recoverable from
      // OUR OWN journal instead of relying on Telegram redelivery.
      if (step.newOffset !== offset) {
        offset = step.newOffset
        writeFileSync(ctx.paths.offset, `${offset}\n`)
      }

      // Persist inbound history for `tg replies` recall — every message the CTO
      // sent in this batch. Best-effort, off the inject path: a read/write error
      // here never blocks delivery. Stale + rejected senders are filtered the
      // same way stepUpdates does (inboundHistoryRecords). Only when the batch
      // carried messages — an empty 50s long-poll skips the walk.
      //
      // Pane stamping must match where the message ACTUALLY routes, else a reply
      // (which routes to its recognized ORIGIN pane, not the default target) would
      // be logged under the wrong pane and vanish from that pane's scoped recall.
      // `resolvePane` mirrors handleReplyRoute's recognition: a reply whose
      // replied-to id is in the routes map AND still maps to a live same-project
      // agent pane is stamped with that pane; everything else uses the default
      // discovered target.
      if (json.result.length > 0) {
        const found = discover()
        const targetPane = found.ok ? found.target.pane.paneId : null
        const histRoutes = parseRoutes(readFileOrNull(ctx.paths.routes))
        // Map a resolved target pane → the human AGENT NAME it belongs to, so
        // each inbound record is attributed (targetAgent) and `tg replies` can
        // scope to "this agent" (agentNameForPane over the live snapshot — the
        // SAME derivation the reader uses for its own pane). One snapshot for
        // the whole batch; a pane that's gone (or none) → null → untagged.
        const agentPanes = snapshot().panes
        const resolveAgent = (pane: string | null): string | null => {
          if (pane === null) return null
          const p = agentPanes.find((x) => x.paneId === pane)
          return p ? agentNameForPane(p.windowName, p.panePath) : null
        }
        const resolvePane = (m: TgMessage): string | null => {
          const replyId = m.reply_to_message?.message_id
          if (replyId === undefined) return null
          // ONLY the kinds that actually reply-route (updates.ts): a text reply
          // whose body is NOT a /command (a /command reply runs verbatim in the
          // default auto-bind pane, never reply-route). A `!shell` reply DOES
          // reply-route to its origin pane (codex #192) — it keeps its raw text but
          // is delivered to the recognized pane, so it must be stamped there too,
          // matching the prose/photo/voice cases. Also a photo/document reply after
          // download, or a voice/audio reply after transcription.
          const isRoutedReply =
            (m.text !== undefined && !m.text.startsWith("/")) ||
            (m.photo !== undefined && !isAgentCommand(m.caption ?? "")) ||
            (m.document !== undefined && !isAgentCommand(m.caption ?? "")) ||
            m.voice !== undefined ||
            m.audio !== undefined
          if (!isRoutedReply) return null
          const recognized = recognizeRoute(histRoutes, replyId)
          if (!recognized) return null
          const { panes, procs } = snapshot()
          const pane = panes.find((p) => p.paneId === recognized.paneId)
          const sameProject = routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: pane?.panePath })
          if (pane && sameProject && findAgentInPane(pane, procs)) return recognized.paneId
          // Mirror handleReplyRoute's recognized-but-unconfirmed guard (HISTORY
          // STAMP ONLY — this return is the scoped-recall pane, NEVER an inject
          // target). When the origin pane is NOT visible (`!pane` — the launchd
          // empty/partial flake), the reply still BELONGS to its recognized origin
          // (the picker routes it there), so stamp it under the origin pane, NOT
          // the default discovered target (the registration's last-writer = the
          // WRONG pane). A genuinely reused/different-project VISIBLE pane (`pane`
          // present but failed the same-project/agent check above) falls back to
          // the default. The two recognized-but-unconfirmed paths intentionally
          // diverge: handleReplyRoute posts the picker (delivery), this stamps the
          // origin pane (attribution) — neither ever injects into an unconfirmed pane.
          return pane ? null : recognized.paneId
        }
        appendHistory(
          ctx.paths.history,
          inboundHistoryRecords(json.result, {
            chatId: ctx.chatId,
            allowedSenders: ctx.cfg.allowedSenders,
            pane: targetPane,
            nowSec: Math.floor(Date.now() / 1000),
            stalenessSec: ctx.cfg.stalenessSec,
            resolvePane,
            resolveAgent,
          }),
        )
      }

      // Concurrent per-target dispatch (tg-cli#357, fixes the reported head-of-line-blocking
      // incident: one wedged omp ACP session/prompt call froze delivery to every other agent
      // sharing this daemon). Actions for one inbound message are grouped by their trailing
      // `ack` boundary and run as one atomic, internally sequential unit — the forum-topics
      // no-double-spawn guarantee (two `topic-model` taps for the SAME thread reach `bound`
      // one-after-another) is preserved because same-key groups (actionResourceKey) still run
      // through dispatchQueues in strict enqueue order. Groups with different keys (the common
      // case: different messages routed to different agents) run fully concurrently via
      // Promise.allSettled, so one group's stuck action can never delay or fail any other.
      const actionGroups = groupActionsByAckBoundary(step.actions)
      await Promise.allSettled(
        actionGroups.map((group) => {
          const key = group.reduce<string | null>((acc, a) => acc ?? actionResourceKey(a), null)
          return dispatchQueues.run(key, async () => {
            let ok = true
            for (const action of group) {
              try {
                ok = await executeAction(action, ok)
              } catch (err) {
                log(`action ${action.kind} failed: ${err instanceof Error ? err.message : String(err)}`)
                ok = false
              }
            }
          })
        }),
      )

      // The batch fully completed — the journal is no longer needed. Best-effort:
      // if this unlink fails the next startup replays the same batch (idempotent/dedupe-tolerant
      // downstream, matching the rest of the codebase's at-least-once handling, e.g. the Stop-hook
      // inbox fallback).
      if (json.result.length > 0) {
        try {
          unlinkSync(ctx.paths.pendingBatch)
        } catch {}
      }
    } catch (err) {
      // A SIGTERM-aborted long-poll surfaces here as an AbortError — that is a
      // clean graceful exit (no batch was in flight, since fetch never returned),
      // not a fault to back off from. Drain any in-flight deferred flush first
      // (codex #198); cleanExit persists the backlog on its way out.
      if (shuttingDown) await cleanExitAfterFlushDrain()
      // The daemon must survive anything — malformed updates, network
      // failures, tmux races. Log and back off.
      log(`poll loop error: ${err}`)
      await drainAwareSleep(5000)
    }
  }
}

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  const cmd = process.argv[2]
  // Bare invocation (no subcommand) prints HELP on stdout and exits 0 — it NEVER launches the
  // daemon (the shared service-management contract: a bare `<tool> <service>` is help, not run).
  if (!cmd || cmd === "-h" || cmd === "--help") {
    console.log(USAGE)
    process.exit(0)
  }
  // Internal one-shot child spawned by `harness-event`; intentionally absent
  // from USAGE and guarded by persisted retry state before it can inject text.
  if (!["start", "run", "stop", "restart", "status", "enable", "disable", "ask", "install-hooks", "voice-setup", "harness-event", "codex-usage-hook", "auto-continue-once", "usage-schedule", "usage-schedule-check", "inbox"].includes(cmd)) {
    console.error(USAGE)
    process.exit(1)
  }

  const home = process.env.HOME ?? "~"
  // install-hooks edits ~/.claude/settings.json only — no bot token needed.
  if (cmd === "install-hooks") {
    process.exit(installHooks(home))
  }
  // TG_CTL_CONFIG_DIR exists so tests can point a spawned daemon at a tmpdir. Resolve it to an
  // ABSOLUTE path: `enable` pins this dir into the launchd/systemd unit, and the OS launches the
  // login daemon from its own cwd (not the shell's) — a relative override would resolve against
  // the wrong directory and silently miss the .env it was enabled with. (The default branch is
  // already absolute, so this is a no-op there.)
  const configDir = resolveConfigDir(home)
  const fileEnv = loadEnv(join(configDir, ".env"))
  const env = { ...fileEnv, ...process.env }

  // usage-schedule-check is a LOCAL date check that shells out to `rig`/`tg` directly (no
  // Bot API call via ctx) — runs before the bot-token gate, same reasoning as voice-setup.
  // `tg` itself owns bot-token resolution for the actual send. The watermark path is still
  // keyed by bot id (same scheme as every other per-bot state file, see ctlPaths) so two
  // bots on one machine never share a schedule — that needs only the token's id part, not
  // the full token gate below.
  if (cmd === "usage-schedule-check") {
    const dryRun = process.env.TG_USAGE_SCHEDULE_DRY_RUN === "1" || process.argv.includes("--dry-run")
    const watermarkPath = ctlPaths(configDir, botIdFromToken(env.TG_BOT_TOKEN ?? "") || "unknown").usageSchedule
    process.exit(await runUsageScheduleCheck(new Date(), dryRun, watermarkPath))
  }
  // voice-setup is a LOCAL probe + config write — no Telegram I/O, so it runs
  // before the bot-token gate (a user may set up voice before configuring creds).
  if (cmd === "voice-setup") {
    const configYaml = readFileOrNull(join(configDir, "config.yaml")) ?? ""
    const voiceCfg = resolveVoiceConfig(parseVoiceConfig(configYaml))
    const ok = runVoiceSetup({ configDir, home, language: voiceCfg.language })
    process.exit(ok ? 0 : 1)
  }

  const token = env.TG_BOT_TOKEN ?? ""
  const botId = botIdFromToken(token)
  if ((cmd === "ask" || cmd === "codex-usage-hook") && (!botId || !env.TG_CHAT_ID)) {
    process.exit(0)
  }
  if (!botId || !env.TG_CHAT_ID) {
    console.error(`Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ${join(configDir, ".env")}`)
    process.exit(1)
  }

  const configYaml = readFileOrNull(join(configDir, "config.yaml")) ?? ""
  const cfg = resolveControlConfig(parseControlConfig(configYaml))
  const voice = resolveVoiceConfig(parseVoiceConfig(configYaml))

  const ctx: Ctx = {
    configDir,
    paths: ctlPaths(configDir, botId),
    cfg,
    voice,
    token,
    chatId: Number(env.TG_CHAT_ID),
    apiBase: env.TG_API_BASE || "https://api.telegram.org",
    botId,
    home,
    cwd: process.cwd(),
  }

  if (cmd === "start") {
    startLauncher(ctx, parseStartFlags(process.argv.slice(3)))
    process.exit(0)
  }
  if (cmd === "stop") {
    stopDaemon(ctx)
    process.exit(0)
  }
  if (cmd === "restart") {
    stopDaemon(ctx)
    startLauncher(ctx, parseStartFlags(process.argv.slice(3)))
    process.exit(0)
  }
  if (cmd === "enable") {
    process.exit(enableAutostart(ctx, process.argv.includes("--dry-run")))
  }
  if (cmd === "disable") {
    process.exit(disableAutostart(ctx))
  }
  if (cmd === "usage-schedule") {
    const sub = process.argv[3]
    if (sub === "enable") process.exit(enableUsageSchedule(ctx, process.argv.includes("--dry-run")))
    if (sub === "disable") process.exit(disableUsageSchedule(ctx))
    console.error("usage: tg-ctl usage-schedule enable|disable [--dry-run]")
    process.exit(1)
  }
  if (cmd === "status") {
    console.log(composeStatus(ctx, null))
    process.exit(0)
  }
  if (cmd === "inbox") {
    process.exit(runInboxCommand(ctx, process.argv.slice(3)))
  }
  if (cmd === "ask") {
    // Grant-protocol client (tg-cli#398): `--verify-grant <approval_id> --hook
    // <hook_id>` (TOKEN path) or `--verify-grant --pull --hook <hook_id>` (PULL
    // path) — stdin carries the normalized payload with the recomputed
    // `operation`. Intercepted BEFORE askDaemon so the stdin payload flows to
    // the verify exchange, not the question normalizer.
    const verifyArgv = verifyGrantArgvFrom(process.argv.slice(3))
    if (verifyArgv) {
      let stdinPayload: unknown = null
      try {
        stdinPayload = JSON.parse(await readStdinText())
      } catch {
        stdinPayload = null // the daemon denies malformed payloads fail-closed
      }
      await verifyGrantDaemon(ctx, verifyArgv, stdinPayload)
      process.exit(0)
    }
    await askDaemon(ctx)
    process.exit(0)
  }
  if (cmd === "harness-event") {
    process.exit(await runHarnessEvent(ctx, process.argv.slice(3), Date.now()))
  }
  if (cmd === "codex-usage-hook") {
    process.exit(await runCodexUsageHook(ctx, Date.now()))
  }
  if (cmd === "auto-continue-once") {
    process.exit(await runAutoContinueOnce(ctx, process.argv.slice(3)))
  }
  await runDaemon(ctx)
}
