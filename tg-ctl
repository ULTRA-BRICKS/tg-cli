      // on disk carrying the same sensitive pane id + cwd the denylist protects
      // (Opus review finding) — clean it up best-effort rather than leaving an
      // orphan. The pid suffix means it would be overwritten next time anyway,
      // but a crash before that next call would otherwise leave it indefinitely.
      try {
        unlinkSync(tmp)
      } catch {
        // Nothing to clean up, or unremovable — either way, not worth failing over.
      }
      // A transient write failure (disk full, EINTR) while RE-AFFIRMING the
      // SAME target the anchor already correctly holds must NOT destroy that
      // still-valid on-disk copy (Opus review finding) — the stale write only
      // meant to refresh `ts`, so leaving the existing good record in place is
      // strictly better than deleting it. Only a failure to persist a GENUINE
      // target CHANGE is invalidated: leaving the PRIOR (different) anchor in
      // place there would silently keep routing to a stale pane instead of
      // falling back to the picker as intended (review finding).
      if (readCurrent()?.paneId === paneId) return
      invalidateLastUserTarget()
    }
  }

  // The base discovery: §10 priority chain + liveness bookkeeping, NO last-message
  // bind. Used by liveness/history paths that must NOT silently pick an agent. The
  // no-reply bind lives ONLY in discoverForInject below, so it can never leak onto
  // the reply path (which uses handleReplyRoute's own #49 fail-closed, not discover())
  // or the history-attribution path.
  const discover = (): DiscoverResult => {
    const result = discoverTarget(ctx)
    // Agent panes existing — even ambiguous ones — keep the daemon alive.
    if (result.ok || result.candidates.length > 0) lastAgentSeenMs = Date.now()
    return result
  }

  // discover() PLUS the no-reply last-user-message bind (tg-cli#78, anchor fixed
  // 2026-08-20/21): an otherwise-ambiguous NON-reply inbound binds to the pane of
  // the CTO's OWN last resolved message, never to "whichever agent spoke most
  // recently" (routes.json's outbound-send history) — that let an unrelated agent's
  // unprompted message to the CTO hijack his very next message (live incident).
  // This runs BEFORE #76's ambiguous-picker: a fresh message after the CTO's own
  // last one lands in the same place directly; the picker fires only when there is
  // no last-user-target, or its pane is gone / not a candidate. The lookup is LAZY
  // — only on a genuinely ambiguous base result — so the common ok/no-agent path
  // never reads the store. This is the ONLY discovery used by the non-reply INJECT
  // paths (injectViaTarget with autoBind). A no-last-target case stays ambiguous →
  // #76's picker (the unscoped fail-closed, #49).
  const discoverForInject = (): DiscoverResult => {
    const result = discover()
    if (result.ok || result.reason !== "ambiguous") return result
    const hit = resolveLastUserTarget(ctx, result.candidates)
    return hit ? { ok: true, target: hit } : result
  }

  // Prepend the git-state-check banner (git-state.ts) to `text` when `control.git_state_banner`
  // is on (default) AND the destination pane's cwd is mid-flight — uncommitted changes or a
  // non-main/master branch. Scoped to the SILENT auto-bind deliveries only: a fresh, non-reply
  // message that lands in the discovered pane with no human/reply anchor choosing it (plain
  // inject-text, a photo/document notice, a standalone voice transcript). Deliberately NOT applied
  // to reply-route (anchored to a specific prior message — on-topic by construction), topic-route
  // (a per-topic pane, a different targeting model entirely), a /new spawn (a brand-new pane has no
  // prior work to protect), a picker tap (the human explicitly chose that pane), or a message
  // deferred behind an open question (flushed through a separate code path, out of scope here).
  //
  // Never banner a COMMAND passthrough (review catch, PR #153): the flat inject-text action also
  // carries an unrecognized `/command` (e.g. `/compact`, `/clear`) or a `!shell` command VERBATIM so
  // the harness TUI can execute it — updates.ts's textAction only wraps ordinary prose, never a
  // passthrough command. Prepending a banner line ahead of it would push the leading `/` or `!` off
  // the first character, so the harness reads it as plain prompt text instead of a command. A wrapped
  // inject (the normal case) always starts with the injectWrap template, never `/`/`!`, so this guard
  // only ever skips a real passthrough.
  const withGitStateBanner = (panePath: string, text: string): string => {
    // An EMPTY panePath (tmux reporting no pane_current_path) must never reach
    // gitStateForPath (review finding, same bug class as the routeMatchesPane
    // empty-path fix above): `git -C ''` leaves the cwd UNCHANGED, so it would
    // silently check the DAEMON's own inherited cwd — an unrelated repo — and
    // could prepend that repo's git state to a message delivered to an
    // unrelated agent. No path to check → no banner, same as the disabled/
    // command-passthrough cases below.
    if (!ctx.cfg.gitStateBanner || !panePath || text.startsWith("/") || text.startsWith("!")) return text
    const banner = buildGitStateBanner(gitStateForPath(panePath))
    return banner ? `${banner}\n${text}` : text
  }

  const replyContext = (threadId?: number | null): Record<string, unknown> =>
    typeof threadId === "number" ? { message_thread_id: threadId } : {}

  // Resolve a DiscoverResult's ambiguous `TargetPane[]` to the picker's
  // `AgentCandidate[]` (window names + cwd → distinct labels). The TargetPane
  // shape carries no window name, so re-derive over a fresh listAgentCandidates()
  // snapshot, keeping ONLY the discovery-narrowed panes that are STILL a live
  // agent candidate. A pane that raced away between the two snapshots (or no
  // longer passes the agent-candidate criterion) drops out — the picker shows
  // only panes a tap can actually route into, never a synthetic button into a
  // dead/non-agent pane. The set/discovery layer already guarantees ≥2 live
  // candidates on the ambiguous path, so the result is non-empty in practice; if
  // a freak full race emptied it, postRoutePicker/postSelectPicker fall back to
  // the no-agent reply rather than an empty button set.
  const candidatesForPicker = (panes: TargetPane[]): AgentCandidate[] => {
    const want = new Set(panes.map((c) => c.pane.paneId))
    return listAgentCandidates().filter((c) => want.has(c.paneId))
  }

  // The "not found" reply for a target that genuinely has NO agent. The ambiguous
  // case never reaches here anymore — it posts the inline-keyboard PICKER (buttons,
  // like /agent) instead of the old plain-text candidate dump (tg-cli#72). Kept as
  // a tiny helper for the no-agent message + the /kill path's reuse.
  const replyNoAgent = async (): Promise<void> => {
    await sendMessage(ctx, noAgentReplyNow())
  }

  // tg-cli#705: a plain message typed to a session that has open cards. With exactly ONE open
  // card, the message is the answer to it — a live card answers its asker (a question takes the
  // text, a permission reads yes/no, any other text denies with the text as the reason); a
  // retained question is typed into its pane as the answer. A retained permission or hatch card
  // is never decided from chat. With several open cards nothing is guessed: the human is asked
  // once to reply to the card he means, and the message takes its normal path. True when the
  // message was consumed as an answer (the caller delivers nothing else).
  const answerOpenCardInChat = async (
    paneId: string,
    plain: string | undefined,
    sourceMessageId: number | null,
    threadId: number | null,
    sessionKey?: string,
  ): Promise<boolean> => {
    if (plain === undefined || !plain.trim() || sourceMessageId === null) return false
    // The pane is on the daemon's own tmux server (every inject goes there): a card from the
    // same pane id on another server is another session's, and so is a registry entry for that
    // pane id on another server (tg-cli#722).
    const serverPid = readTmuxServerPid()
    const reg = sessionKey === undefined ? currentSessionRegistry() : null
    const paneEntry = reg ? sessionAtPane(reg, paneId) : null
    const paneKey = paneEntry && (serverPid === null || paneEntry.locators.tmux?.serverPid === serverPid) ? paneEntry.key : undefined
    const cards = sessionCardKeys(openCards(), { sessionKey: sessionKey ?? paneKey, paneId, serverPid })
    if (cards.length === 0) return false
    const thread = threadId !== null ? { threadId } : {}
    if (cards.length > 1) {
      await sendMessage(
        ctx,
        `this session has ${cards.length} open questions — reply to the card you mean`,
        replyContext(threadId),
      )
      return false
    }
    const cardKey = cards[0]
    const pending = pendingButtons.get(cardKey)
    if (pending) {
      log(`ask-answered-in-chat: key=${cardKey} source=${sourceMessageId}`)
      await executeAction(
        { kind: "answer-question", callbackQueryId: "", requestId: cardKey, value: "", messageId: pending.messageId, freeText: plain, ...thread },
        true,
      )
      return true
    }
    const retained = abandonedButtons.get(cardKey)
    if (!retained || retained.req.kind !== "question" || !retained.req.paneId || retained.req.multiQuestion || retained.messageId === null) return false
    log(`ask-answered-in-chat: key=${cardKey} source=${sourceMessageId} (retained question → pane)`)
    await handlePostTimeoutQuestionReply(
      { kind: "post-timeout-question-reply", requestId: cardKey, questionMessageId: retained.messageId, text: plain, from: "tg", messageId: sourceMessageId, ...thread },
      CLOSE_STATUS.answeredInChat(plain.trim()),
    )
    return true
  }

  // Pick a target, run the plan; every failure mode turns into a TG reply so
  // the human is never left wondering whether the message landed. Returns
  // true only when the plan actually executed — the caller uses it to decide
  // whether the source message earns its 👀 delivery receipt.
  //
  // `autoBind` (default off, tg-cli#78) opts a HARMLESS content inject
  // (text/photo/voice) into the no-reply last-message bind: an otherwise-ambiguous
  // non-reply message lands on the agent of the LAST MESSAGE in the chat FIRST
  // (discoverForInject), so the picker below fires LESS often. It is OFF for control
  // keys (/stop's Escape) — interrupting a GUESSED agent is the wrong default; an
  // ambiguous control verb asks.
  //
  // When the target is STILL ambiguous (auto-bind off, or no last message to prefer)
  // and the inject carries routable text, it posts the agent PICKER (tappable buttons,
  // tg-cli#76) and arms the pending route — a tap injects `deferText` verbatim, exactly
  // like the /agent picker. A control verb with no text (inject-key /stop) has nothing
  // to route through a tap, so it falls back to the picker WITHOUT a pending route
  // (select-only) — the buttons still tell the human which agents are live, not a
  // text dump.
  // `buildPlan` receives the resolved TargetPane (not a bare paneId): the git-state-check banner
  // (git-state.ts) needs the pane's `panePath` (cwd) to check, and that path only exists on the
  // TargetPane `found` resolves to HERE — never re-`discover()`/re-`snapshot()` inside a caller to
  // look it up by paneId alone, which would race against (and could disagree with) the pane this
  // function actually delivers into.
  const injectViaTarget = async (
    buildPlan: (target: TargetPane) => InjectStep[],
    deferText?: string,
    autoBind = false,
    sourceMessageId: number | null = null,
    // The user's own words of a plain message (tg-cli#705): may answer the target's open card.
    plain?: string,
  ): Promise<boolean> => {
    const found = autoBind ? discoverForInject() : discover()
    if (!found.ok) {
      // Routable text present (a real message) → route picker: a tap injects it
      // verbatim. Empty/whitespace deferText is treated as "no text" (same rule as
      // postAgentPicker's selectOnly), so it never arms a pending route that would
      // inject nothing on tap.
      if (found.reason === "ambiguous" && deferText !== undefined && deferText.trim() !== "") {
        return postRoutePicker(candidatesForPicker(found.candidates), deferText, undefined, sourceMessageId)
      }
      if (found.reason === "ambiguous") {
        // No routable text (a /stop with several agents): show the live agents as
        // a select-only picker rather than dumping them as text. A select-only tap
        // does NOT re-run the control verb (it only hands back the selector), so
        // the verb did NOT execute — return false so the source message earns no
        // 👀 "delivered" receipt (matching the kill-agent ambiguous branch below
        // and this function's "true only when the plan executed" contract).
        await postSelectPicker(candidatesForPicker(found.candidates))
        return false
      }
      if (found.reason === "no-agent" && deferText !== undefined && deferText.trim() !== "") {
        const candidates = listAgentCandidates()
        if (candidates.length === 1) {
          log(`inject: no tmux pane, sole candidate ${candidates[0].paneId}/${candidates[0].windowName}`)
          if (await answerOpenCardInChat(candidates[0].paneId, plain, sourceMessageId, null)) return true
          return injectPrewrappedToPane(candidates[0].paneId, deferText, sourceMessageId, candidates[0].panePath ?? "/")
        }
        if (candidates.length > 1) {
          if (autoBind) {
            const anchored = resolveLastUserTargetCandidate(ctx, candidates)
            if (anchored) {
              log(`inject: no tmux pane, anchor bind ${anchored.paneId}/${anchored.windowName}`)
              if (await answerOpenCardInChat(anchored.paneId, plain, sourceMessageId, null)) return true
              return injectPrewrappedToPane(anchored.paneId, deferText, sourceMessageId, anchored.panePath ?? "/")
            }
          }
          return postRoutePicker(candidates, deferText, undefined, sourceMessageId)
        }
      }
      await replyNoAgent()
      return false
    }
    const paneId = found.target.pane.paneId
    if (await answerOpenCardInChat(paneId, plain, sourceMessageId, null)) {
      if (autoBind) recordLastUserTarget(paneId, found.target.pane.panePath)
      return true
    }
    const textPreview = deferText?.slice(0, 60).replace(/\n/g, " ")
    log(`inject: target=${paneId} autoBind=${autoBind} text="${textPreview ?? "(key)"}"`)
    const recordIfAutoBound = () => {
      if (autoBind) recordLastUserTarget(paneId, found.target.pane.panePath)
    }
    if (preferOmpApiOverTmux(found.target.agent)) {
      if (deferText === undefined) {
        log(`inject: omp target=${paneId} — refusing tmux send-keys for a control verb`)
        await sendMessage(ctx, "OMP control keys are not supported by the original-process bridge; use the original terminal. No replacement was started.")
        return false
      }
      if (shouldDeferInbound(paneId)) {
        markDeferredForAck(enqueueDeferred(paneId, deferText, sourceMessageId))
        recordIfAutoBound()
        return true
      }
      const live = liveOmpForPane(listLiveOmpAgents(), paneId, found.target.agentPid)
      const cwd = found.target.pane.panePath || live?.cwd || "/"
      log(`inject: omp original-process pane=${paneId} cwd=${cwd} (endpoint first; own-pane tmux only without one)`)
      const result = await deliverOriginalOmp(live ?? { cwd, pid: found.target.agentPid }, deferText, sourceMessageId ?? undefined, paneId)
      if (!result.ok) {
        log(`inject aborted: ${result.error}`)
        await sendMessage(ctx, result.error)
        return false
      }
      recordIfAutoBound()
      return true
    }
    if (deferText !== undefined && shouldDeferInbound(paneId)) {
      markDeferredForAck(enqueueDeferred(paneId, deferText, sourceMessageId))
      recordIfAutoBound()
      return true
    }
    const result = await injectInbound(sourceMessageId, paneId, buildPlan(found.target))
    if (!result.ok) {
      log(`inject aborted: ${result.error}`)
      await sendMessage(ctx, result.error)
      return false
    }
    recordIfAutoBound()
    return true
  }

  // Inject a wrapped message into ONE specific pane (the /agent target). The
  // plan's verify-pane step still re-checks the pane hosts an agent first.
  const injectToPane = async (
    paneId: string,
    from: string,
    msg: string,
    sourceMessageId: number | null,
    deferReactionViaAck = false,
  ): Promise<{ ok: boolean; error?: string; deferred?: boolean; deferredItem?: DeferredInbound }> => {
    // `sourceMessageId` was accepted here for deferred-queue bookkeeping (see
    // enqueueDeferred below) but never forwarded into wrapInbound — every
    // /agent-routed inbound (direct hit, defer flush, and the ambiguous-picker
    // confirm) silently lost its `tg#<id>` wrap tag while the generic
    // auto-bind inject path (which does pass its messageId) kept it. Forward
    // it here so `/agent <selector> <text>` gets the same `tg#<id>` tag as
    // every other inbound path.
    const wrapped = wrapInbound(ctx.cfg.injectWrap, from, msg, sourceMessageId ?? undefined)
    if (paneId.startsWith("omp:")) {
      const pid = Number(paneId.slice("omp:".length))
      const live = listLiveOmpAgents().find((a) => a.pid === pid)
      if (!live) return { ok: false, error: `omp ${paneId} is no longer running` }
      const cwd = live.cwd ?? "/"
      log(`injectToPane: omp original-process pane=${paneId} cwd=${cwd} (not tmux send-keys)`)
      const res = await deliverOriginalOmp(live, wrapped, sourceMessageId ?? undefined, live.paneId)
      return res.ok ? { ok: true } : { ok: false, error: res.error }
    }
    // A hosted session asks its questions unscoped (no TMUX_PANE), which defers every target
    // (paneHasPendingQuestion): such a message waits in the queue below, never typed into the prompt.
    const hostDelivery = shouldDeferInbound(paneId) ? null : deliverHostPane(paneId, wrapped, sourceMessageId)
    if (hostDelivery) {
      const res = await hostDelivery
      return res.ok ? { ok: true } : { ok: false, error: res.error }
    }
    if (shouldDeferInbound(paneId)) {
      const item = enqueueDeferred(paneId, wrapped, sourceMessageId)
      if (deferReactionViaAck) markDeferredForAck(item)
      return { ok: true, deferred: true, deferredItem: item }
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === paneId)
    const hosted = pane ? findAgentInPane(pane, procs) : null
    if (hosted?.agent === "omp") {
      const live = liveOmpForPane(listLiveOmpAgents(), paneId, hosted.pid)
      const cwd = pane?.panePath || live?.cwd || "/"
      log(`injectToPane: omp original-process pane=${paneId} cwd=${cwd} (endpoint first; own-pane tmux only without one)`)
      const res = await deliverOriginalOmp(live ?? { cwd, pid: hosted.pid }, wrapped, sourceMessageId ?? undefined, paneId)
      return res.ok ? { ok: true } : { ok: false, error: res.error }
    }
    const res = await injectInbound(sourceMessageId, paneId, buildTextInjectPlan(paneId, wrapped))
    return res.ok ? { ok: true } : { ok: false, error: res.error }
  }

  // `label` identifies the chosen agent: `<window> · <agent>` for a direct/
  // confident route, or the picker's DISTINCT label (cwd-derived) when several
  // agents shared a bare window name — so the confirmation never reads an
  // ambiguous "4 · claude".
  const routedReply = (label: string, deferred?: boolean): string =>
    deferred ? `⏳ queued for ${label} (answering a question)` : `→ ${label}`

  // The distinct label for `target` within `fleet` (cwd-derived disambiguation),
  // falling back to `<window> · <agent>` if the target isn't in the fleet.
  const labelFor = (target: AgentCandidate, fleet: AgentCandidate[]): string => {
    const i = fleet.indexOf(target)
    return i >= 0 ? distinctLabels(fleet)[i] : `${target.windowName} · ${target.agent}`
  }

  // Resolve + log the gone-agent anchor fallback target shared by handleAgentRoute (text)
  // and routePrewrappedAgentMessage (media) — see agent-match.ts's "gone-agent (dead
  // subagent) fallback" comment for the full rationale. `allowed` is the caller's
  // topic-scope gate (the text route passes `action.threadId == null`; the media route
  // always passes `true` — a topic message never carries media through this handler at
  // all, `topicActionFor` acks it before the flat photo/document dispatch ever runs, so
  // no such guard is needed there). Returns null when there is no live anchor to try (or
  // the caller disallowed it); the caller then keeps its explicit "no agent matching" error.
  const resolveGoneAgentAnchor = (
    logPrefix: string,
    selector: string,
    candidates: AgentCandidate[],
    allowed: boolean,
  ): { anchor: AgentCandidate; label: string } | null => {
    if (!allowed) return null
    const anchor = resolveLastUserTargetCandidate(ctx, candidates)
    if (!anchor) return null
    const label = labelFor(anchor, candidates)
    log(`${logPrefix}: selector="${selector}" → gone → anchor fallback ${anchor.paneId}/${anchor.windowName}`)
    return { anchor, label }
  }

  const armSelectedAgentRoute = (target: AgentCandidate, label: string, messageId: number | null, threadId: number | null): string => {
    const previous = cancelSelectedAgentRoute()
    if (previous && previous.messageId !== null && previous.messageId !== messageId) {
      void editMessageText(ctx, previous.messageId, `cancelled ${previous.label} — replaced by another selection`)
    }
    const token = `s${++selectedAgentTokenSeq}`
    const timer = setTimeout(() => {
      if (selectedAgentRoute?.token !== token) return
      selectedAgentRoute = null
      if (messageId !== null) void editMessageText(ctx, messageId, `selected ${label} — expired`)
    }, SELECTED_AGENT_TTL_MS)
    selectedAgentRoute = { token, paneId: target.paneId, label, messageId, threadId, timer }
    return token
  }

  // Post the session-grouped inline-keyboard agent PICKER and arm its pending
  // selection. `message` empty ⇒ a select-only picker; bare `/agent` additionally
  // sets `armNextMessage` so a tap routes the next ordinary inbound message.
  // Non-empty ⇒ the route picker (a tap injects the message). Returns false only
  // when the picker send itself failed.
  const postAgentPicker = async (
    subset: AgentCandidate[],
    message: string,
    sourceMessageId: number | null,
    options: { armNextMessage?: boolean; messageExtra?: Record<string, unknown>; threadId?: number | null; notice?: string } = {},
  ): Promise<boolean> => {
    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, message, false, options.notice)
    const messageExtra = options.messageExtra ?? {}
    const messageId = await sendMessage(ctx, payload.text, { ...messageExtra, reply_markup: payload.reply_markup })
    // Picker send failed (Telegram rejected / >4096-char list / network): do NOT
    // store a pending route it can never resolve, and do NOT earn a 👀 receipt.
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>", messageExtra)
      return false
    }
    armPendingAgent(token, {
      message,
      candidates: subset,
      messageId,
      sourceMessageId,
      relatedReactionMessageId: null,
      selectOnly: message.trim() === "",
      armNextMessage: message.trim() === "" && options.armNextMessage === true,
      threadId: options.threadId ?? null,
    })
    if (message.trim() !== "") queueAckReaction(sourceMessageId, DEFER_REACTION)
    return true
  }

  // Select-only picker (buttons, no pending route): fallback for an ambiguous
  // control verb that carries no routable text (a /stop or /kill across several
  // agents) — the buttons show the live agents instead of a plain-text dump, and
  // a tap hands back the selector to address one.
  // Guards an empty subset (a freak full race where candidatesForPicker filtered
  // every discovery pane out) → the no-agent reply, never a button-less picker
  // (mirrors postRoutePicker; matches the candidatesForPicker fallback comment).
  const postSelectPicker = async (subset: AgentCandidate[]): Promise<boolean> => {
    if (subset.length === 0) {
      await replyNoAgent()
      return false
    }
    return postAgentPicker(subset, "", null)
  }

  // Route picker for ALREADY-WRAPPED text (a tap injects it VERBATIM, prewrapped:
  // true) — the ambiguous-target path (injectViaTarget) and, with a gone-target
  // `notice`, the reply-route picker. Unlike postReplyPicker it does NOT reorder by
  // LRU/MRU: the ambiguous fleet has no prior reply usage to rank by. Returns false
  // only when the picker send itself failed.
  const postRoutePicker = async (
    subset: AgentCandidate[],
    prewrappedText: string,
    notice?: string,
    sourceMessageId: number | null = null,
    relatedReactionMessageId: number | null = null,
  ): Promise<boolean> => {
    if (subset.length === 0) {
      await replyNoAgent()
      return false
    }
    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, prewrappedText, false, notice)
    const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>")
      return false
    }
    armPendingAgent(token, {
      message: prewrappedText,
      candidates: subset,
      messageId,
      sourceMessageId,
      relatedReactionMessageId,
      prewrapped: true,
    })
    queueAckReaction(sourceMessageId, DEFER_REACTION)
    return true
  }

  const injectPrewrappedToPane = async (
    paneId: string,
    prewrappedText: string,
    sourceMessageId: number | null,
    // REQUIRED, not optional (review finding): both call sites already have the
    // target's live `panePath` on hand, and an optional `cwd` would let a future
    // caller silently omit it — recordLastUserTarget then treats a missing cwd
    // as "invalidate the anchor" (tg-cli#78), so a forgotten argument here would
    // silently wipe the CTO's anchor on every delivery through this path.
    cwd: string,
    // A topic delivery answers errors in its topic and never moves the flat-chat anchor.
    // `sessionKey`: the registry session this is for — a pane must still host THAT session
    // (spec §2.6), checked before typing or queueing behind an open question.
    { out = {}, recordAnchor = true, sessionKey }: { out?: Record<string, unknown>; recordAnchor?: boolean; sessionKey?: string } = {},
  ): Promise<boolean> => {
    if (paneId.startsWith("omp:")) {
      const pid = Number(paneId.slice("omp:".length))
      const live = listLiveOmpAgents().find((a) => a.pid === pid)
      if (!live) {
        await sendMessage(ctx, `omp ${paneId} is no longer running`, out)
        return false
      }
      const ompCwd = live.cwd ?? "/"
      log(`injectPrewrapped: omp original-process pane=${paneId} cwd=${ompCwd} (not tmux send-keys)`)
      const res = await deliverOriginalOmp(live, prewrappedText, sourceMessageId ?? undefined, live.paneId)
      if (!res.ok) {
        await sendMessage(ctx, res.error, out)
        return false
      }
      if (recordAnchor) recordLastUserTarget(paneId, ompCwd)
      return true
    }
    const hostDelivery = shouldDeferInbound(paneId) ? null : deliverHostPane(paneId, prewrappedText, sourceMessageId)
    if (hostDelivery) {
      const res = await hostDelivery
      if (!res.ok) {
        await sendMessage(ctx, res.error, out)
        return false
      }
      if (recordAnchor) recordLastUserTarget(paneId, cwd)
      return true
    }
    const refusal = paneSessionRefusal(sessionKey, paneId)
    if (refusal !== null) {
      await sendMessage(ctx, refusal, out)
      return false
    }
    if (shouldDeferInbound(paneId)) {
      markDeferredForAck(enqueueDeferred(paneId, prewrappedText, sourceMessageId, null, sessionKey))
      // A media `/agent` caption is an explicit CTO routing choice, same as its
      // text equivalent — record the tg-cli#78 anchor (review finding: this path
      // was the one remaining explicit-routing gap).
      if (recordAnchor) recordLastUserTarget(paneId, cwd)
      return true
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === paneId)
    const hosted = pane ? findAgentInPane(pane, procs) : null
    if (hosted?.agent === "omp") {
      const live = liveOmpForPane(listLiveOmpAgents(), paneId, hosted.pid)
      log(`injectPrewrapped: omp original-process pane=${paneId} cwd=${cwd} (endpoint first; own-pane tmux only without one)`)
      const res = await deliverOriginalOmp(live ?? { cwd: cwd || "/", pid: hosted.pid }, prewrappedText, sourceMessageId ?? undefined, paneId)
      if (!res.ok) {
        await sendMessage(ctx, res.error, out)
        return false
      }
      if (recordAnchor) recordLastUserTarget(paneId, cwd)
      return true
    }
    const res = await injectInbound(sourceMessageId, paneId, buildTextInjectPlan(paneId, prewrappedText, { sessionKey }))
    if (!res.ok) {
      await sendMessage(ctx, res.error, out)
      return false
    }
    if (recordAnchor) recordLastUserTarget(paneId, cwd)
    return true
  }

  // `/agent <selector> …` that matched no candidate (a tmux pane, omp-live or a rig-wrapper
  // host), checked against the non-omp agents running outside tmux AND outside the wrapper
  // (tg-cli#456): a ONE-line refusal naming how to restart it under the wrapper — nothing is
  // sent or queued (the Stop-hook inbox this replaces delivered only at a turn end an idle
  // session never reached). true when it refused (the caller stops), false when nothing matches.
  const refuseOutsideTmux = async (selector: string, out: Record<string, unknown> = {}): Promise<boolean> => {
    const hits = matchUnreachable(selector, listUnreachableAgents())
    if (hits.length === 0) return false
    log(`agent-route: selector="${selector}" → outside tmux and the rig wrapper (${hits.map((a) => `${a.agent} pid ${a.pid}`).join(", ")}) — refused`)
    await sendMessage(ctx, outsideTmuxRefusalText(selector, hits), out)
    return true
  }

  // A `/agent <selector> <message>` whose selector matched NO tmux pane: try the agents
  // running OUTSIDE tmux. An omp gets the (already wrapped) text through its original-
  // process bridge; any other harness gets the refusal. No match returns null
  // so the caller keeps its legacy "no agent matching" error. Never a silent drop.
  const tryRouteOutsideTmux = async (
    selector: string,
    wrapped: string,
    messageId: number | null,
    out: Record<string, unknown> = {},
  ): Promise<boolean | null> => {
    const ompHits = matchLiveOmp(selector, listLiveOmpAgents())
    if (ompHits.length > 1) {
      const lines = describeOmpLines(ompHits)
      await sendMessage(ctx, `'${selector}' matches several omp sessions:\n${lines.join("\n")}`, out)
      return false
    }
    if (ompHits.length === 1) {
      const target = ompHits[0]
      const cwd = target.cwd ?? "/"
      log(`agent-route: selector="${selector}" → omp original-process pid=${target.pid} title=${liveOmpLabel(target)} cwd=${cwd}`)
      const res = await deliverOriginalOmp(target, wrapped, messageId ?? undefined, target.paneId)
      if (!res.ok) {
        await sendMessage(ctx, res.error, out)
        return false
      }
      await sendMessage(ctx, `→ ${liveOmpLabel(target)} · omp (original-process)`, out)
      return true
    }
    return (await refuseOutsideTmux(selector, out)) ? false : null
  }

  const routePrewrappedAgentMessage = async (
    route: ParsedAgentCommand,
    prewrappedText: string,
    sourceMessageId: number,
  ): Promise<boolean> => {
    cancelSelectedAgentRouteForAgentCommand()
    const candidates = listAgentCandidates()
    const msgPreview = prewrappedText.slice(0, 60).replace(/\n/g, " ")
    if (candidates.length === 0) {
      if (route.selector) {
        const routed = await tryRouteOutsideTmux(route.selector, prewrappedText, sourceMessageId)
        if (routed !== null) return routed
      }
      log(`media-agent-route: no candidates — selector=${route.selector || "(none)"} msg="${msgPreview}"`)
      await sendMessage(ctx, noAgentReplyNow())
      return false
    }

    if (route.selector) {
      const m = matchWindows(route.selector, candidates)
      if (m.matches.length > 0) {
        if (m.confident) {
          const target = m.matches[0]
          log(`media-agent-route: selector="${route.selector}" → ${target.paneId}/${target.windowName} confident=true msg="${msgPreview}"`)
          return injectPrewrappedToPane(target.paneId, prewrappedText, sourceMessageId, target.panePath)
        }
        const names = m.matches.map((c) => c.windowName).join(", ")
        log(`media-agent-route: selector="${route.selector}" → ambiguous (${m.matches.length} matches: ${names}) → picker`)
        return postRoutePicker(m.matches, prewrappedText, undefined, sourceMessageId)
      }
      const routed = await tryRouteOutsideTmux(route.selector, prewrappedText, sourceMessageId)
      if (routed !== null) return routed
      const found = resolveGoneAgentAnchor("media-agent-route", route.selector, candidates, true)
      if (found) {
        const { anchor, label } = found
        const ok = await injectPrewrappedToPane(anchor.paneId, prewrappedText, sourceMessageId, anchor.panePath ?? "/")
        if (ok) {
          recordLastUserTarget(anchor.paneId, anchor.panePath)
          await sendMessage(ctx, goneAgentFallbackReplyText(route.selector, label))
        }
        return ok
      }
      const names = candidates.map((c) => c.windowName).join(", ")
      log(`media-agent-route: selector="${route.selector}" → NO match among [${names}] — reporting error`)
      await sendMessage(ctx, `no agent matching '${route.selector}' (running: ${names}) — try /agent to pick`)
      return false
    }

    if (candidates.length === 1) {
      const target = candidates[0]
      log(`media-agent-route: no selector, single candidate → ${target.paneId}/${target.windowName} msg="${msgPreview}"`)
      return injectPrewrappedToPane(target.paneId, prewrappedText, sourceMessageId, target.panePath)
    }

    log(`media-agent-route: no selector, ${candidates.length} candidates → picker msg="${msgPreview}"`)
    return postRoutePicker(candidates, prewrappedText, undefined, sourceMessageId)
  }

  const injectIntoSelectedAgent = async (prewrappedText: string, sourceMessageId: number): Promise<boolean | null> => {
    const selected = cancelSelectedAgentRoute()
    if (!selected) return null
    const liveFleet = listAgentCandidates()
    const liveTarget = liveFleet.find((c) => c.paneId === selected.paneId)
    if (!liveTarget) {
      await sendMessage(ctx, `selected ${selected.label} is no longer running — routing this message normally`, replyContext(selected.threadId))
      if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, `selected ${selected.label} — agent is no longer running`)
      return null
    }
    const label = labelFor(liveTarget, liveFleet)
    log(`agent-select: next message → ${liveTarget.paneId}/${liveTarget.windowName}`)
    if (!liveTarget.paneId.startsWith("omp:") && shouldDeferInbound(liveTarget.paneId)) {
      markDeferredForAck(enqueueDeferred(liveTarget.paneId, prewrappedText, sourceMessageId))
      if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, routedReply(label, true))
      // An armed one-shot route is the CTO's own prior explicit choice — record
      // it as the tg-cli#78 anchor (review finding: `/agent`-driven routing
      // previously never updated it).
      recordLastUserTarget(liveTarget.paneId, liveTarget.panePath)
      return true
    }
    const text = withGitStateBanner(liveTarget.panePath, prewrappedText)
    const ok = await injectPrewrappedToPane(liveTarget.paneId, text, sourceMessageId, liveTarget.panePath ?? "/")
    if (!ok) {
      if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, "inject failed")
      return false
    }
    if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, routedReply(label, false))
    return true
  }

  // /agent routing (item 1): bare `/agent` → an inline-keyboard PICKER (tappable
  // buttons, one distinct-labelled button per agent); confident phonetic match →
  // direct inject; ambiguous → the same session-grouped picker carrying the pending
  // message; named selector with NO match → error reply, never silent fallback.
  const handleAgentRoute = async (action: Extract<Action, { kind: "agent-route" }>): Promise<boolean> => {
    const out = replyContext(action.threadId)
    cancelSelectedAgentRouteForAgentCommand()
    const candidates = listAgentCandidates()
    const msgPreview = action.all.slice(0, 60).replace(/\n/g, " ")
    if (candidates.length === 0) {
      if (action.selector && action.rest.trim()) {
        const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, action.rest, action.messageId)
        const routed = await tryRouteOutsideTmux(action.selector, wrapped, action.messageId, out)
        if (routed !== null) return routed
      } else if (action.selector && (await refuseOutsideTmux(action.selector, out))) {
        return false
      }
      log(`agent-route: no candidates — selector=${action.selector || "(none)"} msg="${msgPreview}"`)
      await sendMessage(ctx, noAgentReplyNow(), out)
      return false
    }
    if (!action.all.trim()) {
      // Bare `/agent`: tappable picker over EVERY live agent, including
      // out-of-tmux omp (paneId omp:<pid> → ACP). No outside-tmux notice.
      log(`agent-route: bare /agent → picker over ${candidates.length} candidates`)
      return postAgentPicker(candidates, "", null, { armNextMessage: true, messageExtra: out, threadId: action.threadId ?? null })
    }

    if (action.selector) {
      const m = matchWindows(action.selector, candidates)
      if (m.matches.length > 0) {
        if (!action.rest.trim()) {
          // `/agent <name>` with NO message: SELECT that agent as the routing
          // target for the next ordinary message (repair of #158 — a named
          // selection used to only print a hint and never arm a route). A
          // confident single match arms directly; an ambiguous match shows the
          // same select-only picker bare `/agent` uses (a tap arms the route).
          //
          // The one-shot route is a FLAT-CHAT concept: injectIntoSelectedAgent is
          // only consulted on flat inject-text / media, never on a topic-route.
          // A topic-originated `/agent <name>` (threadId set) therefore keeps the
          // plain hint — arming a global route there would only leak into a later
          // flat message and mislead ("send the next message here", codex review).
          if (action.threadId != null) {
            const names = m.matches.map((c) => c.windowName).join(", ")
            await sendMessage(ctx, `matched ${names} — add a message: /agent ${action.selector} <message>`, out)
            return true
          }
          if (m.confident) {
            const target = m.matches[0]
            const label = labelFor(target, candidates)
            log(`agent-route: selector="${action.selector}" → select-only arm ${target.paneId}/${target.windowName}`)
            const cardId = await sendMessage(ctx, `selected ${label}`, out)
            const routeToken = armSelectedAgentRoute(target, label, cardId, null)
            if (cardId !== null) {
              void editMessageText(ctx, cardId, `selected ${label} — send the next message here`, selectedAgentCancelMarkup(routeToken))
            }
            return true
          }
          log(`agent-route: selector="${action.selector}" → ambiguous select-only picker over ${m.matches.length} matches`)
          return postAgentPicker(m.matches, "", action.messageId, { armNextMessage: true, messageExtra: out })
        }
        if (m.confident) {
          const target = m.matches[0]
          log(`agent-route: selector="${action.selector}" → ${target.paneId}/${target.windowName} confident=true msg="${msgPreview}"`)
          const res = await injectToPane(target.paneId, action.from, action.rest, action.messageId, true)
          if (!res.ok) {
            log(`agent-route: inject failed → ${target.paneId}: ${res.error}`)
            await sendMessage(ctx, res.error ?? "inject failed", out)
            return false
          }
          // A named `/agent <name> <msg>` is the CTO explicitly addressing this
          // pane — record it as the tg-cli#78 anchor (review finding: `/agent`
          // routing previously never updated it, unlike the ambiguous picker).
          recordLastUserTarget(target.paneId, target.panePath)
          if (target.paneId.startsWith("omp:")) {
            await sendMessage(ctx, routedReply(labelFor(target, candidates), res.deferred), out)
          }
          return true
        }
        // Ambiguous: multiple matches — show picker over matched subset
        const names = m.matches.map((c) => c.windowName).join(", ")
        log(`agent-route: selector="${action.selector}" → ambiguous (${m.matches.length} matches: ${names}) → picker`)
        return postAgentPicker(m.matches, action.rest, action.messageId, { messageExtra: out, threadId: action.threadId ?? null })
      }
      // Named selector matched NOTHING — never silently fall back to a random agent.
      // Report the miss clearly so the user knows their intent was not routed.
      if (action.rest.trim()) {
        const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, action.rest, action.messageId)
        const routed = await tryRouteOutsideTmux(action.selector, wrapped, action.messageId, out)
        if (routed !== null) return routed
        // The named target is not live ANYWHERE tg-ctl can see — see agent-match.ts's
        // "gone-agent (dead subagent) fallback" comment for the full rationale. FLAT
        // chat only: a bound topic already carries its own stronger routing signal (the
        // topic's bound pane), so this flat last-user-target anchor — which may point at
        // a DIFFERENT project's pane entirely — must not override it, matching this
        // function's existing "topic-originated /agent keeps the plain hint" precedent
        // above.
        const found = resolveGoneAgentAnchor("agent-route", action.selector, candidates, action.threadId == null)
        if (found) {
          const { anchor, label } = found
          const res = await injectToPane(anchor.paneId, action.from, action.rest, action.messageId, true)
          if (!res.ok) {
            await sendMessage(ctx, res.error ?? "inject failed", out)
            return false
          }
          recordLastUserTarget(anchor.paneId, anchor.panePath)
          await sendMessage(ctx, goneAgentFallbackReplyText(action.selector, label, res.deferred), out)
          return true
        }
      } else if (await refuseOutsideTmux(action.selector, out)) {
        return false
      }
      const names = candidates.map((c) => c.windowName).join(", ")
      log(`agent-route: selector="${action.selector}" → NO match among [${names}] — reporting error`)
      await sendMessage(ctx, `no agent matching '${action.selector}' (running: ${names}) — try /agent to pick`, out)
      return false
    }

    // No selector (bare `/agent <message>` with no agent name): route to single
    // candidate directly, or show picker when multiple are running.
    if (candidates.length === 1) {
      const target = candidates[0]
      log(`agent-route: no selector, single candidate → ${target.paneId}/${target.windowName} msg="${msgPreview}"`)
      const res = await injectToPane(target.paneId, action.from, action.all, action.messageId, true)
      if (!res.ok) {
        await sendMessage(ctx, res.error ?? "inject failed", out)
        return false
      }
      // A bare `/agent <message>` with a single live candidate is still a
      // confirmed CTO-explicit delivery — record it as the tg-cli#78 anchor
      // (review finding: this was one of two remaining gaps where a successful
      // delivery never updated the anchor, leaving it stale once a second pane
      // later appears).
      recordLastUserTarget(target.paneId, target.panePath)
      await sendMessage(ctx, routedReply(labelFor(target, candidates), res.deferred), out)
      return true
    }

    log(`agent-route: no selector, ${candidates.length} candidates → picker msg="${msgPreview}"`)
    return postAgentPicker(candidates, action.all, action.messageId, { messageExtra: out, threadId: action.threadId ?? null })
  }

  const handleAgentCallback = async (action: Extract<Action, { kind: "agent-callback" }>): Promise<boolean> => {
    const pending = pendingAgent.get(action.token)
    if (!pending) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    // A tap must come from THIS prompt's Telegram message. After a restart
    // agentTokenSeq reuses tokens (a1, a2…), so a tap on an OLD prompt that
    // reused the token must not consume the new pending route (codex P2).
    if (pending.messageId !== null && action.messageId !== null && action.messageId !== pending.messageId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    const target = pending.candidates[action.index]
    if (!target) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    pendingAgent.delete(action.token)
    clearTimeout(pending.timer)
    // Select-only picker: bare `/agent` arms a one-shot target for the next
    // ordinary inbound message; control pickers only return the selector hint.
    if (pending.selectOnly) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "selected")
      if (pending.messageId !== null) {
        // Build selector/label against the full live fleet, not only the button
        // subset, so a suggested selector can never confidently route elsewhere.
        const live = listAgentCandidates()
        const fleet = live.some((c) => c.paneId === target.paneId) ? live : pending.candidates
        const liveTarget = fleet.find((c) => c.paneId === target.paneId) ?? target
        const label = labelFor(liveTarget, fleet)
        if (pending.armNextMessage) {
          const token = armSelectedAgentRoute(liveTarget, label, pending.messageId, pending.threadId ?? null)
          void editMessageText(ctx, pending.messageId, `selected ${label} — send the next message here`, selectedAgentCancelMarkup(token))
        } else {
          const selector = suggestSelector(liveTarget, fleet)
          void editMessageText(ctx, pending.messageId, `selected ${label} — send: /agent ${selector} <message>`)
        }
      }
      return true
    }
    // A reply's pending text already carries its wrap/anchor → inject verbatim;
    // a /agent message is raw → wrap it. Both defer behind an open question. The
    // callback has no trailing ack, so it updates the source reaction directly.
    let res: { ok: boolean; error?: string; deferred?: boolean; deferredItem?: DeferredInbound }
    if (pending.prewrapped) {
      if (!target.paneId.startsWith("omp:") && shouldDeferInbound(target.paneId)) {
        const item = enqueueDeferred(target.paneId, pending.message, pending.sourceMessageId, pending.relatedReactionMessageId)
        res = { ok: true, deferred: true, deferredItem: item }
      } else {
        const ok = await injectPrewrappedToPane(target.paneId, pending.message, pending.sourceMessageId, target.panePath ?? "/")
        res = ok ? { ok: true } : { ok: false, error: "inject failed" }
      }
    } else {
      res = await injectToPane(target.paneId, action.from, pending.message, pending.sourceMessageId)
    }
    // An explicit picker tap is the CTO deliberately choosing this pane — record
    // it as the tg-cli#78 anchor on any confirmed outcome (delivered or queued),
    // never on a failed inject (codex/Opus review finding: explicit routing
    // previously never updated the anchor, leaving an ambiguous fleet asking
    // forever after the very first pick). Every `res` construction above already
    // sets `ok: true` for a deferred outcome too, so `res.ok` alone covers both
    // today — `res.deferred` is included explicitly anyway (Opus review finding)
    // so this stays correct even if a future refactor ever decouples the two.
    if (res.ok || res.deferred) recordLastUserTarget(target.paneId, target.panePath)
    const deferredState = res.deferredItem?.state ?? "queued"
    if (res.deferred && pending.sourceMessageId !== null && deferredState !== "delivered") {
      if (deferredState === "queued") await setReaction(pending.sourceMessageId, DEFER_REACTION)
    } else if (res.ok) {
      await setSeenReactions(pending.sourceMessageId, pending.relatedReactionMessageId)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, res.ok ? (res.deferred ? "queued" : "sent") : "failed")
    if (pending.messageId !== null) {
      void editMessageText(
        ctx,
        pending.messageId,
        res.ok ? routedReply(labelFor(target, pending.candidates), res.deferred) : `inject failed: ${res.error ?? ""}`,
      )
    }
    return res.ok
  }

  const handleAgentCancelCallback = async (action: Extract<Action, { kind: "agent-cancel" }>): Promise<boolean> => {
    const selected = selectedAgentRoute
    if (
      !selected ||
      selected.token !== action.token ||
      (selected.messageId !== null && action.messageId !== null && selected.messageId !== action.messageId)
    ) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    cancelSelectedAgentRoute()
    await answerCallbackQuery(ctx, action.callbackQueryId, "cancelled")
    if (selected.messageId !== null) void editMessageText(ctx, selected.messageId, `cancelled ${selected.label}`)
    return true
  }

  // A reply: route to the recognized origin pane (routes map) or, when unknown,
  // a session-grouped picker ordered LRU/MRU. injectText is injected verbatim
  // everywhere here — for a prose reply it already carries the wrap + quote
  // anchor; for a `!shell` reply it is the RAW `!…` text (codex #192), so `!`
  // stays at column 0 for the harness passthrough.
  const handleReplyRoute = async (
    action: Extract<Action, { kind: "reply-route" }>,
    relatedReactionMessageId: number | null = null,
  ): Promise<boolean> => {
    const routes = parseRoutes(readFileOrNull(ctx.paths.routes))
    const recognized = recognizeRoute(routes, action.replyToMessageId)
    // A reply handed over from a gone session's topic (tg-cli#709) is answered in that topic.
    const out = replyContext(action.threadId)
    // `sessionKey`: the session this reply is for, when known — a deferred copy
    // carries it, and the pane is re-verified to host it right before typing (§2.6).
    const injectVerbatim = async (paneId: string, sessionKey?: string): Promise<boolean> => {
      const live = matchLiveOmpOrigin(paneId, listLiveOmpAgents())
      if (live) {
        // Same defer-while-waiting rule as every tmux pane: never type into an open question.
        if (live.paneId && shouldDeferInbound(live.paneId)) {
          markDeferredForAck(enqueueDeferred(live.paneId, action.injectText, action.messageId, relatedReactionMessageId, sessionKey))
          return true
        }
        const res = await deliverOriginalOmp(live, action.injectText, action.messageId, live.paneId)
        if (!res.ok) {
          await sendMessage(ctx, res.error)
          return false
        }
        await setSeenReactions(null, relatedReactionMessageId)
        return true
      }
      const hostDelivery = shouldDeferInbound(paneId) ? null : deliverHostPane(paneId, action.injectText, action.messageId)
      if (hostDelivery) {
        const res = await hostDelivery
        if (!res.ok) {
          await sendMessage(ctx, res.error)
          return false
        }
        await setSeenReactions(null, relatedReactionMessageId)
        return true
      }
      if (shouldDeferInbound(paneId)) {
        markDeferredForAck(enqueueDeferred(paneId, action.injectText, action.messageId, relatedReactionMessageId, sessionKey))
        return true
      }
      const res = await injectInbound(action.messageId, paneId, buildTextInjectPlan(paneId, action.injectText, { sessionKey }))
      if (!res.ok) {
        await sendMessage(ctx, res.error)
        return false
      }
      // The source message's own receipt is still handled by the trailing ack
      // action. This branch only adds the related replied-to message receipt.
      await setSeenReactions(null, relatedReactionMessageId)
      return true
    }

    // Post the LRU/MRU-ordered agent picker for this reply and arm its pending
    // selection. Shared by the unrecognized-multi-agent case AND the
    // recognized-but-unconfirmed origin case (a known origin we currently can't
    // SEE must never auto-collapse onto the wrong agent — let the human pick).
    // `notice` prepends a gone-target line ("That agent … is no longer running")
    // when the reply's recorded origin pane is no longer a live, same-project agent.
    const postReplyPicker = async (candidates: AgentCandidate[], notice?: string): Promise<boolean> => {
      const usage = aggregateUsage(routes)
      const order = orderByLruMru(candidates.map((c) => c.paneId), usage)
      const byPane = new Map(candidates.map((c) => [c.paneId, c]))
      const sorted = order.map((pid) => byPane.get(pid)!).filter(Boolean)
      const token = `a${++agentTokenSeq}`
      // preserveOrder: keep the LRU/MRU ranking — groupBySession must not re-sort.
      const payload = buildAgentSelectMessage(ctx.chatId, sorted, token, action.injectText, true, notice)
      const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup, ...out })
      if (messageId === null) {
        await sendMessage(ctx, "couldn't post the reply picker", out)
        return false
      }
      armPendingAgent(token, {
        message: action.injectText,
        candidates: sorted,
        messageId,
        sourceMessageId: action.messageId,
        relatedReactionMessageId,
        prewrapped: true,
      })
      queueAckReaction(action.messageId, DEFER_REACTION)
      return true
    }

    // A human label for the GONE origin agent of this recognized reply — the
    // project dir (cwd basename) it was recorded against, else its pane id. Used
    // in the picker notice so the CTO sees WHICH agent vanished, not just "an agent".
    const goneOriginLabel = (): string => {
      const cwd = recognized?.cwd
      if (cwd) {
        const base = cwd.replace(/\/+$/, "").split("/").pop()
        if (base) return base
      }
      return recognized?.paneId ?? "the agent you replied to"
    }
    const goneNotice = (name: string = goneOriginLabel()): string => `That agent (${name}) is no longer running — pick a live one:`

    const msgPreview = action.injectText.slice(0, 60).replace(/\n/g, " ")

    // A reply whose origin is gone. It goes to the origin's recorded process-lineage
    // parent (route.parentPaneId, #503) when that is live: a disposable nested omp
    // that sent the replied-to message and exited hands the reply to the omp that
    // started it. `tg` proved that lineage from the process tree at send time; a
    // session that only shares the origin's cwd is never chosen (unrelated sessions
    // share /tmp or a repo root). Otherwise the picker naming the agent they meant,
    // so a terminated one reads as "that agent is gone" rather than a silent re-ask
    // (CTO ask, #72) — or the no-agent reply when nothing is live.
    const replyToGoneOrigin = async (route: NonNullable<typeof recognized>, name: string, why: string): Promise<boolean> => {
      const replyTo = action.replyToMessageId
      const candidates = listAgentCandidates()
      const parentId = route.parentPaneId
      const parent = parentId === undefined ? null : lineageParentCandidate(parentId, candidates, listLiveOmpAgents())
      if (parent) {
        log(`reply-route: replyTo=${replyTo} → ${why}, routing to lineage parent ${parent.paneId} msg="${msgPreview}"`)
        const delivered = await injectVerbatim(parent.paneId)
        if (delivered) {
          if (parent.panePath) recordLastUserTarget(parent.paneId, parent.panePath)
          // Fire-and-forget, never delaying delivery: the reply did not land where
          // the CTO replied, so say where it went (#446).
          void sendMessage(ctx, `↩️ ${name} is gone — routed to ${labelFor(parent, candidates)}, the session that started it`, out)
        }
        return delivered
      }
      const lineage = parentId === undefined ? "" : `, lineage parent ${parentId} not live`
      log(`reply-route: replyTo=${replyTo} → ${why} → picker (${candidates.length} candidates${lineage})`)
      if (candidates.length > 0) return postReplyPicker(candidates, goneNotice(name))
      await sendMessage(ctx, noAgentReplyNow(), out)
      return false
    }

    // Session-keyed reply (spec §2.4–§2.5, tg-cli#459): the reply follows the
    // SESSION that sent the replied-to message to wherever it lives now — a
    // resumed omp keeps its key under a new pid, a moved one under a new pane —
    // re-read by a fresh scan. It never falls back to a same-project guess: a gone
    // session (or a legacy row the migration could not resolve) goes to
    // replyToGoneOrigin. null: the route carries no session identity at all
    // (an untracked harness, a pre-registry `tg`) — the pane path below decides.
    const routeReplyBySession = async (route: NonNullable<typeof recognized>): Promise<boolean | null> => {
      const replyTo = action.replyToMessageId
      if (route.legacySince !== undefined) return replyToGoneOrigin(route, goneOriginLabel(), `legacy route ${route.paneId}`)
      // A session a rig wrapper hosts outside tmux: its route origin IS `host:<name>`. The host
      // is re-verified by deliverToHost; a gone one gets the picker, never a same-project guess.
      const originHost = hostNameFromOriginId(route.paneId)
      if (originHost !== null) {
        const host = listLiveHosts(snapshot().procs).find((h) => h.name === originHost)
        if (!host) return replyToGoneOrigin(route, goneOriginLabel(), `host ${originHost} gone`)
        log(`reply-route: replyTo=${replyTo} → ${route.paneId} (abduco PTY) msg="${msgPreview}"`)
        const delivered = await injectVerbatim(route.paneId)
        if (delivered) recordLastUserTarget(route.paneId, host.cwd ?? route.cwd)
        return delivered
      }
      const exactOrigin = route.agentPid !== undefined || route.serverPid !== undefined || route.paneId.startsWith("omp:")
      if (route.sessionKey === undefined && !exactOrigin) return null
      // A resumed omp's new process publishes a new endpoint; pick it up before
      // the scan so an out-of-tmux delivery can reach it.
      await refreshOriginalHosts()
      const reg = refreshSessionRegistry()
      if (!reg) return null
      const key = route.sessionKey ?? resolveRouteSession(reg, route)
      if (key === null) {
        // The origin's exact locators name a session that has since left: the
        // picker, never the same-project pane guess below.
        const gone = goneRouteSession(reg, route)
        if (gone) return replyToGoneOrigin(route, gone.name.primary, `origin session ${gone.key} gone`)
        return null
      }
      const target = sessionDeliveryTarget(reg, key)
      if (target.kind !== "live") {
        return replyToGoneOrigin(route, target.kind === "gone" ? target.name : goneOriginLabel(), `session ${key} ${target.kind}`)
      }
      const paneId = target.paneId ?? (target.pid !== null ? liveOmpPaneId(target.pid) : null)
      if (paneId === null) return replyToGoneOrigin(route, target.name, `session ${key} has no locator`)
      log(`reply-route: replyTo=${replyTo} → session ${key} at ${paneId} (sent from ${route.paneId}) msg="${msgPreview}"`)
      const delivered = await injectVerbatim(paneId, key)
      if (delivered) recordLastUserTarget(paneId, target.cwd || undefined)
      return delivered
    }

    if (recognized) {
      const bySession = await routeReplyBySession(recognized)
      if (bySession !== null) return bySession
      const liveHit = matchLiveOmpOrigin(recognized.paneId, listLiveOmpAgents())
      if (liveHit) {
        // omp:<pid> is the live process (pid identity). Do not require cwd match:
        // tg often runs from /tmp while liveHit.cwd is the session dir (Codex P1 #340).
        if (ompReplyOriginMatches(recognized, liveHit)) {
          log(`reply-route: replyTo=${action.replyToMessageId} → ${recognized.paneId} omp ACP pid=${liveHit.pid} msg="${msgPreview}"`)
          const delivered = await injectVerbatim(recognized.paneId)
          if (delivered) recordLastUserTarget(recognized.paneId, liveHit.cwd ?? "/")
          return delivered
        }
      }
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === recognized.paneId)
      // Route to the origin pane ONLY if it still hosts an agent AND is still the
      // SAME project: a tmux pane id is reused after kill-pane, so a stale
      // message_id→%N map could otherwise inject a reply into a DIFFERENT
      // project's agent — leaking project A's reply into project B (review
      // --brainstorm finding). routeMatchesPane validates the recorded send-path
      // (now the origin pane's path — see tg recordRoute) against the live pane's
      // path; on mismatch (or no recorded cwd for an old route) fall through to
      // the picker rather than risk mis-routing.
      const sameProject = routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: pane?.panePath })
      if (pane && sameProject && findAgentInPane(pane, procs)) {
        log(`reply-route: replyTo=${action.replyToMessageId} → ${recognized.paneId} recognized=true sameProject=true msg="${msgPreview}"`)
        // A confirmed reply is the CTO explicitly addressing this pane — the
        // clearest possible signal for the tg-cli#78 anchor. Recorded only once
        // injectVerbatim confirms delivery (queued-deferred or actually injected),
        // never on a failed inject (codex/Opus review finding).
        const delivered = await injectVerbatim(recognized.paneId)
        if (delivered) recordLastUserTarget(recognized.paneId, pane.panePath)
        return delivered
      }

      // We KNOW the origin pane but the snapshot can't CONFIRM it. snapshot()
      // already retried the transient empty/partial `tmux list-panes` read
      // (panesWithRetry); if it STILL can't see the recognized pane there are two
      // shapes — and the launchd no-locale flake (`no-agent reply: panes=0`) makes
      // a zero/partial snapshot a real, recurring runtime state, not a one-off:
      //   (a) the snapshot returned ZERO/partial panes — origin almost certainly
      //       still alive, just invisible. The OLD code fell through and, when the
      //       partial snapshot left exactly ONE agent visible (deterministically
      //       the last writer of the single global registration slot — [rig]/%2),
      //       silently injected the recognized reply into THAT wrong agent. A
      //       recognized reply must NEVER lose to whatever single agent is visible.
      //   (b) the origin pane is genuinely gone/reused/different-project — the
      //       legitimate fall-through to the picker (04cb6e5).
      // Tell them apart by whether the origin pane appears in the snapshot AT ALL
      // (`pane` IS that lookup — undefined ⇔ not visible). When it is NOT visible,
      // post the PICKER (human disambiguates) instead of the single-candidate
      // auto-inject — never the registration's last-writer pane.
      if (!pane) {
        // DEAD SENDER: the origin was a disposable/one-shot sender — a subagent
        // process (or a synthetic omp:<pid> from a headless script, tg-cli#363)
        // that sent once and exited, so its pane/pid will NEVER become visible
        // again. Only its recorded lineage parent may take the reply. A live
        // agent that merely shares the recorded cwd is NOT its parent: the old
        // exact-cwd guess (#423) typed replies into unrelated sessions sharing
        // /tmp or a repository root (#503).
        return replyToGoneOrigin(recognized, goneOriginLabel(), `origin ${recognized.paneId} NOT visible in snapshot`)
      }
      // origin pane visible but not a same-project agent → genuinely reused/gone;
      // fall through to the normal picker path below (with the gone notice).
      log(`reply-route: replyTo=${action.replyToMessageId} → origin ${recognized.paneId} visible but sameProject=${sameProject} hasAgent=${!!findAgentInPane(pane, procs)} → picker (gone/reused)`)
    }

    const candidates = listAgentCandidates()
    if (candidates.length === 0) {
      log(`reply-route: replyTo=${action.replyToMessageId} → no candidates recognized=${!!recognized}`)
      await sendMessage(ctx, noAgentReplyNow(), out)
      return false
    }
    // An UNRECOGNIZED reply (no origin known) with a single agent is unambiguous —
    // inject there. The recognized-but-unconfirmed case above never reaches here. A reply
    // from a gone session's topic is not: its session is gone, so the human picks (tg-cli#709).
    if (!recognized && candidates.length === 1 && action.threadId === undefined) {
      log(`reply-route: replyTo=${action.replyToMessageId} → unrecognized, single candidate ${candidates[0].paneId}/${candidates[0].windowName} → inject msg="${msgPreview}"`)
      const delivered = await injectVerbatim(candidates[0].paneId)
      // Still a confirmed CTO-explicit delivery — record it as the tg-cli#78
      // anchor (review finding: this was the other remaining gap where a
      // successful delivery never updated the anchor).
      if (delivered) recordLastUserTarget(candidates[0].paneId, candidates[0].panePath)
      return delivered
    }

    // Anything else — several agents, OR a recognized reply that fell through
    // (origin visible but reused/gone) — goes to the LRU/MRU-ordered picker. A
    // recognized reply that reached here KNEW an origin that's now gone (its pane
    // was reused by a different project), so it carries the gone notice; an
    // unrecognized reply never knew an origin, so no notice.
    log(`reply-route: replyTo=${action.replyToMessageId} → ${candidates.length} candidates recognized=${!!recognized} → picker`)
    return postReplyPicker(candidates, recognized ? goneNotice() : undefined)
  }

  // --- forum topics: inbound triage (docs/specs/session-registry-and-topics.md §4.4) ---
  // A topic is an ADDRESS for an existing session: messages in a bound topic reach that session,
  // messages in an unknown topic are held while the attach picker asks which live session gets
  // them. Nothing here spawns. The binding store is read fresh on each access (like routes) and
  // rewritten on every transition. It is only consulted when topics are on (control.topics /
  // control.private_topics); otherwise topicStatusOf is never wired into stepUpdates and topic
  // messages take the flat path unchanged.
  const loadTopics = (): TopicBinding[] => parseTopics(readFileOrNull(ctx.paths.topics))
  // A strictly-monotonic nonce for per-spawn tokens: unique even for two spawns in the same
  // second. Seeded above `Date.now()` ms so a daemon restart can't reuse a live token.
  let spawnNonceSeq = Date.now()
  const nextSpawnNonce = (): number => ++spawnNonceSeq
  const persistTopics = (topics: TopicBinding[]): void => {
    // Best-effort, off the inject path: a write error must never break the poll loop — it is
    // logged, not thrown. A lost transition self-heals: the next routed message re-checks the
    // session and records `closed` again.
    try {
      writeFileSync(ctx.paths.topics, serializeTopics(topics), { mode: 0o600 })
    } catch (err) {
      log(`topics persist failed: ${err}`)
    }
  }
  // THE way a handler changes bindings: load → mutate → persist in ONE synchronous call. Handlers
  // for different topics run concurrently (resource key `thread:<id>`), so a load held across an
  // `await` would let two of them persist over each other (e.g. two topics attaching to one
  // session). With no await inside, the event loop makes this the store's lock. `mutate` returns
  // the next binding list, or null to leave the store untouched; the result is the list as it
  // now stands.
  const updateTopics = (mutate: (topics: TopicBinding[]) => TopicBinding[] | null): TopicBinding[] => {
    const current = loadTopics()
    const next = mutate(current)
    if (next === null) return current
    persistTopics(next)
    return next
  }
  // The registry session that owns topic `threadId` (spec §4.2): the registry, not a topics.json
  // pane binding, is the truth for a session's topic. A live owner wins over a gone one.
  const topicOwner = (threadId: number): SessionEntry | null => {
    const owners = currentSessionRegistry()?.sessions.filter((e) => e.threadId === threadId) ?? []
    return owners.find((e) => e.state === "live") ?? owners[0] ?? null
  }
  // The registry session a topic message addresses (§4.4 rows 2–3): the topic's owner, else — a
  // binding the attach picker or a pre-registry spawn made — the ONE live session on the bound
  // pane locator with the binding's cwd. A closed binding is never re-resolved by its pane: that
  // `%N` may host a stranger now. null: the registry does not know the topic (no scan yet, or an
  // untracked harness), and the binding's own pane decides.
  const resolveTopicSession = (threadId: number, binding: TopicBinding | null): SessionEntry | null => {
    const owner = topicOwner(threadId)
    if (owner) return owner
    const reg = currentSessionRegistry()
    if (!reg || binding?.status !== "bound" || !binding.paneId) return null
    const key = resolveLocatorToSession(reg, binding.paneId, binding.path)
    return key === null ? null : (reg.sessions.find((e) => e.key === key) ?? null)
  }
  // threadId → current status (or null when unknown) for stepUpdates' pure triage. A topic the
  // registry gives to a session is known even without a topics.json binding, so a live session's
  // topic never lands behind the attach picker.
  const topicStatusOf = (threadId: number): TopicStatus | null => {
    const owner = topicOwner(threadId)
    if (owner) return owner.state === "live" ? "bound" : "closed"
    return findTopic(loadTopics(), threadId)?.status ?? null
  }
  // sendMessage threaded into a topic — all topic-originated daemon output MUST carry
  // message_thread_id or it lands in General.
  const sendToTopic = (threadId: number, text: string): Promise<number | null> =>
    sendMessage(ctx, text, { message_thread_id: threadId })

  // Is the session a bound topic addresses still running? `gone` is terminal (its pane closed or
  // its agent exited to a shell; an out-of-tmux omp whose pid is no longer live). `unconfirmed`
  // is NOT: a flaky empty `ps` read (the pane is visible but no process list came back) or a
  // live pane whose cwd no longer matches the binding — a tmux pane-id REUSE by another
  // project's agent must never receive this topic's message, while a transient empty
  // pane_current_path read or a legitimate `cd` self-heals on the next message.
  const topicSessionState = (
    binding: TopicBinding & { paneId: string },
  ): { state: "live"; cwd: string } | { state: "gone" } | { state: "unconfirmed"; reply: string } => {
    if (binding.paneId.startsWith("omp:")) {
      const pid = Number(binding.paneId.slice("omp:".length))
      const live = listLiveOmpAgents().find((a) => a.pid === pid)
      return live ? { state: "live", cwd: live.cwd ?? binding.path ?? "/" } : { state: "gone" }
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === binding.paneId)
    if (!pane) return { state: "gone" }
    if (findAgentInPane(pane, procs) === null) {
      return procs.length === 0
        ? { state: "unconfirmed", reply: "couldn't confirm this topic's session right now — try again" }
        : { state: "gone" }
    }
    if (binding.path !== undefined && !routeMatchesPane({ recognizedCwd: binding.path, panePath: pane.panePath })) {
      return { state: "unconfirmed", reply: "this topic's session pane can't be confirmed right now — try again" }
    }
    return { state: "live", cwd: pane.panePath || binding.path || "/" }
  }

  // The agent-facing text for one topic payload: text as-is; a photo/file is downloaded and a
  // voice note transcribed first, exactly as in the flat chat. Failures are answered in the
  // topic and return null.
  const renderTopicPayload = async (threadId: number, payload: TopicPayload): Promise<string | null> => {
    if (payload.type === "text") return payload.text
    const out = replyContext(threadId)
    let body: string
    if (payload.type === "media") {
      const dest = await downloadFileToCache(payload.fileId, payload.suggestedName, out)
      if (dest === null) return null
      body = mediaReceipt(payload.mediaKind, dest, payload.caption)
    } else {
      const transcript = await transcribeVoiceNote(payload.fileId, payload.suggestedName, payload.messageId, out)
      if (transcript === null) return null
      body = formatVoiceTranscript(transcript)
    }
    const wrapped = wrapInbound(ctx.cfg.injectWrap, payload.from, body, payload.messageId)
    return payload.anchor ? `${payload.anchor}\n${wrapped}` : wrapped
  }

  // Deliver one topic payload to a live session through the flat delivery path (omp endpoint →
  // in-tmux send-keys; deferred behind an open question). Errors answer in the topic, and a topic
  // delivery never moves the flat-chat last-user-target anchor. `sessionKey`: the registry session
  // the pane must still host (§2.6).
  const deliverTopicPayload = async (threadId: number, paneId: string, cwd: string, payload: TopicPayload, sessionKey?: string): Promise<boolean> => {
    if (payload.type === "text" && (await answerOpenCardInChat(paneId, payload.plain, payload.messageId, threadId, sessionKey))) return true
    const text = await renderTopicPayload(threadId, payload)
    if (text === null) return false
    return injectPrewrappedToPane(paneId, text, payload.messageId, cwd, { out: replyContext(threadId), recordAnchor: false, sessionKey })
  }

  const sessionStillAt = (key: string, target: Extract<SessionDeliveryTarget, { kind: "live" }>): boolean =>
    target.paneId !== null
      ? paneSessionRefusal(key, target.paneId) === null
      : target.pid === null || listLiveOmpAgents().some((a) => a.pid === target.pid)

  // THE delivery to a registry session (§4.4 row 2), shared by the bound-topic route and the
  // attach picker: a fresh scan says where the session lives NOW (a resumed omp keeps its key
  // under a new pid; a moved one keeps it in a new pane), then the flat path above delivers it —
  // the omp-live endpoint, the in-tmux send-keys fallback (#483), cc/codex send-keys, voice STT
  // and media download. Never a fallback to another session. `gone`: nothing was sent.
  const deliverToSession = async (
    key: string,
    threadId: number,
    payload: TopicPayload,
  ): Promise<{ kind: "sent"; ok: boolean } | { kind: "gone"; name: string | null }> => {
    // A resumed omp's new process publishes a new endpoint; pick it up before the scan.
    await refreshOriginalHosts()
    const reg = refreshSessionRegistry()
    if (!reg) return { kind: "gone", name: null }
    let target = sessionDeliveryTarget(reg, key)
    // That scan may be a rate-limited one from moments ago. Before rendering (STT, download),
    // confirm the session is still where it says — the §2.6 check rescans a pane that changed
    // hands; an out-of-tmux omp's pid must still be live — else a forced scan says where it went,
    // or that it is gone.
    if (target.kind === "live" && !sessionStillAt(key, target)) {
      target = sessionDeliveryTarget(refreshSessionRegistry(true) ?? reg, key)
    }
    if (target.kind !== "live") return { kind: "gone", name: target.kind === "gone" ? target.name : null }
    // A live cc/codex entry always has a pane and a live omp a pid; the `omp:<pid>` row is the
    // out-of-tmux omp's endpoint-only locator.
    const paneId = target.paneId ?? (target.pid !== null ? liveOmpPaneId(target.pid) : null)
    if (paneId === null) return { kind: "gone", name: target.name }
    log(`topic ${threadId}: → session ${key} at ${paneId}`)
    return { kind: "sent", ok: await deliverTopicPayload(threadId, paneId, target.cwd, payload, key) }
  }

  // A gone topic session (§4.4 row 3). A plain message gets the "not running — resume with …"
  // reply in the topic. A REPLY to one of the topic's messages takes the flat reply fallback
  // instead (tg-cli#709): the replied-to message's lineage parent when live, else the agent
  // picker — answered in this topic, never a dead end for a message aimed at a specific report.
  const answerGoneTopic = async (threadId: number, payload: TopicPayload, goneReply: string): Promise<boolean> => {
    if (payload.replyTo === undefined) {
      await sendToTopic(threadId, goneReply)
      return false
    }
    log(`warning: topic ${threadId}: reply to tg#${payload.replyTo} reached a gone session — reply fallback (lineage parent or picker)`)
    const injectText = await renderTopicPayload(threadId, payload)
    if (injectText === null) return false
    return handleReplyRoute({ kind: "reply-route", replyToMessageId: payload.replyTo, injectText, from: payload.from, messageId: payload.messageId, threadId })
  }

  // §4.4 rows 2–3 for a topic the registry knows: its session gets the message wherever it runs;
  // a gone one is answered by answerGoneTopic.
  const routeTopicToSession = async (threadId: number, entry: SessionEntry, payload: TopicPayload): Promise<boolean> => {
    const res = await deliverToSession(entry.key, threadId, payload)
    if (res.kind === "sent") return res.ok
    log(`topic ${threadId}: session ${entry.key} is not running`)
    return answerGoneTopic(threadId, payload, goneTopicReply({ name: res.name ?? entry.name.primary, harness: HARNESS_AGENT[entry.harness] }))
  }

  // §4.4 rows 2–3: a message in a known topic. A live session gets it; a gone one is answered by
  // answerGoneTopic. Never a spawn, never an automatic fallback to another session.
  const handleTopicRoute = async (action: Extract<Action, { kind: "topic-route" }>): Promise<boolean> => {
    const binding = findTopic(loadTopics(), action.threadId)
    const entry = resolveTopicSession(action.threadId, binding)
    if (entry) {
      // A topic bound by pane (the attach picker, a pre-registry spawn) becomes its session's
      // registry topic: it follows the session from now on and is renamed with it (§4.7).
      if (entry.threadId === null && entry.state === "live") patchSessionEntry(ctx, entry.key, { threadId: action.threadId })
      return routeTopicToSession(action.threadId, entry, action.payload)
    }
    // The binding vanished between triage and now (a same-batch store change): the topic is
    // unknown again, so it takes the unknown-topic path rather than dropping the message.
    if (!binding) return handleTopicHold({ kind: "topic-hold", threadId: action.threadId, payload: action.payload })
    // A `/new` spawn runs synchronously inside one handler, so any awaiting-model row seen here is
    // a spawn that never finished (a crash reconcile could not adopt). Nothing will ever bind it:
    // drop it, and the topic takes the unknown-topic path — the attach picker.
    if (binding.status === "awaiting-model") {
      log(`topic ${action.threadId}: dropping unfinished spawn binding — topic is unknown again`)
      updateTopics((topics) => removeTopic(topics, action.threadId))
      return holdUnknownTopicPayload({ kind: "topic-hold", threadId: action.threadId, payload: action.payload })
    }
    if (binding.status === "closed" || !binding.paneId) return answerGoneTopic(action.threadId, action.payload, goneTopicReply(binding))
    const session = topicSessionState({ ...binding, paneId: binding.paneId })
    if (session.state === "gone") {
      log(`topic ${action.threadId}: session ${binding.paneId} is gone — marking closed`)
      updateTopics((topics) => appendTopic(topics, markClosed(binding, Math.floor(Date.now() / 1000))))
      return answerGoneTopic(action.threadId, action.payload, goneTopicReply(binding))
    }
    if (session.state === "unconfirmed") {
      await sendToTopic(action.threadId, session.reply)
      return false
    }
    return deliverTopicPayload(action.threadId, binding.paneId, session.cwd, action.payload)
  }

  // --- unknown-topic hold + attach picker (§4.4 row 4) ---
  // The hold is its own store keyed by threadId, persisted on every mutation (atomic tmp+rename,
  // like the deferred backlog) and restored on bootstrap, so a restart neither loses held
  // messages nor skips their expiry reply. Holds live in memory between mutations; handlers for
  // one thread are serialized by the dispatcher's `thread:<id>` resource key.
  let topicHolds: TopicHold[] = parseHolds(readFileOrNull(ctx.paths.topicHolds))
  if (topicHolds.length) {
    const count = topicHolds.reduce((n, h) => n + h.payloads.length, 0)
    log(`topic holds restored: ${count} message(s) across ${topicHolds.length} topic(s)`)
  }
  const setTopicHolds = (next: TopicHold[]): void => {
    topicHolds = next
    try {
      atomicWrite(ctx.paths.topicHolds, serializeHolds(topicHolds))
    } catch (err) {
      log(`topic holds persist failed: ${err}`)
    }
  }

  // Holds dropped undelivered (expired, or evicted past MAX_TOPIC_HOLDS) are answered in their
  // topic, and their picker loses its buttons.
  const answerDroppedHolds = async (dropped: TopicHold[], why: string): Promise<void> => {
    for (const hold of dropped) {
      log(`topic ${hold.threadId}: hold ${why} with ${hold.payloads.length} undelivered message(s)`)
      for (const id of holdButtonMessages(hold)) void clearMessageKeyboard(ctx, id)
      for (const p of hold.payloads) recordFailed(p.messageId, `thread:${hold.threadId}`, `topic hold ${why}`)
      await sendToTopic(hold.threadId, holdExpiredReply(hold.payloads.length))
    }
  }

  // The picker's buttons: every live session, most recently messaged first.
  const attachSessions = (): Array<{ paneId: string; label: string }> => {
    const fleet = listAgentCandidates()
    const byPane = new Map(fleet.map((c) => [c.paneId, c]))
    const usage = aggregateUsage(parseRoutes(readFileOrNull(ctx.paths.routes)))
    return orderByLruMru(fleet.map((c) => c.paneId), usage).flatMap((paneId) => {
      const candidate = byPane.get(paneId)
      return candidate ? [{ paneId, label: labelFor(candidate, fleet) }] : []
    })
  }

  const handleTopicHold = async (action: Extract<Action, { kind: "topic-hold" }>): Promise<boolean> => {
    // The 📥 Inbox topic (tg-cli#705) belongs to no session: only a tap on, or a reply to, one
    // of its copies does anything there (those never reach this hold).
    if (inboxState.threadId === action.threadId) {
      // Answered in General: nothing but question-card copies ever goes into the Inbox.
      await sendMessage(ctx, "📥 the Inbox topic only lists open questions — tap a button on one, or reply to it, to answer it")
      return false
    }
    // The topic got a binding between triage and now (a same-batch picker tap bound it): route
    // instead of re-holding behind a second picker. Symmetric to handleTopicRoute's fallback.
    if (findTopic(loadTopics(), action.threadId) || topicOwner(action.threadId)) {
      return handleTopicRoute({ kind: "topic-route", threadId: action.threadId, payload: action.payload })
    }
    const dirAnswer = newSessionDirAnswer(action)
    if (dirAnswer) return handleNewAnswer(dirAnswer, action.threadId)
    return holdUnknownTopicPayload(action)
  }

  // A path typed in a topic whose ➕ New session flow awaits a directory (tg-cli#735) answers that
  // prompt — an existing directory advances it, anything else gets the "not a directory" reply —
  // and is not held for the new agent. That includes a bare `/word` and a path with spaces: the
  // topic has no agent a harness command could be meant for (daemon verbs were answered before the
  // topic rows). A reply counts too: card replies were answered before the topic rows. Topic
  // messages never reach the flat dir-answer gate in stepUpdates, so this is the topic's own.
  const newSessionDirAnswer = (action: Extract<Action, { kind: "topic-hold" }>): Extract<Action, { kind: "new-answer" }> | null => {
    const p = action.payload
    if (p.type !== "text") return null
    if (![...pendingNew.values()].some((s) => s.bindThreadId === action.threadId && s.status === "awaiting-dir")) return null
    const path = (p.plain ?? p.text).trim()
    return isAbsolute(path) ? { kind: "new-answer", text: path, from: p.from, messageId: p.messageId } : null
  }

  // The hold itself, without the "bound meanwhile?" re-check: handleTopicRoute's awaiting-model drop
  // calls this directly, so a failed store write can never bounce route ↔ hold forever.
  const holdUnknownTopicPayload = async (action: Extract<Action, { kind: "topic-hold" }>): Promise<boolean> => {
    const { kept, evicted } = capHolds(holdPayload(topicHolds, action.threadId, action.payload, Math.floor(Date.now() / 1000)))
    setTopicHolds(kept)
    log(`topic ${action.threadId}: unknown topic — held message ${action.payload.messageId}`)
    recordHeld(action.payload.messageId, `thread:${action.threadId}`, "topic-hold")
    // ✍️ ("noted, queued") instead of 👀: the message has not reached a session yet.
    queueAckReaction(action.payload.messageId, DEFER_REACTION)
    await answerDroppedHolds(evicted, "evicted (too many held topics)")
    const hold = findHold(topicHolds, action.threadId)
    if (!hold || hold.pickerMessageId !== null) return true
    const sessions = attachSessions()
    // With no live session there is nothing to attach to: that notice (with only ➕ New session) is
    // posted once per hold. A later message re-checks, and posts the full picker once a session
    // has started.
    if (sessions.length === 0 && hold.noSessionNoticeId !== undefined) return true
    const pickerId = await sendMessage(ctx, attachPickerText(sessions.length), {
      message_thread_id: action.threadId,
      reply_markup: { inline_keyboard: buildAttachKeyboard(action.threadId, sessions) },
    })
    // A failed send stays unrecorded, so the next message retries it.
    if (pickerId === null) return true
    setTopicHolds(
      sessions.length > 0 ? setHoldPicker(topicHolds, action.threadId, pickerId) : markNoSessionNotice(topicHolds, action.threadId, pickerId),
    )
    return true
  }

  // A pick: deliver the whole queue to the chosen session in order, exactly once. When that
  // session has no topic yet this topic becomes its topic (renamed to its title); when it
  // already has one, this topic stays unbound and the reply links the session's own topic.
  const handleTopicAttach = async (action: Extract<Action, { kind: "topic-attach" }>): Promise<boolean> => {
    const hold = findHold(topicHolds, action.threadId)
    const stalePicker = hold?.pickerMessageId != null && action.messageId !== null && action.messageId !== hold.pickerMessageId
    if (!hold || stalePicker) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — nothing is waiting here")
      if (action.messageId !== null) void clearMessageKeyboard(ctx, action.messageId)
      return true
    }
    const fleet = listAgentCandidates()
    const target = fleet.find((c) => c.paneId === action.paneId)
    if (!target) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that session is no longer running — pick another")
      // Forget the stale picker so the next message in this topic posts a fresh one over the
      // sessions running then, instead of stranding the hold behind dead buttons until its TTL.
      if (hold.pickerMessageId !== null) {
        void clearMessageKeyboard(ctx, hold.pickerMessageId)
        setTopicHolds(setHoldPicker(topicHolds, action.threadId, null))
      }
      return false
    }
    const label = labelFor(target, fleet)
    const session = { paneId: target.paneId, name: label, path: target.panePath, harness: target.agent }
    // Take the queue BEFORE the first await: a second tap on the same picker then finds no hold,
    // so every payload is delivered exactly once.
    setTopicHolds(dropHold(topicHolds, action.threadId))
    let outcome = ""
    let delivered = 0
    let stopped: string | null = null
    // Everything after the drop is guarded: the queue is already taken, so a throw anywhere below
    // must still answer for the undelivered tail rather than drop it silently.
    try {
      await answerCallbackQuery(ctx, action.callbackQueryId, "sending…")
      // The registry session behind the picked pane, when the registry knows it: its topic is the
      // registry's (§4.2), and its queue is delivered by key like any bound topic's. The registry
      // is re-read as the pane is now: a `%N` that changed hands must not bind the old session.
      const reg = registryForPane(target.paneId)
      const pickedKey = reg ? resolveLocatorToSession(reg, target.paneId, undefined) : null
      const entry = pickedKey ? liveEntry(ctx, pickedKey) : null
      // "Does this session already have a topic?" and the bind run with no await in between, so
      // two topics picking the same session concurrently can never both bind it.
      const own = entry?.threadId ?? topicForPane(loadTopics(), target.paneId)?.threadId ?? null
      if (own !== null && own !== action.threadId) {
        const link = topicLink(ctx.chatId, own)
        outcome = `${label} already has its own topic${link ? ` — ${link}` : ""}; this topic stays unlinked`
      } else {
        if (entry) patchSessionEntry(ctx, entry.key, { threadId: action.threadId })
        updateTopics((current) => appendTopic(current, attachTopic(action.threadId, session, Math.floor(Date.now() / 1000))))
        await editSessionTopic(ctx, action.threadId, entry ? topicTitleFor(entry) : sessionTopicTitle(label))
        outcome = `this topic is now ${label}`
      }
      if (entry) {
        for (const payload of hold.payloads) {
          const res = await deliverToSession(entry.key, action.threadId, payload)
          if (res.kind === "gone") {
            stopped = `${label} stopped before delivery`
            break
          }
          if (!res.ok) continue
          delivered++
          await settleAckReaction(payload.messageId, true)
        }
      } else {
        // Re-verify after the Bot API round-trips above: a pane that died and whose `%N` was
        // reused meanwhile must never receive this topic's queue (the same guard the route path
        // applies).
        const state = topicSessionState({ ...attachTopic(action.threadId, session, 0), paneId: target.paneId })
        if (state.state === "gone") stopped = `${label} stopped before delivery`
        else if (state.state === "unconfirmed") stopped = state.reply
        else {
          for (const payload of hold.payloads) {
            if (!(await deliverTopicPayload(action.threadId, target.paneId, state.cwd, payload))) continue
            delivered++
            await settleAckReaction(payload.messageId, true)
          }
        }
      }
    } catch (err) {
      log(`topic ${action.threadId}: attach delivery interrupted: ${err}`)
      stopped = "delivery interrupted"
    }
    const failed = hold.payloads.length - delivered
    const summary = `→ ${label}: ${delivered} delivered${failed ? `, ${failed} failed` : ""}${stopped ? ` — ${stopped}` : ""}`
    log(`topic ${action.threadId}: attach → ${target.paneId} (${summary}; ${outcome})`)
    if (hold.pickerMessageId !== null) void editMessageText(ctx, hold.pickerMessageId, summary)
    else await sendToTopic(action.threadId, summary)
    if (outcome) await sendToTopic(action.threadId, outcome)
    return failed === 0
  }

  // The picker's ➕ New session tap (tg-cli#735): the /new directory → harness → model flow runs
  // in this topic, and its spawn takes the topic as the new session's own (spawnIntoHeldTopic).
  // The hold stays until that spawn, so the picker's other buttons keep working meanwhile; the tap
  // restarts its clock so it lasts as long as the prompts do. Only a button of the topic's current
  // hold works: a tap after that hold was delivered or expired starts nothing.
  const handleTopicNewSession = async (action: Extract<Action, { kind: "topic-new-session" }>): Promise<boolean> => {
    reapNewSessions()
    // Run the expiry sweep now, not on its next tick: a hold past its TTL is answered and gone, so a
    // late tap cannot revive it.
    await expireTopicHolds()
    const hold = findHold(topicHolds, action.threadId)
    if (!hold || (action.messageId !== null && !holdButtonMessages(hold).includes(action.messageId))) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — nothing is waiting here")
      if (action.messageId !== null) void clearMessageKeyboard(ctx, action.messageId)
      return true
    }
    // A flow already open for this topic is answered, not restarted: the hold clock is extended
    // once per flow, so re-tapping cannot keep the hold alive forever.
    if ([...pendingNew.values()].some((s) => s.bindThreadId === action.threadId)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "already started — answer the prompt below")
      return true
    }
    // An open private-topic fallback decision blocks replacing the pending /new, as in handleNewCommand.
    if (privateTopicFallbackState === "pending") {
      if ([...pendingNew.values()].some((s) => s.status === "awaiting-private-topic-fallback")) {
        await answerCallbackQuery(ctx, action.callbackQueryId, "finish the open /new first")
        return false
      }
      privateTopicFallbackState = "unknown"
    }
    const now = Math.floor(Date.now() / 1000)
    setTopicHolds(restartHoldClock(topicHolds, action.threadId, now))
    // One /new in flight at a time, the same rule a typed /new follows. A replaced flow's prompt
    // loses its buttons, so a second topic's tap never leaves a dead prompt that looks alive.
    for (const replaced of pendingNew.values()) if (replaced.promptMessageId != null) void clearMessageKeyboard(ctx, replaced.promptMessageId)
    pendingNew.clear()
    const session: NewSession = {
      token: `n${++newTokenSeq}`,
      name: "",
      status: "awaiting-dir",
      task: "",
      ts: now,
      threadId: action.threadId,
      bindThreadId: action.threadId,
      sourceChatId: ctx.chatId,
      sourceMessageId: action.messageId ?? 0,
    }
    pendingNew.set(session.token, session)
    log(`topic ${action.threadId}: ➕ new session — asking for a directory`)
    await answerCallbackQuery(ctx, action.callbackQueryId, "new session — pick a directory")
    await askNewDir(session)
    return true
  }

  // Spawn a ➕ New session into the topic it was started from. The held text messages, in order,
  // are the agent's initial prompt: argv, so nothing races the agent's startup. The hold is taken
  // and the topic bound before the first await — the model tap runs under its own token lock, so
  // an attach tap on this topic may run concurrently — and it is put back if the spawn fails. Claims
  // reach the ledger before the spawn, so a restored hold can never send them a second time. Held
  // media and voice notes cannot ride an argv prompt and are answered in the topic. A topic whose
  // hold is gone (delivered by an attach tap, or expired) or that got linked spawns nothing.
  const spawnIntoHeldTopic = async (
    session: NewSession,
    threadId: number,
    modelId: string,
    slug: string,
    promptMessageId: number | null,
  ): Promise<boolean> => {
    const hold = findHold(topicHolds, threadId)
    if (!hold || findTopic(loadTopics(), threadId) || topicOwner(threadId)) {
      pendingNew.delete(session.token)
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      const why = hold ? "this topic was linked to a session meanwhile" : "nothing is waiting in this topic any more"
      await sendMessage(ctx, `${why} — no new agent was spawned; send /new to start one`, replyContext(threadId))
      return false
    }
    setTopicHolds(dropHold(topicHolds, threadId))
    // The task rides one argv element, which Linux caps at 128 KiB (MAX_ARG_STRLEN): held texts
    // join it in order up to half that; the rest is answered like an attachment, never a spawn
    // that fails the same way on every Retry.
    const TASK_MAX_BYTES = 64 * 1024
    const texts: Array<Extract<TopicPayload, { type: "text" }>> = []
    let taskBytes = Buffer.byteLength(session.task)
    for (const p of hold.payloads) {
      if (p.type !== "text") continue
      const bytes = Buffer.byteLength(p.text) + 2
      if (taskBytes + bytes > TASK_MAX_BYTES) break
      texts.push(p)
      taskBytes += bytes
    }
    const task = [session.task, ...texts.map((p) => p.text)].filter((t) => t.trim().length > 0).join("\n\n")
    const target = `thread:${threadId}`
    const ledgerEvent = (event: "claimed" | "delivered", messageId: number): LedgerEvent[] =>
      deliveryLedger ? [{ ts: Date.now(), event, chat: deliveryLedger.chat, msg: messageId, target }] : []
    // The sink contract (deliverInboundOnce): a claim that cannot reach the disk sends nothing.
    const claimed = texts.map((p) => recordDelivery(ledgerEvent("claimed", p.messageId)))
    if (claimed.includes(false)) {
      for (const p of texts) recordFailed(p.messageId, target, "the delivery ledger could not be written")
      setTopicHolds(returnHold(topicHolds, hold))
      pendingNew.delete(session.token)
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      await sendMessage(ctx, "the delivery ledger could not be written, so no agent was started — the messages are still held; pick again", replyContext(threadId))
      return false
    }
    if (!(await spawnNewSessionWithTopic(session, modelId, threadId, slug, promptMessageId, task))) {
      // Unclaimed and held again: the Retry button, or a pick from the picker, still sends them.
      for (const p of texts) recordFailed(p.messageId, target, "the new session did not start")
      setTopicHolds(returnHold(topicHolds, hold))
      return false
    }
    for (const p of texts) {
      recordDelivery(ledgerEvent("delivered", p.messageId))
      await settleAckReaction(p.messageId, true)
    }
    await editSessionTopic(ctx, threadId, sessionTopicTitle(session.name))
    const summary = `→ new session ${session.name}: ${texts.length} held message(s) as its first task`
    log(`topic ${threadId}: ${summary}`)
    for (const id of holdButtonMessages(hold)) void editMessageText(ctx, id, summary)
    const passed = new Set(texts.map((p) => p.messageId))
    const left = hold.payloads.filter((p) => !passed.has(p.messageId))
    if (left.length > 0) {
      for (const p of left) recordFailed(p.messageId, target, "not part of a new session's first task (attachment, or past its size cap)")
      await sendToTopic(threadId, `${left.length} held message(s) not passed to ${session.name} — send them here again`)
    }
    return true
  }

  // A hold older than TOPIC_HOLD_TTL_SEC is answered in its topic and discarded. Run on a timer
  // and once at bootstrap, so a hold that expired while the daemon was down still gets its reply.
  // The sweep also enforces MAX_TOPIC_HOLDS on a restored store, answering what it evicts. A hold
  // whose ➕ New session flow is still open is not expired: the flow's own TTL (reapNewSessions)
  // bounds it, and its spawn takes the hold.
  const expireTopicHolds = async (): Promise<void> => {
    reapNewSessions()
    const flowing = new Set([...pendingNew.values()].map((s) => s.bindThreadId))
    const { expired: due, open } = splitExpiredHolds(topicHolds, Math.floor(Date.now() / 1000))
    const expired = due.filter((h) => !flowing.has(h.threadId))
    open.push(...due.filter((h) => flowing.has(h.threadId)))
    const { kept, evicted } = capHolds(open)
    if (expired.length === 0 && evicted.length === 0) return
    setTopicHolds(kept)
    await answerDroppedHolds(expired, "expired")
    await answerDroppedHolds(evicted, "evicted (too many held topics)")
  }

  // §4.4 row 5: forum_topic_created / _edited / _closed / _reopened are recorded only. A user
  // topic rename is left alone; nothing is spawned and no tmux window is renamed.
  const handleTopicEvent = (action: Extract<Action, { kind: "topic-event" }>): boolean => {
    log(`topic ${action.threadId}: ${action.event}${action.name ? ` "${action.name}"` : ""}`)
    return true
  }

  // --- flat /new private-topic spawn helpers (issue #186) ---
  // A flat `/new` with control.private_topics creates a topic for the new session and spawns it
  // into its own tmux window. SAFETY (this is the CTO's daily lifeline daemon): every step is
  // exception-guarded — a bad path, a missing tmux, an unknown model, or a spawn error NEVER
  // throws into the poll loop; it logs and posts a human-readable error.

  // statSync throws on a broken symlink / EACCES — guard so a malformed path answer can never
  // bubble into the poll loop. A non-existent or non-directory path → false (re-ask the human).
  const isExistingDirectory = (path: string): boolean => {
    try {
      return statSync(path).isDirectory()
    } catch {
      return false
    }
  }

  // The tmux session to spawn the new window into: the configured pin, else the session a live
  // agent already runs in (so the new window lands beside the existing agents), else undefined
  // (tmux new-window without -t targets the current/only session). Best-effort, never throws.
  const sessionForSpawn = (): string | undefined => {
    if (ctx.cfg.session) return ctx.cfg.session
    const { panes, procs } = snapshot()
    for (const p of panes) {
      if (findAgentInPane(p, procs) !== null) return p.sessionName
    }
    return panes[0]?.sessionName
  }

  // Run `tmux new-window … -- <agent argv>` and return the created pane id, or an error.
  // -P -F '#{pane_id}' prints the new pane id on stdout → bound immediately (no discovery race,
  // spec §5). `-e TG_TOPIC=<threadId>` stamps the topic id into the NEW window's environment so the
  // spawned agent's plain `tg "reply"` threads back INTO this topic automatically — no `--topic`
  // needed (spec §9.4 deferral; codex r8 #1). The `tg` send side already reads TG_TOPIC and fails
  // soft on a stale/closed topic. Fully guarded: a spawn throw (tmux missing) or a non-zero exit
  // becomes a typed error, never an exception. `task` is passed through the model catalog as the
  // spawned agent's initial prompt. The path + argv are discrete argv elements (never shell-split),
  // so a directory with spaces is safe.
  const spawnTopicWindow = (
    threadId: number,
    windowSlug: string,
    path: string,
    model: string,
    task = "",
  ): { ok: true; paneId: string } | { ok: false; error: string } => {
    const argvBase = spawnArgvWithTask(model, path, task)
    if (!argvBase) return { ok: false, error: `unknown model \`${model}\` — pick a model again` }
    // tg#8708 (option a): add codex --dangerously-bypass-hook-trust ONLY when codex hooks are
    // rig-managed (rig vouches for them); never bypass a user's own untrusted hooks.
    const argv = applyCodexHookTrustBypass(argvBase, findModel(model)?.kind, process.env)
    try {
      // sessionForSpawn() runs snapshot() (tmux list-panes / ps), which CAN throw if a binary is
      // missing — it MUST be inside this try, else the throw escapes the local guard, past
      // the /new spawn, into the poll loop (exactly the "never throws" guarantee this defends).
      const session = sessionForSpawn()
      const tmuxArgv = [
        "tmux",
        "new-window",
        // `=<session>:` (not a bare name) so a NUMERIC session name isn't misparsed as a window
        // index — a bare `-t 1` fails `create window failed: index 1 in use`. See sessionTargetArgs.
        ...sessionTargetArgs(session),
        // -e sets the spawned PROCESS env so the agent's plain `tg` threads back into this topic.
        "-e",
        `TG_TOPIC=${threadId}`,
        "-n",
        windowSlug,
        "-c",
        path,
        "-P",
        "-F",
        "#{pane_id}",
        "--",
        ...argv,
      ]
      const proc = Bun.spawnSync(tmuxArgv, { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `couldn't start the agent (tmux: ${proc.stderr.toString().trim() || `exit ${proc.exitCode}`})` }
      }
      const paneId = proc.stdout.toString().trim()
      if (!paneId) return { ok: false, error: "tmux did not return a pane id — agent not started" }
      return { ok: true, paneId }
    } catch (err) {
      return { ok: false, error: `couldn't start the agent (${err})` }
    }
  }

  // Stamp the per-spawn token as a WINDOW USER OPTION on the just-created pane (codex r11): a
  // `@user_option` IS queryable after a restart via `#{@tg_spawn_token}` in PANE_FORMAT, unlike
  // `new-window -e` process env. Best-effort — a failure only weakens token-based orphan adoption
  // (the recorded paneId is the fallback proof — codex r12 P1), never the spawn. Never throws.
  const stampSpawnToken = (paneId: string, spawnToken: string): void => {
    try {
      const proc = Bun.spawnSync(["tmux", "set-option", "-w", "-t", paneId, "@tg_spawn_token", spawnToken], {
        stdout: "pipe",
        stderr: "pipe",
        env: SUBPROC_ENV,
      })
      // LOG a non-zero exit (codex r19 P2): the stamp is best-effort (the recorded paneId is the
      // fallback proof), but a silent failure would quietly weaken token-based orphan adoption — so
      // surface it for observability rather than swallowing it.
      if (proc.exitCode !== 0) {
        log(`set @tg_spawn_token for ${paneId} exited ${proc.exitCode}: ${proc.stderr.toString().trim()}`)
      }
    } catch (err) {
      log(`set @tg_spawn_token failed for ${paneId}: ${err}`)
    }
  }

  // (The per-spawn token is now read directly from each pane's snapshot `spawnToken` field — the
  // `@tg_spawn_token` window user option in PANE_FORMAT — so no extra per-candidate tmux call.)

  // The set of panes a `bound` binding LEGITIMATELY holds (so an orphan adoption never steals one).
  // Only a bound binding whose live pane STILL MATCHES its recorded project counts: a path-mismatched
  // (tmux-reused `%N`) bound pane is NOT a legit claim, so it doesn't block a real spawnPending orphan
  // (codex r8 #2). A pathless bound binding claims by pane id alone.
  const legitimatelyClaimedPanes = (topics: TopicBinding[], liveAgentPanes: PaneInfo[]): Set<string | undefined> =>
    new Set(
      topics
        .filter((t) => {
          if (t.status !== "bound" || !t.paneId) return false
          if (t.path === undefined) return true
          const live = liveAgentPanes.find((p) => p.paneId === t.paneId)
          return live !== undefined && routeMatchesPane({ recognizedCwd: t.path, panePath: live.panePath })
        })
        .map((t) => t.paneId),
    )

  // Reconcile ONE binding against the live tmux state on startup. Returns the SAME object when
  // nothing changes (the caller uses identity to detect a change), else a new transitioned binding:
  //   - a `bound` binding whose recorded pane is gone → markClosed (agent died while down);
  //   - an `awaiting-model` binding whose topic-slug window hosts a live UNCLAIMED agent → markBound
  //     (adopt the crash-orphan, no second spawn). `claimed` excludes panes already bound elsewhere.
  const reconcileOneTopic = (
    binding: TopicBinding,
    liveAgentPanes: PaneInfo[],
    claimed: Set<string>,
    ts: number,
  ): TopicBinding => {
    if (binding.status === "bound") {
      // Close the binding ONLY when the recorded pane no longer hosts an agent (genuinely gone). A
      // mere PATH MISMATCH on a live pane is NOT closed here: it can be a transient empty-path read
      // (the launchd flake) or a legit `cd`, and closing on that would irreversibly kill a live topic
      // on a flaky startup read — exactly what the routing-time guard deliberately avoids (see the
      // ctl-topics-integration "REUSED pane … NOT closed" test). The ROUTING path already prevents a
      // leak into a reused-pane stranger (it refuses to inject on a mismatch), so a reused-`%N` case
      // is contained there and self-heals; reconcile must not over-close (codex r4 P2 declined — the
      // transient-read safety wins over closing early). An out-of-tmux omp (`omp:<pid>`) has no
      // pane in this snapshot at all; routing checks its pid per message, so it is left as is.
      if (binding.paneId?.startsWith("omp:")) return binding
      const stillLive = binding.paneId && liveAgentPanes.some((p) => p.paneId === binding.paneId)
      if (stillLive) return binding
      log(`topic ${binding.threadId}: bound pane ${binding.paneId} gone on startup — marking closed`)
      return markClosed(binding, ts)
    }
    // Adopt a crash-orphan ONLY for the EXACT crash-gap state: `awaiting-model` WITH path + model AND
    // the `spawnPending` marker SET. That marker is armed right before `tmux new-window` and the
    // binding is dropped on spawn FAILURE, so only a binding whose new-window actually RAN (and whose
    // `bound` write was lost to a crash) is a real orphan. Without the marker, a legacy awaiting-model
    // row (codex r5 #1 / r7 P1) could be wrongly bound to an unrelated same-slug/cwd pane (parseTopics
    // already drops such rows). A `closed` topic's session is gone (never
    // resurrect — codex r2 #2).
    if (
      binding.status !== "awaiting-model" ||
      !binding.spawnPending ||
      !binding.spawnToken ||
      !binding.path ||
      !binding.model ||
      !findModel(binding.model)
    )
      return binding
    // Adopt a live agent pane that is PROVABLY the one we launched. Candidates: an unclaimed pane in
    // the topic-slug window with the same cwd. Among those, the proof is EITHER the recorded paneId
    // (set right after new-window — codex r12 P1) OR our per-spawn token. Since `@tg_spawn_token` is a
    // WINDOW option, EVERY pane in the window exposes it, so a multi-pane window (the user split it)
    // could token-match more than one pane (codex r23 #2): prefer the EXACT recorded paneId; fall back
    // to a token match ONLY when it is UNAMBIGUOUS (exactly one). Never bind a guessed pane.
    const slug = slugifyTopicName(binding.name, binding.threadId)
    const candidates = liveAgentPanes.filter(
      (p) =>
        p.windowName === slug &&
        !claimed.has(p.paneId) &&
        routeMatchesPane({ recognizedCwd: binding.path, panePath: p.panePath }),
    )
    const byPaneId = binding.paneId !== undefined ? candidates.find((p) => p.paneId === binding.paneId) : undefined
    const tokenMatches = candidates.filter((p) => p.spawnToken.length > 0 && p.spawnToken === binding.spawnToken)
    const orphan = byPaneId ?? (tokenMatches.length === 1 ? tokenMatches[0] : undefined)
    if (!orphan) {
      if (tokenMatches.length > 1) log(`topic ${binding.threadId}: ambiguous token match (${tokenMatches.length} panes) — not adopting`)
      return binding
    }
    log(`topic ${binding.threadId}: adopting orphan pane ${orphan.paneId} (window ${slug}) on startup`)
    return markBound(binding, orphan.paneId, ts)
  }

  // --- flat-chat `/new` command (issue #27, NON-topic) ---
  // The flat sibling of the forum-topics /new flow: a `/new [<harness>|<model>] [<dir>] name
  // [<task>]` slash command in the flat chat spawns a fresh agent in a named tmux window. SAFETY
  // (this is the CTO's daily lifeline): every step is exception-guarded — a bad path, missing tmux,
  // unknown model, or spawn error NEVER throws into the poll loop; it logs and replies, leaving the pending
  // session so the user can retry/answer again. Unlike the topic flow there is NO persistent
  // binding: once the agent spawns the pending session is deleted (the new pane is a plain pane,
  // addressed by /agent afterwards). The pending store is in-memory (pendingNew).

  // The recent project dirs to offer as `/new` dir buttons, parents-aware + LRU/MRU (issue #27).
  // Source = the routes store (every `tg` send stamps its pane's cwd) + the per-pane registrations,
  // merged newest-first; rankNewDirChoices ALSO adds each cwd's `..` parents. Best-effort: any read
  // error → [].
  const gatherNewDirChoices = (): string[] => {
    try {
      const stamped: Array<{ cwd: string | undefined; ts: number }> = [
        ...parseRoutes(readFileOrNull(ctx.paths.routes)).map((r) => ({ cwd: r.cwd, ts: r.ts })),
        ...parseRegistrations(readFileOrNull(ctx.paths.registration)).map((r) => ({ cwd: r.cwd, ts: r.registeredAt ?? 0 })),
      ]
      stamped.sort((a, b) => b.ts - a.ts) // newest first
      return rankNewDirChoices(stamped.map((s) => s.cwd), (p) => isAbsolute(p) && isExistingDirectory(p))
    } catch (err) {
      log(`gatherNewDirChoices failed: ${err}`)
      return []
    }
  }

  // The live tmux window names (for the name-uniqueness warning). Best-effort → [] on any flake.
  const liveWindowNames = (): string[] => {
    try {
      return snapshot().panes.map((p) => p.windowName).filter((n) => n.length > 0)
    } catch {
      return []
    }
  }

  type PrivateTopicResult =
    | { kind: "topic"; threadId: number }
    | { kind: "fallback"; message?: string }
    | { kind: "ask"; message: string }
    | { kind: "waiting" }

  let privateTopicFallbackState: "unknown" | "pending" | "accepted" = "unknown"

  const privateTopicWarning = (reason: string): string =>
    `tg-ctl private_topics is enabled, but ${reason}. This chat does not need to be converted to a forum. Spawning without a topic for now; after the bot capability/provisioning reports true, run \`tg-ctl restart\` and retry \`/new\`.`

  const privateTopicFallbackPrompt = (reason: string): string =>
    `tg-ctl private_topics is enabled, but ${reason}. Continue without topic routing?`

  // Create a private-chat topic via Bot API 9.4 `createForumTopic` and return the new
  // `message_thread_id`, or a user-visible failure reason (the daemon falls back to flat-chat behaviour).
  // Graceful: a failure is logged and returned to the caller so Telegram gets an explicit
  // capability diagnostic instead of hiding "chat is not a forum" in the daemon log.
  const createPrivateTopic = async (name: string): Promise<PrivateTopicResult> => {
    if (privateTopicFallbackState === "accepted") return { kind: "fallback" }
    const me = await botPostResult(ctx, "getMe", {})
    if (me.ok) {
      const user = me.json.result
      if (user && typeof user === "object") {
        const enabled = (user as { has_topics_enabled?: unknown }).has_topics_enabled
        if (enabled === false) {
          log("private chat topic create unavailable — getMe.has_topics_enabled=false")
          if (privateTopicFallbackState === "pending") return { kind: "waiting" }
          if (privateTopicFallbackState === "unknown") {
            privateTopicFallbackState = "pending"
            return {
              kind: "ask",
              message: privateTopicFallbackPrompt("Telegram Bot API currently reports `getMe.has_topics_enabled=false` for this bot, so `createForumTopic` cannot create a private-chat topic"),
            }
          }
        }
      }
    }
    const topicResp = await botPostResult(ctx, "createForumTopic", { chat_id: ctx.chatId, name })
    if (!topicResp.ok) {
      log(`private chat topic create unavailable — createForumTopic: ${topicResp.description}`)
      return {
        kind: "fallback",
        message: privateTopicWarning(`Telegram Bot API rejected \`createForumTopic\`: ${topicResp.description}`),
      }
    }
    const result = topicResp.json.result
    if (!result || typeof result !== "object") {
      log("private chat topic create unavailable — createForumTopic returned no result object")
      return {
        kind: "fallback",
        message: privateTopicWarning("Telegram Bot API returned no topic object from `createForumTopic`"),
      }
    }
    const threadId = (result as { message_thread_id?: unknown }).message_thread_id
    if (typeof threadId !== "number") {
      log("private chat topic create unavailable — createForumTopic returned no message_thread_id")
      return {
        kind: "fallback",
        message: privateTopicWarning("Telegram Bot API returned no `message_thread_id` from `createForumTopic`"),
      }
    }
    return { kind: "topic", threadId }
  }

  // Spawn a flat `/new` agent into a named tmux window and return the pane id, or a typed error.
  // Mirrors spawnTopicWindow but WITHOUT TG_TOPIC (a flat /new agent is not bound to a topic — it
  // registers itself normally via `tg` and is addressed by /agent). When a task is given it is the
  // agent's initial prompt argv (claude accepts a positional prompt), so the agent starts working
  // immediately. Fully guarded: a throw or non-zero exit becomes a typed error, never an exception.
  const spawnNewWindow = (
    windowSlug: string,
    path: string,
    model: string,
    task: string,
    spawnToken: string,
  ): { ok: true; paneId: string } | { ok: false; error: string } => {
    const argvBase = spawnArgvWithTask(model, path, task)
    if (!argvBase) return { ok: false, error: `unknown model \`${model}\` — pick a model again` }
    // tg#8708 (option a): add codex --dangerously-bypass-hook-trust ONLY when codex hooks are
    // rig-managed (rig vouches for them); never bypass a user's own untrusted hooks.
    const argv = applyCodexHookTrustBypass(argvBase, findModel(model)?.kind, process.env)
    try {
      const session = sessionForSpawn()
      const tmuxArgv = [
        "tmux",
        "new-window",
        // `=<session>:` (not a bare name) so a NUMERIC session name isn't misparsed as a window
        // index — a bare `-t 1` fails `create window failed: index 1 in use`. See sessionTargetArgs.
        ...sessionTargetArgs(session),
        // Stamp the per-spawn token into the window env too, mirroring the topic spawn — harmless
        // for a flat /new (no reconcile depends on it) but keeps spawn provenance greppable.
        "-e",
        `TG_SPAWN_TOKEN=${spawnToken}`,
        "-n",
        windowSlug,
        "-c",
        path,
        "-P",
        "-F",
        "#{pane_id}",
        "--",
        ...argv,
      ]
      const proc = Bun.spawnSync(tmuxArgv, { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `couldn't start the agent (tmux: ${proc.stderr.toString().trim() || `exit ${proc.exitCode}`})` }
      }
      const paneId = proc.stdout.toString().trim()
      if (!paneId) return { ok: false, error: "tmux did not return a pane id — agent not started" }
      return { ok: true, paneId }
    } catch (err) {
      return { ok: false, error: `couldn't start the agent (${err})` }
    }
  }

  // Post the dir-pick prompt for a pending /new session (recent dirs as buttons + free-text). The
  // session is already stored (awaiting-dir); this offers the choices and records the prompt id.
  const askNewDir = async (session: NewSession): Promise<void> => {
    const choices = gatherNewDirChoices()
    session.dirChoices = choices
    const out = replyContext(session.threadId)
    const extra: Record<string, unknown> =
      choices.length > 0 ? { ...out, reply_markup: { inline_keyboard: buildNewDirKeyboard(session.token, choices) } } : out
    const subject = session.bindThreadId !== undefined ? "New session for this topic" : `New agent \`${session.name}\``
    const prompt =
      choices.length > 0
        ? `${subject}. Pick a recent project below, or send an absolute path (e.g. /Users/you/project).`
        : `${subject}. Which directory should it work in? Send an absolute path (e.g. /Users/you/project).`
    session.promptMessageId = await sendMessage(ctx, prompt, extra)
  }

  // Post the harness-pick prompt for a pending /new session (one button per agent harness).
  const askNewHarness = async (session: NewSession): Promise<void> => {
    session.status = "awaiting-harness"
    session.ts = Math.floor(Date.now() / 1000)
    session.promptMessageId = await sendMessage(ctx, `Which harness should \`${session.name}\` use?`, {
      ...replyContext(session.threadId),
      reply_markup: { inline_keyboard: buildNewHarnessKeyboard(session.token) },
    })
  }

  // Post the model-pick prompt for a pending /new session (filtered to the chosen harness).
  const askNewModel = async (session: NewSession): Promise<void> => {
    session.status = "awaiting-model"
    session.ts = Math.floor(Date.now() / 1000)
    const catalog = session.harness ? modelsForHarness(session.harness) : MODEL_CATALOG
    const harnessName = session.harness ? `${harnessLabel(session.harness)} ` : ""
    session.promptMessageId = await sendMessage(ctx, `Which ${harnessName}model should \`${session.name}\` run?`, {
      ...replyContext(session.threadId),
      reply_markup: { inline_keyboard: buildNewModelKeyboard(session.token, catalog) },
    })
  }

  const advanceNewAfterDir = async (session: NewSession): Promise<boolean> => {
    // A ➕ New session (tg-cli#735) is named after its directory: the topic it came from has no
    // name of the CTO's choosing (Telegram names an implicit topic after the message's first words).
    if (session.bindThreadId !== undefined && session.dir) session.name = basename(session.dir)
    if (session.model && findModel(session.model)) return spawnNewSession(session, session.model, null)
    if (session.harness) await askNewModel(session)
    else await askNewHarness(session)
    return true
  }

  // After a spawn FAILURE, report the tmux error ONCE and offer a single "Retry spawn" button —
  // NEVER re-enter the questionnaire (the earlier bug: a failure fell back to re-asking the model,
  // so the user answered the same question in a loop while the real error scrolled away). The
  // session keeps name+dir+harness+model and moves to `awaiting-retry`; a tap re-runs the spawn with
  // those preserved answers. Clears the old prompt keyboard so no stale button lingers.
  const offerNewRetry = async (
    session: NewSession,
    errorText: string,
    oldPromptMessageId: number | null,
  ): Promise<boolean> => {
    if (oldPromptMessageId !== null) await clearMessageKeyboard(ctx, oldPromptMessageId)
    session.status = "awaiting-retry"
    session.ts = Math.floor(Date.now() / 1000)
    session.promptMessageId = await sendMessage(ctx, `${errorText}\n\nYour picks are kept — tap Retry to try again.`, {
      ...replyContext(session.threadId),
      reply_markup: { inline_keyboard: buildNewRetryKeyboard(session.token) },
    })
    return false
  }

  // Do the actual spawn for a session that has name + dir + model, then DELETE the session (the
  // agent is now a plain pane). On a spawn failure the session moves to `awaiting-retry` (all
  // answers preserved) and offers a Retry button — it never re-asks. Clears the prompt keyboard on
  // success so it can't be re-tapped.
  const spawnNewSession = async (session: NewSession, modelId: string, promptMessageId: number | null): Promise<boolean> => {
    const out = replyContext(session.threadId)
    if (!session.dir || !isAbsolute(session.dir) || !isExistingDirectory(session.dir)) {
      // The dir vanished between the prompt and now → back to awaiting-dir so the user re-picks.
      // Clear the stale MODEL keyboard first (review #6) so the user isn't left with two live sets.
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      session.status = "awaiting-dir"
      session.ts = Math.floor(Date.now() / 1000)
      await sendMessage(ctx, `\`${session.dir ?? "(none)"}\` is not an absolute existing directory — send a full path like /Users/you/project.`, out)
      await askNewDir(session)
      return false
    }
    const slug = slugifyTopicName(session.name, 0)
    if (session.bindThreadId !== undefined) return spawnIntoHeldTopic(session, session.bindThreadId, modelId, slug, promptMessageId)
    const spawnToken = `new-${session.token}-${Math.floor(Date.now() / 1000)}`
    // Private-chat topic: try to create a per-session topic BEFORE spawning so the window is born
    // with TG_TOPIC already set. Failure (capability/API error) → graceful flat fallback.
    const privateTopic = ctx.cfg.privateTopics ? await createPrivateTopic(sessionTopicTitle(session.name)) : null
    if (privateTopic?.kind === "topic") {
      return spawnNewSessionWithTopic(session, modelId, privateTopic.threadId, slug, promptMessageId)
    }
    if (privateTopic?.kind === "ask") {
      session.model = modelId
      session.ts = Math.floor(Date.now() / 1000)
      if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
      const fallbackPromptMessageId = await sendMessage(ctx, privateTopic.message, {
        ...out,
        reply_markup: { inline_keyboard: buildNewPrivateTopicFallbackKeyboard(session.token) },
      })
      if (fallbackPromptMessageId === null) {
        privateTopicFallbackState = "unknown"
        session.status = "awaiting-model"
        await askNewModel(session)
        return false
      }
      session.status = "awaiting-private-topic-fallback"
      session.promptMessageId = fallbackPromptMessageId
      return false
    }
    if (privateTopic?.kind === "fallback" && privateTopic.message) {
      await sendMessage(ctx, privateTopic.message, out)
    }
    if (privateTopic?.kind === "waiting") {
      await sendMessage(ctx, "private-topic fallback choice is already open — tap Continue without topics or Cancel this spawn.", out)
      return false
    }
    // Flat spawn path (no private topic, or createForumTopic failed gracefully).
    const spawned = spawnNewWindow(slug, session.dir, modelId, session.task, spawnToken)
    if (!spawned.ok) {
      // Spawn FAILED → report the error once and offer a Retry button (answers preserved), NEVER
      // re-ask the model. See offerNewRetry.
      return offerNewRetry(session, spawned.error, promptMessageId)
    }
    stampSpawnToken(spawned.paneId, spawnToken)
    pendingNew.delete(session.token)
    if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
    const taskNote = session.task.trim().length > 0 ? ` with task: ${session.task.trim()}` : ""
    await sendMessage(ctx, `spawned \`${modelId}\` in \`${session.dir}\` (window \`${slug}\`)${taskNote} — use \`/agent ${slug}\` to talk to it`, out)
    return true
  }

  // Private-chat topic spawn path: topic was created (threadId known), now spawn and bind. Extracted
  // from spawnNewSession to keep it under ~50 lines each. Handles the full lifecycle:
  //   - Write a spawnPending awaiting-model binding BEFORE `tmux new-window`, so a crash between a
  //     successful new-window and the `bound` write leaves a row startup reconcile can adopt.
  //   - On spawn FAILURE: drop that binding — the topic is unknown again, so a message there gets
  //     the attach picker (the Retry button re-runs this whole path).
  //   - On spawn SUCCESS: upgrade to a `bound` binding; call stampSpawnToken for log greppability.
  // Supergroup topic /new has no task tail, but private-chat flat /new can pass one through here.
  // `task` is the agent's initial prompt: the /new tail, or a ➕ New session's held text.
  const spawnNewSessionWithTopic = async (
    session: NewSession,
    modelId: string,
    threadId: number,
    slug: string,
    promptMessageId: number | null,
    task = session.task,
  ): Promise<boolean> => {
    const out = replyContext(session.threadId)
    const ts = Math.floor(Date.now() / 1000)
    // `harness` makes a later "not running" reply name this harness's resume command.
    const preliminary = { threadId, name: session.name, status: "awaiting-model" as const, path: session.dir, model: modelId, harness: findModel(modelId)?.kind, sourceChatId: session.sourceChatId, sourceMessageId: session.sourceMessageId, ts }
    const spawnToken = `${threadId}-${ts}-${nextSpawnNonce()}`
    updateTopics((topics) => appendTopic(topics, markSpawnPending(preliminary, spawnToken, ts)))
    const spawned = spawnTopicWindow(threadId, slug, session.dir, modelId, task)
    if (!spawned.ok) {
      updateTopics((topics) => removeTopic(topics, threadId))
      // Report the error once and offer a Retry button (answers preserved), never re-ask the model.
      return offerNewRetry(session, spawned.error, promptMessageId)
    }
    // Upgrade the preliminary binding to `bound` now that the pane exists. Do not persist a
    // spawnPending record with paneId: a crash between that write and markBound would leave a
    // contradictory durable state.
    stampSpawnToken(spawned.paneId, spawnToken)
    const boundTs = Math.floor(Date.now() / 1000)
    updateTopics((topics) => appendTopic(topics, markBound(preliminary, spawned.paneId, boundTs)))
    pendingNew.delete(session.token)
    if (promptMessageId !== null) await clearMessageKeyboard(ctx, promptMessageId)
    const taskNote = session.task.trim().length > 0 ? ` with task: ${session.task.trim()}` : ""
    await sendMessage(ctx, `spawned \`${modelId}\` in \`${session.dir}\` (window \`${slug}\`)${taskNote} — use \`/agent ${slug}\` to talk to it`, out)
    return true
  }

  // A `/new [<harness>|<model>] [<dir>] name [<task>]` command → start (or short-circuit) the
  // flow. With a name+dir+model all supplied the agent spawns immediately; otherwise the missing
  // piece is asked via buttons. A name collision with a live window is a non-fatal WARNING (tmux
  // allows dup names).
  const handleNewCommand = async (action: Extract<Action, { kind: "new-command" }>): Promise<boolean> => {
    reapNewSessions()
    // A crash mid-spawn leaves this `/new` in the pending-batch journal and the restarted daemon
    // replays it — AFTER startup reconcile already adopted (or can adopt) the orphan its first run
    // spawned. A private-topic binding carrying this chat + message id proves the first run got as
    // far as creating the topic, so re-running would create a second topic + a second agent. (The
    // flat fallback spawn writes no binding, so it has no such guard — #500.) The first run may
    // have died before its "spawned …" reply, so the skip is acknowledged.
    const out = replyContext(action.threadId)
    const alreadyCreated = findTopicCreatedBy(loadTopics(), action.chatId, action.messageId)
    if (alreadyCreated) {
      log(`new-command: message ${action.chatId}/${action.messageId} already created topic ${alreadyCreated.threadId} (${alreadyCreated.status}) before a restart — replayed /new not re-run`)
      const state = alreadyCreated.status === "bound"
        ? `its agent is running there — use \`/agent ${alreadyCreated.name}\` to talk to it`
        : `topic state \`${alreadyCreated.status}\`, not created again`
      await sendMessage(ctx, `recovered after a daemon restart: \`/new ${alreadyCreated.name}\` already opened its topic; ${state}`, out)
      return true
    }
    if (!action.name) {
      await sendMessage(ctx, "usage: /new [<harness>|<model>] [<dir>] <name> [<task>] — e.g. `/new codex /Users/you/app api fix the build`", out)
      return false
    }
    if (privateTopicFallbackState === "pending") {
      const hasPendingFallback = [...pendingNew.values()].some((s) => s.status === "awaiting-private-topic-fallback")
      if (hasPendingFallback) {
        await sendMessage(ctx, "private-topic fallback choice is already open — tap Continue without topics or Cancel this spawn.", out)
        return false
      }
      privateTopicFallbackState = "unknown"
    }
    // Name-uniqueness WARNING (issue #27): warn if the resulting window slug collides, don't block.
    const slug = slugifyTopicName(action.name, 0)
    if (nameCollides(slug, liveWindowNames())) {
      await sendMessage(ctx, `⚠️ a window named \`${slug}\` already exists — the new agent will share the name. Continuing.`, out)
    }
    // A flat chat has at most ONE /new in flight (review #2): a second /new normally REPLACES any
    // prior pending session, so a typed path can never be mis-applied to a stale earlier session.
    // Exception: an open private-topic fallback confirmation is a live user decision, so it blocks
    // replacement until Continue/Cancel or expiry (handled above).
    pendingNew.clear()
    // Validate a supplied dir up front; an invalid one is dropped (→ asked) rather than failing.
    let dir = action.dir
    let task = action.task
    if (dir && (!isAbsolute(dir) || !isExistingDirectory(dir))) {
      if (action.dirAfterName && isLikelySlashCommand(dir)) {
        // A COMMAND-SHAPED inline token after the name (`/compact`, `/clear`) is a
        // harness passthrough, not a dir (codex #187). Preserve it at the FRONT of
        // the task instead of dropping it, then ask for a dir normally. A
        // multi-component path that merely doesn't exist (`/does/not/exist`) is a
        // genuine dir typo, NOT command-shaped → it still errors + drops below,
        // mirroring the typed-path flow (handleNewAnswer) which gates on the same
        // isLikelySlashCommand. (A dir BEFORE the name is always a dir attempt —
        // dirAfterName is false there — so it errors too.)
        task = task ? `${dir} ${task}` : dir
        dir = null
      } else {
        await sendMessage(ctx, `\`${dir}\` is not an absolute existing directory — pick one below or send a full path.`, out)
        dir = null
      }
    }
    const token = `n${++newTokenSeq}`
    const modelEntry = action.model ? findModel(action.model) : null
    const session: NewSession = {
      token,
      name: action.name,
      status: "awaiting-dir",
      task,
      ts: Math.floor(Date.now() / 1000),
      threadId: action.threadId ?? null,
      sourceChatId: action.chatId,
      sourceMessageId: action.messageId,
      ...(dir ? { dir } : {}),
      ...(action.harness ? { harness: action.harness } : {}),
    }
    if (modelEntry) {
      session.model = modelEntry.id
      session.harness = modelEntry.kind
    }
    pendingNew.set(token, session)
    // Model already supplied AND dir resolved → spawn straight away (no buttons).
    if (dir && session.model) return spawnNewSession(session, session.model, null)
    // Model supplied but dir missing → ask dir; we'll spawn with the supplied model once dir lands.
    if (dir) return advanceNewAfterDir(session)
    else await askNewDir(session)
    return true
  }

  // A typed path answer to an awaiting-dir /new session. Matches the SINGLE awaiting-dir session
  // (a flat chat has at most one /new in flight). Validates the abs path, then advances: if a model
  // was already supplied on the command line, spawn now; else ask the model.
  // `bindThreadId`: the topic a ➕ New session answer was typed in — it answers that topic's flow
  // only; a flat answer (undefined) answers only a flat /new. Neither picks the other's prompt, even
  // when a tap elsewhere replaced the pending /new between triage and here.
  const handleNewAnswer = async (action: Extract<Action, { kind: "new-answer" }>, bindThreadId?: number): Promise<boolean> => {
    reapNewSessions()
    // The NEWEST awaiting-dir session owns the typed path (review #2): even though handleNewCommand
    // clears prior sessions on a fresh /new, take the newest as a belt-and-suspenders so the path
    // always lands on the prompt the user is actually answering.
    const session = [...pendingNew.values()]
      .filter((s) => s.status === "awaiting-dir" && s.bindThreadId === bindThreadId)
      .sort((a, b) => b.ts - a.ts)[0]
    if (!session) return false // no /new awaiting a dir — defensive (stepUpdates only emits when one is)
    const out = replyContext(session.threadId)
    const path = action.text.trim()
    // Reject the filesystem ROOT as a typed cwd (review #4): the dir BUTTONS already exclude `/`
    // (parentDirs stops above root — spawning an agent at `/` is never the intent), so mirror that
    // guard for a typed `/` instead of letting it slip past `isExistingDirectory('/')`.
    if (path === "/") {
      await sendMessage(ctx, "the filesystem root `/` isn't a project directory — send a real project path like /Users/you/project.", out)
      return false
    }
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      // The text isn't a usable directory. A BARE `/word` (isLikelySlashCommand) is most likely a
      // HARNESS passthrough command — `/compact`, `/clear` — meant for the live 1:1 agent, NOT a
      // path attempt (review #1, second pass): so inject it through instead of erroring, preserving
      // 1:1 passthrough even mid-/new. The session stays awaiting-dir (the user can still answer the
      // dir prompt). A `/path/with/slashes` that doesn't exist IS a genuine bad-path attempt → the
      // dir error. An empty / non-slash answer (the stepUpdates gate only emits slash text, but be
      // defensive) also re-asks.
      // A ➕ New session's topic has no agent to pass a command to: the bare word is a bad path there.
      if (path.startsWith("/") && isLikelySlashCommand(path) && session.bindThreadId === undefined) {
        // A harness control-command passthrough (/compact, /clear), not new content — no
        // git-state banner (see withGitStateBanner's scope note).
        return injectViaTarget((target) => buildTextInjectPlan(target.pane.paneId, path), path, true, action.messageId)
      }
      await sendMessage(ctx, `\`${path || "(empty)"}\` is not an absolute path to an existing directory — send a full path like /Users/you/project.`, out)
      return false
    }
    session.dir = path
    session.ts = Math.floor(Date.now() / 1000)
    if (session.promptMessageId != null) await clearMessageKeyboard(ctx, session.promptMessageId)
    // If a model was supplied on the /new line, spawn immediately; else ask harness/model.
    return advanceNewAfterDir(session)
  }

  // A recent-dir button tap (tnp:<token>:<index>) → resolve the index against the session's
  // dirChoices and advance like a typed path. A stale/forged tap (no session, wrong state, bad
  // index, vanished dir) re-asks rather than spawning into a guessed dir.
  const handleNewDir = async (action: Extract<Action, { kind: "new-dir" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session || session.status !== "awaiting-dir") {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that menu expired — send a directory")
      return false
    }
    const path = session.dirChoices?.[action.index]
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "that path is gone — send one")
      await sendMessage(ctx, `\`${path ?? "(unknown)"}\` is no longer an existing directory — send an absolute path.`, replyContext(session.threadId))
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "ok")
    session.dir = path
    session.ts = Math.floor(Date.now() / 1000)
    if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
    return advanceNewAfterDir(session)
  }

  // A harness button tap (tnh:<token>:<harness>) → ask the model picker for that harness only.
  const handleNewHarness = async (action: Extract<Action, { kind: "new-harness" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (session.status !== "awaiting-harness" || !session.dir) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "pick a directory first")
      return false
    }
    const catalog = modelsForHarness(action.harness)
    if (catalog.length === 0) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "no models")
      await sendMessage(ctx, `no models configured for \`${harnessLabel(action.harness)}\``, replyContext(session.threadId))
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "ok")
    session.harness = action.harness
    session.ts = Math.floor(Date.now() / 1000)
    if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
    await askNewModel(session)
    return true
  }

  // A model button tap (tnm:<token>:<modelId>) → spawn the agent with that model. Refuses an
  // unknown model id (stale/forged callback) and an out-of-state session (already spawned / gone).
  const handleNewModel = async (action: Extract<Action, { kind: "new-model" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (session.status !== "awaiting-model" || !session.dir) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "send a directory first")
      return false
    }
    const modelEntry = findModel(action.modelId)
    if (!modelEntry) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "unknown model")
      await sendMessage(ctx, `unknown model \`${action.modelId}\` — pick a model again`, replyContext(session.threadId))
      return false
    }
    if (session.harness && modelEntry.kind !== session.harness) {
      await answerCallbackQuery(ctx, action.callbackQueryId, `pick a ${harnessLabel(session.harness)} model`)
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "starting…")
    session.model = action.modelId
    session.harness = modelEntry.kind
    return spawnNewSession(session, action.modelId, action.messageId)
  }

  // A "Retry spawn" tap (tnr:<token>) after a spawn failure → re-run the spawn with the session's
  // preserved name/dir/harness/model. Refuses a stale/forged tap (no session, wrong state, or a
  // model that vanished from the catalog). NEVER re-asks — the whole point of the retry button.
  const handleNewRetry = async (action: Extract<Action, { kind: "new-retry" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (session.status !== "awaiting-retry" || !session.model || !findModel(session.model)) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "nothing to retry — run /new again")
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "retrying…")
    return spawnNewSession(session, session.model, action.messageId)
  }

  const handleNewPrivateTopicFallback = async (action: Extract<Action, { kind: "new-private-topic-fallback" }>): Promise<boolean> => {
    reapNewSessions()
    const session = pendingNew.get(action.token)
    if (!session || session.status !== "awaiting-private-topic-fallback" || !session.dir || !session.model) {
      // A stale/reaped token must NOT clobber a DIFFERENT session's live pending fallback
      // decision -- only fall back to "unknown" when nothing is actually awaiting an answer
      // (mirrors the `hasPendingFallback` guard in handleNewCommand, tg-cli#181).
      if (privateTopicFallbackState === "pending") {
        const hasPendingFallback = [...pendingNew.values()].some((s) => s.status === "awaiting-private-topic-fallback")
        if (!hasPendingFallback) privateTopicFallbackState = "unknown"
      }
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
      return false
    }
    if (action.choice === NEW_PRIVATE_TOPIC_FALLBACK_CANCEL) {
      privateTopicFallbackState = "unknown"
      pendingNew.delete(action.token)
      await answerCallbackQuery(ctx, action.callbackQueryId, "cancelled")
      if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
      await sendMessage(ctx, "cancelled — no agent was spawned", replyContext(session.threadId))
      return false
    }
    if (action.choice === NEW_PRIVATE_TOPIC_FALLBACK_CONTINUE) {
      privateTopicFallbackState = "accepted"
      await answerCallbackQuery(ctx, action.callbackQueryId, "starting without topics…")
      if (action.messageId !== null) await clearMessageKeyboard(ctx, action.messageId)
      return spawnNewSession(session, session.model, action.messageId)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "expired — run /new again")
    return false
  }

  // --- crash-window orphan reconcile ---
  // CRASH GAP: a flat /new private-topic spawn persists awaiting-model → `tmux new-window` →
  // persists `bound`. A daemon crash BETWEEN a successful new-window and the `bound` write leaves
  // a LIVE orphan pane plus an `awaiting-model` binding. On startup, reconcile each non-bound
  // binding against the live tmux windows by SLUG: if the topic-slug window already hosts the
  // spawned agent, RE-BIND that pane (adopt the orphan); also mark any `bound` binding whose
  // session is gone as `closed` (it exited while the daemon was down), so the next message in
  // that topic gets the "not running" reply instead of injecting into nothing.
  // Runs ONCE at startup when either public forum topics or private-chat topics use the TopicBinding
  // store, fully guarded (never aborts startup).
  const reconcileTopicsOnStartup = (): void => {
    if (!ctx.cfg.topics && !ctx.cfg.privateTopics) return
    try {
      const topics = loadTopics()
      if (topics.length === 0) return
      const { panes, procs } = snapshot()
      // An empty/flaky snapshot (the known launchd no-locale read) must NOT trigger reconciliation:
      // it would mass-close every live binding. Skip when no panes are visible.
      if (panes.length === 0) return
      const liveAgentPanes = panes.filter((p) => findAgentInPane(p, procs) !== null)
      // SECOND flake guard: a non-empty `panes` but ZERO live-agent panes most likely means the
      // `procs` (ps) read flaked (panesWithRetry resilience is per-source). Closing every `bound`
      // binding off that empty procs read would falsely kill live topics. So when we have bound
      // bindings to reconcile yet found NO agent anywhere, treat it as a flaky read and skip — a
      // genuinely all-dead fleet self-heals on the next message (handleTopicRoute re-probes per pane).
      const hasBound = topics.some((t) => t.status === "bound")
      if (liveAgentPanes.length === 0 && hasBound) return
      const ts = Math.floor(Date.now() / 1000)
      // Panes a `bound` binding LEGITIMATELY holds — never adopt one for an orphan. Mutated as we
      // adopt (a pane adopted by one binding can't ALSO be adopted by a slug-colliding sibling).
      const claimed = legitimatelyClaimedPanes(topics, liveAgentPanes)
      let changed = false
      const reconciled = topics.map((binding) => {
        const next = reconcileOneTopic(binding, liveAgentPanes, claimed, ts)
        if (next !== binding) {
          changed = true
          if (next.status === "bound" && next.paneId) claimed.add(next.paneId) // reserve the adopted pane
        }
        return next
      })
      if (changed) persistTopics(reconciled)
    } catch (err) {
      log(`reconcileTopicsOnStartup failed: ${err}`)
    }
  }

  // getFile → /file/ download into ~/.cache/tg-cli/inbound under the daemon-
  // chosen name (never the Telegram basename, spec §5.2). Returns the local path
  // or null (already logged + replied). Shared by media + voice download. The
  // WHOLE body is exception-guarded: a getFile timeout, a non-JSON body, a
  // download read error or a disk-write failure THROWS otherwise, and since the
  // poll loop persists the offset BEFORE acting, an uncaught throw loses the note
  // permanently with no reply. Catch → "media download failed" → null.
  const downloadFileToCache = async (
    fileId: string,
    suggestedName: string,
    out: Record<string, unknown> = {},
  ): Promise<string | null> => {
    // Log each retry of a network step with its label, the file id, and the
    // attempt count — shared by both steps so the message format stays in sync.
    const retryLog = (step: string) => (i: RetryInfo) =>
      log(`${step} retry ${i.attempt}/${i.maxAttempts} for ${fileId} in ${i.delayMs}ms`)
    try {
      // BOTH network steps run under bounded retry-with-backoff (default 3
      // attempts, ~300ms→900ms→2.7s jittered) so a single transient blip —
      // dropped connection, 5xx, timeout — no longer silently loses the inbound
      // note. Worst case wall time per step ≈ maxAttempts·timeout + backoffs
      // (getFile ~30s/try, file bytes ~120s/try). retryFetch only retries a
      // thrown error / non-2xx HTTP; a 200-with-{ok:false} getFile body is a
      // PERMANENT Telegram error (e.g. file gone) and is handled below, not
      // retried — same for a final non-2xx from either step, which is returned
      // for the local `!resp.ok` checks rather than thrown.
      const getFile = () =>
        fetch(`${api(ctx)}/getFile?file_id=${encodeURIComponent(fileId)}`, {
          signal: AbortSignal.timeout(30_000),
        })
      const fileResp = await retryFetch(getFile, { onRetry: retryLog("getFile") })
      const fileJson = (await fileResp.json()) as { ok: boolean; result?: { file_path?: string } }
      const remotePath = fileJson.ok ? fileJson.result?.file_path : undefined
      if (!remotePath) {
        log(`getFile failed for ${fileId}`)
        await sendMessage(ctx, "media download failed", out)
        return null
      }
      const fetchBytes = () =>
        fetch(`${ctx.apiBase}/file/bot${ctx.token}/${remotePath}`, {
          signal: AbortSignal.timeout(120_000),
        })
      const dataResp = await retryFetch(fetchBytes, { onRetry: retryLog("file download") })
      if (!dataResp.ok) {
        log(`file download failed: HTTP ${dataResp.status} for ${fileId} after retries`)
        await sendMessage(ctx, "media download failed", out)
        return null
      }
      const dir = join(ctx.home, ".cache", "tg-cli", "inbound")
      mkdirSync(dir, { recursive: true })
      const dest = join(dir, suggestedName)
      writeFileSync(dest, new Uint8Array(await dataResp.arrayBuffer()))
      return dest
    } catch (err) {
      log(`media download error for ${fileId}: ${err}`)
      await sendMessage(ctx, "media download failed", out)
      return null
    }
  }

  // The agent-facing receipt for a downloaded photo/file: its local path plus the caption.
  // Shared by the flat media path and topic delivery so both read the same.
  const mediaReceipt = (mediaKind: "photo" | "document", dest: string, caption: string | undefined): string =>
    `sent ${mediaKind === "photo" ? "photo" : "file"}: ${dest}` + (caption ? `\n${caption}` : "")

  const downloadMedia = async (action: Extract<Action, { kind: "download-media" }>): Promise<boolean> => {
    const dest = await downloadFileToCache(action.fileId, action.suggestedName)
    if (dest === null) return false
    const routedCaption = action.agentRoute ? action.agentRoute.rest : action.caption
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, mediaReceipt(action.mediaKind, dest, routedCaption), action.messageId)
    if (action.agentRoute) {
      return routePrewrappedAgentMessage(action.agentRoute, wrapped, action.messageId)
    }
    if (action.replyToMessageId !== undefined) {
      const injectText = `${action.replyAnchor ?? ""}\n${wrapped}`.replace(/^\n/, "")
      return handleReplyRoute({
        kind: "reply-route",
        replyToMessageId: action.replyToMessageId,
        injectText,
        from: action.from,
        messageId: action.messageId,
      })
    }
    if (selectedAgentRoute) {
      const selectedResult = await injectIntoSelectedAgent(wrapped, action.messageId)
      if (selectedResult !== null) return selectedResult
    }
    // A non-reply photo/file → auto-bind to the last-active agent like a text msg, with the
    // git-state-check banner (withGitStateBanner) prepended when that pane is mid-flight.
    return injectViaTarget(
      (target) => buildTextInjectPlan(target.pane.paneId, withGitStateBanner(target.pane.panePath, wrapped)),
      wrapped,
      true,
      action.messageId,
    )
  }

  // Download + transcribe one voice note and post the STT confirmation. Returns the non-empty
  // transcript, or null once the failure (or the onboarding walk-through) has been answered —
  // except for the documented `voice.enabled: false` opt-out, which is only logged. Shared by the
  // flat voice path and topic delivery; `out` threads every reply into the source topic.
  const transcribeVoiceNote = async (
    fileId: string,
    suggestedName: string,
    messageId: number,
    out: Record<string, unknown> = {},
  ): Promise<string | null> => {
    // Reload the voice config from disk EVERY note: a `tg voice setup` run while
    // this daemon was already up must take effect without a restart. The parsed
    // PARTIAL is kept too, to tell "explicitly disabled" from "not configured".
    const rawYaml = readFileOrNull(join(ctx.configDir, "config.yaml")) ?? ""
    const voicePartial = parseVoiceConfig(rawYaml)
    ctx.voice = resolveVoiceConfig(voicePartial)

    // Master switch: an explicit `voice.enabled: false` means OFF — drop the
    // note silently (no onboarding, no re-enable). The documented opt-out must
    // survive a discoverable Whisper still being on the box.
    if (voicePartial.enabled === false) {
      log("voice note ignored — voice.enabled: false")
      return null
    }

    if (!voiceReady(ctx)) {
      // Not yet configured → auto-onboarding reply. No ack (the reply IS the
      // signal); the caller returns false, marking the action unhandled for the ack gate.
      const verdict = decideOnboarding(probeWhisper(ctx.home), ctx.voice.language)
      if (verdict.kind === "ready") {
        // We discovered a working install on the fly — persist it so the NEXT
        // voice note transcribes without re-prompting. But only CLAIM success if
        // the write actually landed: a read-only config.yaml would otherwise tell
        // the user "configured" while the next note loops back to onboarding.
        if (persistVoiceConfigToDir(ctx.configDir, verdict.cfg)) {
          ctx.voice = verdict.cfg
          await sendMessage(ctx, onboardingMessage(verdict), out)
        } else {
          await sendMessage(
            ctx,
            `🎙️ Found a local Whisper (${verdict.cfg.runner}, ${verdict.cfg.modelPath}) but could not save ` +
              `the config. Fix write permissions on ${join(ctx.configDir, "config.yaml")} and resend, or run \`tg voice setup\`.`,
            out,
          )
        }
      } else {
        await sendMessage(ctx, onboardingMessage(verdict), out)
      }
      return null
    }

    const dest = await downloadFileToCache(fileId, suggestedName, out)
    if (dest === null) return null

    const text = await runTranscription(ctx, dest)
    if (text === null) {
      await sendMessage(ctx, "voice transcription failed — see daemon log", out)
      return null
    }
    if (text.trim() === "") {
      await sendMessage(ctx, "voice note had no recognizable speech", out)
      return null
    }

    // This is an STT confirmation only, not a delivery receipt. Routing below may
    // still produce a separate no-agent / picker / inject-failed signal.
    await sendMessage(ctx, formatVoiceConfirmation(text), { ...out, reply_to_message_id: messageId })
    return text
  }

  // Voice note → text (inbound STT). Unconfigured? Walk the user through setup
  // instead of dropping it (the CTO's "если не настроено — бот проводит через
  // настройку"). Otherwise: download OGG → ffmpeg WAV 16k mono → local Whisper →
  // clean → route EXACTLY like a typed message (reply-route when it was a reply,
  // else inject into the discovered pane). The 👀 ack still fires via the step's
  // trailing ack action when this returns true.
  const transcribeVoice = async (action: Extract<Action, { kind: "transcribe-voice" }>): Promise<boolean> => {
    const text = await transcribeVoiceNote(action.fileId, action.suggestedName, action.messageId)
    if (text === null) return false

    // Route exactly like a typed message, but present the transcript as a 🎤-marked
    // quote (formatVoiceTranscript) so the agent can tell it's transcribed speech, not
    // typed text: a reply note carries the quote anchor and goes through the SAME
    // reply-route path; a standalone note injects into the discovered pane.
    const quoted = formatVoiceTranscript(text)
    if (action.replyToMessageId !== undefined) {
      const injectText = `${action.replyAnchor ?? ""}\n${wrapInbound(
        ctx.cfg.injectWrap,
        action.from,
        quoted,
        action.messageId,
      )}`.replace(/^\n/, "")
      return handleReplyRoute(
        {
          kind: "reply-route",
          replyToMessageId: action.replyToMessageId,
          injectText,
          from: action.from,
          messageId: action.messageId,
        },
        action.replyToMessageId,
      )
    }
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, quoted, action.messageId)
    if (selectedAgentRoute) {
      const selectedResult = await injectIntoSelectedAgent(wrapped, action.messageId)
      if (selectedResult !== null) return selectedResult
    }
    // A non-reply voice note → auto-bind to the last-active agent like a text msg, with the
    // git-state-check banner (withGitStateBanner) prepended when that pane is mid-flight.
    return injectViaTarget(
      (target) => buildTextInjectPlan(target.pane.paneId, withGitStateBanner(target.pane.panePath, wrapped)),
      wrapped,
      true,
      action.messageId,
    )
  }

  // Best-effort delivery receipt (spec §10): 👀 on the source message. A
  // failed reaction is logged and otherwise ignored — receipts must never
  // break the poll loop (e.g. a Bot API fake without the endpoint).
  const postReaction = async (messageId: number, reaction: Array<{ type: "emoji"; emoji: string }>): Promise<void> => {
    try {
      const resp = await fetch(`${api(ctx)}/setMessageReaction`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ chat_id: ctx.chatId, message_id: messageId, reaction }),
        signal: AbortSignal.timeout(15_000),
      })
      if (!resp.ok) log(`setMessageReaction failed: ${resp.status}`)
    } catch (err) {
      log(`setMessageReaction failed: ${err}`)
    }
  }
  const setReaction = (messageId: number, emoji: string): Promise<void> => postReaction(messageId, [{ type: "emoji", emoji }])
  // An empty list removes the bot's reaction.
  const clearReaction = (messageId: number): Promise<void> => postReaction(messageId, [])
  const setSeenReaction = (messageId: number): Promise<void> => setReaction(messageId, "👀")
  const setSeenReactions = async (
    primaryMessageId: number | null,
    relatedMessageId: number | null | undefined,
  ): Promise<void> => {
    // setReaction is best-effort and already catches/logs Bot API failures.
    const ids = Array.from(new Set([primaryMessageId, relatedMessageId].filter((id): id is number => typeof id === "number")))
    for (const id of ids) await setSeenReaction(id)
  }
  // ⏳ is NOT in Telegram's allowed reaction set; ✍️ ("noted, queued") is the
  // closest allowed emoji for "deferred behind the agent's open question".
  const DEFER_REACTION = "✍️"
  // The delivery receipt for one source message: a reaction a handler queued for it (✍️ while it
  // waits) wins; otherwise 👀 when its delivery succeeded.
  const settleAckReaction = async (messageId: number, delivered: boolean): Promise<void> => {
    const queuedReaction = takeAckReaction(messageId)
    if (queuedReaction) {
      if (!queuedReaction.shouldSend || queuedReaction.shouldSend()) await setReaction(messageId, queuedReaction.emoji)
    } else if (delivered) {
      await setSeenReaction(messageId)
    }
  }

  // --- auto-continue schedules (#113) — durable, re-armed on restart ---
  // A button tap arms a setTimeout to inject "continue" into the stalled pane at
  // reset time. The schedule is persisted so a daemon restart between the tap and
  // the reset re-arms it (a past reset fires immediately). One pending continue
  // per pane; on fire we inject, flip the card's reaction back to 👀, and drop it.
  let scheduleStore: ScheduleStoreData = parseSchedules(readFileOrNull(ctx.paths.schedules), Date.now())
  const continueTimers = new Map<string, ReturnType<typeof setTimeout>>()
  const persistSchedules = (): void => {
    try {
      atomicWrite(ctx.paths.schedules, serializeSchedules(scheduleStore, Date.now()))
    } catch (err) {
      log(`persistSchedules failed: ${err}`)
    }
  }

  // --- tg-awareness-nudge (tg-cli#363) — durable per-agent silence-nudge state ---
  // Mirrors scheduleStore's own load/persist shape exactly (parse-on-load,
  // atomic-write-on-mutation, best-effort — a corrupt/unwritable file degrades
  // to "no nudges yet remembered", never breaks the poll loop).
  let awarenessNudgeStore: AwarenessNudgeStore = parseAwarenessNudgeStore(readFileOrNull(ctx.paths.awarenessNudge))
  const persistAwarenessNudge = (): void => {
    try {
      atomicWrite(ctx.paths.awarenessNudge, serializeAwarenessNudgeStore(awarenessNudgeStore))
    } catch (err) {
      log(`persistAwarenessNudge failed: ${err}`)
    }
  }

  const fireAutoContinue = async (s: AutoContinueSchedule): Promise<void> => {
    // A reset > ~24.8 days out is clamped to MAX_TIMER_MS, so the timer can wake
    // BEFORE the real reset — re-arm instead of injecting early.
    if (Date.now() < s.resetAt) {
      armAutoContinue(s)
      return
    }
    continueTimers.delete(s.paneId)
    scheduleStore = removeSchedule(scheduleStore, s.paneId)
    persistSchedules()
    // A tmux restart recycles pane ids — %N may now host a DIFFERENT agent (or a
    // bare shell). If we knew the agent at arm time, refuse to inject "continue"
    // into a pane that no longer maps to it (executeInjectSteps only checks that
    // SOME agent is there, not WHICH). Skip quietly rather than poke the wrong one.
    if (s.agent) {
      const live = listAgentCandidates().find((c) => c.paneId === s.paneId)
      if (!live || (live.windowName && live.windowName !== s.agent)) {
        log(`auto-continue skipped: ${s.paneId} no longer hosts ${s.agent}`)
        return
      }
    }
    // Clear the card's button first so a stale card can't re-arm a second inject.
    if (s.cardMessageId !== null) await clearMessageKeyboard(ctx, s.cardMessageId)
    const res = await executeInjectSteps(buildTextInjectPlan(s.paneId, "continue"))
    if (!res.ok) {
      log(`auto-continue inject failed for ${s.paneId}: ${res.error}`)
      // Typed but still in the input box (#463): the CTO armed this — tell him.
      if (res.unsubmitted) {
        await sendMessage(ctx, res.error, s.sourceMessageId === null ? {} : { reply_parameters: { message_id: s.sourceMessageId, allow_sending_without_reply: true } })
      }
      // The agent did not resume: the source keeps its 😴, never a false 👀.
      return
    }
    log(`auto-continue fired for ${s.paneId} (agent=${s.agent})`)
    // Resume: flip the ORIGINAL inbound message (😴 → 👀), not the bot's card.
    if (s.sourceMessageId !== null) await setMessageReaction(ctx, s.sourceMessageId, reactionForStage("working"))
  }
  const armAutoContinue = (s: AutoContinueSchedule): void => {
    const existing = continueTimers.get(s.paneId)
    if (existing) clearTimeout(existing)
    const timer = setTimeout(() => void fireAutoContinue(s), autoContinueDelayMs(s.resetAt, Date.now()))
    continueTimers.set(s.paneId, timer)
  }
  const handleLimitContinue = async (action: Extract<Action, { kind: "limit-continue" }>): Promise<boolean> => {
    // Reject a stale FIRST-TIME tap before arming (PR #120 review): an inline
    // keyboard tapped long after its reset would otherwise upsert + arm with
    // autoContinueDelayMs() clamped to 0, injecting "continue" INSTANTLY into
    // whatever now occupies that pane id — possibly a different session. A
    // restart re-arm already drops resets this old via the schedule store's
    // own prune(); apply the identical threshold here so a first-time tap
    // (which never goes through prune) can't bypass it.
    if (isDeadReset(action.resetAt, Date.now())) {
      log(`limit-continue rejected: stale resetAt for ${action.paneId} (reset=${action.resetAt})`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "This auto-continue has expired — continue manually.")
      return true
    }
    // The agent name isn't in the callback_data — recover it from the live pane.
    const agent = listAgentCandidates().find((c) => c.paneId === action.paneId)?.windowName ?? ""
    const schedule: AutoContinueSchedule = {
      paneId: action.paneId,
      resetAt: action.resetAt,
      agent,
      // The ORIGINAL inbound message (from the callback_data) is the reaction
      // target; action.messageId is the bot's card, whose button we clear on fire.
      sourceMessageId: action.sourceMessageId,
      cardMessageId: action.messageId,
      armedAt: Date.now(),
    }
    scheduleStore = upsertSchedule(scheduleStore, schedule)
    persistSchedules()
    armAutoContinue(schedule)
    await answerCallbackQuery(ctx, action.callbackQueryId, `auto-continue armed for ${formatClock(action.resetAt)}`)
    return true
  }
  // Re-arm any schedule that survived a restart (fires now if its reset passed).
  for (const s of scheduleStore.schedules) armAutoContinue(s)

  // Late-delivery (this PR — the CTO's "I pressed a button but it didn't reach the
  // harness" bug): a Telegram tap arrived for a SCOPED question whose hook socket
  // already CLOSED (its 120s window elapsed → terminal fallback, OR a daemon restart
  // restored it from disk). The agent is no longer blocked on the socket, but the
  // chosen option can still reach the pane it asked from — inject it like any inbound
  // reply (the established voice/text-reply path). Record the answer so a hook that
  // reconnects with the SAME requestId replays it instead of re-forwarding, then drop
  // the retained entry. Returns false when there is nothing to late-deliver (no
  // retained entry, or the tap doesn't resolve to an option), so the caller falls
  // back to the expired/already-answered toast.
  // Grant protocol v1.1 (tg-cli#398): a late tap on an EXPIRED hatch card. This
  // REPLACES the old silent queuedDecision mechanism for hatch requests, which
  // authorized ANY later operation behind the same hookId. A late Approve inside
  // the 24h grace window mints a single-use grant (bound to hook_id + operation
  // fingerprint + cwd + the daemon-observed route), confirms on the card, and
  // routes the contract's consume-instructions message to the origin (omp ACP /
  // inbox — never a live permission menu, the exact no-menu skip this fixes); a
  // tap beyond grace is told it is too late (the agent must re-request) and
  // mints NOTHING. A belated Deny is final: it retires the grace record, revokes
  // an unconsumed grant an earlier Approve minted, and routes a deny notice to
  // the same origin (tg-cli#433, #403). `expiredAt` is the ask's
  // expiry moment (the grace anchor): the card's grace record's `expiredAt` whenever it
  // has one — a restored pending ask's retained `at` is its posting time, not its expiry
  // (tg-cli#510) — else the retained entry's `at`.
  const handleHatchLateTap = async (
    action: Extract<Action, { kind: "answer-question" }>,
    req: ButtonRequest,
    cardId: number | null,
    answer: ButtonAnswer,
    expiredAt: number,
  ): Promise<boolean> => {
    const now = Date.now()
    if (answer.decision === "deny") {
      // A Deny is FINAL (tg-cli#433): retire the grace record so no later tap on this
      // card — a raced or duplicate Approve, a text reply — can mint, record the card as
      // decided so a restart that still finds it in the best-effort questions store does
      // not re-open it, and revoke a grant an earlier Approve minted that the agent has
      // not consumed yet. Durable BEFORE the denial is confirmed (the mint's fail-closed
      // rule): a lost write rolls back and asks for another tap.
      const grant = grantsData.grants.find((g) => g.request_id === req.requestId) ?? null
      if (grant && grant.consumed_at !== null) {
        log(`hatch-late-deny-too-late: ${describeAskRequest(req)} key=${action.requestId} approvalId=${grant.approval_id} — grant already used`)
        // Nothing a tap does on this card can change any more: retire its buttons.
        if (cardId !== null) void clearMessageKeyboard(ctx, cardId)
        await answerCallbackQueryOrNotify(ctx, action, `too late to deny — grant ${grant.approval_id} was already used`)
        return true
      }
      const grantIndex = grant ? grantsData.grants.indexOf(grant) : -1
      if (grant) grantsData.grants.splice(grantIndex, 1)
      const undoClose = closeDecidedCard(grantsData, action.requestId, "deny", now, decidedRetainMs(req))
      if (!persistGrants()) {
        undoClose()
        if (grant) grantsData.grants.splice(grantIndex, 0, grant)
        log(`hatch-late-deny-failed: ${describeAskRequest(req)} key=${action.requestId} — grant store write failed`)
        await answerCallbackQueryOrNotify(ctx, action, "could not record the denial — tap again")
        return true
      }
      const revoked = grant?.approval_id ?? null
      if (cardId !== null) {
        const label = revoked ? `${answer.label} — grant ${revoked} revoked` : answer.label
        void editMessageText(ctx, cardId, buildAnsweredQuestionText(req, label), undefined, hatchParseMode(req))
      }
      // Proactive delivery (tg-cli#403 (d)): the requester learns the outcome instead
      // of waiting. Past the grace window the ask is long dead and a notice is noise —
      // unless it carries a revocation the agent must hear about.
      const shouldNotify = now < expiredAt + GRACE_WINDOW_MS || revoked !== null
      const delivered = shouldNotify
        ? await routeGrantNotice(
            ctx,
            req,
            hatchDenyNoticeText({ requestId: req.requestId, question: req.question, deniedAt: now, revokedApprovalId: revoked }),
            `deny:${req.requestId}`,
          )
        : false
      log(`hatch-late-deny: ${describeAskRequest(req)} key=${action.requestId} revoked=${revoked ?? "-"} notice=${shouldNotify ? (delivered ? "delivered" : "failed") : "-"}`)
      const told = delivered ? " — the agent was told" : shouldNotify ? " — could not reach the agent" : ""
      await answerCallbackQuery(ctx, action.callbackQueryId, revoked ? `denied — grant ${revoked} revoked${told}` : `denied${told}`)
      for (const key of hatchSiblingsOf(closableCards(), req, action.requestId)) closeOpenCard(key, CLOSE_STATUS.decided)
      return true
    }
    const unusedGrant = grantsData.grants.some((g) => g.request_id === req.requestId && g.consumed_at === null)
    if (now >= expiredAt + GRACE_WINDOW_MS && !unusedGrant) {
      // Beyond the 24h grace window: NO grant (contract §4's too-late branch).
      // Retire the stale grace record so this card can never mint later. A card
      // whose Approve already minted a grant still unused keeps its record (it
      // outlives the window so a Deny can revoke that grant) and re-routes the
      // grant below.
      if (retireGraceRecord(grantsData.grace, action.requestId)) persistGrants()
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(ctx, cardId, "too late — the 24h late-approval window has closed; the agent must request approval again")
      }
      log(`hatch-grant-too-late: ${describeAskRequest(req)} key=${action.requestId} ageMs=${now - expiredAt}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "too late — the agent must re-request")
      return true
    }
    // Fail-closed mint gate: a grant is useless unless it can be BOUND (an
    // old-lib ask carries no hookId/operation fields — grants.ts's
    // isGrantableRequest). Tell the user plainly instead of minting an
    // unconsumable grant.
    if (!isGrantableRequest(req)) {
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(
          ctx,
          cardId,
          "this expired request came from an older agent-tools version without grant fields — a late approval cannot be bound to it; the agent must re-request",
        )
      }
      log(`hatch-grant-not-grantable: ${describeAskRequest(req)} key=${action.requestId} — no hookId/operation on the ask`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "cannot grant — the agent must re-request")
      return true
    }
    let grant = grantsData.grants.find((g) => g.request_id === req.requestId) ?? null
    if (grant && grant.consumed_at !== null) {
      // Double-mint guard: this approval was already USED — never mint another.
      if (cardId !== null) {
        void clearMessageKeyboard(ctx, cardId)
        void editMessageText(ctx, cardId, `grant ${grant.approval_id} was already used — grants are single-use; the agent must re-request`)
      }
      log(`hatch-grant-already-used: ${describeAskRequest(req)} key=${action.requestId} approvalId=${grant.approval_id}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "a grant for this request was already used")
      return true
    }
    if (!grant) {
      const approvalId = `hgr-${Array.from(crypto.getRandomValues(new Uint8Array(6)), (b) => b.toString(16).padStart(2, "0")).join("")}`
      grant = buildGrantRecord(req, approvalId, routeForRequest(req), now, GRANT_TTL_MS)
      grantsData.grants.push(grant)
      // Durable BEFORE confirming (single-use invariant): a failed write rolls
      // the mint back — the user is told to tap again rather than being handed
      // an approval a restart would lose.
      if (!persistGrants()) {
        grantsData.grants.pop()
        log(`hatch-grant-mint-failed: ${describeAskRequest(req)} key=${action.requestId} — grant store write failed`)
        await answerCallbackQueryOrNotify(ctx, action, "could not record the grant — tap again")
        return true
      }
      log(
        `hatch-grant-minted: ${describeAskRequest(req)} key=${action.requestId} hookId=${grant.hook_id} approvalId=${grant.approval_id} route=${grant.route ?? "-"}`,
      )
    }
    // An unconsumed grant already existed (a re-tap — e.g. after a delivery
    // failure or a duplicate tap): RE-ROUTE the notice instead of minting.
    const notice = hatchGrantNoticeText({
      requestId: req.requestId,
      question: req.question,
      hookId: grant.hook_id,
      approvalId: grant.approval_id,
      approvedAt: grant.approved_at,
      expiresAt: grant.expires_at,
    })
    const delivered = await routeGrantNotice(ctx, req, notice, `grant:${grant.approval_id}`)
    if (cardId !== null) {
      void clearMessageKeyboard(ctx, cardId)
      void editMessageText(ctx, cardId, hatchGrantApprovedText(req, grant.approval_id, delivered), undefined, hatchParseMode(req))
    }
    log(`hatch-grant-notice-${delivered ? "delivered" : "failed"}: approvalId=${grant.approval_id} route=${grant.route ?? "-"} key=${action.requestId}`)
    await answerCallbackQuery(
      ctx,
      action.callbackQueryId,
      delivered ? "✓ grant issued and sent to the agent" : "grant issued — could not reach the agent (the token path still works)",
    )
    for (const key of hatchSiblingsOf(closableCards(), req, action.requestId)) closeOpenCard(key, CLOSE_STATUS.decided)
    return true
  }

  // A tap on an expired hatch card whose abandoned entry is GONE (closed by a decision, or
  // the daemon restarted since) — the grace store (grants.ts)
  // is what keeps it addressable through 24h. Only hatch asks ever grow grace
  // records, so a non-hatch tap falls straight through to the existing toasts.
  const handleGraceStoreTap = async (action: Extract<Action, { kind: "answer-question" }>): Promise<boolean> => {
    const rec = grantsData.grace.find((g) => g.key === action.requestId)
    if (!rec) return false
    // Same own-card guard as the retained path: a stale card must not resolve a
    // different record that happens to share the callback key.
    if (rec.messageId !== null && action.messageId !== null && action.messageId !== rec.messageId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    const answer = resolveButtonCallback(rec.req, { requestId: action.requestId, value: action.value })
    if (answer.status !== "answered") {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    return handleHatchLateTap(action, rec.req, action.messageId ?? rec.messageId, answer, rec.expiredAt)
  }

  const lateDeliverAbandonedQuestion = async (
    action: Extract<Action, { kind: "answer-question" }>,
  ): Promise<boolean> => {
    const retained = abandonedButtons.get(action.requestId)
    if (!retained) return false
    // A hatch/RIG_HATCH_REQUEST_* permission (see parseHatchHookId) is
    // retained with no paneId (retainAbandonedQuestion's paneless carve-out)
    // specifically so a late tap here CAN still be recorded as a queuedDecision
    // — this early "nothing to inject into" bail-out must not reject it before
    // the permission branch below ever runs.
    if (!retained.req.paneId && !(retained.req.kind === "permission" && isHatchRequest(retained.req))) return false
    // A tap must come from THIS retained entry's OWN Telegram message — mirrors the
    // live-prompt path's same guard (case "answer-question" below). Without it, a
    // stale card reusing a deterministic callback key (callbackRequestId is a
    // stable hash of session+question) could queue or overwrite the decision for a
    // DIFFERENT, newer retained entry that happens to hash-collide (review
    // finding). Skipped only while the card's own messageId is still unknown
    // (send in flight) — same as the live path.
    if (
      retained.messageId !== null &&
      action.messageId !== null &&
      action.messageId !== retained.messageId
    ) {
      await answerCallbackQueryOrNotify(ctx, action, "expired")
      return true
    }
    // A permission's LIVE hook needs a structured JSON reply, not terminal text —
    // but once that hook has closed, the harness has ALREADY fallen back to its own
    // terminal prompt, and for claude that prompt is directly answerable by
    // re-checking the pane and injecting the matching digit (see the pane-recheck
    // block right below, tg-cli#267). That covers claude; every other agent kind,
    // and claude when the menu can't be re-verified live, still can't be delivered
    // to right now and must NOT be silently dropped either (Alex tg requirement:
    // never lose a tapped decision) — QUEUE it on the retained entry so a
    // reconnecting hook delivers it automatically the instant it re-attaches (see
    // handleHookSocketLine's RECONNECT re-attach branch). A later re-tap overwrites
    // the queued value (last tap wins, covers a misclick).
    if (retained.req.kind === "permission") {
      // `resolveButtonCallback` (features/tg-ctl/questions.ts) always sets a real
      // 'allow'|'deny' `decision` when it returns status:"answered" for a
      // permission — there is no answered-but-undefined-decision case — so
      // `answer.decision` below is never undefined here (verified: PermissionDecision
      // is exactly 'allow'|'deny', and both permission branches of
      // resolveButtonCallback set it alongside status:"answered"). This is the same
      // invariant question-store.ts's parseQueuedDecision enforces for the on-disk
      // path (review finding: the two paths must agree), so the queue is never
      // created with a decision the restore-time validator would reject.
      const answer = resolveButtonCallback(retained.req, { requestId: action.requestId, value: action.value })
      if (answer.status !== "answered") return false

      // HATCH DIVERSION (grant protocol v1.1, tg-cli#398): a late tap on a
      // retained hatch card mints a single-use, operation-bound GRANT and routes
      // the consume instructions to the origin — it must NEVER record a
      // queuedDecision (the removed mechanism authorized ANY later operation
      // behind the same hookId, exactly what v1.1 forbids). The entry is
      // resolved by the grant; drop it so a re-tap exercises the grace store
      // (idempotent re-route of the existing grant, handleHatchLateTap).
      if (parseHatchHookId(retained.req.requestId) !== null) {
        abandonedButtons.delete(action.requestId)
        persistQuestions()
        const graceAnchor = grantsData.grace.find((g) => g.key === action.requestId)?.expiredAt ?? retained.at
        return handleHatchLateTap(action, retained.req, retained.messageId ?? action.messageId, answer, graceAnchor)
      }
      const label = resolveSessionName({ tmuxWindow: retained.req.windowName, cwd: retained.req.cwd }).primary
      const paneId = retained.req.paneId

      // QUEUE FIRST, unconditionally, BEFORE any pane-inject attempt below —
      // durable on disk before we ever touch tmux. This ordering matters: a
      // daemon crash between an inject attempt and its post-inject confirm
      // (an await on a subprocess plus a pacing sleep — not a negligible
      // window) must NEVER lose the tap (Alex tg#9982 requirement, the exact
      // guarantee the queuedDecision mechanism exists to provide). If the tap
      // were instead recorded as "answered" only AFTER a successful confirm,
      // a crash in that window would persist NOTHING — no queuedDecision to
      // recover from, no live socket to deliver to, and a re-tap would find
      // nothing retained (review finding: an earlier version of this claimed
      // "answered" BEFORE the inject even ran, regressing exactly this
      // invariant). Queuing first means the worst case of a crash mid-inject
      // is simply the pre-existing, already-durable "queued" state — a
      // pane-inject success below UPGRADES this record to answered/delivered;
      // it never has to roll one back.
      const queuedAt = Date.now()
      retained.queuedDecision = { value: answer.value, label: answer.label, decision: answer.decision, at: queuedAt }
      // A fresh tap is itself activity worth restarting the retention clock for —
      // without this, a tap made near the end of the window would still expire on
      // the very next sweep seconds later, flipping the card from "queued …
      // delivered automatically" to "never delivered" despite the human just having
      // acted (review finding). Accepted (not a bug, review finding): a human who
      // keeps RE-tapping (last tap wins) keeps postponing the window indefinitely —
      // that's fine, each tap is genuine fresh activity re-confirming the decision,
      // the same way any other mutation legitimately resets other windows in this
      // file (e.g. ANSWERED_REPLAY_MS on a fresh answer).
      retained.at = queuedAt
      persistQuestions() // durable NOW — a restart before any other mutation must not lose this tap

      // The CTO's spec (verbatim): "no waiting process — check via tmux
      // whether the permission request is still showing, and send the
      // keypresses." Claude Code's own numbered "Do you want to proceed?"
      // menu is answerable directly this way — the harness has already
      // fallen back to ITS OWN terminal prompt, so nothing causes a fresh
      // hook to fire and reconnect; queuing-and-waiting (below) can wait
      // forever. Scoped to claude (tg-cli#267): its menu layout and
      // bare-digit-submits-instantly behavior are the only ones verified
      // live (tmux capture-pane test, 2026-08-18) — every other agent kind
      // falls straight through to the existing queue-and-wait path,
      // unchanged. KNOWN RESIDUAL LIMITATIONS, accepted rather than silently
      // ignored (tg-cli#268 tracks broadening/verifying these further): a
      // command containing a real newline (heredocs, multi-line strings) can
      // never line-match in permissionMenuMatchesRequest and always falls
      // through to queuing (tracked separately as tg-cli#283, needing live
      // verification of how Claude Code actually renders a multi-line
      // command's box before a fix can be trusted — see that issue).
      //
      // The first capture only SELECTS the target (findPermissionMenuTarget:
      // a live cursor, the request's FULL identity as its own line in the
      // menu's bounded context — never a prefix, tg-cli#309 — and an exact
      // Yes/No option). The digit plan then re-captures INSIDE the pane's
      // typing turn, directly before send-keys, and sends nothing unless the
      // same box is still live (verify-permission-menu): the turn can wait
      // seconds behind another plan, and the human may answer at the keyboard
      // and let a different permission render in the same spot meanwhile.
      // What stays open is the gap between that re-capture and send-keys —
      // two tmux spawns, not closable from outside the app.
      if (paneId && retained.req.agent === "claude") {
        // A live question on this pane owns its prompt (shouldDeferInbound): a
        // digit typed now would answer THAT, so the tap stays queued (#268).
        const lookup: PermissionMenuLookup | { ok: false; reason: "pane-busy" } = shouldDeferInbound(paneId)
          ? { ok: false, reason: "pane-busy" }
          : findPermissionMenuTarget(capturePane(paneId), extractPermissionIdentity(retained.req), answer.decision)
        if (lookup.ok) {
          const { target } = lookup
          let deliveryFailure: string | null = null
          try {
            const res = await executeInjectSteps(buildDigitInjectPlan(paneId, target, retained.req.sessionKey))
            deliveryFailure = res.ok ? null : res.error
          } catch (err) {
            // Bun.spawnSync can throw (missing tmux binary, broken PATH) —
            // this call site is the one explicitly claiming rollback-safe
            // semantics, so it must not let a throw skip straight past the
            // "already safely queued" fallback below (review finding).
            deliveryFailure = `inject threw: ${err instanceof Error ? err.message : String(err)}`
          }
          // A tmux exit-0 only proves the keypress was SENT, not that Claude
          // Code actually consumed it as the menu choice — e.g. the pane is
          // in tmux copy-mode (scrolled up), where a literal digit is
          // swallowed by copy-mode's own key table instead of reaching the
          // app underneath (review finding). Re-capture after a short pace;
          // classifyPostInjectPane gates on the live cursor, not on the
          // marker/option TEXT being gone: nothing confirms Claude Code erases
          // a resolved menu rather than leaving it as scrollback (review
          // finding). A live menu still showing THIS command is not confirmed
          // (swallowed key, or the same command asked again); a live menu for
          // a DIFFERENT command means this one resolved and Claude Code moved
          // on to the next tool call — the pre-send verify proved the digit
          // went to this request's box, so that counts as delivered and is
          // logged as `after=next-menu`. A FAILED re-capture proves nothing
          // and is never confirmed-by-default (review finding: an earlier
          // version was fail-open here).
          let after: PostInjectPaneState | null = null
          if (deliveryFailure === null) {
            await Bun.sleep(400)
            after = classifyPostInjectPane(capturePane(paneId), target)
            if (after === "unreadable") deliveryFailure = "post-inject re-capture failed — cannot confirm delivery"
            else if (after === "still-pending") deliveryFailure = "delivery not confirmed — the same menu is still showing after inject"
          }
          if (deliveryFailure === null) {
            // Confirmed delivered — UPGRADE the already-queued entry to
            // answered/pane-delivered (never a rollback needed on this path:
            // nothing was ever recorded as "answered" before this point).
            // The answeredButtons record never replays: the hook-side replay
            // read is question-only (a permission re-fire forwards a fresh
            // card, see the `req.kind === "question"` guard in the ask
            // forward path) — it exists so a re-tap on this card reports
            // "already answered" instead of "expired".
            abandonedButtons.delete(action.requestId)
            pruneAnsweredButtons(answeredButtons, Date.now())
            answeredButtons.set(action.requestId, { value: answer.value, label: answer.label, decision: answer.decision, at: Date.now(), delivery: "pane" })
            persistQuestions()
            log(`ask-late-deliver-permission-pane: ${describeAskRequest(retained.req)} key=${action.requestId} label=${answer.label} pane=${paneId} digit=${target.digit} after=${after}`)
            await answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
            const cardId = retained.messageId ?? action.messageId
            if (cardId !== null) {
              void clearMessageKeyboard(ctx, cardId)
              void editMessageText(ctx, cardId, buildAnsweredQuestionText(retained.req, answer.label), undefined, hatchParseMode(retained.req))
            }
            return true
          }
          // Not confirmed — the entry is ALREADY safely queued (from the top
          // of this block), so there is nothing to roll back; just log why
          // the optimization didn't apply and fall through to the normal
          // queued-decision UI below.
          log(`ask-late-deliver-permission-pane-failed: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} err=${deliveryFailure}`)
        } else {
          // No live, identity-matching menu to inject into right now — log
          // WHY, so a genuinely-dead pane-inject path (e.g. an unverified
          // real-world deny label, tg-cli#268) is distinguishable in the
          // field from "menu already resolved" instead of reading identical
          // to the ordinary queuing case (review finding).
          log(`ask-late-deliver-permission-pane-skip: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} reason=${lookup.reason}`)
        }
      }

      // Not delivered via pane-inject (unsupported agent kind, deferred pane,
      // no live/identity-matching menu, or unconfirmed injection) — already
      // durably queued above; render the existing queued-decision UI. A HATCH
      // entry never reaches here (the grant diversion above returned first) —
      // this is exclusively the scoped-permission reconnect queue.
      const cardId = retained.messageId ?? action.messageId
      // The keyboard MUST ride along explicitly here too (see the disconnect-edit
      // comment in armPendingSocketClose) — "tap again to change it" is a lie if
      // THIS edit is what removes the buttons (review finding).
      if (cardId !== null) {
        void editMessageText(
          ctx,
          cardId,
          // Card text reads `retained.req` — the toast below MUST read the SAME
          // object (never the incoming `req`/`action`), or queuedDecisionCanAutoDeliver's
          // "single source of truth" guarantee is only nominal (review finding).
          queuedPermissionDecisionText(retained.req, label, answer.label),
          buildButtonMessage(ctx.chatId, retained.req).reply_markup,
          hatchParseMode(retained.req),
        )
      }
      // Hatch's proactive push lives entirely in routeGrantNotice (this
      // file), exercised via handleHatchLateTap.
      log(`ask-permission-decision-queued: ${describeAskRequest(retained.req)} key=${action.requestId} label=${answer.label}`)
      // The ephemeral toast must make the SAME promise as the card text — both
      // branch on the SAME shared predicate (queuedDecisionCanAutoDeliver)
      // instead of independently re-deriving the same truthiness check, so they
      // can never silently drift apart again (Codex review finding + follow-up
      // review finding on this fix itself).
      await answerCallbackQuery(
        ctx,
        action.callbackQueryId,
        queuedDecisionCanAutoDeliver(retained.req) ? "queued — will send once the hook reconnects" : "queued — tap again once it reconnects",
      )
      return true
    }
    // A multi-question SET MEMBER is retained ONLY for reconnect re-attach. Its
    // lone answer must never inject into the pane: the local multi-question
    // dialog that took over may be showing a DIFFERENT question, so the injected
    // text would answer the wrong prompt (all-or-nothing — see
    // ButtonRequest.multiQuestion). Refuse WITHOUT mutating state: the retained
    // entry and the card's keyboard survive, so a `tg-ctl ask` resend across a
    // daemon bounce still re-attaches to the original card (no duplicate), and
    // an in-window re-fire of the whole set replays normally. A genuinely-stale
    // member is cleaned up by the retention-window branch above.
    if (retained.req.multiQuestion) {
      log(`ask-late-deliver-refused: multi-question member ${describeAskRequest(retained.req)} key=${action.requestId}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "the terminal took over — answer all questions there")
      return true
    }
    const answer = resolveButtonCallback(retained.req, { requestId: action.requestId, value: action.value })
    if (answer.status !== "answered") return false
    // Inject the chosen option into the asking pane, wrapped like any inbound reply.
    // We do NOT enqueue it on the pane's defer queue: if the pane is BUSY we decline
    // and keep the entry retained for a re-tap (the busy guard below) — a queued
    // late-answer could be delivered behind the wrong live question after we'd
    // already claimed "sent". The pane must also still host the ASKING session
    // (spec §2.6, tg-cli#100): after a tmux restart or a pane respawn `%N` may host
    // a different session, which gets nothing typed and the CTO a named refusal.
    const paneId = retained.req.paneId
    // The pane is BUSY (another live question, or a flush in progress) → do NOT
    // deliver now. Injecting would hit the open prompt; ENQUEUING would risk the
    // answer being delivered after that other question releases, while we'd already
    // have claimed "sent". Keep the entry RETAINED and ask
    // the user to re-tap once the agent is free; never falsely confirm delivery.
    if (shouldDeferInbound(paneId)) {
      log(`ask-late-deliver-busy: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await answerCallbackQueryOrNotify(ctx, action, "agent is busy — tap again shortly")
      return true
    }
    const refusal = paneSessionRefusal(retained.req.sessionKey, paneId)
    if (refusal !== null) {
      log(`ask-late-deliver-refused: session left pane ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await answerCallbackQueryOrNotify(ctx, action, "not delivered — that session left its pane")
      await sendMessage(ctx, refusal, replyContext(action.threadId))
      return true
    }
    const wrapped = wrapInbound(ctx.cfg.injectWrap, "tg", answer.label)
    // CLAIM the entry BEFORE the inject await (consume it from `abandoned`, record the
    // answer as PANE-delivered) instead of after. A daemon restart can deliver a
    // queued tap and the reconnecting hook's resend at nearly the same instant; if we
    // claimed only AFTER the await, a reconnect landing mid-inject would still find the
    // entry in `abandoned` and either re-attach a LIVE socket (hanging the agent until
    // ASK_TOTAL_TIMEOUT_MS) or fresh-forward a DUPLICATE card — and a later re-tap would
    // inject the answer a SECOND time. Claiming first makes that concurrent reconnect
    // hit the `already-pane-delivered` branch (it returns null → the agent falls back to
    // the terminal where THIS injection lands), so the answer reaches the agent exactly
    // once. Rolled back below if the inject fails, so a re-tap can still retry.
    //
    // Accepted bound: a daemon CRASH in the sub-inject window between this persist and
    // the inject completing leaves the answer marked pane-delivered on disk though the
    // injection may not have landed — a re-fire/re-tap then sees already-pane-delivered
    // with no recovery. The window is shorter than one tmux send-keys (fast), and this
    // is strictly better than the pre-PR behavior (a tap after the socket closed was
    // dropped outright). A persisted "delivering" tri-state would close it but isn't
    // worth the complexity for a sub-50ms window.
    const answeredAt = Date.now()
    abandonedButtons.delete(action.requestId)
    pruneAnsweredButtons(answeredButtons, answeredAt)
    answeredButtons.set(action.requestId, { value: answer.value, label: answer.label, decision: answer.decision, at: answeredAt, delivery: "pane" })
    persistQuestions()
    const res = retained.req.agent === "omp"
      ? await deliverOriginalOmp(liveOmpForPane(listLiveOmpAgents(), paneId) ?? { cwd: retained.req.cwd ?? "/" }, wrapInbound(ctx.cfg.injectWrap, "tg", answer.label), `answer:${action.requestId}`, paneId)
      : await executeInjectSteps(buildTextInjectPlan(paneId, wrapped))
    // Typed but still in the input box after the retry Enter (#463): keep the claim
    // — a re-tap would type the answer a second time — and tell the CTO in the chat.
    if (!res.ok && res.unsubmitted) {
      log(`ask-late-deliver-unsubmitted: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await answerCallbackQuery(ctx, action.callbackQueryId, "typed but not sent — see the chat")
      await sendMessage(ctx, res.error)
      return true
    }
    if (!res.ok) {
      // The pane is unreachable (gone / no longer an agent). ROLL BACK the claim:
      // restore the retained entry (with its ORIGINAL `at`, so a failed attempt doesn't
      // look newer than it is) and drop the provisional answer — so a RE-TAP can
      // retry and the answer isn't lost.
      answeredButtons.delete(action.requestId)
      abandonedButtons.set(action.requestId, { req: retained.req, messageId: retained.messageId, at: retained.at })
      persistQuestions()
      log(`ask-late-deliver-failed: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} err=${res.error}`)
      await answerCallbackQueryOrNotify(ctx, action, "could not reach the terminal — tap again")
      return true
    }
    log(`ask-late-delivered: ${describeAskRequest(retained.req)} key=${action.requestId} label=${answer.label} pane=${paneId}`)
    // The pane's question is now answered — flush any defer-while-waiting backlog
    // queued behind it (in FIFO order, after the agent consumes this answer). This
    // is what makes a RESTORED backlog deliverable after a reload: the restored
    // question lives in `abandonedButtons`, so only its late-delivery reaches here
    // to release the queue. (Also closes a latent gap: answering a socket-closed
    // question never used to flush its pane backlog.) onQuestionReleased self-guards
    // against an in-flight flush or another live question on the pane.
    if (paneId) onQuestionReleased(paneId)
    await answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
    const cardId = retained.messageId ?? action.messageId
    if (cardId !== null) {
      // Clear the keyboard now the answer landed: this card explicitly invited a tap
      // ("window closed — tap still delivers …"), so once delivered it must stop being
      // tappable — a re-tap after the answered-replay window (ANSWERED_REPLAY_MS, 5 min)
      // would otherwise find no entry and show a misleading "expired".
      void clearMessageKeyboard(ctx, cardId)
      void editMessageText(ctx, cardId, buildAnsweredQuestionText(retained.req, answer.label), undefined, hatchParseMode(retained.req))
    }
    return true
  }

  // A text reply to a retained question card — or, with `status`, a plain message typed to the
  // session whose only open card it is (tg-cli#705) — is typed into the asking pane as the answer.
  const handlePostTimeoutQuestionReply = async (
    action: Extract<Action, { kind: "post-timeout-question-reply" }>,
    status?: string,
  ): Promise<boolean> => {
    const retained = abandonedButtons.get(action.requestId)
    if (
      !retained ||
      !retained.req.paneId ||
      retained.req.kind !== "question" ||
      retained.req.multiQuestion ||
      retained.messageId !== action.questionMessageId
    ) {
      await sendMessage(ctx, "that question is no longer waiting — resend if needed", replyContext(action.threadId))
      return false
    }
    const paneId = retained.req.paneId
    if (shouldDeferInbound(paneId)) {
      log(`ask-post-timeout-reply-busy: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await sendMessage(ctx, "agent is busy — reply to the question again shortly", replyContext(action.threadId))
      return false
    }

    const answer = action.text.trim()
    const answeredAt = Date.now()
    abandonedButtons.delete(action.requestId)
    pruneAnsweredButtons(answeredButtons, answeredAt)
    answeredButtons.set(action.requestId, { value: answer, label: answer, at: answeredAt, delivery: "pane" })
    persistQuestions()

    const res = await injectInbound(action.messageId, paneId, buildTextInjectPlan(paneId, answer, { sessionKey: retained.req.sessionKey }))
    // Typed but still in the input box after the retry Enter (#463): keep the claim
    // — a second reply would type the answer again — and tell the CTO.
    if (!res.ok && res.unsubmitted) {
      log(`ask-post-timeout-reply-unsubmitted: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId}`)
      await sendMessage(ctx, res.error)
      return false
    }
    if (!res.ok) {
      answeredButtons.delete(action.requestId)
      abandonedButtons.set(action.requestId, { req: retained.req, messageId: retained.messageId, at: retained.at })
      persistQuestions()
      log(`ask-post-timeout-reply-failed: ${describeAskRequest(retained.req)} key=${action.requestId} pane=${paneId} err=${res.error}`)
      await sendMessage(ctx, res.sessionMismatch ? res.error : "could not reach the terminal — reply to the question again", replyContext(action.threadId))
      return false
    }

    log(`ask-post-timeout-reply-delivered: ${describeAskRequest(retained.req)} key=${action.requestId} answer=${answer} pane=${paneId}`)
    void clearMessageKeyboard(ctx, action.questionMessageId)
    void editMessageText(ctx, action.questionMessageId, status ? closedQuestionText(retained.req, status) : buildAnsweredQuestionText(retained.req, answer))
    flushDeferred(paneId).catch((err) => log(`flushDeferred post-timeout-reply error: ${err}`))
    return true
  }

  // Close / ✕ Dismiss (tg-cli#705): the human says the question is no longer relevant, on the
  // card or its Inbox copy. Any open card closes — a live one too (its asker gets `null` and
  // falls back to its terminal). A tap from a stale card that shares the key only loses its
  // buttons.
  const handleCloseQuestionCard = async (
    action: Extract<Action, { kind: "close-question-card" }>,
  ): Promise<boolean> => {
    const entry = pendingButtons.get(action.requestId) ?? abandonedButtons.get(action.requestId)
    const ownCard = entry && (action.messageId === null || entry.messageId === null || entry.messageId === action.messageId)
    if (!ownCard || !closeOpenCard(action.requestId, CLOSE_STATUS.dismissed)) {
      if (action.messageId !== null) void clearMessageKeyboard(ctx, action.messageId)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "closed")
    return true
  }

  // The shared-state key for actions that read-then-write a Map keyed by a shared identifier
  // (tg-cli#357): actions carrying the same key still run strictly in enqueue order via
  // dispatchQueues below (preserving every existing double-tap/race guard); `null` means the
  // action touches no shared keyed state and is always safe to run fully concurrently.
  const actionResourceKey = (action: Action): string | null => {
    switch (action.kind) {
      case "topic-route":
      case "topic-hold":
      case "topic-attach":
      case "topic-event":
        return `thread:${action.threadId}`
      // Every /new step — a typed /new, a ➕ New session tap, a dir/harness/model/retry tap — reads
      // or replaces the one global pending /new: they run one at a time, so a tap can never act on
      // a flow another step is replacing.
      case "topic-new-session":
      case "new-command":
      case "new-dir":
      case "new-harness":
      case "new-model":
      case "new-retry":
        return "new-session"
      case "agent-callback":
      case "agent-cancel":
        return `token:${action.token}`
      case "answer-question":
      case "close-question-card":
      case "post-timeout-question-reply":
        return `req:${action.requestId}`
      case "limit-continue":
        return `pane:${action.paneId}`
      default:
        return null
    }
  }

  // Returns true when the action was handled successfully — the 'ack' case
  // reads the PRECEDING action's verdict (passed in, not a shared mutable variable — tg-cli#357:
  // concurrent dispatch across different resource keys means a closure variable updated by another
  // in-flight group could otherwise leak across groups) to decide whether the source message earns
  // its 👀 receipt (actions for one message are contiguous, ack last).
  const executeAction = async (action: Action, precedingOk: boolean): Promise<boolean> => {
    // A tap on — or a reply to — a card's 📥 Inbox copy acts on the card itself (tg-cli#705):
    // every guard and edit below compares and edits the card's own message id.
    if ((action.kind === "answer-question" || action.kind === "close-question-card") && action.messageId !== null) {
      action = { ...action, messageId: cardMessageIdFor(action.messageId) }
    } else if (action.kind === "post-timeout-question-reply") {
      action = { ...action, questionMessageId: cardMessageIdFor(action.questionMessageId) }
    }
    switch (action.kind) {
      case "reply":
        await sendMessage(ctx, action.text, replyContext(action.threadId))
        return true
      case "answer-callback":
        await answerCallbackQuery(ctx, action.callbackQueryId, action.text)
        return true
      case "close-question-card":
        return handleCloseQuestionCard(action)
      case "post-timeout-question-reply": {
        // A text reply to a LIVE question card (or its Inbox copy) answers it down the hook
        // socket, like a tap; a retained card's answer is typed into its pane.
        const live = pendingButtons.get(action.requestId)
        if (live && live.messageId === action.questionMessageId) {
          return executeAction(
            {
              kind: "answer-question",
              callbackQueryId: "",
              requestId: action.requestId,
              value: "",
              messageId: action.questionMessageId,
              freeText: action.text,
              ...(action.threadId !== undefined ? { threadId: action.threadId } : {}),
            },
            precedingOk,
          )
        }
        return handlePostTimeoutQuestionReply(action)
      }
      case "answer-question": {
        const pending = pendingButtons.get(action.requestId)
        if (!pending) {
          // No LIVE prompt for this key. FIRST try late-delivery: a tap on a still-
          // retained (abandoned) question injects the chosen option into its pane
          // instead of being dropped (this PR). Only if there is nothing to deliver
          // do we fall back to the toasts below.
          if (await lateDeliverAbandonedQuestion(action)) return true
          // Grant protocol v1.1 (tg-cli#398): a tap on an expired HATCH card whose
          // retained entry is gone (a decision closed it / daemon restarted) —
          // the 24h grace store keeps it addressable, so a late Approve can still
          // mint a grant. Non-hatch taps fall straight through.
          if (await handleGraceStoreTap(action)) return true
          // If we ANSWERED it WITHIN the replay window the tap is on an already-
          // resolved card, not a truly-expired prompt — say so plainly instead of the
          // misleading "expired" (tg-cli#97). Gated on the same window as the hook-
          // path replay so the two never disagree on whether an entry is still
          // "answered" vs aged-out.
          const priorAnswer = answeredButtons.get(action.requestId)
          const stillAnswered = priorAnswer !== undefined && Date.now() - priorAnswer.at <= ANSWERED_REPLAY_MS
          // Nothing answers for this card any more (e.g. a hatch card whose 24h grace
          // window closed): retire its
          // buttons so they never outlive what a tap can do (tg-cli#403).
          if (!stillAnswered && action.messageId !== null) void clearMessageKeyboard(ctx, action.messageId)
          await answerCallbackQueryOrNotify(ctx, action, stillAnswered ? "already answered" : "expired")
          return true
        }
        // A tap must come from THIS prompt's Telegram message: a stale tap on
        // an earlier prompt that reused the callback key must not answer this
        // one. Skipped only while sendMessage is still in flight (messageId
        // unknown) — that race is resolved in the tap's favor by design.
        if (
          pending.messageId !== null &&
          action.messageId !== null &&
          action.messageId !== pending.messageId
        ) {
          await answerCallbackQueryOrNotify(ctx, action, "expired")
          return true
        }
        // An answer typed in chat (tg-cli#705) instead of a tapped option.
        const answer = action.freeText !== undefined ? freeTextAnswer(pending.req, action.freeText) : resolveButtonCallback(pending.req, { requestId: action.requestId, value: action.value })
        if (answer.status !== "answered") {
          await answerCallbackQueryOrNotify(ctx, action, "expired")
          return true
        }
        // A live answer on a hatch card is final: it retires the card's grace record (a
        // restored ask has one while live again — a raced tap must not mint) and records
        // the card as decided, so a restart that still finds it in the best-effort
        // questions store — this answer's write of it can fail — does not re-open it
        // (tg-cli#433). Durable BEFORE the answer goes out, like a late Deny: a lost write
        // refuses the answer and the card stays live for another tap, never confirmed on
        // memory alone.
        if (pending.req.kind === "permission" && isHatchRequest(pending.req)) {
          const decision = answer.decision === "deny" ? "deny" : "allow"
          const undoClose = closeDecidedCard(grantsData, action.requestId, decision, Date.now(), decidedRetainMs(pending.req))
          if (!persistGrants()) {
            undoClose()
            log(`ask-answer-refused: ${describeAskRequest(pending.req)} key=${action.requestId} — grant store write failed`)
            await answerCallbackQueryOrNotify(ctx, action, "could not record the answer — tap again")
            return true
          }
        }
        pendingButtons.delete(action.requestId)
        activeButtonKeys.delete(action.requestId)
        // A stale abandoned twin (a reconnect re-attach raced a tap) must not linger
        // and resurrect on the next restart — the live answer below supersedes it.
        abandonedButtons.delete(action.requestId)
        // Remember a QUESTION's answer briefly so a re-forward of the SAME requestId
        // (the AskUserQuestion double-cover / re-fire race) replays it instead of
        // posting a second card (tg-cli#97). Scoped to questions on purpose: a
        // permission's requestId is also stable, but silently replaying a prior
        // allow/deny without re-prompting would be a behavioral/security change the
        // bug never asked for — and permissions have no double-card problem (they
        // forward via a single catch-all matcher, not a dedicated + catch-all pair).
        // Recorded AFTER the in-flight key is released, so the replay cache takes
        // over exactly where the in-flight dedup leaves off. Sweep stale entries on
        // each record so the cache can't grow unbounded.
        //
        // A multi-question SET MEMBER is never cached: the group is
        // all-or-nothing — if a later member aborts, the whole call is re-asked,
        // and a replayed member would silently stitch a STALE answer into the
        // NEW round without ever showing its card (review finding). The cost is
        // symmetric honesty: a re-fired identical set re-posts its cards.
        if (pending.req.kind === "question" && !pending.req.multiQuestion) {
          const answeredAt = Date.now()
          pruneAnsweredButtons(answeredButtons, answeredAt)
          answeredButtons.set(action.requestId, {
            value: answer.value,
            label: answer.label,
            decision: answer.decision,
            at: answeredAt,
            delivery: "socket", // answered down the live hook socket → re-fire replays (#98)
          })
        }
        // Persist the answer so a hook that reconnects after a restart replays it
        // (no duplicate card) instead of re-forwarding the now-answered question.
        persistQuestions()
        // A decided hatch card makes every other open card of the same (hookId, cwd) moot.
        if (isHatchRequest(pending.req)) {
          for (const key of hatchSiblingsOf(closableCards(), pending.req, action.requestId)) closeOpenCard(key, CLOSE_STATUS.decided)
        }
        clearTimeout(pending.timer)
        const finalText =
          action.freeText !== undefined
            ? closedQuestionText(pending.req, CLOSE_STATUS.answeredInChat(action.freeText.trim()))
            : buildAnsweredQuestionText(pending.req, answer.label)
        if (pending.messageId === null) pending.finalText = finalText
        const output = formatAgentHookOutput(pending.req, answer)
        pending.socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
        // Previously silent — a question reaching the agent left no daemon trace,
        // making the duplicate-card report impossible to confirm from logs.
        log(`ask-answered: ${describeAskRequest(pending.req)} key=${action.requestId} label=${answer.label} messageId=${pending.messageId ?? "-"}`)
        void answerCallbackQuery(ctx, action.callbackQueryId, "✓ sent to the agent")
        if (pending.messageId !== null) void editMessageText(ctx, pending.messageId, finalText, undefined, hatchParseMode(pending.req))
        // The agent is unblocked → deliver anything queued behind this question.
        // Fire-and-forget, but guard the promise: an error here must never become
        // an unhandled rejection that takes down the daemon.
        // A paneless (unscoped) question deferred EVERY pane, so its answer must
        // release them all — the entry is already out of pendingButtons above, as
        // onUnscopedRelease's caller contract requires (tg-cli#127).
        if (pending.req.paneId) {
          flushDeferred(pending.req.paneId).catch((err) => log(`flushDeferred error: ${err}`))
        } else onUnscopedRelease()
        return true
      }
      case "status": {
        const topicSettings = topicSettingsLine(ctx)
        await sendMessage(ctx, composeStatus(ctx, null, topicSettings ? await topicSettings : null), replyContext(action.threadId))
        return true
      }
      case "limit-status":
        await sendMessage(ctx, composeLimitStatus(ctx, action.agent), replyContext(action.threadId))
        return true
      case "daily-report":
        await deliverDailyReport(ctx, replyContext(action.threadId))
        return true
      case "usage-report":
        await sendReportChunks(ctx, (await composeUsageReport(action.period)).text, replyContext(action.threadId))
        return true
      case "tasks":
        await runTasksCommand(ctx, action)
        return true
      case "limit-continue":
        return handleLimitContinue(action)
      case "agent-route":
        return handleAgentRoute(action)
      case "agent-callback":
        return handleAgentCallback(action)
      case "agent-cancel":
        return handleAgentCancelCallback(action)
      case "inject-text":
        if (selectedAgentRoute) {
          const selectedResult = await injectIntoSelectedAgent(action.text, action.messageId)
          if (selectedResult !== null) return selectedResult
        }
        // A plain non-reply message → opt into the no-reply auto-bind (fix B). This is the exact
        // HYP-915 shape (a fresh, unrelated message silently landing in an occupied pane), so the
        // git-state-check banner (withGitStateBanner) is prepended here when that pane is
        // mid-flight.
        return injectViaTarget(
          (target) => buildTextInjectPlan(target.pane.paneId, withGitStateBanner(target.pane.panePath, action.text)),
          action.text,
          true,
          action.messageId,
          action.plain,
        )
      case "reply-route":
        return handleReplyRoute(action)
      case "inject-key":
        // A control verb (Escape/`/stop`) — no text to bank a banner into.
        return injectViaTarget((target) => buildKeyInjectPlan(target.pane.paneId, action.key))
      case "kill-agent": {
        // /kill sends SIGINT — a DESTRUCTIVE verb. It must NOT auto-bind to a
        // guessed agent (killing the wrong one is unrecoverable); on an ambiguous
        // fleet it asks (the select-picker below) rather than the no-reply auto-bind
        // that resolves a harmless content inject. So this uses the base discover(),
        // not discoverForInject (tg-cli#75 review).
        const found = discover()
        if (!found.ok) {
          // Ambiguous /kill (several live agents) → show the live agents as a
          // select-only picker (buttons) instead of a plain-text candidate dump;
          // no-agent → the no-agent reply. (A tap on the picker hands back the
          // selector to re-issue against one agent — kill-on-tap is out of scope.)
          if (found.reason === "ambiguous") {
            await postSelectPicker(candidatesForPicker(found.candidates))
          } else {
            await replyNoAgent()
          }
          return false
        }
        if (found.target.agentPid === undefined) {
          await sendMessage(ctx, "agent pid unknown — not killed")
          return false
        }
        try {
          // SIGINT kills the interactive agent (~1s) — spec §5.2 reserves it
          // for the explicit /kill verb. /stop is the survivable Escape.
          process.kill(found.target.agentPid, "SIGINT")
          await sendMessage(ctx, "session killed — restore via `claude --resume`")
          return true
        } catch (err) {
          await sendMessage(ctx, `kill failed: ${err}`)
          return false
        }
      }
      case "download-media":
        return downloadMedia(action)
      case "transcribe-voice":
        return transcribeVoice(action)
      case "topic-route":
        return handleTopicRoute(action)
      case "topic-hold":
        return handleTopicHold(action)
      case "topic-attach":
        return handleTopicAttach(action)
      case "topic-new-session":
        return handleTopicNewSession(action)
      case "topic-event":
        return handleTopicEvent(action)
      case "new-command":
        return handleNewCommand(action)
      case "new-answer":
        return handleNewAnswer(action)
      case "new-dir":
        return handleNewDir(action)
      case "new-harness":
        return handleNewHarness(action)
      case "new-model":
        return handleNewModel(action)
      case "new-retry":
        return handleNewRetry(action)
      case "new-private-topic-fallback":
        return handleNewPrivateTopicFallback(action)
      case "ack":
        await settleAckReaction(action.messageId, precedingOk)
        return true
    }
  }

  // Publish the command menu once on startup, before entering the poll loop.
  // Best-effort — publishBotCommands swallows every failure so a Telegram
  // hiccup can never block routing.
  await publishBotCommands(ctx)

  // Reconcile forum-topic bindings against the live tmux state once on startup: adopt a
  // crash-orphaned /new topic-slug window, close a bound binding whose session died while down.
  // No-op when topics mode is off (1:1 startup byte-identical) and fully guarded.
  reconcileTopicsOnStartup()
  // Answer unknown-topic holds that expired while the daemon was down, then keep sweeping.
  // Guarded: a send failure must never escape into the timer (an unhandled rejection).
  const sweepTopicHolds = (): void => {
    expireTopicHolds().catch((err) => log(`topic hold expiry failed: ${err}`))
  }
  sweepTopicHolds()
  setInterval(sweepTopicHolds, 30_000).unref?.()

  // Self-heal the Claude Code hooks on startup. Claude Code can re-emit
  // ~/.claude/settings.json with only its own managed keys, silently dropping our
  // q→buttons, StopFailure, and statusLine-telemetry channels — the daemon then
  // keeps running but "question asked" / "tokens running low" never surface until
  // a manual `tg-ctl install-hooks`. Re-merge idempotently here (same pattern as
  // reconcileTopicsOnStartup): a no-op when the hooks are already present, so it
  // only writes when a rewrite actually gutted them. Best-effort — a failure here
  // must never block the daemon from entering its poll loop.
  ensureClaudeHooksOnStartup(ctx)
  await ensureOmpLiveExtensionOnStartup(ctx)

  await refreshOriginalHosts()
  log(`daemon up — pid ${process.pid}, bot ${ctx.botId}, offset ${offset}`)

  // A killed run's open claims and in-memory picker holds (tg-cli#299): never re-sent — the
  // text may already be in the agent — and never silent. Recorded first, so a restart during
  // the notice cannot repeat it.
  for (const c of interruptedClaims) {
    recordDelivery([{ ts: Date.now(), event: "uncertain", chat: c.chat, msg: c.msg, target: c.target }])
    await tellUndelivered(c.msg, `may not have reached ${c.target}: the daemon restarted while delivering it. Resend it if the agent did not get it.`)
  }
  for (const p of lostPickers) {
    recordFailed(p.msg, p.target, "the daemon restarted while it waited for an agent pick")
    await tellUndelivered(p.msg, "was not delivered: the daemon restarted while it waited for you to pick an agent. Resend it if it still matters.")
  }

  let recoveryQueue: TgUpdate[] | null = null
  {
    const leftover = parsePendingBatch(readFileOrNull(ctx.paths.pendingBatch))
    if (leftover.length > 0) {
      log(`recovering ${leftover.length} update(s) from a pending batch left by a prior crash/kill`)
      recoveryQueue = leftover
    }
  }
  // Sends `tg` queued while Telegram was failing (tg-cli#710): try them now, and again after
  // every successful getUpdates.
  kickOutboxFlush(ctx)

  // A chat `tg auth` bound in the previous batch (claimAuthBinding); applied between batches.
  let authChatSwitch: number | null = null
  for (;;) {
    // Graceful shutdown lands here BETWEEN batches — after the previous batch's
    // actions fully executed, before the next long-poll — so a reload never drops
    // an in-flight batch. Wait out any in-flight deferred flush before exiting so
    // an answered-question backlog is drained, not wedged/dropped (codex #198);
    // cleanExit then persists the durable backlog on its way out.
    if (shuttingDown) await cleanExitAfterFlushDrain()
    if (authChatSwitch !== null) {
      switchChat(ctx, authChatSwitch)
      authChatSwitch = null
    }
    try {
      // Idle TTL first, so even an error-backoff loop eventually exits. A
      // newer registration file also counts as agent activity (the daemon may
      // have been retargeted while no pane was discoverable yet).
      const regMtime = fileMtimeMs(ctx.paths.registration)
      if (regMtime !== null && regMtime > lastAgentSeenMs) lastAgentSeenMs = regMtime
      discover()
      // An agent running OUTSIDE tmux keeps the daemon alive too (tg-cli#306): its
      // question cards and hatch asks still come through the daemon socket, and a
      // `/agent` to it must get the tmux-only refusal, not silence. The same tick archives
      // what the omp Stop bridge delivered and, once, reports the stranded cc/codex inbox.
      if (listUnreachableAgents().length > 0 || listLiveOmpAgents().length > 0) lastAgentSeenMs = Date.now()
      archiveDeliveredInboxes(ctx)
      await reportStrandedInbox(ctx)
      if (Date.now() - lastAgentSeenMs > ctx.cfg.idleExitMin * 60_000) {
        log(`no agent pane for ${ctx.cfg.idleExitMin} min — idle exit`)
        cleanExit(0)
      }

      // The queued-decision notice (a notice, never an expiry) and the 📥 Inbox safety-net
      // sync run every loop iteration (roughly once per ~50s long-poll, sooner if messages keep
      // arriving): persistQuestions only runs on a mutation, and a copy whose send failed is
      // retried here (tg-cli#705).
      if (noticeStaleQueuedDecisions(Date.now())) persistQuestions()
      await syncInbox()
      void retireQueuedReminders()

      // Remind only verified original processes. Never spawn an anonymous agent
      // because a TUI has not published its bridge or its session identity is unknown.
      await refreshOriginalHosts()
      const liveOmpAgentsForNudge = listLiveOmpAgents().filter(a => originalHosts.some(h => h.pid === a.pid))
      if (liveOmpAgentsForNudge.length > 0 || Object.keys(awarenessNudgeStore).length > 0) {
        // Nudge state is keyed by the session (`omp:<sessionId>`) when omp has
        // published one, so a `--resume` into another pane keeps its silence
        // clock and nudge marker (#459). History rows only carry the pane/pid
        // locator, so the last-send time is read through the agent's locator.
        const locatorOf = (a: LiveOmpAgent): string => a.paneId ?? liveOmpPaneId(a.pid)
        const nudgeKeyOf = (a: LiveOmpAgent): string => (a.sessionId ? sessionKey("omp", a.sessionId) : locatorOf(a))
        const liveOmpAgentByNudgeKey = new Map(liveOmpAgentsForNudge.map((a) => [nudgeKeyOf(a), a]))
        const nudgeKeys = [...liveOmpAgentByNudgeKey.keys()]
        const sessionIdByNudgeKey = new Map([...liveOmpAgentByNudgeKey].map(([key, a]) => [key, a.sessionId]))
        const sentAtByLocator = lastTgSentAtByKey(parseHistory(readFileOrNull(ctx.paths.history)))
        const sentAtByKey = new Map<string, number>()
        for (const [key, a] of liveOmpAgentByNudgeKey) {
          const locator = locatorOf(a)
          const sentAt = sentAtByLocator.get(locator)
          if (sentAt !== undefined) sentAtByKey.set(key, sentAt)
          // A pre-#459 row keyed by the locator for this same session carries
          // over, so the cutover does not restart its silence clock.
          const legacy = awarenessNudgeStore[locator]
          if (key !== locator && !awarenessNudgeStore[key] && legacy?.sessionId === a.sessionId) {
            awarenessNudgeStore = { ...awarenessNudgeStore, [key]: legacy }
          }
        }
        const nudgePlan = planAwarenessNudges(nudgeKeys, sentAtByKey, awarenessNudgeStore, Date.now(), sessionIdByNudgeKey)
        awarenessNudgeStore = nudgePlan.store
        if (nudgePlan.keysChanged) persistAwarenessNudge()
        // Only a send that actually SUCCEEDS commits the "nudged" marker
        // (via markAwarenessNudgeSent, below) — a due key stays due next
        // sweep on failure/drop instead of silently losing its one shot at
        // reaching the exact busy/loaded agent this feature targets.
        const sentKeys: string[] = []
        for (const key of nudgePlan.due) {
          const target = liveOmpAgentByNudgeKey.get(key)
          if (!target) continue
          const res = await deliverOriginalOmp(target, AWARENESS_NUDGE_TEXT, `awareness:${target.pid}:${target.sessionId}:${Math.floor(Date.now() / 3_600_000)}`)
          log(res.ok ? `awareness-nudge sent to ${key}` : `awareness-nudge failed for ${key}: ${res.error}`)
          if (res.ok) sentKeys.push(key)
        }
        if (sentKeys.length > 0) {
          awarenessNudgeStore = markAwarenessNudgeSent(awarenessNudgeStore, sentKeys, Date.now())
          persistAwarenessNudge()
        }
      }

      kickSessionRegistryScan(ctx)

      let json: { ok: boolean; result?: TgUpdate[]; description?: string }
      if (recoveryQueue !== null) {
        json = { ok: true, result: recoveryQueue }
        recoveryQueue = null
      } else {
      // The idle long-poll is abortable by SIGTERM (beginGracefulShutdown) so a
      // reload doesn't wait out the 50s poll; the timeout is the normal ceiling.
      // Re-check shuttingDown AFTER creating the controller and pre-abort if set:
      // a SIGTERM that landed between the loop-top check and here fired abort() on
      // the PREVIOUS (settled) controller — a no-op — and would otherwise let this
      // fresh long-poll run to its full ceiling (drain would then rely on the 8s
      // fallback instead of the snappy hand-off). Pre-aborting the current
      // controller makes the fetch reject at once → the catch exits gracefully.
      pollAbort = new AbortController()
      if (shuttingDown) pollAbort.abort()
      const resp = await fetch(
        `${api(ctx)}/getUpdates?timeout=50&offset=${offset}&allowed_updates=${encodeURIComponent('["message","callback_query"]')}`,
        { signal: AbortSignal.any([AbortSignal.timeout(60_000), pollAbort.signal]) },
      )
      if (resp.status === 409) {
        // Another consumer is long-polling this bot (other machine, or a
        // lingering server-side poll right after a restart) — the flock can't
        // prevent that. Back off 1,2,4…60s; warn ONCE per streak.
        consecutive409 += 1
        if (consecutive409 === 5 && !warned409) {
          warned409 = true
          log("5 consecutive 409s — another consumer is polling this bot")
          await sendMessage(ctx, "another consumer is polling this bot")
        }
        await drainAwareSleep(Math.min(2 ** (consecutive409 - 1), 60) * 1000)
        continue
      }
      if (!resp.ok) {
        log(`getUpdates HTTP ${resp.status}: ${(await resp.text()).slice(0, 200)}`)
        await drainAwareSleep(5000)
        continue
      }
      json = (await resp.json()) as { ok: boolean; result?: TgUpdate[]; description?: string }
      if (!json.ok || !Array.isArray(json.result)) {
        log(`getUpdates API error: ${json.description ?? "malformed response"}`)
        await drainAwareSleep(5000)
        continue
      }
      consecutive409 = 0
      warned409 = false
      kickOutboxFlush(ctx)
      }

      // Durably journal the raw batch BEFORE stepUpdates/offset-advance (tg-cli#322): if this
      // write completes, ANY subsequent crash — including one back inside stepUpdates or during
      // action dispatch — has a durable copy to replay via recoveryQueue on the next startup.
      // Unconditional on the recovery path too: harmless idempotent rewrite of the same content.
      if (json.result.length > 0) {
        atomicWrite(ctx.paths.pendingBatch, serializePendingBatch(json.result))
      }
      // An update this daemon already finished — Telegram redelivering it after a lost offset
      // write, or the journal replaying it after a kill — is skipped whole (tg-cli#299). One it
      // only half-processed runs again; the sinks' ledger gate keeps whatever already went out
      // from going out twice. The offset still advances past the whole raw batch.
      const processedUpdates = deliveryLedger?.state.processedUpdates
      const received = processedUpdates ? json.result.filter((u) => !processedUpdates.has(u.update_id)) : json.result
      if (received.length < json.result.length) log(`skipping ${json.result.length - received.length} already-processed update(s)`)
      const batchOffset = json.result.reduce((next, u) => Math.max(next, u.update_id + 1), offset)
      const receivedAt = Math.floor(Date.now() / 1000)
      recordDelivery(
        received.map((u): LedgerEvent => {
          const m = u.message
          const sender = m?.from?.id
          if (m && m.chat.id === ctx.chatId && sender !== undefined && (sender === ctx.chatId || ctx.cfg.allowedSenders.includes(sender))) {
            return { ts: Date.now(), event: "received", update: u.update_id, date: m.date, chat: ctx.chatId, msg: m.message_id }
          }
          return { ts: Date.now(), event: "received", update: u.update_id, date: m?.date ?? receivedAt }
        }),
      )
      // tg auth (docs/specs/tg-auth.md §4): claim a live `/start <nonce>` and keep every deep-link
      // Start tap out of routing so it is never typed into a pane. The ledger above still records
      // it (no update-id gap) and the offset still advances past it (batchOffset).
      const auth = daemonAuthStep(received, () => readFileOrNull(ctx.paths.authPending), Date.now())
      if (auth.claim && claimAuthBinding(ctx, auth.claim)) authChatSwitch = auth.claim.chat.id
      const updates = auth.drop.size > 0 ? received.filter((u) => !auth.drop.has(u.update_id)) : received

      await refreshOriginalHosts()
      const step = stepUpdates(updates, {
        cfg: ctx.cfg,
        chatId: ctx.chatId,
        nowSec: Math.floor(Date.now() / 1000),
        currentOffset: offset,
        wrap: (name, msg, messageId) => wrapInbound(ctx.cfg.injectWrap, name, msg, messageId),
        // Local-time quote anchor for replies (item 3); pure module defaults to UTC.
        fmtTime: (s) => {
          const d = new Date(s * 1000)
          const p = (n: number): string => String(n).padStart(2, "0")
          return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
        },
        // Forum-topics mode (spec §8). OFF by default: when ctx.cfg.topics is false stepUpdates
        // ignores message_thread_id and the flat 1:1 path is byte-identical to before. When on,
        // topicStatusOf reads the binding store so topic messages route per-topic.
        // privateTopics also uses the same TopicBinding store and the same routing — enabling
        // either flag arms the topic router so private-chat topic messages reach their agent pane.
        topicsEnabled: ctx.cfg.topics || ctx.cfg.privateTopics,
        topicStatusOf: (ctx.cfg.topics || ctx.cfg.privateTopics) ? topicStatusOf : undefined,
        // Flat /new (issue #27): always wired (not gated by topics) — a plain message while a
        // /new awaits its dir is the typed path. When no /new is in flight this is false and the
        // plain-text path is byte-identical to before.
        newSessionAwaitingDir,
        // A reply to a card's 📥 Inbox copy is a reply to the card (tg-cli#705): both lookups
        // see the card's own message id. A LIVE question card answers the same way as a
        // retained one — executeAction sends the text down its hook socket.
        postTimeoutQuestionRequestIdForMessage: (messageId) => {
          const cardId = cardMessageIdFor(messageId)
          for (const [requestId, pending] of pendingButtons) {
            if (pending.messageId === cardId && pending.req.kind === "question" && !pending.req.multiQuestion) return requestId
          }
          for (const [requestId, retained] of abandonedButtons) {
            if (
              retained.messageId === cardId &&
              retained.req.kind === "question" &&
              !retained.req.multiQuestion &&
              retained.req.paneId
            ) {
              return requestId
            }
          }
          return null
        },
        permissionRequestIdForMessage: (messageId) =>
          findDecidablePermissionRequestId(pendingButtons, cardMessageIdFor(messageId)) ??
          findDecidablePermissionRequestId(abandonedButtons, cardMessageIdFor(messageId)) ??
          // A grace-only hatch card (its retained entry gone after a decision or restart) is
          // decided by a text reply exactly like by a tap (handleGraceStoreTap) — also through an
          // Inbox copy, which names the card it was made from.
          findDecidablePermissionRequestId(
            grantsData.grace.map((g): [string, GraceRecord] => [g.key, g]),
            inboxEntryOf(inboxState, messageId)?.cardId ?? messageId,
          ),
      })

      // The batch is durably journaled BEFORE this point (see the atomicWrite above), so
      // persisting the offset here no longer risks losing the update if a kill lands during
      // action dispatch: recovery-on-restart (recoveryQueue, top of runDaemon) replays the
      // pending-batch file. Telegram will redeliver anything whose offset was never advanced —
      // i.e. a crash before this line, including mid-write of the journal itself, which a POSIX
      // atomic rename makes never partially-visible. Anything past this line is recoverable from
      // OUR OWN journal instead of relying on Telegram redelivery.
      const newOffset = Math.max(step.newOffset, batchOffset)
      if (newOffset !== offset) {
        offset = newOffset
        writeFileSync(ctx.paths.offset, `${offset}\n`)
      }

      // Persist inbound history for `tg replies` recall — every message the CTO
      // sent in this batch. Best-effort, off the inject path: a read/write error
      // here never blocks delivery. Stale + rejected senders are filtered the
      // same way stepUpdates does (inboundHistoryRecords). Only when the batch
      // carried messages — an empty 50s long-poll skips the walk.
      //
      // Pane stamping must match where the message ACTUALLY routes, else a reply
      // (which routes to its recognized ORIGIN pane, not the default target) would
      // be logged under the wrong pane and vanish from that pane's scoped recall.
      // `resolvePane` mirrors handleReplyRoute's recognition: a reply whose
      // replied-to id is in the routes map AND still maps to a live same-project
      // agent pane is stamped with that pane; everything else uses the default
      // discovered target.
      if (updates.length > 0) {
        const found = discover()
        const targetPane = found.ok ? found.target.pane.paneId : null
        const histRoutes = parseRoutes(readFileOrNull(ctx.paths.routes))
        // Map a resolved target pane → the human AGENT NAME it belongs to, so
        // each inbound record is attributed (targetAgent) and `tg replies` can
        // scope to "this agent" (the resolveSessionName primary over the live snapshot — the
        // SAME derivation the reader uses for its own pane). One snapshot for
        // the whole batch; a pane that's gone (or none) → null → untagged.
        // The registry session the pane (or `omp:<pid>` origin) hosts is stamped
        // too (§3.3): the identity `tg replies` scopes on across renames, and the
        // name of an out-of-tmux omp, which has no pane to derive one from.
        const agentPanes = snapshot().panes
        const registry = sessionRegistry
        const resolveSession = (pane: string | null): string | null =>
          pane !== null && registry ? resolveLocatorToSession(registry, pane, undefined) : null
        const resolveAgent = (pane: string | null): string | null => {
          if (pane === null) return null
          const p = agentPanes.find((x) => x.paneId === pane)
          if (p) return resolveSessionName({ tmuxWindow: p.windowName, cwd: p.panePath }).primary || null
          const key = resolveSession(pane)
          return registry?.sessions.find((e) => e.key === key)?.name.primary || null
        }
        // A message inside a forum topic belongs to the topic's session — the one `topic-route`
        // delivers it to (tg-cli#551): the registry owner, else the session on the pane a
        // pre-registry binding names. A gone owner keeps its key but has no pane to stamp (the
        // `%N` may host a stranger now); a topic nobody owns stamps nothing.
        const resolveTopic = (threadId: number): TopicSession | null => {
          const owner = topicOwner(threadId)
          if (owner) {
            return {
              pane: owner.state === "live" ? paneLocatorOf(owner) : null,
              agent: owner.name.primary || null,
              sessionKey: owner.key,
            }
          }
          const binding = findTopic(loadTopics(), threadId)
          if (binding?.status !== "bound" || !binding.paneId) return null
          // The binding's own cwd must match, exactly as resolveTopicSession requires: a pane id is reused freely.
          const key = registry ? resolveLocatorToSession(registry, binding.paneId, binding.path) : null
          return { pane: binding.paneId, agent: resolveAgent(binding.paneId), sessionKey: key }
        }
        const resolvePane = (m: TgMessage): string | null => {
          const replyId = m.reply_to_message?.message_id
          if (replyId === undefined) return null
          // ONLY the kinds that actually reply-route (updates.ts): a text reply
          // whose body is NOT a /command (a /command reply runs verbatim in the
          // default auto-bind pane, never reply-route). A `!shell` reply DOES
          // reply-route to its origin pane (codex #192) — it keeps its raw text but
          // is delivered to the recognized pane, so it must be stamped there too,
          // matching the prose/photo/voice cases. Also a photo/document reply after
          // download, or a voice/audio reply after transcription.
          const isRoutedReply =
            (m.text !== undefined && !m.text.startsWith("/")) ||
            (m.photo !== undefined && !isAgentCommand(m.caption ?? "")) ||
            (m.document !== undefined && !isAgentCommand(m.caption ?? "")) ||
            m.voice !== undefined ||
            m.audio !== undefined
          if (!isRoutedReply) return null
          const recognized = recognizeRoute(histRoutes, replyId)
          if (!recognized) return null
          const { panes, procs } = snapshot()
          const pane = panes.find((p) => p.paneId === recognized.paneId)
          const sameProject = routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: pane?.panePath })
          if (pane && sameProject && findAgentInPane(pane, procs)) return recognized.paneId
          // Mirror handleReplyRoute's recognized-but-unconfirmed guard (HISTORY
          // STAMP ONLY — this return is the scoped-recall pane, NEVER an inject
          // target). When the origin pane is NOT visible (`!pane` — the launchd
          // empty/partial flake), the reply still BELONGS to its recognized origin
          // (the picker routes it there), so stamp it under the origin pane, NOT
          // the default discovered target (the registration's last-writer = the
          // WRONG pane). A genuinely reused/different-project VISIBLE pane (`pane`
          // present but failed the same-project/agent check above) falls back to
          // the default. The two recognized-but-unconfirmed paths intentionally
          // diverge: handleReplyRoute posts the picker (delivery), this stamps the
          // origin pane (attribution) — neither ever injects into an unconfirmed pane.
          return pane ? null : recognized.paneId
        }
        appendHistory(
          ctx.paths.history,
          inboundHistoryRecords(updates, {
            chatId: ctx.chatId,
            allowedSenders: ctx.cfg.allowedSenders,
            pane: targetPane,
            nowSec: Math.floor(Date.now() / 1000),
            stalenessSec: ctx.cfg.stalenessSec,
            resolvePane,
            resolveAgent,
            resolveSession,
            ...(ctx.cfg.topics || ctx.cfg.privateTopics ? { resolveTopic } : {}),
          }),
        )
      }

      // Concurrent per-target dispatch (tg-cli#357, fixes the reported head-of-line-blocking
      // incident: one wedged omp ACP session/prompt call froze delivery to every other agent
      // sharing this daemon). Actions for one inbound message are grouped by their trailing
      // `ack` boundary and run as one atomic, internally sequential unit — the forum-topics
      // no-double-spawn guarantee (two `topic-model` taps for the SAME thread reach `bound`
      // one-after-another) is preserved because same-key groups (actionResourceKey) still run
      // through dispatchQueues in strict enqueue order. Groups with different keys (the common
      // case: different messages routed to different agents) run fully concurrently via
      // Promise.allSettled, so one group's stuck action can never delay or fail any other.
      const actionGroups = groupActionsByAckBoundary(step.actions)
      await Promise.allSettled(
        actionGroups.map((group) => {
          const key = group.reduce<string | null>((acc, a) => acc ?? actionResourceKey(a), null)
          return dispatchQueues.run(key, async () => {
            let ok = true
            for (const action of group) {
              try {
                ok = await executeAction(action, ok)
              } catch (err) {
                log(`action ${action.kind} failed: ${err instanceof Error ? err.message : String(err)}`)
                ok = false
              }
            }
          })
        }),
      )

      // Every action for these updates ran: a later replay of any of them is skipped whole
      // (a dropped tg auth Start tap included — it is finished, not pending).
      recordDelivery(received.map((u): LedgerEvent => ({ ts: Date.now(), event: "processed", update: u.update_id })))

      // The batch fully completed — the journal is no longer needed. Best-effort:
      // if this unlink fails the next startup replays the same batch (idempotent/dedupe-tolerant
      // downstream, matching the rest of the codebase's at-least-once handling, e.g. the Stop-hook
      // inbox fallback).
      if (json.result.length > 0) {
        try {
          unlinkSync(ctx.paths.pendingBatch)
        } catch {}
      }
    } catch (err) {
      // A SIGTERM-aborted long-poll surfaces here as an AbortError — that is a
      // clean graceful exit (no batch was in flight, since fetch never returned),
      // not a fault to back off from. Drain any in-flight deferred flush first
      // (codex #198); cleanExit persists the backlog on its way out.
      if (shuttingDown) await cleanExitAfterFlushDrain()
      // The daemon must survive anything — malformed updates, network
      // failures, tmux races. Log and back off.
      log(`poll loop error: ${err}`)
      await drainAwareSleep(5000)
    }
  }
}

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  const cmd = process.argv[2]
  if (cmd === "omp-live") process.exit(await runOmpLiveCommand(process.argv.slice(3)))
  // Bare invocation (no subcommand) prints HELP on stdout and exits 0 — it NEVER launches the
  // daemon (the shared service-management contract: a bare `<tool> <service>` is help, not run).
  if (!cmd || cmd === "-h" || cmd === "--help") {
    console.log(USAGE)
    process.exit(0)
  }
  // Internal one-shot child spawned by `harness-event`; intentionally absent
  // from USAGE and guarded by persisted retry state before it can inject text.
  if (!["start", "run", "stop", "restart", "status", "enable", "disable", "ask", "withdraw", "install-hooks", "voice-setup", "harness-event", "codex-usage-hook", "auto-continue-once", "usage-schedule", "usage-schedule-check", "inbox", "audit-delivery", "alert"].includes(cmd)) {
    console.error(USAGE)
    process.exit(1)
  }

  const home = process.env.HOME ?? "~"
  // install-hooks edits ~/.claude/settings.json only — no bot token needed.
  if (cmd === "install-hooks") {
    process.exit(installHooks(home))
  }
  // TG_CTL_CONFIG_DIR exists so tests can point a spawned daemon at a tmpdir. Resolve it to an
  // ABSOLUTE path: `enable` pins this dir into the launchd/systemd unit, and the OS launches the
  // login daemon from its own cwd (not the shell's) — a relative override would resolve against
  // the wrong directory and silently miss the .env it was enabled with. (The default branch is
  // already absolute, so this is a no-op there.)
  const configDir = resolveConfigDir(home)
  const fileEnv = loadEnv(join(configDir, ".env"))
  const env = { ...fileEnv, ...process.env }
  // `tg-ctl ask "<question>"` (tg-cli#149) fails CLOSED on every path below; the
  // internal hook-client shapes (parseGenericAskArgv → null) keep their exit-0
  // fast passthrough.
  const genericAsk = cmd === "ask" ? parseGenericAskArgv(process.argv.slice(3)) : null
  if (genericAsk && !genericAsk.question.trim()) {
    console.error("denied: empty question")
    process.exit(1)
  }

  // usage-schedule-check is a LOCAL date check that shells out to `rig`/`tg` directly (no
  // Bot API call via ctx) — runs before the bot-token gate, same reasoning as voice-setup.
  // `tg` itself owns bot-token resolution for the actual send. The watermark path is still
  // keyed by bot id (same scheme as every other per-bot state file, see ctlPaths) so two
  // bots on one machine never share a schedule — that needs only the token's id part, not
  // the full token gate below.
  if (cmd === "usage-schedule-check") {
    const dryRun = process.env.TG_USAGE_SCHEDULE_DRY_RUN === "1" || process.argv.includes("--dry-run")
    const watermarkPath = ctlPaths(configDir, botIdFromToken(env.TG_BOT_TOKEN ?? "") || "unknown").usageSchedule
    process.exit(await runUsageScheduleCheck(new Date(), dryRun, watermarkPath))
  }
  // voice-setup is a LOCAL probe + install + config write — no Telegram I/O, so it
  // runs before the bot-token gate (a user may set up voice before configuring creds).
  if (cmd === "voice-setup") {
    const setupArgs = process.argv.slice(3)
    const unknown = setupArgs.filter((a) => a !== "--dry-run")
    if (unknown.length > 0) {
      console.error(`tg-ctl voice-setup: unknown argument ${unknown[0]} (usage: tg-ctl voice-setup [--dry-run])`)
      process.exit(2)
    }
    const configYaml = readFileOrNull(join(configDir, "config.yaml")) ?? ""
    const current = resolveVoiceConfig(parseVoiceConfig(configYaml))
    const ok = runVoiceSetup({ configDir, home, current, dryRun: setupArgs.includes("--dry-run") })
    process.exit(ok ? 0 : 1)
  }

  const token = env.TG_BOT_TOKEN ?? ""
  const botId = botIdFromToken(token)
  if (genericAsk && (!botId || !env.TG_CHAT_ID)) {
    console.error("denied: no bot credentials configured")
    process.exit(1)
  }
  if ((cmd === "ask" || cmd === "codex-usage-hook") && (!botId || !env.TG_CHAT_ID)) {
    process.exit(0)
  }
  if (!botId || !env.TG_CHAT_ID) {
    console.error(`Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ${join(configDir, ".env")} — run \`tg auth\` to connect.`)
    process.exit(1)
  }

  const configYaml = readFileOrNull(join(configDir, "config.yaml")) ?? ""
  const cfg = resolveControlConfig(parseControlConfig(configYaml))
  const voice = resolveVoiceConfig(parseVoiceConfig(configYaml))

  const ctx: Ctx = {
    configDir,
    paths: ctlPaths(configDir, botId),
    cfg,
    voice,
    token,
    chatId: Number(env.TG_CHAT_ID),
    apiBase: env.TG_API_BASE || "https://api.telegram.org",
    botId,
    home,
    cwd: process.cwd(),
  }

  if (cmd === "start") {
    startLauncher(ctx, parseStartFlags(process.argv.slice(3)))
    process.exit(0)
  }
  if (cmd === "stop") {
    const stopped = stopDaemon(ctx)
    if (stopped.kind === "stopped" && stopped.launchdLabel) {
      console.log(
        `tg-ctl: note — launchd job ${stopped.launchdLabel} supervises the daemon and may relaunch it; ` +
          `\`tg-ctl disable\` (or \`launchctl bootout ${launchdDomain()}/${stopped.launchdLabel}\`) keeps it down.`,
      )
    }
    process.exit(stopped.kind === "still-alive" ? 1 : 0)
  }
  if (cmd === "restart") {
    const args = process.argv.slice(3)
    process.exit(restartDaemon(ctx, parseStartFlags(args), args.includes("--if-stale")))
  }
  if (cmd === "enable") {
    process.exit(enableAutostart(ctx, process.argv.includes("--dry-run")))
  }
  if (cmd === "disable") {
    process.exit(disableAutostart(ctx))
  }
  if (cmd === "usage-schedule") {
    const sub = process.argv[3]
    if (sub === "enable") process.exit(enableUsageSchedule(ctx, process.argv.includes("--dry-run")))
    if (sub === "disable") process.exit(disableUsageSchedule(ctx))
    console.error("usage: tg-ctl usage-schedule enable|disable [--dry-run]")
    process.exit(1)
  }
  if (cmd === "status") {
    await refreshOriginalHosts()
    console.log(composeStatus(ctx, null, await topicSettingsLine(ctx)))
    process.exit(0)
  }
  if (cmd === "inbox") {
    process.exit(runInboxCommand(ctx, process.argv.slice(3)))
  }
  if (cmd === "withdraw") {
    process.exit(await runWithdrawCommand(ctx, process.argv.slice(3)))
  }
  if (cmd === "alert") {
    process.exit(await runAlertCommand(ctx, process.argv.slice(3)))
  }
  if (cmd === "audit-delivery") {
    process.exit(runAuditDelivery(ctx, process.argv.slice(3)))
  }
  if (cmd === "ask") {
    // A generic question first: parseGenericAskArgv returns null for every
    // internal shape, so a `--verify-grant` word inside an unquoted question can
    // never reach the grant client below (which exits 0).
    if (genericAsk) {
      const code = await runGenericAsk(ctx, genericAsk.question, genericAsk.timeout)
      if (signalExit) await signalExit
      process.exit(code)
    }
    // Grant-protocol client (tg-cli#398): `--verify-grant <approval_id> --hook
    // <hook_id>` (TOKEN path) or `--verify-grant --pull --hook <hook_id>` (PULL
    // path) — stdin carries the normalized payload with the recomputed
    // `operation`. Intercepted BEFORE askDaemon so the stdin payload flows to
    // the verify exchange, not the question normalizer.
    const verifyArgv = verifyGrantArgvFrom(process.argv.slice(3))
    if (verifyArgv) {
      let stdinPayload: unknown = null
      try {
        stdinPayload = JSON.parse(await readStdinText())
      } catch {
        stdinPayload = null // the daemon denies malformed payloads fail-closed
      }
      await verifyGrantDaemon(ctx, verifyArgv, stdinPayload)
      process.exit(0)
    }
    await askDaemon(ctx)
    if (signalExit) await signalExit
    process.exit(0)
  }
  if (cmd === "harness-event") {
    process.exit(await runHarnessEvent(ctx, process.argv.slice(3), Date.now()))
  }
  if (cmd === "codex-usage-hook") {
    process.exit(await runCodexUsageHook(ctx, Date.now()))
  }
  if (cmd === "auto-continue-once") {
    process.exit(await runAutoContinueOnce(ctx, process.argv.slice(3)))
  }
  await runDaemon(ctx)
}
